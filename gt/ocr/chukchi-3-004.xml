                        </Shape>
                        <String CONTENT="ɪˊnpɪčɪ-čaˊkɪhêt Elder sister (said by male)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l34" HPOS="578" VPOS="1844" WIDTH="1318" HEIGHT="63" BASELINE="580 1881 1896 1883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="580 1881 578 1891 621 1903 623 1903 625 1903 900 1895 912 1905 913 1905 915 1905 917 1905 919 1905 952 1895 1003 1905 1005 1907 1151 1907 1151 1905 1153 1905 1155 1905 1155 1903 1165 1895 1237 1905 1239 1905 1241 1905 1243 1905 1256 1895 1892 1899 1896 1883 1894 1856 683 1856 580 1844 580 1881"/>
                        </Shape>
                        <String CONTENT="Wuˊthɪtčä-čaˊkɪhêt or wuˊthɪtčeᵋn Middle sister (said by male)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l35" HPOS="570" VPOS="1899" WIDTH="788" HEIGHT="54" BASELINE="572 1926 1358 1932" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="572 1926 570 1940 596 1950 598 1950 995 1952 997 1952 999 1952 1040 1942 1145 1953 1147 1953 1149 1953 1177 1944 1356 1944 1358 1932 1356 1905 572 1899 572 1926"/>
                        </Shape>
                        <String CONTENT="Ñêˊnča-čaˊkɪhêt (“younger sister”)"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l36" HPOS="1373" VPOS="1901" WIDTH="554" HEIGHT="52" BASELINE="1375 1930 1927 1932" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1375 1930 1373 1942 1477 1953 1479 1953 1925 1944 1927 1932 1925 1903 1375 1901 1375 1930"/>
                        </Shape>
                        <String CONTENT="Younger sister (said by male)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l37" HPOS="565" VPOS="1940" WIDTH="1229" HEIGHT="54" BASELINE="567 1977 1794 1975" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="567 1977 567 1989 1790 1994 1794 1975 1790 1950 576 1940 574 1940 572 1940 570 1940 570 1942 565 1946 567 1977"/>
                        </Shape>
                        <String CONTENT="Čaˊkêt-tɵˊmg̣ɪn (“sister-mate”) Sister (said by female)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l38" HPOS="569" VPOS="1996" WIDTH="1335" HEIGHT="43" BASELINE="569 2022 1904 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="569 2022 569 2039 1904 2039 1904 2022 1904 1996 569 1996 569 2022"/>
                        </Shape>
                        <String CONTENT="ɪˊnpɪčɪ-čaˊkêt-tɵˊmg̣ɪn (“elder sister-mate”) Elder sister (said by female)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-004_r4" HPOS="367" VPOS="2086" WIDTH="1782" HEIGHT="1044" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="367 2086 2149 2086 2149 3130 367 3130"/>
                    </Shape>
                    <TextLine ID="mz_3-004_l39" HPOS="475" VPOS="2088" WIDTH="1666" HEIGHT="53" BASELINE="477 2113 2141 2117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 2113 475 2129 2137 2141 2141 2117 2139 2092 477 2088 477 2113"/>
                        </Shape>
                        <String CONTENT="¹ One can also say ᴇʟɪˊw-miˊrg̣ɪn (“paternal grandfather”) and ᴇʟaˊ-mêˊrg̣ɪn (“maternal grandfather”),"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l40" HPOS="368" VPOS="2135" WIDTH="1775" HEIGHT="43" BASELINE="368 2160 2143 2160" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2160 368 2178 2143 2178 2143 2160 2141 2135 368 2135 368 2160"/>
                        </Shape>
                        <String CONTENT="though generally the first part of the word is omitted. Children use also the terms apaiˊñɪn (“grandfather”) and"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l41" HPOS="368" VPOS="2178" WIDTH="1773" HEIGHT="42" BASELINE="368 2203 2141 2203" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2203 368 2220 2141 2220 2141 2203 2141 2178 368 2178 368 2203"/>
                        </Shape>
                        <String CONTENT="epeˊqäi (“grandmother”), which are, the former an augmentative, and the latter a diminutive, form from eˊpᴇ"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l42" HPOS="368" VPOS="2217" WIDTH="1773" HEIGHT="44" BASELINE="370 2246 2141 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2246 370 2261 2139 2259 2141 2240 2135 2217 368 2220 370 2246"/>
                        </Shape>
                        <String CONTENT="(“father”). The latter word, however, is rarely used, and belongs rather to the Koryak language. Another"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l43" HPOS="368" VPOS="2259" WIDTH="1773" HEIGHT="45" BASELINE="370 2287 2141 2283" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2287 370 2304 2139 2302 2141 2283 2135 2259 368 2261 370 2287"/>
                        </Shape>
                        <String CONTENT="diminutive, epeˊpil (literally, “little father”), is attributed to the Christian priest, and with this meaning it has"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l44" HPOS="366" VPOS="2302" WIDTH="512" HEIGHT="43" BASELINE="368 2332 878 2326" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2332 368 2345 878 2345 878 2326 873 2302 366 2306 368 2332"/>
                        </Shape>
                        <String CONTENT="been adopted by the Chukchee."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l45" HPOS="477" VPOS="2339" WIDTH="1538" HEIGHT="49" BASELINE="479 2365 2015 2373" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2365 477 2380 2011 2388 2015 2373 2013 2347 479 2339 479 2365"/>
                        </Shape>
                        <String CONTENT="² These may be distinguished as ᴇʟɪˊhɪndiw (“paternal uncle”) and ᴇʟaˊndêw (“maternal uncle”)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l46" HPOS="477" VPOS="2384" WIDTH="1093" HEIGHT="43" BASELINE="479 2410 1570 2413" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2410 477 2423 1566 2427 1570 2413 1568 2388 479 2384 479 2410"/>
                        </Shape>
                        <String CONTENT="³ Uncles and aunts once removed are designated by the same terms."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l47" HPOS="479" VPOS="2425" WIDTH="1660" HEIGHT="45" BASELINE="481 2450 2139 2456" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="481 2450 479 2464 2135 2470 2139 2456 2137 2431 481 2425 481 2450"/>
                        </Shape>
                        <String CONTENT="⁴ Äˊmmê probably means the mother’s breast; aˊtê and äˊmmê are used mostly by young children."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l48" HPOS="366" VPOS="2466" WIDTH="1771" HEIGHT="49" BASELINE="368 2499 2137 2495" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2499 368 2515 2135 2511 2137 2495 2132 2466 366 2474 368 2499"/>
                        </Shape>
                        <String CONTENT="ɪnpɪnaˊčhɪn and ɪnpɪñeˊ, which, according to Nordquist, were mentioned by several authors as terms for “father”"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l49" HPOS="366" VPOS="2513" WIDTH="1775" HEIGHT="45" BASELINE="368 2542 2141 2538" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2542 368 2558 2139 2558 2141 2538 2135 2513 366 2515 368 2542"/>
                        </Shape>
                        <String CONTENT="and “mother” respectively, in reality have the meaning “old man” and “old woman.” Both are derived from"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l50" HPOS="366" VPOS="2554" WIDTH="861" HEIGHT="48" BASELINE="368 2579 1227 2585" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2579 366 2595 372 2601 372 2602 374 2602 376 2602 378 2602 1225 2601 1227 2585 1225 2560 368 2554 368 2579"/>
                        </Shape>
                        <String CONTENT="ɪnp, the root of the adjective nɪˊnpɪqên (“he is old”)."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l51" HPOS="477" VPOS="2591" WIDTH="1658" HEIGHT="49" BASELINE="479 2622 2135 2620" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2622 479 2640 2134 2638 2135 2620 2130 2591 477 2597 479 2622"/>
                        </Shape>
                        <String CONTENT="⁵ In all derivations, only the first stem is used. Tuˊmg̣ɪtum (pl. tuˊmg̣ɪt, stem tuˊmg̣ɪ) means “companion,”"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l52" HPOS="368" VPOS="2638" WIDTH="1775" HEIGHT="42" BASELINE="370 2663 2143 2667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2663 368 2677 2139 2680 2143 2667 2141 2641 370 2638 370 2663"/>
                        </Shape>
                        <String CONTENT="“mate,” also “kinsman.” A husband, speaking of his wife, calls her g̣ŭmniˊn tuˊmg̣ɪtum (my mate”). G̣etuˊmg̣ɪlin"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l53" HPOS="368" VPOS="2682" WIDTH="1777" HEIGHT="43" BASELINE="368 2710 2145 2710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2710 368 2721 2141 2725 2145 2710 2141 2682 368 2682 368 2710"/>
                        </Shape>
                        <String CONTENT="means “one with companions,” “one with kinsmen,” “one with influence.” It is used as a compound in several"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l54" HPOS="368" VPOS="2727" WIDTH="1777" HEIGHT="41" BASELINE="368 2753 2145 2753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2753 368 2768 2143 2768 2145 2753 2143 2727 368 2727 368 2753"/>
                        </Shape>
                        <String CONTENT="terms referring to degrees of relationship, in various combinations, sometimes only between males, at other times"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l55" HPOS="368" VPOS="2770" WIDTH="1041" HEIGHT="39" BASELINE="368 2793 1409 2793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2793 368 2809 1409 2809 1409 2793 1409 2770 368 2770 368 2793"/>
                        </Shape>
                        <String CONTENT="only between females, and even also between males and females."/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l56" HPOS="477" VPOS="2803" WIDTH="1672" HEIGHT="47" BASELINE="479 2829 2149 2834" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2829 477 2844 2145 2850 2149 2834 2147 2805 479 2803 479 2829"/>
                        </Shape>
                        <String CONTENT="⁶ The terms for “elder brother” and “younger brother” are relative; i. e., all brothers older than myself"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l57" HPOS="366" VPOS="2848" WIDTH="1781" HEIGHT="45" BASELINE="368 2873 2147 2877" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2873 366 2889 2143 2893 2147 2877 2145 2852 368 2848 368 2873"/>
                        </Shape>
                        <String CONTENT="are my ɪneˊelit, and all brothers younger than myself are my ᴇʟeˊnyut (pl.). More detailed terms are used as"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l58" HPOS="366" VPOS="2891" WIDTH="1777" HEIGHT="43" BASELINE="368 2916 2143 2920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2916 366 2932 2139 2934 2143 2920 2141 2895 368 2891 368 2916"/>
                        </Shape>
                        <String CONTENT="follows: ênaˊn-ɪnaˊalɪn, “the oldest brother;” ênaˊn-ᴇʟaˊñê, “the youngest brother;” wuˊthɪtčeᵋn, “the middle"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l59" HPOS="368" VPOS="2938" WIDTH="1779" HEIGHT="41" BASELINE="368 2963 2147 2963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2963 368 2979 2147 2977 2147 2963 2147 2938 368 2938 368 2963"/>
                        </Shape>
                        <String CONTENT="(brother).” ɪneˊelin (“elder brother”) and ᴇʟeˊñi (“younger brother”) are used both by males and females; but"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l60" HPOS="366" VPOS="2973" WIDTH="1779" HEIGHT="45" BASELINE="368 3000 2145 3004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3000 366 3014 2141 3018 2145 3004 2143 2979 368 2973 368 3000"/>
                        </Shape>
                        <String CONTENT="the former term is pronounced by women ɪniˊnelin, according to the rules of female pronunciation, in which"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l61" HPOS="366" VPOS="3020" WIDTH="1777" HEIGHT="52" BASELINE="368 3049 2143 3045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3049 368 3072 2141 3066 2143 3045 2137 3020 366 3021 368 3049"/>
                        </Shape>
                        <String CONTENT="contractions are avoided. The elder sister is also called ɪneˊelin or ɪniˊnelin (by males and females). ᴇʟeˊñi is"/>
                    </TextLine>

                    <TextLine ID="mz_3-004_l62" HPOS="368" VPOS="3064" WIDTH="565" HEIGHT="43" BASELINE="368 3088 933 3088" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3088 368 3107 933 3107 933 3088 933 3064 368 3064 368 3088"/>
                        </Shape>
                        <String CONTENT="used for the younger brother only."/>
                    </TextLine>
</TextBlock>
