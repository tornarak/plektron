                        <Shape>
                            <Polygon POINTS="411 1997 411 2013 2177 2009 2179 1993 2175 1964 409 1962 411 1997"/>
                        </Shape>
                        <String CONTENT="brandishing his spear, went toward the tent of his daughter, and ripped the"/>
                    </TextLine>

