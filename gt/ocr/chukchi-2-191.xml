                    </TextLine>

                    <TextLine ID="mz_2-191_l30" HPOS="407" VPOS="2193" WIDTH="1770" HEIGHT="63" BASELINE="409 2238 2177 2230" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2238 409 2252 1733 2256 1735 2256 2175 2244 2177 2230 2173 2203 2083 2193 2081 2193 2021 2203 1997 2193 1995 2193 1993 2193 1991 2193 1966 2203 1931 2193 1929 2193 1927 2193 1925 2193 1891 2203 1866 2193 1864 2193 1862 2193 1860 2193 1825 2203 1700 2195 1698 2195 1696 2195 1660 2205 1627 2195 1625 2195 1623 2195 1621 2195 1600 2205 1572 2195 1570 2195 1568 2195 1566 2195 1564 2195 1549 2207 1449 2207 1322 2195 1320 2195 1318 2195 1286 2207 1261 2197 1259 2197 1257 2197 1130 2207 1067 2197 1065 2197 785 2209 452 2199 450 2199 448 2199 407 2209 409 2238"/>
                        </Shape>
