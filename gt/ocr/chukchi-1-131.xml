                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE,"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l2" HPOS="2105" VPOS="638" WIDTH="33" HEIGHT="61" BASELINE="2105 671 2138 671" TAGREFS="TYPE_5">
                        <Shape>
