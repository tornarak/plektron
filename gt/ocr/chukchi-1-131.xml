                        </Shape>
                        <String CONTENT="99"/>
                    </TextLine>
<TextLine ID="mz_1-131_l3" HPOS="390" VPOS="725" WIDTH="1778" HEIGHT="61" BASELINE="392 773 2168 768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 727 620 738 583 731 563 731 544 731 526 738 511 734 498 734 477 734 455 734 433 736 429 736 390 740 392 773 392 786 2166 781 2168 768 2164 738 2109 725 2107 725 2105 725 2084 736 1934 725 1932 725 1930 725 1928 725 1910 736 1886 725 1884 725 1882 725 1806 736 1769 725 1767 725 1765 725 1763 725 1739 736 1713 725 1711 725 1709 725 1566 736 1505 725 1503 725 1449 736 1332 725 1330 725 1265 738 682 727 680 727"/>
                        </Shape>
                        <String CONTENT="up to the middle of the last century, a sledge with curved ribs, similar to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l4" HPOS="390" VPOS="799" WIDTH="1778" HEIGHT="49" BASELINE="390 831 2168 831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 831 390 848 2168 848 2168 831 2168 799 390 799 390 831"/>
                        </Shape>
                        <String CONTENT="reindeer-sledge, and a peculiar kind of harness (Fig. 20, b), identical with that"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l5" HPOS="390" VPOS="846" WIDTH="1778" HEIGHT="67" BASELINE="392 892 2168 887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 892 392 905 2146 913 2148 913 2151 913 2153 913 2168 902 2168 887 2164 857 1280 846 1278 846 1276 846 1274 846 1258 857 477 848 474 848 390 859 392 892"/>
                        </Shape>
                        <String CONTENT="used by the American Eskimo. They harnessed the dogs abreast in the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l6" HPOS="390" VPOS="907" WIDTH="1774" HEIGHT="60" BASELINE="392 952 2164 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 952 392 967 2161 965 2164 948 2159 918 1362 907 1360 907 390 920 392 952"/>
                        </Shape>
                        <String CONTENT="way as is done in North America. Since that time, however, they have entirely"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l7" HPOS="392" VPOS="967" WIDTH="1772" HEIGHT="61" BASELINE="392 1011 2164 1011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1011 392 1028 2164 1028 2164 1011 2164 980 2075 967 2073 967 2071 967 2042 978 1947 967 1945 967 1943 967 1895 978 1401 967 1399 967 1267 978 1159 967 1157 967 1100 978 1018 967 1016 967 962 978 925 967 923 967 921 967 834 978 775 967 773 967 771 967 726 978 672 967 669 967 667 967 646 978 617 967 615 967 613 967 550 978 422 967 420 967 418 967 392 978 392 1011"/>
                        </Shape>
                        <String CONTENT="abandoned the old mode of dog-driving, and have adopted the southern form"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l8" HPOS="392" VPOS="1039" WIDTH="1772" HEIGHT="45" BASELINE="392 1069 2164 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1069 392 1084 2164 1084 2164 1069 2164 1039 392 1039 392 1069"/>
                        </Shape>
                        <String CONTENT="of sledge and the “tandem” method of attachment. Nelson¹ gives a sketch"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l9" HPOS="392" VPOS="1086" WIDTH="1774" HEIGHT="61" BASELINE="392 1130 2166 1130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1130 392 1147 2166 1147 2166 1130 2166 1099 1917 1086 1915 1086 1912 1086 1889 1099 1707 1099 1648 1086 1646 1086 1644 1086 1618 1097 1572 1086 1570 1086 1568 1086 1514 1097 1481 1086 1479 1086 1477 1086 1475 1086 1473 1086 1455 1097 1373 1086 1371 1086 1321 1097 1291 1086 1289 1086 1287 1086 1284 1086 1282 1086 1267 1099 1131 1099 1074 1086 1072 1086 1070 1086 1027 1097 912 1086 910 1086 843 1097 795 1086 793 1086 791 1086 788 1086 758 1097 643 1086 641 1086 583 1097 546 1086 544 1086 542 1086 466 1097 435 1086 433 1086 431 1086 429 1086 392 1097 392 1130"/>
                        </Shape>
                        <String CONTENT="of a dog-sledge from Plover Bay, on the Siberian Pacific coast, which seems"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l10" HPOS="390" VPOS="1149" WIDTH="1774" HEIGHT="57" BASELINE="392 1190 2164 1186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1190 392 1206 2161 1206 2164 1186 2159 1158 409 1149 407 1149 405 1149 403 1149 390 1156 392 1190"/>
                        </Shape>
                        <String CONTENT="to me rather to be a reindeer-sledge, as it is too long and slender to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l11" HPOS="388" VPOS="1214" WIDTH="1773" HEIGHT="63" BASELINE="390 1247 2161 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1247 388 1264 405 1275 407 1275 409 1275 412 1275 1189 1264 1295 1277 1297 1277 1360 1266 1817 1266 1865 1277 1867 1277 1869 1277 2051 1266 2131 1277 2133 1277 2135 1277 2159 1264 2161 1251 2159 1219 390 1214 390 1247"/>
                        </Shape>
                        <String CONTENT="driven with dogs. It is somewhat strange that he did not see any other dog-"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l12" HPOS="390" VPOS="1264" WIDTH="1771" HEIGHT="71" BASELINE="392 1309 2161 1305" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1309 392 1325 509 1335 511 1335 513 1335 542 1325 2159 1325 2161 1305 2157 1277 2079 1264 2077 1264 2075 1264 2073 1264 2053 1277 1912 1277 1897 1264 1895 1264 1893 1264 1891 1264 1821 1275 1806 1264 1804 1264 1802 1264 1800 1264 1798 1264 1795 1264 1780 1277 1648 1277 1624 1264 1622 1264 1620 1264 1477 1275 1460 1264 1458 1264 1455 1264 1321 1264 1319 1264 1317 1264 1267 1277 1245 1266 1243 1266 1241 1266 1239 1266 1200 1277 1176 1266 1174 1266 1172 1266 897 1277 869 1266 866 1266 864 1266 862 1266 840 1277 758 1266 756 1266 754 1266 723 1277 672 1266 669 1266 667 1266 665 1266 648 1279 537 1279 418 1266 416 1266 414 1266 390 1277 392 1309"/>
                        </Shape>
                        <String CONTENT="sledge on the Siberian shore. Nordenskiöld,² too, gives a sketch of a dog-"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l13" HPOS="390" VPOS="1335" WIDTH="1776" HEIGHT="61" BASELINE="392 1366 2166 1370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1366 390 1379 472 1394 474 1394 544 1383 591 1394 594 1394 596 1396 700 1396 700 1394 702 1394 704 1394 717 1383 762 1394 765 1394 767 1394 769 1394 795 1383 808 1394 810 1394 812 1394 814 1394 817 1394 847 1383 1280 1396 1282 1396 1284 1396 1323 1385 1837 1396 1839 1396 2164 1383 2166 1370 2164 1335 392 1335 392 1366"/>
                        </Shape>
                        <String CONTENT="sledge similar to a reindeer pack-sledge. Of the native drawings reproduced"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l14" HPOS="392" VPOS="1396" WIDTH="1774" HEIGHT="50" BASELINE="392 1431 2166 1431" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1431 392 1446 2166 1446 2166 1431 2166 1400 392 1396 392 1431"/>
                        </Shape>
                        <String CONTENT="in his book, one represents a man driving a similar sledge with three dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l15" HPOS="392" VPOS="1455" WIDTH="1774" HEIGHT="54" BASELINE="392 1491 2166 1491" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1491 392 1504 2164 1509 2166 1491 2166 1461 392 1455 392 1491"/>
                        </Shape>
                        <String CONTENT="harnessed abreast and a leader ahead; and another pictures a man driving"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l16" HPOS="390" VPOS="1504" WIDTH="1774" HEIGHT="65" BASELINE="392 1552 2164 1548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1552 392 1567 2159 1569 2164 1548 2159 1517 1932 1504 1930 1504 1839 1515 1782 1504 1780 1504 1778 1504 1776 1504 1761 1517 1544 1517 1510 1504 1507 1504 1505 1504 1352 1515 1293 1504 1291 1504 1289 1504 1254 1517 1180 1506 1178 1506 951 1517 921 1506 918 1506 916 1506 914 1506 873 1517 806 1506 804 1506 801 1506 799 1506 782 1517 680 1506 678 1506 676 1506 674 1506 659 1517 533 1506 531 1506 390 1519 392 1552"/>
                        </Shape>
                        <String CONTENT="an ordinary East Siberian dog-sledge with a tandem team. Lieut. Nordquist,"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l17" HPOS="390" VPOS="1569" WIDTH="1778" HEIGHT="59" BASELINE="392 1613 2168 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1613 392 1628 2166 1621 2168 1604 2161 1569 390 1576 392 1613"/>
                        </Shape>
                        <String CONTENT="in his Report given by Nordenskiöld,³ describes likewise the old method of"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l18" HPOS="390" VPOS="1626" WIDTH="1791" HEIGHT="71" BASELINE="392 1669 2181 1673" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1669 390 1682 407 1695 409 1695 412 1695 414 1695 1198 1684 1239 1695 1241 1695 1243 1695 1975 1686 2055 1697 2058 1697 2060 1697 2062 1697 2077 1686 2179 1686 2181 1673 2179 1641 2120 1628 2118 1628 2116 1628 2081 1639 2051 1628 2049 1628 2047 1628 1980 1639 1954 1628 1951 1628 1949 1628 1722 1639 1696 1628 1694 1628 1692 1628 1689 1628 1659 1639 1585 1628 1583 1628 1581 1628 1533 1639 1440 1628 1438 1628 1386 1639 1352 1628 1349 1628 1347 1628 1295 1639 1167 1626 1063 1626 1061 1626 1059 1626 1057 1626 1042 1636 999 1626 996 1626 994 1626 992 1626 949 1636 931 1626 929 1626 927 1626 925 1626 862 1636 786 1626 784 1626 782 1626 760 1636 665 1626 663 1626 661 1626 633 1639 526 1639 511 1626 509 1626 507 1626 505 1626 392 1634 392 1669"/>
                        </Shape>
                        <String CONTENT="dog-harnessing; but Nordenskiöld says elsewhere that it was used only for"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l19" HPOS="390" VPOS="1686" WIDTH="1778" HEIGHT="61" BASELINE="392 1734 2168 1727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1734 392 1747 2166 1740 2168 1727 2164 1699 1876 1699 1830 1686 1828 1686 1826 1686 1720 1697 1685 1686 1683 1686 1681 1686 1679 1686 1637 1697 1611 1686 1609 1686 1607 1686 1531 1699 1191 1688 1189 1688 1187 1688 1185 1688 1167 1699 1113 1688 1111 1688 1109 1688 1087 1699 812 1691 810 1691 808 1691 784 1701 749 1691 747 1691 745 1691 643 1701 552 1691 550 1691 548 1691 518 1701 416 1691 414 1691 412 1691 409 1691 390 1699 392 1734"/>
                        </Shape>
                        <String CONTENT="short trips, and that almost all drivers that passed along the coast on a"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l20" HPOS="390" VPOS="1745" WIDTH="1778" HEIGHT="69" BASELINE="392 1794 2168 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1794 392 1814 2166 1801 2168 1788 2161 1749 1917 1755 1863 1745 1860 1745 1780 1755 1720 1745 1718 1745 1620 1755 1592 1745 1590 1745 1588 1745 1427 1758 1391 1747 1388 1747 1386 1747 1291 1758 1193 1747 1191 1747 1189 1747 1187 1747 1172 1760 1014 1760 986 1747 983 1747 981 1747 979 1747 953 1760 847 1749 845 1749 843 1749 817 1760 468 1749 466 1749 390 1762 392 1794"/>
                        </Shape>
                        <String CONTENT="prolonged journey had dogs attached tandem fashion. The old method of"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l21" HPOS="392" VPOS="1814" WIDTH="1774" HEIGHT="54" BASELINE="394 1853 2166 1849" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1853 394 1868 2164 1864 2166 1849 2159 1814 392 1816 394 1853"/>
                        </Shape>
                        <String CONTENT="harnessing has gone entirely out of use; and I have never seen it employed"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l22" HPOS="394" VPOS="1875" WIDTH="1772" HEIGHT="58" BASELINE="396 1905 2166 1909" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1905 394 1920 416 1933 418 1933 420 1933 2164 1924 2166 1909 2164 1879 396 1875 396 1905"/>
                        </Shape>
                        <String CONTENT="in Maritime villages, though poor Reindeer people along the seacoast, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l23" HPOS="394" VPOS="1929" WIDTH="1776" HEIGHT="58" BASELINE="396 1970 2170 1965" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1970 396 1987 2168 1983 2170 1965 2166 1937 444 1929 442 1929 440 1929 394 1939 396 1970"/>
                        </Shape>
                        <String CONTENT="using dogs, sometimes attach them to a reindeer-sledge. Among the Asiatic"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l24" HPOS="394" VPOS="1991" WIDTH="1772" HEIGHT="57" BASELINE="396 2026 2166 2033" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2026 394 2041 2161 2048 2166 2033 2164 2000 396 1991 396 2026"/>
                        </Shape>
                        <String CONTENT="Eskimo there are cases (for example, in the ceremonial races in the spring)"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l25" HPOS="394" VPOS="2048" WIDTH="1629" HEIGHT="58" BASELINE="394 2091 2023 2091" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2091 394 2104 2021 2106 2023 2091 2023 2059 1997 2048 1995 2048 1993 2048 1990 2048 1964 2059 1895 2048 1893 2048 1828 2059 1661 2048 1659 2048 1588 2061 1481 2061 1466 2048 1464 2048 1462 2048 1460 2048 1397 2059 1332 2048 1330 2048 1328 2048 1297 2059 1254 2048 1252 2048 1135 2048 1133 2048 1131 2048 1128 2048 1111 2061 1022 2061 1009 2048 1007 2048 1005 2048 1003 2048 929 2061 765 2061 741 2048 739 2048 736 2048 734 2048 704 2059 646 2048 643 2048 641 2048 611 2059 576 2048 574 2048 572 2048 394 2054 394 2091"/>
                        </Shape>
                        <String CONTENT="in which the dogs are still attached in the old way (Plate VII, Fig. 1)."/>
                    </TextLine>
<TextLine ID="mz_1-131_l26" HPOS="503" VPOS="2104" WIDTH="1665" HEIGHT="63" BASELINE="505 2152 2168 2145" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="505 2152 505 2167 2166 2160 2168 2145 2166 2117 2133 2104 2131 2104 2129 2104 2127 2104 2125 2104 2105 2117 1681 2117 1657 2104 1655 2104 1653 2104 1650 2104 1605 2117 1592 2106 1590 2106 1588 2106 1585 2106 1583 2106 1553 2117 1477 2106 1475 2106 1473 2106 1445 2117 942 2108 940 2108 938 2108 936 2108 923 2119 901 2108 899 2108 897 2108 895 2108 864 2119 836 2108 834 2108 832 2108 734 2119 659 2108 656 2108 559 2119 522 2108 520 2108 518 2108 516 2108 513 2108 503 2117 505 2152"/>
                        </Shape>
                        <String CONTENT="A model made in Mariinsky Post shows that the bone eyes at the ends"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l27" HPOS="394" VPOS="2171" WIDTH="1776" HEIGHT="54" BASELINE="394 2210 2170 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2210 394 2225 2170 2225 2170 2210 2168 2171 394 2178 394 2210"/>
                        </Shape>
                        <String CONTENT="of the long traces were strung on a line tied across the sledge in front of"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l28" HPOS="392" VPOS="2225" WIDTH="1778" HEIGHT="67" BASELINE="394 2266 2170 2271" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2266 392 2284 405 2292 407 2292 409 2292 412 2292 2168 2284 2170 2271 2168 2240 2103 2227 2101 2227 2099 2227 2064 2238 1865 2227 1863 2227 1860 2227 1824 2238 1744 2227 1741 2227 1529 2238 1503 2227 1501 2227 1499 2227 1447 2238 1393 2227 1391 2227 1388 2227 1367 2238 1280 2225 1278 2225 1276 2225 1274 2225 1256 2236 1189 2225 1187 2225 1118 2236 1057 2225 1055 2225 1053 2225 1018 2236 947 2225 944 2225 840 2236 758 2225 756 2225 754 2225 726 2238 539 2238 524 2225 522 2225 520 2225 518 2225 394 2234 394 2266"/>
                        </Shape>
                        <String CONTENT="the first cross-piece joining the rails. This line is more or less similar to that"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l29" HPOS="392" VPOS="2284" WIDTH="960" HEIGHT="63" BASELINE="394 2331 1352 2325" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2331 394 2347 1349 2340 1352 2325 1341 2284 1328 2295 1217 2284 1215 2284 1159 2295 1137 2284 1135 2284 1133 2284 1131 2284 1128 2284 1118 2295 1098 2284 1096 2284 1094 2284 1092 2284 1055 2295 1031 2284 1029 2284 1027 2284 1025 2284 999 2297 767 2286 765 2286 700 2299 661 2288 659 2288 656 2288 537 2299 433 2288 431 2288 429 2288 392 2301 394 2331"/>
                        </Shape>
                        <String CONTENT="of the Eskimo sledge described by Boas.⁴"/>
                    </TextLine>
<TextLine ID="mz_1-131_l30" HPOS="500" VPOS="2357" WIDTH="1670" HEIGHT="50" BASELINE="500 2390 2170 2390" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 2390 500 2407 2170 2407 2170 2390 2170 2360 500 2357 500 2390"/>
                        </Shape>
                        <String CONTENT="I met with instances among the inland Yakut where ordinary house-dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l31" HPOS="392" VPOS="2407" WIDTH="1776" HEIGHT="59" BASELINE="394 2453 2168 2448" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2453 394 2466 2166 2463 2168 2448 2164 2418 1300 2407 1297 2407 1295 2407 1293 2407 1274 2418 568 2409 565 2409 392 2420 394 2453"/>
                        </Shape>
                        <String CONTENT="were attached singly to small sledges by means of a wooden shaft, or even"/>
                    </TextLine>

                    <TextLine ID="mz_1-131_l32" HPOS="399" VPOS="2481" WIDTH="1769" HEIGHT="47" BASELINE="399 2511 2168 2511" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="399 2511 399 2524 2166 2528 2168 2511 2168 2481 399 2481 399 2511"/>
                        </Shape>
