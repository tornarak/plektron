                        <Shape>
                            <Polygon POINTS="396 2630 396 2647 2168 2647 2168 2630 2168 2600 2016 2587 2014 2587 1928 2598 1863 2587 1860 2587 1765 2598 1668 2587 1666 2587 1598 2598 1505 2587 1503 2587 1501 2587 1468 2598 1408 2587 1406 2587 1202 2598 1122 2587 1120 2587 1040 2598 975 2587 973 2587 873 2598 797 2587 795 2587 793 2587 762 2598 396 2595 396 2630"/>
                        </Shape>
                        <String CONTENT="in the common dog driving-sledge adopted by the northern fishing Yakut on"/>
                    </TextLine>

