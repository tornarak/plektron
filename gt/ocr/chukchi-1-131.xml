                        <Shape>
                            <Polygon POINTS="399 2570 399 2587 2168 2587 2168 2570 2168 2537 399 2531 399 2570"/>
                        </Shape>
                        <String CONTENT="bulls to wooden sledges. This method has no connection with that employed"/>
                    </TextLine>

