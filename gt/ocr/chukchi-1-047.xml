                        <Shape>
                            <Polygon POINTS="388 1015 388 1032 2157 1035 2159 1015 2159 987 388 987 388 1015"/>
                        </Shape>
                        <String CONTENT="On the so-called Chukchee Peninsula, between Kuluˊči Bay, Holy Cross Bay, and the Pacific Ocean,"/>
                    </TextLine>

                    <TextLine ID="mz_1-047_l8" HPOS="466" VPOS="1030" WIDTH="1693" HEIGHT="48" BASELINE="468 1061 2159 1065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1061 466 1073 2155 1078 2159 1065 2157 1035 468 1030 468 1061"/>
                        </Shape>
                        <String CONTENT="the whole number of reindeer-camps is from about 80 to 100. The herds are not very large,"/>
                    </TextLine>

                    <TextLine ID="mz_1-047_l9" HPOS="468" VPOS="1082" WIDTH="1691" HEIGHT="43" BASELINE="468 1110 2159 1110" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1110 468 1125 2157 1125 2159 1110 2157 1082 468 1082 468 1110"/>
                        </Shape>
                        <String CONTENT="owing to the severity of the climate and to scanty pasturage. Almost half of these camps"/>
