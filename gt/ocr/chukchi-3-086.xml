                        </Shape>
                        <String CONTENT="and implies an insult, leading to a serious quarrel. Äᵋmuˊlɪn, however, is used"/>
                    </TextLine>

                    <TextLine ID="mz_3-086_l17" HPOS="368" VPOS="1419" WIDTH="1769" HEIGHT="57" BASELINE="370 1458 2137 1462" TAGREFS="TYPE_5">
