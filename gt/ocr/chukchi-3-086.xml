                        </Shape>
                        <String CONTENT="used for the same purpose is g̣ŭpɪˊlɪn, which means simply “working one,”"/>
                    </TextLine>

                    <TextLine ID="mz_3-086_l9" HPOS="366" VPOS="942" WIDTH="1773" HEIGHT="55" BASELINE="366 983 2139 983" TAGREFS="TYPE_5">
                        <Shape>
