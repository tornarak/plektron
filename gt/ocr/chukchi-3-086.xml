                        </Shape>
                        <String CONTENT="members of their own family. A third word in usage is čawčuwaˊ-aᵋmɵˊlɪn."/>
                    </TextLine>

                    <TextLine ID="mz_3-086_l11" HPOS="368" VPOS="1059" WIDTH="1762" HEIGHT="56" BASELINE="370 1098 2130 1102" TAGREFS="TYPE_5">
                        <Shape>
