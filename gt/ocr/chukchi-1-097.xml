                    <TextLine ID="mz_1-097_l1" HPOS="944" VPOS="643" WIDTH="623" HEIGHT="54" BASELINE="946 675 1567 679" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="946 653 946 675 944 692 1563 697 1567 679 1565 645 963 643 946 653"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-097_r2" HPOS="370" VPOS="746" WIDTH="1778" HEIGHT="839" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="370 746 2148 746 2148 1585 370 1585"/>
                    </Shape>
                    <TextLine ID="mz_1-097_l2" HPOS="476" VPOS="755" WIDTH="1667" HEIGHT="48" BASELINE="476 785 2143 785" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="476 785 476 803 2141 803 2143 785 2141 755 476 755 476 785"/>
                        </Shape>
                        <String CONTENT="Between the Yenisei and Indighirka Rivers the Tungus approach the"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l3" HPOS="370" VPOS="803" WIDTH="1771" HEIGHT="67" BASELINE="372 848 2141 844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 848 372 866 2137 870 2141 844 2137 816 2076 803 2074 803 2072 803 2048 814 1702 803 1700 803 1697 803 1669 816 1485 816 1470 803 1468 803 1466 803 1288 803 1286 803 1284 803 1251 814 1154 805 1152 805 1149 805 1147 805 1132 816 965 805 963 805 900 816 866 805 864 805 861 805 775 816 708 805 706 805 703 805 673 816 630 805 628 805 625 805 560 816 463 805 461 805 370 818 372 848"/>
                        </Shape>
                        <String CONTENT="seashore. In this region they are intermixed with a group of the Yukaghir, who,"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l4" HPOS="370" VPOS="874" WIDTH="1773" HEIGHT="61" BASELINE="372 909 2143 902" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 909 372 924 697 935 699 935 701 935 703 935 718 922 1000 922 1046 933 1048 933 1050 933 1201 922 1273 933 1275 933 1327 922 1520 930 1522 930 1691 920 1957 930 1959 930 1962 930 1983 920 2020 930 2022 930 2024 930 2027 930 2048 920 2122 930 2124 930 2126 930 2128 930 2143 917 2143 902 2139 874 370 874 372 909"/>
                        </Shape>
                        <String CONTENT="here at least, also used to possess some reindeer. The ethnography of this"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l5" HPOS="368" VPOS="924" WIDTH="1778" HEIGHT="58" BASELINE="370 967 2146 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 967 370 982 2146 978 2146 963 2141 935 1292 924 1290 924 1288 924 1251 935 502 926 500 926 368 937 370 967"/>
                        </Shape>
                        <String CONTENT="tract is still very imperfectly known; and the problems to be solved here are"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l6" HPOS="370" VPOS="985" WIDTH="1773" HEIGHT="58" BASELINE="372 1028 2143 1024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1028 372 1043 2141 1039 2143 1024 2139 989 508 985 506 985 370 995 372 1028"/>
                        </Shape>
                        <String CONTENT="exceedingly intricate, owing to the invasion of the Yakut, who assimilated all"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l7" HPOS="372" VPOS="1045" WIDTH="1771" HEIGHT="59" BASELINE="374 1088 2143 1084" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1088 374 1104 2141 1099 2143 1084 2139 1054 394 1045 391 1045 389 1045 387 1045 372 1052 374 1088"/>
                        </Shape>
                        <String CONTENT="the smaller tribes, and modified in many respects their original cultures. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l8" HPOS="374" VPOS="1112" WIDTH="1769" HEIGHT="52" BASELINE="376 1149 2143 1143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1149 376 1164 2141 1158 2143 1143 2139 1112 374 1112 376 1149"/>
                        </Shape>
                        <String CONTENT="Tungus do not use the dog with their herds. Their lean, small, and nimble-"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l9" HPOS="374" VPOS="1175" WIDTH="1769" HEIGHT="50" BASELINE="374 1205 2143 1205" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1205 374 1225 2143 1225 2143 1205 2143 1175 374 1175 374 1205"/>
                        </Shape>
                        <String CONTENT="footed dogs are used only for hunting-purposes, and they retain all the ferocious"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l10" HPOS="374" VPOS="1223" WIDTH="1769" HEIGHT="58" BASELINE="376 1268 2143 1264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1268 376 1281 2141 1277 2143 1264 2141 1236 2113 1223 2111 1223 2109 1223 2107 1223 2085 1234 2063 1223 2061 1223 2059 1223 2057 1223 2029 1236 1801 1236 1786 1223 1784 1223 1782 1223 1780 1223 1715 1234 1580 1223 1578 1223 1360 1234 1275 1223 1273 1223 1271 1223 1269 1223 1249 1236 1082 1225 1080 1225 1013 1236 900 1225 898 1225 896 1225 851 1236 820 1225 818 1225 816 1225 814 1225 777 1236 645 1225 643 1225 374 1229 376 1268"/>
                        </Shape>
                        <String CONTENT="habits of former freedom. They consider all reindeer, wild or tame, their"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l11" HPOS="374" VPOS="1286" WIDTH="1769" HEIGHT="58" BASELINE="374 1329 2143 1329" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1329 374 1344 2143 1344 2143 1329 2143 1299 2087 1286 2085 1286 1931 1299 1825 1299 1810 1286 1808 1286 1806 1286 1803 1286 1721 1296 1678 1286 1676 1286 1674 1286 1563 1299 1336 1299 1316 1286 1314 1286 1312 1286 1310 1286 1308 1286 1273 1296 1173 1286 1171 1286 1169 1286 1139 1296 374 1290 374 1329"/>
                        </Shape>
                        <String CONTENT="lawful prey: therefore in camp these dogs are carefully tied up; otherwise"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l12" HPOS="374" VPOS="1357" WIDTH="1769" HEIGHT="45" BASELINE="374 1387 2143 1387" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1387 374 1402 2143 1402 2143 1387 2143 1357 374 1357 374 1387"/>
                        </Shape>
                        <String CONTENT="they would give chase to the herd and disperse it in every direction. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l13" HPOS="370" VPOS="1413" WIDTH="1771" HEIGHT="52" BASELINE="372 1446 2141 1450" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1446 370 1459 2137 1465 2141 1450 2139 1418 372 1413 372 1446"/>
                        </Shape>
                        <String CONTENT="reindeer are less thoroughly domesticated than among the western tribes,"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l14" HPOS="374" VPOS="1474" WIDTH="1769" HEIGHT="52" BASELINE="374 1506 2143 1506" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1506 374 1526 2143 1526 2143 1506 2141 1474 374 1474 374 1506"/>
                        </Shape>
                        <String CONTENT="though tame enough to be milked, and used for regular service with post and"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l15" HPOS="374" VPOS="1537" WIDTH="442" HEIGHT="49" BASELINE="374 1567 816 1567" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1567 374 1586 816 1586 816 1567 816 1537 374 1537 374 1567"/>
                        </Shape>
                        <String CONTENT="merchant caravans."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-097_r3" HPOS="370" VPOS="1585" WIDTH="1778" HEIGHT="777" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 1585 2148 1585 2148 2362 370 2362"/>
                    </Shape>
                    <TextLine ID="mz_1-097_l16" HPOS="480" VPOS="1580" WIDTH="1661" HEIGHT="69" BASELINE="482 1623 2141 1628" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="482 1623 480 1638 498 1649 500 1649 502 1649 504 1649 2139 1643 2141 1628 2139 1595 2055 1582 2053 1582 2050 1582 2003 1593 1949 1582 1946 1582 1884 1593 1860 1582 1858 1582 1855 1582 1687 1595 1520 1595 1505 1582 1502 1582 1500 1582 1498 1582 1210 1591 1197 1580 1195 1580 1193 1580 1191 1580 1188 1580 1158 1591 1074 1580 1071 1580 1069 1580 1046 1591 1028 1580 1026 1580 1024 1580 1022 1580 1020 1580 996 1591 972 1580 970 1580 968 1580 916 1591 885 1580 883 1580 881 1580 879 1580 877 1580 859 1593 773 1593 760 1580 757 1580 755 1580 753 1580 751 1580 749 1580 734 1591 649 1580 647 1580 482 1586 482 1623"/>
                        </Shape>
                        <String CONTENT="The Koryak and Chukchee form the third group of reindeer-breeders,"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l17" HPOS="370" VPOS="1643" WIDTH="1773" HEIGHT="60" BASELINE="372 1688 2143 1684" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1688 372 1703 2141 1699 2143 1684 2139 1654 1258 1643 1256 1643 1253 1643 1219 1654 443 1645 441 1645 370 1656 372 1688"/>
                        </Shape>
                        <String CONTENT="and live to the east and north of the Tungus. Like the tribes of the extreme"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l18" HPOS="372" VPOS="1701" WIDTH="1771" HEIGHT="63" BASELINE="374 1749 2143 1742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1749 374 1764 2141 1757 2143 1742 2141 1714 2109 1701 2107 1701 2105 1701 2102 1701 2100 1701 2083 1712 1964 1701 1962 1701 1959 1701 1933 1712 1912 1701 1910 1701 1907 1701 1905 1701 1877 1712 1855 1701 1853 1701 1851 1701 1849 1701 1847 1701 1832 1714 1715 1714 1641 1701 1639 1701 1576 1712 1554 1701 1552 1701 1550 1701 1548 1701 1546 1701 1524 1714 1340 1703 1338 1703 1336 1703 1334 1703 1321 1714 1292 1703 1290 1703 1288 1703 1286 1703 1243 1714 1191 1703 1188 1703 1186 1703 1154 1714 1093 1703 1091 1703 1041 1714 998 1703 996 1703 994 1703 991 1703 944 1716 537 1706 534 1706 532 1706 530 1706 513 1716 465 1708 463 1708 372 1719 374 1749"/>
                        </Shape>
                        <String CONTENT="west, they use reindeer only with the sledge, not for riding, and their herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l19" HPOS="370" VPOS="1775" WIDTH="1776" HEIGHT="50" BASELINE="372 1809 2146 1805" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1809 372 1825 2143 1820 2146 1805 2139 1775 370 1777 372 1809"/>
                        </Shape>
                        <String CONTENT="are very numerous, perhaps the most numerous in the world; but the degree"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l20" HPOS="374" VPOS="1838" WIDTH="1772" HEIGHT="45" BASELINE="374 1868 2146 1868" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1868 374 1883 2146 1883 2146 1868 2146 1838 374 1838 374 1868"/>
                        </Shape>
                        <String CONTENT="of domestication is very imperfect. One is almost tempted to assume that"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l21" HPOS="372" VPOS="1883" WIDTH="1771" HEIGHT="61" BASELINE="374 1929 2143 1924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1929 374 1944 2141 1939 2143 1924 2139 1894 1271 1883 1269 1883 1199 1894 394 1885 391 1885 389 1885 387 1885 372 1892 374 1929"/>
                        </Shape>
                        <String CONTENT="they did not introduce the tame reindeer from their neighbors, but that, in"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l22" HPOS="372" VPOS="1942" WIDTH="1771" HEIGHT="64" BASELINE="374 1989 2143 1985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1989 374 2004 2139 2006 2143 1985 2139 1952 1364 1942 1362 1942 1210 1954 372 1954 374 1989"/>
                        </Shape>
                        <String CONTENT="imitation of them, they attempted to domesticate the race of reindeer inhabiting"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l23" HPOS="372" VPOS="2002" WIDTH="1769" HEIGHT="63" BASELINE="374 2050 2141 2043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2050 374 2065 2139 2058 2141 2043 2137 2015 2061 2002 2059 2002 2057 2002 2035 2013 2011 2002 2009 2002 2007 2002 2005 2002 1983 2013 1855 2002 1853 2002 1760 2013 1728 2002 1726 2002 1723 2002 1665 2013 1593 2002 1591 2002 1589 2002 1544 2015 1531 2004 1528 2004 1526 2004 1524 2004 1522 2004 1479 2015 1273 2004 1271 2004 1269 2004 1245 2017 1113 2017 1054 2004 1052 2004 959 2017 931 2006 929 2006 926 2006 489 2017 391 2006 389 2006 387 2006 385 2006 372 2015 374 2050"/>
                        </Shape>
                        <String CONTENT="their own country. This would seem the more plausible, since their reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l24" HPOS="374" VPOS="2071" WIDTH="1769" HEIGHT="52" BASELINE="374 2106 2143 2106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2106 374 2123 2143 2123 2143 2106 2141 2071 374 2071 374 2106"/>
                        </Shape>
                        <String CONTENT="is quite different from that of the Tungus. Their dogs are likewise the natural"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l25" HPOS="374" VPOS="2136" WIDTH="1769" HEIGHT="48" BASELINE="374 2167 2143 2167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2167 374 2184 2143 2184 2143 2167 2143 2136 374 2136 374 2167"/>
                        </Shape>
                        <String CONTENT="foes of the reindeer-herds, and the latter are so wild that they return easily"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l26" HPOS="374" VPOS="2184" WIDTH="1769" HEIGHT="61" BASELINE="374 2227 2143 2227" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2227 374 2245 2143 2245 2143 2227 2143 2195 2115 2184 2113 2184 2111 2184 2109 2184 2079 2195 2053 2184 2050 2184 2048 2184 1972 2195 1739 2184 1736 2184 1648 2195 1617 2184 1615 2184 1613 2184 1611 2184 1587 2195 1561 2184 1559 2184 1557 2184 1446 2195 1373 2184 1370 2184 1279 2195 1227 2184 1225 2184 1223 2184 1201 2195 1175 2184 1173 2184 1171 2184 1115 2195 981 2184 978 2184 976 2184 974 2184 959 2197 868 2197 835 2184 833 2184 831 2184 829 2184 792 2195 749 2184 747 2184 744 2184 742 2184 740 2184 725 2197 615 2197 584 2184 582 2184 580 2184 578 2184 552 2195 524 2184 521 2184 519 2184 517 2184 495 2195 469 2184 467 2184 465 2184 374 2195 374 2227"/>
                        </Shape>
                        <String CONTENT="to their former freedom. Milking is impossible; and the reindeer are difficult"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l27" HPOS="372" VPOS="2247" WIDTH="1771" HEIGHT="58" BASELINE="374 2288 2143 2284" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2288 374 2305 2141 2301 2143 2284 2139 2255 391 2247 389 2247 387 2247 385 2247 372 2253 374 2288"/>
                        </Shape>
                        <String CONTENT="to manage even in harness, and are unable to endure prolonged and regular"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l28" HPOS="374" VPOS="2307" WIDTH="182" HEIGHT="57" BASELINE="374 2344 556 2344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2344 374 2364 556 2364 556 2344 554 2307 374 2314 374 2344"/>
                        </Shape>
                        <String CONTENT="service.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-097_r4" HPOS="370" VPOS="2362" WIDTH="1778" HEIGHT="675" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 2362 2148 2362 2148 3037 370 3037"/>
                    </Shape>
                    <TextLine ID="mz_1-097_l29" HPOS="478" VPOS="2362" WIDTH="1665" HEIGHT="60" BASELINE="480 2407 2143 2403" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="480 2407 480 2422 2141 2420 2143 2403 2139 2372 1386 2362 1383 2362 1260 2375 478 2375 480 2407"/>
                        </Shape>
                        <String CONTENT="BEGINNING OF KORYAK AND CHUKCHEE REINDEER-BREEDING. — Although"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l30" HPOS="374" VPOS="2437" WIDTH="1772" HEIGHT="46" BASELINE="374 2468 2146 2468" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2468 374 2483 2146 2483 2146 2468 2146 2437 374 2437 374 2468"/>
                        </Shape>
                        <String CONTENT="at present the herds of the Koryak and Chukchee are numerous, it was"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l31" HPOS="372" VPOS="2483" WIDTH="1774" HEIGHT="67" BASELINE="374 2528 2146 2524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2528 374 2550 2143 2537 2146 2524 2141 2494 1279 2483 1277 2483 1275 2483 1253 2494 450 2485 448 2485 372 2496 374 2528"/>
                        </Shape>
                        <String CONTENT="probably otherwise in former times. Among the various Koryak bands in"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l32" HPOS="372" VPOS="2541" WIDTH="1774" HEIGHT="63" BASELINE="374 2587 2146 2582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2587 374 2604 2143 2600 2146 2582 2141 2554 2089 2541 2087 2541 2085 2541 2061 2552 1853 2541 1851 2541 1849 2541 1825 2554 1632 2554 1604 2541 1602 2541 1600 2541 1531 2552 1474 2541 1472 2541 1470 2541 1448 2552 1392 2541 1390 2541 1388 2541 1362 2552 1301 2541 1299 2541 1297 2541 1243 2554 1173 2543 1171 2543 838 2554 807 2543 805 2543 593 2543 591 2543 589 2543 563 2554 467 2543 465 2543 372 2556 374 2587"/>
                        </Shape>
                        <String CONTENT="northern Kamchatka and around Baron Korff’s Bay there are still some who"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l33" HPOS="374" VPOS="2600" WIDTH="1769" HEIGHT="62" BASELINE="376 2647 2143 2641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2647 376 2662 2141 2660 2143 2641 2137 2608 1624 2610 1554 2600 1552 2600 1550 2600 1548 2600 1533 2613 1286 2602 1284 2602 1282 2602 1249 2613 1180 2602 1178 2602 1126 2613 1039 2602 1037 2602 825 2615 803 2604 801 2604 589 2604 586 2604 584 2604 563 2615 461 2604 459 2604 374 2617 376 2647"/>
                        </Shape>
                        <String CONTENT="combine seal-hunting with reindeer-breeding; and while one part of the band"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l34" HPOS="376" VPOS="2671" WIDTH="1767" HEIGHT="54" BASELINE="376 2708 2143 2708" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2708 376 2723 2139 2725 2143 2708 2141 2675 376 2671 376 2708"/>
                        </Shape>
                        <String CONTENT="is settled in huts on the coast, fishing and hunting, the other part is wandering"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l35" HPOS="374" VPOS="2721" WIDTH="1769" HEIGHT="61" BASELINE="376 2769 2143 2762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2769 376 2782 2141 2779 2143 2762 2139 2734 1855 2721 1853 2721 1754 2732 1721 2721 1719 2721 1717 2721 1548 2734 1318 2723 1316 2723 1236 2734 1180 2723 1178 2723 1175 2723 1173 2723 1156 2736 1054 2736 1015 2723 1013 2723 1011 2723 744 2736 567 2725 565 2725 515 2736 502 2725 500 2725 498 2725 404 2725 402 2725 400 2725 374 2736 376 2769"/>
                        </Shape>
                        <String CONTENT="about with its reindeer-herds on the neighboring mountains. Usually each"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l36" HPOS="376" VPOS="2790" WIDTH="1767" HEIGHT="54" BASELINE="376 2825 2143 2825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2825 376 2844 2141 2844 2143 2825 2141 2797 376 2790 376 2825"/>
                        </Shape>
                        <String CONTENT="band has only one village on the coast, but several inland camps, each with"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l37" HPOS="376" VPOS="2842" WIDTH="1767" HEIGHT="61" BASELINE="378 2885 2143 2881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 2885 378 2903 2141 2898 2143 2881 2139 2853 1260 2842 1258 2842 1256 2842 1208 2853 493 2844 491 2844 376 2855 378 2885"/>
                        </Shape>
                        <String CONTENT="one herd. There is a constant interchanging of the inhabitants between the"/>
                    </TextLine>

                    <TextLine ID="mz_1-097_l38" HPOS="374" VPOS="2911" WIDTH="1772" HEIGHT="50" BASELINE="376 2942 2146 2946" TAGREFS="TYPE_5">
