                    </Shape>
                    <TextLine ID="mz_1-344_l1" HPOS="1171" VPOS="643" WIDTH="615" HEIGHT="54" BASELINE="1171 677 1786 677" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1777 643 1171 643 1171 677 1171 697 1786 697 1786 677 1786 651 1777 643"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l2" HPOS="593" VPOS="636" WIDTH="108" HEIGHT="58" BASELINE="593 679 701 679" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="690 647 643 636 641 636 638 636 593 647 593 679 593 694 701 694 701 679 701 653 690 647"/>
                        </Shape>
                        <String CONTENT="266"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r2" HPOS="595" VPOS="745" WIDTH="1778" HEIGHT="186" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="595 745 2373 745 2373 931 595 931"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l3" HPOS="589" VPOS="744" WIDTH="1775" HEIGHT="61" BASELINE="589 788 2364 788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 788 589 805 2364 805 2364 788 2364 757 1842 744 1840 744 1838 744 1836 744 1821 757 1609 757 1572 744 1570 744 1567 744 1565 744 1541 755 1505 744 1502 744 1500 744 1422 755 1368 744 1366 744 1364 744 1340 755 1312 744 1310 744 1308 744 1253 755 1217 744 1214 744 1212 744 1210 744 1165 755 1115 744 1113 744 1110 744 1067 755 955 744 952 744 898 755 783 744 781 744 779 744 736 755 654 744 651 744 589 755 589 788"/>
                        </Shape>
                        <String CONTENT="swiftly driven sledge, keeping it from tipping over. After twenty-four hours"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l4" HPOS="589" VPOS="818" WIDTH="1775" HEIGHT="45" BASELINE="589 846 2364 846" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 846 589 863 2364 863 2364 846 2364 818 589 818 589 846"/>
                        </Shape>
                        <String CONTENT="of this painful exercise, the driver is often so tired, that, on reaching the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l5" HPOS="586" VPOS="863" WIDTH="1594" HEIGHT="67" BASELINE="589 909 2180 904" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 909 589 930 2178 922 2180 904 2176 876 1667 863 1665 863 1663 863 1639 874 1589 863 1587 863 1585 863 1583 863 1567 876 1472 876 1383 863 1381 863 1379 863 1340 876 946 866 944 866 942 866 939 866 922 876 887 866 885 866 883 866 803 876 744 866 742 866 664 876 625 866 623 866 621 866 619 866 586 876 589 909"/>
                        </Shape>
                        <String CONTENT="place, he reels like one drunk, and has to be helped into the house."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r3" HPOS="595" VPOS="931" WIDTH="1778" HEIGHT="121" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="595 931 2373 931 2373 1052 595 1052"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l6" HPOS="693" VPOS="926" WIDTH="1671" HEIGHT="59" BASELINE="695 967 2364 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="695 967 695 985 2362 980 2364 963 2360 935 710 926 708 926 706 926 703 926 693 933 695 967"/>
                        </Shape>
                        <String CONTENT="Of two drivers who took part in the dog-race of 1869, which I mentioned"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l7" HPOS="591" VPOS="991" WIDTH="1750" HEIGHT="54" BASELINE="591 1026 2341 1026" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1026 591 1045 2341 1045 2341 1026 2341 995 591 991 591 1026"/>
                        </Shape>
                        <String CONTENT="before, the victor so impaired his health by the strain that he never recovered."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r4" HPOS="595" VPOS="1052" WIDTH="1778" HEIGHT="180" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="595 1052 2373 1052 2373 1232 595 1232"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l8" HPOS="697" VPOS="1052" WIDTH="1667" HEIGHT="52" BASELINE="699 1088 2364 1084" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="699 1088 699 1104 2362 1099 2364 1084 2360 1054 697 1052 699 1088"/>
                        </Shape>
                        <String CONTENT="The young girls and women among the Chukchee have foot-races of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l9" HPOS="589" VPOS="1112" WIDTH="1773" HEIGHT="57" BASELINE="591 1143 2362 1147" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1143 589 1160 602 1169 604 1169 606 1169 608 1169 2360 1160 2362 1147 2360 1117 591 1112 591 1143"/>
                        </Shape>
                        <String CONTENT="own, which they are as eager to win as the men. Often foot-races are run by"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l10" HPOS="589" VPOS="1171" WIDTH="1150" HEIGHT="60" BASELINE="591 1203 1739 1208" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1203 589 1214 632 1229 634 1229 636 1231 710 1231 710 1229 712 1229 714 1229 714 1227 725 1218 840 1218 853 1229 855 1229 857 1229 859 1229 1160 1218 1188 1229 1191 1229 1193 1229 1635 1221 1693 1231 1695 1231 1697 1231 1736 1218 1739 1208 1736 1177 591 1171 591 1203"/>
                        </Shape>
                        <String CONTENT="boys, who compete with fellows of their own age."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r5" HPOS="595" VPOS="1232" WIDTH="1778" HEIGHT="419" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="595 1232 2373 1232 2373 1651 595 1651"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l11" HPOS="701" VPOS="1227" WIDTH="1663" HEIGHT="56" BASELINE="701 1266 2364 1266" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="701 1266 701 1283 2364 1283 2364 1266 2364 1236 701 1227 701 1266"/>
                        </Shape>
                        <String CONTENT="Wrestling usually takes place after the foot-race, because the wrestlers"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l12" HPOS="589" VPOS="1283" WIDTH="1773" HEIGHT="59" BASELINE="589 1327 2362 1327" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 1327 589 1342 2362 1342 2362 1327 2362 1296 2310 1283 2308 1283 2306 1283 2280 1294 2169 1283 2167 1283 2068 1294 2042 1283 2040 1283 2037 1283 2035 1283 1990 1294 1944 1283 1942 1283 1940 1283 1938 1283 1905 1294 1879 1283 1877 1283 1875 1283 1873 1283 1851 1294 1823 1283 1821 1283 1819 1283 1816 1283 1814 1283 1797 1294 1773 1283 1771 1283 1769 1283 1671 1294 1628 1283 1626 1283 1624 1283 1531 1294 1453 1283 1450 1283 1448 1283 1446 1283 1429 1294 1351 1283 1349 1283 1347 1283 1321 1294 1292 1283 1290 1283 1288 1283 1184 1294 1132 1283 1130 1283 1015 1294 989 1283 987 1283 985 1283 874 1294 844 1283 842 1283 840 1283 838 1283 809 1294 781 1283 779 1283 777 1283 690 1294 656 1283 654 1283 651 1283 589 1294 589 1327"/>
                        </Shape>
                        <String CONTENT="strip naked to the waist, and they like to have their bodies heated by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l13" HPOS="589" VPOS="1346" WIDTH="1773" HEIGHT="65" BASELINE="591 1389 2362 1385" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1389 591 1411 2360 1400 2362 1385 2358 1346 688 1346 686 1346 589 1357 591 1389"/>
                        </Shape>
                        <String CONTENT="previous exercise. If there is no foot-race, the wrestlers will run a couple of"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l14" HPOS="589" VPOS="1411" WIDTH="1771" HEIGHT="56" BASELINE="591 1444 2360 1450" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1444 589 1459 599 1467 602 1467 604 1467 606 1467 2358 1465 2360 1450 2358 1418 591 1411 591 1444"/>
                        </Shape>
                        <String CONTENT="miles to get warmed up for their contests. While the couples are wrestling,"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l15" HPOS="591" VPOS="1476" WIDTH="1771" HEIGHT="45" BASELINE="591 1504 2362 1504" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1504 591 1521 2362 1521 2362 1504 2362 1476 591 1476 591 1504"/>
                        </Shape>
                        <String CONTENT="the rest of the people sit or stand around to judge the matches. Sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l16" HPOS="591" VPOS="1537" WIDTH="1771" HEIGHT="45" BASELINE="591 1565 2362 1565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1565 591 1582 2362 1582 2362 1565 2362 1537 591 1537 591 1565"/>
                        </Shape>
                        <String CONTENT="two or three pairs wrestle at the same time. After stripping, the men, just"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l17" HPOS="591" VPOS="1591" WIDTH="1275" HEIGHT="50" BASELINE="591 1625 1866 1625" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1625 591 1641 1866 1641 1866 1625 1866 1595 591 1591 591 1625"/>
                        </Shape>
                        <String CONTENT="before the contest, rub their bodies all over with snow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r6" HPOS="595" VPOS="1651" WIDTH="1778" HEIGHT="1136" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="595 1651 2373 1651 2373 2787 595 2787"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l18" HPOS="699" VPOS="1649" WIDTH="1665" HEIGHT="52" BASELINE="699 1686 2364 1686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="699 1686 699 1701 2364 1701 2364 1686 2364 1656 699 1649 699 1686"/>
                        </Shape>
                        <String CONTENT="The rules of the contest require that one man shall assume a posture"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l19" HPOS="589" VPOS="1701" WIDTH="1773" HEIGHT="61" BASELINE="591 1747 2362 1742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1747 591 1762 2360 1762 2362 1742 2358 1712 2280 1701 2278 1701 2187 1712 2165 1701 2163 1701 2161 1701 2087 1712 2057 1701 2055 1701 2053 1701 1983 1712 1925 1701 1923 1701 1845 1712 1769 1701 1767 1701 1765 1701 1734 1712 1624 1701 1622 1701 1619 1701 1617 1701 1598 1712 877 1703 874 1703 872 1703 835 1714 764 1703 762 1703 671 1714 628 1703 625 1703 623 1703 621 1703 589 1714 591 1747"/>
                        </Shape>
                        <String CONTENT="of passive defence, and the other try to throw him. The first is called"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l20" HPOS="595" VPOS="1768" WIDTH="1767" HEIGHT="59" BASELINE="597 1801 2362 1807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="597 1801 595 1814 628 1827 630 1827 632 1827 2360 1820 2362 1807 2360 1775 597 1768 597 1801"/>
                        </Shape>
                        <String CONTENT="“motionless” (uˊlvɪlɪn); the second, “the attacking one” (viriˊtɪlɪn). If the latter"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l21" HPOS="591" VPOS="1835" WIDTH="1771" HEIGHT="55" BASELINE="591 1866 2362 1866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1866 591 1890 2362 1881 2362 1866 2362 1835 591 1835 591 1866"/>
                        </Shape>
                        <String CONTENT="proves unsuccessful, the positions are reversed. Finally there usually follows"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l22" HPOS="591" VPOS="1896" WIDTH="1771" HEIGHT="46" BASELINE="591 1924 2362 1924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1924 591 1942 2362 1942 2362 1924 2362 1896 591 1896 591 1924"/>
                        </Shape>
                        <String CONTENT="a rough-and-tumble scramble, in which each of the contestants tries every"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l23" HPOS="591" VPOS="1954" WIDTH="1771" HEIGHT="46" BASELINE="591 1985 2362 1985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1985 591 2000 2362 2000 2362 1985 2362 1954 591 1954 591 1985"/>
                        </Shape>
                        <String CONTENT="means to get the better of his adversary. Custom requires that one of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l24" HPOS="591" VPOS="2011" WIDTH="1771" HEIGHT="54" BASELINE="591 2043 2362 2048" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2043 591 2065 2360 2058 2362 2048 2360 2015 591 2011 591 2043"/>
                        </Shape>
                        <String CONTENT="parties be made to touch the ground with both of his shoulders, and kept"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l25" HPOS="586" VPOS="2069" WIDTH="1774" HEIGHT="59" BASELINE="589 2102 2360 2106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2102 586 2115 671 2128 673 2128 2358 2126 2360 2106 2358 2074 589 2069 589 2102"/>
                        </Shape>
                        <String CONTENT="in this position in spite of his struggles. Three bouts are regarded as settling"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l26" HPOS="591" VPOS="2136" WIDTH="1771" HEIGHT="54" BASELINE="591 2165 2362 2165" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2165 591 2177 833 2190 835 2190 838 2190 864 2180 1186 2190 1188 2190 1355 2180 1892 2180 1966 2190 1968 2190 2120 2180 2258 2190 2260 2190 2263 2190 2265 2190 2282 2180 2338 2190 2341 2190 2343 2190 2345 2190 2362 2180 2362 2165 2362 2136 591 2136 591 2165"/>
                        </Shape>
                        <String CONTENT="the match, but the vanquished one often desires to keep on trying his"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l27" HPOS="589" VPOS="2195" WIDTH="1773" HEIGHT="45" BASELINE="589 2225 2362 2225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2225 589 2240 2362 2240 2362 2225 2362 2195 589 2195 589 2225"/>
                        </Shape>
                        <String CONTENT="chances. Frequently he becomes greatly excited, and then a violent scuffle"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l28" HPOS="589" VPOS="2251" WIDTH="1771" HEIGHT="56" BASELINE="591 2284 2360 2288" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2284 589 2294 641 2307 643 2307 2358 2303 2360 2288 2358 2255 591 2251 591 2284"/>
                        </Shape>
                        <String CONTENT="may ensue. The victor has to meet the winner of any other contests: but,"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l29" HPOS="589" VPOS="2305" WIDTH="1771" HEIGHT="54" BASELINE="591 2342 2360 2346" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2342 589 2355 2356 2359 2360 2346 2358 2310 591 2305 591 2342"/>
                        </Shape>
                        <String CONTENT="lest he should become too tired, he will step back after a few matches and"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l30" HPOS="589" VPOS="2375" WIDTH="1773" HEIGHT="45" BASELINE="589 2405 2362 2405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2405 589 2420 2362 2420 2362 2405 2362 2375 589 2375 589 2405"/>
                        </Shape>
                        <String CONTENT="return in a half-hour or so to try his chance once more. This continues until"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l31" HPOS="591" VPOS="2433" WIDTH="1771" HEIGHT="45" BASELINE="591 2463 2362 2463" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2463 591 2478 2362 2478 2362 2463 2362 2433 591 2433 591 2463"/>
                        </Shape>
                        <String CONTENT="the best man is determined, and he takes the stake if there is one. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l32" HPOS="591" VPOS="2494" WIDTH="1771" HEIGHT="52" BASELINE="591 2524 2362 2524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2524 591 2546 2362 2539 2362 2524 2362 2494 591 2494 591 2524"/>
                        </Shape>
                        <String CONTENT="passions are aroused quite enough, however, without stakes, so that prizes"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l33" HPOS="586" VPOS="2539" WIDTH="1776" HEIGHT="67" BASELINE="589 2580 2362 2585" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2580 586 2593 740 2606 742 2606 2360 2598 2362 2585 2360 2554 2308 2541 2306 2541 1756 2552 1728 2541 1726 2541 1723 2541 1721 2541 1719 2541 1708 2552 1695 2541 1693 2541 1691 2541 1546 2541 1544 2541 1541 2541 1502 2552 1433 2539 1431 2539 1429 2539 1386 2552 1208 2552 1188 2539 1186 2539 1184 2539 1182 2539 1123 2550 1067 2539 1065 2539 1063 2539 1028 2552 799 2552 775 2539 773 2539 770 2539 589 2548 589 2580"/>
                        </Shape>
                        <String CONTENT="are seldom put up for this sport. Several Chukchee tales describe a peculiar"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l34" HPOS="589" VPOS="2608" WIDTH="1773" HEIGHT="61" BASELINE="591 2639 2362 2643" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2639 589 2654 753 2667 755 2667 1450 2658 1476 2669 1479 2669 1481 2669 2360 2658 2362 2643 2360 2613 591 2608 591 2639"/>
                        </Shape>
                        <String CONTENT="wrestling-match that takes place on a spread walrus-skin, slippery with blubber"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l35" HPOS="586" VPOS="2669" WIDTH="1776" HEIGHT="50" BASELINE="589 2699 2362 2704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2699 586 2714 2358 2719 2362 2704 2360 2669 589 2669 589 2699"/>
                        </Shape>
                        <String CONTENT="and made dangerous by having sharp splinters of bone or wood stuck around"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l36" HPOS="589" VPOS="2723" WIDTH="1689" HEIGHT="56" BASELINE="589 2762 2278 2762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2762 589 2779 2276 2779 2278 2762 2273 2723 589 2725 589 2762"/>
                        </Shape>
                        <String CONTENT="its edge. Similar details are mentioned also in Eskimo and Indian tales.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-344_r7" HPOS="595" VPOS="2787" WIDTH="1778" HEIGHT="300" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="595 2787 2373 2787 2373 3087 595 3087"/>
                    </Shape>
                    <TextLine ID="mz_1-344_l37" HPOS="697" VPOS="2782" WIDTH="1663" HEIGHT="69" BASELINE="699 2818 2360 2825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="699 2818 697 2833 706 2842 706 2844 708 2844 710 2844 712 2844 781 2836 937 2846 939 2846 1726 2838 1851 2851 1853 2851 1901 2840 1914 2851 1916 2851 1918 2851 1920 2851 2358 2838 2360 2825 2358 2795 1858 2795 1806 2782 1803 2782 699 2786 699 2818"/>
                        </Shape>
                        <String CONTENT="A wrestling-match is the usual method of settling quarrels among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l38" HPOS="584" VPOS="2849" WIDTH="1776" HEIGHT="52" BASELINE="586 2883 2360 2879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 2883 586 2901 2358 2901 2360 2879 2354 2849 584 2851 586 2883"/>
                        </Shape>
                        <String CONTENT="Chukchee. A man having a grudge against another one will either openly"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l39" HPOS="586" VPOS="2909" WIDTH="1772" HEIGHT="48" BASELINE="589 2940 2358 2944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2940 586 2953 2354 2957 2358 2944 2356 2914 589 2909 589 2940"/>
                        </Shape>
                        <String CONTENT="challenge him for a match or he will seek a chance to encounter him in a"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l40" HPOS="589" VPOS="2972" WIDTH="1771" HEIGHT="50" BASELINE="589 3002 2360 3002" TAGREFS="TYPE_5">
                        <Shape>
