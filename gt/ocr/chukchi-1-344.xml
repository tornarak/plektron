        <Page WIDTH="2781" HEIGHT="3866" PHYSICAL_IMG_NR="0" ID="page_0">
            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-344" HPOS="563" VPOS="621" WIDTH="1780" HEIGHT="2633"><TextLine ID="mz_1-344_l1" HPOS="1150" VPOS="628" WIDTH="615" HEIGHT="54" BASELINE="1150 662 1765 662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1756 628 1150 628 1150 662 1150 682 1765 682 1765 662 1765 636 1756 628"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l2" HPOS="572" VPOS="621" WIDTH="108" HEIGHT="58" BASELINE="572 664 680 664" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="669 632 622 621 620 621 617 621 572 632 572 664 572 679 680 679 680 664 680 638 669 632"/>
                        </Shape>
                        <String CONTENT="266"/>
                    </TextLine>
<TextLine ID="mz_1-344_l3" HPOS="568" VPOS="729" WIDTH="1775" HEIGHT="61" BASELINE="568 773 2343 773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 773 568 790 2343 790 2343 773 2343 742 1821 729 1819 729 1817 729 1815 729 1800 742 1588 742 1551 729 1549 729 1546 729 1544 729 1520 740 1484 729 1481 729 1479 729 1401 740 1347 729 1345 729 1343 729 1319 740 1291 729 1289 729 1287 729 1232 740 1196 729 1193 729 1191 729 1189 729 1144 740 1094 729 1092 729 1089 729 1046 740 934 729 931 729 877 740 762 729 760 729 758 729 715 740 633 729 630 729 568 740 568 773"/>
                        </Shape>
                        <String CONTENT="swiftly driven sledge, keeping it from tipping over. After twenty-four hours"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l4" HPOS="568" VPOS="803" WIDTH="1775" HEIGHT="45" BASELINE="568 831 2343 831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 831 568 848 2343 848 2343 831 2343 803 568 803 568 831"/>
                        </Shape>
                        <String CONTENT="of this painful exercise, the driver is often so tired, that, on reaching the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l5" HPOS="565" VPOS="848" WIDTH="1594" HEIGHT="67" BASELINE="568 894 2159 889" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 894 568 915 2157 907 2159 889 2155 861 1646 848 1644 848 1642 848 1618 859 1568 848 1566 848 1564 848 1562 848 1546 861 1451 861 1362 848 1360 848 1358 848 1319 861 925 851 923 851 921 851 918 851 901 861 866 851 864 851 862 851 782 861 723 851 721 851 643 861 604 851 602 851 600 851 598 851 565 861 568 894"/>
                        </Shape>
                        <String CONTENT="place, he reels like one drunk, and has to be helped into the house."/>
                    </TextLine>
<TextLine ID="mz_1-344_l6" HPOS="672" VPOS="911" WIDTH="1671" HEIGHT="59" BASELINE="674 952 2343 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="674 952 674 970 2341 965 2343 948 2339 920 689 911 687 911 685 911 682 911 672 918 674 952"/>
                        </Shape>
                        <String CONTENT="Of two drivers who took part in the dog-race of 1869, which I mentioned"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l7" HPOS="570" VPOS="976" WIDTH="1750" HEIGHT="54" BASELINE="570 1011 2320 1011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1011 570 1030 2320 1030 2320 1011 2320 980 570 976 570 1011"/>
                        </Shape>
                        <String CONTENT="before, the victor so impaired his health by the strain that he never recovered."/>
                    </TextLine>
<TextLine ID="mz_1-344_l8" HPOS="676" VPOS="1037" WIDTH="1667" HEIGHT="52" BASELINE="678 1073 2343 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="678 1073 678 1089 2341 1084 2343 1069 2339 1039 676 1037 678 1073"/>
                        </Shape>
                        <String CONTENT="The young girls and women among the Chukchee have foot-races of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l9" HPOS="568" VPOS="1097" WIDTH="1773" HEIGHT="57" BASELINE="570 1128 2341 1132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1128 568 1145 581 1154 583 1154 585 1154 587 1154 2339 1145 2341 1132 2339 1102 570 1097 570 1128"/>
                        </Shape>
                        <String CONTENT="own, which they are as eager to win as the men. Often foot-races are run by"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l10" HPOS="568" VPOS="1156" WIDTH="1150" HEIGHT="60" BASELINE="570 1188 1718 1193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1188 568 1199 611 1214 613 1214 615 1216 689 1216 689 1214 691 1214 693 1214 693 1212 704 1203 819 1203 832 1214 834 1214 836 1214 838 1214 1139 1203 1167 1214 1170 1214 1172 1214 1614 1206 1672 1216 1674 1216 1676 1216 1715 1203 1718 1193 1715 1162 570 1156 570 1188"/>
                        </Shape>
                        <String CONTENT="boys, who compete with fellows of their own age."/>
                    </TextLine>
<TextLine ID="mz_1-344_l11" HPOS="680" VPOS="1212" WIDTH="1663" HEIGHT="56" BASELINE="680 1251 2343 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 1251 680 1268 2343 1268 2343 1251 2343 1221 680 1212 680 1251"/>
                        </Shape>
                        <String CONTENT="Wrestling usually takes place after the foot-race, because the wrestlers"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l12" HPOS="568" VPOS="1268" WIDTH="1773" HEIGHT="59" BASELINE="568 1312 2341 1312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 1312 568 1327 2341 1327 2341 1312 2341 1281 2289 1268 2287 1268 2285 1268 2259 1279 2148 1268 2146 1268 2047 1279 2021 1268 2019 1268 2016 1268 2014 1268 1969 1279 1923 1268 1921 1268 1919 1268 1917 1268 1884 1279 1858 1268 1856 1268 1854 1268 1852 1268 1830 1279 1802 1268 1800 1268 1798 1268 1795 1268 1793 1268 1776 1279 1752 1268 1750 1268 1748 1268 1650 1279 1607 1268 1605 1268 1603 1268 1510 1279 1432 1268 1429 1268 1427 1268 1425 1268 1408 1279 1330 1268 1328 1268 1326 1268 1300 1279 1271 1268 1269 1268 1267 1268 1163 1279 1111 1268 1109 1268 994 1279 968 1268 966 1268 964 1268 853 1279 823 1268 821 1268 819 1268 817 1268 788 1279 760 1268 758 1268 756 1268 669 1279 635 1268 633 1268 630 1268 568 1279 568 1312"/>
                        </Shape>
                        <String CONTENT="strip naked to the waist, and they like to have their bodies heated by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l13" HPOS="568" VPOS="1331" WIDTH="1773" HEIGHT="65" BASELINE="570 1374 2341 1370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1374 570 1396 2339 1385 2341 1370 2337 1331 667 1331 665 1331 568 1342 570 1374"/>
                        </Shape>
                        <String CONTENT="previous exercise. If there is no foot-race, the wrestlers will run a couple of"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l14" HPOS="568" VPOS="1396" WIDTH="1771" HEIGHT="56" BASELINE="570 1429 2339 1435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1429 568 1444 578 1452 581 1452 583 1452 585 1452 2337 1450 2339 1435 2337 1403 570 1396 570 1429"/>
                        </Shape>
                        <String CONTENT="miles to get warmed up for their contests. While the couples are wrestling,"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l15" HPOS="570" VPOS="1461" WIDTH="1771" HEIGHT="45" BASELINE="570 1489 2341 1489" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1489 570 1506 2341 1506 2341 1489 2341 1461 570 1461 570 1489"/>
                        </Shape>
                        <String CONTENT="the rest of the people sit or stand around to judge the matches. Sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l16" HPOS="570" VPOS="1522" WIDTH="1771" HEIGHT="45" BASELINE="570 1550 2341 1550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1550 570 1567 2341 1567 2341 1550 2341 1522 570 1522 570 1550"/>
                        </Shape>
                        <String CONTENT="two or three pairs wrestle at the same time. After stripping, the men, just"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l17" HPOS="570" VPOS="1576" WIDTH="1275" HEIGHT="50" BASELINE="570 1610 1845 1610" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1610 570 1626 1845 1626 1845 1610 1845 1580 570 1576 570 1610"/>
                        </Shape>
                        <String CONTENT="before the contest, rub their bodies all over with snow."/>
                    </TextLine>
<TextLine ID="mz_1-344_l18" HPOS="678" VPOS="1634" WIDTH="1665" HEIGHT="52" BASELINE="678 1671 2343 1671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="678 1671 678 1686 2343 1686 2343 1671 2343 1641 678 1634 678 1671"/>
                        </Shape>
                        <String CONTENT="The rules of the contest require that one man shall assume a posture"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l19" HPOS="568" VPOS="1686" WIDTH="1773" HEIGHT="61" BASELINE="570 1732 2341 1727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1732 570 1747 2339 1747 2341 1727 2337 1697 2259 1686 2257 1686 2166 1697 2144 1686 2142 1686 2140 1686 2066 1697 2036 1686 2034 1686 2032 1686 1962 1697 1904 1686 1902 1686 1824 1697 1748 1686 1746 1686 1744 1686 1713 1697 1603 1686 1601 1686 1598 1686 1596 1686 1577 1697 856 1688 853 1688 851 1688 814 1699 743 1688 741 1688 650 1699 607 1688 604 1688 602 1688 600 1688 568 1699 570 1732"/>
                        </Shape>
                        <String CONTENT="of passive defence, and the other try to throw him. The first is called"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l20" HPOS="574" VPOS="1753" WIDTH="1767" HEIGHT="59" BASELINE="576 1786 2341 1792" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 1786 574 1799 607 1812 609 1812 611 1812 2339 1805 2341 1792 2339 1760 576 1753 576 1786"/>
                        </Shape>
                        <String CONTENT="“motionless” (uˊlvɪlɪn); the second, “the attacking one” (viriˊtɪlɪn). If the latter"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l21" HPOS="570" VPOS="1820" WIDTH="1771" HEIGHT="55" BASELINE="570 1851 2341 1851" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1851 570 1875 2341 1866 2341 1851 2341 1820 570 1820 570 1851"/>
                        </Shape>
                        <String CONTENT="proves unsuccessful, the positions are reversed. Finally there usually follows"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l22" HPOS="570" VPOS="1881" WIDTH="1771" HEIGHT="46" BASELINE="570 1909 2341 1909" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1909 570 1927 2341 1927 2341 1909 2341 1881 570 1881 570 1909"/>
                        </Shape>
                        <String CONTENT="a rough-and-tumble scramble, in which each of the contestants tries every"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l23" HPOS="570" VPOS="1939" WIDTH="1771" HEIGHT="46" BASELINE="570 1970 2341 1970" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 1970 570 1985 2341 1985 2341 1970 2341 1939 570 1939 570 1970"/>
                        </Shape>
                        <String CONTENT="means to get the better of his adversary. Custom requires that one of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l24" HPOS="570" VPOS="1996" WIDTH="1771" HEIGHT="54" BASELINE="570 2028 2341 2033" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2028 570 2050 2339 2043 2341 2033 2339 2000 570 1996 570 2028"/>
                        </Shape>
                        <String CONTENT="parties be made to touch the ground with both of his shoulders, and kept"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l25" HPOS="565" VPOS="2054" WIDTH="1774" HEIGHT="59" BASELINE="568 2087 2339 2091" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2087 565 2100 650 2113 652 2113 2337 2111 2339 2091 2337 2059 568 2054 568 2087"/>
                        </Shape>
                        <String CONTENT="in this position in spite of his struggles. Three bouts are regarded as settling"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l26" HPOS="570" VPOS="2121" WIDTH="1771" HEIGHT="54" BASELINE="570 2150 2341 2150" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2150 570 2162 812 2175 814 2175 817 2175 843 2165 1165 2175 1167 2175 1334 2165 1871 2165 1945 2175 1947 2175 2099 2165 2237 2175 2239 2175 2242 2175 2244 2175 2261 2165 2317 2175 2320 2175 2322 2175 2324 2175 2341 2165 2341 2150 2341 2121 570 2121 570 2150"/>
                        </Shape>
                        <String CONTENT="the match, but the vanquished one often desires to keep on trying his"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l27" HPOS="568" VPOS="2180" WIDTH="1773" HEIGHT="45" BASELINE="568 2210 2341 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2210 568 2225 2341 2225 2341 2210 2341 2180 568 2180 568 2210"/>
                        </Shape>
                        <String CONTENT="chances. Frequently he becomes greatly excited, and then a violent scuffle"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l28" HPOS="568" VPOS="2236" WIDTH="1771" HEIGHT="56" BASELINE="570 2269 2339 2273" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2269 568 2279 620 2292 622 2292 2337 2288 2339 2273 2337 2240 570 2236 570 2269"/>
                        </Shape>
                        <String CONTENT="may ensue. The victor has to meet the winner of any other contests: but,"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l29" HPOS="568" VPOS="2290" WIDTH="1771" HEIGHT="54" BASELINE="570 2327 2339 2331" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2327 568 2340 2335 2344 2339 2331 2337 2295 570 2290 570 2327"/>
                        </Shape>
                        <String CONTENT="lest he should become too tired, he will step back after a few matches and"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l30" HPOS="568" VPOS="2360" WIDTH="1773" HEIGHT="45" BASELINE="568 2390 2341 2390" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2390 568 2405 2341 2405 2341 2390 2341 2360 568 2360 568 2390"/>
                        </Shape>
                        <String CONTENT="return in a half-hour or so to try his chance once more. This continues until"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l31" HPOS="570" VPOS="2418" WIDTH="1771" HEIGHT="45" BASELINE="570 2448 2341 2448" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2448 570 2463 2341 2463 2341 2448 2341 2418 570 2418 570 2448"/>
                        </Shape>
                        <String CONTENT="the best man is determined, and he takes the stake if there is one. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l32" HPOS="570" VPOS="2479" WIDTH="1771" HEIGHT="52" BASELINE="570 2509 2341 2509" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2509 570 2531 2341 2524 2341 2509 2341 2479 570 2479 570 2509"/>
                        </Shape>
                        <String CONTENT="passions are aroused quite enough, however, without stakes, so that prizes"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l33" HPOS="565" VPOS="2524" WIDTH="1776" HEIGHT="67" BASELINE="568 2565 2341 2570" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2565 565 2578 719 2591 721 2591 2339 2583 2341 2570 2339 2539 2287 2526 2285 2526 1735 2537 1707 2526 1705 2526 1702 2526 1700 2526 1698 2526 1687 2537 1674 2526 1672 2526 1670 2526 1525 2526 1523 2526 1520 2526 1481 2537 1412 2524 1410 2524 1408 2524 1365 2537 1187 2537 1167 2524 1165 2524 1163 2524 1161 2524 1102 2535 1046 2524 1044 2524 1042 2524 1007 2537 778 2537 754 2524 752 2524 749 2524 568 2533 568 2565"/>
                        </Shape>
                        <String CONTENT="are seldom put up for this sport. Several Chukchee tales describe a peculiar"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l34" HPOS="568" VPOS="2593" WIDTH="1773" HEIGHT="61" BASELINE="570 2624 2341 2628" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 2624 568 2639 732 2652 734 2652 1429 2643 1455 2654 1458 2654 1460 2654 2339 2643 2341 2628 2339 2598 570 2593 570 2624"/>
                        </Shape>
                        <String CONTENT="wrestling-match that takes place on a spread walrus-skin, slippery with blubber"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l35" HPOS="565" VPOS="2654" WIDTH="1776" HEIGHT="50" BASELINE="568 2684 2341 2689" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2684 565 2699 2337 2704 2341 2689 2339 2654 568 2654 568 2684"/>
                        </Shape>
                        <String CONTENT="and made dangerous by having sharp splinters of bone or wood stuck around"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l36" HPOS="568" VPOS="2708" WIDTH="1689" HEIGHT="56" BASELINE="568 2747 2257 2747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2747 568 2764 2255 2764 2257 2747 2252 2708 568 2710 568 2747"/>
                        </Shape>
                        <String CONTENT="its edge. Similar details are mentioned also in Eskimo and Indian tales.¹"/>
                    </TextLine>
<TextLine ID="mz_1-344_l37" HPOS="676" VPOS="2767" WIDTH="1663" HEIGHT="69" BASELINE="678 2803 2339 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="678 2803 676 2818 685 2827 685 2829 687 2829 689 2829 691 2829 760 2821 916 2831 918 2831 1705 2823 1830 2836 1832 2836 1880 2825 1893 2836 1895 2836 1897 2836 1899 2836 2337 2823 2339 2810 2337 2780 1837 2780 1785 2767 1782 2767 678 2771 678 2803"/>
                        </Shape>
                        <String CONTENT="A wrestling-match is the usual method of settling quarrels among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l38" HPOS="563" VPOS="2834" WIDTH="1776" HEIGHT="52" BASELINE="565 2868 2339 2864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="565 2868 565 2886 2337 2886 2339 2864 2333 2834 563 2836 565 2868"/>
                        </Shape>
                        <String CONTENT="Chukchee. A man having a grudge against another one will either openly"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l39" HPOS="565" VPOS="2894" WIDTH="1772" HEIGHT="48" BASELINE="568 2925 2337 2929" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2925 565 2938 2333 2942 2337 2929 2335 2899 568 2894 568 2925"/>
                        </Shape>
                        <String CONTENT="challenge him for a match or he will seek a chance to encounter him in a"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l40" HPOS="568" VPOS="2957" WIDTH="1771" HEIGHT="50" BASELINE="568 2987 2339 2987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 2987 568 3007 2339 3003 2339 2987 2339 2957 568 2957 568 2987"/>
                        </Shape>
                        <String CONTENT="general contest. In either case, the match sometimes ends in bloodshed, or"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l41" HPOS="565" VPOS="3011" WIDTH="1237" HEIGHT="50" BASELINE="568 3041 1802 3046" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 3041 565 3057 1798 3061 1802 3046 1800 3016 568 3011 568 3041"/>
                        </Shape>
                        <String CONTENT="even death, if the spectators do not interfere in time."/>
                    </TextLine>
<TextLine ID="mz_1-344_l42" HPOS="678" VPOS="3063" WIDTH="1663" HEIGHT="61" BASELINE="680 3102 2341 3109" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 3102 678 3117 2337 3124 2341 3109 2341 3076 680 3063 680 3102"/>
                        </Shape>
                        <String CONTENT="Women also wrestle, but their matches generally end in scratching and"/>
                    </TextLine>

                    <TextLine ID="mz_1-344_l43" HPOS="565" VPOS="3122" WIDTH="1774" HEIGHT="69" BASELINE="568 3167 2339 3163" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="568 3167 568 3189 2322 3191 2324 3191 2326 3191 2328 3191 2339 3180 2339 3163 2333 3126 1837 3132 1813 3122 1811 3122 1808 3122 1733 3132 1689 3122 1687 3122 1685 3122 1607 3132 1577 3122 1575 3122 1572 3122 1408 3135 1349 3124 1347 3124 1287 3135 1211 3124 1209 3124 1206 3124 1185 3135 1154 3124 1152 3124 1150 3124 1094 3135 899 3124 897 3124 843 3135 821 3124 819 3124 626 3124 624 3124 565 3137 568 3167"/>
                        </Shape>
                        <String CONTENT="pulling hair. Members of alien tribes are also allowed to take part in all of"/>
                    </TextLine>
