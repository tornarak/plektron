                <TextBlock ID="text_1-350" HPOS="550" VPOS="617" WIDTH="1780" HEIGHT="2628"><TextLine ID="mz_1-350_l1" HPOS="1131" VPOS="623" WIDTH="619" HEIGHT="54" BASELINE="1131 656 1750 656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1737 625 1731 623 1141 623 1131 630 1131 656 1131 677 1750 677 1750 656 1748 647 1737 625"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l2" HPOS="557" VPOS="617" WIDTH="110" HEIGHT="67" BASELINE="557 660 667 660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 619 594 617 557 628 557 660 557 675 563 682 563 684 565 684 568 684 570 684 667 671 667 660 667 630 613 619 600 619"/>
                        </Shape>
                        <String CONTENT="268"/>
                    </TextLine>
<TextLine ID="mz_1-350_l3" HPOS="555" VPOS="731" WIDTH="1769" HEIGHT="50" BASELINE="555 764 2324 764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 764 555 781 2324 781 2324 764 2324 734 555 731 555 764"/>
                        </Shape>
                        <String CONTENT="Two women hold the ends of a line, and swing it around regularly, while a"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l4" HPOS="552" VPOS="781" WIDTH="1763" HEIGHT="63" BASELINE="555 825 2315 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 825 555 844 2313 844 2315 820 2311 781 1473 781 1471 781 1468 781 1427 792 578 783 576 783 574 783 552 792 555 825"/>
                        </Shape>
                        <String CONTENT="third jumps over the middle of it, keeping her knees and heels together. I"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l5" HPOS="552" VPOS="840" WIDTH="1774" HEIGHT="65" BASELINE="555 887 2326 879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="552 857 555 887 555 905 2324 896 2326 879 2322 851 1882 840 1880 840 1795 851 1447 842 1445 842 1442 842 1419 855 555 855 552 857"/>
                        </Shape>
                        <String CONTENT="have not noticed any particular rules about the order of the jumps, like those"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l6" HPOS="552" VPOS="902" WIDTH="1003" HEIGHT="70" BASELINE="555 946 1555 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 946 555 961 1050 972 1053 972 1055 972 1087 959 1187 959 1202 970 1204 970 1206 970 1209 970 1553 957 1555 941 1551 902 568 902 565 902 563 902 561 902 552 907 555 946"/>
                        </Shape>
                        <String CONTENT="found by Parry among the Iglulik Eskimo.¹"/>
                    </TextLine>
<TextLine ID="mz_1-350_l7" HPOS="659" VPOS="965" WIDTH="1669" HEIGHT="65" BASELINE="661 1006 2328 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 1006 661 1030 2326 1015 2328 1000 2324 972 680 965 678 965 676 965 674 965 659 972 661 1006"/>
                        </Shape>
                        <String CONTENT="Another game is a contest in crawling on the knees, which is rather"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l8" HPOS="550" VPOS="1019" WIDTH="1776" HEIGHT="63" BASELINE="552 1067 2326 1058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="550 1037 552 1067 552 1082 2324 1073 2326 1058 2322 1030 1895 1019 1893 1019 1891 1019 1889 1019 1876 1030 570 1026 568 1026 565 1026 563 1026 550 1032 550 1037"/>
                        </Shape>
                        <String CONTENT="difficult for women, on account of their clumsy breeches. In one sort of race"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l9" HPOS="550" VPOS="1084" WIDTH="1776" HEIGHT="57" BASELINE="552 1125 2326 1117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="552 1125 552 1141 2324 1134 2326 1117 2322 1089 572 1084 570 1084 568 1084 565 1084 550 1091 552 1125"/>
                        </Shape>
                        <String CONTENT="the contestants move around while bending forward and taking hold of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l10" HPOS="555" VPOS="1154" WIDTH="1771" HEIGHT="47" BASELINE="555 1184 2326 1184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 1184 555 1201 2326 1201 2326 1184 2326 1154 555 1154 555 1184"/>
                        </Shape>
                        <String CONTENT="toes of their boots with their hands. In another they crouch on the ground,"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l11" HPOS="552" VPOS="1199" WIDTH="754" HEIGHT="63" BASELINE="555 1247 1306 1240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 1247 555 1262 1304 1260 1306 1240 1304 1210 1287 1199 1284 1199 1282 1199 1280 1199 1154 1210 1131 1199 1128 1199 1126 1199 1124 1199 1102 1210 1079 1199 1076 1199 1074 1199 1072 1199 1046 1212 953 1201 951 1201 823 1212 806 1201 804 1201 801 1201 799 1201 797 1201 795 1201 773 1214 561 1203 559 1203 557 1203 555 1203 555 1206 552 1206 555 1247"/>
                        </Shape>
                        <String CONTENT="imitating the motion of the seal."/>
                    </TextLine>
<TextLine ID="mz_1-350_l12" HPOS="661" VPOS="1273" WIDTH="1667" HEIGHT="47" BASELINE="661 1301 2328 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 1301 661 1320 2326 1320 2328 1301 2326 1273 661 1273 661 1301"/>
                        </Shape>
                        <String CONTENT="SONGS AND DANCES. — The dances performed at ceremonials by men or"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l13" HPOS="552" VPOS="1320" WIDTH="1772" HEIGHT="63" BASELINE="555 1364 2324 1359" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 1364 555 1379 2320 1383 2324 1359 2320 1331 1438 1320 1436 1320 1434 1320 1432 1320 1414 1331 778 1322 775 1322 552 1333 555 1364"/>
                        </Shape>
                        <String CONTENT="women will be described farther on. Young girls have dances of their own,"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l14" HPOS="555" VPOS="1390" WIDTH="1771" HEIGHT="49" BASELINE="557 1424 2326 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 1424 557 1439 2324 1435 2326 1418 2320 1390 555 1394 557 1424"/>
                        </Shape>
                        <String CONTENT="which are meant to imitate the motions of various animals or certain human"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l15" HPOS="552" VPOS="1444" WIDTH="1774" HEIGHT="58" BASELINE="555 1485 2326 1478" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 1485 555 1502 2324 1496 2326 1478 2322 1446 615 1444 613 1444 552 1455 555 1485"/>
                        </Shape>
                        <String CONTENT="actions. They are accompanied by peculiar songs, or rather rhythmical guttural"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l16" HPOS="555" VPOS="1513" WIDTH="1771" HEIGHT="45" BASELINE="555 1543 2326 1543" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 1543 555 1558 2326 1558 2326 1543 2326 1513 555 1513 555 1543"/>
                        </Shape>
                        <String CONTENT="sounds produced by alternately drawing in and letting out the breath. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l17" HPOS="555" VPOS="1558" WIDTH="1771" HEIGHT="61" BASELINE="557 1604 2326 1600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 1604 557 1619 2324 1615 2326 1600 2322 1569 1453 1558 1451 1558 1449 1558 1447 1558 1434 1569 682 1561 680 1561 555 1571 557 1604"/>
                        </Shape>
                        <String CONTENT="act of making these sounds is termed “to call with the throat” (pič-eiñeˊrkɪn)."/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l18" HPOS="557" VPOS="1626" WIDTH="1769" HEIGHT="56" BASELINE="559 1665 2326 1660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 1665 559 1682 2324 1682 2326 1660 2322 1630 557 1626 559 1665"/>
                        </Shape>
                        <String CONTENT="Two or more girls take positions opposite each other or in a circle (see Plate XXVII,"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l19" HPOS="557" VPOS="1686" WIDTH="1769" HEIGHT="54" BASELINE="559 1725 2326 1719" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 1725 559 1740 2324 1734 2326 1719 2320 1686 557 1686 559 1725"/>
                        </Shape>
                        <String CONTENT="Fig. 4) and in succession produce the sounds, keeping time carefully, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l20" HPOS="555" VPOS="1736" WIDTH="1771" HEIGHT="71" BASELINE="557 1784 2326 1777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 1784 557 1799 1718 1805 1720 1805 1722 1805 1724 1805 1741 1794 1902 1805 1904 1805 1971 1794 2077 1805 2079 1805 2081 1805 2122 1794 2135 1805 2138 1805 2140 1805 2142 1807 2291 1807 2291 1805 2294 1805 2326 1792 2326 1777 2322 1749 2170 1736 2168 1736 2166 1736 2164 1736 2148 1749 2006 1749 1986 1736 1984 1736 1982 1736 1980 1736 1977 1736 1954 1747 1930 1736 1928 1736 1925 1736 1869 1747 1839 1736 1837 1736 1834 1736 1832 1736 1804 1747 1774 1736 1772 1736 1769 1736 1767 1736 1731 1749 1692 1738 1689 1738 1687 1738 1622 1749 1289 1738 1287 1738 1141 1751 615 1740 613 1740 555 1753 557 1784"/>
                        </Shape>
                        <String CONTENT="quickly taking their turns one after the other. The singing is begun with low"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l21" HPOS="555" VPOS="1810" WIDTH="1769" HEIGHT="47" BASELINE="557 1844 2324 1840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 1844 557 1857 2322 1855 2324 1840 2320 1810 555 1810 557 1844"/>
                        </Shape>
                        <String CONTENT="hoarse notes. Imitative sounds are introduced later in a much higher key."/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l22" HPOS="559" VPOS="1857" WIDTH="1767" HEIGHT="67" BASELINE="561 1896 2326 1903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 1896 559 1911 583 1924 585 1924 587 1924 2324 1918 2326 1903 2326 1872 2291 1859 2289 1859 2287 1859 2092 1870 2060 1859 2058 1859 2055 1859 2053 1859 2019 1870 1871 1859 1869 1859 1867 1859 1837 1870 1808 1859 1806 1859 1804 1859 1802 1859 1780 1870 1713 1857 1711 1857 1616 1868 561 1862 561 1896"/>
                        </Shape>
                        <String CONTENT="While singing, the girls sway the upper part of their bodies back and forth,"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l23" HPOS="555" VPOS="1920" WIDTH="1773" HEIGHT="58" BASELINE="557 1961 2328 1957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 1961 557 1978 2326 1974 2328 1957 2324 1929 628 1920 626 1920 555 1931 557 1961"/>
                        </Shape>
                        <String CONTENT="and then go through various imitative motions in connection with the sounds"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l24" HPOS="555" VPOS="1976" WIDTH="1771" HEIGHT="72" BASELINE="557 2022 2326 2017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2022 557 2037 1016 2048 1018 2048 1020 2048 1042 2037 1122 2048 1124 2048 1126 2048 1157 2037 1211 2048 1213 2048 1215 2048 1217 2048 1232 2037 1358 2048 1360 2048 1362 2048 1365 2048 1382 2037 1438 2048 1440 2048 1442 2048 1481 2035 1505 2046 1507 2046 1510 2046 1564 2035 1718 2046 1720 2046 1774 2035 1821 2046 1824 2046 1826 2046 1886 2035 1912 2046 1915 2046 1917 2046 2324 2035 2326 2017 2324 1989 2274 1976 2272 1976 2270 1976 2268 1976 2244 1987 1951 1976 1949 1976 1813 1987 1785 1976 1782 1976 1780 1976 1778 1976 1776 1976 1761 1989 1674 1989 1611 1976 1609 1976 1553 1987 1531 1976 1529 1976 1527 1976 1525 1976 1523 1976 1507 1987 702 1978 700 1978 555 1991 557 2022"/>
                        </Shape>
                        <String CONTENT="uttered (Plates XXXI, Fig. 2; XXVII, Fig. 4). Young boys taking part in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l25" HPOS="555" VPOS="2052" WIDTH="1769" HEIGHT="52" BASELINE="555 2080 2324 2080" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 2080 555 2098 2322 2104 2324 2080 2324 2052 555 2052 555 2080"/>
                        </Shape>
                        <String CONTENT="dance hold up their hands and snap their fingers, at the same time producing"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l26" HPOS="555" VPOS="2111" WIDTH="1769" HEIGHT="51" BASELINE="555 2141 2324 2141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 2141 555 2158 2322 2162 2324 2141 2324 2111 555 2111 555 2141"/>
                        </Shape>
                        <String CONTENT="a peculiar clicking sound with their tongues. Each song, with the accompanying"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l27" HPOS="555" VPOS="2171" WIDTH="1100" HEIGHT="46" BASELINE="555 2201 1655 2201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="555 2201 555 2217 1655 2217 1655 2201 1655 2171 555 2171 555 2201"/>
                        </Shape>
                        <String CONTENT="dance, has the name of the animal represented."/>
                    </TextLine>
<TextLine ID="mz_1-350_l28" HPOS="663" VPOS="2227" WIDTH="1665" HEIGHT="50" BASELINE="663 2260 2328 2260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="663 2260 663 2277 2328 2277 2328 2260 2328 2230 663 2227 663 2260"/>
                        </Shape>
                        <String CONTENT="The most frequently performed are the Raven and The-One-eyed-One"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l29" HPOS="557" VPOS="2290" WIDTH="1771" HEIGHT="46" BASELINE="557 2321 2328 2321" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2321 557 2336 2328 2336 2328 2321 2328 2290 557 2290 557 2321"/>
                        </Shape>
                        <String CONTENT="dances. The imitative sounds of the former represent the croaking of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l30" HPOS="559" VPOS="2338" WIDTH="1769" HEIGHT="58" BASELINE="559 2381 2328 2381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 2381 559 2396 2328 2396 2328 2381 2328 2351 2205 2351 2190 2338 2187 2338 2185 2338 2183 2338 2181 2338 2157 2349 2129 2338 2127 2338 2125 2338 2051 2349 1947 2338 1945 2338 1943 2338 1899 2349 1774 2338 1772 2338 1709 2349 1624 2338 1622 2338 1549 2349 1371 2338 1369 2338 1367 2338 1341 2349 1297 2338 1295 2338 1293 2338 1291 2338 1254 2349 1215 2338 1213 2338 1211 2338 1120 2349 1020 2338 1018 2338 1016 2338 983 2349 962 2338 960 2338 957 2338 886 2349 821 2338 819 2338 749 2349 559 2342 559 2381"/>
                        </Shape>
                        <String CONTENT="Raven. The girls for a while also keep repeating, “Raven, Raven!” in hoarse"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l31" HPOS="557" VPOS="2396" WIDTH="1769" HEIGHT="61" BASELINE="557 2440 2326 2440" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2440 557 2457 2326 2457 2326 2440 2326 2409 2246 2396 2244 2396 2242 2396 2216 2407 2190 2396 2187 2396 2185 2396 1951 2407 1921 2396 1919 2396 1917 2396 1863 2407 1834 2396 1832 2396 1830 2396 1828 2396 1787 2407 1663 2396 1661 2396 1601 2407 1572 2396 1570 2396 1568 2396 1507 2407 1464 2396 1462 2396 1460 2396 1458 2396 1414 2407 1384 2396 1382 2396 1380 2396 1378 2396 1336 2407 1304 2396 1302 2396 1300 2396 1245 2407 1213 2396 1211 2396 1209 2396 1206 2396 1170 2407 1120 2396 1118 2396 1115 2396 1076 2407 1001 2396 999 2396 996 2396 957 2407 927 2396 925 2396 923 2396 869 2407 830 2396 827 2396 825 2396 713 2407 678 2396 676 2396 674 2396 557 2407 557 2440"/>
                        </Shape>
                        <String CONTENT="sounds produced while drawing in the breath. While dancing, the girls hop"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l32" HPOS="557" VPOS="2470" WIDTH="1767" HEIGHT="52" BASELINE="557 2500 2324 2500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2500 557 2513 2320 2522 2324 2500 2322 2470 557 2470 557 2500"/>
                        </Shape>
                        <String CONTENT="around, pretend to seek for something, peck at the ground, etc. The song"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l33" HPOS="555" VPOS="2524" WIDTH="1771" HEIGHT="50" BASELINE="557 2554 2326 2559" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2554 555 2570 2322 2574 2326 2559 2324 2528 557 2524 557 2554"/>
                        </Shape>
                        <String CONTENT="of The-One-eyed-One is accompanied by a few words sung in the same manner"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l34" HPOS="557" VPOS="2574" WIDTH="1771" HEIGHT="67" BASELINE="557 2615 2328 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2615 557 2630 1371 2630 1445 2641 1447 2641 2326 2630 2328 2619 2326 2589 1858 2576 1856 2576 1746 2587 1657 2576 1655 2576 1536 2587 1479 2576 1477 2576 1475 2576 1453 2587 1423 2574 1421 2574 1419 2574 1339 2585 1267 2574 1265 2574 1206 2585 1137 2574 1135 2574 1079 2585 918 2574 916 2574 914 2574 890 2585 838 2574 836 2574 834 2574 808 2585 700 2574 697 2574 557 2583 557 2615"/>
                        </Shape>
                        <String CONTENT="as “Raven.” It runs like this: “The-One-eyed-One called with his throat"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l35" HPOS="557" VPOS="2643" WIDTH="1769" HEIGHT="59" BASELINE="559 2676 2326 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 2676 557 2693 570 2702 572 2702 574 2702 576 2702 2324 2693 2326 2680 2324 2647 559 2643 559 2676"/>
                        </Shape>
                        <String CONTENT="till his other eye got out (of the socket)” (Kowlaˊiñɪn pičeˊiñei rɪpeˊt pɪˊtqa-"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l36" HPOS="557" VPOS="2699" WIDTH="1769" HEIGHT="59" BASELINE="559 2734 2326 2741" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 2734 557 2749 2322 2758 2326 2741 2324 2708 559 2699 559 2734"/>
                        </Shape>
                        <String CONTENT="lêlantoˊê). The dancers make faces and squint their eyes alternately, representing"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l37" HPOS="559" VPOS="2754" WIDTH="1767" HEIGHT="60" BASELINE="561 2799 2326 2795" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 2799 561 2814 2324 2810 2326 2795 2322 2767 2246 2754 2244 2754 2242 2754 2239 2754 2222 2767 2051 2767 2036 2754 2034 2754 2032 2754 2029 2754 2027 2754 2025 2754 2008 2767 1876 2767 1860 2754 1858 2754 1856 2754 1854 2754 1793 2767 1629 2767 1611 2754 1609 2754 1607 2754 1605 2754 1603 2754 1577 2764 1473 2754 1471 2754 1399 2767 1382 2756 1380 2756 1378 2756 1375 2756 1373 2756 1330 2769 1163 2769 1144 2756 1141 2756 1139 2756 1137 2756 1135 2756 1109 2767 1081 2756 1079 2756 1076 2756 1014 2767 916 2756 914 2756 559 2760 561 2799"/>
                        </Shape>
                        <String CONTENT="The-One-eyed-One. He is supposed to have been an old man who wanted to"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l38" HPOS="557" VPOS="2816" WIDTH="1771" HEIGHT="70" BASELINE="557 2857 2328 2857" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2857 557 2870 1157 2883 1159 2883 1215 2873 1713 2873 1752 2883 1754 2883 1756 2886 2118 2886 2118 2883 2120 2883 2122 2883 2138 2873 2216 2883 2218 2883 2220 2883 2222 2883 2239 2873 2304 2883 2307 2883 2309 2883 2311 2883 2328 2873 2328 2857 2328 2829 2276 2816 2274 2816 2272 2816 2242 2827 2200 2816 2198 2816 2196 2816 2194 2816 2159 2827 2088 2816 2086 2816 2019 2829 1702 2829 1687 2816 1685 2816 1683 2816 1681 2816 1607 2827 1585 2816 1583 2816 1581 2816 1525 2827 1471 2816 1468 2816 1466 2816 1429 2827 1378 2816 1375 2816 1373 2816 1339 2827 1308 2816 1306 2816 1304 2816 1224 2827 1139 2816 1033 2816 1031 2816 1029 2816 1027 2816 1016 2827 1003 2816 1001 2816 999 2816 996 2816 994 2816 949 2827 557 2823 557 2857"/>
                        </Shape>
                        <String CONTENT="have a contest of “calling with the throat” with some young girls. In the"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l39" HPOS="555" VPOS="2877" WIDTH="1416" HEIGHT="65" BASELINE="557 2914 1971 2920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="557 2914 555 2929 565 2938 568 2938 570 2938 572 2938 1025 2929 1046 2940 1048 2940 1050 2940 1427 2931 1503 2942 1505 2942 1969 2931 1971 2920 1969 2890 1575 2890 1499 2877 1497 2877 557 2881 557 2914"/>
                        </Shape>
                        <String CONTENT="contest his only eye came out of the socket under the strain."/>
