                        <Shape>
                            <Polygon POINTS="580 2749 578 2764 2343 2773 2347 2756 2345 2723 580 2714 580 2749"/>
                        </Shape>
                        <String CONTENT="lêlantoˊê). The dancers make faces and squint their eyes alternately, representing"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l37" HPOS="580" VPOS="2769" WIDTH="1767" HEIGHT="60" BASELINE="582 2814 2347 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="582 2814 582 2829 2345 2825 2347 2810 2343 2782 2267 2769 2265 2769 2263 2769 2260 2769 2243 2782 2072 2782 2057 2769 2055 2769 2053 2769 2050 2769 2048 2769 2046 2769 2029 2782 1897 2782 1881 2769 1879 2769 1877 2769 1875 2769 1814 2782 1650 2782 1632 2769 1630 2769 1628 2769 1626 2769 1624 2769 1598 2779 1494 2769 1492 2769 1420 2782 1403 2771 1401 2771 1399 2771 1396 2771 1394 2771 1351 2784 1184 2784 1165 2771 1162 2771 1160 2771 1158 2771 1156 2771 1130 2782 1102 2771 1100 2771 1097 2771 1035 2782 937 2771 935 2771 580 2775 582 2814"/>
                        </Shape>
                        <String CONTENT="The-One-eyed-One. He is supposed to have been an old man who wanted to"/>
                    </TextLine>

