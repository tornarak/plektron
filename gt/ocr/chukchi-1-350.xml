                        </Shape>
                        <String CONTENT="women will be described farther on. Young girls have dances of their own,"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l14" HPOS="576" VPOS="1405" WIDTH="1771" HEIGHT="49" BASELINE="578 1439 2347 1433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1439 578 1454 2345 1450 2347 1433 2341 1405 576 1409 578 1439"/>
                        </Shape>
                        <String CONTENT="which are meant to imitate the motions of various animals or certain human"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l15" HPOS="573" VPOS="1459" WIDTH="1774" HEIGHT="58" BASELINE="576 1500 2347 1493" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 1500 576 1517 2345 1511 2347 1493 2343 1461 636 1459 634 1459 573 1470 576 1500"/>
                        </Shape>
                        <String CONTENT="actions. They are accompanied by peculiar songs, or rather rhythmical guttural"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l16" HPOS="576" VPOS="1528" WIDTH="1771" HEIGHT="45" BASELINE="576 1558 2347 1558" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 1558 576 1573 2347 1573 2347 1558 2347 1528 576 1528 576 1558"/>
                        </Shape>
