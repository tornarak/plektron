                        <Shape>
                            <Polygon POINTS="682 1316 682 1335 2347 1335 2349 1316 2347 1288 682 1288 682 1316"/>
                        </Shape>
                        <String CONTENT="SONGS AND DANCES. — The dances performed at ceremonials by men or"/>
