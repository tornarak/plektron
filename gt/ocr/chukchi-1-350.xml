                    <TextLine ID="mz_1-350_l34" HPOS="578" VPOS="2589" WIDTH="1771" HEIGHT="67" BASELINE="578 2630 2349 2634" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2630 578 2645 1392 2645 1466 2656 1468 2656 2347 2645 2349 2634 2347 2604 1879 2591 1877 2591 1767 2602 1678 2591 1676 2591 1557 2602 1500 2591 1498 2591 1496 2591 1474 2602 1444 2589 1442 2589 1440 2589 1360 2600 1288 2589 1286 2589 1227 2600 1158 2589 1156 2589 1100 2600 939 2589 937 2589 935 2589 911 2600 859 2589 857 2589 855 2589 829 2600 721 2589 718 2589 578 2598 578 2630"/>
