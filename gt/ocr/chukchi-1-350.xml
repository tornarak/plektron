                    <TextLine ID="mz_1-350_l31" HPOS="578" VPOS="2411" WIDTH="1769" HEIGHT="61" BASELINE="578 2455 2347 2455" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2455 578 2472 2347 2472 2347 2455 2347 2424 2267 2411 2265 2411 2263 2411 2237 2422 2211 2411 2208 2411 2206 2411 1972 2422 1942 2411 1940 2411 1938 2411 1884 2422 1855 2411 1853 2411 1851 2411 1849 2411 1808 2422 1684 2411 1682 2411 1622 2422 1593 2411 1591 2411 1589 2411 1528 2422 1485 2411 1483 2411 1481 2411 1479 2411 1435 2422 1405 2411 1403 2411 1401 2411 1399 2411 1357 2422 1325 2411 1323 2411 1321 2411 1266 2422 1234 2411 1232 2411 1230 2411 1227 2411 1191 2422 1141 2411 1139 2411 1136 2411 1097 2422 1022 2411 1020 2411 1017 2411 978 2422 948 2411 946 2411 944 2411 890 2422 851 2411 848 2411 846 2411 734 2422 699 2411 697 2411 695 2411 578 2422 578 2455"/>
                        </Shape>
                        <String CONTENT="sounds produced while drawing in the breath. While dancing, the girls hop"/>
