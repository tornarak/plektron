                    <TextLine ID="mz_1-350_l29" HPOS="578" VPOS="2305" WIDTH="1771" HEIGHT="46" BASELINE="578 2336 2349 2336" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2336 578 2351 2349 2351 2349 2336 2349 2305 578 2305 578 2336"/>
                        </Shape>
                        <String CONTENT="dances. The imitative sounds of the former represent the croaking of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-350_l30" HPOS="580" VPOS="2353" WIDTH="1769" HEIGHT="58" BASELINE="580 2396 2349 2396" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="580 2396 580 2411 2349 2411 2349 2396 2349 2366 2226 2366 2211 2353 2208 2353 2206 2353 2204 2353 2202 2353 2178 2364 2150 2353 2148 2353 2146 2353 2072 2364 1968 2353 1966 2353 1964 2353 1920 2364 1795 2353 1793 2353 1730 2364 1645 2353 1643 2353 1570 2364 1392 2353 1390 2353 1388 2353 1362 2364 1318 2353 1316 2353 1314 2353 1312 2353 1275 2364 1236 2353 1234 2353 1232 2353 1141 2364 1041 2353 1039 2353 1037 2353 1004 2364 983 2353 981 2353 978 2353 907 2364 842 2353 840 2353 770 2364 580 2357 580 2396"/>
                        </Shape>
