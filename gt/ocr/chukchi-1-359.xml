                        </Shape>
                        <String CONTENT="¹ The Russians call by this name the village and the river Iˊlpi, and also the whole country occupied"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l74" HPOS="459" VPOS="2450" WIDTH="1763" HEIGHT="46" BASELINE="461 2481 2222 2476" TAGREFS="TYPE_3">
                        <Shape>
