                        </Shape>
                        <String CONTENT="by that division of the Kerek. The proper river Хатырка, however, lies farther to the east. Its Kerek name is"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l75" HPOS="459" VPOS="2489" WIDTH="1479" HEIGHT="48" BASELINE="461 2518 1938 2522" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="461 2518 459 2533 1934 2537 1938 2522 1936 2494 461 2489 461 2518"/>
                        </Shape>
                        <String CONTENT="Hatɪˊykan or Hatɪˊrkan. On the map the Chukchee variety of the name (Vatɪˊrkan) is given."/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l76" HPOS="570" VPOS="2528" WIDTH="1659" HEIGHT="52" BASELINE="572 2557 2229 2563" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="572 2557 570 2574 2224 2580 2229 2563 2226 2535 572 2528 572 2557"/>
                        </Shape>
                        <String CONTENT="² On Russian and English maps, Cape Anannon, through a general misunderstanding, has been called"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l77" HPOS="459" VPOS="2576" WIDTH="1005" HEIGHT="48" BASELINE="461 2606 1464 2602" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="461 2606 461 2624 1462 2621 1464 2602 1458 2576 459 2578 461 2606"/>
                        </Shape>
                        <String CONTENT="Cape Alutorsky; and the real Cape Alutorsky, Cape Govensky."/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l78" HPOS="570" VPOS="2619" WIDTH="870" HEIGHT="46" BASELINE="570 2645 1440 2645" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="570 2645 570 2665 1440 2665 1440 2645 1440 2619 570 2619 570 2645"/>
                        </Shape>
                        <String CONTENT="³ Chukchee. The meaning is the same as in Russian."/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l79" HPOS="570" VPOS="2658" WIDTH="1661" HEIGHT="48" BASELINE="572 2686 2231 2691" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="572 2686 570 2702 2226 2706 2231 2691 2229 2663 572 2658 572 2686"/>
                        </Shape>
                        <String CONTENT="⁴ This name, although belonging to a Yukaghir village, is Lamut. It comes from a mountain near by,"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l80" HPOS="459" VPOS="2702" WIDTH="505" HEIGHT="47" BASELINE="461 2730 964 2734" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="461 2730 459 2745 960 2749 964 2734 962 2706 461 2702 461 2730"/>
                        </Shape>
                        <String CONTENT="which has the shape of a boat."/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l81" HPOS="570" VPOS="2747" WIDTH="1661" HEIGHT="50" BASELINE="570 2773 2231 2773" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="570 2773 570 2788 2229 2797 2231 2773 2231 2747 570 2747 570 2773"/>
                        </Shape>
                        <String CONTENT="⁵ Yukaghir, meaning “stony.” The first Russian name is probably a corruption of it. It is, however,"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l82" HPOS="461" VPOS="2788" WIDTH="1768" HEIGHT="46" BASELINE="464 2818 2229 2814" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="464 2818 464 2834 2226 2829 2229 2814 2222 2788 461 2790 464 2818"/>
                        </Shape>
                        <String CONTENT="unknown even to the Russian inhabitants of the country, though it appears on most of the maps. The second"/>
                    </TextLine>

                    <TextLine ID="mz_1-359_l83" HPOS="464" VPOS="2831" WIDTH="1762" HEIGHT="44" BASELINE="464 2857 2226 2857" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="464 2857 464 2875 2226 2875 2226 2857 2226 2831 464 2831 464 2857"/>
                        </Shape>
                        <String CONTENT="Russian name means “dry river.” The Lamut name of the river is Buks˙unda, which means “icy river.” Of"/>
                    </TextLine>

