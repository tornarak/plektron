                        </Shape>
                        <String CONTENT="was defeated and killed March 14, 1730, on the river Egaˊč; and Mayor"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l13" HPOS="409" VPOS="1350" WIDTH="1771" HEIGHT="65" BASELINE="411 1400 2180 1392" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1400 411 1415 2178 1409 2180 1392 2176 1361 1739 1350 1736 1350 1734 1350 1732 1350 1719 1363 409 1363 411 1400"/>
                        </Shape>
