                    </Shape>
                    <TextLine ID="mz_1-035_l25" HPOS="496" VPOS="2063" WIDTH="1661" HEIGHT="56" BASELINE="498 2104 2157 2095" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="498 2104 498 2119 2155 2113 2157 2095 2153 2063 520 2063 518 2063 516 2063 496 2072 498 2104"/>
                        </Shape>
                        <String CONTENT="About a century ago the territory of the Reindeer Chukchee extended"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l26" HPOS="388" VPOS="2117" WIDTH="1769" HEIGHT="61" BASELINE="390 2165 2157 2158" TAGREFS="TYPE_5">
                        <Shape>
