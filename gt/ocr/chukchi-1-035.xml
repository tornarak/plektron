                        </Shape>
                        <String CONTENT="face has never been seen, nor a word of the Russian language heard."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-035_r5" HPOS="387" VPOS="2066" WIDTH="1778" HEIGHT="712" TAGREFS="TYPE_2">
