                    <TextLine ID="mz_1-035_l9" HPOS="517" VPOS="1123" WIDTH="1663" HEIGHT="48" BASELINE="519 1156 2180 1151" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="519 1156 519 1171 2178 1166 2180 1151 2176 1123 517 1123 519 1156"/>
                        </Shape>
                        <String CONTENT="The reason for this unusual forbearance lies in the fact that the last"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l10" HPOS="407" VPOS="1173" WIDTH="1773" HEIGHT="67" BASELINE="409 1218 2180 1214" TAGREFS="TYPE_5">
