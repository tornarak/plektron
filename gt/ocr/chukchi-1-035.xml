                        <String CONTENT="side as far as the river Baranikha, and on the Pacific side to the river Opuka;"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l28" HPOS="390" VPOS="2249" WIDTH="1767" HEIGHT="52" BASELINE="392 2286 2157 2279" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2286 392 2299 2153 2301 2157 2279 2153 2249 390 2249 392 2286"/>
                        </Shape>
                        <String CONTENT="but in the early twenties of the nineteenth century the Reindeer Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l29" HPOS="390" VPOS="2297" WIDTH="1769" HEIGHT="65" BASELINE="392 2347 2159 2336" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2347 392 2362 2157 2351 2159 2336 2155 2308 2008 2297 2006 2297 1800 2310 390 2310 392 2347"/>
                        </Shape>
                        <String CONTENT="induced in a measure by the increase of their herds, began to extend their"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l30" HPOS="390" VPOS="2357" WIDTH="1767" HEIGHT="63" BASELINE="392 2405 2157 2398" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2405 392 2420 2155 2414 2157 2398 2153 2368 1603 2357 1601 2357 1598 2357 1564 2370 390 2370 392 2405"/>
                        </Shape>
                        <String CONTENT="boundaries westward and southward. In the sixties they crossed the Kolyma"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l31" HPOS="392" VPOS="2418" WIDTH="1769" HEIGHT="63" BASELINE="394 2463 2161 2459" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2463 394 2481 2159 2479 2161 2459 2157 2429 1289 2418 1287 2418 1284 2418 1282 2418 1269 2431 392 2431 394 2463"/>
                        </Shape>
                        <String CONTENT="River, and spread over the flat tundra between the Kolyma and the Alaseya;"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l32" HPOS="390" VPOS="2487" WIDTH="1769" HEIGHT="61" BASELINE="392 2524 2159 2515" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2524 392 2548 2157 2533 2159 2515 2153 2487 390 2494 392 2524"/>
                        </Shape>
                        <String CONTENT="the people of some camps even crossed the Alaseya, and went as far as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l33" HPOS="394" VPOS="2535" WIDTH="1767" HEIGHT="69" BASELINE="396 2585 2161 2576" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2585 396 2598 1711 2604 1713 2604 1715 2604 1750 2593 2138 2602 2140 2602 2142 2602 2144 2602 2161 2591 2161 2576 2157 2548 2105 2535 2103 2535 2101 2535 2073 2546 1893 2535 1891 2535 1889 2535 1856 2546 1769 2535 1767 2535 1670 2548 1570 2537 1568 2537 1566 2537 1538 2550 1399 2550 1380 2537 1378 2537 1375 2537 1373 2537 1302 2548 1280 2537 1278 2537 1276 2537 1274 2537 1271 2537 1254 2550 1193 2539 1191 2539 1189 2539 1159 2550 1038 2539 1035 2539 1033 2539 1001 2550 394 2548 396 2585"/>
                        </Shape>
                        <String CONTENT="Indighirka. At the same time, other bands went from the Dry Anui to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l34" HPOS="390" VPOS="2602" WIDTH="1769" HEIGHT="58" BASELINE="392 2645 2159 2637" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2645 392 2660 2157 2652 2159 2637 2153 2602 390 2608 392 2645"/>
                        </Shape>
                        <String CONTENT="Large Anui, and thence to the Oloi and the Omolon, driving the original"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l35" HPOS="390" VPOS="2656" WIDTH="1767" HEIGHT="67" BASELINE="392 2704 2157 2695" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 2704 392 2723 2155 2715 2157 2695 2153 2667 1886 2656 1884 2656 1711 2667 1289 2658 1287 2658 1284 2658 1254 2671 390 2671 392 2704"/>
                        </Shape>
                        <String CONTENT="inhabitants, the Lamut, farther and farther into the woods, or settling side by"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l36" HPOS="388" VPOS="2728" WIDTH="1031" HEIGHT="52" BASELINE="390 2764 1419 2758" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2764 390 2780 1416 2773 1419 2758 1412 2728 388 2732 390 2764"/>
                        </Shape>
                        <String CONTENT="side with them on the borders of the forest."/>
                    </TextLine>
</TextBlock>
