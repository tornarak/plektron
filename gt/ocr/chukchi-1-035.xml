                        </Shape>
                        <String CONTENT="campaigns which the Russians conducted against the Chukchee, in the eigh-"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l11" HPOS="409" VPOS="1234" WIDTH="1769" HEIGHT="62" BASELINE="411 1279 2178 1273" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1279 411 1294 2174 1296 2178 1273 2174 1242 1002 1234 1000 1234 998 1234 965 1244 524 1236 521 1236 409 1247 411 1279"/>
                        </Shape>
                        <String CONTENT="teenth century, utterly miscarried, since the Cossack captain, A. Shestakoff,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l12" HPOS="407" VPOS="1292" WIDTH="1773" HEIGHT="61" BASELINE="409 1337 2180 1333" TAGREFS="TYPE_5">
                        <Shape>
