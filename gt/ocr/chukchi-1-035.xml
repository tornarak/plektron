                        </Shape>
                        <String CONTENT="campaigns which the Russians conducted against the Chukchee, in the eigh-"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l11" HPOS="388" VPOS="1219" WIDTH="1769" HEIGHT="62" BASELINE="390 1264 2157 1258" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1264 390 1279 2153 1281 2157 1258 2153 1227 981 1219 979 1219 977 1219 944 1229 503 1221 500 1221 388 1232 390 1264"/>
                        </Shape>
                        <String CONTENT="teenth century, utterly miscarried, since the Cossack captain, A. Shestakoff,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l12" HPOS="386" VPOS="1277" WIDTH="1773" HEIGHT="61" BASELINE="388 1322 2159 1318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 1322 388 1338 2157 1333 2159 1318 2155 1290 2053 1277 2051 1277 1949 1288 1624 1277 1622 1277 1620 1277 1575 1288 1529 1277 1527 1277 1525 1277 1523 1277 1499 1290 1267 1290 526 1279 524 1279 522 1279 520 1279 505 1292 386 1292 388 1322"/>
                        </Shape>
                        <String CONTENT="was defeated and killed March 14, 1730, on the river Egaˊč; and Mayor"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l13" HPOS="388" VPOS="1335" WIDTH="1771" HEIGHT="65" BASELINE="390 1385 2159 1377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1385 390 1400 2157 1394 2159 1377 2155 1346 1718 1335 1715 1335 1713 1335 1711 1335 1698 1348 388 1348 390 1385"/>
                        </Shape>
                        <String CONTENT="Pavlutzky, after some temporary success, was likewise defeated and killed"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l14" HPOS="390" VPOS="1409" WIDTH="1765" HEIGHT="50" BASELINE="392 1444 2155 1439" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1444 392 1459 2153 1455 2155 1439 2151 1409 390 1409 392 1444"/>
                        </Shape>
