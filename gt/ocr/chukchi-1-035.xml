                        <Shape>
                            <Polygon POINTS="392 1983 392 1998 2155 1991 2157 1976 2153 1948 427 1942 425 1942 422 1942 390 1952 392 1983"/>
                        </Shape>
                        <String CONTENT="of Russianization; and there are many camps and villages where a Russian"/>
