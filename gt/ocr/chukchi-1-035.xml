                        <Polygon POINTS="408 2081 2186 2081 2186 2793 408 2793"/>
                    </Shape>
                    <TextLine ID="mz_1-035_l25" HPOS="517" VPOS="2078" WIDTH="1661" HEIGHT="56" BASELINE="519 2119 2178 2110" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="519 2119 519 2134 2176 2128 2178 2110 2174 2078 541 2078 539 2078 537 2078 517 2087 519 2119"/>
                        </Shape>
                        <String CONTENT="About a century ago the territory of the Reindeer Chukchee extended"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l26" HPOS="409" VPOS="2132" WIDTH="1769" HEIGHT="61" BASELINE="411 2180 2178 2173" TAGREFS="TYPE_5">
