                    <TextLine ID="mz_1-035_l19" HPOS="388" VPOS="1708" WIDTH="1767" HEIGHT="50" BASELINE="390 1742 2155 1736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1742 390 1758 2153 1751 2155 1736 2148 1708 388 1712 390 1742"/>
                        </Shape>
                        <String CONTENT="whole time with much circumspection, and no new attempt was made to"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l20" HPOS="388" VPOS="1758" WIDTH="1771" HEIGHT="58" BASELINE="390 1803 2159 1799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1803 390 1816 2157 1812 2159 1799 2155 1771 2055 1758 2053 1758 2051 1758 2025 1768 1967 1758 1964 1758 1698 1768 1527 1758 1525 1758 1523 1758 1484 1768 1339 1758 1336 1758 1334 1758 1332 1758 1317 1768 719 1760 717 1760 715 1760 674 1771 622 1760 620 1760 617 1760 615 1760 598 1773 388 1773 390 1803"/>
                        </Shape>
                        <String CONTENT="conquer the Chukchee by force. The border divisions of the tribe have"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l21" HPOS="390" VPOS="1818" WIDTH="1767" HEIGHT="67" BASELINE="392 1866 2157 1859" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1866 392 1885 2155 1879 2157 1859 2153 1827 1016 1818 1014 1818 1012 1818 975 1829 483 1820 481 1820 390 1831 392 1866"/>
                        </Shape>
                        <String CONTENT="gradually submitted to Russian influence. The bulk of the Chukchee territory,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l22" HPOS="388" VPOS="1879" WIDTH="1773" HEIGHT="69" BASELINE="390 1924 2161 1918" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 1924 390 1937 914 1948 916 1948 1614 1935 2088 1944 2090 1944 2161 1931 2161 1918 2157 1890 1570 1879 1568 1879 1566 1879 1529 1892 388 1892 390 1924"/>
                        </Shape>
                        <String CONTENT="however, up to the present time, remains practically exempt from any trace"/>
                    </TextLine>

