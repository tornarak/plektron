                            <Polygon POINTS="519 1697 519 1712 2178 1708 2180 1693 2176 1664 517 1664 519 1697"/>
                        </Shape>
                        <String CONTENT="Intercourse with the Chukchee, renewed in 1789, was carried on the"/>
