                    </TextLine>

                    <TextLine ID="mz_1-035_l14" HPOS="411" VPOS="1424" WIDTH="1765" HEIGHT="50" BASELINE="413 1459 2176 1454" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1459 413 1474 2174 1470 2176 1454 2172 1424 411 1424 413 1459"/>
                        </Shape>
