                        <Shape>
                            <Polygon POINTS="498 1141 498 1156 2157 1151 2159 1136 2155 1108 496 1108 498 1141"/>
                        </Shape>
                        <String CONTENT="The reason for this unusual forbearance lies in the fact that the last"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l10" HPOS="386" VPOS="1158" WIDTH="1773" HEIGHT="67" BASELINE="388 1203 2159 1199" TAGREFS="TYPE_5">
