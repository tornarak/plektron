                    <TextLine ID="mz_1-035_l19" HPOS="409" VPOS="1723" WIDTH="1767" HEIGHT="50" BASELINE="411 1757 2176 1751" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1757 411 1773 2174 1766 2176 1751 2169 1723 409 1727 411 1757"/>
                        </Shape>
                        <String CONTENT="whole time with much circumspection, and no new attempt was made to"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l20" HPOS="409" VPOS="1773" WIDTH="1771" HEIGHT="58" BASELINE="411 1818 2180 1814" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1818 411 1831 2178 1827 2180 1814 2176 1786 2076 1773 2074 1773 2072 1773 2046 1783 1988 1773 1985 1773 1719 1783 1548 1773 1546 1773 1544 1773 1505 1783 1360 1773 1357 1773 1355 1773 1353 1773 1338 1783 740 1775 738 1775 736 1775 695 1786 643 1775 641 1775 638 1775 636 1775 619 1788 409 1788 411 1818"/>
                        </Shape>
                        <String CONTENT="conquer the Chukchee by force. The border divisions of the tribe have"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l21" HPOS="411" VPOS="1833" WIDTH="1767" HEIGHT="67" BASELINE="413 1881 2178 1874" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1881 413 1900 2176 1894 2178 1874 2174 1842 1037 1833 1035 1833 1033 1833 996 1844 504 1835 502 1835 411 1846 413 1881"/>
                        </Shape>
                        <String CONTENT="gradually submitted to Russian influence. The bulk of the Chukchee territory,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l22" HPOS="409" VPOS="1894" WIDTH="1773" HEIGHT="69" BASELINE="411 1939 2182 1933" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1939 411 1952 935 1963 937 1963 1635 1950 2109 1959 2111 1959 2182 1946 2182 1933 2178 1905 1591 1894 1589 1894 1587 1894 1550 1907 409 1907 411 1939"/>
                        </Shape>
                        <String CONTENT="however, up to the present time, remains practically exempt from any trace"/>
                    </TextLine>

