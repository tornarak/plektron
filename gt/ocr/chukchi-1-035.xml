                    <TextLine ID="mz_1-035_l28" HPOS="411" VPOS="2264" WIDTH="1767" HEIGHT="52" BASELINE="413 2301 2178 2294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2301 413 2314 2174 2316 2178 2294 2174 2264 411 2264 413 2301"/>
                        </Shape>
                        <String CONTENT="but in the early twenties of the nineteenth century the Reindeer Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l29" HPOS="411" VPOS="2312" WIDTH="1769" HEIGHT="65" BASELINE="413 2362 2180 2351" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2362 413 2377 2178 2366 2180 2351 2176 2323 2029 2312 2027 2312 1821 2325 411 2325 413 2362"/>
                        </Shape>
                        <String CONTENT="induced in a measure by the increase of their herds, began to extend their"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l30" HPOS="411" VPOS="2372" WIDTH="1767" HEIGHT="63" BASELINE="413 2420 2178 2413" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2420 413 2435 2176 2429 2178 2413 2174 2383 1624 2372 1622 2372 1619 2372 1585 2385 411 2385 413 2420"/>
                        </Shape>
                        <String CONTENT="boundaries westward and southward. In the sixties they crossed the Kolyma"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l31" HPOS="413" VPOS="2433" WIDTH="1769" HEIGHT="63" BASELINE="415 2478 2182 2474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2478 415 2496 2180 2494 2182 2474 2178 2444 1310 2433 1308 2433 1305 2433 1303 2433 1290 2446 413 2446 415 2478"/>
                        </Shape>
                        <String CONTENT="River, and spread over the flat tundra between the Kolyma and the Alaseya;"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l32" HPOS="411" VPOS="2502" WIDTH="1769" HEIGHT="61" BASELINE="413 2539 2180 2530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2539 413 2563 2178 2548 2180 2530 2174 2502 411 2509 413 2539"/>
                        </Shape>
                        <String CONTENT="the people of some camps even crossed the Alaseya, and went as far as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l33" HPOS="415" VPOS="2550" WIDTH="1767" HEIGHT="69" BASELINE="417 2600 2182 2591" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2600 417 2613 1732 2619 1734 2619 1736 2619 1771 2608 2159 2617 2161 2617 2163 2617 2165 2617 2182 2606 2182 2591 2178 2563 2126 2550 2124 2550 2122 2550 2094 2561 1914 2550 1912 2550 1910 2550 1877 2561 1790 2550 1788 2550 1691 2563 1591 2552 1589 2552 1587 2552 1559 2565 1420 2565 1401 2552 1399 2552 1396 2552 1394 2552 1323 2563 1301 2552 1299 2552 1297 2552 1295 2552 1292 2552 1275 2565 1214 2554 1212 2554 1210 2554 1180 2565 1059 2554 1056 2554 1054 2554 1022 2565 415 2563 417 2600"/>
                        </Shape>
                        <String CONTENT="Indighirka. At the same time, other bands went from the Dry Anui to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l34" HPOS="411" VPOS="2617" WIDTH="1769" HEIGHT="58" BASELINE="413 2660 2180 2652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2660 413 2675 2178 2667 2180 2652 2174 2617 411 2623 413 2660"/>
                        </Shape>
                        <String CONTENT="Large Anui, and thence to the Oloi and the Omolon, driving the original"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l35" HPOS="411" VPOS="2671" WIDTH="1767" HEIGHT="67" BASELINE="413 2719 2178 2710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2719 413 2738 2176 2730 2178 2710 2174 2682 1907 2671 1905 2671 1732 2682 1310 2673 1308 2673 1305 2673 1275 2686 411 2686 413 2719"/>
                        </Shape>
                        <String CONTENT="inhabitants, the Lamut, farther and farther into the woods, or settling side by"/>
                    </TextLine>

                    <TextLine ID="mz_1-035_l36" HPOS="409" VPOS="2743" WIDTH="1031" HEIGHT="52" BASELINE="411 2779 1440 2773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2779 411 2795 1437 2788 1440 2773 1433 2743 409 2747 411 2779"/>
                        </Shape>
                        <String CONTENT="side with them on the borders of the forest."/>
                    </TextLine>
</TextBlock>
