                        <Shape>
                            <Polygon POINTS="413 1998 413 2013 2176 2006 2178 1991 2174 1963 448 1957 446 1957 443 1957 411 1967 413 1998"/>
                        </Shape>
                        <String CONTENT="of Russianization; and there are many camps and villages where a Russian"/>
