                    <TextLine ID="mz_1-035_l18" HPOS="496" VPOS="1649" WIDTH="1663" HEIGHT="48" BASELINE="498 1682 2159 1678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="498 1682 498 1697 2157 1693 2159 1678 2155 1649 496 1649 498 1682"/>
                        </Shape>
                        <String CONTENT="Intercourse with the Chukchee, renewed in 1789, was carried on the"/>
