                        </Shape>
                        <String CONTENT="and is so large that it can attack big game. When hungry, it is very active,"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l35" HPOS="415" VPOS="2665" WIDTH="1776" HEIGHT="62" BASELINE="417 2710 2191 2704" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="417 2710 417 2727 2189 2727 2191 2704 2187 2673 1017 2665 1015 2665 1013 2665 981 2675 489 2667 487 2667 415 2678 417 2710"/>
                        </Shape>
                        <String CONTENT="and will spring from ambush upon a wild reindeer, and then, after having"/>
