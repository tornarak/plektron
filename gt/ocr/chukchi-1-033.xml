                <TextBlock ID="text_1-033" HPOS="351" VPOS="632" WIDTH="1841" HEIGHT="2669"><TextLine ID="mz_1-033_l1" HPOS="979" VPOS="632" WIDTH="622" HEIGHT="54" BASELINE="979 666 1601 666" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1585 632 983 632 979 634 979 666 979 686 1601 686 1601 666 1598 662 1585 632"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l2" HPOS="2131" VPOS="636" WIDTH="20" HEIGHT="65" BASELINE="2131 677 2151 677" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2131 677 2131 692 2146 701 2151 677 2148 636 2131 636 2131 677"/>
                        </Shape>
                        <String CONTENT="13"/>
                    </TextLine>
<TextLine ID="mz_1-033_l3" HPOS="405" VPOS="729" WIDTH="1787" HEIGHT="70" BASELINE="407 777 2192 770" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 777 407 792 2157 799 2159 799 2161 799 2192 786 2192 770 2187 742 2105 729 2103 729 1980 740 1956 729 1954 729 1951 729 1897 740 1869 729 1867 729 1865 729 1778 740 1741 729 1739 729 1737 729 1683 740 1618 729 1616 729 1614 729 1562 742 1486 731 1484 731 1481 731 1455 744 1310 744 1243 731 1241 731 1239 731 1237 731 1219 742 1083 731 1081 731 1079 731 1038 742 1005 731 1003 731 1001 731 999 731 966 744 916 734 914 734 791 744 758 734 756 734 754 734 752 734 730 744 646 734 643 734 591 744 433 734 431 734 429 734 405 744 407 777"/>
                        </Shape>
                        <String CONTENT="clothing, though made of reindeer-skins, are invariably given the form of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l4" HPOS="403" VPOS="790" WIDTH="1771" HEIGHT="65" BASELINE="405 838 2174 831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 838 405 855 2172 848 2174 831 2172 803 2135 790 2133 790 2131 790 2042 801 1954 790 1951 790 1949 790 1928 801 1876 790 1873 790 1871 790 1847 801 1821 790 1819 790 1817 790 1815 790 1776 801 1529 792 1527 792 1525 792 1503 803 1092 792 1089 792 1087 792 1061 803 1022 792 1020 792 1018 792 944 805 914 794 912 794 910 794 708 805 617 794 615 794 613 794 611 794 596 805 479 794 477 794 403 807 405 838"/>
                        </Shape>
                        <String CONTENT="seal-skin bag, stripped whole from the carcass, with a cross-slit in the middle"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l5" HPOS="403" VPOS="863" WIDTH="364" HEIGHT="63" BASELINE="405 894 767 898" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 894 403 909 435 920 438 920 440 920 572 911 591 924 594 924 596 924 598 926 745 926 745 924 747 924 749 924 765 911 767 898 765 868 405 863 405 894"/>
                        </Shape>
                        <String CONTENT="for an opening."/>
                    </TextLine>
<TextLine ID="mz_1-033_l6" HPOS="513" VPOS="922" WIDTH="1661" HEIGHT="50" BASELINE="513 954 2174 954" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="513 954 513 972 2174 972 2174 954 2174 924 513 922 513 954"/>
                        </Shape>
                        <String CONTENT="In religious beliefs and rites the dog plays a more important part than"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l7" HPOS="405" VPOS="974" WIDTH="1769" HEIGHT="58" BASELINE="405 1015 2174 1015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1015 405 1032 2174 1032 2174 1015 2174 985 2144 974 2142 974 2140 974 1997 985 1468 974 1466 974 1161 985 1109 974 1107 974 1105 974 1063 985 1003 974 1001 974 890 985 864 974 862 974 860 974 806 985 758 974 756 974 754 974 650 985 557 974 555 974 483 985 431 974 429 974 427 974 405 985 405 1015"/>
                        </Shape>
                        <String CONTENT="the reindeer, though, under the present condition of life, dogs are of little"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l8" HPOS="407" VPOS="1045" WIDTH="1765" HEIGHT="48" BASELINE="407 1073 2172 1073" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1073 407 1093 2172 1093 2172 1073 2172 1045 407 1045 407 1073"/>
                        </Shape>
                        <String CONTENT="use to the people; besides, dog-breeding does not harmonize well with reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l9" HPOS="405" VPOS="1091" WIDTH="1769" HEIGHT="60" BASELINE="407 1136 2174 1130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1136 407 1151 2172 1145 2174 1130 2170 1102 1637 1091 1635 1091 1577 1104 405 1104 407 1136"/>
                        </Shape>
                        <String CONTENT="breeding, as will be shown later on. I was told several times by the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l10" HPOS="403" VPOS="1154" WIDTH="1774" HEIGHT="67" BASELINE="405 1199 2177 1193" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1199 405 1216 1118 1221 1120 1221 1122 1221 1163 1210 1304 1221 1306 1221 1308 1221 1349 1210 1427 1221 1429 1221 1432 1221 1434 1221 1449 1210 1655 1219 1657 1219 1761 1208 1876 1219 1878 1219 1880 1219 1899 1208 1912 1219 1915 1219 1917 1219 1919 1221 2016 1221 2016 1219 2077 1208 2153 1219 2155 1219 2157 1219 2159 1219 2177 1206 2177 1193 2172 1162 1014 1154 1012 1154 1009 1154 962 1164 511 1156 509 1156 403 1167 405 1199"/>
                        </Shape>
                        <String CONTENT="people, “The Russians unjustly wonder why we keep so many dogs. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l11" HPOS="403" VPOS="1212" WIDTH="1771" HEIGHT="63" BASELINE="405 1258 2174 1253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1258 405 1275 2172 1275 2174 1253 2170 1223 1293 1212 1291 1212 1289 1212 1287 1212 1274 1223 429 1214 427 1214 425 1214 403 1223 405 1258"/>
                        </Shape>
                        <String CONTENT="dog is the guardian of man, a strong help in every misfortune, a true friend,"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l12" HPOS="403" VPOS="1271" WIDTH="1771" HEIGHT="69" BASELINE="405 1318 2174 1312" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1318 405 1331 1012 1340 1014 1340 1180 1329 1399 1340 1401 1340 1403 1340 1406 1340 1419 1331 1429 1340 1432 1340 1434 1340 1436 1340 1438 1340 1484 1329 1572 1340 1575 1340 1646 1327 1670 1338 1672 1338 1674 1338 1676 1338 1702 1327 2153 1338 2155 1338 2157 1338 2159 1338 2174 1325 2174 1312 2170 1281 1884 1271 1882 1271 403 1284 405 1318"/>
                        </Shape>
                        <String CONTENT="keeping off the Evil One.” In travelling, a dog as a companion frightens"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l13" HPOS="403" VPOS="1335" WIDTH="1771" HEIGHT="59" BASELINE="405 1377 2174 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1377 405 1394 2172 1387 2174 1370 2170 1342 422 1335 420 1335 418 1335 416 1335 403 1342 405 1377"/>
                        </Shape>
                        <String CONTENT="the evil spirit away, while a reindeer has no such power. In times of infectious"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l14" HPOS="403" VPOS="1394" WIDTH="1771" HEIGHT="56" BASELINE="405 1435 2174 1431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1435 405 1450 2172 1446 2174 1431 2170 1398 425 1394 422 1394 420 1394 418 1394 403 1400 405 1435"/>
                        </Shape>
                        <String CONTENT="disease a small pup is rubbed against visitors coming from afar. This will"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l15" HPOS="403" VPOS="1455" WIDTH="1771" HEIGHT="58" BASELINE="405 1498 2174 1491" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1498 405 1513 2172 1506 2174 1491 2170 1461 433 1455 431 1455 429 1455 403 1463 405 1498"/>
                        </Shape>
                        <String CONTENT="either frighten away the spirits that may come with the traveller, or, if they"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l16" HPOS="403" VPOS="1515" WIDTH="1425" HEIGHT="67" BASELINE="405 1558 1828 1550" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1558 405 1571 581 1571 620 1582 622 1582 624 1582 795 1580 797 1580 799 1580 799 1578 810 1569 1826 1569 1828 1550 1824 1522 760 1515 758 1515 403 1528 405 1558"/>
                        </Shape>
                        <String CONTENT="are too powerful, it will at least serve as an expiatory victim."/>
                    </TextLine>
<TextLine ID="mz_1-033_l17" HPOS="509" VPOS="1574" WIDTH="1665" HEIGHT="58" BASELINE="511 1615 2174 1608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="511 1615 511 1632 2172 1626 2174 1608 2170 1580 526 1574 524 1574 522 1574 520 1574 509 1580 511 1615"/>
                        </Shape>
                        <String CONTENT="On the other hand, the names of the months, both in Chukchee and in"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l18" HPOS="401" VPOS="1639" WIDTH="1773" HEIGHT="52" BASELINE="403 1673 2174 1669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1673 403 1691 2172 1686 2174 1669 2168 1639 401 1639 403 1673"/>
                        </Shape>
                        <String CONTENT="Koryak, curiously enough, indicate that both of these tribes, or some parts"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l19" HPOS="403" VPOS="1697" WIDTH="1771" HEIGHT="54" BASELINE="405 1734 2174 1729" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1734 405 1751 2172 1747 2174 1729 2168 1697 403 1704 405 1734"/>
                        </Shape>
                        <String CONTENT="of them, came from more southern latitudes, and that perhaps they had"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l20" HPOS="401" VPOS="1751" WIDTH="1776" HEIGHT="67" BASELINE="403 1794 2177 1790" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1794 403 1807 1287 1818 1289 1818 1291 1818 1293 1818 1293 1816 1304 1807 2112 1816 2114 1816 2177 1803 2177 1790 2172 1762 1326 1751 1323 1751 1258 1762 453 1753 451 1753 401 1764 403 1794"/>
                        </Shape>
                        <String CONTENT="reindeer-herds at that time. The fact is, that some of these names do not"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l21" HPOS="405" VPOS="1825" WIDTH="1769" HEIGHT="45" BASELINE="405 1853 2174 1853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1853 405 1870 2174 1870 2174 1853 2174 1825 405 1825 405 1853"/>
                        </Shape>
                        <String CONTENT="correspond to the real change of the seasons on the northern tundra. For"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l22" HPOS="401" VPOS="1872" WIDTH="1773" HEIGHT="59" BASELINE="403 1914 2174 1909" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1914 403 1931 2172 1927 2174 1909 2170 1877 414 1872 412 1872 409 1872 407 1872 407 1875 401 1879 403 1914"/>
                        </Shape>
                        <String CONTENT="instance, the fifth month of the Chukchee year (from the beginning of April"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l23" HPOS="401" VPOS="1927" WIDTH="1771" HEIGHT="73" BASELINE="403 1976 2172 1970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1976 403 1989 801 2000 804 2000 886 1989 990 2000 992 2000 994 2000 1022 1987 1232 1987 1248 1998 1250 1998 1252 1998 1254 1998 2170 1985 2172 1970 2170 1939 2120 1927 2118 1927 2116 1927 1967 1937 1798 1927 1795 1927 1793 1927 1791 1927 1774 1937 1746 1927 1744 1927 1741 1927 1579 1939 1542 1929 1540 1929 1538 1929 1536 1929 1512 1939 1499 1929 1497 1929 1494 1929 1492 1929 1438 1939 1384 1929 1382 1929 1300 1939 1245 1929 1243 1929 1241 1929 1239 1929 1224 1939 1135 1929 1133 1929 1061 1939 1033 1929 1031 1929 1029 1929 1027 1929 1025 1929 1012 1939 996 1929 994 1929 992 1929 990 1929 988 1929 960 1942 944 1931 942 1931 940 1931 938 1931 771 1942 739 1931 736 1931 734 1931 732 1931 704 1942 669 1931 667 1931 665 1931 663 1931 661 1931 643 1942 591 1931 589 1931 537 1942 507 1931 505 1931 503 1931 401 1944 403 1976"/>
                        </Shape>
                        <String CONTENT="to the beginning of May) is called “[month] of the waters” (Imlɪˊrɪlɪn). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l24" HPOS="399" VPOS="1989" WIDTH="1775" HEIGHT="70" BASELINE="401 2035 2174 2030" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="401 2035 401 2048 1124 2059 1126 2059 1128 2059 1152 2048 1239 2059 1241 2059 1243 2059 1287 2046 1304 2056 1306 2056 1308 2056 1310 2056 1399 2046 1707 2046 1739 2056 1741 2056 1744 2056 1746 2056 1748 2056 1765 2046 1791 2056 1793 2056 1795 2056 2172 2046 2174 2030 2168 1996 2014 2000 1949 1989 1947 1989 1850 2000 1746 1989 1744 1989 1741 1989 1698 2000 1663 1989 1661 1989 1659 1989 1568 2000 1512 1989 1510 1989 1507 1989 1505 1989 1490 2002 1393 2002 1352 1989 1349 1989 1347 1989 1280 2004 962 2004 934 1991 931 1991 929 1991 877 2002 825 1991 823 1991 713 2002 659 1991 656 1991 654 1991 633 2002 598 1991 596 1991 594 1991 533 2002 431 1991 429 1991 427 1991 399 2000 401 2035"/>
                        </Shape>
                        <String CONTENT="rivers of the tundra, however, open only at the end of May. The third"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l25" HPOS="401" VPOS="2046" WIDTH="1769" HEIGHT="65" BASELINE="403 2095 2170 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2095 403 2111 2168 2102 2170 2087 2166 2059 1917 2046 1915 2046 1912 2046 1910 2046 1891 2059 1780 2059 1756 2046 1754 2046 1752 2046 1668 2059 1360 2048 1358 2048 1356 2048 1354 2048 1336 2059 1313 2048 1310 2048 1308 2048 1222 2061 1059 2050 1057 2050 1055 2050 1020 2061 986 2050 983 2050 981 2050 914 2061 888 2050 886 2050 884 2050 821 2063 793 2052 791 2052 788 2052 552 2063 518 2052 516 2052 513 2052 401 2065 403 2095"/>
                        </Shape>
                        <String CONTENT="month of the Koryak calendar is called “false reindeer-birth month” (Tɪˊnmɪ-"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l26" HPOS="401" VPOS="2108" WIDTH="1769" HEIGHT="63" BASELINE="403 2156 2170 2150" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2156 403 2171 2168 2165 2170 2150 2166 2119 1609 2108 1607 2108 1605 2108 1575 2119 1044 2111 1042 2111 986 2121 468 2113 466 2113 401 2124 403 2156"/>
                        </Shape>
                        <String CONTENT="qoˊya-yo-yêˊᵋḷhɪn); and the fourth, “genuine reindeer-birth month” (Lhê-qoˊya-"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l27" HPOS="401" VPOS="2171" WIDTH="1773" HEIGHT="67" BASELINE="403 2219 2174 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2219 403 2238 2172 2225 2174 2210 2170 2180 1289 2171 1287 2171 1198 2182 503 2175 500 2175 401 2186 403 2219"/>
                        </Shape>
                        <String CONTENT="yo-yêˊᵋḷhɪn). These names seem to indicate that in some former country fawns"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l28" HPOS="403" VPOS="2232" WIDTH="1771" HEIGHT="63" BASELINE="405 2275 2174 2269" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 2275 405 2288 2157 2295 2159 2295 2161 2295 2164 2295 2174 2284 2174 2269 2170 2240 994 2232 992 2232 990 2232 957 2243 539 2234 537 2234 403 2245 405 2275"/>
                        </Shape>
                        <String CONTENT="were born a month earlier than in the present home of the Koryak. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l29" HPOS="401" VPOS="2288" WIDTH="1771" HEIGHT="65" BASELINE="403 2336 2172 2327" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2336 403 2353 2170 2344 2172 2327 2168 2299 1806 2288 1804 2288 1724 2299 1287 2290 1284 2290 1165 2303 401 2303 403 2336"/>
                        </Shape>
                        <String CONTENT="incongruity in both cases was pointed out to me by the natives, who them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l30" HPOS="399" VPOS="2364" WIDTH="656" HEIGHT="47" BASELINE="399 2394 1055 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="399 2394 399 2411 1055 2411 1055 2394 1055 2364 399 2364 399 2394"/>
                        </Shape>
                        <String CONTENT="selves were astonished at it."/>
                    </TextLine>
<TextLine ID="mz_1-033_l31" HPOS="509" VPOS="2407" WIDTH="1663" HEIGHT="61" BASELINE="511 2453 2172 2448" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="511 2453 511 2468 2170 2463 2172 2448 2168 2420 2014 2407 2012 2407 2010 2407 1984 2418 1958 2407 1956 2407 1954 2407 1951 2407 1949 2407 1934 2420 1789 2420 1720 2407 1718 2407 1616 2418 1536 2407 1533 2407 1531 2407 1529 2407 1514 2420 1395 2420 1365 2407 1362 2407 1360 2407 1300 2420 1282 2409 1280 2409 1278 2409 1276 2409 1219 2420 1163 2409 1161 2409 1159 2409 1128 2420 931 2409 929 2409 927 2409 886 2420 799 2409 797 2409 704 2420 626 2409 624 2409 622 2409 587 2420 535 2409 533 2409 531 2409 529 2409 509 2420 511 2453"/>
                        </Shape>
                        <String CONTENT="Another curious detail in the Chukchee tradition points even farther to"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l32" HPOS="399" VPOS="2472" WIDTH="1773" HEIGHT="59" BASELINE="401 2515 2172 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="401 2515 401 2531 2170 2522 2172 2507 2168 2479 843 2472 840 2472 838 2472 806 2483 418 2474 416 2474 414 2474 412 2474 399 2481 401 2515"/>
                        </Shape>
                        <String CONTENT="the south. It is the description of a large worm that lives near the villages"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l33" HPOS="394" VPOS="2535" WIDTH="1774" HEIGHT="58" BASELINE="396 2576 2168 2567" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2576 396 2593 2166 2593 2168 2567 2161 2535 394 2541 396 2576"/>
                        </Shape>
                        <String CONTENT="of the dead, on the Aurora Borealis. This worm is red in color, and striped,"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l34" HPOS="355" VPOS="2602" WIDTH="1815" HEIGHT="48" BASELINE="355 2630 2170 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2630 355 2647 2168 2650 2170 2630 2170 2602 355 2602 355 2630"/>
                        </Shape>
                        <String CONTENT="and is so large that it can attack big game. When hungry, it is very active,"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l35" HPOS="394" VPOS="2650" WIDTH="1776" HEIGHT="62" BASELINE="396 2695 2170 2689" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2695 396 2712 2168 2712 2170 2689 2166 2658 996 2650 994 2650 992 2650 960 2660 468 2652 466 2652 394 2663 396 2695"/>
                        </Shape>
                        <String CONTENT="and will spring from ambush upon a wild reindeer, and then, after having"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l36" HPOS="351" VPOS="2704" WIDTH="1819" HEIGHT="78" BASELINE="353 2764 637 2754 2170 2749" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2764 355 2782 388 2771 2168 2771 2170 2749 2166 2719 2058 2704 2055 2704 2053 2704 2025 2719 1932 2719 1841 2706 1839 2706 1837 2706 1834 2706 1815 2721 1761 2721 1711 2706 1709 2706 1707 2706 1616 2719 1579 2706 1577 2706 1575 2706 1510 2719 1468 2706 1466 2706 1464 2706 1462 2706 1414 2721 1356 2708 1354 2708 1284 2723 1063 2723 1012 2708 1009 2708 1007 2708 1005 2708 973 2721 912 2708 910 2708 908 2708 873 2723 838 2710 836 2710 672 2710 669 2710 607 2723 589 2710 587 2710 585 2710 451 2710 448 2710 351 2723 353 2764"/>
                        </Shape>
                        <String CONTENT="seized it, will kill it with the pressure of its coils. It swallows its prey whole,"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l37" HPOS="375" VPOS="2775" WIDTH="1797" HEIGHT="56" BASELINE="377 2814 2172 2805" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2814 377 2831 2170 2823 2172 2805 2168 2777 375 2775 377 2814"/>
                        </Shape>
                        <String CONTENT="since it has no teeth. After taking a meal, it becomes inert, and sleeps for"/>
                    </TextLine>

