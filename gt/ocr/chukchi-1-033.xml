                        </Shape>
                        <String CONTENT="Another curious detail in the Chukchee tradition points even farther to"/>
                    </TextLine>

                    <TextLine ID="mz_1-033_l32" HPOS="420" VPOS="2487" WIDTH="1773" HEIGHT="59" BASELINE="422 2530 2193 2522" TAGREFS="TYPE_4">
