                        <Shape>
                            <Polygon POINTS="404 2684 404 2699 2174 2695 2176 2680 2172 2649 1390 2639 1388 2639 1284 2649 638 2641 636 2641 402 2652 404 2684"/>
                        </Shape>
                        <String CONTENT="some small glacier, where the insects are less numerous than in the valleys."/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l44" HPOS="404" VPOS="2697" WIDTH="1772" HEIGHT="59" BASELINE="407 2743 2176 2738" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2743 407 2756 2174 2751 2176 2738 2172 2710 1613 2697 1611 2697 1511 2708 1457 2697 1455 2697 1364 2708 1321 2697 1318 2697 1316 2697 1314 2697 1260 2710 710 2699 708 2699 706 2699 677 2710 580 2699 578 2699 576 2699 534 2710 422 2699 420 2699 417 2699 415 2699 404 2708 407 2743"/>
                        </Shape>
                        <String CONTENT="Often these herds do not thrive so well as those which are driven down to"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l45" HPOS="404" VPOS="2758" WIDTH="1770" HEIGHT="58" BASELINE="407 2803 2174 2799" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2803 407 2816 2172 2814 2174 2799 2169 2771 1461 2758 1459 2758 1403 2769 1366 2758 1364 2758 1362 2758 1264 2771 1238 2760 1236 2760 1234 2760 740 2771 645 2760 643 2760 641 2760 638 2760 623 2773 487 2773 426 2760 424 2760 422 2760 420 2760 404 2769 407 2803"/>
                        </Shape>
                        <String CONTENT="the sea. The range of the wanderings of a Chukchee camp extends from a"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l46" HPOS="404" VPOS="2827" WIDTH="1772" HEIGHT="52" BASELINE="407 2864 2176 2855" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2864 407 2879 2174 2870 2176 2855 2172 2827 404 2827 407 2864"/>
                        </Shape>
