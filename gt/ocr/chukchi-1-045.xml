                    <TextLine ID="mz_1-045_l36" HPOS="386" VPOS="2204" WIDTH="1769" HEIGHT="60" BASELINE="388 2249 2155 2245" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="388 2249 388 2264 2153 2260 2155 2245 2151 2217 2075 2204 2073 2204 2071 2204 2025 2217 1826 2217 1798 2204 1795 2204 1793 2204 1700 2214 1635 2204 1633 2204 1531 2214 1442 2204 1440 2204 1438 2204 1393 2214 1336 2204 1334 2204 1228 2217 706 2206 704 2206 626 2217 526 2206 524 2206 386 2219 388 2249"/>
                        </Shape>
                        <String CONTENT="watersheds, which are ordinarily so devoid of vegetation and so exposed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l37" HPOS="386" VPOS="2266" WIDTH="1771" HEIGHT="57" BASELINE="388 2308 2157 2303" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="388 2308 388 2323 2155 2318 2157 2303 2153 2273 427 2266 425 2266 422 2266 386 2277 388 2308"/>
                        </Shape>
                        <String CONTENT="winds as to be unfit for reindeer-breeding. In the fall the camps are moved"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l38" HPOS="383" VPOS="2327" WIDTH="1772" HEIGHT="56" BASELINE="386 2368 2155 2362" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="386 2368 386 2383 2153 2379 2155 2362 2151 2334 403 2327 401 2327 399 2327 396 2327 383 2334 386 2368"/>
                        </Shape>
                        <String CONTENT="to the border of the forest to find shelter from the winter tempests; while in"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l39" HPOS="383" VPOS="2383" WIDTH="1772" HEIGHT="61" BASELINE="386 2429 2155 2424" TAGREFS="TYPE_6">
