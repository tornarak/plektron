                        </Shape>
                        <String CONTENT="winds as to be unfit for reindeer-breeding. In the fall the camps are moved"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l38" HPOS="404" VPOS="2342" WIDTH="1772" HEIGHT="56" BASELINE="407 2383 2176 2377" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2383 407 2398 2174 2394 2176 2377 2172 2349 424 2342 422 2342 420 2342 417 2342 404 2349 407 2383"/>
                        </Shape>
                        <String CONTENT="to the border of the forest to find shelter from the winter tempests; while in"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l39" HPOS="404" VPOS="2398" WIDTH="1772" HEIGHT="61" BASELINE="407 2444 2176 2439" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2444 407 2459 2174 2455 2176 2439 2172 2411 2094 2398 2092 2398 2089 2398 2063 2409 2024 2398 2022 2398 2020 2398 2018 2398 1988 2409 1671 2398 1669 2398 1567 2409 1511 2398 1509 2398 1401 2409 1290 2398 1288 2398 1286 2398 1284 2398 1260 2411 693 2400 690 2400 688 2400 647 2411 569 2400 567 2400 487 2411 426 2400 424 2400 422 2400 420 2400 404 2409 407 2444"/>
                        </Shape>
                        <String CONTENT="the spring of the year the herds are driven to the tundra, as far as the sea-"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l40" HPOS="407" VPOS="2472" WIDTH="1771" HEIGHT="48" BASELINE="407 2502 2178 2502" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2502 407 2520 2178 2520 2178 2502 2178 2472 407 2472 407 2502"/>
                        </Shape>
                        <String CONTENT="coast, in order to be freer from noxious insects, and to give them pasturage"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l41" HPOS="398" VPOS="2528" WIDTH="1778" HEIGHT="50" BASELINE="400 2563 2176 2559" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="400 2563 400 2578 2174 2574 2176 2559 2169 2528 398 2530 400 2563"/>
                        </Shape>
                        <String CONTENT="better suited for the summer season. Some of the camps near the head waters"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l42" HPOS="402" VPOS="2580" WIDTH="1774" HEIGHT="59" BASELINE="404 2623 2176 2617" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="404 2623 404 2639 2174 2632 2176 2617 2172 2589 1024 2580 1022 2580 1020 2580 989 2591 439 2582 437 2582 435 2582 402 2593 404 2623"/>
                        </Shape>
                        <String CONTENT="of several rivers move to the mountains instead of to the sea, and stay near"/>
                    </TextLine>

