                            <Polygon POINTS="383 2669 383 2684 2153 2680 2155 2665 2151 2634 1369 2624 1367 2624 1263 2634 617 2626 615 2626 381 2637 383 2669"/>
                        </Shape>
                        <String CONTENT="some small glacier, where the insects are less numerous than in the valleys."/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l44" HPOS="383" VPOS="2682" WIDTH="1772" HEIGHT="59" BASELINE="386 2728 2155 2723" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="386 2728 386 2741 2153 2736 2155 2723 2151 2695 1592 2682 1590 2682 1490 2693 1436 2682 1434 2682 1343 2693 1300 2682 1297 2682 1295 2682 1293 2682 1239 2695 689 2684 687 2684 685 2684 656 2695 559 2684 557 2684 555 2684 513 2695 401 2684 399 2684 396 2684 394 2684 383 2693 386 2728"/>
                        </Shape>
                        <String CONTENT="Often these herds do not thrive so well as those which are driven down to"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l45" HPOS="383" VPOS="2743" WIDTH="1770" HEIGHT="58" BASELINE="386 2788 2153 2784" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="386 2788 386 2801 2151 2799 2153 2784 2148 2756 1440 2743 1438 2743 1382 2754 1345 2743 1343 2743 1341 2743 1243 2756 1217 2745 1215 2745 1213 2745 719 2756 624 2745 622 2745 620 2745 617 2745 602 2758 466 2758 405 2745 403 2745 401 2745 399 2745 383 2754 386 2788"/>
                        </Shape>
                        <String CONTENT="the sea. The range of the wanderings of a Chukchee camp extends from a"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l46" HPOS="383" VPOS="2812" WIDTH="1772" HEIGHT="52" BASELINE="386 2849 2155 2840" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="386 2849 386 2864 2153 2855 2155 2840 2151 2812 383 2812 386 2849"/>
                        </Shape>
                        <String CONTENT="hundred to a hundred and fifty miles, and in most cases covers the same or"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l47" HPOS="383" VPOS="2868" WIDTH="1774" HEIGHT="57" BASELINE="386 2909 2157 2901" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="386 2909 386 2925 2155 2916 2157 2901 2153 2870 477 2868 474 2868 383 2879 386 2909"/>
                        </Shape>
                        <String CONTENT="nearly the same territory every year; but any camp that becomes dissatisfied"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l48" HPOS="386" VPOS="2925" WIDTH="1769" HEIGHT="58" BASELINE="388 2966 2155 2961" TAGREFS="TYPE_6">
                        <Shape>
