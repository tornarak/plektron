                        </Shape>
                        <String CONTENT="CAMPS AND VILLAGES. — The camps of the Reindeer Chukchee are situated"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l35" HPOS="404" VPOS="2158" WIDTH="1772" HEIGHT="63" BASELINE="407 2206 2176 2199" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2206 407 2221 2174 2216 2176 2199 2172 2169 1780 2158 1777 2158 404 2169 407 2206"/>
                        </Shape>
                        <String CONTENT="in groups, mostly along the rivers; and their grazing-grounds are divided by"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l36" HPOS="407" VPOS="2219" WIDTH="1769" HEIGHT="60" BASELINE="409 2264 2176 2260" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2264 409 2279 2174 2275 2176 2260 2172 2232 2096 2219 2094 2219 2092 2219 2046 2232 1847 2232 1819 2219 1816 2219 1814 2219 1721 2229 1656 2219 1654 2219 1552 2229 1463 2219 1461 2219 1459 2219 1414 2229 1357 2219 1355 2219 1249 2232 727 2221 725 2221 647 2232 547 2221 545 2221 407 2234 409 2264"/>
                        </Shape>
                        <String CONTENT="watersheds, which are ordinarily so devoid of vegetation and so exposed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-045_l37" HPOS="407" VPOS="2281" WIDTH="1771" HEIGHT="57" BASELINE="409 2323 2178 2318" TAGREFS="TYPE_6">
                        <Shape>
