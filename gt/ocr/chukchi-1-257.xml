                <TextBlock ID="mz_1-257_r1" HPOS="326" VPOS="573" WIDTH="1778" HEIGHT="90" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="326 573 2104 573 2104 663 326 663"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l1" HPOS="903" VPOS="582" WIDTH="620" HEIGHT="54" BASELINE="905 617 1523 612" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1510 582 910 584 903 589 905 617 905 636 1520 632 1523 612 1518 597 1510 582"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l2" HPOS="1999" VPOS="589" WIDTH="98" HEIGHT="45" BASELINE="1999 617 2097 617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2086 610 2064 589 2010 589 1999 595 1999 617 1999 634 2097 634 2097 617 2097 604 2086 610"/>
                        </Shape>
                        <String CONTENT="201"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r2" HPOS="326" VPOS="682" WIDTH="1778" HEIGHT="363" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 682 2104 682 2104 1045 326 1045"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l3" HPOS="433" VPOS="677" WIDTH="1674" HEIGHT="72" BASELINE="435 725 2107 721" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="435 725 435 738 1261 749 1263 749 1265 749 1308 738 2079 747 2081 747 2084 747 2107 734 2107 721 2103 690 1358 677 1356 677 1354 677 1310 688 1287 677 1284 677 1282 677 1280 677 1278 677 1265 690 1243 679 1241 679 1239 679 1185 692 860 692 847 679 845 679 843 679 840 679 782 690 713 679 710 679 708 679 682 690 672 679 669 679 667 679 665 679 433 688 435 725"/>
                        </Shape>
                        <String CONTENT="The Chukchee like to try every kind of “alien food,” and even become"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l4" HPOS="323" VPOS="742" WIDTH="1778" HEIGHT="61" BASELINE="325 788 2101 781" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="323 764 325 788 325 803 2099 796 2101 781 2097 742 923 742 921 742 918 742 916 742 903 753 561 744 559 744 332 755 323 764"/>
                        </Shape>
                        <String CONTENT="accustomed to condiments, like mustard and pepper. They even offer sacrifices of"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l5" HPOS="325" VPOS="803" WIDTH="1776" HEIGHT="63" BASELINE="327 848 2101 840" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 848 327 866 2099 857 2101 840 2097 803 817 803 814 803 739 814 477 805 474 805 325 816 327 848"/>
                        </Shape>
                        <String CONTENT="sugar, bread, etc., to the spirits, supposing that they are also fond of new kinds of"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l6" HPOS="325" VPOS="863" WIDTH="1776" HEIGHT="59" BASELINE="327 905 2101 900" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 905 327 922 2099 918 2101 900 2097 872 338 863 336 863 334 863 332 863 332 866 325 870 327 905"/>
                        </Shape>
                        <String CONTENT="food. In cases of voluntary death, the self-doomed man often declares his last"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l7" HPOS="329" VPOS="935" WIDTH="1772" HEIGHT="43" BASELINE="329 963 2101 963" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 963 329 978 2101 978 2101 963 2101 935 329 935 329 963"/>
                        </Shape>
                        <String CONTENT="wish to be to taste “alien food.” In the next world, he argues, there will be"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l8" HPOS="329" VPOS="993" WIDTH="1744" HEIGHT="48" BASELINE="329 1024 2073 1024" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1024 329 1041 2073 1041 2073 1024 2073 993 329 993 329 1024"/>
                        </Shape>
                        <String CONTENT="no place for other tribes, so this will be his last chance to taste foreign foods."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r3" HPOS="326" VPOS="1045" WIDTH="1778" HEIGHT="362" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 1045 2104 1045 2104 1407 326 1407"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l9" HPOS="433" VPOS="1052" WIDTH="1668" HEIGHT="50" BASELINE="435 1084 2101 1080" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="435 1084 435 1102 2099 1097 2101 1080 2097 1052 433 1052 435 1084"/>
                        </Shape>
                        <String CONTENT="I have already mentioned the passion for tobacco among the native tribes"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l10" HPOS="325" VPOS="1099" WIDTH="1774" HEIGHT="70" BASELINE="327 1145 2099 1138" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 1145 327 1160 1068 1158 1228 1169 1230 1169 1232 1169 1256 1158 1425 1158 1505 1169 1507 1169 1614 1156 1752 1167 1754 1169 1995 1169 1995 1167 1997 1167 1999 1167 2012 1156 2066 1167 2068 1167 2071 1167 2099 1154 2099 1138 2094 1110 1507 1099 1505 1099 1421 1110 936 1102 934 1102 931 1102 929 1102 910 1112 366 1104 364 1104 362 1104 325 1115 327 1145"/>
                        </Shape>
                        <String CONTENT="of northeastern Siberia. It is stronger in the Kolyma country, possibly be-"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l11" HPOS="325" VPOS="1162" WIDTH="1776" HEIGHT="59" BASELINE="327 1206 2101 1199" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 1206 327 1221 2099 1214 2101 1199 2097 1171 918 1162 916 1162 853 1173 483 1164 481 1164 325 1175 327 1206"/>
                        </Shape>
                        <String CONTENT="cause tobacco is more difficult to get there. Among the Chukchee very few"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l12" HPOS="325" VPOS="1223" WIDTH="1776" HEIGHT="65" BASELINE="327 1266 2101 1260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 1266 327 1288 2099 1275 2101 1260 2097 1232 947 1223 944 1223 875 1234 431 1225 429 1225 325 1236 327 1266"/>
                        </Shape>
                        <String CONTENT="people are met in that region who do not use tobacco in some form. Even"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l13" HPOS="329" VPOS="1284" WIDTH="1770" HEIGHT="58" BASELINE="329 1327 2099 1327" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1327 329 1342 2099 1342 2099 1327 2099 1296 2027 1284 2025 1284 1895 1294 1343 1284 1341 1284 1261 1294 1178 1284 1176 1284 1174 1284 1172 1284 1154 1296 1040 1296 983 1284 981 1284 921 1294 860 1284 858 1284 856 1284 853 1284 834 1296 656 1296 559 1284 557 1284 503 1294 355 1284 353 1284 351 1284 329 1294 329 1327"/>
                        </Shape>
                        <String CONTENT="children three years old, who are just toddling about, are seen smoking."/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l14" HPOS="329" VPOS="1340" WIDTH="1488" HEIGHT="69" BASELINE="332 1381 1817 1385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1381 329 1396 1126 1409 1128 1409 1815 1398 1817 1385 1815 1355 1744 1342 1741 1342 1666 1353 1624 1342 1622 1342 1620 1342 1533 1353 1510 1342 1507 1342 1505 1342 1408 1353 1189 1342 1187 1342 1133 1353 1070 1340 1068 1340 1066 1340 1033 1353 849 1353 830 1340 827 1340 825 1340 823 1340 821 1340 784 1351 741 1340 739 1340 736 1340 734 1340 704 1351 691 1340 689 1340 687 1340 685 1340 682 1340 654 1351 581 1340 578 1340 576 1340 546 1351 332 1346 332 1381"/>
                        </Shape>
                        <String CONTENT="Mothers give their pipes to suckling babes to quiet their crying."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r4" HPOS="326" VPOS="1407" WIDTH="1778" HEIGHT="179" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 1407 2104 1407 2104 1586 326 1586"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l15" HPOS="440" VPOS="1409" WIDTH="1665" HEIGHT="59" BASELINE="442 1437 2105 1442" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="442 1437 440 1452 481 1465 483 1465 485 1465 1124 1457 1276 1468 1278 1468 2103 1457 2105 1442 2105 1409 442 1409 442 1437"/>
                        </Shape>
                        <String CONTENT="“The tobacco-weed knows no shame,” says a proverb of the Russianized"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l16" HPOS="332" VPOS="1468" WIDTH="1769" HEIGHT="51" BASELINE="334 1502 2101 1498" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1502 334 1519 2099 1515 2101 1498 2097 1470 332 1468 334 1502"/>
                        </Shape>
                        <String CONTENT="Yukaghir. Of the same nature is another common saying in this tribe, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l17" HPOS="327" VPOS="1519" WIDTH="1412" HEIGHT="61" BASELINE="329 1563 1739 1558" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1563 329 1580 1737 1580 1739 1558 1735 1530 1033 1519 1031 1519 1029 1519 1003 1530 386 1522 383 1522 327 1532 329 1563"/>
                        </Shape>
                        <String CONTENT="refers to their girls selling their virtue for a stem of tobacco."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r5" HPOS="326" VPOS="1586" WIDTH="1778" HEIGHT="593" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 1586 2104 1586 2104 2179 326 2179"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l18" HPOS="438" VPOS="1593" WIDTH="1667" HEIGHT="46" BASELINE="438 1621 2105 1621" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="438 1621 438 1639 2103 1639 2105 1621 2103 1593 438 1593 438 1621"/>
                        </Shape>
                        <String CONTENT="Scarcity of tobacco is felt as keenly as a food or tea famine. The same"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l19" HPOS="327" VPOS="1652" WIDTH="1778" HEIGHT="47" BASELINE="327 1682 2105 1682" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="327 1682 327 1699 2105 1699 2105 1682 2105 1652 327 1652 327 1682"/>
                        </Shape>
                        <String CONTENT="term is used to express all three ideas in local Russian and in the native"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l20" HPOS="327" VPOS="1710" WIDTH="1778" HEIGHT="50" BASELINE="329 1742 2105 1738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1742 329 1760 2103 1755 2105 1738 2101 1710 327 1710 329 1742"/>
                        </Shape>
                        <String CONTENT="languages. When tobacco gives out, the people use the black deposit which"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l21" HPOS="329" VPOS="1762" WIDTH="1776" HEIGHT="65" BASELINE="332 1805 2105 1799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1805 332 1827 2103 1814 2105 1799 2101 1768 399 1762 396 1762 329 1773 332 1805"/>
                        </Shape>
                        <String CONTENT="gathers inside of the pipe-stem. Indeed, one of the reasons for making pipes"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l22" HPOS="329" VPOS="1818" WIDTH="1776" HEIGHT="61" BASELINE="332 1864 2105 1859" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1864 332 1879 2103 1875 2105 1859 2101 1829 1239 1818 1237 1818 1235 1818 1213 1829 373 1820 370 1820 368 1820 329 1831 332 1864"/>
                        </Shape>
                        <String CONTENT="with cleft stems is for the convenience of extracting this nicotine deposit, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l23" HPOS="329" VPOS="1890" WIDTH="1774" HEIGHT="52" BASELINE="329 1924 2103 1924" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1924 329 1937 2101 1942 2103 1924 2103 1892 329 1890 329 1924"/>
                        </Shape>
                        <String CONTENT="is stored in a bag for future use. It is considered especially suited to chewing,"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l24" HPOS="327" VPOS="1939" WIDTH="1778" HEIGHT="61" BASELINE="329 1985 2105 1978" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 1985 329 2000 2103 1994 2105 1978 2101 1948 938 1939 936 1939 934 1939 908 1950 396 1942 394 1942 327 1952 329 1985"/>
                        </Shape>
                        <String CONTENT="and during prolonged hard work it drives away drowsiness and fatigue more"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l25" HPOS="329" VPOS="1998" WIDTH="1776" HEIGHT="61" BASELINE="332 2043 2105 2039" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2043 332 2059 2103 2054 2105 2039 2099 2004 1934 2009 1904 1998 1902 1998 1899 1998 1841 2009 1815 1998 1813 1998 1811 1998 1748 2009 1722 1998 1720 1998 1718 1998 1715 1998 1713 1998 1698 2011 1577 2011 1523 1998 1520 1998 1518 1998 1486 2009 1445 1998 1442 1998 1440 1998 1193 2011 1126 2000 1124 2000 1122 2000 1120 2000 1105 2013 988 2013 934 2000 931 2000 869 2011 808 2000 806 2000 804 2000 801 2000 784 2013 678 2013 591 2000 589 2000 587 2000 559 2011 537 2000 535 2000 370 2000 368 2000 366 2000 329 2013 332 2043"/>
                        </Shape>
                        <String CONTENT="effectually than genuine tobacco. More commonly they use for chewing small"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l26" HPOS="329" VPOS="2063" WIDTH="1776" HEIGHT="63" BASELINE="332 2104 2105 2098" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2104 332 2126 2103 2115 2105 2098 2101 2065 360 2063 357 2063 355 2063 329 2072 332 2104"/>
                        </Shape>
                        <String CONTENT="pieces of tobacco-leaf without any preparation. The stamens are considered"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l27" HPOS="332" VPOS="2119" WIDTH="1208" HEIGHT="59" BASELINE="332 2160 1540 2160" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2160 332 2178 1540 2178 1540 2160 1540 2128 1529 2119 1527 2119 1525 2119 1523 2119 1520 2119 1479 2130 1458 2119 1455 2119 1453 2119 1451 2119 1427 2130 1378 2119 1375 2119 1373 2119 1345 2130 1334 2119 1332 2119 1330 2119 1328 2119 1326 2119 1284 2130 1128 2119 1126 2119 1046 2130 1022 2119 1020 2119 1018 2119 1016 2119 970 2130 940 2119 938 2119 936 2119 934 2119 931 2119 931 2121 921 2132 851 2132 825 2119 823 2119 821 2119 819 2119 778 2130 715 2119 713 2119 710 2119 687 2130 663 2119 661 2119 659 2119 656 2119 654 2119 639 2130 604 2119 602 2119 600 2119 524 2130 490 2119 487 2119 485 2119 483 2119 438 2130 414 2119 412 2119 409 2119 332 2130 332 2160"/>
                        </Shape>
                        <String CONTENT="to be less desirable than the broad part of the leaf."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r6" HPOS="326" VPOS="2179" WIDTH="1778" HEIGHT="594" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 2179 2104 2179 2104 2773 326 2773"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l28" HPOS="442" VPOS="2173" WIDTH="1665" HEIGHT="63" BASELINE="444 2217 2107 2221" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="444 2217 442 2232 2103 2236 2107 2221 2105 2186 1700 2188 1646 2178 1644 2178 1642 2178 1620 2188 1596 2178 1594 2178 1592 2178 1499 2188 1451 2178 1449 2178 1447 2178 1291 2188 1276 2175 1274 2175 1271 2175 1269 2175 1144 2186 1107 2175 1105 2175 1102 2175 1100 2175 1098 2175 1085 2188 977 2188 953 2175 951 2175 949 2175 888 2186 830 2175 827 2175 825 2175 823 2175 806 2188 693 2188 669 2175 667 2175 665 2175 663 2175 661 2175 646 2188 533 2188 444 2173 444 2217"/>
                        </Shape>
                        <String CONTENT="Tobacco for smoking is cut fine with an ordinary knife on a small board"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l29" HPOS="329" VPOS="2238" WIDTH="1778" HEIGHT="59" BASELINE="332 2282 2107 2277" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2282 332 2297 2105 2292 2107 2277 2103 2249 1245 2238 1243 2238 1152 2249 370 2240 368 2240 366 2240 329 2251 332 2282"/>
                        </Shape>
                        <String CONTENT="of the same shape as a woman’s tailoring-board. Two parts of tobacco are"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l30" HPOS="332" VPOS="2301" WIDTH="1775" HEIGHT="56" BASELINE="334 2342 2107 2338" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2342 334 2357 2105 2353 2107 2338 2103 2305 351 2301 349 2301 347 2301 344 2301 332 2308 334 2342"/>
                        </Shape>
                        <String CONTENT="then mixed with one part of wood to weaken it properly. The wood used"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l31" HPOS="332" VPOS="2364" WIDTH="1775" HEIGHT="54" BASELINE="334 2403 2107 2398" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2403 334 2418 2105 2414 2107 2398 2101 2364 332 2366 334 2403"/>
                        </Shape>
                        <String CONTENT="is dry poplar or aspen bark, or pieces of young willow, which are scraped"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l32" HPOS="334" VPOS="2427" WIDTH="1771" HEIGHT="49" BASELINE="336 2459 2105 2463" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2459 334 2472 2101 2476 2105 2463 2103 2431 336 2427 336 2459"/>
                        </Shape>
                        <String CONTENT="fine and rubbed with the fingers. The Russian leaf-tobacco is too strong,"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l33" HPOS="334" VPOS="2479" WIDTH="1771" HEIGHT="62" BASELINE="334 2522 2105 2522" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2522 334 2535 2103 2541 2105 2522 2105 2492 1588 2479 1585 2479 1460 2489 1375 2479 1373 2479 1308 2489 1187 2479 1185 2479 1059 2489 1003 2479 1001 2479 999 2479 953 2489 918 2479 916 2479 914 2479 912 2479 910 2479 895 2492 806 2492 769 2479 767 2479 765 2479 646 2489 578 2479 576 2479 494 2489 464 2479 461 2479 459 2479 388 2489 362 2479 360 2479 357 2479 355 2479 334 2489 334 2522"/>
                        </Shape>
                        <String CONTENT="though a few people use it without mixture. The so-called “Turkish” tobacco,"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l34" HPOS="336" VPOS="2550" WIDTH="1771" HEIGHT="48" BASELINE="336 2580 2107 2580" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2580 336 2595 2105 2598 2107 2580 2107 2550 336 2550 336 2580"/>
                        </Shape>
                        <String CONTENT="which in reality is grown in southern Russia and in the Crimea, is used pure,"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l35" HPOS="332" VPOS="2595" WIDTH="1777" HEIGHT="61" BASELINE="334 2643 2109 2637" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2643 334 2656 2107 2650 2109 2637 2105 2606 1520 2595 1518 2595 1516 2595 1514 2595 1499 2608 332 2608 334 2643"/>
                        </Shape>
                        <String CONTENT="because it is much weaker. The same may be said of Manchurian tobacco"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l36" HPOS="332" VPOS="2660" WIDTH="1777" HEIGHT="59" BASELINE="334 2702 2109 2695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2702 334 2719 2107 2712 2109 2695 2105 2665 401 2660 399 2660 332 2671 334 2702"/>
                        </Shape>
                        <String CONTENT="and the lighter American tobaccos. All strong American tobaccos are smoked"/>
                    </TextLine>

                    <TextLine ID="mz_1-257_l37" HPOS="334" VPOS="2717" WIDTH="571" HEIGHT="58" BASELINE="336 2762 905 2758" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2762 336 2775 903 2773 905 2758 903 2728 886 2717 884 2717 882 2717 879 2717 877 2717 853 2728 732 2717 730 2717 728 2717 702 2728 552 2719 550 2719 548 2719 511 2730 375 2719 373 2719 370 2719 334 2732 336 2762"/>
                        </Shape>
                        <String CONTENT="with a mixture of wood."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-257_r7" HPOS="326" VPOS="2773" WIDTH="1778" HEIGHT="431" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="326 2773 2104 2773 2104 3204 326 3204"/>
                    </Shape>
                    <TextLine ID="mz_1-257_l38" HPOS="444" VPOS="2777" WIDTH="1665" HEIGHT="61" BASELINE="444 2821 2109 2821" TAGREFS="TYPE_4">
                        <Shape>
