                        </Shape>
                        <String CONTENT="The shirts of the Maritime people, (Plate XXIV, Fig. 1) are of the same cut"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l26" HPOS="416" VPOS="3057" WIDTH="1767" HEIGHT="45" BASELINE="416 3085 2183 3085" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 3085 416 3102 2181 3102 2183 3085 2181 3057 416 3057 416 3085"/>
                        </Shape>
                        <String CONTENT="as those of the reindeer-breeders. They often wear cast-off clothing of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l27" HPOS="414" VPOS="3104" WIDTH="1767" HEIGHT="59" BASELINE="416 3141 2181 3148" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 3141 414 3156 2177 3163 2181 3148 2179 3117 416 3104 416 3141"/>
                        </Shape>
                        <String CONTENT="Reindeer people, because the herdsman wears his coat only one winter, often"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l28" HPOS="414" VPOS="3171" WIDTH="1769" HEIGHT="52" BASELINE="416 3202 2183 3206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 3202 414 3219 2179 3223 2183 3206 2181 3176 416 3171 416 3202"/>
                        </Shape>
