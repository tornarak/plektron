                        </Shape>
                        <String CONTENT="in two pieces, an inner and an outer one, the former with the hair side in,"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l9" HPOS="426" VPOS="1091" WIDTH="1776" HEIGHT="62" BASELINE="428 1136 2202 1132" TAGREFS="TYPE_4">
