                        <Shape>
                            <Polygon POINTS="2170 1444 405 1448 407 1481 407 1506 2183 1489 2183 1474 2181 1468 2170 1444"/>
                        </Shape>
                        <String CONTENT="knees, with no hood attached, and with a rather large opening in the collar"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l16" HPOS="407" VPOS="1494" WIDTH="1774" HEIGHT="64" BASELINE="409 1543 2181 1537" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1543 409 1558 2181 1558 2181 1537 2177 1506 1819 1494 1817 1494 1815 1494 1785 1504 1754 1494 1752 1494 1750 1494 1681 1504 1620 1494 1618 1494 1616 1494 1585 1506 1549 1496 1546 1496 1544 1496 1481 1506 1265 1496 1263 1496 1135 1506 1055 1496 1053 1496 1050 1496 1048 1496 1033 1506 730 1498 728 1498 726 1498 723 1498 708 1511 565 1511 427 1498 425 1498 422 1498 420 1498 407 1504 409 1543"/>
                        </Shape>
                        <String CONTENT="(Plates XXIII, Fig. 1; XXIV, Fig. 2; also Fig. 168). Koryak shirts are longer,"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-301_r5" HPOS="409" VPOS="2505" WIDTH="1778" HEIGHT="476" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="409 2505 2187 2505 2187 2981 409 2981"/>
                    </Shape>
                    <TextLine ID="mz_1-301_l17" HPOS="409" VPOS="2511" WIDTH="1772" HEIGHT="56" BASELINE="412 2544 2181 2550" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2170 2515 412 2511 412 2544 409 2559 2177 2567 2181 2550 2179 2535 2170 2515"/>
                        </Shape>
                        <String CONTENT="and often have a hood; but among the Chukchee only the shroud has a hood,"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l18" HPOS="412" VPOS="2563" WIDTH="1773" HEIGHT="65" BASELINE="414 2604 2185 2608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="414 2604 412 2617 431 2628 433 2628 435 2628 2183 2619 2185 2608 2183 2578 2109 2565 2107 2565 1958 2576 1941 2565 1938 2565 1936 2565 1772 2565 1769 2565 1707 2576 1644 2565 1642 2565 1579 2576 1540 2565 1538 2565 1536 2565 1533 2565 1501 2576 1427 2565 1425 2565 1423 2565 1388 2576 1354 2565 1352 2565 1349 2565 1347 2565 1304 2576 1267 2563 1265 2563 1263 2563 1261 2563 1232 2574 1215 2563 1213 2563 1211 2563 1209 2563 1206 2563 1161 2574 1066 2563 1063 2563 1061 2563 1031 2574 975 2563 973 2563 970 2563 934 2576 715 2576 674 2563 672 2563 669 2563 667 2563 641 2574 596 2563 594 2563 591 2563 589 2563 561 2574 531 2563 529 2563 526 2563 414 2572 414 2604"/>
                        </Shape>
