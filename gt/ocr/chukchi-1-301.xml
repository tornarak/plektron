                    <TextLine ID="mz_1-301_l7" HPOS="513" VPOS="954" WIDTH="1670" HEIGHT="63" BASELINE="516 1002 2183 996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="516 1002 516 1017 2181 1011 2183 996 2179 967 1997 954 1995 954 1993 954 1990 954 1975 967 1609 967 1555 957 1553 957 1551 957 1549 957 1533 970 1308 970 1202 957 1200 957 1144 967 1070 957 1068 957 1066 957 1063 957 1046 970 513 970 516 1002"/>
                        </Shape>
                        <String CONTENT="Each part of the Chukchee winter garments for men or women is made"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l8" HPOS="405" VPOS="1017" WIDTH="1774" HEIGHT="63" BASELINE="407 1065 2179 1058" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1065 407 1080 2177 1080 2179 1058 2174 1028 1724 1017 1722 1017 1512 1030 405 1030 407 1065"/>
                        </Shape>
                        <String CONTENT="in two pieces, an inner and an outer one, the former with the hair side in,"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l9" HPOS="405" VPOS="1076" WIDTH="1776" HEIGHT="62" BASELINE="407 1121 2181 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1121 407 1136 2177 1138 2181 1117 2177 1086 1334 1076 1332 1076 1330 1076 1289 1086 483 1078 481 1078 405 1089 407 1121"/>
                        </Shape>
                        <String CONTENT="and the latter with the hair side out. These pieces are worn without being"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l10" HPOS="407" VPOS="1149" WIDTH="1776" HEIGHT="48" BASELINE="407 1180 2183 1180" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1154 407 1180 407 1197 2183 1197 2183 1180 2183 1149 409 1149 407 1154"/>
                        </Shape>
                        <String CONTENT="sewed together, in order that they may be separated for drying, but they fit"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l11" HPOS="405" VPOS="1197" WIDTH="1778" HEIGHT="61" BASELINE="407 1242 2183 1236" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1242 407 1258 2181 1251 2183 1236 2179 1208 1834 1197 1832 1197 405 1208 407 1242"/>
                        </Shape>
                        <String CONTENT="together so exactly as to form practically a single garment. The inner part"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l12" HPOS="409" VPOS="1253" WIDTH="1776" HEIGHT="65" BASELINE="412 1303 2185 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="412 1303 412 1318 2183 1309 2185 1294 2181 1266 2129 1253 2127 1253 2125 1253 2101 1264 1936 1253 1934 1253 1830 1264 1776 1253 1774 1253 1772 1253 1737 1266 1702 1255 1700 1255 1698 1255 1696 1255 1668 1266 1590 1255 1588 1255 1471 1266 1399 1255 1397 1255 1278 1268 1241 1258 1239 1258 1237 1258 409 1266 412 1303"/>
                        </Shape>
                        <String CONTENT="is usually made of very soft-haired material, so that it will not irritate the"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l13" HPOS="407" VPOS="1320" WIDTH="1534" HEIGHT="59" BASELINE="409 1361 1941 1355" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1361 409 1379 1938 1372 1941 1355 1936 1327 438 1320 435 1320 433 1320 407 1329 409 1361"/>
                        </Shape>
                        <String CONTENT="skin, and can be worn without underclothing even by a European."/>
                    </TextLine>
