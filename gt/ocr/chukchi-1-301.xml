                    </TextLine>

                    <TextLine ID="mz_1-301_l19" HPOS="414" VPOS="2621" WIDTH="1771" HEIGHT="68" BASELINE="416 2665 2185 2669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 2665 414 2680 427 2689 429 2689 431 2689 433 2689 2183 2680 2185 2669 2185 2637 2151 2624 2148 2624 2146 2624 2144 2624 2120 2634 2079 2624 2077 2624 2075 2624 1949 2634 1921 2624 1919 2624 1917 2624 1915 2624 1912 2624 1902 2634 1889 2624 1886 2624 1884 2624 1791 2624 1789 2624 1733 2634 1711 2624 1709 2624 1707 2624 1705 2624 1683 2634 1659 2624 1657 2624 1655 2624 1570 2634 1529 2624 1527 2624 1525 2624 1429 2634 1367 2624 1365 2624 1362 2624 1330 2634 1302 2621 1300 2621 1297 2621 1295 2621 1258 2634 1096 2634 1079 2621 1076 2621 1074 2621 1072 2621 999 2632 936 2621 934 2621 931 2621 905 2632 860 2621 858 2621 856 2621 799 2632 691 2621 689 2621 687 2621 663 2632 589 2621 587 2621 585 2621 565 2632 544 2621 542 2621 539 2621 416 2630 416 2665"/>
                        </Shape>
                        <String CONTENT="called by them “the hooded garment.” The collar of the Chukchee shirt is"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l20" HPOS="414" VPOS="2686" WIDTH="1767" HEIGHT="63" BASELINE="416 2723 2181 2728" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 2723 414 2738 2177 2749 2181 2728 2179 2697 416 2686 416 2723"/>
                        </Shape>
                        <String CONTENT="bound with a narrow piece of skin folded over so that a stout sinew string"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l21" HPOS="414" VPOS="2754" WIDTH="1769" HEIGHT="56" BASELINE="416 2784 2183 2788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 2784 414 2797 470 2810 472 2810 2181 2801 2183 2788 2181 2758 416 2754 416 2784"/>
                        </Shape>
                        <String CONTENT="may be pulled through to tighten the collar as much as desired. The ends"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l22" HPOS="414" VPOS="2812" WIDTH="1769" HEIGHT="56" BASELINE="416 2842 2183 2849" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 2842 414 2860 427 2868 429 2868 431 2868 433 2868 2181 2866 2183 2849 2181 2818 416 2812 416 2842"/>
                        </Shape>
