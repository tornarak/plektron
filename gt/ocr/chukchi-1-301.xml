                        <Shape>
                            <Polygon POINTS="418 2901 416 2918 2181 2922 2185 2907 2183 2877 418 2864 418 2901"/>
                        </Shape>
                        <String CONTENT="is added to strengthen the neck of the shirt in case of a scuffle; otherwise"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l24" HPOS="414" VPOS="2929" WIDTH="1132" HEIGHT="58" BASELINE="416 2961 1546 2970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="416 2961 414 2979 420 2985 420 2987 422 2987 425 2987 427 2987 1544 2985 1546 2970 1544 2938 416 2929 416 2961"/>
                        </Shape>
                        <String CONTENT="it would give way when pulled hard in wrestling."/>
                    </TextLine>
