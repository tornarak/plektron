                        </Shape>
                        <String CONTENT="is usually made of very soft-haired material, so that it will not irritate the"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l13" HPOS="428" VPOS="1335" WIDTH="1534" HEIGHT="59" BASELINE="430 1376 1962 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="430 1376 430 1394 1959 1387 1962 1370 1957 1342 459 1335 456 1335 454 1335 428 1344 430 1376"/>
                        </Shape>
