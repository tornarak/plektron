                <TextBlock ID="mz_1-301_r6" HPOS="409" VPOS="2981" WIDTH="1778" HEIGHT="260" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="409 2981 2187 2981 2187 3241 409 3241"/>
                    </Shape>
                    <TextLine ID="mz_1-301_l25" HPOS="522" VPOS="2985" WIDTH="1663" HEIGHT="59" BASELINE="524 3022 2185 3028" TAGREFS="TYPE_4">
                        <Shape>
