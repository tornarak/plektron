                        </Shape>
                        <String CONTENT="Each part of the Chukchee winter garments for men or women is made"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l8" HPOS="426" VPOS="1032" WIDTH="1774" HEIGHT="63" BASELINE="428 1080 2200 1073" TAGREFS="TYPE_4">
