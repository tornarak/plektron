                        </Shape>
                        <String CONTENT="and the latter with the hair side out. These pieces are worn without being"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l10" HPOS="428" VPOS="1164" WIDTH="1776" HEIGHT="48" BASELINE="428 1195 2204 1195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="428 1169 428 1195 428 1212 2204 1212 2204 1195 2204 1164 430 1164 428 1169"/>
                        </Shape>
                        <String CONTENT="sewed together, in order that they may be separated for drying, but they fit"/>
                    </TextLine>

                    <TextLine ID="mz_1-301_l11" HPOS="426" VPOS="1212" WIDTH="1778" HEIGHT="61" BASELINE="428 1257 2204 1251" TAGREFS="TYPE_4">
                        <Shape>
