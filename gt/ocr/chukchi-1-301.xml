                    <TextLine ID="mz_1-301_l24" HPOS="435" VPOS="2944" WIDTH="1132" HEIGHT="58" BASELINE="437 2976 1567 2985" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="437 2976 435 2994 441 3000 441 3002 443 3002 446 3002 448 3002 1565 3000 1567 2985 1565 2953 437 2944 437 2976"/>
