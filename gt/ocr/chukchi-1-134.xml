                    <TextLine ID="mz_1-134_l18" HPOS="708" VPOS="1634" WIDTH="1769" HEIGHT="56" BASELINE="708 1673 2477 1673" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="708 1673 708 1690 2477 1690 2477 1673 2475 1634 708 1634 708 1673"/>
                        </Shape>
                        <String CONTENT="The Kolyma Russians often cook for their dogs a kind of porridge made of"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l19" HPOS="706" VPOS="1699" WIDTH="1767" HEIGHT="56" BASELINE="706 1732 2473 1736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 1732 706 1755 2471 1755 2473 1736 2471 1703 706 1699 706 1732"/>
                        </Shape>
                        <String CONTENT="putrid fish, roe, fish-bones, refuse of human food, etc., and serve it in long"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l20" HPOS="703" VPOS="1757" WIDTH="1772" HEIGHT="61" BASELINE="706 1788 2475 1792" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 1788 703 1803 853 1816 855 1816 1548 1807 1628 1818 1630 1818 2473 1807 2475 1792 2473 1762 706 1757 706 1788"/>
                        </Shape>
