                    <TextLine ID="mz_1-134_l9" HPOS="701" VPOS="1099" WIDTH="1772" HEIGHT="59" BASELINE="703 1132 2473 1136" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 1132 701 1147 716 1158 718 1158 721 1158 723 1158 2471 1153 2473 1136 2471 1104 703 1099 703 1132"/>
                        </Shape>
