                    <TextLine ID="mz_1-134_l16" HPOS="812" VPOS="1515" WIDTH="1663" HEIGHT="56" BASELINE="814 1552 2475 1556" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="814 1552 812 1565 2471 1571 2475 1556 2473 1524 814 1515 814 1552"/>
                        </Shape>
