                    <TextLine ID="mz_1-134_l13" HPOS="701" VPOS="1342" WIDTH="1776" HEIGHT="50" BASELINE="703 1376 2477 1372" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 1376 703 1392 2475 1387 2477 1372 2473 1342 701 1342 703 1376"/>
                        </Shape>
