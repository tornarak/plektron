                    <TextLine ID="mz_1-134_l7" HPOS="812" VPOS="980" WIDTH="1667" HEIGHT="52" BASELINE="812 1013 2479 1013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="812 1013 812 1032 2477 1032 2479 1013 2477 982 812 980 812 1013"/>
                        </Shape>
                        <String CONTENT="Dogs of the southern and western districts are considered the swiftest and"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l8" HPOS="701" VPOS="1041" WIDTH="1770" HEIGHT="56" BASELINE="703 1073 2471 1078" TAGREFS="TYPE_5">
