                        </Shape>
                        <String CONTENT="chadal, at the same season, when food is scattered on the ground, the dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l31" HPOS="703" VPOS="2409" WIDTH="916" HEIGHT="67" BASELINE="706 2452 1619 2448" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2452 706 2472 1193 2476 1195 2476 1197 2476 1199 2476 1199 2474 1210 2465 1321 2465 1455 2476 1457 2476 1459 2476 1487 2465 1593 2476 1596 2476 1598 2476 1600 2476 1619 2463 1619 2448 1613 2409 703 2422 706 2452"/>
                        </Shape>
                        <String CONTENT="grow so fat that they can hardly walk.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-134_r5" HPOS="702" VPOS="2468" WIDTH="1778" HEIGHT="726" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="702 2468 2480 2468 2480 3194 702 3194"/>
                    </Shape>
                    <TextLine ID="mz_1-134_l32" HPOS="812" VPOS="2474" WIDTH="1665" HEIGHT="54" BASELINE="814 2507 2477 2513" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="814 2507 812 2522 2473 2528 2477 2513 2475 2483 814 2474 814 2507"/>
                        </Shape>
                        <String CONTENT="The continuous fluctuations of success in seal-hunting, and the frequent"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l33" HPOS="703" VPOS="2543" WIDTH="1772" HEIGHT="50" BASELINE="703 2572 2475 2572" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2572 703 2589 2473 2593 2475 2572 2475 2543 703 2543 703 2572"/>
                        </Shape>
                        <String CONTENT="seasons of famine, have a deteriorating effect upon the Chukchee race of dogs;"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l34" HPOS="703" VPOS="2598" WIDTH="1774" HEIGHT="51" BASELINE="703 2630 2477 2630" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2630 703 2649 2477 2649 2477 2630 2477 2602 703 2598 703 2630"/>
                        </Shape>
                        <String CONTENT="but fishing among the more southern tribes is much more regular. Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l35" HPOS="703" VPOS="2658" WIDTH="1774" HEIGHT="50" BASELINE="706 2688 2477 2693" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2688 703 2704 2473 2708 2477 2693 2475 2662 706 2658 706 2688"/>
                        </Shape>
                        <String CONTENT="dogs need something to season their blubber, and are generally inclined to"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l36" HPOS="701" VPOS="2714" WIDTH="1780" HEIGHT="65" BASELINE="703 2749 2481 2753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2749 701 2762 833 2777 835 2777 838 2777 879 2766 1123 2777 1126 2777 1347 2766 1435 2777 1437 2777 1440 2777 1468 2766 1593 2779 1596 2779 1676 2769 1741 2779 1743 2779 1745 2779 1788 2769 1923 2779 1925 2779 2479 2766 2481 2753 2479 2714 703 2717 703 2749"/>
                        </Shape>
                        <String CONTENT="eat up all the dry thongs they can get; they even gnaw at the lashings of"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l37" HPOS="706" VPOS="2784" WIDTH="1771" HEIGHT="45" BASELINE="706 2812 2477 2812" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2812 706 2829 2477 2829 2477 2812 2477 2784 706 2784 706 2812"/>
                        </Shape>
