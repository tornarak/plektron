                        <Shape>
                            <Polygon POINTS="703 1974 703 1991 2475 1987 2477 1970 2473 1942 1589 1931 1587 1931 1526 1942 738 1933 736 1933 734 1933 701 1944 703 1974"/>
                        </Shape>
                        <String CONTENT="of meat is small, and consists only of kitchen refuse, since their masters want"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l24" HPOS="701" VPOS="1989" WIDTH="1774" HEIGHT="67" BASELINE="703 2035 2475 2028" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2035 703 2050 1881 2056 1884 2056 2473 2043 2475 2028 2471 2000 1884 1989 1881 1989 1879 1989 1855 2000 1295 1991 1292 1991 1290 1991 1262 2002 729 1993 727 1993 725 1993 701 2002 703 2035"/>
                        </Shape>
                        <String CONTENT="all the meat proper for themselves. However, exclusive blubber diet is insuf-"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l25" HPOS="701" VPOS="2048" WIDTH="1776" HEIGHT="62" BASELINE="703 2095 2477 2089" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2095 703 2110 2475 2104 2477 2089 2475 2061 2440 2048 2438 2048 2436 2048 2434 2048 2388 2058 2260 2048 2258 2048 2256 2048 2237 2058 2221 2048 2219 2048 2217 2048 2215 2048 2213 2048 2211 2048 2195 2061 2074 2061 2022 2048 2020 2048 1918 2058 1897 2048 1894 2048 1892 2048 1890 2048 1888 2048 1875 2061 1855 2050 1853 2050 1851 2050 1849 2050 1827 2061 1801 2050 1799 2050 1797 2050 1630 2061 1600 2050 1598 2050 1596 2050 1533 2061 1476 2050 1474 2050 1472 2050 1470 2050 1453 2063 1286 2063 1223 2052 1221 2052 1054 2063 961 2052 959 2052 957 2052 931 2063 868 2052 866 2052 864 2052 861 2052 851 2063 838 2052 835 2052 833 2052 714 2052 712 2052 710 2052 708 2052 708 2054 701 2058 703 2095"/>
                        </Shape>
                        <String CONTENT="ficient for dogs. In the summer-time, in the Chukchee villages of the Pacific"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l26" HPOS="701" VPOS="2113" WIDTH="1774" HEIGHT="58" BASELINE="703 2154 2475 2149" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2154 703 2171 2473 2167 2475 2149 2471 2121 812 2113 809 2113 701 2123 703 2154"/>
                        </Shape>
                        <String CONTENT="coast, I saw large pieces of blubber strewn all over the ground; and the dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l27" HPOS="701" VPOS="2169" WIDTH="1774" HEIGHT="67" BASELINE="703 2216 2475 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 2216 703 2236 2473 2234 2475 2210 2471 2182 2291 2169 2289 2169 2286 2169 2284 2169 2267 2182 2165 2182 2139 2169 2137 2169 2135 2169 2020 2180 1962 2169 1959 2169 1907 2180 1886 2169 1884 2169 1881 2169 1808 2182 1661 2171 1658 2171 1656 2171 1654 2171 1637 2184 1316 2184 1297 2171 1295 2171 1292 2171 1290 2171 1221 2184 788 2173 786 2173 701 2186 703 2216"/>
                        </Shape>
                        <String CONTENT="prowling among them did not appear to be overfed. The natives said, that,"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l28" HPOS="706" VPOS="2242" WIDTH="1771" HEIGHT="48" BASELINE="706 2273 2477 2273" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2273 706 2290 2477 2290 2477 2273 2477 2242 706 2242 706 2273"/>
                        </Shape>
                        <String CONTENT="whenever the dogs were satiated, they would desist from eating blubber for"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l29" HPOS="703" VPOS="2288" WIDTH="1772" HEIGHT="63" BASELINE="706 2336 2475 2329" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2336 706 2351 2473 2344 2475 2329 2471 2301 2384 2288 2382 2288 2330 2299 1979 2288 1977 2288 1879 2301 1611 2290 1609 2290 1606 2290 1576 2301 1524 2290 1522 2290 1520 2290 1485 2301 1448 2290 1446 2290 1444 2290 1442 2290 1440 2290 1422 2301 1312 2292 1310 2292 1234 2303 1169 2292 1167 2292 983 2303 894 2292 892 2292 890 2292 866 2303 762 2292 760 2292 757 2292 703 2305 706 2336"/>
                        </Shape>
                        <String CONTENT="a long time. On the contrary, in the fishing villages of the Koryak or Kam-"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l30" HPOS="703" VPOS="2357" WIDTH="1774" HEIGHT="59" BASELINE="706 2387 2477 2394" TAGREFS="TYPE_5">
                        <Shape>
