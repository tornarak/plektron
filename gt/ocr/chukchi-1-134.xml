                    </TextLine>

                    <TextLine ID="mz_1-134_l21" HPOS="701" VPOS="1807" WIDTH="1774" HEIGHT="63" BASELINE="703 1853 2475 1848" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="703 1853 703 1870 2473 1866 2475 1848 2468 1816 2219 1818 2202 1807 2200 1807 2198 1807 2195 1807 2107 1818 2092 1807 2089 1807 2087 1807 2085 1807 2083 1807 2059 1818 2042 1807 2040 1807 2037 1807 2035 1807 2033 1807 2005 1818 1959 1807 1957 1807 1955 1807 1899 1818 1840 1807 1838 1807 1784 1818 1762 1807 1760 1807 1758 1807 1756 1807 1713 1818 1617 1807 1615 1807 1613 1807 1611 1807 1596 1818 1485 1809 1483 1809 1481 1809 1479 1809 1463 1822 1279 1822 1214 1809 1212 1809 1158 1820 937 1809 935 1809 859 1820 820 1809 818 1809 816 1809 814 1809 777 1820 727 1809 725 1809 723 1809 721 1809 701 1818 703 1853"/>
                        </Shape>
                        <String CONTENT="the dogs feel heavy with too much liquid food. The Chukchee dogs are fed"/>
                    </TextLine>

