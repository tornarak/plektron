                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l2" HPOS="2189" VPOS="627" WIDTH="56" HEIGHT="67" BASELINE="2191 666 2245 673" TAGREFS="TYPE_4">
