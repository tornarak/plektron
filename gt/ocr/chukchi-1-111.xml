        <Page WIDTH="2781" HEIGHT="3866" PHYSICAL_IMG_NR="0" ID="page_0">
            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-111" HPOS="455" VPOS="608" WIDTH="1789" HEIGHT="2626"><TextLine ID="mz_1-111_l1" HPOS="1044" VPOS="608" WIDTH="617" HEIGHT="61" BASELINE="1044 649 1661 647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1648 617 1642 612 1083 608 1063 615 1046 638 1044 649 1044 669 1659 666 1661 647 1659 640 1648 617"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l2" HPOS="2168" VPOS="612" WIDTH="56" HEIGHT="67" BASELINE="2170 651 2224 658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2216 619 2205 615 2172 612 2170 651 2168 666 2218 679 2224 658 2224 619 2216 619"/>
                        </Shape>
                        <String CONTENT="83"/>
                    </TextLine>
<TextLine ID="mz_1-111_l3" HPOS="459" VPOS="716" WIDTH="1778" HEIGHT="67" BASELINE="461 764 2237 757" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="676 721 654 723 633 723 611 723 589 725 568 725 546 725 524 725 503 727 500 727 459 729 461 764 461 783 2235 773 2237 757 2233 725 1053 716 1050 716 992 727 693 721 676 721"/>
                        </Shape>
                        <String CONTENT="poor families usually combine for the summer and form a large herd with plenty"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l4" HPOS="461" VPOS="777" WIDTH="1776" HEIGHT="61" BASELINE="464 822 2237 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 822 464 838 2235 831 2237 816 2233 786 1055 777 1053 777 1050 777 1020 788 503 779 500 779 498 779 461 790 464 822"/>
                        </Shape>
                        <String CONTENT="of herdsmen. Early in the fall the herds are separated; and in winter some"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l5" HPOS="464" VPOS="835" WIDTH="1773" HEIGHT="61" BASELINE="466 881 2237 876" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 881 466 896 2235 892 2237 876 2233 846 1352 835 1349 835 1287 846 505 838 503 838 500 838 464 848 466 881"/>
                        </Shape>
                        <String CONTENT="of the poor men will join their wealthy neighbors and help them watch the"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l6" HPOS="466" VPOS="898" WIDTH="1767" HEIGHT="59" BASELINE="466 941 2233 941" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 941 466 957 2231 957 2233 941 2231 911 2144 898 2032 898 2029 898 2027 898 2025 898 2012 909 1951 898 1949 898 1947 898 1917 909 1884 898 1882 898 1880 898 1735 911 1581 911 1564 898 1562 898 1559 898 1557 898 1475 909 1386 898 1384 898 1323 909 466 905 466 941"/>
                        </Shape>
                        <String CONTENT="herd, receiving for their pay some skins, and some animals for slaughter."/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l7" HPOS="466" VPOS="965" WIDTH="1769" HEIGHT="52" BASELINE="466 1000 2235 1000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 1000 466 1015 2233 1017 2235 1000 2235 970 466 965 466 1000"/>
                        </Shape>
                        <String CONTENT="Such temporary helpers generally leave in spring, before the calving-season,"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l8" HPOS="461" VPOS="1019" WIDTH="1772" HEIGHT="61" BASELINE="464 1061 2233 1056" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 1061 464 1076 2229 1080 2233 1056 2229 1028 487 1019 485 1019 483 1019 461 1028 464 1061"/>
                        </Shape>
                        <String CONTENT="since at that time a large herd gives much trouble. It must be kept moving"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l9" HPOS="461" VPOS="1084" WIDTH="1774" HEIGHT="50" BASELINE="464 1121 2235 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 1121 464 1134 2233 1132 2235 1117 2229 1084 461 1086 464 1121"/>
                        </Shape>
                        <String CONTENT="in search of new pastures. Does with young ones are very slow. In a herd"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l10" HPOS="464" VPOS="1149" WIDTH="1773" HEIGHT="46" BASELINE="464 1177 2237 1177" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 1177 464 1195 2237 1195 2237 1177 2237 1149 464 1149 464 1177"/>
                        </Shape>
                        <String CONTENT="of a thousand does there are some thirty calvings daily. The herdsman has"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l11" HPOS="464" VPOS="1199" WIDTH="1773" HEIGHT="56" BASELINE="466 1240 2237 1236" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 1240 466 1255 2235 1251 2237 1236 2233 1208 481 1199 479 1199 477 1199 474 1199 464 1206 466 1240"/>
                        </Shape>
                        <String CONTENT="to keep his eye on every one of these. He leaves them behind, then comes"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l12" HPOS="461" VPOS="1255" WIDTH="1280" HEIGHT="61" BASELINE="464 1301 1741 1296" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 1301 464 1316 1739 1312 1741 1296 1737 1268 1637 1255 1635 1255 1633 1255 1609 1266 1588 1255 1585 1255 1583 1255 1581 1255 1579 1255 1579 1258 1568 1268 1499 1268 1466 1255 1464 1255 1462 1255 1460 1255 1458 1255 1442 1268 1347 1268 1310 1255 1308 1255 1306 1255 1304 1255 1261 1266 1232 1255 1230 1255 1228 1255 1226 1255 1191 1266 1122 1255 1120 1255 1118 1255 1083 1271 923 1271 912 1260 912 1258 910 1258 908 1258 905 1258 903 1258 877 1268 717 1258 715 1258 713 1258 676 1268 624 1258 622 1258 461 1266 464 1301"/>
                        </Shape>
                        <String CONTENT="back for them, and even assists the inexperienced dam."/>
                    </TextLine>
<TextLine ID="mz_1-111_l13" HPOS="568" VPOS="1314" WIDTH="1669" HEIGHT="63" BASELINE="570 1361 2237 1355" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 1361 570 1377 2235 1370 2237 1355 2235 1327 2205 1314 2203 1314 2200 1314 2198 1314 2177 1325 2155 1314 2153 1314 2151 1314 2148 1314 2122 1325 2021 1314 2019 1314 1967 1325 1938 1314 1936 1314 1934 1314 1839 1325 1808 1314 1806 1314 1804 1314 1676 1329 1516 1329 1501 1316 1499 1316 1497 1316 1494 1316 1492 1316 1460 1327 1345 1316 1343 1316 1341 1316 1304 1327 1261 1316 1258 1316 1256 1316 1081 1329 990 1318 988 1318 568 1325 570 1361"/>
                        </Shape>
                        <String CONTENT="Many poor families, especially those who want to raise a herd of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l14" HPOS="461" VPOS="1390" WIDTH="1774" HEIGHT="45" BASELINE="461 1420 2235 1420" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1420 461 1435 2235 1435 2235 1420 2235 1390 461 1390 461 1420"/>
                        </Shape>
                        <String CONTENT="own, enter the service of one of their wealthy neighbors for several years."/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l15" HPOS="464" VPOS="1444" WIDTH="1771" HEIGHT="52" BASELINE="466 1478 2235 1474" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 1478 466 1496 2233 1491 2235 1474 2231 1446 464 1444 466 1478"/>
                        </Shape>
                        <String CONTENT="They are very hard-worked, and receive as pay their meat-supply and skins"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l16" HPOS="459" VPOS="1500" WIDTH="1776" HEIGHT="56" BASELINE="461 1541 2235 1535" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1541 461 1556 2233 1552 2235 1535 2231 1506 472 1500 470 1500 468 1500 466 1500 466 1502 459 1506 461 1541"/>
                        </Shape>
                        <String CONTENT="from the herd of their master; but in moving from camp to camp they must"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l17" HPOS="461" VPOS="1554" WIDTH="1774" HEIGHT="61" BASELINE="464 1600 2235 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 1600 464 1615 2233 1610 2235 1595 2231 1565 1349 1554 1347 1554 1345 1554 1317 1565 578 1556 576 1556 461 1567 464 1600"/>
                        </Shape>
                        <String CONTENT="use their own pack and driving animals. Meanwhile their own little stock is"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l18" HPOS="459" VPOS="1626" WIDTH="1774" HEIGHT="49" BASELINE="461 1658 2233 1654" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1658 461 1675 2231 1671 2233 1654 2229 1626 459 1626 461 1658"/>
                        </Shape>
                        <String CONTENT="left undisturbed to multiply. In return for good services, they may expect to"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l19" HPOS="461" VPOS="1684" WIDTH="1774" HEIGHT="52" BASELINE="461 1719 2235 1719" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1719 461 1736 2235 1736 2235 1719 2233 1684 461 1686 461 1719"/>
                        </Shape>
                        <String CONTENT="receive from their master every year about ten fawns; and with the natural"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l20" HPOS="459" VPOS="1747" WIDTH="1774" HEIGHT="47" BASELINE="461 1779 2233 1775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1779 461 1794 2231 1792 2233 1775 2229 1747 459 1747 461 1779"/>
                        </Shape>
                        <String CONTENT="increase of their own animals they may secure one hundred reindeer in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l21" HPOS="459" VPOS="1792" WIDTH="1770" HEIGHT="65" BASELINE="461 1840 2229 1833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1840 461 1857 2226 1851 2229 1833 2222 1797 2025 1803 1980 1792 1977 1792 1975 1792 1973 1792 1934 1803 1910 1792 1908 1792 1906 1792 1856 1803 1832 1792 1830 1792 1828 1792 1826 1792 1824 1792 1811 1803 1772 1792 1769 1792 1767 1792 1765 1792 1741 1805 1544 1805 1512 1794 1510 1794 1507 1794 1505 1794 1484 1805 1462 1794 1460 1794 1458 1794 1455 1794 1434 1805 1412 1794 1410 1794 1408 1794 1406 1794 1375 1805 1339 1794 1336 1794 1334 1794 1332 1794 1330 1794 1315 1807 1133 1807 1068 1794 1066 1794 1063 1794 1025 1807 942 1797 940 1797 938 1797 912 1807 808 1797 806 1797 804 1797 773 1807 661 1797 659 1797 656 1797 630 1810 459 1810 461 1840"/>
                        </Shape>
                        <String CONTENT="course of five fairly favorable years. Such helpers are called “dwelling-mates”"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l22" HPOS="459" VPOS="1857" WIDTH="1776" HEIGHT="59" BASELINE="461 1901 2235 1896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1901 461 1916 2233 1911 2235 1896 2231 1864 477 1857 474 1857 472 1857 470 1857 459 1864 461 1901"/>
                        </Shape>
                        <String CONTENT="(nɪm-tuˊmg̣ɪt); and the owners of every large flock, when short of hands, will"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l23" HPOS="459" VPOS="1929" WIDTH="1776" HEIGHT="45" BASELINE="459 1959 2235 1959" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 1959 459 1974 2235 1974 2235 1959 2235 1929 459 1929 459 1959"/>
                        </Shape>
                        <String CONTENT="strive in every way to attract at least one poor family. Often these are poor"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l24" HPOS="457" VPOS="1974" WIDTH="1778" HEIGHT="61" BASELINE="459 2020 2235 2015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2020 459 2035 2233 2030 2235 2015 2231 1987 2122 1987 2105 1974 2103 1974 2101 1974 2099 1974 2097 1974 2075 1985 2047 1974 2045 1974 2042 1974 2040 1974 2038 1974 2023 1987 1510 1987 1347 1974 1345 1974 1343 1974 1341 1974 1319 1987 1278 1976 1276 1976 1274 1976 1271 1976 1228 1987 1198 1976 1196 1976 1193 1976 1191 1976 1159 1987 1050 1976 1048 1976 1046 1976 1020 1989 832 1989 773 1976 771 1976 769 1976 767 1976 754 1987 715 1976 713 1976 710 1976 652 1987 507 1976 505 1976 503 1976 457 1989 459 2020"/>
                        </Shape>
                        <String CONTENT="relatives of the owner of the herd. If there are any young unmarried men"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l25" HPOS="459" VPOS="2048" WIDTH="1785" HEIGHT="47" BASELINE="459 2078 2244 2078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2078 459 2095 2244 2095 2244 2078 2244 2048 459 2048 459 2078"/>
                        </Shape>
                        <String CONTENT="in these families, they will be offered a girl of the master’s family in marriage,"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l26" HPOS="457" VPOS="2098" WIDTH="773" HEIGHT="58" BASELINE="459 2141 1230 2137" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2141 459 2156 1228 2152 1230 2137 1226 2106 529 2098 526 2098 457 2108 459 2141"/>
                        </Shape>
                        <String CONTENT="and thus become relatives of his."/>
                    </TextLine>
<TextLine ID="mz_1-111_l27" HPOS="572" VPOS="2160" WIDTH="1663" HEIGHT="54" BASELINE="574 2197 2235 2193" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2197 574 2214 2233 2210 2235 2193 2231 2165 572 2160 574 2197"/>
                        </Shape>
                        <String CONTENT="With the beginning of summer, when sledges become useless and tents"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l28" HPOS="457" VPOS="2217" WIDTH="1778" HEIGHT="58" BASELINE="459 2260 2235 2253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2260 459 2275 2233 2269 2235 2253 2231 2225 1050 2217 1048 2217 931 2227 503 2219 500 2219 498 2219 457 2230 459 2260"/>
                        </Shape>
                        <String CONTENT="cannot be moved around the country, the Chukchee herdsmen usually leave"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l29" HPOS="457" VPOS="2277" WIDTH="1776" HEIGHT="59" BASELINE="459 2321 2233 2316" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2321 459 2336 2231 2331 2233 2316 2229 2286 479 2277 477 2277 474 2277 472 2277 457 2284 459 2321"/>
                        </Shape>
                        <String CONTENT="their families in camp, and move with the herd about twenty miles away, to"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l30" HPOS="459" VPOS="2349" WIDTH="1774" HEIGHT="49" BASELINE="459 2377 2233 2377" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2377 459 2392 2231 2398 2233 2377 2233 2349 459 2349 459 2377"/>
                        </Shape>
                        <String CONTENT="the summer pastures. Boys and girls of more than ten years, and young"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l31" HPOS="459" VPOS="2407" WIDTH="1772" HEIGHT="52" BASELINE="459 2437 2231 2437" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2437 459 2453 2229 2459 2231 2437 2231 2407 459 2407 459 2437"/>
                        </Shape>
                        <String CONTENT="women having no small children, usually go along for a time. While moving"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l32" HPOS="457" VPOS="2463" WIDTH="1772" HEIGHT="55" BASELINE="459 2494 2229 2498" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2494 457 2509 2224 2518 2229 2498 2226 2468 459 2463 459 2494"/>
                        </Shape>
                        <String CONTENT="about with the herd, the herdsmen have to carry on their backs all necessaries,"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l33" HPOS="457" VPOS="2513" WIDTH="1776" HEIGHT="61" BASELINE="459 2559 2233 2554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2559 459 2574 2231 2570 2233 2554 2229 2526 2168 2513 2166 2513 2107 2524 1932 2513 1930 2513 1819 2524 1793 2513 1791 2513 1789 2513 1670 2524 1653 2513 1650 2513 1648 2513 1546 2513 1544 2513 1542 2513 1505 2524 1414 2513 1412 2513 1319 2526 840 2515 838 2515 836 2515 834 2515 819 2528 568 2528 535 2515 533 2515 531 2515 457 2528 459 2559"/>
                        </Shape>
                        <String CONTENT="such as extra clothing, rifle and ammunition, kettles, and provisions. After"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l34" HPOS="459" VPOS="2587" WIDTH="1776" HEIGHT="45" BASELINE="459 2617 2235 2617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2617 459 2632 2235 2632 2235 2617 2235 2587 459 2587 459 2617"/>
                        </Shape>
                        <String CONTENT="they have killed a reindeer, they must carry its skin and meat until it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l35" HPOS="459" VPOS="2647" WIDTH="1774" HEIGHT="46" BASELINE="459 2678 2233 2678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2678 459 2693 2233 2693 2233 2678 2233 2647 459 2647 459 2678"/>
                        </Shape>
                        <String CONTENT="consumed. For this reason the herdsmen are so averse to slaughtering an"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l36" HPOS="457" VPOS="2708" WIDTH="1776" HEIGHT="46" BASELINE="457 2738 2233 2738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 2738 457 2754 2233 2754 2233 2738 2233 2708 457 2708 457 2738"/>
                        </Shape>
                        <String CONTENT="animal at that season, that they sometimes go for several days on starvation"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l37" HPOS="455" VPOS="2756" WIDTH="1778" HEIGHT="56" BASELINE="457 2797 2233 2793" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 2797 457 2812 2231 2810 2233 2793 2229 2764 520 2756 518 2756 455 2767 457 2797"/>
                        </Shape>
                        <String CONTENT="rations. If the hoof-disease breaks out, they have plenty of meat, but they"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l38" HPOS="457" VPOS="2812" WIDTH="1774" HEIGHT="63" BASELINE="459 2857 2231 2851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2857 459 2875 2229 2870 2231 2851 2226 2823 1687 2812 1685 2812 1683 2812 1635 2825 457 2825 459 2857"/>
                        </Shape>
                        <String CONTENT="have to carry along additional loads of skins. Sometimes they are so heavily"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l39" HPOS="457" VPOS="2881" WIDTH="1776" HEIGHT="61" BASELINE="459 2918 2233 2914" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2918 459 2931 973 2942 975 2942 977 2942 979 2942 994 2931 2231 2931 2233 2914 2229 2883 457 2881 459 2918"/>
                        </Shape>
                        <String CONTENT="laden as to be hardly able to move. The burdens are carried by girls and"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l40" HPOS="457" VPOS="2942" WIDTH="1774" HEIGHT="52" BASELINE="459 2977 2231 2972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 2977 459 2994 2229 2990 2231 2972 2226 2944 457 2942 459 2977"/>
                        </Shape>
                        <String CONTENT="by men who are not very agile; while the best herdsmen must remain unen-"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l41" HPOS="457" VPOS="2994" WIDTH="1057" HEIGHT="60" BASELINE="459 3035 1514 3033" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="459 3035 459 3054 1512 3054 1514 3033 1510 3005 548 2994 546 2994 457 3005 459 3035"/>
                        </Shape>
                        <String CONTENT="cumbered for moving swiftly around the herd."/>
                    </TextLine>
<TextLine ID="mz_1-111_l42" HPOS="568" VPOS="3059" WIDTH="1665" HEIGHT="54" BASELINE="568 3093 2233 3093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="568 3093 568 3113 2233 3113 2233 3093 2233 3065 568 3059 568 3093"/>
                        </Shape>
                        <String CONTENT="The time of the first sprouting of weeds, and the mushroom season in"/>
                    </TextLine>

                    <TextLine ID="mz_1-111_l43" HPOS="455" VPOS="3115" WIDTH="1774" HEIGHT="59" BASELINE="457 3156 2229 3150" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 3156 457 3174 2226 3171 2229 3150 2224 3122 477 3115 474 3115 472 3115 470 3115 455 3122 457 3156"/>
                        </Shape>
                        <String CONTENT="the fall, are also hard on the herdsman; but the winter is easier, especially"/>
                    </TextLine>

