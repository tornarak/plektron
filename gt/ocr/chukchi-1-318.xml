                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l2" HPOS="563" VPOS="621" WIDTH="109" HEIGHT="71" BASELINE="565 669 672 664" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 621 630 621 574 634 563 658 565 669 565 679 615 692 617 692 620 692 672 675 672 664 669 634 635 621 633 621"/>
                        </Shape>
                        <String CONTENT="248"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-318_r2" HPOS="559" VPOS="727" WIDTH="1778" HEIGHT="187" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="559 727 2337 727 2337 914 559 914"/>
                    </Shape>
                    <TextLine ID="mz_1-318_l3" HPOS="663" VPOS="734" WIDTH="1667" HEIGHT="52" BASELINE="665 768 2330 762" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2309 736 2287 736 2265 734 2244 734 663 734 665 768 665 786 2328 779 2330 762 2326 736 2309 736"/>
                        </Shape>
                        <String CONTENT="Women’s caps and mittens are quite similar to those of men. The women"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l4" HPOS="552" VPOS="786" WIDTH="1781" HEIGHT="75" BASELINE="555 833 2333 822" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="555 833 555 861 648 848 851 859 853 859 856 859 910 846 1468 853 1471 853 1707 842 1847 853 1850 853 1962 851 1964 851 1967 851 1980 840 2159 851 2161 851 2268 840 2289 851 2291 851 2294 851 2296 851 2333 838 2333 822 2328 786 1289 786 1287 786 1284 786 1252 796 1096 788 1094 788 905 799 585 790 583 790 581 790 552 799 555 833"/>
                        </Shape>
                        <String CONTENT="also tie bright cotton handkerchiefs around their heads, after the manner of"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l5" HPOS="557" VPOS="846" WIDTH="312" HEIGHT="61" BASELINE="557 889 869 889" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 889 557 907 869 907 869 889 869 859 659 846 656 846 607 857 585 846 583 846 581 846 578 846 557 857 557 889"/>
                        </Shape>
                        <String CONTENT="the Russians."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-318_r3" HPOS="559" VPOS="914" WIDTH="1778" HEIGHT="605" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="559 914 2337 914 2337 1519 559 1519"/>
                    </Shape>
                    <TextLine ID="mz_1-318_l6" HPOS="661" VPOS="907" WIDTH="1669" HEIGHT="60" BASELINE="663 950 2330 946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="663 950 663 967 2328 967 2330 946 2326 915 674 907 672 907 669 907 667 907 667 909 661 913 663 950"/>
                        </Shape>
                        <String CONTENT="SUMMER CLOTHING. — The Chukchee have no special summer garments,"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l7" HPOS="555" VPOS="961" WIDTH="1775" HEIGHT="71" BASELINE="557 1013 2330 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 1013 557 1032 2328 1017 2330 1004 2326 974 2259 961 2257 961 2255 961 2233 972 2135 961 2133 961 2034 972 2008 961 2006 961 2003 961 2001 961 1960 972 1928 961 1925 961 1923 961 1860 974 1821 963 1819 963 1817 963 1815 963 1787 974 1668 963 1666 963 1544 974 1449 963 1447 963 1445 963 1442 963 1429 976 1395 965 1393 965 1391 965 1388 965 1365 976 1254 965 1252 965 1250 965 1211 976 1196 965 1193 965 1191 965 1042 965 1040 965 1038 965 994 978 702 967 700 967 555 980 557 1013"/>
                        </Shape>
                        <String CONTENT="properly speaking. Indeed, there is little need for them in those latitudes."/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l8" HPOS="555" VPOS="1024" WIDTH="1778" HEIGHT="60" BASELINE="557 1067 2333 1063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 1067 557 1084 2330 1080 2333 1063 2328 1035 1455 1024 1453 1024 1393 1037 555 1037 557 1067"/>
                        </Shape>
                        <String CONTENT="Fur clothes are used all the year round; the old, half-worn clothes, which are"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l9" HPOS="555" VPOS="1084" WIDTH="1778" HEIGHT="59" BASELINE="557 1128 2333 1123" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 1128 557 1143 2330 1138 2333 1123 2328 1095 1468 1084 1466 1084 1401 1095 596 1086 594 1086 591 1086 555 1097 557 1128"/>
                        </Shape>
                        <String CONTENT="of little use in the coldest season, being worn during the summer months."/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l10" HPOS="557" VPOS="1143" WIDTH="1773" HEIGHT="60" BASELINE="559 1188 2330 1182" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="559 1188 559 1203 2328 1199 2330 1182 2326 1154 1761 1143 1759 1143 1756 1143 1733 1156 557 1156 559 1188"/>
                        </Shape>
                        <String CONTENT="Dampness and rain are much more destructive to fur clothing than the dry"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l11" HPOS="557" VPOS="1201" WIDTH="1773" HEIGHT="63" BASELINE="559 1249 2330 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="559 1249 559 1264 2328 1260 2330 1242 2324 1210 2161 1212 2133 1201 2131 1201 2129 1201 2071 1212 2001 1201 1999 1201 1997 1201 1995 1201 1982 1212 1954 1201 1951 1201 1949 1201 1947 1201 1902 1212 1876 1201 1873 1201 1871 1201 1804 1212 1748 1201 1746 1201 1744 1201 1741 1201 1728 1212 1663 1203 1661 1203 1592 1214 1562 1203 1559 1203 1557 1203 1503 1214 1479 1203 1477 1203 1475 1203 1380 1214 1332 1203 1330 1203 1328 1203 1326 1203 1323 1203 1308 1214 1202 1203 1200 1203 1198 1203 1196 1203 1180 1214 836 1206 834 1206 832 1206 795 1216 758 1206 756 1206 754 1206 752 1206 728 1219 557 1219 559 1249"/>
                        </Shape>
                        <String CONTENT="snows of winter. So the Chukchee, who in mid-winter is clad in clean and"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l12" HPOS="555" VPOS="1275" WIDTH="1778" HEIGHT="47" BASELINE="557 1307 2333 1303" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 1307 557 1322 2330 1318 2333 1303 2328 1275 555 1275 557 1307"/>
                        </Shape>
                        <String CONTENT="handsome furs, in the summer wears the worst clothing he has. Even the"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l13" HPOS="557" VPOS="1322" WIDTH="1776" HEIGHT="61" BASELINE="559 1368 2333 1364" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="559 1368 559 1383 2330 1379 2333 1364 2330 1335 2281 1322 2278 1322 2276 1322 2274 1322 2244 1333 2170 1322 2168 1322 2166 1322 2131 1333 1945 1322 1943 1322 1876 1333 1748 1322 1746 1322 1744 1322 1702 1333 1663 1322 1661 1322 1659 1322 1657 1322 1629 1333 1579 1322 1577 1322 1442 1335 1412 1325 1410 1325 1408 1325 1406 1325 1375 1335 1349 1325 1347 1325 1345 1325 1343 1325 1310 1335 1096 1325 1094 1325 1038 1335 849 1325 847 1325 771 1335 732 1325 730 1325 728 1325 726 1325 704 1335 624 1325 622 1325 557 1338 559 1368"/>
                        </Shape>
                        <String CONTENT="well-to-do reindeer-breeders then look exceedingly shabby. The people, who"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l14" HPOS="555" VPOS="1394" WIDTH="1778" HEIGHT="52" BASELINE="557 1431 2333 1424" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="557 1431 557 1446 2330 1439 2333 1424 2326 1394 555 1394 557 1431"/>
                        </Shape>
                        <String CONTENT="have accustomed themselves to severe cold, apparently consider it not worth"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l15" HPOS="559" VPOS="1446" WIDTH="1750" HEIGHT="58" BASELINE="561 1489 2309 1485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1489 561 1504 2307 1500 2309 1485 2304 1455 598 1446 596 1446 594 1446 559 1457 561 1489"/>
                        </Shape>
                        <String CONTENT="while to prepare for the milder, damp weather of the short summer months."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-318_r4" HPOS="559" VPOS="1519" WIDTH="1778" HEIGHT="892" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="559 1519 2337 1519 2337 2411 559 2411"/>
                    </Shape>
                    <TextLine ID="mz_1-318_l16" HPOS="665" VPOS="1513" WIDTH="1665" HEIGHT="52" BASELINE="667 1548 2330 1543" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="667 1548 667 1561 2326 1565 2330 1543 2326 1515 665 1513 667 1548"/>
                        </Shape>
                        <String CONTENT="In the summer-time coats are worn either single or double. If single,"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l17" HPOS="557" VPOS="1563" WIDTH="1773" HEIGHT="63" BASELINE="559 1608 2330 1604" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="559 1608 559 1623 2326 1626 2330 1604 2326 1574 1445 1563 1442 1563 1440 1563 1395 1574 576 1565 574 1565 572 1565 570 1565 557 1571 559 1608"/>
                        </Shape>
                        <String CONTENT="they are always worn with the hair side in. Among the Reindeer Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l18" HPOS="559" VPOS="1632" WIDTH="1774" HEIGHT="50" BASELINE="561 1662 2333 1667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1662 559 1678 2328 1682 2333 1667 2330 1636 561 1632 561 1662"/>
                        </Shape>
                        <String CONTENT="trousers and shoes are made of strongly smoked tent-covering (retteˊm), which"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l19" HPOS="559" VPOS="1693" WIDTH="1774" HEIGHT="49" BASELINE="561 1727 2333 1721" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1727 561 1742 2330 1736 2333 1721 2328 1693 559 1693 561 1727"/>
                        </Shape>
                        <String CONTENT="has the advantage of not shrinking after having been wetted.¹ The trousers"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l20" HPOS="559" VPOS="1751" WIDTH="1774" HEIGHT="52" BASELINE="561 1788 2333 1784" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1788 561 1803 2330 1799 2333 1784 2328 1753 559 1751 561 1788"/>
                        </Shape>
                        <String CONTENT="have the usual cut. The soles of the boots are made of hard thong-seal hide."/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l21" HPOS="563" VPOS="1810" WIDTH="1772" HEIGHT="52" BASELINE="563 1846 2335 1846" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 1846 563 1862 2335 1862 2335 1846 2335 1816 563 1810 563 1846"/>
                        </Shape>
                        <String CONTENT="The boots often have small guards around the front to keep the toes from"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l22" HPOS="559" VPOS="1872" WIDTH="1776" HEIGHT="50" BASELINE="561 1907 2335 1903" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1907 561 1922 2333 1918 2335 1903 2330 1875 559 1872 561 1907"/>
                        </Shape>
                        <String CONTENT="being hurt by striking against stones and roots that lie exposed during the"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l23" HPOS="559" VPOS="1922" WIDTH="1774" HEIGHT="59" BASELINE="561 1965 2333 1961" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 1965 561 1981 2330 1976 2333 1961 2328 1933 1486 1922 1484 1922 1354 1933 808 1924 806 1924 559 1935 561 1965"/>
                        </Shape>
                        <String CONTENT="summer. These shoes are worn with thick grass insoles, but without socks."/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l24" HPOS="561" VPOS="1981" WIDTH="1776" HEIGHT="62" BASELINE="563 2028 2337 2022" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2028 563 2043 2335 2037 2337 2022 2333 1994 2073 1994 2058 1981 2055 1981 2053 1981 2051 1981 1884 1991 1852 1981 1850 1981 1847 1981 1845 1981 1817 1991 1761 1981 1759 1981 1756 1981 1728 1994 1624 1983 1622 1983 1512 1994 1425 1983 1423 1983 1371 1994 1300 1983 1297 1983 1295 1983 1258 1994 561 1991 563 2028"/>
                        </Shape>
                        <String CONTENT="They fit the foot closely, so that when walking ankle-deep in the numerous"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l25" HPOS="559" VPOS="2041" WIDTH="1776" HEIGHT="61" BASELINE="561 2089 2335 2082" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 2089 561 2102 2333 2098 2335 2082 2333 2054 2287 2041 2285 2041 2283 2041 2220 2052 2103 2041 2101 2041 2099 2041 2075 2052 2012 2041 2010 2041 2008 2041 1975 2052 1852 2041 1850 2041 1737 2056 1468 2056 1449 2043 1447 2043 1445 2043 1442 2043 1347 2054 1163 2043 1161 2043 1159 2043 1124 2054 1048 2046 1046 2046 1044 2046 1042 2046 1029 2056 994 2046 992 2046 990 2046 559 2050 561 2089"/>
                        </Shape>
                        <String CONTENT="bogs and mountain brooks, very little water can remain in the shoe. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l26" HPOS="561" VPOS="2104" WIDTH="1774" HEIGHT="61" BASELINE="561 2147 2335 2147" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 2147 561 2162 2333 2165 2335 2147 2335 2115 2289 2104 2287 2104 2166 2104 2164 2104 2161 2104 2159 2104 2146 2115 2081 2104 2079 2104 2006 2115 1967 2104 1964 2104 1962 2104 1839 2115 1689 2104 1687 2104 1685 2104 1663 2115 1577 2104 1575 2104 1572 2104 1544 2117 1313 2117 1297 2104 1295 2104 1293 2104 1068 2104 1066 2104 1063 2104 1040 2117 676 2117 615 2104 613 2104 561 2115 561 2147"/>
                        </Shape>
                        <String CONTENT="soles, moreover, are pierced with two rows of small holes made with a bodkin,"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l27" HPOS="561" VPOS="2171" WIDTH="1774" HEIGHT="52" BASELINE="563 2204 2335 2208" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2204 561 2217 2330 2223 2335 2208 2333 2175 563 2171 563 2204"/>
                        </Shape>
                        <String CONTENT="to facilitate the outlet of the water. Even after a long walk through water,"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l28" HPOS="561" VPOS="2223" WIDTH="1776" HEIGHT="59" BASELINE="563 2266 2337 2262" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2266 563 2282 2335 2277 2337 2262 2333 2234 1462 2223 1460 2223 1458 2223 1455 2223 1442 2234 598 2225 596 2225 594 2225 561 2236 563 2266"/>
                        </Shape>
                        <String CONTENT="when a stretch of dry ground is reached, the shoes dry very rapidly under"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l29" HPOS="563" VPOS="2284" WIDTH="1776" HEIGHT="58" BASELINE="563 2325 2339 2325" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2325 563 2342 2339 2342 2339 2325 2339 2297 2287 2284 2285 2284 2170 2295 1876 2284 1873 2284 1871 2284 1869 2284 1854 2295 1821 2284 1819 2284 1817 2284 1746 2295 1679 2284 1676 2284 1674 2284 1672 2284 1657 2297 1356 2297 1302 2284 1300 2284 1297 2284 1265 2295 1219 2284 1217 2284 1215 2284 1213 2284 1211 2284 1193 2297 1096 2297 1061 2284 1059 2284 1057 2284 1055 2284 1025 2295 973 2284 970 2284 968 2284 966 2284 951 2295 916 2284 914 2284 912 2284 910 2284 882 2297 641 2297 585 2284 583 2284 581 2284 578 2284 563 2292 563 2325"/>
                        </Shape>
                        <String CONTENT="the pressure of the foot. As there are no stockings inside, the feet will be"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l30" HPOS="561" VPOS="2340" WIDTH="756" HEIGHT="67" BASELINE="563 2381 1317 2385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2381 561 2401 570 2407 572 2407 574 2407 576 2407 1315 2401 1317 2385 1315 2355 1146 2342 1144 2342 1076 2353 1053 2342 1050 2342 1048 2342 968 2353 942 2340 940 2340 938 2340 936 2340 897 2351 886 2342 886 2340 884 2340 882 2340 879 2340 877 2340 851 2351 817 2340 814 2340 812 2340 810 2340 786 2351 728 2340 726 2340 723 2340 721 2340 704 2351 637 2340 635 2340 563 2349 563 2381"/>
                        </Shape>
                        <String CONTENT="quite dry in half an hour’s time."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-318_r5" HPOS="559" VPOS="2411" WIDTH="1778" HEIGHT="300" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="559 2411 2337 2411 2337 2711 559 2711"/>
                    </Shape>
                    <TextLine ID="mz_1-318_l31" HPOS="672" VPOS="2405" WIDTH="1667" HEIGHT="54" BASELINE="674 2440 2339 2444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="674 2440 672 2455 2335 2459 2339 2444 2337 2414 674 2405 674 2440"/>
                        </Shape>
                        <String CONTENT="The summer trousers and boots of the Maritime Chukchee, as has been"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l32" HPOS="561" VPOS="2474" WIDTH="1776" HEIGHT="48" BASELINE="561 2505 2337 2505" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 2505 561 2522 2337 2522 2337 2505 2337 2474 561 2474 561 2505"/>
                        </Shape>
                        <String CONTENT="noted before, are made of seal-skin, which is much more suitable for this pur-"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l33" HPOS="561" VPOS="2518" WIDTH="1778" HEIGHT="69" BASELINE="563 2565 2339 2559" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2565 563 2587 2337 2576 2339 2559 2335 2531 2226 2531 2209 2518 2207 2518 2205 2518 2203 2518 2086 2528 2071 2518 2068 2518 2066 2518 2064 2518 2062 2518 2060 2518 2045 2528 2021 2518 2019 2518 2016 2518 1945 2528 1923 2518 1921 2518 1919 2518 1917 2518 1895 2528 1878 2518 1876 2518 1873 2518 1871 2518 1869 2518 1867 2518 1852 2528 1646 2520 1644 2520 1642 2520 1622 2531 1601 2520 1598 2520 1596 2520 1484 2531 1421 2520 1419 2520 1354 2531 1289 2520 1287 2520 1215 2531 1178 2520 1176 2520 1174 2520 1025 2533 1001 2522 999 2522 996 2522 791 2533 702 2522 700 2522 697 2522 695 2522 680 2535 561 2535 563 2565"/>
                        </Shape>
                        <String CONTENT="pose than any kind of reindeer-skin. The seal-skin is curried and the epidermis"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l34" HPOS="561" VPOS="2591" WIDTH="1778" HEIGHT="48" BASELINE="563 2624 2339 2619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2624 563 2639 2337 2634 2339 2619 2335 2591 561 2591 563 2624"/>
                        </Shape>
                        <String CONTENT="is left on, or the skin is well scraped and blackened with soot. Thanks to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-318_l35" HPOS="561" VPOS="2647" WIDTH="1635" HEIGHT="52" BASELINE="563 2678 2196 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2678 561 2693 2192 2699 2196 2684 2194 2654 563 2647 563 2678"/>
                        </Shape>
                        <String CONTENT="thickness and oiliness of seal-skin, they are nearly impervious to water."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-318_r6" HPOS="559" VPOS="2711" WIDTH="1778" HEIGHT="243" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="559 2711 2337 2711 2337 2954 559 2954"/>
                    </Shape>
                    <TextLine ID="mz_1-318_l36" HPOS="674" VPOS="2699" WIDTH="1665" HEIGHT="61" BASELINE="676 2741 2339 2745" TAGREFS="TYPE_4">
                        <Shape>
