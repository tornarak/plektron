                    <TextLine ID="mz_1-060_l32" HPOS="747" VPOS="2528" WIDTH="1771" HEIGHT="74" BASELINE="749 2576 2518 2569" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2576 749 2591 1312 2602 1314 2602 1316 2602 1318 2602 1340 2589 1437 2600 1440 2600 1494 2589 1632 2600 1635 2600 1637 2600 1674 2589 1710 2600 1713 2600 1715 2600 1845 2589 1884 2600 1886 2600 1888 2600 2516 2587 2518 2569 2514 2541 2185 2528 2182 2528 2120 2539 2087 2528 2085 2528 2083 2528 2081 2528 2035 2539 2014 2528 2011 2528 2009 2528 2007 2528 2005 2528 1988 2539 1884 2530 1881 2530 1879 2530 1877 2530 1862 2543 1760 2543 1713 2530 1710 2530 1708 2530 1641 2541 1615 2530 1613 2530 1611 2530 1609 2530 1585 2541 1557 2530 1554 2530 1552 2530 1550 2530 1509 2541 1496 2530 1494 2530 1492 2530 1360 2530 1357 2530 1355 2530 1353 2530 1331 2543 952 2533 950 2533 855 2543 777 2533 775 2533 773 2533 747 2543 749 2576"/>
                        </Shape>
                        <String CONTENT="chee social organization, “Chief of the Chaun Chukchee”). This document"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l33" HPOS="749" VPOS="2600" WIDTH="1769" HEIGHT="52" BASELINE="749 2634 2518 2634" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2634 749 2652 2518 2652 2518 2634 2516 2600 749 2600 749 2634"/>
                        </Shape>
                        <String CONTENT="had been preserved in the family of Qɪˊmɪqäi for more than a century, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l34" HPOS="749" VPOS="2660" WIDTH="1769" HEIGHT="52" BASELINE="749 2695 2518 2695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2695 749 2712 2518 2712 2518 2695 2518 2665 749 2660 749 2695"/>
                        </Shape>
                        <String CONTENT="had gradually come to be considered, along with the fire-drills and strings"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l35" HPOS="747" VPOS="2721" WIDTH="1769" HEIGHT="58" BASELINE="749 2753 2516 2758" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2753 747 2766 768 2779 770 2779 773 2779 2514 2773 2516 2758 2514 2725 749 2721 749 2753"/>
                        </Shape>
                        <String CONTENT="of amulets, a part of their sacred possessions. The family became extinct,"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l36" HPOS="747" VPOS="2775" WIDTH="1771" HEIGHT="56" BASELINE="749 2814 2518 2810" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2814 749 2831 2516 2827 2518 2810 2514 2779 816 2775 814 2775 747 2786 749 2814"/>
                        </Shape>
                        <String CONTENT="and I was able to acquire it, together with a curious wooden case adorned"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l37" HPOS="747" VPOS="2840" WIDTH="1773" HEIGHT="61" BASELINE="749 2870 2520 2875" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2870 747 2885 794 2898 796 2898 799 2898 1433 2890 1652 2901 1654 2901 2518 2890 2520 2875 2520 2844 749 2840 749 2870"/>
                        </Shape>
                        <String CONTENT="with beads and tassels, for a moderate price. When I brought it to the tent"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l38" HPOS="749" VPOS="2901" WIDTH="1769" HEIGHT="52" BASELINE="749 2935 2518 2935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 2935 749 2953 2518 2953 2518 2935 2518 2905 749 2901 749 2935"/>
                        </Shape>
                        <String CONTENT="in which I was temporarily living, my host warned me against taking it into"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l39" HPOS="744" VPOS="2953" WIDTH="1776" HEIGHT="60" BASELINE="747 2996 2520 2992" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="747 2996 747 3013 2518 3009 2520 2992 2516 2961 766 2953 764 2953 762 2953 760 2953 744 2959 747 2996"/>
                        </Shape>
                        <String CONTENT="the inner room; but as it was bitterly cold outside, and as I wished to examine"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l40" HPOS="747" VPOS="3024" WIDTH="1773" HEIGHT="45" BASELINE="747 3054 2520 3054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="747 3054 747 3069 2520 3069 2520 3054 2520 3024 747 3024 747 3054"/>
                        </Shape>
                        <String CONTENT="the paper, I took it in. No sooner had I produced the fatal wooden case"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l41" HPOS="744" VPOS="3074" WIDTH="1774" HEIGHT="65" BASELINE="747 3115 2518 3111" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="747 3115 747 3130 2492 3139 2494 3139 2496 3139 2518 3126 2518 3111 2514 3082 757 3074 755 3074 753 3074 751 3074 751 3076 744 3080 747 3115"/>
                        </Shape>
                        <String CONTENT="from my bag, than the mistress of the house, a sickly woman of thirty, who"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l42" HPOS="747" VPOS="3132" WIDTH="1771" HEIGHT="59" BASELINE="749 3176 2518 3171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 3176 749 3191 2516 3186 2518 3171 2514 3143 1682 3132 1680 3132 1619 3143 807 3134 805 3134 747 3145 749 3176"/>
                        </Shape>
                        <String CONTENT="sat opposite me, nursing a child on her lap, moaned and fell senseless. We"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l43" HPOS="751" VPOS="3199" WIDTH="1769" HEIGHT="57" BASELINE="751 3234 2520 3234" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="751 3234 751 3256 2520 3256 2520 3234 2520 3204 751 3199 751 3234"/>
                        </Shape>
                        <String CONTENT="had much trouble in reviving her, and afterwards I had to expiate my offence"/>
                    </TextLine>
