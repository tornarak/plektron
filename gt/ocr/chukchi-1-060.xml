                <TextBlock ID="text_1-060" HPOS="721" VPOS="617" WIDTH="1778" HEIGHT="2624"><TextLine ID="mz_1-060_l1" HPOS="1295" VPOS="617" WIDTH="617" HEIGHT="54" BASELINE="1297 649 1912 653" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1904 617 1603 617 1601 617 1579 617 1557 617 1536 617 1514 617 1492 617 1471 617 1449 617 1427 617 1406 617 1384 617 1362 617 1341 617 1319 617 1297 617 1297 649 1295 666 1908 671 1912 653 1910 630 1904 617"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-060_l2" HPOS="721" VPOS="716" WIDTH="1776" HEIGHT="61" BASELINE="723 764 2497 760" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2432 727 2421 725 2395 725 2389 725 2367 725 2346 725 2324 723 2302 723 2281 723 2259 721 2237 721 2216 721 2194 721 2183 718 2155 727 2129 718 2112 716 2034 727 1997 716 1995 716 1993 716 1990 716 1954 727 1902 716 1899 716 1819 727 1767 716 1765 716 1763 716 1761 716 1746 729 1596 729 1479 718 1477 718 1425 729 1235 718 1232 718 1230 718 1198 729 1113 718 1111 718 721 727 723 764 723 777 2495 773 2497 760 2493 729 2443 727 2432 727"/>
                        </Shape>
                        <String CONTENT="Maritime Chukchee the men who seem to be quite decrepit almost always"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l3" HPOS="721" VPOS="779" WIDTH="1774" HEIGHT="67" BASELINE="723 825 2495 818" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 825 723 846 2493 833 2495 818 2491 788 1345 779 1343 779 1341 779 1308 790 888 781 886 781 721 792 723 825"/>
                        </Shape>
                        <String CONTENT="prove to have become so rather from the hardships of life than from old age."/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l4" HPOS="726" VPOS="840" WIDTH="1769" HEIGHT="60" BASELINE="726 883 2495 883" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 883 726 898 2493 900 2495 883 2495 853 2365 840 2363 840 2296 851 2255 840 2252 840 2250 840 2155 851 2099 840 2097 840 2094 840 2058 851 1986 840 1837 840 1834 840 1832 840 1830 840 1815 851 1663 840 1661 840 1659 840 1614 851 1562 840 1559 840 1416 851 1401 840 1399 840 1397 840 1395 840 1293 851 1204 840 1202 840 1128 853 843 853 825 840 823 840 821 840 819 840 726 848 726 883"/>
                        </Shape>
                        <String CONTENT="Such men are speedily carried away by disease. Therefore the really old men,"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l5" HPOS="721" VPOS="911" WIDTH="776" HEIGHT="48" BASELINE="723 944 1497 939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 944 723 959 1494 954 1497 939 1492 911 721 911 723 944"/>
                        </Shape>
                        <String CONTENT="in my opinion, are not numerous."/>
                    </TextLine>
<TextLine ID="mz_1-060_l6" HPOS="834" VPOS="952" WIDTH="1663" HEIGHT="76" BASELINE="836 1004 2497 993" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="836 1004 836 1019 1378 1017 1423 1028 1425 1028 1427 1028 1533 1015 1681 1026 1683 1026 1685 1026 1715 1015 1826 1024 1828 1024 1830 1024 1832 1024 1847 1013 1990 1013 2003 1024 2006 1024 2008 1024 2010 1024 2012 1024 2049 1013 2075 1024 2077 1024 2079 1024 2081 1024 2125 1013 2138 1024 2140 1024 2142 1024 2144 1024 2255 1011 2272 1022 2274 1022 2276 1022 2278 1022 2495 1013 2497 993 2495 963 2482 952 2480 952 2478 952 2475 952 2473 952 2471 952 2456 963 2372 952 2369 952 2313 963 2285 952 2283 952 2281 952 2278 952 2276 952 2263 965 2161 965 2075 954 2073 954 2071 954 2047 967 1852 967 1837 954 1834 954 1832 954 1830 954 1828 954 1787 970 1546 970 1531 957 1529 957 1527 957 1525 957 1453 970 1326 959 1323 959 1163 972 834 965 836 1004"/>
                        </Shape>
                        <String CONTENT="THE SENSES. — Of the special senses, smell seems to be more developed"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l7" HPOS="721" VPOS="1017" WIDTH="1774" HEIGHT="61" BASELINE="723 1063 2495 1058" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 1063 723 1078 2493 1073 2495 1058 2491 1030 2374 1017 2372 1017 2369 1017 2341 1028 1995 1017 1993 1017 1990 1017 1988 1017 1971 1030 1795 1030 1609 1017 1607 1017 1605 1017 1570 1030 1514 1019 1512 1019 1510 1019 1477 1030 1007 1019 1005 1019 1003 1019 955 1030 895 1019 892 1019 827 1030 743 1019 741 1019 739 1019 736 1019 721 1028 723 1063"/>
                        </Shape>
                        <String CONTENT="than with civilized races, since the Chukchee assert that every man has a"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l8" HPOS="721" VPOS="1076" WIDTH="1774" HEIGHT="62" BASELINE="723 1123 2495 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 1123 723 1138 2493 1132 2495 1117 2491 1089 2270 1076 2268 1076 2265 1076 2263 1076 2246 1089 2097 1089 2042 1076 2040 1076 2038 1076 2036 1076 2021 1086 1462 1078 1460 1078 1458 1078 1455 1078 1438 1089 1408 1078 1406 1078 1403 1078 1332 1089 1317 1078 1315 1078 1313 1078 1310 1078 1256 1089 1154 1080 1152 1080 1150 1080 1148 1080 1133 1091 968 1080 966 1080 864 1091 812 1080 810 1080 721 1093 723 1123"/>
                        </Shape>
                        <String CONTENT="smell peculiar to himself, and that his clothes, etc., can be ascertained from"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l9" HPOS="723" VPOS="1136" WIDTH="1774" HEIGHT="61" BASELINE="726 1182 2497 1177" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1182 726 1197 2495 1193 2497 1177 2495 1149 2450 1136 2447 1136 2445 1136 2443 1136 2413 1147 2361 1136 2359 1136 2281 1147 2257 1136 2255 1136 2252 1136 2198 1147 2151 1136 2148 1136 2146 1136 2144 1136 2114 1149 1800 1149 1763 1136 1761 1136 1759 1136 1756 1136 1724 1147 1581 1138 1579 1138 1577 1138 1575 1138 1559 1149 1445 1138 1442 1138 1440 1138 1408 1149 1339 1138 1336 1138 1278 1149 1224 1138 1222 1138 1219 1138 1193 1149 1131 1138 1128 1138 1126 1138 1092 1149 1079 1138 1076 1138 1074 1138 1072 1138 723 1145 726 1182"/>
                        </Shape>
                        <String CONTENT="it. I was told that in olden times, during the wars among the Koryak, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l10" HPOS="723" VPOS="1208" WIDTH="1772" HEIGHT="54" BASELINE="726 1242 2495 1238" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1242 726 1262 2493 1262 2495 1238 2491 1208 723 1208 726 1242"/>
                        </Shape>
                        <String CONTENT="invading Chukchee parties, finding an old camping-place, were able to ascertain,"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l11" HPOS="723" VPOS="1258" WIDTH="1774" HEIGHT="60" BASELINE="726 1303 2497 1296" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1303 726 1318 2495 1312 2497 1296 2493 1268 1945 1258 1943 1258 1941 1258 1902 1268 1317 1260 1315 1260 1313 1260 1310 1260 1297 1273 723 1273 726 1303"/>
                        </Shape>
                        <String CONTENT="from the odor of broken bones and other remains, whether they belonged to"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l12" HPOS="723" VPOS="1320" WIDTH="1774" HEIGHT="57" BASELINE="726 1361 2497 1357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1361 726 1377 2495 1372 2497 1357 2493 1329 745 1320 743 1320 741 1320 739 1320 723 1327 726 1361"/>
                        </Shape>
                        <String CONTENT="the Koryak or to their own tribe. Accordingly mutual sniffing has the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l13" HPOS="723" VPOS="1377" WIDTH="1772" HEIGHT="60" BASELINE="726 1422 2495 1416" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1422 726 1437 2493 1431 2495 1416 2491 1387 1904 1377 1902 1377 1899 1377 1897 1377 1882 1387 782 1381 780 1381 723 1392 726 1422"/>
                        </Shape>
                        <String CONTENT="value as kissing, as is the case with many other primitive tribes. The Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l14" HPOS="723" VPOS="1439" WIDTH="1774" HEIGHT="59" BASELINE="726 1483 2497 1478" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1483 726 1498 2495 1494 2497 1478 2493 1448 754 1439 752 1439 749 1439 723 1448 726 1483"/>
                        </Shape>
                        <String CONTENT="chee father, when leaving his family for a trip, will perhaps kiss his wife; but"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l15" HPOS="721" VPOS="1496" WIDTH="1776" HEIGHT="62" BASELINE="723 1543 2497 1539" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 1543 723 1558 2495 1554 2497 1539 2495 1509 2460 1496 2458 1496 2456 1496 2454 1496 2426 1506 2411 1496 2408 1496 2406 1496 2404 1496 2071 1506 2055 1496 2053 1496 2051 1496 1893 1496 1891 1496 1889 1496 1845 1506 1752 1496 1750 1496 1592 1509 1516 1498 1514 1498 1512 1498 1510 1498 1492 1511 1284 1511 1226 1498 1224 1498 1222 1498 1219 1498 1202 1509 1159 1498 1157 1498 1154 1498 1059 1509 1005 1498 1003 1498 903 1509 847 1498 845 1498 786 1509 734 1498 732 1498 730 1498 728 1498 728 1500 721 1504 723 1543"/>
                        </Shape>
                        <String CONTENT="he will usually apply his nose to the nape of his children’s necks, and inhale"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l16" HPOS="723" VPOS="1556" WIDTH="637" HEIGHT="61" BASELINE="726 1602 1360 1597" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1602 726 1617 1358 1615 1360 1597 1356 1569 1248 1556 1245 1556 1178 1567 1152 1556 1150 1556 1148 1556 1146 1556 1118 1567 1085 1556 1083 1556 1081 1556 1079 1556 1076 1556 1061 1567 1044 1556 1042 1556 1040 1556 1038 1556 1035 1556 1033 1556 1016 1569 1003 1558 1001 1558 999 1558 996 1558 778 1569 749 1558 747 1558 745 1558 743 1558 741 1558 723 1567 726 1602"/>
                        </Shape>
                        <String CONTENT="the odor of their fur shirts."/>
                    </TextLine>
<TextLine ID="mz_1-060_l17" HPOS="834" VPOS="1628" WIDTH="1663" HEIGHT="50" BASELINE="836 1662 2497 1658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="836 1662 836 1678 2495 1673 2497 1658 2493 1628 834 1628 836 1662"/>
                        </Shape>
                        <String CONTENT="I must note, too, the sensitiveness of the Chukchee to unfamiliar odors."/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l18" HPOS="723" VPOS="1675" WIDTH="1774" HEIGHT="70" BASELINE="726 1723 2497 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1723 726 1738 1904 1745 1906 1745 1908 1745 1934 1734 2495 1734 2497 1717 2495 1688 2454 1675 2452 1675 2450 1675 2447 1675 2426 1686 2402 1675 2400 1675 2398 1675 2281 1686 2250 1675 2248 1675 2246 1675 2179 1686 2094 1675 2092 1675 2019 1686 1988 1675 1986 1675 1984 1675 1889 1688 1767 1678 1765 1678 1763 1678 1739 1691 1386 1691 1356 1678 1354 1678 1352 1678 1267 1691 1180 1680 1178 1680 1100 1691 1038 1680 1035 1680 1033 1680 999 1691 923 1680 921 1680 723 1688 726 1723"/>
                        </Shape>
                        <String CONTENT="Every time that I happened to open my small chest of medicines in a Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l19" HPOS="723" VPOS="1736" WIDTH="1772" HEIGHT="65" BASELINE="726 1784 2495 1777" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 1784 726 1801 2493 1794 2495 1777 2491 1747 1910 1736 1908 1736 1906 1736 1904 1736 1891 1747 752 1740 749 1740 747 1740 723 1749 726 1784"/>
                        </Shape>
                        <String CONTENT="chee sleeping-room, the inmates complained loudly of the offensive smell which"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l20" HPOS="726" VPOS="1807" WIDTH="1771" HEIGHT="50" BASELINE="728 1842 2497 1836" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 1842 728 1857 2495 1853 2497 1836 2491 1807 726 1812 728 1842"/>
                        </Shape>
                        <String CONTENT="came from it, and sometimes I was obliged to go away to the outer tent"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l21" HPOS="728" VPOS="1870" WIDTH="1769" HEIGHT="48" BASELINE="728 1901 2497 1901" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 1901 728 1918 2497 1918 2497 1901 2497 1870 728 1870 728 1901"/>
                        </Shape>
                        <String CONTENT="with my patients. Similar complaint was made against some wild onions that"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l22" HPOS="726" VPOS="1927" WIDTH="1771" HEIGHT="49" BASELINE="728 1961 2497 1957" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 1961 728 1976 2495 1972 2497 1957 2493 1929 726 1927 728 1961"/>
                        </Shape>
                        <String CONTENT="I brought in, though the Russianized natives use them for food and even"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l23" HPOS="728" VPOS="1978" WIDTH="1769" HEIGHT="59" BASELINE="728 2020 2497 2020" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2020 728 2037 2497 2037 2497 2020 2497 1991 2411 1978 2408 1978 2406 1978 2369 1989 2324 1978 2322 1978 2320 1978 2131 1989 2058 1978 2055 1978 2053 1978 2051 1978 2038 1989 2025 1978 2023 1978 2021 1978 1930 1978 1928 1978 1925 1978 1893 1989 1808 1978 1806 1978 1804 1978 1802 1978 1787 1991 1650 1991 1549 1978 1546 1978 1471 1989 1440 1978 1438 1978 1436 1978 1434 1978 1403 1989 1319 1978 1317 1978 1100 1989 1068 1978 1066 1978 1063 1978 1061 1978 1038 1989 1003 1978 1001 1978 999 1978 912 1989 886 1978 884 1978 882 1978 879 1978 877 1978 858 1991 728 1991 728 2020"/>
                        </Shape>
                        <String CONTENT="store them in large quantities for winter use. The Chukchee name for them"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l24" HPOS="726" VPOS="2046" WIDTH="714" HEIGHT="52" BASELINE="728 2078 1440 2082" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2078 726 2093 1436 2098 1440 2082 1438 2050 728 2046 728 2078"/>
                        </Shape>
                        <String CONTENT="is tɪkêˊ-vaˊg̣lɪñɪn (“smell-grass”)."/>
                    </TextLine>
<TextLine ID="mz_1-060_l25" HPOS="832" VPOS="2095" WIDTH="1665" HEIGHT="70" BASELINE="834 2137 2497 2141" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="834 2137 832 2152 853 2165 856 2165 858 2165 2495 2156 2497 2141 2497 2111 2458 2098 2456 2098 2454 2098 2335 2111 2055 2111 2021 2098 2019 2098 2016 2098 2014 2098 1969 2108 1934 2098 1932 2098 1930 2098 1863 2108 1815 2098 1813 2098 1811 2098 1808 2098 1806 2098 1793 2106 1782 2098 1780 2098 1778 2098 1685 2098 1683 2098 1681 2098 1679 2098 1661 2108 1531 2095 1529 2095 1527 2095 1501 2106 1432 2095 1429 2095 1427 2095 1395 2106 1367 2095 1365 2095 1362 2095 1287 2106 1206 2095 1204 2095 1202 2095 1176 2108 1031 2108 1016 2095 1014 2095 1012 2095 1009 2095 1007 2095 986 2106 834 2104 834 2137"/>
                        </Shape>
                        <String CONTENT="The taboo against bringing into a Chukchee sleeping-room any objects"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l26" HPOS="726" VPOS="2169" WIDTH="1771" HEIGHT="50" BASELINE="726 2199 2497 2199" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 2199 726 2219 2497 2219 2497 2199 2497 2169 726 2169 726 2199"/>
                        </Shape>
                        <String CONTENT="connected with the hearths and households of other families is founded, in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l27" HPOS="723" VPOS="2219" WIDTH="1774" HEIGHT="58" BASELINE="726 2262 2497 2256" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 2262 726 2277 2495 2271 2497 2256 2493 2227 1317 2219 1315 2219 1263 2230 769 2221 767 2221 765 2221 723 2232 726 2262"/>
                        </Shape>
                        <String CONTENT="minds of the people, chiefly upon their unfamiliar odor. I have had some"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l28" HPOS="723" VPOS="2290" WIDTH="1774" HEIGHT="50" BASELINE="723 2321 2497 2321" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 2321 723 2338 2495 2340 2497 2321 2497 2290 723 2290 723 2321"/>
                        </Shape>
                        <String CONTENT="curious experiences regarding this idiosyncrasy. In 1896, while travelling among"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l29" HPOS="721" VPOS="2338" WIDTH="1776" HEIGHT="60" BASELINE="723 2383 2497 2379" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 2383 723 2396 2493 2398 2497 2379 2493 2351 2439 2338 2437 2338 2434 2338 2389 2349 2118 2338 2116 2338 2114 2338 2086 2351 1908 2351 1869 2338 1867 2338 1865 2338 1863 2338 1860 2338 1845 2351 1607 2351 1497 2340 1494 2340 1365 2351 1235 2340 1232 2340 1230 2340 1189 2351 983 2340 981 2340 979 2340 977 2340 966 2351 953 2340 951 2340 949 2340 847 2340 845 2340 843 2340 804 2351 747 2340 745 2340 743 2340 741 2340 721 2349 723 2383"/>
                        </Shape>
                        <String CONTENT="the Anui Chukchee, I happened to procure a document of the year 1789;"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l30" HPOS="721" VPOS="2398" WIDTH="1776" HEIGHT="63" BASELINE="723 2444 2497 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 2444 723 2461 2495 2453 2497 2435 2493 2405 1170 2398 1167 2398 1165 2398 1163 2398 1150 2409 775 2401 773 2401 721 2411 723 2444"/>
                        </Shape>
                        <String CONTENT="acknowledging the loyal faith of a certain Qɪˊmɪqäi, evidently a rich reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l31" HPOS="723" VPOS="2459" WIDTH="1774" HEIGHT="65" BASELINE="726 2502 2497 2496" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 2502 726 2518 1904 2524 1906 2524 2495 2511 2497 2496 2493 2468 1352 2459 1349 2459 723 2472 726 2502"/>
                        </Shape>
                        <String CONTENT="owner (the document calls him, with the usual misapprehension of the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l32" HPOS="726" VPOS="2513" WIDTH="1771" HEIGHT="74" BASELINE="728 2561 2497 2554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2561 728 2576 1291 2587 1293 2587 1295 2587 1297 2587 1319 2574 1416 2585 1419 2585 1473 2574 1611 2585 1614 2585 1616 2585 1653 2574 1689 2585 1692 2585 1694 2585 1824 2574 1863 2585 1865 2585 1867 2585 2495 2572 2497 2554 2493 2526 2164 2513 2161 2513 2099 2524 2066 2513 2064 2513 2062 2513 2060 2513 2014 2524 1993 2513 1990 2513 1988 2513 1986 2513 1984 2513 1967 2524 1863 2515 1860 2515 1858 2515 1856 2515 1841 2528 1739 2528 1692 2515 1689 2515 1687 2515 1620 2526 1594 2515 1592 2515 1590 2515 1588 2515 1564 2526 1536 2515 1533 2515 1531 2515 1529 2515 1488 2526 1475 2515 1473 2515 1471 2515 1339 2515 1336 2515 1334 2515 1332 2515 1310 2528 931 2518 929 2518 834 2528 756 2518 754 2518 752 2518 726 2528 728 2561"/>
                        </Shape>
                        <String CONTENT="chee social organization, “Chief of the Chaun Chukchee”). This document"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l33" HPOS="728" VPOS="2585" WIDTH="1769" HEIGHT="52" BASELINE="728 2619 2497 2619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2619 728 2637 2497 2637 2497 2619 2495 2585 728 2585 728 2619"/>
                        </Shape>
                        <String CONTENT="had been preserved in the family of Qɪˊmɪqäi for more than a century, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l34" HPOS="728" VPOS="2645" WIDTH="1769" HEIGHT="52" BASELINE="728 2680 2497 2680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2680 728 2697 2497 2697 2497 2680 2497 2650 728 2645 728 2680"/>
                        </Shape>
                        <String CONTENT="had gradually come to be considered, along with the fire-drills and strings"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l35" HPOS="726" VPOS="2706" WIDTH="1769" HEIGHT="58" BASELINE="728 2738 2495 2743" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2738 726 2751 747 2764 749 2764 752 2764 2493 2758 2495 2743 2493 2710 728 2706 728 2738"/>
                        </Shape>
                        <String CONTENT="of amulets, a part of their sacred possessions. The family became extinct,"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l36" HPOS="726" VPOS="2760" WIDTH="1771" HEIGHT="56" BASELINE="728 2799 2497 2795" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2799 728 2816 2495 2812 2497 2795 2493 2764 795 2760 793 2760 726 2771 728 2799"/>
                        </Shape>
                        <String CONTENT="and I was able to acquire it, together with a curious wooden case adorned"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l37" HPOS="726" VPOS="2825" WIDTH="1773" HEIGHT="61" BASELINE="728 2855 2499 2860" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2855 726 2870 773 2883 775 2883 778 2883 1412 2875 1631 2886 1633 2886 2497 2875 2499 2860 2499 2829 728 2825 728 2855"/>
                        </Shape>
                        <String CONTENT="with beads and tassels, for a moderate price. When I brought it to the tent"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l38" HPOS="728" VPOS="2886" WIDTH="1769" HEIGHT="52" BASELINE="728 2920 2497 2920" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 2920 728 2938 2497 2938 2497 2920 2497 2890 728 2886 728 2920"/>
                        </Shape>
                        <String CONTENT="in which I was temporarily living, my host warned me against taking it into"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l39" HPOS="723" VPOS="2938" WIDTH="1776" HEIGHT="60" BASELINE="726 2981 2499 2977" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 2981 726 2998 2497 2994 2499 2977 2495 2946 745 2938 743 2938 741 2938 739 2938 723 2944 726 2981"/>
                        </Shape>
                        <String CONTENT="the inner room; but as it was bitterly cold outside, and as I wished to examine"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l40" HPOS="726" VPOS="3009" WIDTH="1773" HEIGHT="45" BASELINE="726 3039 2499 3039" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 3039 726 3054 2499 3054 2499 3039 2499 3009 726 3009 726 3039"/>
                        </Shape>
                        <String CONTENT="the paper, I took it in. No sooner had I produced the fatal wooden case"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l41" HPOS="723" VPOS="3059" WIDTH="1774" HEIGHT="65" BASELINE="726 3100 2497 3096" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="726 3100 726 3115 2471 3124 2473 3124 2475 3124 2497 3111 2497 3096 2493 3067 736 3059 734 3059 732 3059 730 3059 730 3061 723 3065 726 3100"/>
                        </Shape>
                        <String CONTENT="from my bag, than the mistress of the house, a sickly woman of thirty, who"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l42" HPOS="726" VPOS="3117" WIDTH="1771" HEIGHT="59" BASELINE="728 3161 2497 3156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="728 3161 728 3176 2495 3171 2497 3156 2493 3128 1661 3117 1659 3117 1598 3128 786 3119 784 3119 726 3130 728 3161"/>
                        </Shape>
                        <String CONTENT="sat opposite me, nursing a child on her lap, moaned and fell senseless. We"/>
                    </TextLine>

                    <TextLine ID="mz_1-060_l43" HPOS="730" VPOS="3184" WIDTH="1769" HEIGHT="57" BASELINE="730 3219 2499 3219" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="730 3219 730 3241 2499 3241 2499 3219 2499 3189 730 3184 730 3219"/>
                        </Shape>
                        <String CONTENT="had much trouble in reviving her, and afterwards I had to expiate my offence"/>
                    </TextLine>
</TextBlock></PrintSpace>
        </Page>
