                <TextBlock ID="text_1-177" HPOS="373" VPOS="617" WIDTH="1782" HEIGHT="2628"><TextLine ID="mz_1-177_l1" HPOS="955" VPOS="617" WIDTH="622" HEIGHT="54" BASELINE="957 649 1577 653" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1566 617 973 617 957 640 957 649 955 666 1572 671 1577 653 1575 625 1566 617"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l2" HPOS="2058" VPOS="625" WIDTH="86" HEIGHT="54" BASELINE="2060 662 2144 666" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2125 630 2103 630 2081 628 2060 625 2060 662 2058 675 2140 679 2144 666 2144 632 2125 630"/>
                        </Shape>
                        <String CONTENT="135"/>
                    </TextLine>
<TextLine ID="mz_1-177_l3" HPOS="485" VPOS="727" WIDTH="1670" HEIGHT="52" BASELINE="485 762 2155 762" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="485 762 485 779 2155 779 2155 762 2155 731 485 727 485 762"/>
                        </Shape>
                        <String CONTENT="The later the season, the better is the meat, because the animals are no"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l4" HPOS="377" VPOS="779" WIDTH="1771" HEIGHT="67" BASELINE="379 822 2148 827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 822 377 831 407 844 409 844 412 846 2146 846 2148 827 2146 794 1995 781 1993 781 1941 792 1746 781 1744 781 1676 792 1616 781 1614 781 1369 792 1263 779 1261 779 1258 779 1235 792 1126 792 1111 779 1109 779 1107 779 1105 779 1025 790 379 783 379 822"/>
                        </Shape>
                        <String CONTENT="longer worried by insects, and can feed undisturbed. The meat of young"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l5" HPOS="379" VPOS="840" WIDTH="1774" HEIGHT="60" BASELINE="379 883 2153 883" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 883 379 900 2153 900 2153 883 2153 851 2116 840 2114 840 2112 840 2109 840 2084 851 2047 840 2045 840 2042 840 2040 840 2008 851 1910 840 1908 840 1815 851 1787 840 1785 840 1782 840 1780 840 1756 851 1731 840 1728 840 1726 840 1724 840 1679 851 1633 840 1631 840 1629 840 1540 851 1501 840 1499 840 1497 840 1393 851 1362 840 1360 840 1358 840 1222 851 1187 840 1185 840 1183 840 1087 851 1057 840 1055 840 1053 840 1050 840 1048 840 1033 853 947 853 821 840 819 840 756 851 734 840 732 840 576 840 574 840 572 840 550 851 516 840 513 840 511 840 509 840 487 851 438 840 435 840 379 851 379 883"/>
                        </Shape>
                        <String CONTENT="animals killed in midsummer is so lean and tasteless, that it is really only fit"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l6" HPOS="379" VPOS="900" WIDTH="1772" HEIGHT="59" BASELINE="379 941 2151 941" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 941 379 959 2151 959 2151 941 2151 913 2099 900 2097 900 2094 900 2064 911 1969 900 1967 900 1964 900 1941 911 1811 900 1696 900 1694 900 1692 900 1689 900 1672 913 1440 913 1425 900 1423 900 1421 900 1419 900 1416 900 1388 911 1367 900 1365 900 1362 900 1360 900 1315 911 1293 900 1291 900 1289 900 1219 913 1066 913 1042 900 1040 900 1038 900 981 911 955 900 953 900 951 900 847 911 795 900 793 900 726 911 669 900 667 900 617 911 604 900 602 900 600 900 598 900 379 909 379 941"/>
                        </Shape>
                        <String CONTENT="for dog-food. The buck-skins are valued for summer bedding and as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l7" HPOS="377" VPOS="963" WIDTH="1774" HEIGHT="56" BASELINE="379 998 2151 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 998 377 1013 2146 1019 2151 1004 2148 974 379 963 379 998"/>
                        </Shape>
                        <String CONTENT="best material for curried leather. The fawn-skins, on the contrary, are poor,"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l8" HPOS="377" VPOS="1028" WIDTH="1774" HEIGHT="56" BASELINE="379 1058 2151 1063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1058 377 1076 390 1084 392 1084 394 1084 396 1084 2148 1076 2151 1063 2148 1032 379 1028 379 1058"/>
                        </Shape>
                        <String CONTENT="since the hunter cannot choose his own time for killing. Only the poorest"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l9" HPOS="379" VPOS="1078" WIDTH="1772" HEIGHT="65" BASELINE="379 1119 2151 1123" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1119 379 1143 2148 1136 2151 1123 2151 1093 2105 1080 2103 1080 2101 1080 2042 1091 1982 1080 1980 1080 1977 1080 1943 1091 1588 1080 1585 1080 1583 1080 1544 1091 1479 1080 1477 1080 1475 1080 1473 1080 1455 1091 1365 1080 1362 1080 1360 1080 1317 1091 1202 1078 1200 1078 1109 1091 856 1091 814 1078 812 1078 810 1078 808 1078 780 1089 689 1078 687 1078 685 1078 654 1091 531 1091 507 1078 505 1078 503 1078 379 1086 379 1119"/>
                        </Shape>
                        <String CONTENT="people use them for garments, while all others buy fawn-skins from the rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l10" HPOS="379" VPOS="1145" WIDTH="312" HEIGHT="54" BASELINE="381 1177 691 1182" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1177 379 1195 687 1199 691 1182 689 1149 381 1145 381 1177"/>
                        </Shape>
                        <String CONTENT="deer-breeders."/>
                    </TextLine>
<TextLine ID="mz_1-177_l11" HPOS="487" VPOS="1199" WIDTH="1664" HEIGHT="61" BASELINE="487 1242 2151 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2148 1210 2099 1199 2097 1199 2027 1210 1787 1199 1785 1199 1782 1199 1756 1210 1707 1199 1705 1199 1702 1199 1679 1210 1653 1199 1650 1199 1648 1199 1646 1199 1616 1212 1445 1212 1356 1199 1354 1199 1256 1210 1239 1199 1237 1199 1235 1199 1122 1199 1120 1199 1055 1210 1003 1199 1001 1199 918 1210 871 1199 869 1199 866 1199 741 1210 708 1199 706 1199 704 1199 633 1210 602 1199 600 1199 598 1199 596 1199 557 1210 513 1199 511 1199 509 1199 507 1199 487 1208 487 1242 487 1260 2151 1260 2151 1242 2151 1219 2148 1210"/>
                        </Shape>
                        <String CONTENT="At the places where the migrating reindeer crossed the Kolyma and its"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l12" HPOS="379" VPOS="1260" WIDTH="1767" HEIGHT="58" BASELINE="379 1301 2146 1301" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1301 379 1318 2144 1318 2146 1301 2146 1273 2120 1260 2118 1260 2116 1260 2114 1260 2084 1271 2053 1260 2051 1260 2049 1260 2047 1260 2021 1271 1999 1260 1997 1260 1995 1260 1993 1260 1964 1271 953 1260 951 1260 949 1260 918 1271 856 1260 853 1260 851 1260 823 1271 715 1260 713 1260 710 1260 676 1271 630 1260 628 1260 626 1260 624 1260 622 1260 604 1273 479 1273 420 1260 418 1260 416 1260 379 1271 379 1301"/>
                        </Shape>
                        <String CONTENT="affluents, the Yukaghir inhabitants used to set long rows of snares on both"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l13" HPOS="383" VPOS="1322" WIDTH="1763" HEIGHT="57" BASELINE="383 1364 2146 1364" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1364 383 1379 2146 1379 2146 1364 2146 1333 383 1322 383 1364"/>
                        </Shape>
                        <String CONTENT="banks of the river, spreading them out on the trees and among the bushes."/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l14" HPOS="383" VPOS="1383" WIDTH="1765" HEIGHT="56" BASELINE="383 1422 2148 1422" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1422 383 1439 2148 1439 2148 1422 2148 1392 383 1383 383 1422"/>
                        </Shape>
                        <String CONTENT="These were still more efficient than hunting on the water; but bush and forest"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l15" HPOS="377" VPOS="1437" WIDTH="1765" HEIGHT="65" BASELINE="379 1478 2142 1485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1478 377 1494 388 1502 390 1502 392 1502 394 1502 2140 1498 2142 1485 2140 1455 2073 1442 1921 1442 1919 1442 1917 1442 1893 1452 1878 1442 1876 1442 1873 1442 1871 1442 1687 1452 1666 1442 1663 1442 1661 1442 1523 1450 1460 1439 1458 1439 1397 1452 979 1452 879 1437 877 1437 875 1437 849 1448 786 1437 784 1437 782 1437 754 1448 700 1437 697 1437 379 1446 379 1478"/>
                        </Shape>
                        <String CONTENT="on the Middle Anadyr are too scanty to allow of this method of hunting."/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l16" HPOS="381" VPOS="1500" WIDTH="1770" HEIGHT="58" BASELINE="381 1543 2151 1543" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1543 381 1558 2151 1558 2151 1543 2151 1513 2040 1500 2038 1500 1986 1511 1915 1500 1912 1500 1834 1511 1382 1500 1380 1500 1297 1511 1267 1500 1265 1500 1263 1500 1261 1500 1224 1511 1133 1500 1131 1500 1033 1511 892 1500 890 1500 888 1500 862 1511 760 1500 758 1500 708 1511 678 1500 676 1500 674 1500 542 1511 494 1500 492 1500 490 1500 487 1500 448 1511 405 1500 403 1500 401 1500 399 1500 396 1500 381 1509 381 1543"/>
                        </Shape>
                        <String CONTENT="At the mouth of the Kolyma, where the migration of reindeer still continues"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l17" HPOS="375" VPOS="1569" WIDTH="1771" HEIGHT="52" BASELINE="377 1602 2146 1606" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1602 375 1613 2142 1621 2146 1606 2144 1574 377 1569 377 1602"/>
                        </Shape>
                        <String CONTENT="to some extent, a few score reindeer are killed every summer on the water,"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l18" HPOS="375" VPOS="1621" WIDTH="1600" HEIGHT="59" BASELINE="377 1665 1975 1660" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1665 377 1680 1973 1675 1975 1660 1971 1630 448 1621 446 1621 375 1632 377 1665"/>
                        </Shape>
                        <String CONTENT="and in some places single snares are still spread on the reindeer-trail."/>
                    </TextLine>
<TextLine ID="mz_1-177_l19" HPOS="490" VPOS="1684" WIDTH="1658" HEIGHT="54" BASELINE="490 1721 2148 1721" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="490 1721 490 1738 2148 1738 2148 1721 2148 1691 490 1684 490 1721"/>
                        </Shape>
                        <String CONTENT="The frame of the kayak used by the Chukchee for hunting reindeer on"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l20" HPOS="375" VPOS="1751" WIDTH="1773" HEIGHT="52" BASELINE="375 1784 2148 1784" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1784 375 1803 2148 1803 2148 1784 2148 1751 375 1751 375 1784"/>
                        </Shape>
                        <String CONTENT="the rivers (Fig. 47, b) is similar to the common Eskimo form, but it is covered"/>
                    </TextLine>
<TextLine ID="mz_1-177_l21" HPOS="375" VPOS="2572" WIDTH="1773" HEIGHT="60" BASELINE="377 2617 2148 2613" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2617 377 2632 2146 2628 2148 2613 2144 2585 2084 2572 2081 2572 2079 2572 2051 2583 1843 2572 1841 2572 1750 2583 1728 2572 1726 2572 1724 2572 1722 2572 1679 2583 1648 2572 1646 2572 1644 2572 1642 2572 1611 2583 1581 2572 1579 2572 1577 2572 1575 2572 1553 2583 1527 2572 1525 2572 1523 2572 1388 2583 1323 2572 1321 2572 1258 2585 1226 2574 1224 2574 1222 2574 981 2585 955 2574 953 2574 951 2574 949 2574 912 2585 817 2574 814 2574 812 2574 782 2585 710 2574 708 2574 706 2574 704 2574 687 2585 548 2574 546 2574 481 2585 416 2574 414 2574 412 2574 375 2587 377 2617"/>
                        </Shape>
                        <String CONTENT="with reindeer-skin instead of seal-skin. The manhole in the middle remains"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l22" HPOS="377" VPOS="2647" WIDTH="1767" HEIGHT="48" BASELINE="377 2678 2144 2678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2678 377 2695 2142 2695 2144 2678 2142 2647 377 2647 377 2678"/>
                        </Shape>
                        <String CONTENT="open, because there is no need of making it water-tight for use on the river."/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l23" HPOS="381" VPOS="2697" WIDTH="1767" HEIGHT="57" BASELINE="381 2738 2148 2738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2738 381 2754 2146 2754 2148 2738 2146 2708 381 2697 381 2738"/>
                        </Shape>
                        <String CONTENT="The kayak is employed because of its lightness as compared to that of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l24" HPOS="375" VPOS="2754" WIDTH="1771" HEIGHT="62" BASELINE="377 2799 2146 2795" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2799 377 2816 2144 2812 2146 2795 2142 2764 1261 2754 1258 2754 1256 2754 1254 2754 1237 2764 481 2756 479 2756 375 2767 377 2799"/>
                        </Shape>
                        <String CONTENT="wooden canoes of the Russianized Yukaghir. The type of the Maritime Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l25" HPOS="377" VPOS="2823" WIDTH="1769" HEIGHT="52" BASELINE="377 2857 2146 2857" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2857 377 2875 2146 2875 2146 2857 2146 2827 377 2823 377 2857"/>
                        </Shape>
                        <String CONTENT="kayak is represented in Fig. 47, c. The double paddle (Fig. 47, a) is similar"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l26" HPOS="375" VPOS="2873" WIDTH="1769" HEIGHT="65" BASELINE="377 2918 2144 2914" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2918 377 2933 2140 2938 2144 2914 2142 2883 2122 2873 2120 2873 2118 2873 2116 2873 2114 2873 2090 2886 1919 2886 1902 2873 1899 2873 1897 2873 1895 2873 1893 2873 1891 2873 1873 2886 1663 2886 1579 2873 1577 2873 1477 2883 1449 2873 1447 2873 1445 2873 1442 2873 1399 2883 1356 2873 1354 2873 1352 2873 1349 2873 1347 2873 1332 2886 1219 2886 594 2875 591 2875 589 2875 546 2886 466 2875 464 2875 461 2875 431 2886 396 2875 394 2875 392 2875 390 2875 388 2875 375 2883 377 2918"/>
                        </Shape>
                        <String CONTENT="to that of the Yukaghir, and has a stem that is straight or somewhat curved,"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l27" HPOS="379" VPOS="2935" WIDTH="1767" HEIGHT="68" BASELINE="379 2977 2146 2977" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 2977 379 2992 845 2992 914 3003 916 3003 988 2992 1074 2992 1089 3003 1092 3003 1094 3003 1096 3003 2144 2990 2146 2977 2144 2948 2092 2935 2090 2935 2040 2946 2023 2935 2021 2935 2019 2935 2016 2935 2014 2935 1982 2946 1551 2935 1549 2935 1494 2946 1453 2935 1451 2935 1449 2935 1399 2946 1367 2935 1365 2935 1362 2935 1360 2935 1332 2946 1230 2935 1228 2935 1076 2946 1046 2935 1044 2935 1042 2935 923 2946 877 2935 875 2935 873 2935 799 2946 771 2935 769 2935 767 2935 765 2935 719 2946 685 2935 682 2935 680 2935 678 2935 643 2946 511 2935 509 2935 507 2935 479 2946 420 2935 418 2935 416 2935 379 2946 379 2977"/>
                        </Shape>
                        <String CONTENT="with blades in the shape of a poplar-leaf. In shallow waters two slender"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l28" HPOS="377" VPOS="2996" WIDTH="1771" HEIGHT="56" BASELINE="377 3037 2148 3037" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 3037 377 3052 2148 3052 2148 3037 2148 3009 1640 2996 1637 2996 1635 2996 1633 2996 1616 3007 1592 2996 1590 2996 1588 2996 1391 3007 1300 2996 1297 2996 1295 2996 1293 2996 1276 3009 1133 3009 1102 2996 1100 2996 1098 2996 947 3007 908 2996 905 2996 903 2996 901 2996 899 2996 882 3009 665 3009 561 2996 559 2996 503 3007 420 2996 418 2996 416 2996 377 3007 377 3037"/>
                        </Shape>
                        <String CONTENT="sticks about 150 cm. long and 1 cm. thick are used, both with the dug-out"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l29" HPOS="375" VPOS="3063" WIDTH="1769" HEIGHT="61" BASELINE="377 3093 2144 3098" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 3093 375 3109 1410 3124 1412 3124 2142 3113 2144 3098 2142 3067 377 3063 377 3093"/>
                        </Shape>
                        <String CONTENT="and with the skin canoe, for punting. The sporadic occurrence of the kayak"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l30" HPOS="375" VPOS="3128" WIDTH="1771" HEIGHT="43" BASELINE="375 3156 2146 3156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 3156 375 3171 2146 3171 2146 3156 2146 3128 375 3128 375 3156"/>
                        </Shape>
                        <String CONTENT="all along the Asiatic shore is very curious. It exists on the Arctic, then"/>
                    </TextLine>

                    <TextLine ID="mz_1-177_l31" HPOS="373" VPOS="3176" WIDTH="1771" HEIGHT="69" BASELINE="375 3215 2144 3210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 3215 375 3234 1217 3245 1219 3245 1287 3234 2019 3243 2021 3243 2144 3230 2144 3210 2140 3184 407 3176 405 3176 403 3176 373 3187 375 3215"/>
                        </Shape>
                        <String CONTENT="almost disappears on the Pacific, again appears on the waters of the Middle"/>
                    </TextLine>
