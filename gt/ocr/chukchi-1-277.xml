                        <Shape>
                            <Polygon POINTS="355 2494 355 2509 1674 2498 1676 2483 1672 2455 1455 2442 1453 2442 1451 2442 1408 2455 1397 2444 1395 2444 1393 2444 1391 2444 1278 2455 1222 2444 1219 2444 1217 2444 1180 2455 1148 2444 1146 2444 1144 2444 1141 2444 1139 2444 1139 2446 1131 2455 1122 2448 1122 2446 1120 2446 1118 2446 1115 2446 1113 2446 1089 2459 936 2459 908 2446 905 2446 903 2446 901 2446 899 2446 875 2459 368 2450 366 2450 364 2450 362 2450 362 2453 353 2459 355 2494"/>
                        </Shape>
                        <String CONTENT="frames quite similar to those used in Alaska.¹ Cords are"/>
                    </TextLine>

                    <TextLine ID="mz_1-277_l33" HPOS="353" VPOS="2500" WIDTH="1321" HEIGHT="76" BASELINE="355 2557 1674 2544" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2557 355 2576 988 2576 988 2574 1085 2563 1200 2572 1202 2572 1274 2561 1449 2570 1451 2570 1453 2570 1486 2559 1655 2567 1657 2567 1659 2567 1661 2567 1674 2557 1674 2544 1670 2513 1533 2500 1531 2500 1529 2500 1527 2500 1527 2502 1516 2511 1401 2502 1399 2502 1332 2513 1310 2502 1308 2502 1306 2502 1304 2502 1302 2502 1287 2513 1265 2502 1263 2502 1261 2502 1258 2502 1228 2515 1144 2505 1141 2505 1139 2505 1137 2505 1137 2507 1126 2518 1055 2518 1031 2505 1029 2505 1027 2505 1025 2505 1022 2505 1007 2518 957 2507 955 2507 953 2507 951 2507 938 2520 819 2520 795 2507 793 2507 791 2507 788 2507 754 2520 669 2509 667 2509 353 2524 355 2557"/>
                        </Shape>
                        <String CONTENT="passed through holes cut in the edge of the skin. When"/>
                    </TextLine>

