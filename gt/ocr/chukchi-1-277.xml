                    <TextLine ID="mz_1-277_l31" HPOS="353" VPOS="2390" WIDTH="1323" HEIGHT="56" BASELINE="355 2433 1676 2424" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2433 355 2446 1674 2437 1676 2424 1672 2396 685 2390 682 2390 680 2390 639 2401 422 2392 420 2392 353 2403 355 2433"/>
                        </Shape>
                        <String CONTENT="and walrus skins are stretched with cords on rectangular"/>
