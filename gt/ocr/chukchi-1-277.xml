                        </Shape>
                        <String CONTENT="Reindeer-skins are stretched on the ground, and their"/>
                    </TextLine>

                    <TextLine ID="mz_1-277_l28" HPOS="351" VPOS="2210" WIDTH="1323" HEIGHT="59" BASELINE="353 2253 1674 2243" TAGREFS="TYPE_6">
