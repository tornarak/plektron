                        </Shape>
                        <String CONTENT="of two sticks tied at their tops in such a way that they"/>
                    </TextLine>

                    <TextLine ID="mz_1-277_l21" HPOS="349" VPOS="1790" WIDTH="1317" HEIGHT="69" BASELINE="351 1833 1666 1823" TAGREFS="TYPE_6">
                        <Shape>
