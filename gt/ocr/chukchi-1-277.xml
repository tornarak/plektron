                        <Shape>
                            <Polygon POINTS="459 1714 459 1732 2120 1719 2120 1701 2114 1667 457 1675 459 1714"/>
                        </Shape>
                        <String CONTENT="The drying-rack in use among all the tribes of northeastern Asia is formed"/>
