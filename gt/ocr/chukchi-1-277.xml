                    <TextLine ID="mz_1-277_l18" HPOS="347" VPOS="1608" WIDTH="1745" HEIGHT="63" BASELINE="349 1652 2092 1641" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="349 1652 349 1671 2090 1660 2092 1641 2088 1613 697 1608 695 1608 693 1608 669 1619 477 1610 474 1610 347 1621 349 1652"/>
