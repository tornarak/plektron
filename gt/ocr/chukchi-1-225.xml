                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-225_l2" HPOS="2097" VPOS="619" WIDTH="62" HEIGHT="65" BASELINE="2097 662 2159 662" TAGREFS="TYPE_5">
