                        <Shape>
                            <Polygon POINTS="376 2745 376 2760 517 2771 519 2771 617 2758 760 2766 762 2766 764 2766 796 2756 926 2764 929 2764 1017 2753 1355 2762 1357 2762 1360 2762 1362 2762 1381 2749 1401 2760 1403 2760 1405 2760 1472 2749 1535 2760 1537 2760 1667 2758 1669 2758 1671 2758 1684 2747 1741 2758 1743 2758 1821 2745 1847 2756 1849 2756 1851 2756 2143 2747 2146 2725 2141 2697 1962 2686 1959 2686 1957 2686 1955 2686 1940 2697 1749 2688 1747 2688 1745 2688 1713 2699 1648 2691 1645 2691 374 2710 376 2745"/>
                        </Shape>
                        <String CONTENT="is espied, two or three of the best dogs are released. The bear is easily"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l38" HPOS="376" VPOS="2756" WIDTH="1772" HEIGHT="64" BASELINE="378 2803 2148 2790" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 2803 378 2820 2146 2808 2148 2790 2143 2762 1292 2756 1290 2756 1288 2756 1247 2766 1007 2758 1004 2758 1002 2758 963 2769 723 2760 721 2760 376 2773 378 2803"/>
                        </Shape>
                        <String CONTENT="overtaken by them, and, when held at bay, is speared with a lance, or shot"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-183_r7" HPOS="380" VPOS="2845" WIDTH="1778" HEIGHT="352" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="380 2845 2158 2845 2158 3197 380 3197"/>
                    </Shape>
                    <TextLine ID="mz_1-183_l39" HPOS="482" VPOS="2842" WIDTH="1666" HEIGHT="59" BASELINE="485 2883 2148 2868" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 2883 485 2901 2146 2885 2148 2868 2141 2842 482 2855 485 2883"/>
                        </Shape>
                        <String CONTENT="¹ Its name in Chukchee is waˊpak, which means literally “fly-agaric” (an intoxicating mushroom). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l40" HPOS="378" VPOS="2885" WIDTH="1768" HEIGHT="59" BASELINE="381 2927 2146 2911" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2927 381 2944 2143 2929 2146 2911 2139 2885 378 2898 381 2927"/>
                        </Shape>
                        <String CONTENT="Chukchee and the Koryak are very fond of this mushroom; and when they find it in the woods, they pick it"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l41" HPOS="378" VPOS="2929" WIDTH="1772" HEIGHT="56" BASELINE="381 2970 2150 2955" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2970 381 2985 2148 2976 2150 2955 2143 2929 378 2942 381 2970"/>
                        </Shape>
                        <String CONTENT="off just as eagerly as the wolves snatch after the greased whalebone spits. The Chukchee believe, moreover,"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l42" HPOS="378" VPOS="2968" WIDTH="1768" HEIGHT="63" BASELINE="381 3011 2146 2994" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 3011 381 3031 2143 3013 2146 2994 2139 2968 378 2983 381 3011"/>
                        </Shape>
                        <String CONTENT="that mice, when gathering roots for the winter, bring in some unknown intoxicating herbs which they use in"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l43" HPOS="381" VPOS="3013" WIDTH="1767" HEIGHT="65" BASELINE="383 3054 2148 3039" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 3054 383 3078 2148 3056 2148 3039 2141 3013 381 3026 383 3054"/>
                        </Shape>
                        <String CONTENT="their ceremonials. These herbs also serve to protect their stores from intruders, because they are said to act"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l44" HPOS="381" VPOS="3052" WIDTH="1765" HEIGHT="63" BASELINE="383 3098 2146 3078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 3098 383 3115 2143 3095 2146 3078 2139 3052 381 3069 383 3098"/>
                        </Shape>
                        <String CONTENT="as poison on most other animals, including man. These herbs are called by a name derived from that of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l45" HPOS="378" VPOS="3095" WIDTH="1768" HEIGHT="61" BASELINE="381 3139 2146 3121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 3139 381 3156 2143 3141 2146 3121 2139 3095 378 3111 381 3139"/>
                        </Shape>
                        <String CONTENT="intoxicating mushroom, — êˊlhɪ-waˊpak (“white agaric”), — and a similar name is given to the whalebone spit"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l46" HPOS="381" VPOS="3145" WIDTH="1022" HEIGHT="52" BASELINE="383 3180 1403 3171" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 3180 383 3197 1403 3191 1403 3171 1396 3145 381 3152 383 3180"/>
                        </Shape>
                        <String CONTENT="on account of its power of killing the animal that swallowed it."/>
                    </TextLine>
