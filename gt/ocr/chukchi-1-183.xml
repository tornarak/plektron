                    <TextLine ID="mz_1-183_l37" HPOS="353" VPOS="2671" WIDTH="1772" HEIGHT="85" BASELINE="355 2730 2125 2710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2730 355 2745 496 2756 498 2756 596 2743 739 2751 741 2751 743 2751 775 2741 905 2749 908 2749 996 2738 1334 2747 1336 2747 1339 2747 1341 2747 1360 2734 1380 2745 1382 2745 1384 2745 1451 2734 1514 2745 1516 2745 1646 2743 1648 2743 1650 2743 1663 2732 1720 2743 1722 2743 1800 2730 1826 2741 1828 2741 1830 2741 2122 2732 2125 2710 2120 2682 1941 2671 1938 2671 1936 2671 1934 2671 1919 2682 1728 2673 1726 2673 1724 2673 1692 2684 1627 2676 1624 2676 353 2695 355 2730"/>
                        </Shape>
                        <String CONTENT="is espied, two or three of the best dogs are released. The bear is easily"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l38" HPOS="355" VPOS="2741" WIDTH="1772" HEIGHT="64" BASELINE="357 2788 2127 2775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2788 357 2805 2125 2793 2127 2775 2122 2747 1271 2741 1269 2741 1267 2741 1226 2751 986 2743 983 2743 981 2743 942 2754 702 2745 700 2745 355 2758 357 2788"/>
                        </Shape>
                        <String CONTENT="overtaken by them, and, when held at bay, is speared with a lance, or shot"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-183_r7" HPOS="359" VPOS="2830" WIDTH="1778" HEIGHT="352" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="359 2830 2137 2830 2137 3182 359 3182"/>
                    </Shape>
                    <TextLine ID="mz_1-183_l39" HPOS="461" VPOS="2827" WIDTH="1666" HEIGHT="59" BASELINE="464 2868 2127 2853" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 2868 464 2886 2125 2870 2127 2853 2120 2827 461 2840 464 2868"/>
                        </Shape>
                        <String CONTENT="¹ Its name in Chukchee is waˊpak, which means literally “fly-agaric” (an intoxicating mushroom). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l40" HPOS="357" VPOS="2870" WIDTH="1768" HEIGHT="59" BASELINE="360 2912 2125 2896" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2912 360 2929 2122 2914 2125 2896 2118 2870 357 2883 360 2912"/>
                        </Shape>
                        <String CONTENT="Chukchee and the Koryak are very fond of this mushroom; and when they find it in the woods, they pick it"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l41" HPOS="357" VPOS="2914" WIDTH="1772" HEIGHT="56" BASELINE="360 2955 2129 2940" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2955 360 2970 2127 2961 2129 2940 2122 2914 357 2927 360 2955"/>
                        </Shape>
                        <String CONTENT="off just as eagerly as the wolves snatch after the greased whalebone spits. The Chukchee believe, moreover,"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l42" HPOS="357" VPOS="2953" WIDTH="1768" HEIGHT="63" BASELINE="360 2996 2125 2979" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2996 360 3016 2122 2998 2125 2979 2118 2953 357 2968 360 2996"/>
                        </Shape>
                        <String CONTENT="that mice, when gathering roots for the winter, bring in some unknown intoxicating herbs which they use in"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l43" HPOS="360" VPOS="2998" WIDTH="1767" HEIGHT="65" BASELINE="362 3039 2127 3024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 3039 362 3063 2127 3041 2127 3024 2120 2998 360 3011 362 3039"/>
                        </Shape>
                        <String CONTENT="their ceremonials. These herbs also serve to protect their stores from intruders, because they are said to act"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l44" HPOS="360" VPOS="3037" WIDTH="1765" HEIGHT="63" BASELINE="362 3083 2125 3063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 3083 362 3100 2122 3080 2125 3063 2118 3037 360 3054 362 3083"/>
                        </Shape>
                        <String CONTENT="as poison on most other animals, including man. These herbs are called by a name derived from that of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l45" HPOS="357" VPOS="3080" WIDTH="1768" HEIGHT="61" BASELINE="360 3124 2125 3106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 3124 360 3141 2122 3126 2125 3106 2118 3080 357 3096 360 3124"/>
                        </Shape>
                        <String CONTENT="intoxicating mushroom, — êˊlhɪ-waˊpak (“white agaric”), — and a similar name is given to the whalebone spit"/>
                    </TextLine>

                    <TextLine ID="mz_1-183_l46" HPOS="360" VPOS="3130" WIDTH="1022" HEIGHT="52" BASELINE="362 3165 1382 3156" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 3165 362 3182 1382 3176 1382 3156 1375 3130 360 3137 362 3165"/>
                        </Shape>
                        <String CONTENT="on account of its power of killing the animal that swallowed it."/>
                    </TextLine>
