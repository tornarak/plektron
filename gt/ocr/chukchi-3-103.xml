                        </Shape>
                        <String CONTENT="In other Maritime villages we were occasionally detained by a snow-storm"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l32" HPOS="397" VPOS="2283" WIDTH="1772" HEIGHT="56" BASELINE="399 2326 2169 2322" TAGREFS="TYPE_5">
