                        </Shape>
                        <String CONTENT="for several days. All fuel had been consumed. We fed on raw walrus-meat."/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l33" HPOS="399" VPOS="2341" WIDTH="1770" HEIGHT="59" BASELINE="401 2386 2169 2378" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 2386 401 2400 2167 2396 2169 2378 2167 2353 2130 2341 2128 2341 2126 2341 2124 2341 2087 2351 2024 2341 2022 2341 2020 2341 2019 2341 2003 2353 1868 2353 1812 2341 1810 2341 1707 2355 1531 2355 1502 2343 1500 2343 1498 2343 1434 2355 399 2355 401 2386"/>
                        </Shape>
                        <String CONTENT="Still some fire was necessary to melt snow and to prepare the tea. In the"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l34" HPOS="399" VPOS="2406" WIDTH="1772" HEIGHT="54" BASELINE="401 2447 2171 2439" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 2447 401 2460 2169 2454 2171 2439 2167 2411 843 2406 841 2406 399 2417 401 2447"/>
                        </Shape>
                        <String CONTENT="more southern villages, on the coast of the Pacific Ocean cooking is done"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l35" HPOS="401" VPOS="2462" WIDTH="1771" HEIGHT="57" BASELINE="403 2505 2172 2501" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 2505 403 2519 2171 2515 2172 2501 2165 2462 2124 2472 1650 2462 1648 2462 1588 2472 1553 2462 1551 2462 1549 2462 1473 2472 1424 2462 1422 2462 1420 2462 1379 2472 1321 2462 1319 2462 1266 2474 1219 2464 1218 2464 1143 2474 736 2464 734 2464 557 2474 506 2464 504 2464 401 2476 403 2505"/>
                        </Shape>
                        <String CONTENT="mostly, not with blubber, but with twigs from low bushes, small pieces of"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l36" HPOS="399" VPOS="2523" WIDTH="1772" HEIGHT="58" BASELINE="401 2563 2171 2558" TAGREFS="TYPE_5">
