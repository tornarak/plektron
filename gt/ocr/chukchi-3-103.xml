                        <Shape>
                            <Polygon POINTS="407 2084 407 2098 2167 2100 2169 2084 2167 2047 407 2051 407 2084"/>
                        </Shape>
                        <String CONTENT="“Enough for our wants, but too little for the passers-by.” Then they would"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l29" HPOS="399" VPOS="2104" WIDTH="1768" HEIGHT="58" BASELINE="401 2146 2167 2141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 2146 401 2162 2165 2156 2167 2141 2163 2113 1590 2104 1588 2104 1586 2104 1584 2104 1570 2113 1011 2106 1009 2106 900 2115 465 2107 463 2107 399 2117 401 2146"/>
                        </Shape>
                        <String CONTENT="undertake some extra hunting in order to increase their supply; but no com-"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l30" HPOS="399" VPOS="2168" WIDTH="933" HEIGHT="60" BASELINE="401 2207 1332 2203" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 2207 401 2228 535 2219 1329 2219 1332 2203 1329 2176 428 2168 426 2168 424 2168 399 2176 401 2207"/>
                        </Shape>
                        <String CONTENT="plaint was ever uttered by any of them."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-103_r3" HPOS="391" VPOS="2231" WIDTH="1782" HEIGHT="780" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="391 2231 2173 2231 2173 3011 391 3011"/>
                    </Shape>
                    <TextLine ID="mz_3-103_l31" HPOS="506" VPOS="2220" WIDTH="1663" HEIGHT="61" BASELINE="508 2267 2169 2261" TAGREFS="TYPE_5">
                        <Shape>
