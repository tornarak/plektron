                        </Shape>
                        <String CONTENT="few reindeer-breeders who live near the seacoast, scattered here and there"/>
                    </TextLine>

                    <TextLine ID="mz_3-103_l42" HPOS="399" VPOS="2881" WIDTH="1773" HEIGHT="59" BASELINE="401 2924 2172 2920" TAGREFS="TYPE_5">
