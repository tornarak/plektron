                    </TextLine>

                    <TextLine ID="mz_1-182_l21" HPOS="580" VPOS="2942" WIDTH="1767" HEIGHT="60" BASELINE="582 2983 2347 2989" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="582 2983 580 2996 2343 3002 2347 2989 2347 2959 2302 2946 2299 2946 2297 2946 2295 2946 2263 2957 2247 2946 2245 2946 2243 2946 2241 2946 2048 2957 2003 2946 2001 2946 1998 2946 1996 2946 1994 2946 1979 2959 1760 2959 1721 2944 1719 2944 1717 2944 1652 2955 1494 2944 1492 2944 1440 2955 1416 2944 1414 2944 1412 2944 1303 2955 1288 2944 1286 2944 1284 2944 1282 2944 1279 2944 1256 2953 1167 2942 1165 2942 1162 2942 1134 2953 1095 2942 1093 2942 1091 2942 1089 2942 1061 2953 970 2942 968 2942 881 2953 582 2944 582 2983"/>
