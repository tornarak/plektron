                        </Shape>
                        <String CONTENT="kɪlhɪˊnkɪn (“fifteen”) is probably contracted from g̣ɪtkaˊlhɪkên (“belonging to"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l24" HPOS="757" VPOS="1987" WIDTH="1772" HEIGHT="61" BASELINE="757 2030 2529 2030" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 2030 757 2048 2529 2048 2529 2030 2529 1996 2427 1987 2425 1987 2423 1987 2399 1998 2373 1987 2371 1987 2369 1987 2237 1998 2174 1987 2172 1987 2169 1987 2135 1998 2105 1987 2102 1987 2100 1987 2098 1987 2096 1987 2081 2000 1834 2000 1801 1987 1799 1987 1797 1987 1739 1998 1706 1987 1704 1987 1702 1987 1700 1987 1697 1987 1682 1998 1639 1987 1637 1987 1635 1987 1580 1998 1524 1987 1522 1987 1520 1987 1489 1998 1461 1987 1459 1987 1457 1987 1455 1987 1420 1998 1388 1987 1386 1987 1383 1987 1381 1987 1379 1987 1364 2000 1266 2000 1208 1987 1206 1987 1204 1987 1171 1998 1046 1987 1043 1987 981 1998 942 1987 939 1987 937 1987 935 1987 896 1998 868 1987 866 1987 864 1987 861 1987 816 1998 786 1987 783 1987 781 1987 779 1987 757 1998 757 2030"/>
                        </Shape>
                        <String CONTENT="the foot”); qliˊkkin (“twenty”) signifies “belonging to a man.” The word qlaˊul"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l25" HPOS="755" VPOS="2045" WIDTH="1774" HEIGHT="72" BASELINE="757 2093 2529 2089" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 2093 757 2106 1455 2117 1457 2117 1459 2117 1461 2117 1476 2106 2527 2106 2529 2089 2527 2058 2501 2045 2499 2045 2496 2045 2494 2045 2473 2056 2351 2045 2349 2045 2347 2045 2317 2058 2204 2058 2187 2045 2185 2045 2182 2045 2180 2045 2178 2045 2154 2056 1585 2048 1583 2048 1580 2048 1578 2048 1563 2058 1509 2048 1507 2048 1505 2048 1476 2058 1437 2048 1435 2048 1433 2048 1381 2058 1212 2048 1210 2048 1102 2058 1043 2048 1041 2048 1039 2048 996 2058 981 2048 978 2048 976 2048 773 2048 770 2048 768 2048 766 2048 755 2056 757 2093"/>
                        </Shape>
                        <String CONTENT="(“man”) is also used frequently for “twenty.” The fingers and toes play such"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l26" HPOS="757" VPOS="2106" WIDTH="1770" HEIGHT="63" BASELINE="760 2152 2527 2147" TAGREFS="TYPE_5">
                        <Shape>
