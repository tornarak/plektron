                    <TextLine ID="mz_1-072_l31" HPOS="868" VPOS="2411" WIDTH="1665" HEIGHT="54" BASELINE="868 2448 2533 2448" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="868 2448 868 2465 2533 2465 2533 2448 2531 2411 868 2411 868 2448"/>
                        </Shape>
                        <String CONTENT="This term is also applied by a few rich traders to express the idea of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l32" HPOS="764" VPOS="2476" WIDTH="1765" HEIGHT="50" BASELINE="764 2507 2529 2507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 2507 764 2526 2529 2526 2529 2507 2529 2478 764 2476 764 2507"/>
                        </Shape>
                        <String CONTENT="“one thousand.” Many of the people, especially the Reindeer men, are unable"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l33" HPOS="755" VPOS="2535" WIDTH="1772" HEIGHT="56" BASELINE="757 2565 2527 2569" TAGREFS="TYPE_5">
