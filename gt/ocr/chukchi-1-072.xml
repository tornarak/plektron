                        </Shape>
                        <String CONTENT="to make a calculation without them. The larger numbers are composed of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l28" HPOS="757" VPOS="2225" WIDTH="1770" HEIGHT="69" BASELINE="760 2273 2527 2266" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2273 760 2294 2525 2281 2527 2266 2522 2238 2447 2225 2445 2225 2442 2225 2440 2225 2423 2238 2228 2238 2187 2225 2185 2225 2182 2225 2180 2225 2148 2236 2102 2225 2100 2225 2098 2225 1994 2236 1964 2225 1962 2225 1959 2225 1881 2238 1470 2227 1468 2227 1416 2238 1370 2227 1368 2227 1366 2227 1364 2227 1342 2238 968 2229 965 2229 963 2229 939 2242 757 2242 760 2273"/>
                        </Shape>
                        <String CONTENT="groups of “twenty” (“man”). They are also counted on the fingers, so that"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l29" HPOS="755" VPOS="2284" WIDTH="1772" HEIGHT="73" BASELINE="757 2331 2527 2325" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 2331 757 2346 1338 2355 1340 2355 1414 2344 1550 2355 1552 2355 1554 2355 1557 2355 1572 2344 1728 2344 1743 2355 1745 2355 1747 2355 1749 2357 1894 2357 1894 2355 2033 2353 2035 2353 2037 2353 2055 2342 2245 2353 2247 2353 2525 2342 2527 2325 2522 2297 2113 2284 2111 2284 2035 2294 1951 2284 1949 2284 1862 2297 1827 2286 1825 2286 1823 2286 1470 2297 1401 2286 1399 2286 1318 2299 1256 2288 1253 2288 961 2299 857 2288 855 2288 853 2288 851 2288 835 2299 781 2288 779 2288 777 2288 775 2288 755 2297 757 2331"/>
                        </Shape>
                        <String CONTENT="the limit of enumeration is “twenty scores” (qlik-qliˊkkin). All numbers above"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l30" HPOS="755" VPOS="2346" WIDTH="1090" HEIGHT="70" BASELINE="757 2387 1845 2392" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 2387 755 2405 768 2413 770 2413 773 2413 775 2413 1130 2403 1308 2416 1310 2416 1375 2405 1819 2416 1821 2416 1823 2416 1825 2416 1842 2403 1845 2392 1845 2359 1819 2346 1816 2346 1814 2346 757 2353 757 2387"/>
                        </Shape>
                        <String CONTENT="this are called “knowledge limit” (g̣ɪyeuˊ-teˊhɪn)."/>
                    </TextLine>
</TextBlock>
