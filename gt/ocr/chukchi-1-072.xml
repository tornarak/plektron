                        </Shape>
                        <String CONTENT="calculation is quinary-vigesimal, but very imperfect, and all numerical operations"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l18" HPOS="755" VPOS="1628" WIDTH="1774" HEIGHT="58" BASELINE="757 1673 2529 1669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1673 757 1686 2527 1682 2529 1669 2525 1638 1658 1628 1656 1628 1654 1628 1652 1628 1635 1638 939 1630 937 1630 755 1641 757 1673"/>
                        </Shape>
                        <String CONTENT="are performed with the help of the fingers of both hands. The word for"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l19" HPOS="757" VPOS="1690" WIDTH="1765" HEIGHT="70" BASELINE="757 1729 2522 1729" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1729 757 1744 913 1757 916 1757 968 1747 1277 1757 1279 1757 1282 1757 1325 1747 1457 1757 1459 1757 1537 1747 1576 1757 1578 1757 1580 1760 1825 1760 1825 1757 1827 1757 1829 1757 1847 1747 2468 1757 2471 1757 2522 1744 2522 1729 2520 1690 757 1697 757 1729"/>
                        </Shape>
                        <String CONTENT="counting means literally “I finger” (t-rɪˊlhɪrkɪn). The question “How many?”"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l20" HPOS="755" VPOS="1747" WIDTH="1774" HEIGHT="60" BASELINE="757 1792 2529 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1792 757 1807 2527 1807 2529 1788 2525 1760 2384 1760 2360 1747 2358 1747 2356 1747 2354 1747 2310 1757 2280 1747 2278 1747 2276 1747 2273 1747 2271 1747 2258 1757 2237 1747 2234 1747 2232 1747 2230 1747 2228 1747 2211 1760 2016 1760 1964 1747 1962 1747 1847 1757 1765 1747 1762 1747 1760 1747 1719 1757 1684 1747 1682 1747 1680 1747 1557 1760 1481 1749 1479 1749 1418 1760 1394 1749 1392 1749 1390 1749 1264 1760 1223 1749 1221 1749 1219 1749 1217 1749 1214 1749 1199 1762 1033 1762 903 1749 900 1749 898 1749 896 1749 879 1762 755 1762 757 1792"/>
                        </Shape>
                        <String CONTENT="runs “How many fingers?” (Ter rɪˊlhɪt?) The numbers proceed in the way"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l21" HPOS="755" VPOS="1807" WIDTH="1772" HEIGHT="61" BASELINE="757 1851 2527 1846" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1851 757 1868 2525 1864 2527 1846 2522 1818 1665 1807 1663 1807 1661 1807 1637 1818 857 1809 855 1809 755 1820 757 1851"/>
                        </Shape>
                        <String CONTENT="usual to many primitive languages, so that mɪˊʟɪñên (“five”) is shortened from"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l22" HPOS="755" VPOS="1866" WIDTH="1770" HEIGHT="63" BASELINE="757 1911 2525 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1911 757 1929 2522 1924 2525 1907 2518 1870 2113 1877 2096 1866 2094 1866 2092 1866 2089 1866 2033 1877 1996 1866 1994 1866 1992 1866 1990 1866 1988 1866 1972 1877 1931 1866 1929 1866 1927 1866 1868 1877 1741 1866 1739 1866 1736 1866 1697 1877 1658 1866 1656 1866 1654 1866 1652 1866 1624 1879 1412 1868 1409 1868 1234 1879 1219 1868 1217 1868 1214 1868 1052 1868 1050 1868 1048 1868 1009 1879 892 1868 890 1868 755 1881 757 1911"/>
                        </Shape>
                        <String CONTENT="mɪng̣ɪˊʟɪñɪn (“hand”); mɪng̣ɪˊtkên (“ten”) signifies “belonging to two hands;”"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l23" HPOS="757" VPOS="1924" WIDTH="1770" HEIGHT="65" BASELINE="760 1970 2527 1965" TAGREFS="TYPE_5">
