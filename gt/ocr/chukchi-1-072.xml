                    <TextLine ID="mz_1-072_l6" HPOS="760" VPOS="917" WIDTH="1771" HEIGHT="59" BASELINE="762 950 2531 954" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 950 760 967 770 976 773 976 775 976 777 976 2529 967 2531 954 2529 922 762 917 762 950"/>
                        </Shape>
