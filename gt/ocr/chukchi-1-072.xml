                        </Shape>
                        <String CONTENT="The Chukchee cannot be called quick-witted, especially in trading-transactions,"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l16" HPOS="755" VPOS="1511" WIDTH="1778" HEIGHT="67" BASELINE="757 1552 2533 1547" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 1552 757 1565 1061 1578 1063 1578 1065 1578 1100 1567 1297 1578 1299 1578 1301 1578 1340 1567 1396 1578 1399 1578 1550 1567 1604 1578 1606 1578 1669 1565 1706 1576 1708 1576 1710 1576 1713 1576 1752 1565 2429 1576 2432 1576 2434 1576 2468 1565 2486 1576 2488 1576 2490 1576 2492 1576 2494 1576 2533 1560 2533 1547 2527 1511 755 1515 757 1552"/>
                        </Shape>
                        <String CONTENT="in which they are easily imposed upon by their neighbors. Their system of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l17" HPOS="757" VPOS="1580" WIDTH="1774" HEIGHT="50" BASELINE="757 1610 2531 1610" TAGREFS="TYPE_5">
