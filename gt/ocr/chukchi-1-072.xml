                    <TextLine ID="mz_1-072_l8" HPOS="870" VPOS="1037" WIDTH="1663" HEIGHT="54" BASELINE="870 1073 2533 1073" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="870 1073 870 1091 2533 1091 2533 1073 2533 1041 870 1037 870 1073"/>
                        </Shape>
                        <String CONTENT="The inhabitants of Luˊᵋren, Yaˊnřa-ñai, and other villages and camps around"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l9" HPOS="757" VPOS="1088" WIDTH="1772" HEIGHT="61" BASELINE="760 1134 2529 1127" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1134 760 1149 2527 1145 2529 1127 2525 1099 1975 1088 1972 1088 1970 1088 1933 1099 1431 1091 1429 1091 757 1101 760 1134"/>
                        </Shape>
                        <String CONTENT="St. Lawrence Bay, are famed for their roughness. Some of them buy from"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l10" HPOS="760" VPOS="1151" WIDTH="1769" HEIGHT="61" BASELINE="762 1195 2529 1190" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1195 762 1210 2525 1212 2529 1190 2525 1160 781 1151 779 1151 777 1151 775 1151 760 1158 762 1195"/>
                        </Shape>
                        <String CONTENT="American whalers revolvers, which they carry in a special pocket up the sleeve,"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l11" HPOS="757" VPOS="1208" WIDTH="1776" HEIGHT="62" BASELINE="760 1253 2533 1249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1253 760 1270 2531 1266 2533 1249 2529 1218 1652 1208 1650 1208 1648 1208 1645 1208 1630 1218 848 1210 846 1210 757 1221 760 1253"/>
                        </Shape>
                        <String CONTENT="ready to handle. Mr. J. Kelly, the American agent for buying reindeer, who spent"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l12" HPOS="757" VPOS="1266" WIDTH="1774" HEIGHT="65" BASELINE="760 1314 2531 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1314 760 1331 2529 1324 2531 1307 2529 1279 2501 1266 2499 1266 2496 1266 2494 1266 2460 1277 2159 1266 2156 1266 2087 1277 2057 1266 2055 1266 2053 1266 1990 1277 1946 1266 1944 1266 1942 1266 1940 1266 1938 1266 1920 1279 1442 1268 1440 1268 1437 1268 1401 1279 1349 1268 1347 1268 1344 1268 1342 1268 1327 1281 890 1270 887 1270 885 1270 838 1281 779 1270 777 1270 775 1270 773 1270 757 1279 760 1314"/>
                        </Shape>
                        <String CONTENT="the winter of 1897-98 on the shores of St. Lawrence Bay, in a block-house built"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l13" HPOS="757" VPOS="1331" WIDTH="1774" HEIGHT="58" BASELINE="760 1372 2531 1368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1372 760 1389 2529 1385 2531 1368 2527 1340 770 1331 768 1331 766 1331 764 1331 764 1333 757 1337 760 1372"/>
                        </Shape>
                        <String CONTENT="for the purpose near the village Yaˊnřa-ñai, had considerable trouble with the"/>
                    </TextLine>

