                        </Shape>
                        <String CONTENT="haste, first of all, to perform the marriage ritual with the ravished girl, anointing"/>
                    </TextLine>

                    <TextLine ID="mz_3-056_l13" HPOS="368" VPOS="1170" WIDTH="1766" HEIGHT="60" BASELINE="370 1217 2134 1211" TAGREFS="TYPE_3">
                        <Shape>
