                        </Shape>
                        <String CONTENT="were not considered as a reason for implacable hatred and feuds. The parents"/>
                    </TextLine>

                    <TextLine ID="mz_3-056_l9" HPOS="370" VPOS="932" WIDTH="1764" HEIGHT="63" BASELINE="372 975 2134 971" TAGREFS="TYPE_3">
                        <Shape>
