                        <Shape>
                            <Polygon POINTS="368 1811 368 1823 2128 1827 2130 1811 2130 1784 2073 1772 1935 1772 1933 1772 1931 1772 1907 1782 1709 1772 1707 1772 1705 1772 1668 1782 1631 1772 1629 1772 1627 1772 1625 1772 1590 1782 1486 1772 1485 1772 1483 1772 1440 1784 1282 1784 1266 1772 1264 1772 1262 1772 1260 1772 1182 1782 1147 1772 1145 1772 1030 1772 1028 1772 1027 1772 1025 1772 1011 1782 962 1772 867 1772 865 1772 863 1772 861 1772 849 1782 836 1772 834 1772 832 1772 830 1772 750 1782 368 1778 368 1811"/>
                        </Shape>
                        <String CONTENT="in a tent-cover and firmly tied it with rope. I was in the camp of ᴇˊttɪhɪn,"/>
                    </TextLine>

                    <TextLine ID="mz_3-056_l24" HPOS="364" VPOS="1833" WIDTH="1768" HEIGHT="54" BASELINE="366 1872 2132 1868" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1872 366 1887 2130 1885 2132 1868 2128 1833 512 1833 510 1833 364 1842 366 1872"/>
                        </Shape>
                        <String CONTENT="some five years after the incident, when everything was mended and smoothed"/>
                    </TextLine>

                    <TextLine ID="mz_3-056_l25" HPOS="364" VPOS="1887" WIDTH="1770" HEIGHT="59" BASELINE="366 1932 2134 1926" TAGREFS="TYPE_3">
