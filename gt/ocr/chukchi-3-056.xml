                        </Shape>
                        <String CONTENT="Even at present a case of ravishment may happen now and then. Thus,"/>
                    </TextLine>

                    <TextLine ID="mz_3-056_l18" HPOS="366" VPOS="1468" WIDTH="1766" HEIGHT="59" BASELINE="368 1513 2132 1509" TAGREFS="TYPE_3">
