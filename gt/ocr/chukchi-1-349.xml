                <TextBlock ID="text_1-349" HPOS="427" VPOS="615" WIDTH="1782" HEIGHT="2630"><TextLine ID="mz_1-349_l1" HPOS="1009" VPOS="615" WIDTH="624" HEIGHT="51" BASELINE="1009 647 1633 647" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1620 615 1009 615 1009 647 1009 666 1633 666 1633 647 1631 632 1620 615"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l2" HPOS="2101" VPOS="621" WIDTH="97" HEIGHT="48" BASELINE="2101 651 2198 651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2187 621 2101 621 2101 651 2101 669 2198 669 2198 651 2198 623 2187 621"/>
                        </Shape>
                        <String CONTENT="267"/>
                    </TextLine>
<TextLine ID="mz_1-349_l3" HPOS="429" VPOS="714" WIDTH="1774" HEIGHT="59" BASELINE="431 757 2203 753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="689 716 667 716 646 718 624 718 602 721 581 721 559 723 537 723 516 723 494 725 472 725 451 727 429 727 431 757 431 773 2200 768 2203 753 2198 723 697 714 689 716"/>
                        </Shape>
                        <String CONTENT="the sports described; but if a stranger should be so imprudent as to take the"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l4" HPOS="429" VPOS="777" WIDTH="1774" HEIGHT="63" BASELINE="431 812 2203 816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 812 429 831 442 840 444 840 446 840 448 840 2200 831 2203 816 2200 786 431 777 431 812"/>
                        </Shape>
                        <String CONTENT="best prize, the people are likely to resent it, and might even try to retaliate"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l5" HPOS="429" VPOS="842" WIDTH="316" HEIGHT="56" BASELINE="431 872 745 876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 872 429 889 435 896 435 898 438 898 440 898 442 898 743 889 745 876 743 846 431 842 431 872"/>
                        </Shape>
                        <String CONTENT="in some way."/>
                    </TextLine>
<TextLine ID="mz_1-349_l6" HPOS="539" VPOS="892" WIDTH="1661" HEIGHT="62" BASELINE="539 937 2200 937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="539 937 539 950 2198 954 2200 937 2200 900 2185 892 2183 892 2181 892 2179 892 2177 892 2151 902 2077 892 2075 892 2014 905 1841 905 1824 892 1821 892 1819 892 1817 892 1754 905 1572 905 1559 892 1557 892 1555 892 1553 892 1551 892 1523 905 1434 905 1421 892 1419 892 1416 892 1414 892 1412 892 1388 902 1313 892 1180 892 1178 892 1176 892 1174 892 1159 905 1044 905 1029 892 1027 892 1025 892 1022 892 1020 892 999 902 983 892 981 892 979 892 888 892 886 892 884 892 882 892 866 902 788 892 786 892 732 902 706 892 704 892 702 892 539 898 539 937"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee and Eskimo have foot-races (Plate XXX, Fig. 1)"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l7" HPOS="427" VPOS="950" WIDTH="1776" HEIGHT="65" BASELINE="429 998 2203 991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="429 998 429 1015 2200 1009 2203 991 2198 963 1982 963 1967 950 1964 950 1962 950 1960 950 1958 950 1934 961 1696 950 1694 950 1585 963 1484 952 1481 952 1395 963 1365 952 1362 952 1360 952 1358 952 1328 963 1267 952 1265 952 1196 963 949 954 947 954 944 954 942 954 929 965 866 954 864 954 741 965 481 954 479 954 477 954 427 967 429 998"/>
                        </Shape>
                        <String CONTENT="and wrestling-matches (Plate XXXI, Fig. 1) of the same character as those above"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l8" HPOS="429" VPOS="1019" WIDTH="1748" HEIGHT="50" BASELINE="431 1050 2177 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1050 429 1065 2172 1069 2177 1054 2174 1024 431 1019 431 1050"/>
                        </Shape>
                        <String CONTENT="described, as well as nearly all the other sports which we shall now take up."/>
                    </TextLine>
<TextLine ID="mz_1-349_l9" HPOS="539" VPOS="1080" WIDTH="1668" HEIGHT="54" BASELINE="539 1115 2207 1115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="539 1115 539 1134 2205 1134 2207 1115 2205 1084 539 1080 539 1115"/>
                        </Shape>
                        <String CONTENT="I have already noted the fighting-contests of former times and the physical"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l10" HPOS="431" VPOS="1145" WIDTH="1774" HEIGHT="48" BASELINE="431 1173 2205 1173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1173 431 1193 2205 1193 2205 1173 2205 1145 431 1145 431 1173"/>
                        </Shape>
                        <String CONTENT="exercises with stones (Plate XXVIII, Fig. 1) and trunks of trees.¹ In all exercises"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l11" HPOS="431" VPOS="1201" WIDTH="1774" HEIGHT="50" BASELINE="431 1236 2205 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1236 431 1251 2205 1251 2205 1236 2205 1206 431 1201 431 1236"/>
                        </Shape>
                        <String CONTENT="long and continuous running plays the most important part. The common"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l12" HPOS="429" VPOS="1260" WIDTH="1776" HEIGHT="58" BASELINE="431 1290 2205 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1290 429 1305 474 1318 477 1318 479 1318 2203 1309 2205 1294 2203 1264 431 1260 431 1290"/>
                        </Shape>
                        <String CONTENT="expression for these exercises is “becoming lighter of foot” (inetviˊrkɪn). Even"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l13" HPOS="433" VPOS="1325" WIDTH="1772" HEIGHT="47" BASELINE="433 1355 2205 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1355 433 1372 2205 1372 2205 1355 2205 1325 433 1325 433 1355"/>
                        </Shape>
                        <String CONTENT="at the present time, if a young man is vanquished by an unfriendly rival in"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l14" HPOS="433" VPOS="1385" WIDTH="1772" HEIGHT="48" BASELINE="433 1413 2205 1413" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1413 433 1433 2205 1433 2205 1413 2205 1385 433 1385 433 1413"/>
                        </Shape>
                        <String CONTENT="a wrestling-contest, he will sometimes train for a whole year, dragging heavy"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l15" HPOS="431" VPOS="1439" WIDTH="1774" HEIGHT="52" BASELINE="431 1474 2205 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1474 431 1491 2205 1491 2205 1474 2205 1439 431 1439 431 1474"/>
                        </Shape>
                        <String CONTENT="loads, running, carrying burdens, etc., in order to acquire more agility and"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l16" HPOS="433" VPOS="1504" WIDTH="1770" HEIGHT="48" BASELINE="433 1535 2203 1535" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1535 433 1552 2203 1552 2203 1535 2203 1504 433 1504 433 1535"/>
                        </Shape>
                        <String CONTENT="strength for another contest. Cases of this kind are often mentioned in tales."/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l17" HPOS="431" VPOS="1550" WIDTH="1774" HEIGHT="60" BASELINE="431 1593 2205 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1593 431 1610 2205 1610 2205 1593 2205 1561 2172 1550 2170 1550 2168 1550 2118 1561 2086 1550 2084 1550 2081 1550 2079 1550 2055 1561 2029 1550 2027 1550 2025 1550 1962 1561 1908 1550 1906 1550 1904 1550 1865 1561 1778 1550 1776 1550 1774 1550 1752 1561 1707 1550 1705 1550 1702 1550 1700 1550 1676 1561 1601 1550 1598 1550 1596 1550 1570 1561 1546 1550 1544 1550 1542 1550 1540 1550 1516 1563 1393 1563 1375 1550 1373 1550 1371 1550 1369 1550 1367 1550 1345 1561 1317 1550 1315 1550 1313 1550 1245 1561 1224 1550 1222 1550 1219 1550 1089 1561 1057 1550 1055 1550 1053 1550 1050 1550 1025 1561 929 1550 927 1550 925 1550 899 1561 856 1550 853 1550 851 1550 849 1550 819 1561 769 1550 767 1550 765 1550 741 1563 500 1563 481 1550 479 1550 477 1550 474 1550 431 1558 431 1593"/>
                        </Shape>
                        <String CONTENT="For instance, in the legend of Talo² it is stated that the hero lies idle in his"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l18" HPOS="429" VPOS="1615" WIDTH="1776" HEIGHT="56" BASELINE="431 1656 2205 1652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1656 431 1671 2203 1667 2205 1652 2200 1617 448 1615 446 1615 444 1615 442 1615 429 1621 431 1656"/>
                        </Shape>
                        <String CONTENT="tent for about a year, eating an enormous amount and storing up fat and"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l19" HPOS="429" VPOS="1669" WIDTH="1774" HEIGHT="65" BASELINE="431 1717 2203 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="431 1717 431 1729 2198 1734 2203 1712 2198 1682 2133 1669 2131 1669 2129 1669 2127 1669 2109 1680 2003 1669 2001 1669 1999 1669 1969 1680 1947 1669 1945 1669 1943 1669 1876 1680 1850 1669 1847 1669 1845 1669 1759 1680 1707 1669 1705 1669 1702 1669 1661 1680 1635 1669 1633 1669 1631 1669 1629 1669 1627 1669 1611 1680 1538 1669 1536 1669 1533 1669 1510 1680 1466 1669 1464 1669 1462 1669 1460 1669 1458 1669 1442 1682 1352 1682 1319 1669 1317 1669 1315 1669 1211 1682 652 1671 650 1671 587 1682 548 1671 546 1671 544 1671 429 1684 431 1717"/>
                        </Shape>
                        <String CONTENT="muscle. Then suddenly he starts training. At first he is so slow in dragging"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l20" HPOS="431" VPOS="1727" WIDTH="1774" HEIGHT="65" BASELINE="433 1777 2205 1771" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1777 433 1792 2203 1786 2205 1771 2198 1736 2021 1738 1999 1727 1997 1727 1995 1727 1993 1727 1990 1727 1975 1740 1847 1740 1811 1727 1808 1727 1806 1727 1804 1727 1765 1738 1737 1727 1735 1727 1733 1727 1731 1727 1700 1738 1620 1727 1618 1727 1616 1727 1588 1740 1525 1729 1523 1729 1410 1740 1380 1729 1378 1729 1375 1729 1373 1729 1371 1729 1356 1742 1256 1742 1209 1729 1206 1729 1204 1729 1202 1729 1165 1740 1094 1729 1092 1729 1089 1729 1087 1729 1070 1740 791 1732 788 1732 786 1732 765 1742 646 1732 643 1732 641 1732 639 1732 626 1742 574 1732 572 1732 431 1745 433 1777"/>
                        </Shape>
                        <String CONTENT="a small sledge behind him, that the moving train of his family gets far ahead"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l21" HPOS="431" VPOS="1792" WIDTH="1774" HEIGHT="59" BASELINE="433 1836 2205 1829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1836 433 1851 2203 1844 2205 1829 2200 1801 1038 1792 1035 1792 1033 1792 1031 1792 1016 1803 468 1794 466 1794 464 1794 431 1805 433 1836"/>
                        </Shape>
                        <String CONTENT="of him, and he reaches the camping-place only late the next morning. He"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l22" HPOS="431" VPOS="1853" WIDTH="1774" HEIGHT="63" BASELINE="433 1896 2205 1888" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1896 433 1916 2203 1905 2205 1888 2200 1857 921 1853 918 1853 431 1866 433 1896"/>
                        </Shape>
                        <String CONTENT="perseveres, however, in his exercises, and from day to day increases his speed"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l23" HPOS="433" VPOS="1907" WIDTH="1774" HEIGHT="69" BASELINE="435 1955 2207 1948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1955 435 1968 1111 1976 1113 1976 1115 1976 1118 1976 1133 1965 1280 1965 1345 1976 1347 1976 1349 1976 1380 1965 1575 1976 1577 1976 1694 1963 1709 1974 1711 1974 1713 1974 1715 1974 1772 1963 1787 1974 1789 1974 1791 1974 1793 1974 1795 1974 1828 1963 1845 1974 1847 1974 1850 1974 1852 1974 2205 1963 2207 1948 2205 1920 2164 1907 2161 1907 2159 1907 2157 1907 2155 1907 2140 1918 2086 1907 2084 1907 2081 1907 2079 1907 2064 1920 1925 1920 1869 1907 1867 1907 1865 1907 1819 1918 1793 1907 1791 1907 1789 1907 1739 1918 1715 1907 1713 1907 1711 1907 1657 1918 1627 1907 1624 1907 1622 1907 1620 1907 1618 1907 1605 1920 1568 1909 1566 1909 1564 1909 1349 1920 1302 1909 1300 1909 1297 1909 1295 1909 1248 1920 1193 1909 1191 1909 1189 1909 1187 1909 1172 1922 1081 1922 1042 1909 1040 1909 1038 1909 1035 1909 1005 1922 973 1911 970 1911 968 1911 840 1922 819 1911 817 1911 656 1911 654 1911 652 1911 628 1922 565 1911 563 1911 561 1911 559 1911 542 1922 505 1911 503 1911 500 1911 433 1924 435 1955"/>
                        </Shape>
                        <String CONTENT="and the load he is drawing. On the twentieth day he is able to pull six"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l24" HPOS="433" VPOS="1970" WIDTH="1774" HEIGHT="60" BASELINE="433 2011 2207 2011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2011 433 2030 2207 2030 2207 2011 2207 1981 2161 1970 2159 1970 2157 1970 2155 1970 2120 1981 2053 1970 2051 1970 2049 1970 2019 1981 1980 1970 1977 1970 1975 1970 1919 1981 1897 1970 1895 1970 1893 1970 1821 1981 1735 1970 1733 1970 1657 1981 1581 1970 1579 1970 1577 1970 1542 1983 1434 1983 1419 1970 1416 1970 1414 1970 1412 1970 1321 1981 1295 1970 1293 1970 1291 1970 1239 1981 1206 1970 1204 1970 1202 1970 1200 1970 1163 1983 1070 1983 1055 1970 1053 1970 1050 1970 1048 1970 938 1981 905 1970 903 1970 901 1970 847 1981 704 1970 702 1970 433 1976 433 2011"/>
                        </Shape>
                        <String CONTENT="loaded sledges, and still keep ahead of the moving train. All this time he"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l25" HPOS="433" VPOS="2039" WIDTH="1772" HEIGHT="50" BASELINE="435 2072 2205 2067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2072 435 2089 2203 2085 2205 2067 2198 2039 433 2041 435 2072"/>
                        </Shape>
                        <String CONTENT="eats nothing and does not enter his tent, sleeping for only a few hours each"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l26" HPOS="433" VPOS="2091" WIDTH="1772" HEIGHT="56" BASELINE="435 2134 2205 2130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2134 435 2147 2203 2143 2205 2130 2200 2102 1332 2091 1330 2091 1328 2091 1326 2091 1313 2102 464 2093 461 2093 459 2093 433 2102 435 2134"/>
                        </Shape>
                        <String CONTENT="night out in the open on the snow. After that he practises other exercises."/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l27" HPOS="438" VPOS="2158" WIDTH="1771" HEIGHT="50" BASELINE="438 2193 2209 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 2193 438 2208 2209 2208 2209 2193 2209 2162 438 2158 438 2193"/>
                        </Shape>
                        <String CONTENT="For whole days he will throw his lance or jump over the tents, across the"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l28" HPOS="433" VPOS="2219" WIDTH="1774" HEIGHT="52" BASELINE="435 2253 2207 2249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2253 435 2271 2205 2266 2207 2249 2203 2221 433 2219 435 2253"/>
                        </Shape>
                        <String CONTENT="lakes, or over large forests from one border to the other, until he feels ready"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l29" HPOS="433" VPOS="2271" WIDTH="563" HEIGHT="65" BASELINE="435 2310 996 2314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2310 433 2327 444 2336 446 2336 448 2336 451 2336 453 2336 492 2325 518 2336 520 2336 522 2336 994 2325 996 2314 996 2284 964 2271 962 2271 960 2271 435 2277 435 2310"/>
                        </Shape>
                        <String CONTENT="to conquer the Taˊn˙ñɪt."/>
                    </TextLine>
<TextLine ID="mz_1-349_l30" HPOS="544" VPOS="2325" WIDTH="1665" HEIGHT="65" BASELINE="546 2372 2209 2366" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="546 2372 546 2390 2207 2383 2209 2366 2205 2338 2006 2325 2003 2325 1954 2336 1938 2325 1936 2325 1934 2325 1932 2325 1930 2325 1889 2336 1837 2325 1834 2325 1646 2338 1603 2327 1601 2327 1598 2327 1596 2327 1564 2340 1442 2340 1423 2327 1421 2327 1419 2327 1416 2327 1313 2338 1297 2327 1295 2327 1293 2327 1291 2327 1289 2327 1250 2338 1222 2327 1219 2327 1128 2327 1126 2327 1124 2327 1094 2340 1027 2329 1025 2329 1022 2329 999 2340 916 2329 914 2329 912 2329 875 2340 858 2329 856 2329 853 2329 851 2329 795 2340 765 2329 762 2329 760 2329 758 2329 726 2340 669 2329 667 2329 544 2336 546 2372"/>
                        </Shape>
                        <String CONTENT="Tossing in blankets is a kind of religious performance with the Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l31" HPOS="433" VPOS="2388" WIDTH="1776" HEIGHT="60" BASELINE="435 2433 2209 2429" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2433 435 2448 2207 2444 2209 2429 2205 2398 1321 2388 1319 2388 1317 2388 1293 2398 453 2390 451 2390 448 2390 446 2390 433 2396 435 2433"/>
                        </Shape>
                        <String CONTENT="Chukchee and Eskimo, and will therefore be described later, in the chapters"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l32" HPOS="435" VPOS="2450" WIDTH="1772" HEIGHT="59" BASELINE="438 2489 2207 2485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 2489 438 2509 2205 2505 2207 2485 2203 2455 455 2450 453 2450 451 2450 448 2450 435 2457 438 2489"/>
                        </Shape>
                        <String CONTENT="dealing with this subject. Other amusements of less importance are practised"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l33" HPOS="435" VPOS="2518" WIDTH="1770" HEIGHT="54" BASELINE="438 2554 2205 2548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 2554 438 2570 2200 2572 2205 2548 2200 2518 435 2518 438 2554"/>
                        </Shape>
                        <String CONTENT="by grown people and children whenever occasion presents, without prizes being"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l34" HPOS="433" VPOS="2576" WIDTH="897" HEIGHT="58" BASELINE="435 2606 1330 2613" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2583 435 2606 433 2626 448 2634 451 2634 453 2634 455 2634 1328 2628 1330 2613 1328 2583 440 2576 435 2583"/>
                        </Shape>
                        <String CONTENT="offered and without general gatherings."/>
                    </TextLine>
<TextLine ID="mz_1-349_l35" HPOS="542" VPOS="2641" WIDTH="1667" HEIGHT="52" BASELINE="542 2671 2209 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="542 2671 542 2693 2207 2686 2209 2671 2207 2641 542 2641 542 2671"/>
                        </Shape>
                        <String CONTENT="Jumping-matches are often arranged on the spur of the moment by young"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l36" HPOS="438" VPOS="2702" WIDTH="1767" HEIGHT="54" BASELINE="438 2732 2205 2732" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 2732 438 2756 2203 2751 2205 2732 2203 2702 438 2702 438 2732"/>
                        </Shape>
                        <String CONTENT="people in camps or villages. Each tries to make the longest jump possible,"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l37" HPOS="438" VPOS="2758" WIDTH="1736" HEIGHT="52" BASELINE="438 2790 2174 2790" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 2773 438 2790 438 2810 2174 2810 2174 2790 2174 2760 444 2758 438 2773"/>
                        </Shape>
                        <String CONTENT="keeping his heels together, and getting a start by a few preliminary jumps."/>
                    </TextLine>
<TextLine ID="mz_1-349_l38" HPOS="550" VPOS="2821" WIDTH="1659" HEIGHT="49" BASELINE="550 2849 2209 2849" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="550 2849 550 2870 2209 2870 2209 2849 2209 2821 550 2821 550 2849"/>
                        </Shape>
                        <String CONTENT="Arm-pulling, finger-pulling, neck-pulling, and stick-pulling are practised in"/>
                    </TextLine>

                    <TextLine ID="mz_1-349_l39" HPOS="438" VPOS="2875" WIDTH="1769" HEIGHT="60" BASELINE="440 2914 2207 2905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="440 2914 440 2935 2205 2925 2207 2905 2200 2875 438 2881 440 2914"/>
                        </Shape>
                        <String CONTENT="pairs. For these the contestants lock arms or fingers, have a rawhide loop"/>
                    </TextLine>

