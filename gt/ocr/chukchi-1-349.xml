                        <Shape>
                            <Polygon POINTS="454 1370 454 1387 2226 1387 2226 1370 2226 1340 454 1340 454 1370"/>
                        </Shape>
                        <String CONTENT="at the present time, if a young man is vanquished by an unfriendly rival in"/>
