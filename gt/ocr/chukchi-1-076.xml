                <TextBlock ID="mz_1-076_r2" HPOS="740" VPOS="712" WIDTH="1778" HEIGHT="257" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="740 712 2518 712 2518 969 740 969"/>
                    </Shape>
                    <TextLine ID="mz_1-076_l3" HPOS="741" VPOS="725" WIDTH="1769" HEIGHT="54" BASELINE="743 764 2510 760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2495 736 2473 736 2452 734 2430 734 2408 731 2387 731 2365 729 2343 729 2339 727 741 725 743 764 743 779 2508 775 2510 760 2506 736 2495 736"/>
                        </Shape>
                        <String CONTENT="ward along the Arctic coast, carried on trade with the Maritime Chukchee."/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l4" HPOS="743" VPOS="781" WIDTH="1771" HEIGHT="57" BASELINE="743 822 2514 822" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 822 743 838 2514 838 2514 822 2514 794 2439 781 2298 781 2296 781 2294 781 2291 781 2278 792 2233 781 2231 781 2229 781 2157 794 1917 794 1902 781 1899 781 1897 781 1895 781 1839 792 1711 781 1709 781 1707 781 1676 792 1609 781 1607 781 1605 781 1570 792 743 786 743 822"/>
                        </Shape>
                        <String CONTENT="They would leave their wares on the shore and go away. The Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l5" HPOS="739" VPOS="846" WIDTH="1771" HEIGHT="59" BASELINE="741 885 2510 879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 885 741 905 2508 905 2510 879 2504 846 739 851 741 885"/>
                        </Shape>
                        <String CONTENT="would come afterwards, take the wares, and leave their equivalent in peltries,"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l6" HPOS="739" VPOS="900" WIDTH="608" HEIGHT="70" BASELINE="741 944 1347 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 944 741 957 827 970 830 970 882 959 1102 967 1105 967 1107 967 1109 967 1109 965 1118 957 1137 967 1139 967 1141 970 1323 970 1323 967 1326 967 1328 967 1347 954 1347 939 1341 900 739 911 741 944"/>
                        </Shape>
                        <String CONTENT="ivory, and ivory carvings.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-076_r3" HPOS="740" VPOS="972" WIDTH="1778" HEIGHT="56" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="740 972 2518 972 2518 1028 740 1028"/>
                    </Shape>
                    <TextLine ID="mz_1-076_l7" HPOS="845" VPOS="954" WIDTH="1665" HEIGHT="65" BASELINE="847 1004 2510 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="847 1004 847 1019 2508 1013 2510 998 2506 967 2378 967 2361 954 2359 954 2356 954 2354 954 2268 965 2252 954 2250 954 2248 954 2246 954 2244 954 2205 965 2153 954 2151 954 2090 965 2060 954 2058 954 2055 954 1941 967 1910 957 1908 957 1906 957 1702 967 1681 957 1679 957 1549 957 1546 957 1544 957 1518 967 1473 957 1471 957 1468 957 1466 957 1464 957 1447 967 1334 959 1332 959 1330 959 1328 959 1310 970 990 959 988 959 986 959 983 959 973 967 962 959 960 959 957 959 866 959 864 959 862 959 860 959 845 967 847 1004"/>
                        </Shape>
                        <String CONTENT="Chukchee tradition relates the following regarding trade with America: —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-076_r4" HPOS="740" VPOS="1028" WIDTH="1778" HEIGHT="475" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="740 1028 2518 1028 2518 1503 740 1503"/>
                    </Shape>
                    <TextLine ID="mz_1-076_l8" HPOS="853" VPOS="1022" WIDTH="1653" HEIGHT="56" BASELINE="853 1058 2506 1058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="853 1058 853 1078 2506 1078 2506 1058 2504 1022 853 1028 853 1058"/>
                        </Shape>
                        <String CONTENT="“On the other side of the sea, in a large forest, live ‘the invisible ones.’"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l9" HPOS="745" VPOS="1084" WIDTH="1765" HEIGHT="54" BASELINE="745 1121 2510 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 1121 745 1138 2510 1138 2510 1121 2510 1091 749 1084 745 1121"/>
                        </Shape>
                        <String CONTENT="When they come to trade, one can see only the fox and beaver skins which"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l10" HPOS="741" VPOS="1136" WIDTH="1769" HEIGHT="63" BASELINE="743 1182 2510 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1182 743 1199 2508 1193 2510 1175 2506 1147 1930 1136 1928 1136 1925 1136 1923 1136 1908 1147 1414 1138 1412 1138 1326 1149 758 1141 756 1141 754 1141 752 1141 741 1147 743 1182"/>
                        </Shape>
                        <String CONTENT="they carry in their hands, and it seems as if the peltries move of themselves."/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l11" HPOS="745" VPOS="1212" WIDTH="1769" HEIGHT="46" BASELINE="745 1240 2514 1240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 1240 745 1258 2514 1258 2514 1240 2514 1212 754 1212 745 1240"/>
                        </Shape>
                        <String CONTENT="They come to meet our traders on the border of the forest, and shout, ‘Let"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l12" HPOS="743" VPOS="1271" WIDTH="1767" HEIGHT="45" BASELINE="743 1301 2510 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1301 743 1316 2508 1316 2510 1301 2508 1271 743 1271 743 1301"/>
                        </Shape>
                        <String CONTENT="us trade!’ The traders take a bundle of tobacco and fling it far away."/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l13" HPOS="745" VPOS="1325" WIDTH="1767" HEIGHT="58" BASELINE="747 1357 2512 1361" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="747 1357 745 1370 771 1383 773 1383 775 1383 2510 1374 2512 1361 2512 1331 747 1325 747 1357"/>
                        </Shape>
                        <String CONTENT="‘Tobacco, tobacco!’ rings through the forest, but nobody is seen. After a"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l14" HPOS="741" VPOS="1377" WIDTH="1773" HEIGHT="60" BASELINE="743 1422 2514 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1422 743 1437 2512 1433 2514 1418 2510 1387 1640 1377 1637 1377 1635 1377 1633 1377 1618 1387 784 1379 782 1379 780 1379 741 1390 743 1422"/>
                        </Shape>
                        <String CONTENT="while a bag filled with fox or beaver skins is flung from the forest. For one,"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l15" HPOS="741" VPOS="1433" WIDTH="1401" HEIGHT="71" BASELINE="743 1481 2142 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1481 743 1496 1256 1504 1258 1504 1261 1504 1263 1504 1276 1494 1375 1494 1419 1504 1421 1504 1423 1504 1553 1494 1644 1504 1646 1504 1648 1504 1705 1491 1934 1502 1936 1502 1993 1491 2006 1502 2008 1502 2010 1502 2012 1504 2120 1504 2120 1502 2122 1502 2125 1502 2142 1489 2142 1474 2131 1433 2112 1444 1821 1433 1819 1433 1817 1433 1780 1444 1759 1433 1756 1433 1754 1433 1752 1433 1707 1444 1683 1433 1681 1433 1679 1433 1676 1433 1633 1446 1564 1435 1562 1435 1559 1435 1557 1435 1544 1448 1449 1448 1425 1435 1423 1435 1421 1435 1419 1435 1375 1446 1330 1435 1328 1435 1326 1435 1323 1435 1291 1448 741 1448 743 1481"/>
                        </Shape>
                        <String CONTENT="bundle of tobacco they will give a bagful of white-fox skins.”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-076_r5" HPOS="740" VPOS="1503" WIDTH="1778" HEIGHT="479" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="740 1503 2518 1503 2518 1982 740 1982"/>
                    </Shape>
                    <TextLine ID="mz_1-076_l16" HPOS="847" VPOS="1498" WIDTH="1667" HEIGHT="56" BASELINE="849 1541 2514 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="849 1541 849 1554 2512 1550 2514 1537 2510 1506 860 1498 858 1498 856 1498 853 1498 853 1500 847 1504 849 1541"/>
                        </Shape>
                        <String CONTENT="Some trade with the Koryak was also probably carried on before the"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l17" HPOS="741" VPOS="1552" WIDTH="1769" HEIGHT="65" BASELINE="743 1602 2510 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1602 743 1617 2508 1613 2510 1595 2506 1565 2231 1552 2229 1552 2120 1563 2079 1552 2077 1552 2075 1552 2073 1552 2027 1563 1960 1552 1958 1552 1956 1552 1917 1565 1884 1554 1882 1554 1880 1554 1878 1554 1854 1565 1718 1554 1715 1554 1713 1554 1670 1565 1640 1554 1637 1554 1635 1554 1633 1554 1611 1565 1540 1554 1538 1554 1536 1554 1533 1554 1516 1565 1488 1554 1486 1554 1484 1554 1427 1565 1334 1554 1332 1554 1330 1554 1328 1554 1313 1567 786 1556 784 1556 782 1556 741 1569 743 1602"/>
                        </Shape>
                        <String CONTENT="advent of the Russians. I heard that in the south of the Parapolsky Dol, on"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l18" HPOS="741" VPOS="1617" WIDTH="1771" HEIGHT="58" BASELINE="743 1660 2512 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1660 743 1675 2510 1671 2512 1656 2508 1626 760 1617 758 1617 756 1617 754 1617 741 1623 743 1660"/>
                        </Shape>
                        <String CONTENT="the river Anapka, an ancient fair was held at which several camps of Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l19" HPOS="745" VPOS="1673" WIDTH="1767" HEIGHT="63" BASELINE="745 1719 2512 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 1719 745 1736 2510 1732 2512 1714 2508 1684 2320 1673 2317 1673 2315 1673 2278 1684 2257 1673 2255 1673 2252 1673 2177 1684 2099 1673 2097 1673 2094 1673 2092 1673 2077 1686 1925 1686 1899 1673 1897 1673 1895 1673 1746 1684 1722 1673 1720 1673 1718 1673 1715 1673 1694 1684 1629 1673 1627 1673 1624 1673 1572 1686 1490 1675 1488 1675 1213 1686 1198 1675 1196 1675 1193 1675 1005 1675 1003 1675 921 1686 905 1675 903 1675 901 1675 760 1675 758 1675 745 1719"/>
                        </Shape>
                        <String CONTENT="Koryak and Chukchee, of Maritime Chukchee, and even of Kamchadal, used"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l20" HPOS="743" VPOS="1751" WIDTH="1769" HEIGHT="46" BASELINE="743 1779 2512 1779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1779 743 1797 2512 1797 2512 1779 2512 1751 743 1751 743 1779"/>
                        </Shape>
                        <String CONTENT="to gather. Perhaps a few articles of Japanese manufacture may have come"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l21" HPOS="741" VPOS="1794" WIDTH="1773" HEIGHT="61" BASELINE="743 1840 2514 1836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1840 743 1855 2512 1851 2514 1836 2510 1807 2367 1794 2365 1794 2237 1805 2211 1794 2209 1794 2207 1794 2118 1805 2042 1794 2040 1794 1975 1805 1880 1794 1878 1794 1821 1805 1759 1794 1756 1794 1648 1805 1575 1797 1572 1797 1570 1797 1568 1797 1551 1807 988 1797 986 1797 888 1807 825 1797 823 1797 741 1810 743 1840"/>
                        </Shape>
                        <String CONTENT="to the north in this way. At least, the question of the origin and manufacture"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l22" HPOS="743" VPOS="1868" WIDTH="1771" HEIGHT="48" BASELINE="743 1898 2514 1898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1898 743 1916 2514 1916 2514 1898 2514 1868 743 1868 743 1898"/>
                        </Shape>
                        <String CONTENT="of Chukchee iron armor suggests a connection with the Japanese which does"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l23" HPOS="741" VPOS="1918" WIDTH="478" HEIGHT="63" BASELINE="743 1959 1219 1955" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1959 743 1974 1202 1981 1204 1981 1206 1981 1209 1981 1219 1970 1219 1955 1213 1918 741 1929 743 1959"/>
                        </Shape>
                        <String CONTENT="not exist at present.²"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-076_r6" HPOS="740" VPOS="1982" WIDTH="1778" HEIGHT="718" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="740 1982 2518 1982 2518 2700 740 2700"/>
                    </Shape>
                    <TextLine ID="mz_1-076_l24" HPOS="847" VPOS="1972" WIDTH="1667" HEIGHT="76" BASELINE="849 2020 2514 2015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="849 2020 849 2048 957 2035 1488 2046 1490 2046 1603 2035 2086 2043 2088 2043 2090 2043 2116 2033 2512 2033 2514 2015 2510 1985 2359 1972 2356 1972 2354 1972 2352 1972 2337 1985 2194 1985 2170 1972 2168 1972 2166 1972 2164 1972 2161 1972 2146 1985 2055 1985 2025 1972 2023 1972 2021 1972 1936 1983 1906 1972 1904 1972 1902 1972 1899 1972 1876 1983 1819 1972 1817 1972 1715 1983 1683 1972 1681 1972 1679 1972 1618 1985 1510 1974 1507 1974 1505 1974 1471 1985 1447 1974 1445 1974 1442 1974 1440 1974 1393 1985 1321 1974 1319 1974 1317 1974 1276 1985 1235 1974 1232 1974 1230 1974 847 1983 849 2020"/>
                        </Shape>
                        <String CONTENT="This armor, made of small pieces of iron with fastenings of narrow leather"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l25" HPOS="739" VPOS="2035" WIDTH="1773" HEIGHT="60" BASELINE="741 2080 2512 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 2080 741 2095 2510 2091 2512 2074 2508 2043 1917 2035 1915 2035 1802 2046 1516 2037 1514 2037 739 2048 741 2080"/>
                        </Shape>
                        <String CONTENT="strips, was very common among the Reindeer Chukchee until recently. Even"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l26" HPOS="741" VPOS="2095" WIDTH="1771" HEIGHT="61" BASELINE="743 2141 2512 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 2141 743 2156 2510 2152 2512 2137 2508 2106 1884 2095 1882 2095 741 2108 743 2141"/>
                        </Shape>
                        <String CONTENT="now, many individuals preserve their armor out of reverence for its antiquity."/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l27" HPOS="745" VPOS="2165" WIDTH="1767" HEIGHT="47" BASELINE="745 2197 2512 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2197 745 2212 2510 2208 2512 2193 2506 2165 754 2167 745 2197"/>
                        </Shape>
                        <String CONTENT="Besides armor, helmets and greaves were used, all of which are in some"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l28" HPOS="741" VPOS="2217" WIDTH="1771" HEIGHT="58" BASELINE="743 2258 2512 2253" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 2258 743 2275 2510 2271 2512 2253 2508 2225 760 2217 758 2217 756 2217 754 2217 741 2223 743 2258"/>
                        </Shape>
                        <String CONTENT="degree similar to those of Japanese production. The Chukchee, however, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l29" HPOS="745" VPOS="2275" WIDTH="1767" HEIGHT="59" BASELINE="745 2318 2512 2318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2318 745 2334 2510 2334 2512 2318 2512 2288 2478 2275 2475 2275 2473 2275 2471 2275 2432 2286 2350 2275 2348 2275 2285 2288 2090 2288 2062 2275 2060 2275 2058 2275 2055 2275 2053 2275 2038 2288 1917 2288 1869 2275 1867 2275 1865 2275 1863 2275 1860 2275 1843 2288 1679 2288 1590 2275 1588 2275 1585 2275 1546 2286 1505 2275 1503 2275 1501 2275 1499 2275 1475 2286 1419 2275 1416 2275 1414 2275 1369 2286 1341 2275 1339 2275 1336 2275 1334 2275 1295 2286 1274 2275 1271 2275 1118 2275 1115 2275 1113 2275 1074 2286 1050 2275 1048 2275 901 2275 899 2275 756 2286 745 2318"/>
                        </Shape>
                        <String CONTENT="not sufficiently skilled in the blacksmith’s art to forge such armor. The only"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l30" HPOS="745" VPOS="2347" WIDTH="1767" HEIGHT="54" BASELINE="745 2377 2512 2377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2377 745 2401 2510 2390 2512 2377 2510 2347 756 2347 745 2377"/>
                        </Shape>
                        <String CONTENT="place where it could have been made is in the Koryak village of Poiˊtɪn"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l31" HPOS="741" VPOS="2394" WIDTH="1771" HEIGHT="61" BASELINE="743 2437 2512 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 2437 743 2455 2510 2450 2512 2433 2508 2401 758 2394 756 2394 754 2394 752 2394 741 2401 743 2437"/>
                        </Shape>
                        <String CONTENT="(Russian Paren, Парень), the inhabitants of which have for a long time occupied"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l32" HPOS="745" VPOS="2466" WIDTH="1769" HEIGHT="49" BASELINE="745 2496 2514 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2496 745 2515 2514 2515 2514 2496 2514 2466 756 2466 745 2496"/>
                        </Shape>
                        <String CONTENT="themselves with farriery; and the tradition of the southwestern Chukchee points"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l33" HPOS="745" VPOS="2526" WIDTH="1769" HEIGHT="48" BASELINE="745 2557 2514 2557" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2557 745 2574 2514 2574 2514 2557 2514 2526 756 2526 745 2557"/>
                        </Shape>
                        <String CONTENT="in this direction. The question arises, whether the manufacture of this armor"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l34" HPOS="745" VPOS="2572" WIDTH="1769" HEIGHT="60" BASELINE="745 2617 2514 2613" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2617 745 2632 2512 2628 2514 2613 2510 2583 1644 2572 1642 2572 1640 2572 1609 2583 927 2574 925 2574 754 2585 745 2617"/>
                        </Shape>
                        <String CONTENT="was really developed only after the arrival of the Russians, especially as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-076_l35" HPOS="745" VPOS="2645" WIDTH="1510" HEIGHT="48" BASELINE="745 2676 2255 2676" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 2676 745 2693 2255 2693 2255 2676 2255 2645 756 2645 745 2676"/>
                        </Shape>
                        <String CONTENT="wars have decreased since the last half of the eighteenth century."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-076_r7" HPOS="740" VPOS="2700" WIDTH="1778" HEIGHT="417" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="740 2700 2518 2700 2518 3117 740 3117"/>
                    </Shape>
