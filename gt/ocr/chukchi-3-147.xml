                    <TextLine ID="mz_3-147_l41" HPOS="479" VPOS="2661" WIDTH="1655" HEIGHT="43" BASELINE="479 2686 2134 2686" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 2686 479 2704 2134 2704 2134 2686 2134 2661 479 2661 479 2686"/>
                        </Shape>
                        <String CONTENT="² The Russian governors (воеводы) of the Moscow period were often sent in pairs, partly with the idea"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l42" HPOS="372" VPOS="2706" WIDTH="871" HEIGHT="41" BASELINE="372 2731 1243 2731" TAGREFS="TYPE_4">
                        <Shape>
