                        </Shape>
                        <String CONTENT="that one would prevent any misdemeanor of the other."/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l43" HPOS="479" VPOS="2745" WIDTH="1549" HEIGHT="43" BASELINE="479 2770 2028 2770" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 2770 479 2788 2028 2788 2028 2770 2028 2745 479 2745 479 2770"/>
                        </Shape>
                        <String CONTENT="³ Thus were called all categories of soldiers and lower officials in the service of the Government."/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l44" HPOS="477" VPOS="2784" WIDTH="1657" HEIGHT="45" BASELINE="479 2811 2134 2807" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 2811 479 2829 2132 2827 2134 2807 2128 2784 477 2786 479 2811"/>
                        </Shape>
                        <String CONTENT="⁴ The Maritime (sedentary) Chukchee usually are called in the reports “walking,” in contrast to the"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l45" HPOS="370" VPOS="2827" WIDTH="1764" HEIGHT="46" BASELINE="372 2858 2134 2850" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="372 2858 372 2873 2132 2869 2134 2850 2128 2827 370 2832 372 2858"/>
                        </Shape>
                        <String CONTENT="Reindeer division of the tribe. Among the Reindeer Chukchee each member of the family has a team of its"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l46" HPOS="370" VPOS="2869" WIDTH="1764" HEIGHT="45" BASELINE="372 2901 2134 2893" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="372 2901 372 2914 2132 2912 2134 2893 2128 2869 370 2875 372 2901"/>
                        </Shape>
                        <String CONTENT="own: so all can drive. Among the Maritime Chukchee a family usually has but one team, and most of the"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l47" HPOS="372" VPOS="2912" WIDTH="1763" HEIGHT="49" BASELINE="374 2944 2135 2938" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 2944 374 2961 2135 2949 2135 2938 2130 2912 372 2916 374 2944"/>
                        </Shape>
                        <String CONTENT="people have to walk. It seems that in earlier times the dog-teams of the Chukchee were still more unfit"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l48" HPOS="372" VPOS="2951" WIDTH="1762" HEIGHT="49" BASELINE="374 2986 2134 2977" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 2986 374 3000 2132 2998 2134 2977 2128 2951 372 2961 374 2986"/>
                        </Shape>
                        <String CONTENT="for swift and efficient driving than they are now, in comparison with the dogs of the Maritime Koryak and"/>
                    </TextLine>

                    <TextLine ID="mz_3-147_l49" HPOS="374" VPOS="2996" WIDTH="1760" HEIGHT="49" BASELINE="376 3027 2134 3021" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 3027 376 3045 2134 3045 2134 3021 2128 2996 374 3000 376 3027"/>
                        </Shape>
                        <String CONTENT="Russianized natives. So in a campaign the warriors of the Reindeer Chukchee were usually driving reindeer,"/>
                    </TextLine>

