                        </Shape>
                        <String CONTENT="be bought from competent persons. These are, of course, mostly shamans;"/>
                    </TextLine>

                    <TextLine ID="mz_2-201_l39" HPOS="411" VPOS="2743" WIDTH="1761" HEIGHT="59" BASELINE="411 2786 2172 2780" TAGREFS="TYPE_5">
                        <Shape>
