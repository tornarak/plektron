                        </Shape>
                        <String CONTENT="Incantations may be inherited from parents, who, dying or growing old,"/>
                    </TextLine>

                    <TextLine ID="mz_2-201_l36" HPOS="407" VPOS="2561" WIDTH="1765" HEIGHT="59" BASELINE="409 2606 2172 2600" TAGREFS="TYPE_5">
