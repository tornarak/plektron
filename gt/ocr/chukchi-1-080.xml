                <TextBlock ID="text_1-080" HPOS="710" VPOS="612" WIDTH="1783" HEIGHT="2642"><TextLine ID="mz_1-080_l1" HPOS="1295" VPOS="617" WIDTH="620" HEIGHT="56" BASELINE="1297 651 1915 656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1906 619 1317 617 1297 625 1297 651 1295 669 1910 673 1915 656 1912 628 1906 619"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l2" HPOS="732" VPOS="612" WIDTH="46" HEIGHT="74" BASELINE="739 666 778 662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 666 739 686 778 682 778 662 767 612 732 621 739 666"/>
                        </Shape>
                        <String CONTENT="58"/>
                    </TextLine>
<TextLine ID="mz_1-080_l3" HPOS="719" VPOS="718" WIDTH="1774" HEIGHT="63" BASELINE="721 766 2493 762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2473 727 2452 727 2430 727 2413 725 2391 725 2387 725 2365 725 2356 723 2296 723 2278 723 2272 721 2105 718 2103 718 2053 729 2040 718 2038 718 2036 718 1923 718 1921 718 1919 718 1917 718 1899 729 1828 718 1826 718 1707 729 1627 718 1624 718 1622 718 1620 718 1598 731 1412 721 1410 721 1358 731 1332 721 1330 721 1328 721 1326 721 1323 721 1304 734 1176 734 1128 721 1126 721 1124 721 1122 721 1100 731 1020 721 1018 721 1016 721 1014 721 996 734 856 734 840 721 838 721 836 721 745 721 743 721 741 721 739 721 719 729 721 766 721 781 2491 777 2493 762 2488 727 2473 727"/>
                        </Shape>
                        <String CONTENT="Anui camps led them to the fair. As late as 1879 Nordenskiöld saw several"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l4" HPOS="717" VPOS="779" WIDTH="1776" HEIGHT="63" BASELINE="719 825 2493 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 825 719 842 2491 838 2493 820 2491 792 2456 779 2454 779 2452 779 2450 779 2421 790 2406 779 2404 779 2402 779 2400 779 2398 779 2352 790 1997 779 1995 779 1928 790 1860 779 1858 779 1856 779 1826 790 1774 779 1772 779 1707 790 1642 779 1640 779 1637 779 1635 779 1620 792 1479 792 1440 781 1438 781 1436 781 1434 781 1406 792 1391 781 1388 781 1386 781 1384 781 1241 792 1206 781 1204 781 1202 781 1200 781 1170 792 1100 781 1098 781 977 792 840 781 838 781 782 792 745 781 743 781 741 781 739 781 736 781 717 790 719 825"/>
                        </Shape>
                        <String CONTENT="dog-sledges passing by on their return from the fair, while during the whole"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l5" HPOS="719" VPOS="853" WIDTH="1774" HEIGHT="49" BASELINE="719 883 2493 883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 883 719 902 2493 902 2493 883 2493 853 719 853 719 883"/>
                        </Shape>
                        <String CONTENT="of my stay in the Kolyma district (1890-98), hardly a single dog-sledge came"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l6" HPOS="717" VPOS="900" WIDTH="884" HEIGHT="61" BASELINE="719 946 1601 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 946 719 961 1598 957 1601 941 1596 913 1284 900 1282 900 1280 900 1278 900 1263 913 1152 913 1126 902 1124 902 1122 902 1042 913 994 902 992 902 990 902 988 902 962 913 892 902 890 902 888 902 864 913 810 902 808 902 717 915 719 946"/>
                        </Shape>
                        <String CONTENT="to the fair from the maritime villages."/>
                    </TextLine>
<TextLine ID="mz_1-080_l7" HPOS="825" VPOS="959" WIDTH="1668" HEIGHT="73" BASELINE="827 1006 2493 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="827 1006 827 1032 897 1022 1653 1028 1655 1028 1746 1017 2068 1026 2071 1026 2491 1013 2493 998 2488 970 2075 959 2073 959 2071 959 2042 970 843 965 840 965 838 965 836 965 825 972 827 1006"/>
                        </Shape>
                        <String CONTENT="At the present time about six or seven hundred people gather together"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l8" HPOS="719" VPOS="1022" WIDTH="1769" HEIGHT="60" BASELINE="719 1065 2488 1065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1065 719 1078 2486 1082 2488 1065 2488 1035 2400 1022 2398 1022 2159 1032 2062 1022 2060 1022 2058 1022 2055 1022 2038 1032 2003 1022 2001 1022 1999 1022 1943 1032 1928 1022 1925 1022 1923 1022 1815 1022 1813 1022 1811 1022 1772 1032 1715 1022 1713 1022 1642 1032 1616 1022 1614 1022 1611 1022 1609 1022 1607 1022 1590 1035 1486 1035 1391 1022 1388 1022 1291 1032 1178 1022 1176 1022 1174 1022 1141 1032 1074 1022 1072 1022 1070 1022 1046 1032 942 1022 940 1022 869 1032 840 1022 838 1022 836 1022 769 1032 739 1022 736 1022 734 1022 732 1022 730 1022 719 1028 719 1065"/>
                        </Shape>
                        <String CONTENT="for the Anui fair (Plate II, Figs. 1, 2). One-fourth of these are Russians,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l9" HPOS="719" VPOS="1091" WIDTH="1769" HEIGHT="52" BASELINE="721 1125 2488 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="721 1125 721 1138 2484 1143 2488 1121 2484 1091 719 1091 721 1125"/>
                        </Shape>
                        <String CONTENT="Russianized natives, and Yakut, from settlements on the Anadyr, Kolyma,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l10" HPOS="719" VPOS="1136" WIDTH="1772" HEIGHT="65" BASELINE="721 1186 2491 1180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="721 1186 721 1201 2488 1195 2491 1180 2486 1149 2434 1136 2432 1136 2430 1136 2408 1147 2374 1136 2372 1136 2369 1136 2367 1136 2365 1136 2350 1149 2198 1149 2174 1136 2172 1136 2170 1136 2168 1136 2142 1147 2116 1136 2114 1136 2112 1136 2109 1136 2107 1136 2090 1149 1897 1149 1882 1138 1880 1138 1878 1138 1876 1138 1873 1138 1839 1149 1666 1138 1663 1138 1546 1149 1516 1138 1514 1138 1512 1138 1455 1149 1425 1138 1423 1138 1421 1138 1308 1151 1239 1141 1237 1141 899 1151 741 1141 739 1141 736 1141 734 1141 719 1149 721 1186"/>
                        </Shape>
                        <String CONTENT="Alaseya, and Indighirka; one-fourth are Kolyma Lamut; and the rest, Rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l11" HPOS="719" VPOS="1212" WIDTH="1774" HEIGHT="50" BASELINE="719 1242 2493 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1242 719 1262 2493 1262 2493 1242 2493 1212 719 1212 719 1242"/>
                        </Shape>
                        <String CONTENT="deer Chukchee and Kavraˊlɪt. Commerce has fallen off greatly, because American"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l12" HPOS="717" VPOS="1262" WIDTH="1774" HEIGHT="65" BASELINE="719 1307 2491 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1307 719 1327 2488 1316 2491 1301 2486 1271 1313 1262 1310 1262 1308 1262 1261 1273 771 1264 769 1264 717 1275 719 1307"/>
                        </Shape>
                        <String CONTENT="peltries have nearly ceased to come, and part of the peltries from the Asiatic"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l13" HPOS="717" VPOS="1322" WIDTH="1774" HEIGHT="59" BASELINE="719 1364 2491 1357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1364 719 1381 2488 1374 2491 1357 2486 1329 743 1322 741 1322 739 1322 717 1331 719 1364"/>
                        </Shape>
                        <String CONTENT="shore are bought by the whalers. Of the remainder, a large portion goes to"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l14" HPOS="717" VPOS="1381" WIDTH="1776" HEIGHT="58" BASELINE="719 1424 2493 1420" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1424 719 1439 2491 1435 2493 1420 2488 1387 739 1381 736 1381 734 1381 732 1381 717 1387 719 1424"/>
                        </Shape>
                        <String CONTENT="the Anadyr. Of late the total of the Anui trade has been, according to official"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l15" HPOS="717" VPOS="1442" WIDTH="1771" HEIGHT="60" BASELINE="719 1483 2488 1478" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1483 719 1502 2486 1502 2488 1478 2484 1450 739 1442 736 1442 734 1442 732 1442 717 1448 719 1483"/>
                        </Shape>
                        <String CONTENT="data, from twenty to twenty-five thousand rubles annually. Of this amount,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l16" HPOS="719" VPOS="1511" WIDTH="1772" HEIGHT="50" BASELINE="719 1543 2491 1543" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1543 719 1561 2491 1561 2491 1543 2491 1511 719 1511 719 1543"/>
                        </Shape>
                        <String CONTENT="two thirds is contributed by the Reindeer Chukchee; the remaining third belongs"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l17" HPOS="717" VPOS="1558" WIDTH="957" HEIGHT="61" BASELINE="719 1604 1674 1600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1604 719 1619 1672 1615 1674 1600 1670 1571 1347 1558 1345 1558 1343 1558 1341 1558 1330 1569 1308 1558 1306 1558 1304 1558 1302 1558 1271 1569 1241 1558 1239 1558 1237 1558 1137 1571 1105 1561 1102 1561 1100 1561 1033 1571 888 1561 886 1561 884 1561 840 1571 810 1561 808 1561 806 1561 717 1574 719 1604"/>
                        </Shape>
                        <String CONTENT="to the Lamut, Russianized Yukaghir, etc."/>
                    </TextLine>
<TextLine ID="mz_1-080_l18" HPOS="819" VPOS="1617" WIDTH="1674" HEIGHT="63" BASELINE="821 1662 2493 1658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="821 1662 821 1680 2491 1675 2493 1658 2488 1630 2437 1617 2434 1617 2432 1617 2406 1628 2352 1617 2350 1617 2133 1628 2058 1617 2055 1617 1973 1628 1921 1617 1919 1617 1856 1628 1826 1617 1824 1617 1821 1617 1819 1617 1793 1628 1700 1617 1698 1617 1696 1617 1650 1630 1581 1619 1579 1619 1577 1619 1549 1630 1486 1619 1484 1619 1375 1630 1347 1619 1345 1619 1343 1619 1341 1619 1297 1630 1254 1619 1252 1619 1250 1619 1248 1619 1245 1619 1230 1632 1131 1632 1005 1619 1003 1619 1001 1619 977 1630 843 1619 840 1619 838 1619 836 1619 819 1628 821 1662"/>
                        </Shape>
                        <String CONTENT="OTHER FAIRS. — At about the time of the founding of the Anui fair, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l19" HPOS="717" VPOS="1680" WIDTH="1774" HEIGHT="62" BASELINE="719 1725 2491 1717" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1725 719 1742 2488 1734 2491 1717 2486 1686 1170 1680 1167 1680 1098 1691 739 1682 736 1682 734 1682 732 1682 717 1688 719 1725"/>
                        </Shape>
                        <String CONTENT="Anadyr and the Telqäˊp Chukchee began to trade at Gishiginsk and Kamen-"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l20" HPOS="717" VPOS="1738" WIDTH="1771" HEIGHT="63" BASELINE="719 1784 2488 1779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1784 719 1801 2486 1797 2488 1779 2484 1749 1616 1738 1614 1738 1611 1738 1609 1738 1596 1749 745 1740 743 1740 741 1740 717 1749 719 1784"/>
                        </Shape>
                        <String CONTENT="skoye, on the Sea of Okhotsk. In the beginning of the century, simultaneously"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l21" HPOS="717" VPOS="1799" WIDTH="1774" HEIGHT="58" BASELINE="719 1842 2491 1838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1842 719 1857 2488 1853 2491 1838 2486 1810 1605 1799 1603 1799 1544 1810 760 1801 758 1801 756 1801 717 1812 719 1842"/>
                        </Shape>
                        <String CONTENT="with a spring fair for the Reindeer Koryak, was established another one for"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l22" HPOS="717" VPOS="1857" WIDTH="1774" HEIGHT="63" BASELINE="719 1905 2491 1898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1905 719 1920 2488 1914 2491 1898 2486 1870 2311 1870 2283 1857 2281 1857 2278 1857 2196 1868 2144 1857 2142 1857 2092 1868 2062 1857 2060 1857 2058 1857 2055 1857 2053 1857 2038 1870 1936 1870 1908 1857 1906 1857 1904 1857 1819 1870 1772 1859 1769 1859 1767 1859 1702 1870 1605 1859 1603 1859 1601 1859 1555 1870 1510 1859 1507 1859 1505 1859 1503 1859 1464 1870 1148 1862 1146 1862 1144 1862 1141 1862 1124 1872 910 1862 908 1862 799 1872 739 1862 736 1862 734 1862 732 1862 717 1870 719 1905"/>
                        </Shape>
                        <String CONTENT="the southwestern Chukchee on the Parapolsky Dol, not far from the upper"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l23" HPOS="717" VPOS="1916" WIDTH="1774" HEIGHT="69" BASELINE="719 1965 2491 1957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1965 719 1985 2488 1978 2491 1957 2486 1929 2135 1916 2133 1916 2131 1916 2092 1927 2064 1916 2062 1916 2060 1916 2058 1916 2055 1916 2038 1929 1702 1918 1700 1918 1698 1918 1670 1929 1425 1920 1423 1920 1421 1920 1382 1931 1339 1920 1336 1920 1334 1920 1265 1931 1161 1920 1159 1920 1157 1920 1113 1933 866 1922 864 1922 862 1922 825 1933 804 1922 801 1922 799 1922 717 1935 719 1965"/>
                        </Shape>
                        <String CONTENT="part of the river Opuka. In the village of Markova, on the Middle Anadyr,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l24" HPOS="717" VPOS="1976" WIDTH="1774" HEIGHT="70" BASELINE="719 2024 2491 2017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2024 719 2039 1897 2046 1899 2046 2488 2033 2491 2017 2486 1989 2417 1976 2415 1976 2413 1976 2387 1987 2135 1976 2133 1976 2131 1976 2129 1976 2114 1989 2023 1989 1997 1976 1995 1976 1993 1976 1990 1976 1988 1976 1971 1987 1899 1976 1897 1976 1895 1976 1847 1989 1653 1978 1650 1978 1648 1978 1646 1978 1629 1989 1601 1978 1598 1978 1596 1978 1507 1989 1445 1978 1442 1978 1440 1978 1406 1989 1356 1978 1354 1978 1235 1991 1170 1981 1167 1981 1165 1981 1133 1991 1005 1981 1003 1981 1001 1981 999 1981 983 1994 866 1994 793 1981 791 1981 717 1994 719 2024"/>
                        </Shape>
                        <String CONTENT="a fair was held, for the Anadyr and Oˊnmɪlɪn Chukchee. During the last"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l25" HPOS="717" VPOS="2039" WIDTH="1774" HEIGHT="61" BASELINE="719 2082 2491 2078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2082 719 2100 2488 2095 2491 2078 2486 2050 1605 2039 1603 2039 1601 2039 1557 2050 730 2041 728 2041 726 2041 723 2041 723 2043 717 2048 719 2082"/>
                        </Shape>
                        <String CONTENT="fifteen years, from the time of the institution of separate district administration"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l26" HPOS="717" VPOS="2108" WIDTH="1771" HEIGHT="61" BASELINE="719 2143 2488 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2143 719 2158 966 2169 968 2169 970 2169 973 2169 988 2158 2486 2158 2488 2137 2484 2108 717 2108 719 2143"/>
                        </Shape>
                        <String CONTENT="in Anadyr, three more fairs were opened, — one, the Tumanskaya fair, on"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l27" HPOS="715" VPOS="2167" WIDTH="1771" HEIGHT="58" BASELINE="717 2199 2486 2204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="717 2199 715 2212 840 2225 843 2225 2484 2221 2486 2204 2484 2171 717 2167 717 2199"/>
                        </Shape>
                        <String CONTENT="the west (Plate III, Fig. 1), near the mountain Iˊrg̣u-ñei (“pointed mountain”),"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l28" HPOS="715" VPOS="2214" WIDTH="1771" HEIGHT="70" BASELINE="717 2258 2486 2264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="717 2258 715 2275 728 2284 730 2284 732 2284 734 2284 2484 2282 2486 2264 2484 2232 2335 2219 2333 2219 1824 2227 1808 2217 1806 2217 1804 2217 1802 2217 1800 2217 1769 2227 1616 2217 1614 2217 1611 2217 1609 2217 1594 2230 1429 2230 1410 2217 1408 2217 1406 2217 1403 2217 1401 2217 1375 2227 1360 2217 1358 2217 1356 2217 1354 2217 1352 2217 1323 2227 1310 2214 1308 2214 1306 2214 1304 2214 1302 2214 1256 2225 1211 2214 1209 2214 1206 2214 717 2223 717 2258"/>
                        </Shape>
                        <String CONTENT="chiefly for the Telqäˊp Chukchee; another in the small village of Vaˊkarena,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l29" HPOS="719" VPOS="2279" WIDTH="1769" HEIGHT="63" BASELINE="719 2323 2488 2323" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2323 719 2336 2486 2342 2488 2323 2488 2292 2395 2279 2393 2279 2287 2290 1882 2279 1880 2279 1806 2290 1778 2279 1776 2279 1774 2279 1772 2279 1769 2279 1754 2292 1661 2292 1609 2279 1607 2279 1553 2290 1488 2279 1486 2279 1484 2279 1447 2290 1403 2279 1401 2279 1399 2279 1341 2290 1310 2279 1308 2279 1306 2279 1304 2279 1261 2290 1204 2279 1202 2279 1200 2279 1161 2290 1118 2279 1115 2279 1113 2279 1111 2279 1066 2290 1044 2279 1042 2279 918 2279 916 2279 860 2290 836 2279 834 2279 832 2279 719 2290 719 2323"/>
                        </Shape>
                        <String CONTENT="on the Middle Anadyr, for the Oˊnmɪlɪn; and a third on the Yeropol River,"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l30" HPOS="710" VPOS="2336" WIDTH="1776" HEIGHT="71" BASELINE="713 2379 2486 2383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="713 2379 710 2394 730 2405 732 2405 734 2405 1458 2396 1601 2407 1603 2407 2484 2396 2486 2383 2486 2351 2460 2338 2458 2338 2456 2338 2454 2338 2424 2349 2094 2338 2092 2338 2090 2338 2088 2338 2073 2351 1958 2351 1928 2338 1925 2338 1923 2338 1921 2338 1878 2349 1854 2338 1852 2338 1850 2338 1793 2349 1765 2338 1763 2338 1761 2338 1759 2338 1756 2338 1741 2349 1718 2338 1715 2338 1713 2338 1711 2338 1709 2338 1694 2351 1603 2351 1581 2336 1579 2336 1577 2336 1575 2336 1572 2336 1549 2347 1488 2336 1486 2336 1484 2336 1460 2347 1343 2336 1341 2336 1287 2347 1239 2336 1237 2336 1235 2336 1150 2347 1050 2336 1048 2336 1046 2336 1044 2336 1029 2347 1003 2336 1001 2336 999 2336 996 2336 994 2336 981 2347 953 2336 951 2336 949 2336 713 2344 713 2379"/>
                        </Shape>
                        <String CONTENT="for the Chukchee of the Upper Anadyr and for the Lamut (Plate III, Fig. 2)."/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l31" HPOS="721" VPOS="2405" WIDTH="1770" HEIGHT="54" BASELINE="721 2440 2491 2440" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="721 2440 721 2459 2491 2459 2491 2440 2491 2411 721 2405 721 2440"/>
                        </Shape>
                        <String CONTENT="The extent of trade in the Anadyr region, however, is by no means sufficient"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l32" HPOS="717" VPOS="2461" WIDTH="1774" HEIGHT="57" BASELINE="719 2502 2491 2498" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2502 719 2518 2488 2513 2491 2498 2486 2466 734 2461 732 2461 730 2461 728 2461 717 2468 719 2502"/>
                        </Shape>
                        <String CONTENT="to support all these fairs, the annual receipts being about twenty thousand"/>
                    </TextLine>

                    <TextLine ID="mz_1-080_l33" HPOS="715" VPOS="2522" WIDTH="1776" HEIGHT="56" BASELINE="717 2563 2491 2557" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="717 2563 717 2578 2488 2572 2491 2557 2486 2528 765 2522 762 2522 760 2522 715 2533 717 2563"/>
                        </Shape>
                        <String CONTENT="rubles. In 1901, on account of heavy snows, only two Telqäˊp camps went"/>
                    </TextLine>

