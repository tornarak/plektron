                        <Shape>
                            <Polygon POINTS="645 772 645 788 2416 783 2419 768 2412 736 1858 738 1790 727 1788 727 1786 727 1741 738 1710 727 1708 727 1706 727 1704 727 1669 738 1604 727 1602 727 1600 727 1576 738 1533 727 1531 727 1528 727 1526 727 1524 727 1502 740 1245 729 1243 729 1240 729 1219 740 1191 729 1188 729 1186 729 1087 740 981 729 978 729 976 729 929 740 848 729 846 729 844 729 842 729 827 742 727 742 660 729 658 729 656 729 654 729 643 736 645 772"/>
                        </Shape>
                        <String CONTENT="fire, cut into pieces, and thrown into the blood. The guts are also chopped"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l4" HPOS="643" VPOS="788" WIDTH="1776" HEIGHT="58" BASELINE="645 833 2419 829" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 833 645 846 2416 844 2419 829 2414 798 1570 788 1567 788 1565 788 1520 798 716 790 714 790 643 801 645 833"/>
                        </Shape>
                        <String CONTENT="and thrown into the blood. The same is done with fish-heads and such bits"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l5" HPOS="643" VPOS="848" WIDTH="1773" HEIGHT="59" BASELINE="645 891 2416 887" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 891 645 907 2414 904 2416 887 2412 859 1531 848 1528 848 1526 848 1492 859 684 850 682 850 680 850 643 861 645 891"/>
                        </Shape>
                        <String CONTENT="of meat as are not consumed immediately. This mixture does not readily"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l6" HPOS="647" VPOS="915" WIDTH="1767" HEIGHT="54" BASELINE="647 952 2414 952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 952 647 969 2412 969 2414 952 2412 922 647 915 647 952"/>
                        </Shape>
                        <String CONTENT="become putrid, on account of the fermentation that is going on in the blood."/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l7" HPOS="643" VPOS="974" WIDTH="1773" HEIGHT="54" BASELINE="645 1011 2416 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1011 645 1028 2414 1021 2416 1004 2410 974 643 978 645 1011"/>
                        </Shape>
                        <String CONTENT="Bags filled with fermented blood, and putrid meat of slaughtered or dead"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l8" HPOS="643" VPOS="1030" WIDTH="1773" HEIGHT="56" BASELINE="645 1073 2416 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1073 645 1086 2414 1080 2416 1067 2412 1039 1236 1030 1234 1030 1232 1030 1197 1041 701 1032 699 1032 643 1043 645 1073"/>
                        </Shape>
                        <String CONTENT="animals, are stored up by thrifty families for winter use. These stores are"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l9" HPOS="643" VPOS="1088" WIDTH="1771" HEIGHT="65" BASELINE="645 1134 2414 1125" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1134 645 1153 2412 1143 2414 1125 2410 1095 1087 1088 1084 1088 1082 1088 1041 1099 734 1091 731 1091 643 1101 645 1134"/>
                        </Shape>
                        <String CONTENT="gradually consumed during the cold season, although the Chukchee prefer to"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l10" HPOS="645" VPOS="1149" WIDTH="1730" HEIGHT="56" BASELINE="647 1190 2375 1188" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1190 647 1205 2373 1203 2375 1188 2371 1160 753 1149 751 1149 645 1160 647 1190"/>
                        </Shape>
                        <String CONTENT="use fresh meat, and sell them at a low price to the Russians for dog-food."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r3" HPOS="629" VPOS="1214" WIDTH="1778" HEIGHT="480" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="629 1214 2407 1214 2407 1694 629 1694"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l11" HPOS="755" VPOS="1216" WIDTH="1659" HEIGHT="52" BASELINE="757 1253 2414 1247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 1253 757 1268 2412 1262 2414 1247 2410 1216 755 1216 757 1253"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee store away bags of seal-blood prepared in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l12" HPOS="643" VPOS="1266" WIDTH="1773" HEIGHT="63" BASELINE="645 1314 2416 1305" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1314 645 1329 2414 1320 2416 1305 2412 1277 1972 1266 1970 1266 1968 1266 1942 1277 1115 1270 1113 1270 1110 1270 1082 1281 998 1273 996 1273 643 1283 645 1314"/>
                        </Shape>
                        <String CONTENT="same manner, but their supply is not so abundant as that of the reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l13" HPOS="643" VPOS="1327" WIDTH="1773" HEIGHT="60" BASELINE="645 1372 2416 1366" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1372 645 1387 2414 1381 2416 1366 2412 1337 2005 1327 2003 1327 1821 1340 643 1340 645 1372"/>
                        </Shape>
                        <String CONTENT="breeders. Walrus-meat, whale-skin, and the like, are cut into square pieces"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l14" HPOS="643" VPOS="1389" WIDTH="1773" HEIGHT="59" BASELINE="645 1433 2416 1424" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1433 645 1448 2414 1441 2416 1424 2412 1396 1087 1389 1084 1389 1028 1400 712 1392 710 1392 643 1402 645 1433"/>
                        </Shape>
                        <String CONTENT="and stored in underground cellars. Whole carcasses of seals and walruses"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l15" HPOS="645" VPOS="1461" WIDTH="1769" HEIGHT="48" BASELINE="645 1491 2414 1491" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1491 645 1506 2412 1509 2414 1491 2414 1461 645 1461 645 1491"/>
                        </Shape>
                        <String CONTENT="are often stored for several months, and afterwards eaten or used for dog-food,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l16" HPOS="645" VPOS="1513" WIDTH="1769" HEIGHT="54" BASELINE="645 1550 2414 1550" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1550 645 1567 2414 1567 2414 1550 2412 1513 645 1517 645 1550"/>
                        </Shape>
                        <String CONTENT="although they generally become quite putrid. Blubber is stored in bags. Oil"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l17" HPOS="645" VPOS="1578" WIDTH="1769" HEIGHT="58" BASELINE="645 1610 2414 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1610 645 1625 1078 1625 1149 1636 1152 1636 1271 1625 1366 1636 1368 1636 1570 1625 2252 1636 2254 1636 2256 1636 2258 1636 2273 1625 2414 1625 2414 1610 2414 1580 645 1578 645 1610"/>
                        </Shape>
                        <String CONTENT="is extracted from chopped or pounded blubber by protracted boiling. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l18" HPOS="643" VPOS="1625" WIDTH="1620" HEIGHT="61" BASELINE="645 1671 2263 1667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1671 645 1686 2260 1682 2263 1667 2258 1638 2191 1625 2189 1625 2187 1625 2163 1636 1994 1625 1992 1625 1920 1636 1897 1625 1894 1625 1760 1625 1758 1625 1678 1636 1626 1625 1624 1625 1622 1625 1591 1636 1539 1625 1537 1625 1535 1625 1502 1636 1453 1625 1450 1625 1448 1625 1446 1625 1429 1638 1342 1628 1340 1628 1338 1628 1314 1638 1275 1628 1273 1628 1271 1628 1269 1628 1243 1638 1145 1628 1143 1628 1141 1628 1097 1638 1033 1628 1030 1628 1028 1628 994 1641 877 1641 861 1628 859 1628 857 1628 855 1628 853 1628 820 1638 760 1628 757 1628 643 1636 645 1671"/>
                        </Shape>
                        <String CONTENT="blubber is not chewed, as is done by the Central Eskimo in America."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r4" HPOS="629" VPOS="1694" WIDTH="1778" HEIGHT="839" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="629 1694 2407 1694 2407 2533 629 2533"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l19" HPOS="751" VPOS="1686" WIDTH="1665" HEIGHT="61" BASELINE="753 1732 2416 1727" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="753 1732 753 1747 2414 1742 2416 1727 2412 1697 1585 1686 1583 1686 1580 1686 1578 1686 1561 1699 751 1699 753 1732"/>
                        </Shape>
                        <String CONTENT="In spring, about the middle of April, the Reindeer Chukchee dry some"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l20" HPOS="643" VPOS="1744" WIDTH="1773" HEIGHT="72" BASELINE="645 1792 2416 1786" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1792 645 1805 1173 1805 1230 1816 1232 1816 1292 1803 1533 1814 1535 1814 1591 1803 1674 1814 1676 1814 1678 1814 1680 1814 1695 1803 1728 1814 1730 1814 1732 1814 1931 1801 1962 1812 1964 1812 1966 1812 2414 1801 2416 1786 2412 1757 2237 1757 2211 1744 2208 1744 2206 1744 2204 1744 2182 1755 2159 1744 2156 1744 2154 1744 2057 1755 2020 1744 2018 1744 2016 1744 1940 1755 1910 1744 1907 1744 1905 1744 1903 1744 1871 1755 1836 1744 1834 1744 1832 1744 1767 1757 1448 1747 1446 1747 1379 1757 1344 1747 1342 1747 1340 1747 1230 1760 684 1749 682 1749 680 1749 643 1760 645 1792"/>
                        </Shape>
                        <String CONTENT="of their meat in the open air. Under the combined action of the warm"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l21" HPOS="641" VPOS="1814" WIDTH="1773" HEIGHT="54" BASELINE="643 1853 2414 1846" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 1853 643 1868 2412 1864 2414 1846 2408 1814 641 1816 643 1853"/>
                        </Shape>
                        <String CONTENT="breezes of noon and the frost of night, quite large pieces become thoroughly"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l22" HPOS="641" VPOS="1868" WIDTH="1771" HEIGHT="58" BASELINE="643 1913 2412 1907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 1913 643 1926 2410 1924 2412 1907 2408 1877 1232 1868 1230 1868 1149 1879 660 1870 658 1870 656 1870 654 1870 641 1877 643 1913"/>
                        </Shape>
                        <String CONTENT="dry, and keep much of their savor and softness. The dried meat is slightly"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l23" HPOS="643" VPOS="1924" WIDTH="1769" HEIGHT="65" BASELINE="645 1972 2412 1967" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1972 645 1985 2408 1989 2412 1967 2410 1937 2369 1924 2367 1924 2364 1924 2308 1935 2263 1924 2260 1924 2258 1924 1879 1935 1823 1924 1821 1924 1819 1924 1790 1935 1745 1924 1743 1924 1741 1924 1682 1935 1667 1924 1665 1924 1663 1924 1561 1924 1559 1924 1557 1924 1522 1939 1364 1939 1338 1926 1336 1926 1334 1926 1331 1926 1290 1937 1260 1926 1258 1926 1256 1926 1253 1926 1221 1937 1195 1926 1193 1926 1191 1926 1113 1937 1084 1926 1082 1926 1080 1926 1078 1926 1046 1937 996 1926 994 1926 991 1926 989 1926 970 1939 835 1939 738 1926 736 1926 643 1939 645 1972"/>
                        </Shape>
                        <String CONTENT="smoked over the hearth in the tent. Unlike the Lamut and the Yukaghir,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l24" HPOS="645" VPOS="2000" WIDTH="1769" HEIGHT="45" BASELINE="645 2030 2414 2030" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2030 645 2045 2414 2045 2414 2030 2414 2000 645 2000 645 2030"/>
                        </Shape>
                        <String CONTENT="the Reindeer Chukchee do not care to dry meat in summer, because at that"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l25" HPOS="643" VPOS="2048" WIDTH="1771" HEIGHT="58" BASELINE="645 2091 2414 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2091 645 2106 2412 2102 2414 2087 2410 2058 1528 2048 1526 2048 1524 2048 1492 2058 833 2050 831 2050 643 2061 645 2091"/>
                        </Shape>
                        <String CONTENT="season the meat must be cut into thin strips and strung on lines, which is"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l26" HPOS="643" VPOS="2106" WIDTH="1771" HEIGHT="59" BASELINE="645 2149 2414 2145" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2149 645 2165 2412 2162 2414 2145 2410 2117 1561 2106 1559 2106 1457 2117 744 2108 742 2108 643 2119 645 2149"/>
                        </Shape>
                        <String CONTENT="considered too much work. The Maritime people dry some seal-meat in"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l27" HPOS="645" VPOS="2165" WIDTH="1765" HEIGHT="62" BASELINE="647 2210 2410 2206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2210 647 2227 2408 2223 2410 2206 2408 2177 2373 2165 2371 2165 2369 2165 2367 2165 2343 2175 1868 2165 1866 2165 1782 2175 1743 2165 1741 2165 1739 2165 1736 2165 1734 2165 1715 2177 1606 2177 1572 2165 1570 2165 1567 2165 1565 2165 1513 2177 1165 2167 1162 2167 1160 2167 1136 2177 1113 2167 1110 2167 1108 2167 1106 2167 1104 2167 1089 2177 1022 2167 1020 2167 1017 2167 983 2177 948 2167 946 2167 944 2167 942 2167 939 2167 926 2177 887 2167 885 2167 883 2167 881 2167 879 2167 864 2180 645 2180 647 2210"/>
                        </Shape>
                        <String CONTENT="summer. It is sliced thin and hung on long poles, which form a drying-rack."/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l28" HPOS="647" VPOS="2229" WIDTH="1767" HEIGHT="55" BASELINE="649 2264 2414 2268" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2264 647 2279 2410 2284 2414 2268 2412 2232 649 2229 649 2264"/>
                        </Shape>
                        <String CONTENT="Whenever a whale drifts ashore, quantities of whale-meat are sliced thin and"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l29" HPOS="643" VPOS="2297" WIDTH="1771" HEIGHT="49" BASELINE="645 2331 2414 2327" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2331 645 2346 2412 2342 2414 2327 2410 2299 643 2297 645 2331"/>
                        </Shape>
                        <String CONTENT="hung on poles or strung on lines, or, if the weather is favorable, spread on"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l30" HPOS="645" VPOS="2359" WIDTH="1769" HEIGHT="46" BASELINE="645 2390 2414 2390" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2390 645 2405 2414 2405 2414 2390 2414 2359 645 2359 645 2390"/>
                        </Shape>
                        <String CONTENT="skins or on dry smooth rocks. The Chukchee fishermen at the mouth of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l31" HPOS="645" VPOS="2418" WIDTH="1767" HEIGHT="52" BASELINE="645 2450 2412 2450" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2450 645 2463 2408 2470 2412 2450 2410 2418 645 2418 645 2450"/>
                        </Shape>
                        <String CONTENT="Anadyr dry their fish on racks made in imitation of those of their neighbors,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l32" HPOS="641" VPOS="2472" WIDTH="550" HEIGHT="54" BASELINE="643 2511 1191 2504" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 2511 643 2526 1191 2520 1191 2504 1184 2472 641 2476 643 2511"/>
                        </Shape>
                        <String CONTENT="the Russianized natives."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r5" HPOS="629" VPOS="2533" WIDTH="1778" HEIGHT="231" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="629 2533 2407 2533 2407 2764 629 2764"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l33" HPOS="755" VPOS="2526" WIDTH="1659" HEIGHT="59" BASELINE="755 2567 2414 2567" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="755 2567 755 2585 2414 2585 2414 2567 2414 2535 755 2526 755 2567"/>
                        </Shape>
                        <String CONTENT="The drying is done very carelessly. The meat or fish is seldom protected"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l34" HPOS="641" VPOS="2585" WIDTH="1773" HEIGHT="69" BASELINE="643 2630 2414 2626" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 2630 643 2643 1219 2643 1312 2654 1314 2654 1316 2654 1318 2654 1334 2643 1803 2652 1806 2652 1994 2641 2098 2652 2100 2652 2102 2652 2126 2641 2219 2652 2221 2652 2224 2652 2245 2641 2317 2652 2319 2652 2321 2652 2343 2641 2393 2652 2395 2652 2397 2652 2399 2652 2414 2639 2414 2626 2410 2595 1528 2585 1526 2585 1524 2585 1522 2585 1509 2595 654 2587 651 2587 649 2587 647 2587 647 2589 641 2593 643 2630"/>
                        </Shape>
                        <String CONTENT="from rain. It becomes soft, and so full of maggots that often they can be"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l35" HPOS="641" VPOS="2643" WIDTH="1771" HEIGHT="67" BASELINE="643 2693 2412 2686" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 2693 643 2710 2410 2699 2412 2686 2408 2654 1821 2643 1819 2643 1749 2654 714 2647 712 2647 641 2658 643 2693"/>
                        </Shape>
                        <String CONTENT="gathered by the handful on the ground below. When it is at last dry, it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l36" HPOS="643" VPOS="2719" WIDTH="966" HEIGHT="54" BASELINE="643 2749 1609 2749" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 2749 643 2773 1609 2762 1609 2749 1609 2719 643 2719 643 2749"/>
                        </Shape>
                        <String CONTENT="as hard as wood, and almost as tasteless."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r6" HPOS="629" VPOS="2764" WIDTH="1778" HEIGHT="428" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="629 2764 2407 2764 2407 3192 629 3192"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l37" HPOS="753" VPOS="2771" WIDTH="1659" HEIGHT="52" BASELINE="755 2808 2412 2803" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="755 2808 755 2823 2410 2818 2412 2803 2408 2775 753 2771 755 2808"/>
                        </Shape>
                        <String CONTENT="TABOOS. — There are several restrictions connected with animal food."/>
                    </TextLine>

