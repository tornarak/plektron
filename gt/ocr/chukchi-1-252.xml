                    </TextLine>

                    <TextLine ID="mz_1-252_l5" HPOS="622" VPOS="833" WIDTH="1773" HEIGHT="59" BASELINE="624 876 2395 872" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 876 624 892 2393 889 2395 872 2391 844 1510 833 1507 833 1505 833 1471 844 663 835 661 835 659 835 622 846 624 876"/>
                        </Shape>
                        <String CONTENT="of meat as are not consumed immediately. This mixture does not readily"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l6" HPOS="626" VPOS="900" WIDTH="1767" HEIGHT="54" BASELINE="626 937 2393 937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 937 626 954 2391 954 2393 937 2391 907 626 900 626 937"/>
                        </Shape>
