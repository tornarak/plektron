                    <TextLine ID="mz_1-252_l19" HPOS="730" VPOS="1671" WIDTH="1665" HEIGHT="61" BASELINE="732 1717 2395 1712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="732 1717 732 1732 2393 1727 2395 1712 2391 1682 1564 1671 1562 1671 1559 1671 1557 1671 1540 1684 730 1684 732 1717"/>
                        </Shape>
                        <String CONTENT="In spring, about the middle of April, the Reindeer Chukchee dry some"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l20" HPOS="622" VPOS="1729" WIDTH="1773" HEIGHT="72" BASELINE="624 1777 2395 1771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1777 624 1790 1152 1790 1209 1801 1211 1801 1271 1788 1512 1799 1514 1799 1570 1788 1653 1799 1655 1799 1657 1799 1659 1799 1674 1788 1707 1799 1709 1799 1711 1799 1910 1786 1941 1797 1943 1797 1945 1797 2393 1786 2395 1771 2391 1742 2216 1742 2190 1729 2187 1729 2185 1729 2183 1729 2161 1740 2138 1729 2135 1729 2133 1729 2036 1740 1999 1729 1997 1729 1995 1729 1919 1740 1889 1729 1886 1729 1884 1729 1882 1729 1850 1740 1815 1729 1813 1729 1811 1729 1746 1742 1427 1732 1425 1732 1358 1742 1323 1732 1321 1732 1319 1732 1209 1745 663 1734 661 1734 659 1734 622 1745 624 1777"/>
                        </Shape>
                        <String CONTENT="of their meat in the open air. Under the combined action of the warm"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l21" HPOS="620" VPOS="1799" WIDTH="1773" HEIGHT="54" BASELINE="622 1838 2393 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 1838 622 1853 2391 1849 2393 1831 2387 1799 620 1801 622 1838"/>
                        </Shape>
                        <String CONTENT="breezes of noon and the frost of night, quite large pieces become thoroughly"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l22" HPOS="620" VPOS="1853" WIDTH="1771" HEIGHT="58" BASELINE="622 1898 2391 1892" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 1898 622 1911 2389 1909 2391 1892 2387 1862 1211 1853 1209 1853 1128 1864 639 1855 637 1855 635 1855 633 1855 620 1862 622 1898"/>
                        </Shape>
                        <String CONTENT="dry, and keep much of their savor and softness. The dried meat is slightly"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l23" HPOS="622" VPOS="1909" WIDTH="1769" HEIGHT="65" BASELINE="624 1957 2391 1952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1957 624 1970 2387 1974 2391 1952 2389 1922 2348 1909 2346 1909 2343 1909 2287 1920 2242 1909 2239 1909 2237 1909 1858 1920 1802 1909 1800 1909 1798 1909 1769 1920 1724 1909 1722 1909 1720 1909 1661 1920 1646 1909 1644 1909 1642 1909 1540 1909 1538 1909 1536 1909 1501 1924 1343 1924 1317 1911 1315 1911 1313 1911 1310 1911 1269 1922 1239 1911 1237 1911 1235 1911 1232 1911 1200 1922 1174 1911 1172 1911 1170 1911 1092 1922 1063 1911 1061 1911 1059 1911 1057 1911 1025 1922 975 1911 973 1911 970 1911 968 1911 949 1924 814 1924 717 1911 715 1911 622 1924 624 1957"/>
                        </Shape>
                        <String CONTENT="smoked over the hearth in the tent. Unlike the Lamut and the Yukaghir,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l24" HPOS="624" VPOS="1985" WIDTH="1769" HEIGHT="45" BASELINE="624 2015 2393 2015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2015 624 2030 2393 2030 2393 2015 2393 1985 624 1985 624 2015"/>
                        </Shape>
                        <String CONTENT="the Reindeer Chukchee do not care to dry meat in summer, because at that"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l25" HPOS="622" VPOS="2033" WIDTH="1771" HEIGHT="58" BASELINE="624 2076 2393 2072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2076 624 2091 2391 2087 2393 2072 2389 2043 1507 2033 1505 2033 1503 2033 1471 2043 812 2035 810 2035 622 2046 624 2076"/>
                        </Shape>
                        <String CONTENT="season the meat must be cut into thin strips and strung on lines, which is"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l26" HPOS="622" VPOS="2091" WIDTH="1771" HEIGHT="59" BASELINE="624 2134 2393 2130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2134 624 2150 2391 2147 2393 2130 2389 2102 1540 2091 1538 2091 1436 2102 723 2093 721 2093 622 2104 624 2134"/>
                        </Shape>
                        <String CONTENT="considered too much work. The Maritime people dry some seal-meat in"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l27" HPOS="624" VPOS="2150" WIDTH="1765" HEIGHT="62" BASELINE="626 2195 2389 2191" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2195 626 2212 2387 2208 2389 2191 2387 2162 2352 2150 2350 2150 2348 2150 2346 2150 2322 2160 1847 2150 1845 2150 1761 2160 1722 2150 1720 2150 1718 2150 1715 2150 1713 2150 1694 2162 1585 2162 1551 2150 1549 2150 1546 2150 1544 2150 1492 2162 1144 2152 1141 2152 1139 2152 1115 2162 1092 2152 1089 2152 1087 2152 1085 2152 1083 2152 1068 2162 1001 2152 999 2152 996 2152 962 2162 927 2152 925 2152 923 2152 921 2152 918 2152 905 2162 866 2152 864 2152 862 2152 860 2152 858 2152 843 2165 624 2165 626 2195"/>
                        </Shape>
                        <String CONTENT="summer. It is sliced thin and hung on long poles, which form a drying-rack."/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l28" HPOS="626" VPOS="2214" WIDTH="1767" HEIGHT="55" BASELINE="628 2249 2393 2253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2249 626 2264 2389 2269 2393 2253 2391 2217 628 2214 628 2249"/>
                        </Shape>
                        <String CONTENT="Whenever a whale drifts ashore, quantities of whale-meat are sliced thin and"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l29" HPOS="622" VPOS="2282" WIDTH="1771" HEIGHT="49" BASELINE="624 2316 2393 2312" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2316 624 2331 2391 2327 2393 2312 2389 2284 622 2282 624 2316"/>
                        </Shape>
                        <String CONTENT="hung on poles or strung on lines, or, if the weather is favorable, spread on"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l30" HPOS="624" VPOS="2344" WIDTH="1769" HEIGHT="46" BASELINE="624 2375 2393 2375" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2375 624 2390 2393 2390 2393 2375 2393 2344 624 2344 624 2375"/>
                        </Shape>
                        <String CONTENT="skins or on dry smooth rocks. The Chukchee fishermen at the mouth of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l31" HPOS="624" VPOS="2403" WIDTH="1767" HEIGHT="52" BASELINE="624 2435 2391 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2435 624 2448 2387 2455 2391 2435 2389 2403 624 2403 624 2435"/>
                        </Shape>
                        <String CONTENT="Anadyr dry their fish on racks made in imitation of those of their neighbors,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l32" HPOS="620" VPOS="2457" WIDTH="550" HEIGHT="54" BASELINE="622 2496 1170 2489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2496 622 2511 1170 2505 1170 2489 1163 2457 620 2461 622 2496"/>
                        </Shape>
                        <String CONTENT="the Russianized natives."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r5" HPOS="608" VPOS="2518" WIDTH="1778" HEIGHT="231" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="608 2518 2386 2518 2386 2749 608 2749"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l33" HPOS="734" VPOS="2511" WIDTH="1659" HEIGHT="59" BASELINE="734 2552 2393 2552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2552 734 2570 2393 2570 2393 2552 2393 2520 734 2511 734 2552"/>
                        </Shape>
                        <String CONTENT="The drying is done very carelessly. The meat or fish is seldom protected"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l34" HPOS="620" VPOS="2570" WIDTH="1773" HEIGHT="69" BASELINE="622 2615 2393 2611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2615 622 2628 1198 2628 1291 2639 1293 2639 1295 2639 1297 2639 1313 2628 1782 2637 1785 2637 1973 2626 2077 2637 2079 2637 2081 2637 2105 2626 2198 2637 2200 2637 2203 2637 2224 2626 2296 2637 2298 2637 2300 2637 2322 2626 2372 2637 2374 2637 2376 2637 2378 2637 2393 2624 2393 2611 2389 2580 1507 2570 1505 2570 1503 2570 1501 2570 1488 2580 633 2572 630 2572 628 2572 626 2572 626 2574 620 2578 622 2615"/>
                        </Shape>
                        <String CONTENT="from rain. It becomes soft, and so full of maggots that often they can be"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l35" HPOS="620" VPOS="2628" WIDTH="1771" HEIGHT="67" BASELINE="622 2678 2391 2671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2678 622 2695 2389 2684 2391 2671 2387 2639 1800 2628 1798 2628 1728 2639 693 2632 691 2632 620 2643 622 2678"/>
                        </Shape>
                        <String CONTENT="gathered by the handful on the ground below. When it is at last dry, it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l36" HPOS="622" VPOS="2704" WIDTH="966" HEIGHT="54" BASELINE="622 2734 1588 2734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2734 622 2758 1588 2747 1588 2734 1588 2704 622 2704 622 2734"/>
                        </Shape>
                        <String CONTENT="as hard as wood, and almost as tasteless."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r6" HPOS="608" VPOS="2749" WIDTH="1778" HEIGHT="428" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="608 2749 2386 2749 2386 3177 608 3177"/>
                    </Shape>
