                        <Shape>
                            <Polygon POINTS="734 2793 734 2808 2389 2803 2391 2788 2387 2760 732 2756 734 2793"/>
                        </Shape>
                        <String CONTENT="TABOOS. — There are several restrictions connected with animal food."/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l38" HPOS="624" VPOS="2810" WIDTH="1767" HEIGHT="60" BASELINE="624 2853 2391 2853" TAGREFS="TYPE_4">
