                    </TextLine>

                    <TextLine ID="mz_1-252_l7" HPOS="622" VPOS="959" WIDTH="1773" HEIGHT="54" BASELINE="624 996 2395 989" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 996 624 1013 2393 1006 2395 989 2389 959 622 963 624 996"/>
                        </Shape>
                        <String CONTENT="Bags filled with fermented blood, and putrid meat of slaughtered or dead"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l8" HPOS="622" VPOS="1015" WIDTH="1773" HEIGHT="56" BASELINE="624 1058 2395 1052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1058 624 1071 2393 1065 2395 1052 2391 1024 1215 1015 1213 1015 1211 1015 1176 1026 680 1017 678 1017 622 1028 624 1058"/>
                        </Shape>
                        <String CONTENT="animals, are stored up by thrifty families for winter use. These stores are"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l9" HPOS="622" VPOS="1073" WIDTH="1771" HEIGHT="65" BASELINE="624 1119 2393 1110" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1119 624 1138 2391 1128 2393 1110 2389 1080 1066 1073 1063 1073 1061 1073 1020 1084 713 1076 710 1076 622 1086 624 1119"/>
                        </Shape>
                        <String CONTENT="gradually consumed during the cold season, although the Chukchee prefer to"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l10" HPOS="624" VPOS="1134" WIDTH="1730" HEIGHT="56" BASELINE="626 1175 2354 1173" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1175 626 1190 2352 1188 2354 1173 2350 1145 732 1134 730 1134 624 1145 626 1175"/>
                        </Shape>
                        <String CONTENT="use fresh meat, and sell them at a low price to the Russians for dog-food."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-252_r3" HPOS="608" VPOS="1199" WIDTH="1778" HEIGHT="480" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="608 1199 2386 1199 2386 1679 608 1679"/>
                    </Shape>
                    <TextLine ID="mz_1-252_l11" HPOS="734" VPOS="1201" WIDTH="1659" HEIGHT="52" BASELINE="736 1238 2393 1232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1238 736 1253 2391 1247 2393 1232 2389 1201 734 1201 736 1238"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee store away bags of seal-blood prepared in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l12" HPOS="622" VPOS="1251" WIDTH="1773" HEIGHT="63" BASELINE="624 1299 2395 1290" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1299 624 1314 2393 1305 2395 1290 2391 1262 1951 1251 1949 1251 1947 1251 1921 1262 1094 1255 1092 1255 1089 1255 1061 1266 977 1258 975 1258 622 1268 624 1299"/>
                        </Shape>
                        <String CONTENT="same manner, but their supply is not so abundant as that of the reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l13" HPOS="622" VPOS="1312" WIDTH="1773" HEIGHT="60" BASELINE="624 1357 2395 1351" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1357 624 1372 2393 1366 2395 1351 2391 1322 1984 1312 1982 1312 1800 1325 622 1325 624 1357"/>
                        </Shape>
                        <String CONTENT="breeders. Walrus-meat, whale-skin, and the like, are cut into square pieces"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l14" HPOS="622" VPOS="1374" WIDTH="1773" HEIGHT="59" BASELINE="624 1418 2395 1409" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1418 624 1433 2393 1426 2395 1409 2391 1381 1066 1374 1063 1374 1007 1385 691 1377 689 1377 622 1387 624 1418"/>
                        </Shape>
                        <String CONTENT="and stored in underground cellars. Whole carcasses of seals and walruses"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l15" HPOS="624" VPOS="1446" WIDTH="1769" HEIGHT="48" BASELINE="624 1476 2393 1476" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1476 624 1491 2391 1494 2393 1476 2393 1446 624 1446 624 1476"/>
                        </Shape>
                        <String CONTENT="are often stored for several months, and afterwards eaten or used for dog-food,"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l16" HPOS="624" VPOS="1498" WIDTH="1769" HEIGHT="54" BASELINE="624 1535 2393 1535" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1535 624 1552 2393 1552 2393 1535 2391 1498 624 1502 624 1535"/>
                        </Shape>
                        <String CONTENT="although they generally become quite putrid. Blubber is stored in bags. Oil"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l17" HPOS="624" VPOS="1563" WIDTH="1769" HEIGHT="58" BASELINE="624 1595 2393 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1595 624 1610 1057 1610 1128 1621 1131 1621 1250 1610 1345 1621 1347 1621 1549 1610 2231 1621 2233 1621 2235 1621 2237 1621 2252 1610 2393 1610 2393 1595 2393 1565 624 1563 624 1595"/>
                        </Shape>
                        <String CONTENT="is extracted from chopped or pounded blubber by protracted boiling. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-252_l18" HPOS="622" VPOS="1610" WIDTH="1620" HEIGHT="61" BASELINE="624 1656 2242 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1656 624 1671 2239 1667 2242 1652 2237 1623 2170 1610 2168 1610 2166 1610 2142 1621 1973 1610 1971 1610 1899 1621 1876 1610 1873 1610 1739 1610 1737 1610 1657 1621 1605 1610 1603 1610 1601 1610 1570 1621 1518 1610 1516 1610 1514 1610 1481 1621 1432 1610 1429 1610 1427 1610 1425 1610 1408 1623 1321 1613 1319 1613 1317 1613 1293 1623 1254 1613 1252 1613 1250 1613 1248 1613 1222 1623 1124 1613 1122 1613 1120 1613 1076 1623 1012 1613 1009 1613 1007 1613 973 1626 856 1626 840 1613 838 1613 836 1613 834 1613 832 1613 799 1623 739 1613 736 1613 622 1621 624 1656"/>
                        </Shape>
                        <String CONTENT="blubber is not chewed, as is done by the Central Eskimo in America."/>
                    </TextLine>
