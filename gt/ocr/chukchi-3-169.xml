                        </Shape>
                        <String CONTENT="presented with a crimson coat, and with a parade dagger bearing the inscription"/>
                    </TextLine>

                    <TextLine ID="mz_3-169_l13" HPOS="376" VPOS="1172" WIDTH="1769" HEIGHT="55" BASELINE="376 1209 2145 1209" TAGREFS="TYPE_6">
