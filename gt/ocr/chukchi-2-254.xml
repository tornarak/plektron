                        </Shape>
                        <String CONTENT="“They ask the corpse, ‘Will the disease come again afterward?’ and then"/>
                    </TextLine>

                    <TextLine ID="mz_2-254_l21" HPOS="340" VPOS="1656" WIDTH="1765" HEIGHT="63" BASELINE="342 1697 2105 1701" TAGREFS="TYPE_5">
                        <Shape>
