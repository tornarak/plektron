                        </Shape>
                        <String CONTENT="‘Maybe you want to walk?’ He said, ‘I will walk, but you must give me a"/>
                    </TextLine>

                    <TextLine ID="mz_2-254_l8" HPOS="352" VPOS="887" WIDTH="1759" HEIGHT="47" BASELINE="352 914 2111 918" TAGREFS="TYPE_5">
                        <Shape>
