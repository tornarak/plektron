                    </TextLine>

                    <TextLine ID="mz_2-254_l23" HPOS="344" VPOS="1776" WIDTH="1763" HEIGHT="60" BASELINE="346 1815 2107 1819" TAGREFS="TYPE_5">
                        <Shape>
