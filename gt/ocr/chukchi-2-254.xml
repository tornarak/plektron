                        </Shape>
                        <String CONTENT="want to take a team?’ But the dead man answered, ‘No!’ They asked him,"/>
                    </TextLine>

                    <TextLine ID="mz_2-254_l7" HPOS="354" VPOS="818" WIDTH="1759" HEIGHT="61" BASELINE="356 855 2113 859" TAGREFS="TYPE_5">
