                        </Shape>
                        <String CONTENT="began with the divination. His first question was, “What place do you"/>
                    </TextLine>

                    <TextLine ID="mz_2-254_l31" HPOS="340" VPOS="2263" WIDTH="1763" HEIGHT="53" BASELINE="342 2291 2103 2295" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2291 340 2304 389 2316 391 2316 2101 2308 2103 2295 2101 2267 342 2263 342 2291"/>
                        </Shape>
                        <String CONTENT="want to choose for your funeral?” But the body was as heavy and motionless"/>
                    </TextLine>

