                    </TextLine>

                    <TextLine ID="mz_2-254_l10" HPOS="346" VPOS="1000" WIDTH="1767" HEIGHT="55" BASELINE="348 1039 2113 1035" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 1039 348 1055 2111 1055 2113 1035 2107 1000 346 1002 348 1039"/>
                        </Shape>
