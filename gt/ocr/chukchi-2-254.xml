                        </Shape>
                        <String CONTENT="walking-staff.’” Of course, the last answer was procured by means of divination."/>
                    </TextLine>

                    <TextLine ID="mz_2-254_l9" HPOS="456" VPOS="947" WIDTH="1657" HEIGHT="45" BASELINE="458 981 2113 977" TAGREFS="TYPE_5">
