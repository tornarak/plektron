                <TextBlock ID="text_3-123" HPOS="317" VPOS="472" WIDTH="1791" HEIGHT="2635"><TextLine ID="mz_3-123_l1" HPOS="898" VPOS="474" WIDTH="616" HEIGHT="53" BASELINE="898 509 1514 505" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1500 480 1490 474 910 474 898 496 898 509 898 527 1512 523 1514 505 1510 496 1500 480"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l2" HPOS="1995" VPOS="472" WIDTH="86" HEIGHT="67" BASELINE="1997 509 2081 513" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1997 509 1995 523 2036 539 2038 539 2040 539 2042 539 2079 527 2081 513 2081 476 1997 472 1997 509"/>
                        </Shape>
                        <String CONTENT="657"/>
                    </TextLine>
<TextLine ID="mz_3-123_l3" HPOS="317" VPOS="574" WIDTH="1774" HEIGHT="52" BASELINE="319 613 2091 607" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2085 578 489 574 473 576 454 576 434 578 415 578 395 580 376 581 356 581 337 583 327 583 317 583 319 613 319 626 2089 620 2091 607 2089 597 2085 578"/>
                        </Shape>
                        <String CONTENT="to St. Lawrence Island. They saw a village on the shore, and in a thick fog landed not very far"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l4" HPOS="317" VPOS="626" WIDTH="1772" HEIGHT="47" BASELINE="319 659 2089 652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 659 319 673 2087 671 2089 652 2083 626 317 632 319 659"/>
                        </Shape>
                        <String CONTENT="away from it. The greater part of the people moved inland in order to attack the enemy from"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l5" HPOS="321" VPOS="673" WIDTH="1770" HEIGHT="45" BASELINE="321 702 2091 702" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="321 702 321 718 2089 718 2091 702 2089 677 321 673 321 702"/>
                        </Shape>
                        <String CONTENT="behind. Some few went directly to the village under cover of the fog. One old man said, ‘Give"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l6" HPOS="321" VPOS="720" WIDTH="1770" HEIGHT="45" BASELINE="323 751 2091 745" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="323 751 323 765 2089 763 2091 745 2085 720 321 724 323 751"/>
                        </Shape>
                        <String CONTENT="voice, like wolves howling.’ They howled like wolves. Then among the St. Lawrence people"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l7" HPOS="321" VPOS="769" WIDTH="1770" HEIGHT="42" BASELINE="323 798 2091 794" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="323 798 323 811 2089 808 2091 794 2085 769 321 771 323 798"/>
                        </Shape>
                        <String CONTENT="another old man started, and said, ‘Oh, they are here!’ The younger people answered, ‘Is it pos-"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l8" HPOS="319" VPOS="813" WIDTH="1772" HEIGHT="45" BASELINE="321 843 2091 839" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="321 843 321 858 2089 858 2091 839 2085 813 319 815 321 843"/>
                        </Shape>
                        <String CONTENT="sible? But we are on an island.’ — ‘Oh, yes! Give answer, you also.’ Then they roared like"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l9" HPOS="325" VPOS="862" WIDTH="1766" HEIGHT="43" BASELINE="325 889 2091 889" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 889 325 903 2087 905 2091 889 2089 862 325 862 325 889"/>
                        </Shape>
                        <String CONTENT="walrus. Meanwhile the larger troop of assailants, those that were behind, were slowly approaching."/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l10" HPOS="325" VPOS="909" WIDTH="1766" HEIGHT="47" BASELINE="325 936 2091 936" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 936 325 950 2087 956 2091 936 2089 909 325 909 325 936"/>
                        </Shape>
                        <String CONTENT="All of a sudden they attacked the islanders, and began to kill them. The women, from sheer fright,"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l11" HPOS="323" VPOS="956" WIDTH="1768" HEIGHT="43" BASELINE="323 983 2091 983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="323 983 323 999 2091 999 2091 983 2091 956 323 956 323 983"/>
                        </Shape>
                        <String CONTENT="strangled themselves. Others carved walrus-meat, with which to treat the victors. A great slaughter"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l12" HPOS="323" VPOS="1002" WIDTH="1393" HEIGHT="43" BASELINE="323 1030 1716 1030" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="323 1030 323 1043 1714 1045 1716 1030 1716 1002 323 1002 323 1030"/>
                        </Shape>
                        <String CONTENT="ensued. Numerous women were taken prisoners and carried to Indian Point."/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l13" HPOS="434" VPOS="1045" WIDTH="1661" HEIGHT="45" BASELINE="436 1071 2095 1076" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="436 1071 434 1084 2091 1090 2095 1076 2095 1051 436 1045 436 1071"/>
                        </Shape>
                        <String CONTENT="“After four years the St. Lawrence people, in their turn, sought revenge. They came in the"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l14" HPOS="323" VPOS="1084" WIDTH="1770" HEIGHT="55" BASELINE="325 1123 2093 1119" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 1123 325 1137 2089 1139 2093 1119 2089 1094 1235 1084 1233 1084 1231 1084 1194 1094 354 1086 352 1086 350 1086 323 1094 325 1123"/>
                        </Shape>
                        <String CONTENT="night-time, and succeeded in surprising the people in their sleep. They killed them simply by"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l15" HPOS="323" VPOS="1141" WIDTH="1770" HEIGHT="49" BASELINE="325 1170 2093 1166" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 1170 325 1186 2089 1190 2093 1166 2087 1141 323 1143 325 1170"/>
                        </Shape>
                        <String CONTENT="thrusting their spears through the skin walls of the sleeping-room. One small orphan-boy, however,"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l16" HPOS="323" VPOS="1188" WIDTH="1772" HEIGHT="48" BASELINE="325 1217 2095 1213" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 1217 325 1230 2091 1236 2095 1213 2089 1188 323 1190 325 1217"/>
                        </Shape>
                        <String CONTENT="fled in time, and wakened the people. Then the assailants fled to the open sea. The next year"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l17" HPOS="323" VPOS="1227" WIDTH="1772" HEIGHT="50" BASELINE="325 1264 2095 1260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 1264 325 1277 2093 1273 2095 1260 2091 1229 340 1227 339 1227 337 1227 335 1227 323 1232 325 1264"/>
                        </Shape>
                        <String CONTENT="the old men of St. Lawrence said, ‘It is enough. Let all the people make peace among themselves.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l18" HPOS="327" VPOS="1279" WIDTH="1769" HEIGHT="45" BASELINE="327 1310 2096 1310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1310 327 1324 2095 1324 2096 1310 2095 1283 327 1279 327 1310"/>
                        </Shape>
                        <String CONTENT="The summer came, and a number of the islanders came to the shore. They brought a large num-"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l19" HPOS="325" VPOS="1322" WIDTH="1770" HEIGHT="55" BASELINE="327 1353 2095 1357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1353 325 1365 2091 1377 2095 1357 2093 1328 327 1322 327 1353"/>
                        </Shape>
                        <String CONTENT="ber of wooden vessels, and gave them to the people of this land. An old man of our shore said,"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l20" HPOS="327" VPOS="1373" WIDTH="1771" HEIGHT="45" BASELINE="329 1402 2098 1398" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1402 329 1418 2096 1418 2098 1398 2093 1373 327 1373 329 1402"/>
                        </Shape>
                        <String CONTENT="‘How will you answer them? Give them skins.’ They gave them soft skins. ‘What skins are"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l21" HPOS="327" VPOS="1412" WIDTH="1771" HEIGHT="50" BASELINE="327 1449 2098 1449" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1449 327 1458 2096 1462 2098 1449 2098 1423 1993 1423 1978 1412 1976 1412 1974 1412 1972 1412 1909 1421 1841 1412 1839 1412 1510 1421 1416 1412 1414 1412 1332 1421 1319 1412 1317 1412 1315 1412 1182 1412 1180 1412 1081 1421 1058 1412 1056 1412 1054 1412 1052 1412 1032 1421 931 1412 929 1412 849 1421 836 1412 834 1412 832 1412 736 1412 734 1412 732 1412 713 1421 557 1412 555 1412 471 1421 457 1412 455 1412 454 1412 352 1412 350 1412 348 1412 327 1421 327 1449"/>
                        </Shape>
                        <String CONTENT="these?’ — ‘Reindeer-skins!’ — ‘What is a reindeer?’ — ‘They are with antlers!’ — ‘What are"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l22" HPOS="327" VPOS="1466" WIDTH="1773" HEIGHT="45" BASELINE="327 1494 2100 1494" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1494 327 1511 2100 1511 2100 1494 2100 1466 327 1466 327 1494"/>
                        </Shape>
                        <String CONTENT="antlers?’ So they showed them a part of some skin from the head of a reindeer. They looked at"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l23" HPOS="327" VPOS="1513" WIDTH="1771" HEIGHT="45" BASELINE="327 1542 2098 1542" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1542 327 1554 2096 1558 2098 1542 2098 1515 327 1513 327 1542"/>
                        </Shape>
                        <String CONTENT="it, and said, ‘Oh, how wonderful! The nose is like the holes in the hide cover of a boat.’ — ‘You"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l24" HPOS="325" VPOS="1558" WIDTH="1773" HEIGHT="47" BASELINE="327 1589 2098 1585" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1589 327 1603 2095 1605 2098 1585 2095 1558 325 1558 327 1589"/>
                        </Shape>
                        <String CONTENT="had better try the meat!’ They cooked some reindeer-fat. — ‘Oh, well! it is like blubber.’ Then"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l25" HPOS="327" VPOS="1605" WIDTH="1773" HEIGHT="46" BASELINE="327 1636 2100 1636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1636 327 1648 2098 1651 2100 1636 2098 1605 327 1607 327 1636"/>
                        </Shape>
                        <String CONTENT="they ate of it. ‘Oh, it tastes good!’ They went away and left one man. He was a shaman; and"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l26" HPOS="329" VPOS="1655" WIDTH="1771" HEIGHT="43" BASELINE="329 1683 2100 1683" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1683 329 1698 2100 1698 2100 1683 2100 1655 329 1655 329 1683"/>
                        </Shape>
                        <String CONTENT="the people of this shore made him a prisoner in the same way as the islanders did four years ago"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l27" HPOS="329" VPOS="1692" WIDTH="407" HEIGHT="51" BASELINE="329 1727 736 1727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1727 329 1743 736 1743 736 1727 734 1692 329 1698 329 1727"/>
                        </Shape>
                        <String CONTENT="to one of our people.”"/>
                    </TextLine>
<TextLine ID="mz_3-123_l28" HPOS="438" VPOS="1774" WIDTH="1662" HEIGHT="57" BASELINE="438 1815 2100 1815" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 1815 438 1831 2100 1831 2100 1815 2100 1784 2071 1774 2069 1774 2067 1774 2065 1774 2028 1784 1867 1774 1865 1774 1806 1784 1785 1774 1783 1774 1781 1774 1714 1784 1457 1774 1455 1774 1453 1774 1422 1786 1292 1786 1278 1774 1276 1774 1274 1774 1272 1774 1225 1784 1145 1774 1143 1774 1038 1784 999 1774 997 1774 995 1774 993 1774 964 1784 943 1774 941 1774 939 1774 937 1774 902 1784 886 1774 884 1774 882 1774 880 1774 789 1784 438 1778 438 1815"/>
                        </Shape>
                        <String CONTENT="This is a very typical description of a war between two Maritime people"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l29" HPOS="327" VPOS="1833" WIDTH="933" HEIGHT="66" BASELINE="329 1872 1260 1876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1872 327 1885 352 1897 354 1897 356 1899 457 1899 457 1897 459 1897 461 1897 461 1895 471 1887 1101 1899 1103 1899 1258 1887 1260 1876 1258 1846 1192 1835 1190 1835 1188 1835 1147 1844 1083 1835 1081 1835 927 1846 812 1846 798 1833 797 1833 795 1833 793 1833 791 1833 763 1842 703 1833 701 1833 699 1833 664 1842 329 1840 329 1872"/>
                        </Shape>
                        <String CONTENT="living on opposite shores of Bering Sea."/>
                    </TextLine>
<TextLine ID="mz_3-123_l30" HPOS="444" VPOS="1891" WIDTH="1656" HEIGHT="64" BASELINE="446 1930 2100 1934" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 1930 444 1946 459 1955 461 1955 463 1955 465 1955 2098 1948 2100 1934 2098 1905 1763 1893 1761 1893 1759 1893 1724 1905 1506 1905 1479 1893 1477 1893 1475 1893 1405 1903 1379 1893 1377 1893 1375 1893 1373 1893 1352 1903 1329 1893 1327 1893 1325 1893 1323 1893 1321 1893 1309 1903 1274 1891 1272 1891 1270 1891 1268 1891 1229 1903 1075 1903 1062 1891 1060 1891 1058 1891 1056 1891 986 1901 943 1891 941 1891 939 1891 874 1901 837 1891 836 1891 834 1891 446 1899 446 1930"/>
                        </Shape>
                        <String CONTENT="Tungus and Yukaghir Wars. — Chukchee intercourse with the Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l31" HPOS="327" VPOS="1955" WIDTH="1775" HEIGHT="57" BASELINE="327 1996 2102 1996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1996 327 2012 2102 2012 2102 1996 2102 1967 2034 1955 2032 1955 2030 1955 1993 1965 1894 1955 1892 1955 1890 1955 1861 1965 1773 1955 1771 1955 1695 1965 1642 1955 1640 1955 1638 1955 1607 1965 1561 1955 1559 1955 1438 1965 1414 1955 1412 1955 1410 1955 1340 1965 1299 1955 1297 1955 1295 1955 1294 1955 1264 1965 1245 1955 1243 1955 1241 1955 1161 1965 1081 1955 1079 1955 999 1965 847 1955 845 1955 843 1955 804 1965 781 1955 779 1955 777 1955 722 1965 327 1961 327 1996"/>
                        </Shape>
                        <String CONTENT="is quite recent, and almost nothing of it is reflected in the folk-stories. One"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l32" HPOS="331" VPOS="2016" WIDTH="1773" HEIGHT="54" BASELINE="331 2057 2104 2057" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="331 2057 331 2070 2104 2070 2104 2057 2100 2016 2057 2026 1987 2016 1985 2016 1929 2026 1870 2016 1868 2016 1800 2026 1631 2016 1629 2016 1627 2016 1590 2026 1555 2016 1553 2016 1551 2016 1549 2016 1547 2016 1531 2028 1420 2028 1387 2016 1385 2016 1383 2016 1290 2026 1196 2016 1194 2016 1147 2026 1095 2016 1093 2016 929 2026 896 2016 894 2016 892 2016 800 2026 672 2016 670 2016 611 2026 549 2016 547 2016 331 2026 331 2057"/>
                        </Shape>
                        <String CONTENT="or two tales relating to it are quite short, and poor in details. The tales of"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l33" HPOS="331" VPOS="2076" WIDTH="1771" HEIGHT="55" BASELINE="331 2115 2102 2115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="331 2115 331 2129 2100 2131 2102 2115 2102 2086 2059 2076 2057 2076 2056 2076 2054 2076 2020 2086 1921 2076 1919 2076 1917 2076 1880 2086 1841 2076 1839 2076 1837 2076 991 2086 935 2076 933 2076 931 2076 910 2088 793 2088 625 2076 623 2076 621 2076 594 2086 516 2076 514 2076 409 2086 348 2076 346 2076 344 2076 342 2076 331 2084 331 2115"/>
                        </Shape>
                        <String CONTENT="the eastern Tungus, on the contrary, contain a number of details about the"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l34" HPOS="331" VPOS="2135" WIDTH="1773" HEIGHT="64" BASELINE="331 2176 2104 2176" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="331 2176 331 2187 457 2199 459 2199 514 2189 1190 2189 1270 2199 1272 2199 1381 2189 1687 2199 1689 2199 2104 2189 2104 2176 2100 2135 2059 2144 1798 2135 1796 2135 1794 2135 1792 2135 1777 2146 1670 2146 1613 2135 1611 2135 1562 2144 1535 2135 1533 2135 1531 2135 1529 2135 1490 2144 1436 2135 1434 2135 1370 2144 1336 2135 1334 2135 1332 2135 1331 2135 1329 2135 1311 2146 1167 2146 1136 2135 1134 2135 1132 2135 1130 2135 1128 2135 1114 2144 1085 2135 1083 2135 1081 2135 1079 2135 1050 2144 1021 2135 1019 2135 1017 2135 894 2144 843 2135 841 2135 839 2135 837 2135 826 2144 812 2135 810 2135 808 2135 717 2135 715 2135 713 2135 670 2144 619 2135 617 2135 615 2135 594 2144 563 2135 561 2135 559 2135 465 2144 426 2135 424 2135 422 2135 331 2144 331 2176"/>
                        </Shape>
                        <String CONTENT="coming of the Chukchee and their struggle with the Tungus inhabitants of"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l35" HPOS="333" VPOS="2195" WIDTH="1769" HEIGHT="55" BASELINE="333 2236 2102 2236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="333 2236 333 2248 2098 2250 2102 2236 2100 2207 2005 2195 2003 2195 2001 2195 1970 2205 1898 2195 1896 2195 1843 2205 1247 2195 1245 2195 1243 2195 1202 2205 1151 2195 1149 2195 1091 2205 1030 2195 1028 2195 1027 2195 999 2205 882 2195 880 2195 878 2195 849 2205 798 2195 797 2195 795 2195 793 2195 777 2207 674 2207 621 2195 619 2195 553 2205 539 2195 537 2195 535 2195 438 2195 436 2195 434 2195 407 2205 352 2195 350 2195 348 2195 346 2195 333 2203 333 2236"/>
                        </Shape>
                        <String CONTENT="the land. As to the Yukaghir, the Chukchee tales hardly mention them."/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l36" HPOS="335" VPOS="2252" WIDTH="1767" HEIGHT="58" BASELINE="337 2293 2102 2296" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="337 2293 335 2306 2098 2310 2102 2296 2102 2263 2085 2254 2083 2254 2081 2254 2079 2254 2017 2263 1974 2254 1972 2254 1970 2254 1681 2263 1633 2254 1631 2254 1629 2254 1609 2263 1588 2254 1586 2254 1584 2254 1582 2254 1580 2254 1566 2263 1506 2254 1504 2254 1453 2263 1426 2254 1424 2254 1422 2254 1368 2263 1321 2254 1319 2254 1227 2263 912 2263 878 2252 876 2252 874 2252 873 2252 839 2261 485 2252 483 2252 430 2261 337 2252 337 2293"/>
                        </Shape>
                        <String CONTENT="Yukaghir tradition, on the contrary, asserts that the Chukchee and the Yukaghir"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l37" HPOS="333" VPOS="2316" WIDTH="1771" HEIGHT="55" BASELINE="333 2355 2104 2355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="333 2355 333 2371 2104 2371 2104 2355 2104 2328 1935 2316 1933 2316 1522 2326 1469 2316 1467 2316 1377 2326 1325 2316 1323 2316 1208 2326 1169 2316 1167 2316 1165 2316 1060 2326 837 2316 836 2316 834 2316 832 2316 814 2328 637 2328 471 2316 469 2316 467 2316 465 2316 450 2328 333 2328 333 2355"/>
                        </Shape>
                        <String CONTENT="were friendly among themselves; and one time, when a certain Chukchee was"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l38" HPOS="333" VPOS="2376" WIDTH="1771" HEIGHT="53" BASELINE="335 2411 2104 2415" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 2411 333 2425 2100 2429 2104 2415 2102 2380 335 2376 335 2411"/>
                        </Shape>
                        <String CONTENT="killed unintentially by the Yukaghir, and they saw his face, they exclaimed with"/>
                    </TextLine>

                    <TextLine ID="mz_3-123_l39" HPOS="333" VPOS="2431" WIDTH="1771" HEIGHT="56" BASELINE="335 2472 2104 2476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 2472 333 2484 2100 2487 2104 2476 2102 2445 2036 2433 1894 2433 1892 2433 1890 2433 1888 2433 1874 2443 1829 2433 1828 2433 1826 2433 1792 2443 1605 2433 1603 2433 1551 2443 1523 2433 1522 2433 1520 2433 1463 2443 1438 2433 1436 2433 1434 2433 1370 2443 1356 2433 1354 2433 1352 2433 1243 2433 1241 2433 1239 2433 1219 2443 1124 2431 1122 2431 1120 2431 1093 2443 912 2443 894 2431 892 2431 890 2431 888 2431 886 2431 859 2441 832 2431 830 2431 828 2431 826 2431 793 2441 721 2431 719 2431 656 2443 463 2443 446 2431 444 2431 442 2431 440 2431 335 2439 335 2472"/>
                        </Shape>
                        <String CONTENT="much sorrow, “Sun, look on, we have killed a brother.”¹ But the Chukchee"/>
