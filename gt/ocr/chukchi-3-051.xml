                            <Polygon POINTS="418 1160 418 1172 2188 1176 2192 1156 2188 1129 1929 1129 1911 1117 1909 1117 1907 1117 1905 1117 1904 1117 1876 1127 1699 1117 1697 1117 1631 1127 1523 1117 1522 1117 1401 1127 1332 1117 1331 1117 1329 1117 1299 1129 1260 1119 1258 1119 1256 1119 1255 1119 1216 1129 1143 1119 1141 1119 1050 1129 416 1125 418 1160"/>
                        </Shape>
                        <String CONTENT="is even expected to agree. When the old people are ill-tempered, — as many"/>
                    </TextLine>

                    <TextLine ID="mz_3-051_l13" HPOS="416" VPOS="1176" WIDTH="1774" HEIGHT="62" BASELINE="418 1215 2190 1219" TAGREFS="TYPE_5">
