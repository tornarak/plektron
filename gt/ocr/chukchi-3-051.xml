                        <Shape>
                            <Polygon POINTS="418 1038 418 1055 2190 1055 2192 1034 2186 1000 416 1000 418 1038"/>
                        </Shape>
                        <String CONTENT="her elder brothers, and other male members of the family. If one of the old"/>
                    </TextLine>

                    <TextLine ID="mz_3-051_l11" HPOS="416" VPOS="1057" WIDTH="1778" HEIGHT="64" BASELINE="418 1100 2194 1096" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="418 1100 418 1121 2192 1112 2194 1096 2188 1059 1859 1067 1831 1057 1829 1057 1828 1057 1755 1067 1703 1057 1701 1057 1699 1057 1697 1057 1681 1069 1590 1069 1537 1057 1535 1057 1533 1057 1514 1067 1459 1057 1457 1057 1455 1057 1453 1057 1438 1069 1262 1069 1182 1059 1180 1059 1179 1059 1159 1069 1108 1059 1106 1059 1060 1069 1025 1059 1023 1059 1021 1059 931 1069 750 1059 748 1059 572 1069 522 1059 520 1059 416 1071 418 1100"/>
                        </Shape>
                        <String CONTENT="people reproaches him and calls him names, he has to bear it patiently, and"/>
                    </TextLine>

