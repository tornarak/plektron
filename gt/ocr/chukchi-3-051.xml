                    </TextLine>

                    <TextLine ID="mz_3-051_l9" HPOS="416" VPOS="934" WIDTH="1774" HEIGHT="65" BASELINE="418 975 2190 979" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="418 975 416 989 2186 999 2190 979 2188 948 2116 936 2114 936 2032 946 2009 936 2007 936 2005 936 1923 946 1865 936 1863 936 1861 936 1828 946 1726 936 1724 936 1722 936 1681 946 1539 936 1537 936 1535 936 1506 946 1483 936 1481 936 1479 936 1416 946 1350 936 1348 936 1143 944 1128 934 1126 934 1124 934 1122 934 1120 934 1089 944 1058 934 1056 934 1054 934 1052 934 1021 944 986 934 984 934 982 934 980 934 945 944 851 934 849 934 847 934 820 944 734 934 732 934 730 934 701 946 531 946 510 934 508 934 506 934 418 942 418 975"/>
                        </Shape>
                        <String CONTENT="sledges, mends and repairs broken utensils. He has to please the girl’s father,"/>
                    </TextLine>

