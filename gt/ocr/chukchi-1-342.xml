                <TextBlock ID="text_1-342" HPOS="570" VPOS="885" WIDTH="1784" HEIGHT="2423"><TextLine ID="mz_1-342_l1" HPOS="1261" VPOS="885" WIDTH="405" HEIGHT="63" BASELINE="1261 935 1666 935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1655 896 1633 885 1631 885 1629 885 1347 900 1332 887 1332 885 1330 885 1328 885 1282 885 1280 885 1261 933 1261 935 1261 948 1666 948 1666 935 1666 920 1655 896"/>
                        </Shape>
                        <String CONTENT="XI. — GAMES."/>
                    </TextLine>
<TextLine ID="mz_1-342_l2" HPOS="685" VPOS="1017" WIDTH="1667" HEIGHT="50" BASELINE="687 1050 2352 1054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2333 1022 2311 1022 2289 1019 2268 1019 2246 1019 2224 1017 2203 1017 2181 1017 687 1017 687 1050 685 1063 2348 1067 2352 1054 2350 1022 2333 1022"/>
                        </Shape>
                        <String CONTENT="ATHLETIC SPORTS. — The Chukchee are fond of all kinds of sports, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l3" HPOS="574" VPOS="1076" WIDTH="1778" HEIGHT="60" BASELINE="576 1108 2352 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1108 574 1121 680 1134 682 1134 1226 1125 1466 1136 1468 1136 2350 1125 2352 1112 2350 1082 576 1076 576 1108"/>
                        </Shape>
                        <String CONTENT="indulge in them whenever opportunity is offered. Many of their games are"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l4" HPOS="574" VPOS="1136" WIDTH="1442" HEIGHT="50" BASELINE="576 1169 2016 1173" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1169 574 1182 2012 1186 2016 1173 2014 1141 576 1136 576 1169"/>
                        </Shape>
                        <String CONTENT="connected with religious ceremonials, as will be described later."/>
                    </TextLine>
<TextLine ID="mz_1-342_l5" HPOS="687" VPOS="1188" WIDTH="1665" HEIGHT="61" BASELINE="687 1232 2352 1232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="687 1232 687 1249 2352 1249 2352 1232 2352 1201 2259 1188 2257 1188 2255 1188 2222 1199 2099 1188 2097 1188 2094 1188 2092 1188 2075 1201 1973 1201 1943 1188 1941 1188 1938 1188 1936 1188 1934 1188 1921 1199 1893 1188 1891 1188 1889 1188 1817 1199 1793 1188 1791 1188 1789 1188 1787 1188 1785 1188 1769 1201 1650 1201 1637 1188 1635 1188 1633 1188 1549 1188 1546 1188 1481 1199 1453 1188 1451 1188 1449 1188 1367 1199 1341 1188 1339 1188 1336 1188 1334 1188 1315 1199 1304 1188 1302 1188 1300 1188 1211 1188 1209 1188 1133 1199 1098 1188 1096 1188 1094 1188 1092 1188 1089 1188 1074 1199 986 1188 983 1188 981 1188 936 1199 908 1188 905 1188 903 1188 901 1188 899 1188 882 1201 775 1201 710 1188 708 1188 706 1188 687 1197 687 1232"/>
                        </Shape>
                        <String CONTENT="Among the Reindeer Chukchee the chief sport is reindeer-racing. Once"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l6" HPOS="574" VPOS="1260" WIDTH="1776" HEIGHT="54" BASELINE="576 1290 2350 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1290 574 1305 587 1314 589 1314 591 1314 594 1314 2348 1312 2350 1294 2348 1264 576 1260 576 1290"/>
                        </Shape>
                        <String CONTENT="a year almost every camp arranges a race. These races are held in circuits,"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l7" HPOS="574" VPOS="1309" WIDTH="1780" HEIGHT="59" BASELINE="574 1353 2354 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1353 574 1368 2354 1368 2354 1353 2354 1320 1854 1309 1852 1309 1850 1309 1802 1320 1718 1309 1715 1309 1713 1309 1672 1320 1581 1309 1579 1309 1577 1309 1536 1320 1473 1309 1471 1309 1336 1320 1308 1309 1306 1309 1304 1309 1302 1309 1265 1320 1213 1309 1211 1309 1209 1309 1206 1309 1191 1320 1076 1309 1074 1309 1001 1320 912 1309 910 1309 856 1320 801 1309 799 1309 797 1309 754 1320 682 1309 680 1309 574 1320 574 1353"/>
                        </Shape>
                        <String CONTENT="so that the whole neighborhood can visit all in their vicinity. The principal"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l8" HPOS="574" VPOS="1368" WIDTH="1776" HEIGHT="67" BASELINE="576 1409 2350 1413" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1409 574 1422 793 1435 795 1435 2348 1426 2350 1413 2350 1383 2317 1370 2315 1370 2313 1370 1711 1381 1603 1370 1601 1370 1598 1370 1551 1381 1462 1368 1460 1368 1458 1368 1455 1368 1438 1379 1401 1368 1399 1368 1397 1368 1395 1368 1360 1379 1154 1368 1152 1368 1150 1368 1113 1379 1063 1368 1061 1368 1009 1379 799 1368 797 1368 576 1377 576 1409"/>
                        </Shape>
                        <String CONTENT="man of the camp, who figures as the host of the race (ireˊlɪn), has to supply"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l9" HPOS="576" VPOS="1442" WIDTH="1774" HEIGHT="45" BASELINE="576 1472 2350 1472" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1472 576 1487 2350 1487 2350 1472 2350 1442 576 1442 576 1472"/>
                        </Shape>
                        <String CONTENT="the prize, which varies from a couple of leaves of tobacco to a beaver-skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l10" HPOS="574" VPOS="1487" WIDTH="1776" HEIGHT="61" BASELINE="576 1532 2350 1528" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1532 576 1548 2348 1545 2350 1528 2348 1500 2320 1487 2317 1487 2315 1487 2313 1487 2311 1487 2291 1498 2060 1487 2058 1487 1984 1498 1958 1487 1956 1487 1954 1487 1951 1487 1904 1498 1839 1487 1837 1487 1834 1487 1804 1500 1616 1500 1533 1487 1531 1487 1529 1487 1492 1498 1464 1487 1462 1487 1460 1487 1458 1487 1455 1487 1440 1500 1388 1489 1386 1489 1384 1489 1354 1500 1022 1489 1020 1489 957 1500 836 1489 834 1489 832 1489 830 1489 817 1500 780 1489 778 1489 775 1489 574 1502 576 1532"/>
                        </Shape>
                        <String CONTENT="or a pack-sledge reindeer. The prize is tied to a tree-branch, which is stuck"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l11" HPOS="574" VPOS="1545" WIDTH="1776" HEIGHT="70" BASELINE="576 1589 2350 1593" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1589 574 1604 585 1613 587 1613 589 1613 591 1613 1423 1604 1462 1615 1464 1615 1466 1615 2348 1604 2350 1593 2350 1561 2304 1548 2302 1548 2300 1548 2237 1558 2177 1548 2174 1548 2118 1558 2097 1548 2094 1548 1954 1548 1951 1548 1949 1548 1947 1548 1934 1558 1921 1548 1919 1548 1917 1548 1915 1548 1912 1548 1882 1558 1744 1548 1741 1548 1683 1558 1627 1548 1624 1548 1408 1556 1388 1545 1386 1545 1384 1545 1382 1545 1380 1545 1358 1556 1334 1545 1332 1545 1330 1545 1328 1545 1304 1558 1139 1558 1120 1545 1118 1545 1115 1545 1113 1545 1055 1556 990 1545 988 1545 986 1545 940 1556 576 1554 576 1589"/>
                        </Shape>
                        <String CONTENT="into the snow. For this reason it is called “the thing stuck in” (rɪˊpyo). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l12" HPOS="574" VPOS="1613" WIDTH="1778" HEIGHT="60" BASELINE="576 1647 2352 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1647 574 1660 630 1673 633 1673 2350 1665 2352 1652 2350 1617 576 1613 576 1647"/>
                        </Shape>
                        <String CONTENT="larger the prize, the greater will be the concourse of people at the race, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l13" HPOS="574" VPOS="1678" WIDTH="1780" HEIGHT="58" BASELINE="576 1708 2354 1712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1708 574 1725 587 1734 589 1734 591 1734 594 1734 1438 1725 1464 1736 1466 1736 1468 1736 2352 1725 2354 1712 2352 1682 576 1678 576 1708"/>
                        </Shape>
                        <String CONTENT="the longer the stretch to be covered by the contestants, sometimes ten miles"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l14" HPOS="572" VPOS="1736" WIDTH="316" HEIGHT="58" BASELINE="574 1766 888 1771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1766 572 1786 581 1792 583 1792 585 1792 587 1792 687 1784 728 1794 730 1794 732 1794 886 1784 888 1771 886 1740 574 1736 574 1766"/>
                        </Shape>
                        <String CONTENT="and upwards."/>
                    </TextLine>
<TextLine ID="mz_1-342_l15" HPOS="685" VPOS="1788" WIDTH="1667" HEIGHT="63" BASELINE="687 1825 2352 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="687 1825 685 1840 700 1851 702 1851 704 1851 706 1851 2350 1844 2352 1831 2350 1801 687 1788 687 1825"/>
                        </Shape>
                        <String CONTENT="There are no particular rules about starting the race. The participants"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l16" HPOS="572" VPOS="1855" WIDTH="1778" HEIGHT="54" BASELINE="574 1888 2350 1894" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1888 572 1907 2346 1909 2350 1894 2348 1862 574 1855 574 1888"/>
                        </Shape>
                        <String CONTENT="gather in front of the prize in an irregular group. The host gives the signal,"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l17" HPOS="572" VPOS="1905" WIDTH="1778" HEIGHT="60" BASELINE="574 1950 2350 1946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1950 574 1965 2348 1963 2350 1946 2346 1918 2229 1905 2226 1905 2125 1916 2107 1905 2105 1905 2103 1905 2101 1905 2099 1905 2077 1916 2047 1905 2045 1905 2042 1905 1962 1916 1928 1905 1925 1905 1923 1905 1921 1905 1919 1905 1904 1918 1808 1918 1761 1905 1759 1905 1756 1905 1696 1916 1672 1905 1670 1905 1668 1905 1666 1905 1663 1905 1646 1918 1542 1918 1514 1905 1512 1905 1510 1905 1421 1918 1009 1907 1007 1907 1005 1907 970 1918 916 1907 914 1907 762 1918 710 1907 708 1907 706 1907 685 1918 650 1907 648 1907 646 1907 572 1920 574 1950"/>
                        </Shape>
                        <String CONTENT="and all start off. While some keep to the road, others strike off through the"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l18" HPOS="576" VPOS="1981" WIDTH="1776" HEIGHT="45" BASELINE="576 2009 2352 2009" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 2009 576 2026 2352 2026 2352 2009 2352 1981 576 1981 576 2009"/>
                        </Shape>
                        <String CONTENT="deep snow, trying to intercept the leaders. The race is to a distant point"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l19" HPOS="572" VPOS="2037" WIDTH="1780" HEIGHT="54" BASELINE="574 2067 2352 2072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2067 572 2082 585 2091 587 2091 589 2091 591 2091 2350 2082 2352 2072 2350 2041 574 2037 574 2067"/>
                        </Shape>
                        <String CONTENT="and back again. Until the contestants are on the return stretch they spare"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l20" HPOS="574" VPOS="2085" WIDTH="1776" HEIGHT="60" BASELINE="576 2130 2350 2126" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 2130 576 2145 2348 2143 2350 2126 2346 2098 2185 2098 2168 2085 2166 2085 2164 2085 2161 2085 2159 2085 2157 2085 2144 2095 2129 2085 2127 2085 2125 2085 2122 2085 2120 2085 2118 2085 2103 2098 2014 2098 1997 2085 1995 2085 1993 2085 1990 2085 1941 2095 1923 2085 1921 2085 1919 2085 1917 2085 1915 2085 1912 2085 1895 2098 1759 2098 1728 2085 1726 2085 1724 2085 1722 2085 1720 2085 1700 2095 1200 2087 1198 2087 1196 2087 1193 2087 1178 2100 1044 2100 951 2087 949 2087 884 2098 871 2087 869 2087 866 2087 765 2087 762 2087 689 2098 594 2087 591 2087 589 2087 587 2087 574 2095 576 2130"/>
                        </Shape>
                        <String CONTENT="their animals. The race begins in earnest on the way back, and becomes"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l21" HPOS="576" VPOS="2154" WIDTH="849" HEIGHT="58" BASELINE="578 2184 1425 2191" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="578 2184 576 2201 591 2210 594 2210 596 2210 598 2210 702 2201 860 2212 862 2212 1423 2204 1425 2191 1423 2160 578 2154 578 2184"/>
                        </Shape>
                        <String CONTENT="very exciting as they near the prize."/>
                    </TextLine>
<TextLine ID="mz_1-342_l22" HPOS="685" VPOS="2208" WIDTH="1665" HEIGHT="61" BASELINE="687 2245 2350 2253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="687 2245 685 2258 2346 2269 2350 2253 2348 2221 687 2208 687 2245"/>
                        </Shape>
                        <String CONTENT="The onlookers are very enthusiastic, and meet the racers with encouraging"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l23" HPOS="570" VPOS="2273" WIDTH="1778" HEIGHT="58" BASELINE="572 2305 2348 2310" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2305 570 2321 596 2331 598 2331 600 2331 2346 2323 2348 2310 2346 2279 572 2273 572 2305"/>
                        </Shape>
                        <String CONTENT="cries or hootings. The winner snatches the prize, and the race is over. Often"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l24" HPOS="572" VPOS="2334" WIDTH="1778" HEIGHT="60" BASELINE="574 2364 2350 2370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2364 572 2377 594 2390 596 2390 598 2390 1144 2381 1756 2394 1759 2394 2348 2383 2350 2370 2348 2340 574 2334 574 2364"/>
                        </Shape>
                        <String CONTENT="one or two minor prizes are also put up by other people of the camp. These"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l25" HPOS="572" VPOS="2394" WIDTH="1778" HEIGHT="50" BASELINE="574 2427 2350 2431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2427 572 2440 2346 2444 2350 2431 2348 2398 574 2394 574 2427"/>
                        </Shape>
                        <String CONTENT="are taken by the next comers in order. Sometimes there is also a small stake"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l26" HPOS="572" VPOS="2453" WIDTH="1776" HEIGHT="58" BASELINE="574 2483 2348 2492" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2483 572 2496 604 2509 607 2509 609 2511 2346 2511 2348 2492 2346 2459 574 2453 574 2483"/>
                        </Shape>
                        <String CONTENT="for the last comer, partly in derision, partly (according to a native saying)"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l27" HPOS="581" VPOS="2511" WIDTH="1769" HEIGHT="63" BASELINE="583 2541 2350 2548" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="583 2541 581 2557 620 2570 622 2570 624 2570 1135 2561 1187 2572 1189 2572 1618 2563 1759 2574 1761 2574 2348 2563 2350 2548 2348 2518 583 2511 583 2541"/>
                        </Shape>
                        <String CONTENT="“to console him for his disgrace.” The host takes part in the race, but it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l28" HPOS="572" VPOS="2565" WIDTH="1776" HEIGHT="59" BASELINE="574 2608 2348 2604" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2608 574 2624 2346 2621 2348 2604 2343 2576 1468 2565 1466 2565 1464 2565 1462 2565 1462 2567 1451 2576 704 2567 702 2567 572 2578 574 2608"/>
                        </Shape>
                        <String CONTENT="regarded as discourteous if he seriously tries to beat his guests out of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l29" HPOS="574" VPOS="2626" WIDTH="1776" HEIGHT="63" BASELINE="574 2669 2350 2669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2669 574 2689 2350 2682 2350 2669 2350 2639 2200 2639 2177 2626 2174 2626 2172 2626 2084 2637 2055 2626 2053 2626 2051 2626 2049 2626 2047 2626 2029 2637 1986 2626 1984 2626 1982 2626 1980 2626 1977 2626 1962 2639 1850 2639 1795 2626 1793 2626 1724 2637 1672 2626 1670 2626 1668 2626 1635 2637 1603 2626 1601 2626 1598 2626 1596 2626 1594 2626 1579 2639 1414 2639 1354 2626 1352 2626 1295 2637 1241 2626 1239 2626 1237 2626 1206 2637 1128 2626 1126 2626 1124 2626 1094 2637 1057 2626 1055 2626 1053 2626 1050 2626 1048 2626 1033 2639 873 2639 752 2626 749 2626 689 2637 626 2626 624 2626 574 2637 574 2669"/>
                        </Shape>
                        <String CONTENT="prize. If he comes in first, he will not touch the prize; or, if there is more"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l30" HPOS="574" VPOS="2680" WIDTH="1728" HEIGHT="67" BASELINE="576 2721 2302 2732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 2721 574 2736 2298 2747 2302 2732 2300 2702 1980 2689 1977 2689 1975 2689 1973 2689 1956 2699 1878 2686 1876 2686 1670 2697 1562 2684 1559 2684 1557 2684 1523 2695 1421 2684 1419 2684 1310 2695 1267 2682 1265 2682 1263 2682 1261 2682 1237 2693 1061 2682 1059 2682 977 2693 951 2682 949 2682 947 2682 944 2682 921 2693 869 2680 866 2680 864 2680 862 2680 832 2693 633 2693 617 2680 615 2680 613 2680 611 2680 609 2680 576 2689 576 2721"/>
                        </Shape>
                        <String CONTENT="than one prize, he will take the smallest, leaving the others for his guests."/>
                    </TextLine>
<TextLine ID="mz_1-342_l31" HPOS="685" VPOS="2738" WIDTH="1661" HEIGHT="72" BASELINE="687 2782 2346 2795" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="687 2782 685 2795 700 2805 702 2805 704 2805 706 2805 810 2797 966 2808 968 2810 2343 2810 2346 2795 2343 2762 2112 2749 2109 2749 2107 2749 2075 2760 2055 2747 2053 2747 2051 2747 2049 2747 1824 2758 1752 2745 1750 2745 1644 2756 1627 2745 1624 2745 1622 2745 1620 2745 1492 2754 1477 2743 1475 2743 1473 2743 1471 2743 1468 2743 1440 2754 1397 2743 1395 2743 1393 2743 1391 2743 1360 2754 1263 2743 1261 2743 977 2751 964 2741 964 2738 962 2738 960 2738 957 2738 955 2738 936 2749 914 2738 912 2738 910 2738 908 2738 905 2738 888 2749 862 2738 860 2738 858 2738 687 2745 687 2782"/>
                        </Shape>
                        <String CONTENT="The Chukchee are passionately fond of reindeer-racing. In the spring,"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l32" HPOS="574" VPOS="2812" WIDTH="1774" HEIGHT="52" BASELINE="576 2842 2348 2849" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 2842 574 2857 2343 2864 2348 2849 2346 2818 576 2812 576 2842"/>
                        </Shape>
                        <String CONTENT="which is the usual season for the sport, some of the young people undertake"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l33" HPOS="572" VPOS="2862" WIDTH="1776" HEIGHT="67" BASELINE="574 2903 2348 2909" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2903 572 2916 643 2929 646 2929 2346 2922 2348 2909 2346 2879 2224 2879 2209 2866 2207 2866 2205 2866 2016 2866 2014 2866 2012 2866 2010 2866 1993 2877 1754 2864 1752 2864 1750 2864 1726 2877 1549 2877 1525 2864 1523 2864 1520 2864 1455 2875 1274 2864 1271 2864 1200 2875 1165 2862 1163 2862 1161 2862 1092 2873 574 2868 574 2903"/>
                        </Shape>
                        <String CONTENT="long journeys to try their reindeer against a possible rival. Doubtful races"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l34" HPOS="572" VPOS="2929" WIDTH="1780" HEIGHT="54" BASELINE="574 2961 2352 2968" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2961 572 2977 2348 2983 2352 2968 2348 2929 574 2929 574 2961"/>
                        </Shape>
                        <String CONTENT="often lead to quarrels, and even to feuds. I had a chance to observe one of"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l35" HPOS="572" VPOS="2990" WIDTH="1776" HEIGHT="51" BASELINE="574 3022 2348 3028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 3022 572 3035 2343 3041 2348 3028 2346 2996 574 2990 574 3022"/>
                        </Shape>
                        <String CONTENT="these in 1896 in the East Anui camps on the Wolverene River. Two rivals"/>
                    </TextLine>

                    <TextLine ID="mz_1-342_l36" HPOS="572" VPOS="3052" WIDTH="1776" HEIGHT="48" BASELINE="574 3083 2348 3087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 3083 572 3096 2343 3100 2348 3087 2346 3057 574 3052 574 3083"/>
                        </Shape>
                        <String CONTENT="of several years standing met in a race. When one had almost reached the"/>
                    </TextLine>

