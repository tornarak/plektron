                        </Shape>
                        <String CONTENT="family has one or more drums of its own, on which its members are bound"/>
                    </TextLine>

                    <TextLine ID="mz_2-141_l5" HPOS="395" VPOS="1051" WIDTH="1773" HEIGHT="59" BASELINE="397 1096 2168 1090" TAGREFS="TYPE_5">
