                        </Shape>
                        <String CONTENT="FAMILY SHAMANISM. — Shamanism among the Chukchee, as has been"/>
                    </TextLine>

                    <TextLine ID="mz_2-141_l3" HPOS="395" VPOS="930" WIDTH="1771" HEIGHT="58" BASELINE="397 973 2166 969" TAGREFS="TYPE_5">
