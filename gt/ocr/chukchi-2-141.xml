                        </Shape>
                        <String CONTENT="said before,¹ is in large measure affiliated with the family ceremonials. Each"/>
                    </TextLine>

                    <TextLine ID="mz_2-141_l4" HPOS="399" VPOS="996" WIDTH="1769" HEIGHT="53" BASELINE="399 1034 2168 1034" TAGREFS="TYPE_5">
