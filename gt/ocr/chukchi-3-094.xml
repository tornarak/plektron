                    <TextLine ID="mz_3-094_l5" HPOS="467" VPOS="696" WIDTH="1665" HEIGHT="55" BASELINE="469 735 2132 732" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="469 735 469 751 2130 747 2132 732 2126 696 467 700 469 735"/>
                        </Shape>
                        <String CONTENT="If some serious misfortune happens, the people of the nearest camp will"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l6" HPOS="360" VPOS="755" WIDTH="1770" HEIGHT="54" BASELINE="362 796 2130 792" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 796 362 809 2128 808 2130 792 2126 765 1264 755 1262 755 1260 755 1241 765 385 757 383 757 381 757 360 765 362 796"/>
                        </Shape>
                        <String CONTENT="always give help; the more so, since they are in most cases relatives, or at"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l7" HPOS="362" VPOS="817" WIDTH="1768" HEIGHT="53" BASELINE="362 854 2130 854" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 854 362 870 2130 870 2130 854 2130 825 362 817 362 854"/>
                        </Shape>
                        <String CONTENT="least good friends. As an instance may be given the following story, where"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l8" HPOS="360" VPOS="870" WIDTH="1692" HEIGHT="66" BASELINE="362 909 2052 915" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 909 360 926 374 934 376 934 378 934 379 934 902 926 937 936 939 936 941 936 2050 928 2052 915 2052 884 2038 874 2036 874 2034 874 2032 874 1707 884 1672 874 1670 874 1668 874 1666 874 1664 874 1652 884 1615 874 1613 874 1611 874 1566 884 1553 874 1551 874 1549 874 1547 874 1407 882 1385 872 1383 872 1381 872 1065 882 1038 872 1036 872 1034 872 1032 872 1030 872 1015 882 991 872 989 872 988 872 986 872 958 882 925 870 923 870 921 870 919 870 892 880 828 870 826 870 824 870 787 880 738 870 736 870 734 870 709 880 668 870 666 870 664 870 662 870 633 880 559 870 557 870 362 878 362 909"/>
                        </Shape>
                        <String CONTENT="the sudden death of a Chukchee while hunting wild reindeer is described."/>
                    </TextLine>
</TextBlock>
