                        </Shape>
                        <String CONTENT="THE VILLAGE OF THE MARITIME CHUKCHEE. — The Maritime village is"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l23" HPOS="364" VPOS="1764" WIDTH="1773" HEIGHT="55" BASELINE="366 1796 2137 1800" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1796 364 1809 381 1819 383 1819 385 1819 2135 1811 2137 1800 2128 1766 366 1764 366 1796"/>
                        </Shape>
                        <String CONTENT="founded, not on family connection, but on territorial contiguity. Many of the"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l24" HPOS="368" VPOS="1815" WIDTH="1766" HEIGHT="66" BASELINE="370 1854 2134 1860" TAGREFS="TYPE_6">
