                        </Shape>
                        <String CONTENT="villages also have the front house (aᵋttooraˊn, “front house;” or aˊrmačɪ-raˊn,"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l25" HPOS="374" VPOS="1881" WIDTH="1761" HEIGHT="61" BASELINE="376 1913 2135 1920" TAGREFS="TYPE_6">
