                        </Shape>
                        <String CONTENT="“When he left the camp and followed the reindeer-buck, they both ran to the ice on a large"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l10" HPOS="362" VPOS="1034" WIDTH="1770" HEIGHT="44" BASELINE="364 1063 2132 1067" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1063 362 1076 2128 1078 2132 1067 2130 1038 364 1034 364 1063"/>
                        </Shape>
                        <String CONTENT="lake. He slipped on the ice and fell down. Here he broke his neck and remained on the ice."/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l11" HPOS="364" VPOS="1082" WIDTH="1766" HEIGHT="47" BASELINE="366 1114 2130 1110" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1114 366 1129 2128 1129 2130 1110 2126 1082 364 1082 366 1114"/>
                        </Shape>
                        <String CONTENT="Two nights he was absent from his camp. After the second night, his wife went to the neighbors"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l12" HPOS="362" VPOS="1127" WIDTH="1768" HEIGHT="45" BASELINE="364 1156 2130 1160" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1156 362 1168 2126 1172 2130 1160 2128 1131 364 1127 364 1156"/>
                        </Shape>
                        <String CONTENT="and brought them the news: ‘My husband is absent!’ — ‘Oh, where is he?’ — ‘He was following the"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l13" HPOS="364" VPOS="1174" WIDTH="1766" HEIGHT="47" BASELINE="366 1201 2130 1205" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1201 364 1215 2126 1221 2130 1205 2128 1178 366 1174 366 1201"/>
                        </Shape>
                        <String CONTENT="wounded reindeer.’ — ‘Oh, oh! let us go and look for him.... Well, do you know what direction"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l14" HPOS="364" VPOS="1221" WIDTH="1768" HEIGHT="45" BASELINE="366 1248 2132 1252" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1248 364 1262 2128 1266 2132 1252 2130 1225 366 1221 366 1248"/>
                        </Shape>
                        <String CONTENT="we are to take?’ They went together, the woman and one of the neighbors. The woman sought"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l15" HPOS="364" VPOS="1266" WIDTH="1768" HEIGHT="46" BASELINE="366 1293 2132 1299" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1293 364 1306 2128 1312 2132 1299 2130 1271 366 1266 366 1293"/>
                        </Shape>
                        <String CONTENT="on the land. He took the road across the ice. Then he found him, and gave a signal to the"/>
                    </TextLine>

                    <TextLine ID="mz_3-094_l16" HPOS="364" VPOS="1306" WIDTH="1148" HEIGHT="51" BASELINE="366 1342 1512 1338" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1342 366 1357 1510 1353 1512 1338 1506 1306 364 1316 366 1342"/>
                        </Shape>
                        <String CONTENT="woman, who also came. The dead man was lying on the ice.”¹"/>
                    </TextLine>
</TextBlock>
