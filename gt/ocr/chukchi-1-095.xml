                        <String CONTENT="69"/>
                    </TextLine>
<TextLine ID="mz_1-095_l3" HPOS="362" VPOS="701" WIDTH="1773" HEIGHT="61" BASELINE="364 744 2135 740" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2008 703 1986 703 1964 703 1943 703 1921 703 1899 703 1878 703 1856 703 1834 703 1813 703 1791 703 1769 703 1761 701 1178 701 1176 701 1174 701 1128 712 1033 701 1031 701 970 712 819 701 817 701 814 701 780 712 700 703 687 703 665 705 643 705 622 708 615 708 576 712 555 710 535 712 513 712 492 712 470 714 448 714 427 716 405 716 383 718 362 718 364 744 364 762 2133 757 2135 740 2131 703 2008 701 2008 703"/>
                        </Shape>
                        <String CONTENT="the three northern districts, yields about 70,000 rubles. The total amount of"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l4" HPOS="366" VPOS="775" WIDTH="1767" HEIGHT="45" BASELINE="366 803 2133 803" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 803 366 820 2131 820 2133 803 2131 775 366 775 366 803"/>
                        </Shape>
                        <String CONTENT="the whalers’ trade on the seashore is uncertain. In the last few years there"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l5" HPOS="364" VPOS="820" WIDTH="1767" HEIGHT="72" BASELINE="366 866 2131 859" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 866 366 881 821 892 823 892 825 892 827 892 843 879 1018 879 2127 879 2131 859 2125 820 364 827 366 866"/>
                        </Shape>
                        <String CONTENT="have come annually to the shores of Asia about ten whaling-ships, each of"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l6" HPOS="366" VPOS="896" WIDTH="1769" HEIGHT="45" BASELINE="366 926 2135 926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 926 366 939 2133 941 2135 926 2135 896 366 896 366 926"/>
                        </Shape>
                        <String CONTENT="which carries on trade to the amount of about one or two thousand dollars;"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l7" HPOS="366" VPOS="954" WIDTH="1765" HEIGHT="48" BASELINE="366 985 2131 985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 985 366 1002 2131 1002 2131 985 2131 954 366 954 366 985"/>
                        </Shape>
                        <String CONTENT="so that the whole yearly proceeds may be anywhere from $10,000 to $20,000."/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l8" HPOS="368" VPOS="1000" WIDTH="1510" HEIGHT="63" BASELINE="368 1041 1878 1041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1041 368 1058 1876 1063 1878 1041 1878 1013 1793 1000 1791 1000 1460 1011 1447 1000 1445 1000 1442 1000 1354 1000 1352 1000 1349 1000 1347 1000 1332 1013 1239 1013 1215 1000 1213 1000 1211 1000 1209 1000 1206 1000 1196 1011 1170 1000 1167 1000 1165 1000 1057 1011 1029 1000 1027 1000 1025 1000 1022 1000 994 1011 968 1000 966 1000 964 1000 860 1011 808 1000 806 1000 702 1011 674 1000 672 1000 669 1000 667 1000 641 1011 620 1000 617 1000 615 1000 613 1000 611 1000 600 1011 578 1000 576 1000 574 1000 572 1000 570 1000 557 1013 416 1013 392 1000 390 1000 388 1000 386 1000 383 1000 368 1009 368 1041"/>
                        </Shape>
                        <String CONTENT="As stated before, this trade is carried on chiefly with the Eskimo.¹"/>
                    </TextLine>
<TextLine ID="mz_1-095_l9" HPOS="477" VPOS="1065" WIDTH="1658" HEIGHT="56" BASELINE="477 1104 2135 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 1104 477 1121 2135 1121 2135 1104 2135 1073 477 1065 477 1104"/>
                        </Shape>
                        <String CONTENT="The yearly amount of trade done in the three districts of northeastern"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l10" HPOS="366" VPOS="1117" WIDTH="1763" HEIGHT="67" BASELINE="368 1160 2129 1167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1160 366 1175 2125 1184 2129 1167 2127 1134 2042 1121 1943 1121 1941 1121 1938 1121 1936 1121 1923 1132 1886 1121 1884 1121 1882 1121 1880 1121 1843 1132 1798 1121 1795 1121 1793 1121 1475 1130 1460 1119 1458 1119 1455 1119 1453 1119 1451 1119 1425 1130 1412 1119 1410 1119 1408 1119 1317 1119 1315 1119 1313 1119 1310 1119 1297 1130 1241 1119 1239 1119 1237 1119 1213 1130 1133 1119 1131 1119 1128 1119 1094 1130 1070 1119 1068 1119 1066 1119 1063 1119 1040 1130 1009 1119 1007 1119 1005 1119 1003 1119 1001 1119 981 1130 851 1130 834 1117 832 1117 830 1117 827 1117 825 1117 793 1128 704 1117 702 1117 700 1117 676 1128 641 1117 639 1117 637 1117 635 1117 604 1128 368 1128 368 1160"/>
                        </Shape>
                        <String CONTENT="Asia by all the tribes — including the Chukchee, the Koryak, the Eskimo,"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l11" HPOS="364" VPOS="1177" WIDTH="1767" HEIGHT="65" BASELINE="366 1225 2131 1219" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1225 366 1242 2129 1240 2131 1219 2129 1186 2118 1177 2116 1177 2114 1177 2112 1177 2109 1177 2107 1177 2092 1190 1951 1190 1932 1177 1930 1177 1928 1177 1925 1177 1845 1188 1817 1177 1815 1177 1813 1177 1811 1177 1778 1188 1754 1177 1752 1177 1750 1177 1748 1177 1715 1188 1689 1177 1687 1177 1685 1177 1629 1188 1585 1177 1583 1177 1581 1177 1579 1177 1540 1190 1518 1180 1516 1180 1514 1180 1512 1180 1484 1190 1378 1180 1375 1180 1245 1190 1109 1180 1107 1180 1105 1180 1081 1190 1031 1180 1029 1180 1027 1180 1025 1180 1009 1190 474 1182 472 1182 470 1182 440 1193 386 1182 383 1182 381 1182 379 1182 364 1190 366 1225"/>
                        </Shape>
                        <String CONTENT="the Lamut, the Yukaghir, the Russian settlers, the Russianized natives, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l12" HPOS="366" VPOS="1245" WIDTH="1765" HEIGHT="56" BASELINE="368 1286 2131 1281" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1286 368 1301 2129 1296 2131 1281 2127 1253 379 1245 377 1245 375 1245 373 1245 373 1247 366 1251 368 1286"/>
                        </Shape>
                        <String CONTENT="the Yakut — does not exceed 200,000 rubles, — 70,000 in Gishiga, 70,000"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l13" HPOS="366" VPOS="1303" WIDTH="1767" HEIGHT="58" BASELINE="366 1346 2133 1346" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1346 366 1361 2131 1361 2133 1346 2133 1316 2088 1303 2086 1303 2084 1303 2023 1314 2001 1303 1999 1303 1906 1303 1904 1303 1902 1303 1899 1303 1886 1314 1826 1303 1681 1303 1679 1303 1676 1303 1674 1303 1661 1314 1620 1303 1618 1303 1616 1303 1614 1303 1579 1316 1250 1316 1235 1303 1232 1303 1230 1303 1228 1303 1226 1303 1193 1314 1172 1303 1170 1303 1167 1303 1111 1314 1007 1303 1005 1303 1003 1303 957 1314 921 1303 918 1303 916 1303 914 1303 882 1314 838 1303 836 1303 834 1303 832 1303 804 1314 366 1309 366 1346"/>
                        </Shape>
                        <String CONTENT="in Kolyma, 25,000 in Anadyr, and about 30,000 on the Chukchee Peninsula."/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l14" HPOS="364" VPOS="1370" WIDTH="1769" HEIGHT="61" BASELINE="366 1400 2133 1405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1400 364 1416 388 1429 390 1429 392 1429 1113 1420 1261 1431 1263 1431 2131 1420 2133 1405 2131 1374 366 1370 366 1400"/>
                        </Shape>
                        <String CONTENT="Of course, even the first three figures, though based on official reports, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l15" HPOS="366" VPOS="1435" WIDTH="412" HEIGHT="48" BASELINE="366 1465 778 1465" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1465 366 1483 778 1483 778 1465 778 1435 366 1435 366 1465"/>
                        </Shape>
                        <String CONTENT="only approximate."/>
                    </TextLine>
<TextLine ID="mz_1-095_l16" HPOS="477" VPOS="1524" WIDTH="1656" HEIGHT="45" BASELINE="477 1550 2133 1550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 1550 477 1569 2133 1569 2133 1550 2133 1524 477 1524 477 1550"/>
                        </Shape>
                        <String CONTENT="¹ Mr. Gondatti (op. cit., p. 12) mentions Tñeˊs˙qᴀn of Uweˊlen as being the wealthiest trader on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l17" HPOS="366" VPOS="1563" WIDTH="1763" HEIGHT="47" BASELINE="368 1593 2129 1589" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1593 368 1610 2127 1608 2129 1589 2122 1563 366 1565 368 1593"/>
                        </Shape>
                        <String CONTENT="Arctic coast. The name Tñeˊs˙qᴀn is Chukchee, as are the majority of the inhabitants of Uweˊlen. A few years"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l18" HPOS="368" VPOS="1602" WIDTH="1763" HEIGHT="52" BASELINE="370 1630 2131 1634" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1630 368 1652 2127 1654 2131 1634 2129 1606 370 1602 370 1630"/>
                        </Shape>
                        <String CONTENT="after the visit of Mr. Gondatti, Tñeˊs˙qᴀn died. It is true, however, that the Chukchee on the Arctic coast do"/>
                    </TextLine>

                    <TextLine ID="mz_1-095_l19" HPOS="368" VPOS="1645" WIDTH="1209" HEIGHT="52" BASELINE="370 1673 1577 1678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1673 368 1693 1572 1697 1577 1678 1575 1649 370 1645 370 1673"/>
                        </Shape>
                        <String CONTENT="take a more active share in trading with whalers than those on the Pacific."/>
                    </TextLine>
