                <TextBlock ID="text_1-095" HPOS="362" VPOS="597" WIDTH="1773" HEIGHT="1100"><TextLine ID="mz_1-095_l1" HPOS="936" VPOS="597" WIDTH="617" HEIGHT="56" BASELINE="938 632 1553 636" TAGREFS="TYPE_5">
