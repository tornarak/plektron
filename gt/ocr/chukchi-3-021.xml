                        </Shape>
                        <String CONTENT="and lived at his house as an adopted son-in-law. The following spring, when"/>
                    </TextLine>

                    <TextLine ID="mz_3-021_l35" HPOS="378" VPOS="2491" WIDTH="1777" HEIGHT="59" BASELINE="379 2536 2155 2528" TAGREFS="TYPE_5">
