                <TextBlock ID="text_1-178" HPOS="626" VPOS="612" WIDTH="1782" HEIGHT="2629"><TextLine ID="mz_1-178_l1" HPOS="1209" VPOS="612" WIDTH="617" HEIGHT="57" BASELINE="1211 649 1826 645" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1815 615 1806 612 1209 615 1211 649 1211 669 1824 664 1826 645 1819 617 1815 615"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l2" HPOS="639" VPOS="612" WIDTH="91" HEIGHT="70" BASELINE="643 658 730 653" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="643 658 643 671 685 682 687 682 689 682 730 666 730 653 723 612 639 619 643 658"/>
                        </Shape>
                        <String CONTENT="136"/>
                    </TextLine>
<TextLine ID="mz_1-178_l3" HPOS="628" VPOS="716" WIDTH="1774" HEIGHT="59" BASELINE="630 760 2402 755" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 760 630 775 2400 770 2402 755 2398 725 650 716 648 716 646 716 643 716 628 723 630 760"/>
                        </Shape>
                        <String CONTENT="Anadyr, then disappears for a long stretch of space, to appear finally on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l4" HPOS="628" VPOS="770" WIDTH="988" HEIGHT="70" BASELINE="630 812 1616 818" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 812 628 831 643 840 646 840 648 840 650 840 1614 833 1616 818 1616 788 1583 775 1581 775 1579 775 1282 783 1267 773 1265 773 1263 773 1261 773 1202 783 1150 773 1148 773 1146 773 1115 783 897 783 877 770 875 770 873 770 871 770 869 770 838 781 806 770 804 770 801 770 799 770 797 770 780 781 663 770 661 770 659 770 630 779 630 812"/>
                        </Shape>
                        <String CONTENT="Okhotsk Sea among the Maritime Koryak."/>
                    </TextLine>
<TextLine ID="mz_1-178_l5" HPOS="736" VPOS="844" WIDTH="1666" HEIGHT="50" BASELINE="739 876 2402 872" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="739 876 739 894 2400 889 2402 872 2398 844 736 844 739 876"/>
                        </Shape>
                        <String CONTENT="The hunting of “resident” reindeer is done with the gun, and sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l6" HPOS="630" VPOS="907" WIDTH="1772" HEIGHT="47" BASELINE="630 937 2402 937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 937 630 954 2402 954 2402 937 2402 907 630 907 630 937"/>
                        </Shape>
                        <String CONTENT="even now with the bow. For instance, bucks that go to the Chukchee herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l7" HPOS="630" VPOS="963" WIDTH="1770" HEIGHT="52" BASELINE="630 998 2400 998" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 998 630 1011 2398 1015 2400 998 2400 965 630 963 630 998"/>
                        </Shape>
                        <String CONTENT="in rutting-time may be killed only with the bow or with the lasso. The Lamut,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l8" HPOS="626" VPOS="1015" WIDTH="1778" HEIGHT="58" BASELINE="628 1056 2404 1052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1056 628 1073 2402 1069 2404 1052 2400 1015 702 1015 700 1015 626 1026 628 1056"/>
                        </Shape>
                        <String CONTENT="and, following their example, also the Reindeer Chukchee, take advantage of"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l9" HPOS="626" VPOS="1071" WIDTH="1774" HEIGHT="63" BASELINE="628 1119 2400 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1119 628 1134 2398 1130 2400 1112 2398 1084 2348 1071 2346 1071 2343 1071 2341 1071 2317 1084 2131 1084 2101 1071 2099 1071 2097 1071 2034 1082 2006 1071 2003 1071 2001 1071 1999 1071 1954 1082 1865 1071 1863 1071 1860 1071 1806 1084 1789 1073 1787 1073 1785 1073 1782 1073 1780 1073 1754 1084 1425 1073 1423 1073 1360 1084 1256 1073 1254 1073 1252 1073 1213 1086 1150 1076 1148 1076 977 1086 793 1076 791 1076 710 1086 652 1076 650 1076 648 1076 646 1076 626 1084 628 1119"/>
                        </Shape>
                        <String CONTENT="the well-known curiosity of the reindeer, to lure it within shooting range by"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l10" HPOS="628" VPOS="1134" WIDTH="1774" HEIGHT="63" BASELINE="630 1180 2402 1175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1180 630 1197 2400 1197 2402 1175 2398 1145 1516 1134 1514 1134 1440 1145 836 1136 834 1136 628 1147 630 1180"/>
                        </Shape>
                        <String CONTENT="means of a special decoy-reindeer, which is put to pasture in the open field,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l11" HPOS="628" VPOS="1193" WIDTH="1774" HEIGHT="60" BASELINE="630 1240 2402 1234" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1240 630 1253 2400 1249 2402 1234 2398 1203 1819 1193 1817 1193 1815 1193 1813 1193 1795 1203 728 1197 726 1197 628 1208 630 1240"/>
                        </Shape>
                        <String CONTENT="on the end of a very long and thin line. When wild reindeer are espied at"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l12" HPOS="628" VPOS="1255" WIDTH="1776" HEIGHT="57" BASELINE="630 1299 2404 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1299 630 1312 2402 1307 2404 1294 2400 1264 710 1255 708 1255 628 1266 630 1299"/>
                        </Shape>
                        <String CONTENT="a distance, the hunter hides behind some tree or large stone. The Lamut"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l13" HPOS="630" VPOS="1312" WIDTH="1772" HEIGHT="60" BASELINE="633 1359 2402 1355" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1359 633 1372 2400 1368 2402 1355 2398 1325 2328 1312 2326 1312 1997 1322 1928 1312 1925 1312 1923 1312 1880 1322 1785 1312 1782 1312 1733 1322 1702 1312 1700 1312 1698 1312 1696 1312 1674 1322 1631 1312 1629 1312 1627 1312 1624 1312 1596 1322 1551 1312 1549 1312 1546 1312 1544 1312 1542 1312 1527 1322 1416 1314 1414 1314 1412 1314 1410 1314 1397 1325 1382 1314 1380 1314 1378 1314 1375 1314 1373 1314 1349 1325 1328 1314 1326 1314 1323 1314 1321 1314 1293 1325 1137 1314 1135 1314 1070 1325 992 1314 990 1314 988 1314 964 1327 797 1327 741 1314 739 1314 630 1327 633 1359"/>
                        </Shape>
                        <String CONTENT="on the open plain will crouch behind the back of his riding-reindeer. Thus"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l14" HPOS="633" VPOS="1387" WIDTH="1769" HEIGHT="46" BASELINE="633 1416 2402 1416" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1416 633 1433 2402 1433 2402 1416 2402 1387 633 1387 633 1416"/>
                        </Shape>
                        <String CONTENT="the hunter patiently awaits the oncomers, directing the course of his decoy-"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l15" HPOS="628" VPOS="1431" WIDTH="1772" HEIGHT="60" BASELINE="630 1476 2400 1472" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1476 630 1491 2398 1489 2400 1472 2395 1444 2270 1431 2268 1431 2265 1431 2222 1442 2196 1431 2194 1431 2192 1431 2190 1431 2187 1431 2170 1444 2045 1444 2021 1431 2019 1431 2016 1431 1919 1442 1895 1431 1893 1431 1891 1431 1889 1431 1843 1442 1780 1431 1778 1431 1685 1442 1642 1431 1640 1431 1637 1431 1635 1431 1609 1442 1564 1431 1562 1431 1559 1431 1557 1431 1538 1442 1516 1431 1514 1431 1512 1431 1510 1431 1477 1444 1414 1433 1412 1433 1410 1433 1384 1444 1360 1433 1358 1433 1356 1433 1217 1444 1172 1433 1170 1433 1167 1433 1092 1444 899 1433 897 1433 895 1433 866 1444 689 1433 687 1433 628 1446 630 1476"/>
                        </Shape>
                        <String CONTENT="animal by dexterous pulls and jerks of the line. The best decoy-animal is a"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l16" HPOS="628" VPOS="1502" WIDTH="1774" HEIGHT="56" BASELINE="630 1532 2402 1537" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1532 628 1548 643 1558 646 1558 648 1558 650 1558 2400 1550 2402 1537 2400 1506 630 1502 630 1532"/>
                        </Shape>
                        <String CONTENT="cross with a wild reindeer, — in the rutting-season a young doe, or a buck"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l17" HPOS="630" VPOS="1550" WIDTH="1441" HEIGHT="69" BASELINE="633 1591 2071 1597" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1591 630 1608 643 1617 646 1617 648 1617 650 1617 1068 1608 1111 1619 1113 1619 1115 1619 2068 1610 2071 1597 2071 1565 2058 1554 2055 1554 2053 1554 2051 1554 1884 1565 1821 1554 1819 1554 1817 1554 1791 1565 1746 1554 1744 1554 1741 1554 1739 1554 1698 1565 1687 1554 1685 1554 1683 1554 1681 1554 1533 1563 1499 1552 1497 1552 1494 1552 1492 1552 1458 1563 1386 1552 1384 1552 1315 1563 1289 1552 1287 1552 1284 1552 1222 1563 1191 1552 1189 1552 1187 1552 1122 1563 1113 1552 1111 1552 1111 1550 1109 1550 1107 1550 1105 1550 1102 1550 1070 1561 975 1550 973 1550 916 1563 788 1563 775 1550 773 1550 771 1550 769 1550 767 1550 745 1561 717 1550 715 1550 713 1550 633 1558 633 1591"/>
                        </Shape>
                        <String CONTENT="with large antlers, that is taken by the wild bucks for a rival."/>
                    </TextLine>
<TextLine ID="mz_1-178_l18" HPOS="739" VPOS="1619" WIDTH="1663" HEIGHT="52" BASELINE="741 1656 2402 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 1656 741 1671 2400 1667 2402 1652 2398 1623 739 1619 741 1656"/>
                        </Shape>
                        <String CONTENT="The Lamut hunt reindeer in the spring, running on snowshoes over the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l19" HPOS="628" VPOS="1684" WIDTH="1776" HEIGHT="48" BASELINE="628 1714 2404 1714" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1714 628 1732 2404 1732 2404 1714 2404 1686 628 1684 628 1714"/>
                        </Shape>
                        <String CONTENT="hard-crusted snow, but this is possible only in a wooded country. On the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l20" HPOS="628" VPOS="1732" WIDTH="1774" HEIGHT="69" BASELINE="630 1775 2402 1771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1775 630 1790 1239 1801 1241 1801 1243 1801 1274 1790 2400 1790 2402 1771 2398 1742 1516 1732 1514 1732 1455 1742 648 1734 646 1734 643 1734 641 1734 628 1740 630 1775"/>
                        </Shape>
                        <String CONTENT="tundra the snow is always too hard-beaten by winds to give a man with"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l21" HPOS="628" VPOS="1803" WIDTH="1018" HEIGHT="48" BASELINE="630 1836 1646 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1836 630 1851 1644 1849 1646 1831 1640 1803 628 1805 630 1836"/>
                        </Shape>
                        <String CONTENT="snowshoes any advantage over the reindeer."/>
                    </TextLine>
<TextLine ID="mz_1-178_l22" HPOS="741" VPOS="1853" WIDTH="1663" HEIGHT="58" BASELINE="741 1896 2404 1896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 1896 741 1911 2404 1911 2404 1896 2404 1866 2161 1866 2125 1853 2122 1853 2120 1853 2118 1853 2094 1866 1993 1866 1977 1853 1975 1853 1973 1853 1971 1853 1969 1853 1945 1866 1728 1866 1709 1853 1707 1853 1705 1853 1702 1853 1598 1864 1570 1853 1568 1853 1566 1853 1479 1864 1419 1853 1416 1853 1414 1853 1384 1864 1302 1853 1300 1853 1297 1853 1271 1864 1261 1853 1258 1853 1256 1853 1163 1853 1161 1853 1159 1853 1157 1853 1144 1864 1063 1853 1061 1853 1003 1864 988 1853 986 1853 983 1853 981 1853 918 1864 741 1857 741 1896"/>
                        </Shape>
                        <String CONTENT="To the Maritime Chukchee the wild reindeer cannot be so important as"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l23" HPOS="630" VPOS="1924" WIDTH="1774" HEIGHT="48" BASELINE="630 1955 2404 1955" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 1955 630 1972 2404 1972 2404 1955 2404 1924 630 1924 630 1955"/>
                        </Shape>
                        <String CONTENT="to the American Eskimo, because most of the hunt is done by the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l24" HPOS="628" VPOS="1970" WIDTH="1774" HEIGHT="63" BASELINE="630 2011 2402 2017" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2011 628 2026 2398 2033 2402 2017 2400 1987 2094 1974 2092 1974 2038 1985 2008 1974 2006 1974 2003 1974 2001 1974 1964 1985 1928 1974 1925 1974 1923 1974 1813 1985 1739 1972 1737 1972 1679 1983 1492 1972 1490 1972 1343 1983 1304 1972 1302 1972 1300 1972 1297 1972 1258 1983 1170 1970 1167 1970 1098 1981 1040 1970 1038 1970 986 1981 960 1970 957 1970 955 1970 953 1970 923 1983 808 1983 793 1970 791 1970 788 1970 786 1970 784 1970 762 1981 745 1970 743 1970 741 1970 739 1970 630 1978 630 2011"/>
                        </Shape>
                        <String CONTENT="Chukchee and other inland tribes; and the maritime people, for the most part,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l25" HPOS="630" VPOS="2041" WIDTH="1774" HEIGHT="57" BASELINE="633 2072 2404 2076" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2072 630 2087 646 2098 648 2098 650 2098 652 2098 2402 2091 2404 2076 2402 2046 633 2041 633 2072"/>
                        </Shape>
                        <String CONTENT="can only have a share in their large hunts. Thus, as already mentioned,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l26" HPOS="630" VPOS="2091" WIDTH="1774" HEIGHT="63" BASELINE="630 2132 2404 2137" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2132 630 2154 2402 2150 2404 2137 2402 2106 2326 2093 2107 2093 2105 2093 2103 2093 2101 2093 2088 2104 2034 2093 2032 2093 2029 2093 1993 2106 1769 2106 1754 2093 1752 2093 1750 2093 1748 2093 1746 2093 1722 2104 1546 2093 1544 2093 1391 2102 1375 2091 1373 2091 1371 2091 1369 2091 1367 2091 1336 2102 1300 2091 1297 2091 1295 2091 1293 2091 1265 2102 1165 2091 1163 2091 1094 2102 1050 2091 1048 2091 1046 2091 992 2102 962 2091 960 2091 957 2091 955 2091 914 2102 830 2091 827 2091 825 2091 795 2102 762 2091 760 2091 758 2091 630 2100 630 2132"/>
                        </Shape>
                        <String CONTENT="people from Pacific villages in former times used to go up the Anadyr River"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l27" HPOS="630" VPOS="2160" WIDTH="1776" HEIGHT="50" BASELINE="633 2193 2406 2197" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2193 630 2206 2402 2210 2406 2197 2404 2165 633 2160 633 2193"/>
                        </Shape>
                        <String CONTENT="to take part in the reindeer-killing on the water. On the tundra between the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l28" HPOS="628" VPOS="2212" WIDTH="1774" HEIGHT="65" BASELINE="628 2256 2402 2256" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2256 628 2271 2400 2277 2402 2256 2402 2225 2315 2212 2313 2212 2311 2212 2289 2223 2268 2212 2265 2212 2263 2212 2261 2212 2259 2212 2242 2223 2218 2212 2216 2212 2213 2212 2161 2223 2075 2212 2073 2212 2023 2223 1995 2212 1993 2212 1990 2212 1711 2223 1681 2212 1679 2212 1676 2212 1618 2223 1536 2212 1533 2212 1531 2212 1488 2223 1391 2212 1388 2212 1317 2223 1289 2212 1287 2212 1284 2212 1282 2212 1239 2223 1124 2212 1122 2212 1120 2212 1085 2223 901 2212 899 2212 808 2223 654 2212 652 2212 650 2212 628 2223 628 2256"/>
                        </Shape>
                        <String CONTENT="Anadyr and Indian Point the chief reindeer-hunters are Maritime Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l29" HPOS="630" VPOS="2282" WIDTH="1774" HEIGHT="49" BASELINE="633 2312 2404 2316" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2312 630 2327 2400 2331 2404 2316 2402 2286 633 2282 633 2312"/>
                        </Shape>
                        <String CONTENT="who have acquired a few reindeer, and who for this reason spend much time"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l30" HPOS="628" VPOS="2336" WIDTH="1776" HEIGHT="56" BASELINE="630 2370 2404 2377" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2370 628 2385 2400 2392 2404 2377 2402 2347 630 2336 630 2370"/>
                        </Shape>
                        <String CONTENT="inland, scouring the country the whole time far and wide. The same is true"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l31" HPOS="628" VPOS="2388" WIDTH="804" HEIGHT="60" BASELINE="630 2431 1432 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2431 628 2444 1427 2448 1432 2435 1432 2405 1386 2390 1384 2390 1382 2390 1263 2401 1211 2390 1209 2390 1206 2390 1204 2390 1204 2392 1191 2405 1137 2405 1115 2390 1113 2390 1111 2390 1109 2390 1107 2390 1105 2390 1087 2403 1068 2390 1066 2390 1063 2390 1061 2390 1059 2390 1033 2403 1025 2390 1022 2390 1022 2388 1020 2388 1018 2388 1016 2388 1014 2388 966 2401 923 2388 921 2388 918 2388 916 2388 884 2401 873 2390 873 2388 871 2388 869 2388 866 2388 864 2388 827 2403 771 2403 758 2390 758 2388 756 2388 754 2388 752 2388 749 2388 723 2401 663 2388 661 2388 659 2388 630 2398 630 2431"/>
                        </Shape>
                        <String CONTENT="for the whole Chukchee Peninsula."/>
                    </TextLine>
<TextLine ID="mz_1-178_l32" HPOS="743" VPOS="2450" WIDTH="1661" HEIGHT="61" BASELINE="745 2496 2404 2492" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="745 2496 745 2511 2402 2507 2404 2492 2402 2463 2352 2450 2350 2450 2348 2450 2346 2450 2322 2463 2166 2463 2151 2450 2148 2450 2146 2450 2144 2450 2142 2450 2140 2450 2122 2463 1815 2463 1791 2450 1789 2450 1787 2450 1653 2461 1622 2450 1620 2450 1618 2450 1616 2450 1570 2463 1546 2453 1544 2453 1542 2453 1540 2453 1514 2463 1501 2453 1499 2453 1497 2453 1391 2453 1388 2453 1386 2453 1384 2453 1371 2463 1265 2453 1263 2453 1261 2453 1226 2463 743 2457 745 2496"/>
                        </Shape>
                        <String CONTENT="The elk, in former times, lived in the Kolyma country, close to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l33" HPOS="628" VPOS="2518" WIDTH="1780" HEIGHT="52" BASELINE="630 2552 2408 2557" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2552 628 2565 2404 2570 2408 2557 2404 2518 630 2518 630 2552"/>
                        </Shape>
                        <String CONTENT="seashore; and the Kolyma Yukaghir derived from it a considerable part of"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l34" HPOS="630" VPOS="2578" WIDTH="1774" HEIGHT="63" BASELINE="633 2611 2404 2617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2611 630 2624 1908 2641 1910 2641 2402 2630 2404 2617 2402 2580 633 2578 633 2611"/>
                        </Shape>
                        <String CONTENT="their food. Around old dwelling-places at the mouth of the Kolyma I could"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l35" HPOS="633" VPOS="2630" WIDTH="1773" HEIGHT="69" BASELINE="635 2671 2406 2678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 2671 633 2682 691 2695 693 2695 1737 2689 1815 2699 1817 2699 2404 2689 2406 2678 2404 2647 2198 2634 2196 2634 2194 2634 2192 2634 2174 2645 2142 2634 2140 2634 2138 2634 2135 2634 2101 2645 2055 2634 2053 2634 2051 2634 2049 2634 2019 2645 1990 2634 1988 2634 1986 2634 1824 2645 1761 2632 1759 2632 1629 2643 1380 2632 1378 2632 1375 2632 1345 2643 1315 2632 1313 2632 1310 2632 1245 2643 1152 2630 1150 2630 635 2639 635 2671"/>
                        </Shape>
                        <String CONTENT="always find an abundance of elk antlers and bones; and the jacket of a"/>
                    </TextLine>

