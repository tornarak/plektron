                        </Shape>
                        <String CONTENT="Anadyr, then disappears for a long stretch of space, to appear finally on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l4" HPOS="649" VPOS="785" WIDTH="988" HEIGHT="70" BASELINE="651 827 1637 833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 827 649 846 664 855 667 855 669 855 671 855 1635 848 1637 833 1637 803 1604 790 1602 790 1600 790 1303 798 1288 788 1286 788 1284 788 1282 788 1223 798 1171 788 1169 788 1167 788 1136 798 918 798 898 785 896 785 894 785 892 785 890 785 859 796 827 785 825 785 822 785 820 785 818 785 801 796 684 785 682 785 680 785 651 794 651 827"/>
                        </Shape>
                        <String CONTENT="Okhotsk Sea among the Maritime Koryak."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-178_r3" HPOS="649" VPOS="856" WIDTH="1778" HEIGHT="776" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 856 2427 856 2427 1632 649 1632"/>
