                    <TextLine ID="mz_1-178_l5" HPOS="757" VPOS="859" WIDTH="1666" HEIGHT="50" BASELINE="760 891 2423 887" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="760 891 760 909 2421 904 2423 887 2419 859 757 859 760 891"/>
                        </Shape>
                        <String CONTENT="The hunting of “resident” reindeer is done with the gun, and sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l6" HPOS="651" VPOS="922" WIDTH="1772" HEIGHT="47" BASELINE="651 952 2423 952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 952 651 969 2423 969 2423 952 2423 922 651 922 651 952"/>
                        </Shape>
                        <String CONTENT="even now with the bow. For instance, bucks that go to the Chukchee herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l7" HPOS="651" VPOS="978" WIDTH="1770" HEIGHT="52" BASELINE="651 1013 2421 1013" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1013 651 1026 2419 1030 2421 1013 2421 980 651 978 651 1013"/>
                        </Shape>
                        <String CONTENT="in rutting-time may be killed only with the bow or with the lasso. The Lamut,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l8" HPOS="647" VPOS="1030" WIDTH="1778" HEIGHT="58" BASELINE="649 1071 2425 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1071 649 1088 2423 1084 2425 1067 2421 1030 723 1030 721 1030 647 1041 649 1071"/>
                        </Shape>
                        <String CONTENT="and, following their example, also the Reindeer Chukchee, take advantage of"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l9" HPOS="647" VPOS="1086" WIDTH="1774" HEIGHT="63" BASELINE="649 1134 2421 1127" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1134 649 1149 2419 1145 2421 1127 2419 1099 2369 1086 2367 1086 2364 1086 2362 1086 2338 1099 2152 1099 2122 1086 2120 1086 2118 1086 2055 1097 2027 1086 2024 1086 2022 1086 2020 1086 1975 1097 1886 1086 1884 1086 1881 1086 1827 1099 1810 1088 1808 1088 1806 1088 1803 1088 1801 1088 1775 1099 1446 1088 1444 1088 1381 1099 1277 1088 1275 1088 1273 1088 1234 1101 1171 1091 1169 1091 998 1101 814 1091 812 1091 731 1101 673 1091 671 1091 669 1091 667 1091 647 1099 649 1134"/>
                        </Shape>
                        <String CONTENT="the well-known curiosity of the reindeer, to lure it within shooting range by"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l10" HPOS="649" VPOS="1149" WIDTH="1774" HEIGHT="63" BASELINE="651 1195 2423 1190" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1195 651 1212 2421 1212 2423 1190 2419 1160 1537 1149 1535 1149 1461 1160 857 1151 855 1151 649 1162 651 1195"/>
                        </Shape>
                        <String CONTENT="means of a special decoy-reindeer, which is put to pasture in the open field,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l11" HPOS="649" VPOS="1208" WIDTH="1774" HEIGHT="60" BASELINE="651 1255 2423 1249" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1255 651 1268 2421 1264 2423 1249 2419 1218 1840 1208 1838 1208 1836 1208 1834 1208 1816 1218 749 1212 747 1212 649 1223 651 1255"/>
                        </Shape>
                        <String CONTENT="on the end of a very long and thin line. When wild reindeer are espied at"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l12" HPOS="649" VPOS="1270" WIDTH="1776" HEIGHT="57" BASELINE="651 1314 2425 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1314 651 1327 2423 1322 2425 1309 2421 1279 731 1270 729 1270 649 1281 651 1314"/>
                        </Shape>
                        <String CONTENT="a distance, the hunter hides behind some tree or large stone. The Lamut"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l13" HPOS="651" VPOS="1327" WIDTH="1772" HEIGHT="60" BASELINE="654 1374 2423 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1374 654 1387 2421 1383 2423 1370 2419 1340 2349 1327 2347 1327 2018 1337 1949 1327 1946 1327 1944 1327 1901 1337 1806 1327 1803 1327 1754 1337 1723 1327 1721 1327 1719 1327 1717 1327 1695 1337 1652 1327 1650 1327 1648 1327 1645 1327 1617 1337 1572 1327 1570 1327 1567 1327 1565 1327 1563 1327 1548 1337 1437 1329 1435 1329 1433 1329 1431 1329 1418 1340 1403 1329 1401 1329 1399 1329 1396 1329 1394 1329 1370 1340 1349 1329 1347 1329 1344 1329 1342 1329 1314 1340 1158 1329 1156 1329 1091 1340 1013 1329 1011 1329 1009 1329 985 1342 818 1342 762 1329 760 1329 651 1342 654 1374"/>
                        </Shape>
                        <String CONTENT="on the open plain will crouch behind the back of his riding-reindeer. Thus"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l14" HPOS="654" VPOS="1402" WIDTH="1769" HEIGHT="46" BASELINE="654 1431 2423 1431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1431 654 1448 2423 1448 2423 1431 2423 1402 654 1402 654 1431"/>
                        </Shape>
                        <String CONTENT="the hunter patiently awaits the oncomers, directing the course of his decoy-"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l15" HPOS="649" VPOS="1446" WIDTH="1772" HEIGHT="60" BASELINE="651 1491 2421 1487" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1491 651 1506 2419 1504 2421 1487 2416 1459 2291 1446 2289 1446 2286 1446 2243 1457 2217 1446 2215 1446 2213 1446 2211 1446 2208 1446 2191 1459 2066 1459 2042 1446 2040 1446 2037 1446 1940 1457 1916 1446 1914 1446 1912 1446 1910 1446 1864 1457 1801 1446 1799 1446 1706 1457 1663 1446 1661 1446 1658 1446 1656 1446 1630 1457 1585 1446 1583 1446 1580 1446 1578 1446 1559 1457 1537 1446 1535 1446 1533 1446 1531 1446 1498 1459 1435 1448 1433 1448 1431 1448 1405 1459 1381 1448 1379 1448 1377 1448 1238 1459 1193 1448 1191 1448 1188 1448 1113 1459 920 1448 918 1448 916 1448 887 1459 710 1448 708 1448 649 1461 651 1491"/>
                        </Shape>
                        <String CONTENT="animal by dexterous pulls and jerks of the line. The best decoy-animal is a"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l16" HPOS="649" VPOS="1517" WIDTH="1774" HEIGHT="56" BASELINE="651 1547 2423 1552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1547 649 1563 664 1573 667 1573 669 1573 671 1573 2421 1565 2423 1552 2421 1521 651 1517 651 1547"/>
                        </Shape>
                        <String CONTENT="cross with a wild reindeer, — in the rutting-season a young doe, or a buck"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l17" HPOS="651" VPOS="1565" WIDTH="1441" HEIGHT="69" BASELINE="654 1606 2092 1612" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1606 651 1623 664 1632 667 1632 669 1632 671 1632 1089 1623 1132 1634 1134 1634 1136 1634 2089 1625 2092 1612 2092 1580 2079 1569 2076 1569 2074 1569 2072 1569 1905 1580 1842 1569 1840 1569 1838 1569 1812 1580 1767 1569 1765 1569 1762 1569 1760 1569 1719 1580 1708 1569 1706 1569 1704 1569 1702 1569 1554 1578 1520 1567 1518 1567 1515 1567 1513 1567 1479 1578 1407 1567 1405 1567 1336 1578 1310 1567 1308 1567 1305 1567 1243 1578 1212 1567 1210 1567 1208 1567 1143 1578 1134 1567 1132 1567 1132 1565 1130 1565 1128 1565 1126 1565 1123 1565 1091 1576 996 1565 994 1565 937 1578 809 1578 796 1565 794 1565 792 1565 790 1565 788 1565 766 1576 738 1565 736 1565 734 1565 654 1573 654 1606"/>
                        </Shape>
                        <String CONTENT="with large antlers, that is taken by the wild bucks for a rival."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-178_r4" HPOS="649" VPOS="1632" WIDTH="1778" HEIGHT="241" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 1632 2427 1632 2427 1873 649 1873"/>
                    </Shape>
                    <TextLine ID="mz_1-178_l18" HPOS="760" VPOS="1634" WIDTH="1663" HEIGHT="52" BASELINE="762 1671 2423 1667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="762 1671 762 1686 2421 1682 2423 1667 2419 1638 760 1634 762 1671"/>
                        </Shape>
                        <String CONTENT="The Lamut hunt reindeer in the spring, running on snowshoes over the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l19" HPOS="649" VPOS="1699" WIDTH="1776" HEIGHT="48" BASELINE="649 1729 2425 1729" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1729 649 1747 2425 1747 2425 1729 2425 1701 649 1699 649 1729"/>
                        </Shape>
                        <String CONTENT="hard-crusted snow, but this is possible only in a wooded country. On the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l20" HPOS="649" VPOS="1747" WIDTH="1774" HEIGHT="69" BASELINE="651 1790 2423 1786" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1790 651 1805 1260 1816 1262 1816 1264 1816 1295 1805 2421 1805 2423 1786 2419 1757 1537 1747 1535 1747 1476 1757 669 1749 667 1749 664 1749 662 1749 649 1755 651 1790"/>
                        </Shape>
                        <String CONTENT="tundra the snow is always too hard-beaten by winds to give a man with"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l21" HPOS="649" VPOS="1818" WIDTH="1018" HEIGHT="48" BASELINE="651 1851 1667 1846" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1851 651 1866 1665 1864 1667 1846 1661 1818 649 1820 651 1851"/>
                        </Shape>
                        <String CONTENT="snowshoes any advantage over the reindeer."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-178_r5" HPOS="649" VPOS="1873" WIDTH="1778" HEIGHT="592" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 1873 2427 1873 2427 2465 649 2465"/>
                    </Shape>
                    <TextLine ID="mz_1-178_l22" HPOS="762" VPOS="1868" WIDTH="1663" HEIGHT="58" BASELINE="762 1911 2425 1911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="762 1911 762 1926 2425 1926 2425 1911 2425 1881 2182 1881 2146 1868 2143 1868 2141 1868 2139 1868 2115 1881 2014 1881 1998 1868 1996 1868 1994 1868 1992 1868 1990 1868 1966 1881 1749 1881 1730 1868 1728 1868 1726 1868 1723 1868 1619 1879 1591 1868 1589 1868 1587 1868 1500 1879 1440 1868 1437 1868 1435 1868 1405 1879 1323 1868 1321 1868 1318 1868 1292 1879 1282 1868 1279 1868 1277 1868 1184 1868 1182 1868 1180 1868 1178 1868 1165 1879 1084 1868 1082 1868 1024 1879 1009 1868 1007 1868 1004 1868 1002 1868 939 1879 762 1872 762 1911"/>
                        </Shape>
                        <String CONTENT="To the Maritime Chukchee the wild reindeer cannot be so important as"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l23" HPOS="651" VPOS="1939" WIDTH="1774" HEIGHT="48" BASELINE="651 1970 2425 1970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1970 651 1987 2425 1987 2425 1970 2425 1939 651 1939 651 1970"/>
                        </Shape>
                        <String CONTENT="to the American Eskimo, because most of the hunt is done by the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l24" HPOS="649" VPOS="1985" WIDTH="1774" HEIGHT="63" BASELINE="651 2026 2423 2032" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2026 649 2041 2419 2048 2423 2032 2421 2002 2115 1989 2113 1989 2059 2000 2029 1989 2027 1989 2024 1989 2022 1989 1985 2000 1949 1989 1946 1989 1944 1989 1834 2000 1760 1987 1758 1987 1700 1998 1513 1987 1511 1987 1364 1998 1325 1987 1323 1987 1321 1987 1318 1987 1279 1998 1191 1985 1188 1985 1119 1996 1061 1985 1059 1985 1007 1996 981 1985 978 1985 976 1985 974 1985 944 1998 829 1998 814 1985 812 1985 809 1985 807 1985 805 1985 783 1996 766 1985 764 1985 762 1985 760 1985 651 1993 651 2026"/>
                        </Shape>
                        <String CONTENT="Chukchee and other inland tribes; and the maritime people, for the most part,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l25" HPOS="651" VPOS="2056" WIDTH="1774" HEIGHT="57" BASELINE="654 2087 2425 2091" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2087 651 2102 667 2113 669 2113 671 2113 673 2113 2423 2106 2425 2091 2423 2061 654 2056 654 2087"/>
                        </Shape>
                        <String CONTENT="can only have a share in their large hunts. Thus, as already mentioned,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l26" HPOS="651" VPOS="2106" WIDTH="1774" HEIGHT="63" BASELINE="651 2147 2425 2152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2147 651 2169 2423 2165 2425 2152 2423 2121 2347 2108 2128 2108 2126 2108 2124 2108 2122 2108 2109 2119 2055 2108 2053 2108 2050 2108 2014 2121 1790 2121 1775 2108 1773 2108 1771 2108 1769 2108 1767 2108 1743 2119 1567 2108 1565 2108 1412 2117 1396 2106 1394 2106 1392 2106 1390 2106 1388 2106 1357 2117 1321 2106 1318 2106 1316 2106 1314 2106 1286 2117 1186 2106 1184 2106 1115 2117 1071 2106 1069 2106 1067 2106 1013 2117 983 2106 981 2106 978 2106 976 2106 935 2117 851 2106 848 2106 846 2106 816 2117 783 2106 781 2106 779 2106 651 2115 651 2147"/>
                        </Shape>
                        <String CONTENT="people from Pacific villages in former times used to go up the Anadyr River"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l27" HPOS="651" VPOS="2175" WIDTH="1776" HEIGHT="50" BASELINE="654 2208 2427 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2208 651 2221 2423 2225 2427 2212 2425 2180 654 2175 654 2208"/>
                        </Shape>
                        <String CONTENT="to take part in the reindeer-killing on the water. On the tundra between the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l28" HPOS="649" VPOS="2227" WIDTH="1774" HEIGHT="65" BASELINE="649 2271 2423 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2271 649 2286 2421 2292 2423 2271 2423 2240 2336 2227 2334 2227 2332 2227 2310 2238 2289 2227 2286 2227 2284 2227 2282 2227 2280 2227 2263 2238 2239 2227 2237 2227 2234 2227 2182 2238 2096 2227 2094 2227 2044 2238 2016 2227 2014 2227 2011 2227 1732 2238 1702 2227 1700 2227 1697 2227 1639 2238 1557 2227 1554 2227 1552 2227 1509 2238 1412 2227 1409 2227 1338 2238 1310 2227 1308 2227 1305 2227 1303 2227 1260 2238 1145 2227 1143 2227 1141 2227 1106 2238 922 2227 920 2227 829 2238 675 2227 673 2227 671 2227 649 2238 649 2271"/>
                        </Shape>
                        <String CONTENT="Anadyr and Indian Point the chief reindeer-hunters are Maritime Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l29" HPOS="651" VPOS="2297" WIDTH="1774" HEIGHT="49" BASELINE="654 2327 2425 2331" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2327 651 2342 2421 2346 2425 2331 2423 2301 654 2297 654 2327"/>
                        </Shape>
                        <String CONTENT="who have acquired a few reindeer, and who for this reason spend much time"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l30" HPOS="649" VPOS="2351" WIDTH="1776" HEIGHT="56" BASELINE="651 2385 2425 2392" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2385 649 2400 2421 2407 2425 2392 2423 2362 651 2351 651 2385"/>
                        </Shape>
                        <String CONTENT="inland, scouring the country the whole time far and wide. The same is true"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l31" HPOS="649" VPOS="2403" WIDTH="804" HEIGHT="60" BASELINE="651 2446 1453 2450" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2446 649 2459 1448 2463 1453 2450 1453 2420 1407 2405 1405 2405 1403 2405 1284 2416 1232 2405 1230 2405 1227 2405 1225 2405 1225 2407 1212 2420 1158 2420 1136 2405 1134 2405 1132 2405 1130 2405 1128 2405 1126 2405 1108 2418 1089 2405 1087 2405 1084 2405 1082 2405 1080 2405 1054 2418 1046 2405 1043 2405 1043 2403 1041 2403 1039 2403 1037 2403 1035 2403 987 2416 944 2403 942 2403 939 2403 937 2403 905 2416 894 2405 894 2403 892 2403 890 2403 887 2403 885 2403 848 2418 792 2418 779 2405 779 2403 777 2403 775 2403 773 2403 770 2403 744 2416 684 2403 682 2403 680 2403 651 2413 651 2446"/>
                        </Shape>
                        <String CONTENT="for the whole Chukchee Peninsula."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-178_r6" HPOS="649" VPOS="2465" WIDTH="1778" HEIGHT="727" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 2465 2427 2465 2427 3192 649 3192"/>
                    </Shape>
                    <TextLine ID="mz_1-178_l32" HPOS="764" VPOS="2465" WIDTH="1661" HEIGHT="61" BASELINE="766 2511 2425 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="766 2511 766 2526 2423 2522 2425 2507 2423 2478 2373 2465 2371 2465 2369 2465 2367 2465 2343 2478 2187 2478 2172 2465 2169 2465 2167 2465 2165 2465 2163 2465 2161 2465 2143 2478 1836 2478 1812 2465 1810 2465 1808 2465 1674 2476 1643 2465 1641 2465 1639 2465 1637 2465 1591 2478 1567 2468 1565 2468 1563 2468 1561 2468 1535 2478 1522 2468 1520 2468 1518 2468 1412 2468 1409 2468 1407 2468 1405 2468 1392 2478 1286 2468 1284 2468 1282 2468 1247 2478 764 2472 766 2511"/>
                        </Shape>
                        <String CONTENT="The elk, in former times, lived in the Kolyma country, close to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-178_l33" HPOS="649" VPOS="2533" WIDTH="1780" HEIGHT="52" BASELINE="651 2567 2429 2572" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2567 649 2580 2425 2585 2429 2572 2425 2533 651 2533 651 2567"/>
                        </Shape>
