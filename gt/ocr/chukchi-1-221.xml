                        <Shape>
                            <Polygon POINTS="439 1974 439 1989 2211 1980 2213 1965 2208 1935 1823 1924 1821 1924 1765 1935 1349 1926 1347 1926 1344 1926 1321 1939 437 1939 439 1974"/>
                        </Shape>
