                            <Polygon POINTS="443 2632 443 2649 2208 2643 2211 2623 2206 2595 1334 2587 1331 2587 1329 2587 1327 2587 1310 2598 968 2589 965 2589 441 2602 443 2632"/>
                        </Shape>
