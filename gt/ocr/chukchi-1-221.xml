                        </Shape>
                        <String CONTENT="the ceiling, a line is stretched, which serves for hanging up small articles of"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l10" HPOS="439" VPOS="1160" WIDTH="1774" HEIGHT="58" BASELINE="439 1190 2213 1190" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1190 439 1203 749 1216 751 1216 861 1205 916 1216 918 1218 1017 1218 1017 1216 1020 1216 1022 1216 1037 1205 1323 1216 1325 1216 1383 1205 1892 1205 1977 1216 1979 1216 2213 1203 2213 1190 2213 1160 439 1160 439 1190"/>
                        </Shape>
                        <String CONTENT="dress that require drying over the lamp. The left side of the sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l11" HPOS="437" VPOS="1214" WIDTH="1776" HEIGHT="63" BASELINE="439 1253 2213 1247" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1253 439 1266 955 1277 957 1277 1071 1266 1615 1275 1617 1275 1674 1264 2213 1264 2213 1247 2206 1214 437 1216 439 1253"/>
                        </Shape>
