                        <Shape>
                            <Polygon POINTS="439 1671 439 1686 2206 1688 2208 1671 2208 1641 439 1641 439 1671"/>
                        </Shape>
                        <String CONTENT="outside of the room, lying flat on their stomachs, and raising themselves up,"/>
                    </TextLine>

