                        <Shape>
                            <Polygon POINTS="545 891 545 909 2211 909 2213 891 2211 861 545 857 545 891"/>
                        </Shape>
                        <String CONTENT="Because of the position of the sleeping-room, the tent often has a some-"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l6" HPOS="437" VPOS="909" WIDTH="1778" HEIGHT="58" BASELINE="439 952 2215 948" TAGREFS="TYPE_5">
                        <Shape>
