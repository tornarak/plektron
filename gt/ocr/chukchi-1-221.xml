                        <Shape>
                            <Polygon POINTS="437 1431 437 1446 983 1457 985 1457 987 1457 989 1457 1007 1446 1184 1446 1221 1457 1223 1457 1225 1457 1450 1444 1767 1454 1769 1454 2208 1444 2211 1426 2204 1398 435 1400 437 1431"/>
                        </Shape>
                        <String CONTENT="sleeping-room, however, affords little room for the stranger. A few extra"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l15" HPOS="437" VPOS="1457" WIDTH="1774" HEIGHT="52" BASELINE="439 1491 2211 1485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1491 439 1509 2208 1502 2211 1485 2204 1457 437 1461 439 1491"/>
                        </Shape>
