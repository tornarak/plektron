                    </TextLine>

                    <TextLine ID="mz_1-221_l12" HPOS="446" VPOS="1275" WIDTH="1765" HEIGHT="62" BASELINE="448 1307 2211 1311" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1307 446 1320 521 1335 524 1337 818 1337 818 1335 820 1335 822 1335 838 1324 1167 1335 1169 1335 1236 1324 1399 1324 1414 1337 1416 1337 1418 1337 1420 1337 1546 1327 1583 1337 1585 1337 1587 1337 1589 1337 1632 1327 1938 1337 1940 1337 1942 1337 1983 1327 2208 1327 2211 1311 2208 1281 448 1275 448 1307"/>
                        </Shape>
                        <String CONTENT="“master’s place;” while the right side is given up to the younger members"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l13" HPOS="439" VPOS="1342" WIDTH="1772" HEIGHT="45" BASELINE="439 1370 2211 1370" TAGREFS="TYPE_5">
