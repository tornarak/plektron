                    <TextLine ID="mz_1-221_l7" HPOS="439" VPOS="980" WIDTH="1774" HEIGHT="48" BASELINE="439 1011 2213 1011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1011 439 1028 2213 1028 2213 1011 2213 980 439 980 439 1011"/>
                        </Shape>
                        <String CONTENT="construction of the inner room. The rear side (kɪˊnmen) of the sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l8" HPOS="437" VPOS="1026" WIDTH="1776" HEIGHT="62" BASELINE="439 1071 2213 1067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1071 439 1088 2211 1084 2213 1067 2208 1039 1957 1039 1942 1026 1940 1026 1938 1026 1936 1026 1933 1026 1888 1037 1814 1026 1812 1026 1736 1037 1665 1026 1663 1026 1323 1039 1234 1028 1232 1028 1169 1039 1110 1028 1108 1028 989 1039 929 1028 926 1028 924 1028 892 1039 857 1028 855 1028 853 1028 437 1034 439 1071"/>
                        </Shape>
                        <String CONTENT="has a lamp fixed in the middle, quite near the wall (Plate XIV). Above it, near"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l9" HPOS="437" VPOS="1088" WIDTH="1778" HEIGHT="65" BASELINE="439 1130 2215 1125" TAGREFS="TYPE_5">
