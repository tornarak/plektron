                        <Shape>
                            <Polygon POINTS="439 1732 439 1749 2206 1740 2208 1723 2202 1695 437 1695 439 1732"/>
                        </Shape>
                        <String CONTENT="like so many seals, from under the tent-cover, which is fastened around their"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l20" HPOS="437" VPOS="1751" WIDTH="1771" HEIGHT="58" BASELINE="439 1792 2208 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1792 439 1807 2204 1809 2208 1788 2204 1760 463 1751 461 1751 459 1751 437 1760 439 1792"/>
                        </Shape>
