                        <Shape>
                            <Polygon POINTS="441 2333 441 2349 2211 2342 2213 2327 2208 2299 1033 2290 1030 2290 965 2301 459 2292 456 2292 454 2292 452 2292 439 2299 441 2333"/>
                        </Shape>
