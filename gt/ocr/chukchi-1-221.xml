                        <Shape>
                            <Polygon POINTS="439 1612 439 1630 2208 1619 2211 1604 2206 1576 456 1571 454 1571 452 1571 450 1571 437 1578 439 1612"/>
                        </Shape>
                        <String CONTENT="they can only thrust their heads in, and must keep the rest of their bodies"/>
                    </TextLine>

