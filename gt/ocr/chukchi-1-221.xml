                        <Shape>
                            <Polygon POINTS="439 1851 439 1870 2208 1864 2211 1844 2204 1816 437 1820 439 1851"/>
                        </Shape>
                        <String CONTENT="and trays of steaming meat and kettles of boiling tea are brought inside, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-221_l22" HPOS="437" VPOS="1870" WIDTH="1776" HEIGHT="67" BASELINE="439 1913 2213 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1913 439 1926 547 1937 550 1937 944 1926 987 1937 989 1937 991 1937 1067 1924 1388 1924 1407 1935 1409 1935 1412 1935 1414 1935 1494 1924 1583 1935 1585 1935 1658 1922 1739 1933 1741 1933 1793 1922 1923 1933 1925 1933 1927 1933 1968 1922 2107 1933 2109 1933 2111 1933 2113 1933 2126 1922 2169 1933 2172 1933 2174 1933 2176 1933 2213 1920 2213 1907 2208 1879 1030 1870 1028 1870 955 1881 456 1872 454 1872 452 1872 450 1872 437 1879 439 1913"/>
                        </Shape>
                        <String CONTENT="temperature becomes quite unbearable. The guests strip to the waist, the"/>
                    </TextLine>

