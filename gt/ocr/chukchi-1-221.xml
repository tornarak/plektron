                    <TextLine ID="mz_1-221_l16" HPOS="437" VPOS="1509" WIDTH="1767" HEIGHT="64" BASELINE="439 1552 2204 1547" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="439 1552 439 1573 2202 1571 2204 1547 2200 1519 1342 1509 1340 1509 1338 1509 1316 1519 528 1511 526 1511 437 1521 439 1552"/>
                        </Shape>
                        <String CONTENT="postures while eating or conversing. When there are a number of guests,"/>
                    </TextLine>

