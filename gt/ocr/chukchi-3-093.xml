                        </Shape>
                        <String CONTENT="of the “idle wanderers” who have wives cannot keep them for a long time,"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l8" HPOS="442" VPOS="889" WIDTH="1771" HEIGHT="63" BASELINE="444 936 2213 928" TAGREFS="TYPE_5">
