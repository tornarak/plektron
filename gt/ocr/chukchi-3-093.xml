                        </Shape>
                        <String CONTENT="left him, a young boy, with a large herd of reindeer. Before he was grown"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l15" HPOS="442" VPOS="1306" WIDTH="1769" HEIGHT="65" BASELINE="444 1357 2211 1349" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 1357 444 1369 2208 1371 2211 1349 2208 1314 2046 1306 2044 1306 2042 1306 2040 1306 2024 1318 1896 1318 1872 1306 1870 1306 1868 1306 1810 1316 1781 1306 1779 1306 1777 1306 1775 1306 1773 1306 1757 1320 1596 1320 1578 1308 1576 1308 1574 1308 1457 1308 1455 1308 1453 1308 1434 1318 1358 1308 1356 1308 1354 1308 1323 1320 1206 1310 1204 1310 1202 1310 1200 1310 1184 1322 927 1322 890 1310 888 1310 886 1310 884 1310 861 1320 682 1312 680 1312 678 1312 652 1322 639 1312 637 1312 635 1312 543 1312 541 1312 442 1324 444 1357"/>
                        </Shape>
