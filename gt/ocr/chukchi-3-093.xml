                    </TextLine>

                    <TextLine ID="mz_3-093_l19" HPOS="442" VPOS="1550" WIDTH="1769" HEIGHT="57" BASELINE="444 1593 2211 1589" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 1593 444 1607 2210 1605 2211 1589 2208 1562 2102 1550 2100 1550 2098 1550 2059 1560 1699 1550 1697 1550 1695 1550 1674 1562 1481 1562 1371 1550 1370 1550 1309 1562 1260 1552 1258 1552 988 1562 972 1552 970 1552 968 1552 830 1552 828 1552 748 1562 658 1552 656 1552 442 1564 444 1593"/>
                        </Shape>
                        <String CONTENT="too, was lean and weak and good for nothing, as was plain at the first glance."/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l20" HPOS="446" VPOS="1618" WIDTH="1765" HEIGHT="55" BASELINE="446 1651 2211 1651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 1651 446 1663 2208 1673 2211 1651 2210 1620 446 1618 446 1651"/>
                        </Shape>
                        <String CONTENT="They even had no decent winter clothes, which is rarely the case even among"/>
                    </TextLine>

