                        </Shape>
                        <String CONTENT="and lost the greater part of it through card-playing. Then he became quite"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l17" HPOS="442" VPOS="1427" WIDTH="1771" HEIGHT="69" BASELINE="444 1476 2213 1468" TAGREFS="TYPE_5">
                        <Shape>
