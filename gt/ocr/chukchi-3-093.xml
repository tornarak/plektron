                        </Shape>
                        <String CONTENT="of a man who is of milder disposition and does not begrudge a morsel to a"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l12" HPOS="444" VPOS="1131" WIDTH="1767" HEIGHT="66" BASELINE="446 1176 2211 1170" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 1176 446 1188 779 1197 781 1197 845 1188 2210 1188 2211 1170 2210 1141 2192 1131 2190 1131 2188 1131 2186 1131 1993 1141 1808 1131 1806 1131 1753 1141 1691 1131 1689 1131 1564 1143 1085 1133 1083 1133 941 1145 919 1135 917 1135 915 1135 672 1145 656 1135 654 1135 652 1135 561 1135 559 1135 444 1147 446 1176"/>
                        </Shape>
                        <String CONTENT="wretched pauper. I remember one pair, — a man Ranaˊwkurg̣ɪn, and his"/>
                    </TextLine>

