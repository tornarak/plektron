                        </Shape>
                        <String CONTENT="poor. At the time when I saw them they both had only one reindeer and"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l18" HPOS="442" VPOS="1490" WIDTH="1769" HEIGHT="60" BASELINE="444 1534 2211 1531" TAGREFS="TYPE_5">
