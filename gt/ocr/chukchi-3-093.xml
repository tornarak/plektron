                        <Shape>
                            <Polygon POINTS="444 1813 444 1831 444 1844 2210 1850 2211 1831 2211 1801 448 1801 444 1813"/>
                        </Shape>
                        <String CONTENT="other. The woman tried once or twice to leave her husband for another man,"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l24" HPOS="442" VPOS="1848" WIDTH="1029" HEIGHT="59" BASELINE="444 1893 1471 1887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 1893 444 1907 1469 1901 1471 1887 1465 1858 1295 1858 1260 1848 1258 1848 1256 1848 1210 1858 1171 1848 1169 1848 1167 1848 1165 1848 1163 1848 1149 1858 1067 1850 1065 1850 1064 1850 1062 1850 1062 1852 1052 1860 865 1850 863 1850 724 1862 682 1852 680 1852 678 1852 676 1852 648 1862 615 1852 613 1852 611 1852 442 1860 444 1893"/>
                        </Shape>
                        <String CONTENT="but nobody wanted her in his sleeping-room."/>
                    </TextLine>
