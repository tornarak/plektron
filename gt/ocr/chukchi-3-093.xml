                        </Shape>
                        <String CONTENT="among the camps of his brothers; then he would move on and make visits"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l29" HPOS="440" VPOS="2144" WIDTH="1770" HEIGHT="65" BASELINE="442 2193 2210 2183" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="442 2193 442 2209 2208 2203 2210 2183 2206 2156 2083 2156 2061 2144 2059 2144 2057 2144 1978 2154 1948 2144 1946 2144 1944 2144 1898 2154 1865 2144 1863 2144 1861 2144 1859 2144 1857 2144 1843 2156 1820 2146 1818 2146 1816 2146 1586 2156 1529 2146 1527 2146 1525 2146 1498 2158 1467 2148 1465 2148 1463 2148 1334 2158 1218 2148 1216 2148 1214 2148 1212 2148 1194 2158 904 2150 902 2150 900 2150 873 2162 689 2162 633 2152 631 2152 629 2152 627 2152 611 2164 440 2164 442 2193"/>
                        </Shape>
                        <String CONTENT="among the camps of the whole neighborhood. Because of his brothers he was"/>
                    </TextLine>

