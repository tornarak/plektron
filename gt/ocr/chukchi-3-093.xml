                        </Shape>
                        <String CONTENT="wife Añqaˊñña. Both were quite young. Ranaˊwkurg̣ɪn’s father died, and"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l14" HPOS="440" VPOS="1248" WIDTH="1771" HEIGHT="60" BASELINE="442 1295 2211 1289" TAGREFS="TYPE_5">
                        <Shape>
