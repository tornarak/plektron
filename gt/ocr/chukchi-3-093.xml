                        </Shape>
                        <String CONTENT="younger brother with a stench!’ Then the old man and his wife went away. The whole time they"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l4" HPOS="446" VPOS="628" WIDTH="1765" HEIGHT="43" BASELINE="448 656 2211 659" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 656 446 667 2208 671 2211 659 2210 632 448 628 448 656"/>
                        </Shape>
                        <String CONTENT="were weeping. Such was Tatk-omruˊwg̣ê, the violent, the richest reindeer-breeder on the whole"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l5" HPOS="444" VPOS="671" WIDTH="1658" HEIGHT="51" BASELINE="446 704 2102 700" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 704 446 722 2100 718 2102 700 2096 671 444 677 446 704"/>
                        </Shape>
                        <String CONTENT="tundra. The Luck-giving Being (Kɪntaˊ-vaˊɪrg̣ɪn¹), in later time, however, made him poor.”²"/>
                    </TextLine>
<TextLine ID="mz_3-093_l6" HPOS="549" VPOS="769" WIDTH="1662" HEIGHT="58" BASELINE="551 815 2211 811" TAGREFS="TYPE_5">
                        <Shape>
