                        </Shape>
                        <String CONTENT="unless the woman is also good for nothing, and undesirable for any other"/>
                    </TextLine>

                    <TextLine ID="mz_3-093_l9" HPOS="442" VPOS="948" WIDTH="1769" HEIGHT="60" BASELINE="444 995 2211 987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 995 444 1008 2210 1006 2211 987 2210 962 2163 948 2161 948 2159 948 2157 948 2132 962 2034 962 2007 948 2005 948 2003 948 2001 948 1999 948 1981 962 1750 962 1724 950 1722 950 1720 950 1718 950 1670 962 1331 950 1329 950 1231 963 1188 952 1186 952 1184 952 1042 963 980 952 978 952 976 952 939 963 896 952 894 952 892 952 890 952 888 952 871 965 609 954 607 954 606 954 604 954 584 967 442 967 444 995"/>
                        </Shape>
                        <String CONTENT="man. Even then, in the middle of winter, the man takes care to leave the"/>
                    </TextLine>

