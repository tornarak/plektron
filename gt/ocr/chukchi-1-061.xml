                        <Shape>
                            <Polygon POINTS="467 2697 467 2712 2126 2714 2128 2697 2128 2667 467 2667 467 2697"/>
                        </Shape>
                        <String CONTENT="Other colors are not strictly defined, but are included among the preceding,"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l36" HPOS="361" VPOS="2712" WIDTH="1769" HEIGHT="65" BASELINE="363 2762 2130 2753" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2762 363 2777 2128 2769 2130 2753 2126 2723 1706 2712 1704 2712 1702 2712 1700 2712 1680 2723 452 2719 450 2719 361 2730 363 2762"/>
                        </Shape>
                        <String CONTENT="or described by comparison with various existing objects. Thus we have the"/>
