                        </Shape>
                        <String CONTENT="Regarding taste there are also some peculiar features. Thus the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l11" HPOS="359" VPOS="1214" WIDTH="1771" HEIGHT="67" BASELINE="361 1260 2130 1253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1260 361 1281 2128 1270 2130 1253 2126 1225 1539 1214 1537 1214 1535 1214 1533 1214 1533 1216 1522 1225 998 1216 996 1216 994 1216 946 1227 506 1218 504 1218 359 1229 361 1260"/>
                        </Shape>
                        <String CONTENT="generally do not care for salt; many of them have, in fact, a decided aversion"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l12" HPOS="359" VPOS="1277" WIDTH="1771" HEIGHT="56" BASELINE="361 1318 2130 1314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1318 361 1333 2128 1329 2130 1314 2126 1286 446 1277 443 1277 359 1288 361 1318"/>
                        </Shape>
                        <String CONTENT="to it, declaring that it is bitter and tastes of sea-water. The Lamut, on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l13" HPOS="359" VPOS="1333" WIDTH="1771" HEIGHT="61" BASELINE="361 1379 2130 1374" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1379 361 1394 2128 1389 2130 1374 2126 1344 1245 1333 1243 1333 1240 1333 1238 1333 1221 1344 621 1335 619 1335 359 1346 361 1379"/>
                        </Shape>
                        <String CONTENT="contrary, relish salt, and, when it is at hand, often use it with their tea. Some"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l14" HPOS="361" VPOS="1407" WIDTH="1769" HEIGHT="45" BASELINE="361 1437 2130 1437" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1437 361 1452 2130 1452 2130 1437 2130 1407 361 1407 361 1437"/>
                        </Shape>
                        <String CONTENT="of the Chukchee have also an aversion toward soft bread, which to them"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l15" HPOS="359" VPOS="1454" WIDTH="1771" HEIGHT="61" BASELINE="361 1500 2130 1493" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1500 361 1515 2128 1509 2130 1493 2126 1463 950 1454 948 1454 887 1465 519 1457 517 1457 359 1467 361 1500"/>
                        </Shape>
                        <String CONTENT="tastes too sour. They will consume only hard biscuit, especially unsalted hard-"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l16" HPOS="361" VPOS="1515" WIDTH="1769" HEIGHT="61" BASELINE="361 1558 2130 1558" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1558 361 1571 2128 1576 2130 1558 2130 1526 2105 1515 2102 1515 2100 1515 1227 1526 1173 1515 1171 1515 1169 1515 1167 1515 1149 1528 1050 1528 968 1515 965 1515 900 1526 870 1515 868 1515 866 1515 864 1515 833 1526 801 1515 799 1515 796 1515 794 1515 768 1526 740 1515 738 1515 736 1515 734 1515 731 1515 714 1526 634 1515 632 1515 630 1515 591 1526 528 1515 526 1515 463 1526 437 1515 435 1515 433 1515 361 1526 361 1558"/>
                        </Shape>
                        <String CONTENT="tack. The Russianized natives, on the contrary, who are used to baked bread,"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l17" HPOS="359" VPOS="1576" WIDTH="1771" HEIGHT="58" BASELINE="361 1619 2130 1612" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1619 361 1634 2128 1628 2130 1612 2126 1582 376 1576 374 1576 372 1576 370 1576 359 1582 361 1619"/>
                        </Shape>
                        <String CONTENT="find ship-biscuit tasteless. The desire for fat seems to be innate in the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l18" HPOS="357" VPOS="1643" WIDTH="1773" HEIGHT="56" BASELINE="359 1680 2130 1673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1680 359 1693 1537 1699 1539 1699 1628 1688 2128 1688 2130 1673 2124 1643 357 1647 359 1680"/>
                        </Shape>
                        <String CONTENT="chee. I saw an infant not a year old that cried every time an oil lamp was"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l19" HPOS="357" VPOS="1697" WIDTH="1773" HEIGHT="56" BASELINE="359 1738 2130 1734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1738 359 1753 2128 1749 2130 1734 2126 1701 450 1697 448 1697 357 1708 359 1738"/>
                        </Shape>
                        <String CONTENT="carried past his head. As the oil was very rancid, he evidently recognized"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l20" HPOS="359" VPOS="1753" WIDTH="1771" HEIGHT="63" BASELINE="361 1801 2130 1794" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1801 361 1816 2128 1809 2130 1794 2126 1764 1632 1753 1630 1753 1533 1766 359 1766 361 1801"/>
                        </Shape>
                        <String CONTENT="it by its odor, and wanted some of it. To grown people an admixture of fat"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l21" HPOS="361" VPOS="1812" WIDTH="1769" HEIGHT="62" BASELINE="363 1861 2130 1855" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 1861 363 1874 2128 1870 2130 1855 2128 1825 2100 1812 2098 1812 2096 1812 2009 1822 1511 1814 1509 1814 1507 1814 1505 1814 1487 1825 952 1814 950 1814 948 1814 916 1827 404 1816 402 1816 400 1816 361 1829 363 1861"/>
                        </Shape>
                        <String CONTENT="will improve the taste of all spoiled provisions: therefore putrid meat which"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l22" HPOS="361" VPOS="1885" WIDTH="1769" HEIGHT="48" BASELINE="363 1920 2130 1913" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 1920 363 1933 2128 1929 2130 1913 2126 1885 361 1885 363 1920"/>
                        </Shape>
                        <String CONTENT="has been stored in summer is usually consumed with oil or tallow. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l23" HPOS="361" VPOS="1933" WIDTH="1769" HEIGHT="63" BASELINE="363 1978 2130 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 1978 363 1996 2128 1989 2130 1972 2126 1944 1567 1933 1565 1933 1563 1933 1535 1944 1050 1935 1048 1935 361 1948 363 1978"/>
                        </Shape>
                        <String CONTENT="consumption of fat, however, has some limitations. Many persons, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l24" HPOS="361" VPOS="1996" WIDTH="1772" HEIGHT="62" BASELINE="363 2041 2133 2032" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2041 363 2058 2133 2048 2133 2032 2128 2002 822 1996 820 1996 818 1996 816 1996 799 2009 361 2009 363 2041"/>
                        </Shape>
                        <String CONTENT="women, cannot eat the blubber of the male rough-seal (Phoca hispida) because"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l25" HPOS="359" VPOS="2056" WIDTH="1771" HEIGHT="59" BASELINE="361 2097 2130 2091" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2097 361 2115 2128 2108 2130 2091 2126 2061 402 2056 400 2056 398 2056 359 2067 361 2097"/>
                        </Shape>
                        <String CONTENT="of its disgusting odor. Among the Reindeer people the marrow of the wild"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l26" HPOS="361" VPOS="2126" WIDTH="1767" HEIGHT="51" BASELINE="361 2158 2128 2158" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2158 361 2173 2124 2177 2128 2158 2126 2126 361 2126 361 2158"/>
                        </Shape>
                        <String CONTENT="reindeer-buck is considered the best food in the world. Notwithstanding this,"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l27" HPOS="359" VPOS="2173" WIDTH="1771" HEIGHT="63" BASELINE="361 2219 2130 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2219 361 2236 2128 2234 2130 2212 2126 2184 1539 2173 1537 2173 1414 2184 1022 2175 1020 2175 937 2186 526 2177 524 2177 359 2188 361 2219"/>
                        </Shape>
                        <String CONTENT="most of the people are not able “to break the joints” (i. e., to eat the marrow)"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l28" HPOS="359" VPOS="2238" WIDTH="1769" HEIGHT="56" BASELINE="361 2277 2128 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2277 361 2294 2126 2290 2128 2271 2124 2245 400 2238 398 2238 396 2238 359 2249 361 2277"/>
                        </Shape>
                        <String CONTENT="of a whole animal, and some are contented with a single leg. There is a"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l29" HPOS="359" VPOS="2294" WIDTH="1771" HEIGHT="63" BASELINE="361 2340 2130 2333" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2340 361 2357 2128 2351 2130 2333 2126 2303 963 2294 961 2294 959 2294 933 2305 459 2297 456 2297 359 2307 361 2340"/>
                        </Shape>
                        <String CONTENT="special term for the taste of food that is excessively fat and sweet, — nɪñɪˊrñuqin"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l30" HPOS="361" VPOS="2364" WIDTH="652" HEIGHT="60" BASELINE="363 2396 1013 2400" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2396 361 2418 363 2420 365 2420 365 2422 368 2422 370 2422 372 2424 469 2424 469 2422 472 2422 474 2422 487 2409 506 2422 508 2422 511 2422 513 2422 595 2409 729 2420 731 2420 809 2411 827 2422 829 2422 831 2422 833 2422 887 2413 926 2424 929 2424 931 2424 1011 2413 1013 2400 1011 2368 363 2364 363 2396"/>
                        </Shape>
                        <String CONTENT="(“too rich” or “too savory”)."/>
