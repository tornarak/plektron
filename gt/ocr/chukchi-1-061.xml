                    <TextLine ID="mz_1-061_l26" HPOS="340" VPOS="2111" WIDTH="1767" HEIGHT="51" BASELINE="340 2143 2107 2143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 2143 340 2158 2103 2162 2107 2143 2105 2111 340 2111 340 2143"/>
                        </Shape>
                        <String CONTENT="reindeer-buck is considered the best food in the world. Notwithstanding this,"/>
