                        </Shape>
                        <String CONTENT="generally do not care for salt; many of them have, in fact, a decided aversion"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l12" HPOS="338" VPOS="1262" WIDTH="1771" HEIGHT="56" BASELINE="340 1303 2109 1299" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1303 340 1318 2107 1314 2109 1299 2105 1271 425 1262 422 1262 338 1273 340 1303"/>
                        </Shape>
                        <String CONTENT="to it, declaring that it is bitter and tastes of sea-water. The Lamut, on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l13" HPOS="338" VPOS="1318" WIDTH="1771" HEIGHT="61" BASELINE="340 1364 2109 1359" TAGREFS="TYPE_4">
                        <Shape>
