                        </Shape>
                        <String CONTENT="Among reindeer-skins the color “yellowish” (ɪplɪˊlɪ) is also recognized. Occasion-"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l34" HPOS="338" VPOS="2583" WIDTH="1691" HEIGHT="67" BASELINE="340 2626 2029 2619" TAGREFS="TYPE_4">
                        <Shape>
