                        <Shape>
                            <Polygon POINTS="338 1723 338 1738 2107 1734 2109 1719 2105 1686 429 1682 427 1682 336 1693 338 1723"/>
                        </Shape>
                        <String CONTENT="carried past his head. As the oil was very rancid, he evidently recognized"/>
                    </TextLine>

