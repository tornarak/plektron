                        <Shape>
                            <Polygon POINTS="472 2459 472 2485 2128 2470 2130 2452 2126 2422 469 2422 472 2459"/>
                        </Shape>
                        <String CONTENT="The Chukchee scale of colors is also somewhat peculiar. The best-known"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l32" HPOS="359" VPOS="2472" WIDTH="1767" HEIGHT="63" BASELINE="361 2517 2126 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2517 361 2535 2124 2530 2126 2513 2124 2485 2096 2472 2094 2472 2092 2472 2089 2472 2068 2483 2050 2472 2048 2472 2046 2472 2044 2472 2042 2472 2009 2483 1972 2472 1970 2472 1968 2472 1765 2483 1702 2472 1700 2472 1637 2483 1624 2472 1622 2472 1619 2472 1509 2472 1507 2472 1505 2472 1502 2472 1487 2483 1463 2472 1461 2472 1459 2472 1375 2483 1314 2472 1312 2472 1310 2472 1286 2483 1253 2472 1251 2472 1249 2472 1247 2472 1221 2485 1199 2474 1197 2474 1195 2474 1193 2474 1167 2485 1139 2474 1136 2474 1134 2474 1132 2474 1108 2485 1084 2474 1082 2474 1080 2474 887 2485 788 2474 786 2474 783 2474 744 2485 664 2474 662 2474 459 2485 420 2474 417 2474 415 2474 413 2474 359 2487 361 2517"/>
                        </Shape>
                        <String CONTENT="colors are white (niˊlhᴀqin), black (nuˊuqin), red (nɪčêˊʟ̣oqên), gray (čêvaˊro)."/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l33" HPOS="361" VPOS="2533" WIDTH="1767" HEIGHT="62" BASELINE="363 2578 2128 2574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2578 363 2595 2126 2591 2128 2574 2124 2543 1245 2533 1243 2533 1240 2533 1214 2543 389 2535 387 2535 385 2535 361 2543 363 2578"/>
                        </Shape>
                        <String CONTENT="Among reindeer-skins the color “yellowish” (ɪplɪˊlɪ) is also recognized. Occasion-"/>
                    </TextLine>

                    <TextLine ID="mz_1-061_l34" HPOS="359" VPOS="2598" WIDTH="1691" HEIGHT="67" BASELINE="361 2641 2050 2634" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2641 361 2654 779 2665 781 2665 883 2654 918 2665 920 2665 922 2665 1054 2652 1396 2662 1399 2662 1502 2649 1773 2660 1775 2660 2048 2647 2050 2634 2046 2604 391 2598 389 2598 387 2598 359 2606 361 2641"/>
                        </Shape>
                        <String CONTENT="ally this term may be applied to other skins, but never to anything else."/>
