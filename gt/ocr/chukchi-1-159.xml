                        </Shape>
                        <String CONTENT="drift-ice is abundant, because all kinds of sea-animals go along with it, basking"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l39" HPOS="452" VPOS="2872" WIDTH="1772" HEIGHT="61" BASELINE="454 2918 2224 2914" TAGREFS="TYPE_5">
