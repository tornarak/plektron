                        </Shape>
                        <String CONTENT="all the while on its surface. Later on, when the ice has drifted away, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l40" HPOS="452" VPOS="2942" WIDTH="1772" HEIGHT="50" BASELINE="454 2974 2224 2979" TAGREFS="TYPE_5">
