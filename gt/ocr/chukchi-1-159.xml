                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-159_r3" HPOS="432" VPOS="887" WIDTH="1778" HEIGHT="1198" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="432 887 2210 887 2210 2085 432 2085"/>
                    </Shape>
                    <TextLine ID="mz_1-159_l6" HPOS="477" VPOS="889" WIDTH="1442" HEIGHT="48" BASELINE="477 922 1919 924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 922 477 937 1917 935 1919 924 1917 892 477 889 477 922"/>
                        </Shape>
                        <String CONTENT="In summer, seal-hunting is done chiefly with guns from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l7" HPOS="431" VPOS="937" WIDTH="1484" HEIGHT="63" BASELINE="433 978 1915 985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 978 431 991 1910 1000 1915 985 1915 954 1873 941 1871 941 1772 941 1769 941 1767 941 1765 941 1752 952 1700 941 1698 941 1696 941 1661 952 1572 941 1570 941 1369 950 1339 939 1336 939 1202 939 1200 939 1198 939 1196 939 1183 952 1050 952 1038 939 1035 939 1033 939 1031 939 1029 939 1005 950 975 939 973 939 970 939 817 948 801 937 799 937 797 937 795 937 793 937 762 948 676 937 674 937 672 937 648 950 492 950 479 937 477 937 474 937 472 937 470 937 433 946 433 978"/>
                        </Shape>
                        <String CONTENT="shore or from large skin boats. Kayaks are used on the Arctic,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l8" HPOS="435" VPOS="1000" WIDTH="1482" HEIGHT="67" BASELINE="435 1041 1917 1041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1041 435 1056 1087 1056 1148 1067 1150 1067 1152 1067 1191 1056 1297 1056 1315 1067 1317 1067 1319 1067 1321 1067 1516 1056 1564 1067 1566 1067 1568 1067 1633 1056 1655 1067 1657 1067 1659 1067 1661 1067 1702 1056 1865 1067 1867 1067 1869 1067 1917 1054 1917 1041 1917 1013 1761 1000 1759 1000 1689 1011 1657 1000 1655 1000 1653 1000 1650 1000 1627 1011 1590 1000 1588 1000 1585 1000 1523 1011 1499 1000 1497 1000 1494 1000 1432 1011 1397 1000 1395 1000 1393 1000 1391 1000 1367 1013 1185 1013 1107 1000 1105 1000 1001 1011 973 1000 970 1000 968 1000 966 1000 918 1011 860 1000 858 1000 856 1000 832 1011 780 1000 778 1000 723 1011 693 1000 691 1000 689 1000 687 1000 685 1000 669 1013 555 1013 477 1000 474 1000 472 1000 435 1011 435 1041"/>
                        </Shape>
                        <String CONTENT="while on the Pacific shore they are employed only in reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l9" HPOS="433" VPOS="1056" WIDTH="1482" HEIGHT="67" BASELINE="435 1099 1915 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1099 433 1117 438 1121 440 1121 440 1123 442 1123 444 1123 446 1123 1912 1115 1915 1104 1915 1071 1867 1058 1865 1058 1863 1058 1800 1069 1668 1058 1666 1058 1663 1058 1640 1069 1629 1058 1627 1058 1624 1058 1622 1058 1620 1058 1579 1069 1568 1058 1566 1058 1564 1058 1562 1058 1559 1058 1523 1069 1289 1058 1287 1058 1176 1069 1100 1056 1098 1056 1096 1056 1068 1067 1009 1056 1007 1056 1005 1056 979 1067 929 1056 927 1056 435 1063 435 1099"/>
                        </Shape>
                        <String CONTENT="hunting on the Middle Anadyr, as will be described later. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l10" HPOS="435" VPOS="1125" WIDTH="1480" HEIGHT="52" BASELINE="438 1162 1915 1158" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="438 1162 438 1177 1912 1173 1915 1158 1910 1138 1700 1138 1681 1125 1601 1138 1579 1125 1553 1138 1499 1125 1484 1138 1360 1138 1289 1125 1274 1138 1189 1138 1176 1125 1150 1141 1122 1128 1061 1141 1035 1128 990 1141 944 1128 910 1141 728 1128 435 1136 438 1162"/>
                        </Shape>
                        <String CONTENT="Maritime villages on the Pacific have but very few kayaks. I saw"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l11" HPOS="431" VPOS="1177" WIDTH="1486" HEIGHT="68" BASELINE="433 1219 1917 1223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1219 431 1232 453 1245 455 1245 457 1245 1915 1236 1917 1223 1915 1193 1707 1180 1705 1180 1644 1190 1620 1180 1618 1180 1616 1180 1614 1180 1611 1180 1598 1193 1473 1193 1393 1180 1391 1180 1319 1190 1295 1180 1293 1180 1291 1180 1289 1180 1252 1190 1135 1177 1133 1177 1059 1188 975 1177 973 1177 903 1188 821 1177 819 1177 433 1186 433 1219"/>
                        </Shape>
                        <String CONTENT="one in the Eskimo village Wuteˊen (see Fig. 47, c), which was"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l12" HPOS="433" VPOS="1251" WIDTH="1484" HEIGHT="48" BASELINE="433 1281 1917 1281" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1281 433 1299 1917 1299 1917 1281 1917 1251 433 1251 433 1281"/>
                        </Shape>
                        <String CONTENT="about fifteen feet long, and obtained a model of a kayak made at"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l13" HPOS="435" VPOS="1307" WIDTH="1477" HEIGHT="57" BASELINE="435 1344 1912 1344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1344 435 1357 1910 1364 1912 1344 1912 1312 435 1307 435 1344"/>
                        </Shape>
                        <String CONTENT="Indian Point. I had no opportunity of seeing the Arctic kayaks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l14" HPOS="433" VPOS="1366" WIDTH="1484" HEIGHT="52" BASELINE="435 1398 1917 1403" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1398 433 1413 1912 1418 1917 1403 1915 1372 435 1366 435 1398"/>
                        </Shape>
                        <String CONTENT="but, according to the natives, they are of various sizes, sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l15" HPOS="433" VPOS="1424" WIDTH="1484" HEIGHT="63" BASELINE="435 1459 1917 1463" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1459 433 1476 440 1483 442 1483 442 1485 444 1485 446 1485 448 1487 539 1487 539 1485 542 1485 544 1485 557 1474 587 1485 589 1485 591 1485 661 1474 700 1485 702 1485 704 1485 1174 1474 1215 1485 1217 1485 1219 1485 1685 1476 1828 1487 1830 1487 1832 1487 1834 1487 1834 1485 1845 1476 1915 1476 1917 1463 1915 1433 435 1424 435 1459"/>
                        </Shape>
                        <String CONTENT="have two seats, and are used for seal-hunting and travel, as"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l16" HPOS="433" VPOS="1487" WIDTH="1482" HEIGHT="56" BASELINE="435 1517 1915 1524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1517 433 1532 442 1541 442 1543 444 1543 446 1543 448 1543 1912 1537 1915 1524 1912 1494 435 1487 435 1517"/>
                        </Shape>
                        <String CONTENT="mentioned many times in Chukchee tales. These kayaks are so"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l17" HPOS="433" VPOS="1545" WIDTH="1482" HEIGHT="61" BASELINE="435 1578 1915 1582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1578 433 1591 492 1604 494 1604 1131 1595 1187 1606 1189 1606 1912 1595 1915 1582 1912 1552 435 1545 435 1578"/>
                        </Shape>
                        <String CONTENT="large, that sometimes a man creeps into one and lies down, to"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l18" HPOS="431" VPOS="1606" WIDTH="1486" HEIGHT="61" BASELINE="433 1636 1917 1643" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1636 431 1654 444 1662 446 1662 448 1662 451 1662 1397 1656 1423 1667 1425 1667 1427 1667 1915 1656 1917 1643 1915 1613 433 1606 433 1636"/>
                        </Shape>
                        <String CONTENT="be carried as a passive passenger. I was told of one case where"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l19" HPOS="433" VPOS="1673" WIDTH="1479" HEIGHT="44" BASELINE="433 1701 1912 1701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1701 433 1714 1908 1717 1912 1701 1910 1673 433 1673 433 1701"/>
                        </Shape>
                        <String CONTENT="three men set out in a kayak across Chaun Bay. Two of them"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l20" HPOS="431" VPOS="1725" WIDTH="1479" HEIGHT="52" BASELINE="433 1758 1910 1764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1758 431 1771 1906 1777 1910 1764 1908 1732 433 1725 433 1758"/>
                        </Shape>
                        <String CONTENT="fastened themselves in the manholes, and the third lay down in"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l21" HPOS="431" VPOS="1788" WIDTH="1479" HEIGHT="56" BASELINE="433 1820 1910 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1820 431 1833 446 1844 448 1844 451 1844 453 1844 1908 1840 1910 1825 1908 1792 433 1788 433 1820"/>
                        </Shape>
                        <String CONTENT="the hold. A tempest suddenly arose and capsized the kayak,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l22" HPOS="431" VPOS="1838" WIDTH="1481" HEIGHT="58" BASELINE="433 1879 1912 1883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1879 431 1892 1908 1896 1912 1883 1910 1851 1564 1840 1562 1840 1559 1840 1557 1840 1544 1853 1406 1853 1380 1840 1378 1840 1375 1840 1373 1840 1339 1851 1269 1840 1267 1840 1265 1840 1241 1851 1213 1840 1211 1840 1209 1840 1206 1840 1174 1851 1072 1838 1070 1838 1068 1838 1042 1849 843 1838 840 1838 773 1851 676 1851 663 1838 661 1838 659 1838 656 1838 654 1838 624 1849 546 1838 544 1838 433 1846 433 1879"/>
                        </Shape>
                        <String CONTENT="so that the paddlers were drowned; but the man inside remained"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l23" HPOS="433" VPOS="1901" WIDTH="1477" HEIGHT="56" BASELINE="435 1942 1910 1937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 1942 435 1957 1908 1952 1910 1937 1906 1909 490 1901 487 1901 433 1911 435 1942"/>
                        </Shape>
                        <String CONTENT="safe and sound, and on the second day drifted ashore in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l24" HPOS="431" VPOS="1968" WIDTH="1479" HEIGHT="49" BASELINE="433 1998 1910 2002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 1998 431 2013 1906 2017 1910 2002 1908 1972 433 1968 433 1998"/>
                        </Shape>
                        <String CONTENT="kayak, together with his dead companions, and was able to get out"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l25" HPOS="431" VPOS="2028" WIDTH="1447" HEIGHT="57" BASELINE="433 2061 1878 2065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2061 431 2076 444 2085 446 2085 448 2085 451 2085 1876 2076 1878 2065 1876 2033 433 2028 433 2061"/>
                        </Shape>
                        <String CONTENT="and go away. Perhaps this is only a fragment of some folk-tale."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-159_r4" HPOS="432" VPOS="2085" WIDTH="1778" HEIGHT="658" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="432 2085 2210 2085 2210 2743 432 2743"/>
                    </Shape>
                    <TextLine ID="mz_1-159_l26" HPOS="539" VPOS="2089" WIDTH="1365" HEIGHT="56" BASELINE="542 2121 1904 2126" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="542 2121 539 2132 747 2145 749 2145 1902 2143 1904 2126 1902 2093 542 2089 542 2121"/>
                        </Shape>
                        <String CONTENT="In hunting from boats, the harpoon is thrown at the animal,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l27" HPOS="433" VPOS="2147" WIDTH="1767" HEIGHT="50" BASELINE="435 2180 2200 2184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2180 433 2193 2196 2197 2200 2184 2198 2152 435 2147 435 2180"/>
                        </Shape>
                        <String CONTENT="and the shaft becomes detached from the point in the same way as described."/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l28" HPOS="440" VPOS="2199" WIDTH="1763" HEIGHT="67" BASELINE="440 2243 2203 2243" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="440 2243 440 2258 2200 2266 2203 2243 2203 2212 2008 2212 1975 2199 1973 2199 1971 2199 1969 2199 1945 2212 1813 2212 1798 2199 1795 2199 1793 2199 1791 2199 1789 2199 1787 2199 1769 2210 1733 2199 1731 2199 1728 2199 1663 2210 1629 2199 1627 2199 1624 2199 1622 2199 1585 2210 1568 2199 1566 2199 1564 2199 1562 2199 1559 2199 1536 2210 1453 2199 1451 2199 1449 2199 1421 2210 1375 2199 1373 2199 1371 2199 1369 2199 1336 2210 1282 2199 1280 2199 1278 2199 1250 2210 1228 2199 1226 2199 1224 2199 1172 2210 1083 2199 1081 2199 953 2210 921 2199 918 2199 916 2199 914 2199 886 2210 862 2199 860 2199 858 2199 780 2210 743 2199 741 2199 739 2199 736 2199 697 2210 440 2204 440 2243"/>
                        </Shape>
                        <String CONTENT="Then the animal is hauled in, and the floating shaft picked up. At present,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l29" HPOS="433" VPOS="2266" WIDTH="1774" HEIGHT="52" BASELINE="433 2303 2207 2303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2303 433 2318 2207 2318 2207 2303 2207 2273 433 2266 433 2303"/>
                        </Shape>
                        <String CONTENT="however, seals do not allow the boat to come near enough for the use of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l30" HPOS="433" VPOS="2321" WIDTH="1774" HEIGHT="69" BASELINE="433 2362 2207 2362" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2362 433 2375 505 2388 507 2388 639 2377 1050 2377 1115 2388 1118 2388 1120 2388 1159 2377 1559 2388 1562 2390 1670 2390 1670 2388 1672 2388 1674 2388 1689 2377 1718 2388 1720 2388 1722 2388 1813 2377 1834 2388 1837 2388 1839 2390 1934 2390 1934 2388 1936 2388 1938 2388 1954 2377 2027 2388 2029 2388 2032 2388 2053 2377 2090 2388 2092 2388 2094 2388 2097 2388 2118 2377 2185 2388 2187 2388 2190 2388 2192 2388 2207 2377 2207 2362 2207 2334 2153 2321 2151 2321 2148 2321 2122 2331 2109 2321 2107 2321 2105 2321 2103 2321 2101 2321 2062 2334 1759 2334 1744 2321 1741 2321 1739 2321 1737 2321 1735 2321 1707 2331 1536 2321 1533 2321 1481 2331 1319 2321 1317 2321 1315 2321 1284 2331 1092 2321 1089 2321 1087 2321 1050 2331 1005 2321 1003 2321 1001 2321 938 2331 873 2321 871 2321 869 2321 832 2331 795 2321 793 2321 791 2321 672 2331 433 2327 433 2362"/>
                        </Shape>
                        <String CONTENT="harpoon. With the rifle they are shot at wherever they come out of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l31" HPOS="433" VPOS="2388" WIDTH="1772" HEIGHT="58" BASELINE="435 2418 2205 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2418 433 2431 509 2444 511 2444 1289 2435 1352 2446 1354 2446 2203 2435 2205 2422 2203 2392 435 2388 435 2418"/>
                        </Shape>
                        <String CONTENT="water, no matter how far away they may be. The native hunters are pretty"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l32" HPOS="435" VPOS="2453" WIDTH="1772" HEIGHT="52" BASELINE="435 2483 2207 2483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 2483 435 2505 2207 2496 2207 2483 2207 2453 435 2453 435 2483"/>
                        </Shape>
                        <String CONTENT="good marksmen, but of course many shots go amiss. The animals that have"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l33" HPOS="431" VPOS="2507" WIDTH="1772" HEIGHT="50" BASELINE="433 2537 2203 2544" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2537 431 2550 2198 2557 2203 2544 2200 2513 433 2507 433 2537"/>
                        </Shape>
                        <String CONTENT="been killed sink so rapidly that they are often lost before the hunter can"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l34" HPOS="431" VPOS="2565" WIDTH="1772" HEIGHT="56" BASELINE="433 2595 2203 2604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2595 431 2613 442 2621 444 2621 446 2621 448 2621 2200 2617 2203 2604 2200 2574 433 2565 433 2595"/>
                        </Shape>
                        <String CONTENT="secure the body. Especially is this true in shooting from the shore, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l35" HPOS="431" VPOS="2626" WIDTH="1772" HEIGHT="58" BASELINE="433 2656 2203 2665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2656 431 2671 2198 2684 2203 2665 2200 2634 433 2626 433 2656"/>
                        </Shape>
                        <String CONTENT="the small boat stands ready to hand. Only fat seals, mostly the younger ones,"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l36" HPOS="431" VPOS="2676" WIDTH="563" HEIGHT="58" BASELINE="433 2717 994 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2717 431 2730 990 2734 994 2721 994 2691 964 2678 962 2678 960 2678 810 2689 765 2678 762 2678 760 2678 758 2678 715 2689 695 2676 693 2676 691 2676 689 2676 433 2684 433 2717"/>
                        </Shape>
