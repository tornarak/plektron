                    <TextLine ID="mz_1-159_l37" HPOS="560" VPOS="2762" WIDTH="1668" HEIGHT="52" BASELINE="560 2797 2228 2797" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="560 2797 560 2814 2226 2814 2228 2797 2226 2766 560 2762 560 2797"/>
                        </Shape>
                        <String CONTENT="Hunting on open water is more successful early in the season, when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l38" HPOS="452" VPOS="2820" WIDTH="1772" HEIGHT="57" BASELINE="454 2853 2224 2859" TAGREFS="TYPE_5">
                        <Shape>
