                    </TextLine>

                    <TextLine ID="mz_1-159_l5" HPOS="435" VPOS="829" WIDTH="691" HEIGHT="50" BASELINE="435 861 1126 861" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="435 861 435 879 1126 879 1126 861 1126 831 435 829 435 861"/>
                        </Shape>
