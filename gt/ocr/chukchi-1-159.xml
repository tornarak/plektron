                        </Shape>
                        <String CONTENT="sail off with fair wind, and go so far that the highest mountain-tops near the"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l43" HPOS="452" VPOS="3119" WIDTH="1769" HEIGHT="61" BASELINE="454 3150 2221 3158" TAGREFS="TYPE_5">
