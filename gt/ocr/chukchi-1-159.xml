                        </Shape>
                        <String CONTENT="animals become more scarce and the hunt difficult. Then the seal-hunters go"/>
                    </TextLine>

                    <TextLine ID="mz_1-159_l41" HPOS="452" VPOS="3002" WIDTH="1774" HEIGHT="57" BASELINE="454 3033 2226 3037" TAGREFS="TYPE_5">
