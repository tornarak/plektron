<TextLine ID="mz_1-038_l3" HPOS="524" VPOS="736" WIDTH="1772" HEIGHT="63" BASELINE="526 783 2296 779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2257 744 2235 744 2213 742 2192 742 2177 742 2157 747 2146 740 2127 740 2112 740 2086 747 2075 738 2062 738 2055 738 2042 749 1936 749 1902 736 1899 736 1897 736 1806 747 1700 736 1698 736 1696 736 1672 747 1629 736 1627 736 1624 736 1464 747 1427 736 1425 736 1423 736 1356 749 1280 738 1278 738 1276 738 1232 749 1141 738 1139 738 1072 749 1044 738 1042 738 1040 738 986 749 955 738 953 738 951 738 949 738 927 749 799 738 797 738 795 738 769 751 602 751 550 738 548 738 546 738 544 738 524 747 526 783 526 799 2294 794 2296 779 2291 747 2274 744 2257 744"/>
                        </Shape>
                        <String CONTENT="the name of Kopai, who claimed to belong to the Shelag tribe, and who had"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l4" HPOS="526" VPOS="807" WIDTH="1772" HEIGHT="52" BASELINE="529 842 2298 838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="529 842 529 859 2296 855 2298 838 2294 807 526 807 529 842"/>
                        </Shape>
                        <String CONTENT="his place on the seashore at a distance of two hundred versts (about a hundred"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l5" HPOS="524" VPOS="857" WIDTH="1774" HEIGHT="69" BASELINE="526 898 2298 902" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 898 524 918 537 926 539 926 542 926 544 926 2296 918 2298 902 2298 872 2252 859 2250 859 2248 859 2246 859 2211 870 2179 859 2177 859 2174 859 2122 870 1837 859 1834 859 1739 870 1601 859 1598 859 1596 859 1549 870 1471 859 1468 859 1416 870 1401 857 1399 857 1397 857 1395 857 1339 870 1230 870 1215 857 1213 857 1211 857 1209 857 1206 857 1176 868 1081 857 1079 857 1076 857 1048 868 1027 857 1025 857 1022 857 1020 857 999 868 977 857 975 857 973 857 970 857 934 870 843 870 827 857 825 857 823 857 821 857 819 857 793 870 628 870 613 857 611 857 609 857 607 857 526 866 526 898"/>
                        </Shape>
                        <String CONTENT="and twenty-five miles) from the mouth of the Kolyma. Maydell regards the"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l6" HPOS="526" VPOS="928" WIDTH="808" HEIGHT="50" BASELINE="529 959 1334 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="529 959 526 974 1330 978 1334 963 1332 933 529 928 529 959"/>
                        </Shape>
                        <String CONTENT="whole story as a misunderstanding."/>
                    </TextLine>
<TextLine ID="mz_1-038_l7" HPOS="633" VPOS="987" WIDTH="1665" HEIGHT="52" BASELINE="635 1024 2298 1019" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 1024 635 1039 2296 1035 2298 1019 2294 989 633 987 635 1024"/>
                        </Shape>
                        <String CONTENT="I was told by the natives, however, that on the seashore, westward from"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l8" HPOS="522" VPOS="1041" WIDTH="1774" HEIGHT="63" BASELINE="524 1084 2296 1080" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 1084 524 1099 2291 1104 2296 1080 2291 1050 544 1041 542 1041 539 1041 537 1041 522 1048 524 1084"/>
                        </Shape>
                        <String CONTENT="the island of Ayo, some ruins similar to those on the Bear Islands still exist,"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l9" HPOS="524" VPOS="1097" WIDTH="957" HEIGHT="72" BASELINE="526 1143 1481 1138" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1143 526 1158 966 1169 968 1169 1042 1156 1202 1167 1204 1167 1479 1154 1481 1138 1479 1110 1438 1097 1436 1097 1434 1097 1306 1108 1289 1097 1287 1097 1284 1097 1133 1097 1131 1097 1128 1097 1126 1097 1126 1099 1115 1110 810 1110 771 1099 769 1099 767 1099 715 1110 654 1099 652 1099 650 1099 626 1110 600 1099 598 1099 596 1099 524 1112 526 1143"/>
                        </Shape>
                        <String CONTENT="and this gives support to Viligin’s words."/>
                    </TextLine>
<TextLine ID="mz_1-038_l10" HPOS="637" VPOS="1160" WIDTH="1661" HEIGHT="56" BASELINE="637 1201 2298 1201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 1201 637 1216 2298 1216 2298 1201 2298 1173 2051 1173 2027 1160 2025 1160 2023 1160 1969 1171 1904 1160 1902 1160 1899 1160 1873 1171 1860 1160 1858 1160 1856 1160 1854 1160 1791 1171 1605 1160 1603 1160 1601 1160 1568 1171 1551 1160 1549 1160 1546 1160 1544 1160 1494 1171 1481 1160 1479 1160 1477 1160 1297 1160 1295 1160 1293 1160 1291 1160 1278 1171 1228 1160 1226 1160 1224 1160 1198 1171 1159 1160 1157 1160 1154 1160 1152 1160 1120 1171 1057 1160 927 1160 925 1160 923 1160 921 1160 905 1171 637 1164 637 1201"/>
                        </Shape>
                        <String CONTENT="The name Čaˊačên, in its Russianized form, would be Chavantzy or"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l11" HPOS="524" VPOS="1216" WIDTH="1772" HEIGHT="65" BASELINE="526 1264 2296 1260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1264 526 1279 2291 1281 2296 1260 2291 1229 2229 1216 2226 1216 2224 1216 2194 1227 1928 1216 1925 1216 1923 1216 1921 1216 1904 1229 1761 1229 1598 1216 1596 1216 1505 1227 1477 1216 1475 1216 1473 1216 1471 1216 1440 1227 1412 1216 1410 1216 1408 1216 1349 1229 1323 1219 1321 1219 1319 1219 1317 1219 1284 1229 1267 1219 1265 1219 1263 1219 1261 1219 1258 1219 1228 1229 1007 1219 1005 1219 1003 1219 957 1229 923 1219 921 1219 918 1219 916 1219 914 1219 899 1229 810 1219 808 1219 739 1229 544 1219 542 1219 539 1219 537 1219 524 1227 526 1264"/>
                        </Shape>
                        <String CONTENT="Chauntzy, which is almost identical with that of Chuvantzy. This latter tribe,"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l12" HPOS="524" VPOS="1290" WIDTH="1772" HEIGHT="50" BASELINE="526 1325 2296 1320" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1325 526 1340 2294 1335 2296 1320 2289 1290 524 1292 526 1325"/>
                        </Shape>
                        <String CONTENT="almost extinct at present, in former times lived somewhere in the country"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l13" HPOS="526" VPOS="1344" WIDTH="1768" HEIGHT="54" BASELINE="526 1383 2294 1383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1383 526 1396 2289 1398 2294 1383 2289 1344 526 1344 526 1383"/>
                        </Shape>
                        <String CONTENT="between the Yukaghir and the Chukchee regions. It bred reindeer, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l14" HPOS="524" VPOS="1400" WIDTH="1774" HEIGHT="68" BASELINE="526 1446 2298 1439" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1446 526 1468 2296 1455 2298 1439 2294 1400 1115 1400 1113 1400 1111 1400 1063 1411 598 1403 596 1403 524 1413 526 1446"/>
                        </Shape>
                        <String CONTENT="probably was an intermediate tribe between those two. The last remnants of"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l15" HPOS="522" VPOS="1457" WIDTH="1772" HEIGHT="62" BASELINE="524 1498 2294 1502" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 1498 522 1513 2289 1519 2294 1502 2294 1472 2259 1459 2257 1459 2107 1459 2105 1459 2103 1459 2101 1459 2088 1470 2053 1459 2051 1459 2049 1459 2047 1459 2012 1470 1984 1459 1982 1459 1980 1459 1839 1470 1718 1459 1715 1459 1594 1470 1540 1459 1538 1459 1536 1459 1533 1459 1516 1472 1416 1472 1291 1457 1289 1457 1287 1457 1256 1470 908 1470 892 1457 890 1457 888 1457 886 1457 884 1457 836 1468 749 1457 747 1457 745 1457 723 1468 695 1457 693 1457 691 1457 689 1457 687 1457 672 1468 656 1457 654 1457 652 1457 650 1457 524 1465 524 1498"/>
                        </Shape>
                        <String CONTENT="the Reindeer Chuvantzy are, at the present time, assimilated with the Koryak,"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l16" HPOS="524" VPOS="1517" WIDTH="1772" HEIGHT="61" BASELINE="526 1563 2296 1558" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1563 526 1578 2294 1574 2296 1558 2291 1530 2133 1517 2131 1517 2019 1528 1997 1517 1995 1517 1993 1517 1990 1517 1964 1528 1938 1517 1936 1517 1934 1517 1865 1528 1832 1517 1830 1517 1828 1517 1696 1528 1609 1517 1607 1517 1605 1517 1566 1528 1514 1517 1512 1517 1510 1517 1464 1528 1416 1517 1414 1517 1412 1517 1349 1532 1139 1532 1107 1519 1105 1519 1102 1519 1100 1519 1072 1530 1044 1519 1042 1519 1040 1519 973 1530 905 1519 903 1519 901 1519 873 1530 814 1519 812 1519 810 1519 773 1530 743 1519 741 1519 739 1519 633 1530 596 1519 594 1519 591 1519 524 1532 526 1563"/>
                        </Shape>
                        <String CONTENT="and speak the Koryak language; while the fisher-people of that tribe are"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l17" HPOS="524" VPOS="1589" WIDTH="1772" HEIGHT="50" BASELINE="526 1621 2296 1617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1621 526 1639 2294 1634 2296 1617 2291 1589 524 1589 526 1621"/>
                        </Shape>
                        <String CONTENT="Russianized. The few words of the Chuvantzy language given in the curious"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l18" HPOS="524" VPOS="1636" WIDTH="1770" HEIGHT="65" BASELINE="526 1680 2294 1684" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1680 524 1693 2289 1701 2294 1684 2291 1652 2177 1639 2042 1639 2040 1639 2038 1639 2014 1649 1912 1639 1910 1639 1843 1649 1776 1639 1774 1639 1683 1649 1473 1639 1471 1639 1468 1639 1427 1649 1412 1636 1410 1636 1408 1636 1406 1636 1403 1636 1378 1647 1276 1636 1274 1636 1271 1636 1241 1649 1152 1649 1137 1636 1135 1636 1133 1636 1131 1636 1128 1636 1100 1647 1083 1636 1081 1636 1079 1636 1076 1636 994 1647 977 1636 975 1636 973 1636 970 1636 918 1647 851 1636 849 1636 847 1636 810 1647 778 1636 775 1636 773 1636 771 1636 734 1647 676 1636 674 1636 672 1636 650 1647 624 1636 622 1636 620 1636 617 1636 594 1647 526 1643 526 1680"/>
                        </Shape>
                        <String CONTENT="book by G. Dyachkoff,¹ the native school-teacher of the village of Markova,"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l19" HPOS="524" VPOS="1699" WIDTH="1770" HEIGHT="61" BASELINE="524 1742 2294 1742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 1742 524 1760 2294 1760 2294 1742 2294 1710 2252 1699 2250 1699 2248 1699 2185 1710 2146 1699 2144 1699 2142 1699 1564 1710 1440 1699 1438 1699 1369 1710 1321 1699 1319 1699 1317 1699 1315 1699 1313 1699 1297 1712 1122 1712 1094 1699 1092 1699 1089 1699 1027 1710 968 1699 966 1699 964 1699 925 1710 882 1699 879 1699 877 1699 875 1699 843 1710 825 1699 823 1699 821 1699 700 1699 697 1699 695 1699 652 1710 626 1699 624 1699 622 1699 524 1710 524 1742"/>
                        </Shape>
                        <String CONTENT="on the Middle Anadyr, who comes from Chuvantzy stock, are mainly Yukaghir."/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l20" HPOS="524" VPOS="1758" WIDTH="1774" HEIGHT="60" BASELINE="526 1803 2298 1799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 1803 526 1818 2296 1814 2298 1799 2294 1771 2209 1758 2207 1758 2205 1758 2181 1771 2090 1771 2075 1758 2073 1758 2071 1758 2068 1758 2066 1758 2038 1768 1754 1758 1752 1758 1650 1768 1609 1758 1607 1758 1605 1758 1388 1771 1326 1760 1323 1760 1321 1760 1291 1771 1161 1760 1159 1760 1061 1771 1001 1760 999 1760 996 1760 964 1771 871 1760 869 1760 791 1771 524 1768 526 1803"/>
                        </Shape>
                        <String CONTENT="There are still on the tundra to the west of the Kolyma two or three clans"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l21" HPOS="520" VPOS="1827" WIDTH="1778" HEIGHT="61" BASELINE="522 1864 2298 1859" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 1864 522 1877 754 1888 756 1888 2296 1875 2298 1859 2291 1827 520 1829 522 1864"/>
                        </Shape>
                        <String CONTENT="of Yukaghir who to some extent breed reindeer, and are intermingled with"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l22" HPOS="520" VPOS="1875" WIDTH="1776" HEIGHT="67" BASELINE="522 1924 2296 1916" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 1924 522 1942 2294 1935 2296 1916 2291 1885 1941 1875 1938 1875 1873 1885 1856 1875 1854 1875 1852 1875 1850 1875 1494 1888 1447 1877 1445 1877 1442 1877 1440 1877 1406 1890 1378 1879 1375 1879 1373 1879 1371 1879 1347 1892 1170 1892 1133 1879 1131 1879 1128 1879 1126 1879 1094 1890 988 1879 986 1879 983 1879 981 1879 957 1892 622 1881 620 1881 617 1881 615 1881 602 1892 542 1881 539 1881 537 1881 535 1881 520 1890 522 1924"/>
                        </Shape>
                        <String CONTENT="the Tungus. The oldest documents in the archives of Nishne-Kolymsk, dated"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l23" HPOS="522" VPOS="1935" WIDTH="1767" HEIGHT="74" BASELINE="524 1985 2289 1978" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 1985 524 1998 806 2009 808 2009 810 2009 812 2009 827 1996 1267 1996 1373 2007 1375 2007 1468 1996 1510 2007 1512 2007 1514 2007 1516 2007 1518 2007 1533 1996 1863 2004 1865 2004 1867 2004 1899 1994 2125 2004 2127 2004 2129 2004 2131 2004 2146 1994 2181 2004 2183 2004 2185 2004 2287 1991 2289 1978 2283 1937 1980 1946 1921 1935 1919 1935 1865 1946 1839 1935 1837 1935 1834 1935 1780 1946 1756 1935 1754 1935 1752 1935 1750 1935 1748 1935 1731 1946 1702 1935 1700 1935 1698 1935 1616 1948 1520 1937 1518 1937 1451 1948 1386 1937 1384 1937 1382 1937 1358 1948 1245 1937 1243 1937 1241 1937 1215 1948 1185 1937 1183 1937 1180 1937 1068 1950 552 1939 550 1939 548 1939 522 1950 524 1985"/>
                        </Shape>
                        <String CONTENT="about 1770, mention several Yukaghir of the Khodynsky Chuvansky clan.²"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l24" HPOS="526" VPOS="2000" WIDTH="1768" HEIGHT="61" BASELINE="526 2043 2294 2043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 2043 526 2059 2289 2061 2294 2043 2291 2013 2010 2013 1993 2000 1990 2000 1988 2000 1986 2000 1928 2011 1871 2000 1869 2000 1715 2011 1674 2000 1672 2000 1670 2000 1668 2000 1627 2011 1590 2000 1588 2000 1585 2000 1583 2000 1553 2011 1429 2000 1427 2000 1347 2013 1157 2013 1122 2000 1120 2000 1118 2000 1014 2011 940 2000 938 2000 936 2000 903 2011 860 2000 858 2000 856 2000 853 2000 821 2011 793 2000 791 2000 788 2000 786 2000 756 2011 700 2000 697 2000 695 2000 661 2011 526 2007 526 2043"/>
                        </Shape>
                        <String CONTENT="Now, the single clan of Chuvantzy existing to-day is called by this same name,"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l25" HPOS="524" VPOS="2056" WIDTH="288" HEIGHT="63" BASELINE="526 2102 812 2100" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="526 2102 526 2119 810 2117 812 2100 801 2056 784 2067 641 2056 639 2056 637 2056 598 2067 535 2056 533 2056 531 2056 529 2056 529 2059 526 2059 524 2059 526 2102"/>
                        </Shape>
                        <String CONTENT="Khodynsky.³"/>
                    </TextLine>
<TextLine ID="mz_1-038_l26" HPOS="630" VPOS="2115" WIDTH="1666" HEIGHT="65" BASELINE="633 2165 2296 2156" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 2165 633 2180 2294 2171 2296 2156 2291 2126 1893 2115 1891 2115 1889 2115 1886 2115 1871 2128 630 2128 633 2165"/>
                        </Shape>
                        <String CONTENT="In later times the Chuvantzy were always allied with the Cossacks, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l27" HPOS="524" VPOS="2180" WIDTH="1772" HEIGHT="56" BASELINE="524 2221 2296 2221" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 2221 524 2236 2296 2236 2296 2221 2296 2193 2224 2180 2222 2180 2151 2191 2088 2180 2086 2180 2084 2180 2053 2191 1666 2180 1663 2180 1575 2191 1397 2180 1395 2180 1393 2180 1356 2191 1302 2180 1300 2180 1224 2191 1187 2180 1185 2180 1183 2180 1072 2191 999 2180 996 2180 685 2191 659 2180 656 2180 654 2180 524 2191 524 2221"/>
                        </Shape>
                        <String CONTENT="waged common warfare against the Chukchee. The latter, after the defeat"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l28" HPOS="520" VPOS="2236" WIDTH="1774" HEIGHT="69" BASELINE="522 2277 2294 2282" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 2277 520 2295 535 2305 537 2305 539 2305 542 2305 2291 2297 2294 2282 2294 2251 2248 2238 2246 2238 2244 2238 2127 2249 1858 2238 1856 2238 1782 2249 1756 2238 1754 2238 1752 2238 1750 2238 1748 2238 1731 2251 1601 2251 1575 2238 1572 2238 1570 2238 1434 2249 1408 2236 1406 2236 1403 2236 1401 2236 1378 2249 1291 2249 1276 2236 1274 2236 1271 2236 1269 2236 1267 2236 1241 2247 1170 2236 1167 2236 1109 2249 936 2249 921 2236 918 2236 916 2236 914 2236 912 2236 910 2236 895 2247 845 2236 843 2236 840 2236 838 2236 821 2247 780 2236 778 2236 775 2236 773 2236 741 2247 678 2236 676 2236 674 2236 672 2236 659 2247 646 2236 643 2236 641 2236 639 2236 522 2245 522 2277"/>
                        </Shape>
                        <String CONTENT="of Major Pavlutsky, are said to have destroyed more than half of them. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l29" HPOS="520" VPOS="2301" WIDTH="1776" HEIGHT="56" BASELINE="522 2342 2296 2338" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 2342 522 2357 2294 2353 2296 2338 2291 2310 548 2301 546 2301 544 2301 520 2310 522 2342"/>
                        </Shape>
                        <String CONTENT="situation in former times may have been different, since even the Yukaghir"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l30" HPOS="522" VPOS="2360" WIDTH="1774" HEIGHT="58" BASELINE="522 2401 2296 2401" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 2401 522 2418 2296 2418 2296 2401 2296 2372 1956 2360 1954 2360 1951 2360 1917 2370 1867 2360 1865 2360 1863 2360 1826 2370 1750 2360 1748 2360 1746 2360 1711 2370 1603 2360 1601 2360 1505 2370 1419 2360 1416 2360 1356 2372 1027 2372 882 2360 879 2360 778 2370 710 2360 708 2360 654 2370 624 2360 622 2360 620 2360 617 2360 596 2370 568 2360 565 2360 563 2360 561 2360 522 2370 522 2401"/>
                        </Shape>
                        <String CONTENT="of the Upper Kolyma preserve a curious tradition that the Chukchee were"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l31" HPOS="520" VPOS="2418" WIDTH="1776" HEIGHT="58" BASELINE="522 2461 2296 2457" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 2461 522 2476 2294 2472 2296 2457 2291 2429 1440 2418 1438 2418 1362 2429 672 2420 669 2420 520 2431 522 2461"/>
                        </Shape>
                        <String CONTENT="once their brothers, and that they had a defensive and offensive alliance"/>
                    </TextLine>

                    <TextLine ID="mz_1-038_l32" HPOS="522" VPOS="2476" WIDTH="258" HEIGHT="68" BASELINE="524 2522 780 2518" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 2522 524 2535 767 2544 769 2544 771 2544 773 2544 773 2541 775 2541 780 2535 780 2518 775 2489 665 2476 663 2476 661 2476 659 2476 641 2489 563 2479 561 2479 559 2479 522 2492 524 2522"/>
                        </Shape>
                        <String CONTENT="with them."/>
