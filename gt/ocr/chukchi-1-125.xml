                    <TextLine ID="mz_1-125_l1" HPOS="955" VPOS="632" WIDTH="615" HEIGHT="54" BASELINE="955 666 1570 662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1559 632 1537 632 1515 632 1494 632 1472 632 1450 632 1429 632 1407 632 1386 632 1364 632 1342 632 1321 632 1299 632 1277 632 1256 632 1234 632 1212 632 1191 632 1169 632 1147 632 1126 632 1104 632 1082 632 1061 632 1039 632 1017 632 996 632 974 632 955 647 955 666 955 686 1567 681 1570 662 1567 658 1559 632"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l2" HPOS="2076" VPOS="638" WIDTH="59" HEIGHT="56" BASELINE="2079 677 2135 681" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2124 649 2107 640 2079 638 2079 677 2076 690 2130 694 2135 681 2135 655 2124 649"/>
                        </Shape>
                        <String CONTENT="95"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-125_r2" HPOS="374" VPOS="738" WIDTH="1778" HEIGHT="419" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="374 738 2152 738 2152 1157 374 1157"/>
                    </Shape>
                    <TextLine ID="mz_1-125_l3" HPOS="376" VPOS="744" WIDTH="1776" HEIGHT="50" BASELINE="376 775 2152 775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 775 376 794 2152 794 2152 775 2152 744 376 744 376 775"/>
                        </Shape>
                        <String CONTENT="Sometimes a medium-sized log, or a clumsy wooden implement similar in shape"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l4" HPOS="374" VPOS="792" WIDTH="1776" HEIGHT="61" BASELINE="376 837 2150 831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 837 376 853 2148 848 2150 831 2146 801 985 792 983 792 981 792 978 792 959 803 396 794 394 794 391 794 389 794 374 801 376 837"/>
                        </Shape>
                        <String CONTENT="to a thick two-pronged fork, is tied to the animal’s neck, though it hinders it"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l5" HPOS="374" VPOS="855" WIDTH="1776" HEIGHT="58" BASELINE="376 898 2150 894" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 898 376 913 2148 909 2150 894 2146 863 387 855 385 855 383 855 381 855 381 857 374 861 376 898"/>
                        </Shape>
                        <String CONTENT="from grazing properly. The reindeer, secured by the end of the lasso, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l6" HPOS="376" VPOS="920" WIDTH="1772" HEIGHT="56" BASELINE="378 950 2148 954" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 950 376 967 387 976 389 976 391 976 394 976 2146 967 2148 954 2146 924 378 920 378 950"/>
                        </Shape>
                        <String CONTENT="usually turned out to pasture for a short time daily; but at night the man"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l7" HPOS="376" VPOS="974" WIDTH="1776" HEIGHT="67" BASELINE="378 1015 2152 1008" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1015 378 1030 738 1041 740 1041 2150 1026 2152 1008 2148 974 413 974 411 974 409 974 376 985 378 1015"/>
                        </Shape>
                        <String CONTENT="who wants to pasture his animals well will sit up himself, holding the end of"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l8" HPOS="374" VPOS="1032" WIDTH="1776" HEIGHT="56" BASELINE="376 1073 2150 1069" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1073 376 1088 2150 1084 2150 1069 2146 1041 396 1032 394 1032 391 1032 389 1032 374 1039 376 1073"/>
                        </Shape>
                        <String CONTENT="the rope in his hand, and now and then, while dozing, take a look at his"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l9" HPOS="374" VPOS="1093" WIDTH="1772" HEIGHT="58" BASELINE="376 1134 2146 1130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1134 376 1151 2143 1147 2146 1130 2141 1101 424 1093 422 1093 420 1093 374 1104 376 1134"/>
                        </Shape>
                        <String CONTENT="reindeer; otherwise they would become entangled, and could not graze at all."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-125_r3" HPOS="374" VPOS="1157" WIDTH="1778" HEIGHT="838" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="374 1157 2152 1157 2152 1995 374 1995"/>
                    </Shape>
                    <TextLine ID="mz_1-125_l10" HPOS="480" VPOS="1149" WIDTH="1668" HEIGHT="63" BASELINE="482 1195 2148 1188" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="482 1195 482 1212 2146 1205 2148 1188 2143 1160 1695 1149 1693 1149 1576 1160 1243 1151 1240 1151 480 1162 482 1195"/>
                        </Shape>
                        <String CONTENT="If well pastured and not overworked, reindeer are swift; and in two days"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l11" HPOS="374" VPOS="1212" WIDTH="1774" HEIGHT="58" BASELINE="376 1255 2148 1251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1255 376 1270 2146 1266 2148 1251 2143 1218 452 1212 450 1212 374 1223 376 1255"/>
                        </Shape>
                        <String CONTENT="a single driver often makes two hundred miles, provided the snow is thin and"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l12" HPOS="374" VPOS="1277" WIDTH="1772" HEIGHT="58" BASELINE="376 1316 2146 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1316 376 1331 2141 1335 2146 1309 2141 1290 1747 1290 1717 1277 1695 1290 1520 1292 1405 1279 1323 1292 1282 1279 1214 1292 1126 1279 1007 1292 965 1279 933 1294 825 1281 374 1288 376 1316"/>
                        </Shape>
                        <String CONTENT="hard, as it usually is on the tundra. The lightest camp makes, on an average,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l13" HPOS="374" VPOS="1329" WIDTH="1774" HEIGHT="63" BASELINE="376 1376 2148 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1376 376 1392 2146 1387 2148 1370 2146 1342 2120 1329 2118 1329 2115 1329 2113 1329 2089 1340 1702 1329 1700 1329 1697 1329 1695 1329 1680 1342 1533 1342 1013 1331 1011 1331 950 1344 396 1333 394 1333 391 1333 389 1333 374 1342 376 1376"/>
                        </Shape>
                        <String CONTENT="twenty-five miles a day; and the large camp, from ten to fifteen miles, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l14" HPOS="376" VPOS="1389" WIDTH="1767" HEIGHT="61" BASELINE="378 1435 2143 1428" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1435 378 1450 2141 1448 2143 1428 2139 1400 1587 1389 1585 1389 1583 1389 1550 1400 413 1394 411 1394 409 1394 376 1405 378 1435"/>
                        </Shape>
                        <String CONTENT="often, especially early in the fall, not more than from three to five miles."/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l15" HPOS="381" VPOS="1448" WIDTH="1767" HEIGHT="61" BASELINE="383 1491 2148 1487" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1491 383 1509 2146 1504 2148 1487 2143 1461 2059 1448 2057 1448 2055 1448 2022 1459 1951 1448 1949 1448 1946 1448 1944 1448 1925 1461 1732 1461 1713 1448 1710 1448 1708 1448 1706 1448 1600 1459 1509 1448 1507 1448 1327 1459 1279 1448 1277 1448 1275 1448 1273 1448 1271 1448 1251 1461 1199 1450 1197 1450 1115 1463 933 1463 909 1450 907 1450 905 1450 903 1450 877 1461 855 1450 853 1450 851 1450 794 1461 729 1450 727 1450 725 1450 693 1461 651 1450 649 1450 647 1450 381 1454 383 1491"/>
                        </Shape>
                        <String CONTENT="When tired, the reindeer, especially the Chukchee reindeer, must be given"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l16" HPOS="376" VPOS="1517" WIDTH="1772" HEIGHT="59" BASELINE="376 1547 2148 1552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1547 376 1565 1178 1565 1269 1576 1271 1576 2146 1565 2148 1552 2146 1521 376 1517 376 1547"/>
                        </Shape>
                        <String CONTENT="immediate rest. If compelled to make further effort, it will become quite"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l17" HPOS="376" VPOS="1582" WIDTH="1772" HEIGHT="46" BASELINE="376 1610 2148 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1610 376 1628 2148 1628 2148 1610 2148 1582 376 1582 376 1610"/>
                        </Shape>
                        <String CONTENT="exhausted, and oftentimes drop dead on the spot. Therefore wealthy men"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l18" HPOS="374" VPOS="1628" WIDTH="1774" HEIGHT="62" BASELINE="376 1673 2148 1669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1673 376 1690 2146 1686 2148 1669 2143 1638 1262 1628 1260 1628 1258 1628 1256 1628 1243 1638 493 1630 491 1630 374 1641 376 1673"/>
                        </Shape>
                        <String CONTENT="are always on the look-out to acquire additional harness-reindeer, either for pack-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l19" HPOS="376" VPOS="1701" WIDTH="1774" HEIGHT="48" BASELINE="376 1732 2150 1732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1732 376 1749 2150 1749 2150 1732 2150 1701 376 1701 376 1732"/>
                        </Shape>
                        <String CONTENT="sledges or for fast driving, that they may be able to relieve frequently those"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l20" HPOS="374" VPOS="1749" WIDTH="1774" HEIGHT="58" BASELINE="376 1792 2148 1788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1792 376 1807 2146 1803 2148 1788 2143 1760 1459 1749 1457 1749 374 1760 376 1792"/>
                        </Shape>
                        <String CONTENT="in use. The Chukchee saying is, however, “The poor man’s reindeer are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l21" HPOS="374" VPOS="1809" WIDTH="1774" HEIGHT="59" BASELINE="376 1853 2148 1846" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 1853 376 1868 2146 1861 2148 1846 2143 1818 968 1809 965 1809 374 1822 376 1853"/>
                        </Shape>
                        <String CONTENT="more enduring,” compelled as they are to constant exercise. In the reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l22" HPOS="372" VPOS="1877" WIDTH="1771" HEIGHT="54" BASELINE="374 1909 2143 1913" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 1909 372 1924 2139 1931 2143 1913 2141 1881 374 1877 374 1909"/>
                        </Shape>
                        <String CONTENT="races, the fresh, well-rested reindeer always win; and, to quote another saying,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l23" HPOS="385" VPOS="1929" WIDTH="1072" HEIGHT="58" BASELINE="385 1967 1457 1967" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1967 385 1987 1457 1987 1457 1967 1455 1929 385 1937 385 1967"/>
                        </Shape>
                        <String CONTENT="“All stakes are taken by the largest breeders.”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-125_r4" HPOS="374" VPOS="1995" WIDTH="1778" HEIGHT="1270" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="374 1995 2152 1995 2152 3265 374 3265"/>
                    </Shape>
                    <TextLine ID="mz_1-125_l24" HPOS="480" VPOS="1985" WIDTH="1670" HEIGHT="63" BASELINE="482 2032 2150 2026" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="482 2032 482 2048 2148 2043 2150 2026 2146 1996 1799 1985 1797 1985 480 1998 482 2032"/>
                        </Shape>
                        <String CONTENT="ECONOMICAL VALUE OF REINDEER-BREEDING. — The possession of reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l25" HPOS="374" VPOS="2045" WIDTH="1774" HEIGHT="63" BASELINE="376 2093 2148 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2093 376 2108 2146 2102 2148 2087 2143 2056 1557 2045 1554 2045 1552 2045 1528 2058 374 2058 376 2093"/>
                        </Shape>
                        <String CONTENT="herds makes the material life of the nomadic Chukchee more stable, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l26" HPOS="378" VPOS="2119" WIDTH="1770" HEIGHT="50" BASELINE="378 2149 2148 2149" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 2149 378 2169 2148 2169 2148 2149 2148 2119 378 2119 378 2149"/>
                        </Shape>
                        <String CONTENT="when compared with the precarious subsistence of most of the fishing and seal-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l27" HPOS="374" VPOS="2177" WIDTH="1774" HEIGHT="50" BASELINE="376 2210 2148 2206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2210 376 2227 2146 2223 2148 2206 2143 2177 374 2177 376 2210"/>
                        </Shape>
                        <String CONTENT="hunting tribes in his neighborhood, not excepting even the Russians and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l28" HPOS="374" VPOS="2225" WIDTH="1774" HEIGHT="63" BASELINE="376 2271 2148 2266" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2271 376 2288 2146 2284 2148 2266 2143 2238 1962 2225 1959 2225 1871 2236 1825 2225 1823 2225 1821 2225 1734 2236 1671 2225 1669 2225 1617 2236 1565 2225 1563 2225 1466 2236 1437 2225 1435 2225 1433 2225 1368 2236 1262 2225 1260 2225 1258 2225 1219 2238 1110 2227 1108 2227 647 2238 550 2227 547 2227 545 2227 521 2238 504 2227 502 2227 500 2227 387 2227 385 2227 383 2227 381 2227 381 2229 374 2234 376 2271"/>
                        </Shape>
                        <String CONTENT="Russianized natives. In the Kolyma district, where the white salmon does not"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l29" HPOS="376" VPOS="2301" WIDTH="1772" HEIGHT="45" BASELINE="376 2329 2148 2329" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2329 376 2346 2148 2346 2148 2329 2148 2301 376 2301 376 2329"/>
                        </Shape>
                        <String CONTENT="come from the Arctic Sea in large numbers, and where wild reindeer are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l30" HPOS="374" VPOS="2349" WIDTH="1774" HEIGHT="58" BASELINE="376 2390 2148 2385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2390 376 2407 2146 2403 2148 2385 2143 2357 396 2349 394 2349 391 2349 389 2349 374 2355 376 2390"/>
                        </Shape>
                        <String CONTENT="thinly scattered over a large wilderness, the Reindeer Chukchee, though in"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l31" HPOS="372" VPOS="2407" WIDTH="1776" HEIGHT="58" BASELINE="374 2450 2148 2444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 2450 374 2465 2146 2459 2148 2444 2143 2416 965 2407 963 2407 961 2407 959 2407 944 2418 576 2409 573 2409 372 2420 374 2450"/>
                        </Shape>
                        <String CONTENT="every other respect inferior to the fisher-folk of the river, play the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l32" HPOS="374" VPOS="2470" WIDTH="1774" HEIGHT="65" BASELINE="376 2511 2148 2504" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2511 376 2535 1528 2535 1528 2533 1531 2533 1559 2522 2130 2530 2133 2530 2135 2530 2137 2530 2148 2520 2148 2504 2143 2472 491 2470 489 2470 374 2481 376 2511"/>
                        </Shape>
                        <String CONTENT="prominent part in the economic life of the country. The river people depend"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l33" HPOS="372" VPOS="2526" WIDTH="1774" HEIGHT="59" BASELINE="374 2569 2146 2565" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 2569 374 2585 2143 2580 2146 2565 2141 2537 1279 2526 1277 2526 1275 2526 1240 2537 474 2528 472 2528 372 2539 374 2569"/>
                        </Shape>
                        <String CONTENT="on them for skins and fur clothing; and every spring, when the fish-supply is"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l34" HPOS="372" VPOS="2587" WIDTH="1774" HEIGHT="62" BASELINE="374 2632 2146 2626" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2137 2593 963 2587 961 2587 887 2598 426 2589 424 2589 372 2600 374 2632 374 2649 2143 2649 2146 2626 2143 2610 2137 2593"/>
                        </Shape>
                        <String CONTENT="exhausted and the usual famine is at hand, the river inhabitants, one by one,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l35" HPOS="372" VPOS="2647" WIDTH="1774" HEIGHT="61" BASELINE="374 2691 2146 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 2691 374 2708 2143 2701 2146 2684 2141 2652 394 2647 391 2647 389 2647 387 2647 372 2654 374 2691"/>
                        </Shape>
                        <String CONTENT="drive over the tundra with their dog-teams, carrying with them all the household"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l36" HPOS="374" VPOS="2706" WIDTH="1772" HEIGHT="60" BASELINE="376 2751 2146 2745" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2751 376 2766 2143 2760 2146 2745 2141 2714 965 2706 963 2706 961 2706 939 2717 396 2708 394 2708 391 2708 389 2708 374 2714 376 2751"/>
                        </Shape>
                        <String CONTENT="things they can spare, to buy with them such animals as their half-wild nomadic"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l37" HPOS="374" VPOS="2760" WIDTH="1772" HEIGHT="67" BASELINE="376 2812 2146 2803" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2812 376 2827 2143 2818 2146 2803 2141 2773 1949 2760 1946 2760 1864 2771 1847 2760 1845 2760 1842 2760 1840 2760 1771 2771 1747 2760 1745 2760 1743 2760 1661 2773 1496 2762 1494 2762 1492 2762 1466 2775 1286 2775 1262 2762 1260 2762 1258 2762 1182 2775 1033 2764 1030 2764 957 2775 929 2764 926 2764 924 2764 922 2764 920 2764 905 2775 779 2766 777 2766 775 2766 773 2766 760 2777 710 2766 708 2766 528 2777 511 2766 508 2766 506 2766 391 2766 389 2766 387 2766 385 2766 374 2775 376 2812"/>
                        </Shape>
                        <String CONTENT="friends will sell. Even the officials of the towns of Sredne-Kolymsk and Nishne-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l38" HPOS="374" VPOS="2836" WIDTH="1769" HEIGHT="52" BASELINE="376 2868 2143 2864" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2868 376 2885 2139 2888 2143 2864 2139 2836 374 2836 376 2868"/>
                        </Shape>
                        <String CONTENT="Kolymsk find themselves obliged to visit the wealthy camps, and urgently beg"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l39" HPOS="374" VPOS="2894" WIDTH="1767" HEIGHT="52" BASELINE="376 2927 2141 2922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2927 376 2944 2137 2946 2141 2922 2135 2894 374 2896 376 2927"/>
                        </Shape>
                        <String CONTENT="the reindeer-breeders to come nearer to the river with animals for slaughter,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l40" HPOS="374" VPOS="2944" WIDTH="1772" HEIGHT="61" BASELINE="376 2989 2146 2983" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2989 376 3005 2143 2998 2146 2983 2141 2955 1561 2944 1559 2944 1557 2944 1554 2944 1539 2955 974 2946 972 2946 970 2946 946 2957 498 2948 495 2948 374 2959 376 2989"/>
                        </Shape>
                        <String CONTENT="as otherwise the people of the town and the cossacks will be starved. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l41" HPOS="374" VPOS="3002" WIDTH="1772" HEIGHT="63" BASELINE="376 3048 2146 3041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 3048 376 3065 2143 3059 2146 3041 2141 3013 1606 3002 1604 3002 1548 3013 456 3007 454 3007 374 3018 376 3048"/>
                        </Shape>
                        <String CONTENT="trade of the country at present is carried on chiefly with the produce of rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l42" HPOS="372" VPOS="3065" WIDTH="1774" HEIGHT="61" BASELINE="374 3108 2146 3104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="374 3108 374 3124 2141 3126 2146 3104 2141 3076 1277 3065 1275 3065 1199 3076 398 3067 396 3067 394 3067 372 3076 374 3108"/>
                        </Shape>
                        <String CONTENT="deer-breeding, such as fawn-skins, curried leather, etc. The costly peltries,"/>
