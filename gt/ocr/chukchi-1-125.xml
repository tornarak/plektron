        <Page WIDTH="2781" HEIGHT="3866" PHYSICAL_IMG_NR="0" ID="page_0">
            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-125" HPOS="351" VPOS="617" WIDTH="1780" HEIGHT="2617"><TextLine ID="mz_1-125_l1" HPOS="934" VPOS="617" WIDTH="615" HEIGHT="54" BASELINE="934 651 1549 647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1538 617 1516 617 1494 617 1473 617 1451 617 1429 617 1408 617 1386 617 1365 617 1343 617 1321 617 1300 617 1278 617 1256 617 1235 617 1213 617 1191 617 1170 617 1148 617 1126 617 1105 617 1083 617 1061 617 1040 617 1018 617 996 617 975 617 953 617 934 632 934 651 934 671 1546 666 1549 647 1546 643 1538 617"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l2" HPOS="2055" VPOS="623" WIDTH="59" HEIGHT="56" BASELINE="2058 662 2114 666" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2103 634 2086 625 2058 623 2058 662 2055 675 2109 679 2114 666 2114 640 2103 634"/>
                        </Shape>
                        <String CONTENT="95"/>
                    </TextLine>
<TextLine ID="mz_1-125_l3" HPOS="355" VPOS="729" WIDTH="1776" HEIGHT="50" BASELINE="355 760 2131 760" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 760 355 779 2131 779 2131 760 2131 729 355 729 355 760"/>
                        </Shape>
                        <String CONTENT="Sometimes a medium-sized log, or a clumsy wooden implement similar in shape"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l4" HPOS="353" VPOS="777" WIDTH="1776" HEIGHT="61" BASELINE="355 822 2129 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 822 355 838 2127 833 2129 816 2125 786 964 777 962 777 960 777 957 777 938 788 375 779 373 779 370 779 368 779 353 786 355 822"/>
                        </Shape>
                        <String CONTENT="to a thick two-pronged fork, is tied to the animal’s neck, though it hinders it"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l5" HPOS="353" VPOS="840" WIDTH="1776" HEIGHT="58" BASELINE="355 883 2129 879" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 883 355 898 2127 894 2129 879 2125 848 366 840 364 840 362 840 360 840 360 842 353 846 355 883"/>
                        </Shape>
                        <String CONTENT="from grazing properly. The reindeer, secured by the end of the lasso, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l6" HPOS="355" VPOS="905" WIDTH="1772" HEIGHT="56" BASELINE="357 935 2127 939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 935 355 952 366 961 368 961 370 961 373 961 2125 952 2127 939 2125 909 357 905 357 935"/>
                        </Shape>
                        <String CONTENT="usually turned out to pasture for a short time daily; but at night the man"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l7" HPOS="355" VPOS="959" WIDTH="1776" HEIGHT="67" BASELINE="357 1000 2131 993" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 1000 357 1015 717 1026 719 1026 2129 1011 2131 993 2127 959 392 959 390 959 388 959 355 970 357 1000"/>
                        </Shape>
                        <String CONTENT="who wants to pasture his animals well will sit up himself, holding the end of"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l8" HPOS="353" VPOS="1017" WIDTH="1776" HEIGHT="56" BASELINE="355 1058 2129 1054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1058 355 1073 2129 1069 2129 1054 2125 1026 375 1017 373 1017 370 1017 368 1017 353 1024 355 1058"/>
                        </Shape>
                        <String CONTENT="the rope in his hand, and now and then, while dozing, take a look at his"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l9" HPOS="353" VPOS="1078" WIDTH="1772" HEIGHT="58" BASELINE="355 1119 2125 1115" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1119 355 1136 2122 1132 2125 1115 2120 1086 403 1078 401 1078 399 1078 353 1089 355 1119"/>
                        </Shape>
                        <String CONTENT="reindeer; otherwise they would become entangled, and could not graze at all."/>
                    </TextLine>
<TextLine ID="mz_1-125_l10" HPOS="459" VPOS="1134" WIDTH="1668" HEIGHT="63" BASELINE="461 1180 2127 1173" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 1180 461 1197 2125 1190 2127 1173 2122 1145 1674 1134 1672 1134 1555 1145 1222 1136 1219 1136 459 1147 461 1180"/>
                        </Shape>
                        <String CONTENT="If well pastured and not overworked, reindeer are swift; and in two days"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l11" HPOS="353" VPOS="1197" WIDTH="1774" HEIGHT="58" BASELINE="355 1240 2127 1236" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1240 355 1255 2125 1251 2127 1236 2122 1203 431 1197 429 1197 353 1208 355 1240"/>
                        </Shape>
                        <String CONTENT="a single driver often makes two hundred miles, provided the snow is thin and"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l12" HPOS="353" VPOS="1262" WIDTH="1772" HEIGHT="58" BASELINE="355 1301 2125 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1301 355 1316 2120 1320 2125 1294 2120 1275 1726 1275 1696 1262 1674 1275 1499 1277 1384 1264 1302 1277 1261 1264 1193 1277 1105 1264 986 1277 944 1264 912 1279 804 1266 353 1273 355 1301"/>
                        </Shape>
                        <String CONTENT="hard, as it usually is on the tundra. The lightest camp makes, on an average,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l13" HPOS="353" VPOS="1314" WIDTH="1774" HEIGHT="63" BASELINE="355 1361 2127 1355" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1361 355 1377 2125 1372 2127 1355 2125 1327 2099 1314 2097 1314 2094 1314 2092 1314 2068 1325 1681 1314 1679 1314 1676 1314 1674 1314 1659 1327 1512 1327 992 1316 990 1316 929 1329 375 1318 373 1318 370 1318 368 1318 353 1327 355 1361"/>
                        </Shape>
                        <String CONTENT="twenty-five miles a day; and the large camp, from ten to fifteen miles, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l14" HPOS="355" VPOS="1374" WIDTH="1767" HEIGHT="61" BASELINE="357 1420 2122 1413" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 1420 357 1435 2120 1433 2122 1413 2118 1385 1566 1374 1564 1374 1562 1374 1529 1385 392 1379 390 1379 388 1379 355 1390 357 1420"/>
                        </Shape>
                        <String CONTENT="often, especially early in the fall, not more than from three to five miles."/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l15" HPOS="360" VPOS="1433" WIDTH="1767" HEIGHT="61" BASELINE="362 1476 2127 1472" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1476 362 1494 2125 1489 2127 1472 2122 1446 2038 1433 2036 1433 2034 1433 2001 1444 1930 1433 1928 1433 1925 1433 1923 1433 1904 1446 1711 1446 1692 1433 1689 1433 1687 1433 1685 1433 1579 1444 1488 1433 1486 1433 1306 1444 1258 1433 1256 1433 1254 1433 1252 1433 1250 1433 1230 1446 1178 1435 1176 1435 1094 1448 912 1448 888 1435 886 1435 884 1435 882 1435 856 1446 834 1435 832 1435 830 1435 773 1446 708 1435 706 1435 704 1435 672 1446 630 1435 628 1435 626 1435 360 1439 362 1476"/>
                        </Shape>
                        <String CONTENT="When tired, the reindeer, especially the Chukchee reindeer, must be given"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l16" HPOS="355" VPOS="1502" WIDTH="1772" HEIGHT="59" BASELINE="355 1532 2127 1537" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1532 355 1550 1157 1550 1248 1561 1250 1561 2125 1550 2127 1537 2125 1506 355 1502 355 1532"/>
                        </Shape>
                        <String CONTENT="immediate rest. If compelled to make further effort, it will become quite"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l17" HPOS="355" VPOS="1567" WIDTH="1772" HEIGHT="46" BASELINE="355 1595 2127 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1595 355 1613 2127 1613 2127 1595 2127 1567 355 1567 355 1595"/>
                        </Shape>
                        <String CONTENT="exhausted, and oftentimes drop dead on the spot. Therefore wealthy men"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l18" HPOS="353" VPOS="1613" WIDTH="1774" HEIGHT="62" BASELINE="355 1658 2127 1654" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1658 355 1675 2125 1671 2127 1654 2122 1623 1241 1613 1239 1613 1237 1613 1235 1613 1222 1623 472 1615 470 1615 353 1626 355 1658"/>
                        </Shape>
                        <String CONTENT="are always on the look-out to acquire additional harness-reindeer, either for pack-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l19" HPOS="355" VPOS="1686" WIDTH="1774" HEIGHT="48" BASELINE="355 1717 2129 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1717 355 1734 2129 1734 2129 1717 2129 1686 355 1686 355 1717"/>
                        </Shape>
                        <String CONTENT="sledges or for fast driving, that they may be able to relieve frequently those"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l20" HPOS="353" VPOS="1734" WIDTH="1774" HEIGHT="58" BASELINE="355 1777 2127 1773" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1777 355 1792 2125 1788 2127 1773 2122 1745 1438 1734 1436 1734 353 1745 355 1777"/>
                        </Shape>
                        <String CONTENT="in use. The Chukchee saying is, however, “The poor man’s reindeer are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l21" HPOS="353" VPOS="1794" WIDTH="1774" HEIGHT="59" BASELINE="355 1838 2127 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1838 355 1853 2125 1846 2127 1831 2122 1803 947 1794 944 1794 353 1807 355 1838"/>
                        </Shape>
                        <String CONTENT="more enduring,” compelled as they are to constant exercise. In the reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l22" HPOS="351" VPOS="1862" WIDTH="1771" HEIGHT="54" BASELINE="353 1894 2122 1898" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1894 351 1909 2118 1916 2122 1898 2120 1866 353 1862 353 1894"/>
                        </Shape>
                        <String CONTENT="races, the fresh, well-rested reindeer always win; and, to quote another saying,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l23" HPOS="364" VPOS="1914" WIDTH="1072" HEIGHT="58" BASELINE="364 1952 1436 1952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1952 364 1972 1436 1972 1436 1952 1434 1914 364 1922 364 1952"/>
                        </Shape>
                        <String CONTENT="“All stakes are taken by the largest breeders.”"/>
                    </TextLine>
<TextLine ID="mz_1-125_l24" HPOS="459" VPOS="1970" WIDTH="1670" HEIGHT="63" BASELINE="461 2017 2129 2011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 2017 461 2033 2127 2028 2129 2011 2125 1981 1778 1970 1776 1970 459 1983 461 2017"/>
                        </Shape>
                        <String CONTENT="ECONOMICAL VALUE OF REINDEER-BREEDING. — The possession of reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l25" HPOS="353" VPOS="2030" WIDTH="1774" HEIGHT="63" BASELINE="355 2078 2127 2072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2078 355 2093 2125 2087 2127 2072 2122 2041 1536 2030 1533 2030 1531 2030 1507 2043 353 2043 355 2078"/>
                        </Shape>
                        <String CONTENT="herds makes the material life of the nomadic Chukchee more stable, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l26" HPOS="357" VPOS="2104" WIDTH="1770" HEIGHT="50" BASELINE="357 2134 2127 2134" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2134 357 2154 2127 2154 2127 2134 2127 2104 357 2104 357 2134"/>
                        </Shape>
                        <String CONTENT="when compared with the precarious subsistence of most of the fishing and seal-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l27" HPOS="353" VPOS="2162" WIDTH="1774" HEIGHT="50" BASELINE="355 2195 2127 2191" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2195 355 2212 2125 2208 2127 2191 2122 2162 353 2162 355 2195"/>
                        </Shape>
                        <String CONTENT="hunting tribes in his neighborhood, not excepting even the Russians and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l28" HPOS="353" VPOS="2210" WIDTH="1774" HEIGHT="63" BASELINE="355 2256 2127 2251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2256 355 2273 2125 2269 2127 2251 2122 2223 1941 2210 1938 2210 1850 2221 1804 2210 1802 2210 1800 2210 1713 2221 1650 2210 1648 2210 1596 2221 1544 2210 1542 2210 1445 2221 1416 2210 1414 2210 1412 2210 1347 2221 1241 2210 1239 2210 1237 2210 1198 2223 1089 2212 1087 2212 626 2223 529 2212 526 2212 524 2212 500 2223 483 2212 481 2212 479 2212 366 2212 364 2212 362 2212 360 2212 360 2214 353 2219 355 2256"/>
                        </Shape>
                        <String CONTENT="Russianized natives. In the Kolyma district, where the white salmon does not"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l29" HPOS="355" VPOS="2286" WIDTH="1772" HEIGHT="45" BASELINE="355 2314 2127 2314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2314 355 2331 2127 2331 2127 2314 2127 2286 355 2286 355 2314"/>
                        </Shape>
                        <String CONTENT="come from the Arctic Sea in large numbers, and where wild reindeer are"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l30" HPOS="353" VPOS="2334" WIDTH="1774" HEIGHT="58" BASELINE="355 2375 2127 2370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2375 355 2392 2125 2388 2127 2370 2122 2342 375 2334 373 2334 370 2334 368 2334 353 2340 355 2375"/>
                        </Shape>
                        <String CONTENT="thinly scattered over a large wilderness, the Reindeer Chukchee, though in"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l31" HPOS="351" VPOS="2392" WIDTH="1776" HEIGHT="58" BASELINE="353 2435 2127 2429" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2435 353 2450 2125 2444 2127 2429 2122 2401 944 2392 942 2392 940 2392 938 2392 923 2403 555 2394 552 2394 351 2405 353 2435"/>
                        </Shape>
                        <String CONTENT="every other respect inferior to the fisher-folk of the river, play the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l32" HPOS="353" VPOS="2455" WIDTH="1774" HEIGHT="65" BASELINE="355 2496 2127 2489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2496 355 2520 1507 2520 1507 2518 1510 2518 1538 2507 2109 2515 2112 2515 2114 2515 2116 2515 2127 2505 2127 2489 2122 2457 470 2455 468 2455 353 2466 355 2496"/>
                        </Shape>
                        <String CONTENT="prominent part in the economic life of the country. The river people depend"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l33" HPOS="351" VPOS="2511" WIDTH="1774" HEIGHT="59" BASELINE="353 2554 2125 2550" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2554 353 2570 2122 2565 2125 2550 2120 2522 1258 2511 1256 2511 1254 2511 1219 2522 453 2513 451 2513 351 2524 353 2554"/>
                        </Shape>
                        <String CONTENT="on them for skins and fur clothing; and every spring, when the fish-supply is"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l34" HPOS="351" VPOS="2572" WIDTH="1774" HEIGHT="62" BASELINE="353 2617 2125 2611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2116 2578 942 2572 940 2572 866 2583 405 2574 403 2574 351 2585 353 2617 353 2634 2122 2634 2125 2611 2122 2595 2116 2578"/>
                        </Shape>
                        <String CONTENT="exhausted and the usual famine is at hand, the river inhabitants, one by one,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l35" HPOS="351" VPOS="2632" WIDTH="1774" HEIGHT="61" BASELINE="353 2676 2125 2669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2676 353 2693 2122 2686 2125 2669 2120 2637 373 2632 370 2632 368 2632 366 2632 351 2639 353 2676"/>
                        </Shape>
                        <String CONTENT="drive over the tundra with their dog-teams, carrying with them all the household"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l36" HPOS="353" VPOS="2691" WIDTH="1772" HEIGHT="60" BASELINE="355 2736 2125 2730" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2736 355 2751 2122 2745 2125 2730 2120 2699 944 2691 942 2691 940 2691 918 2702 375 2693 373 2693 370 2693 368 2693 353 2699 355 2736"/>
                        </Shape>
                        <String CONTENT="things they can spare, to buy with them such animals as their half-wild nomadic"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l37" HPOS="353" VPOS="2745" WIDTH="1772" HEIGHT="67" BASELINE="355 2797 2125 2788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2797 355 2812 2122 2803 2125 2788 2120 2758 1928 2745 1925 2745 1843 2756 1826 2745 1824 2745 1821 2745 1819 2745 1750 2756 1726 2745 1724 2745 1722 2745 1640 2758 1475 2747 1473 2747 1471 2747 1445 2760 1265 2760 1241 2747 1239 2747 1237 2747 1161 2760 1012 2749 1009 2749 936 2760 908 2749 905 2749 903 2749 901 2749 899 2749 884 2760 758 2751 756 2751 754 2751 752 2751 739 2762 689 2751 687 2751 507 2762 490 2751 487 2751 485 2751 370 2751 368 2751 366 2751 364 2751 353 2760 355 2797"/>
                        </Shape>
                        <String CONTENT="friends will sell. Even the officials of the towns of Sredne-Kolymsk and Nishne-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l38" HPOS="353" VPOS="2821" WIDTH="1769" HEIGHT="52" BASELINE="355 2853 2122 2849" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2853 355 2870 2118 2873 2122 2849 2118 2821 353 2821 355 2853"/>
                        </Shape>
                        <String CONTENT="Kolymsk find themselves obliged to visit the wealthy camps, and urgently beg"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l39" HPOS="353" VPOS="2879" WIDTH="1767" HEIGHT="52" BASELINE="355 2912 2120 2907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2912 355 2929 2116 2931 2120 2907 2114 2879 353 2881 355 2912"/>
                        </Shape>
                        <String CONTENT="the reindeer-breeders to come nearer to the river with animals for slaughter,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l40" HPOS="353" VPOS="2929" WIDTH="1772" HEIGHT="61" BASELINE="355 2974 2125 2968" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2974 355 2990 2122 2983 2125 2968 2120 2940 1540 2929 1538 2929 1536 2929 1533 2929 1518 2940 953 2931 951 2931 949 2931 925 2942 477 2933 474 2933 353 2944 355 2974"/>
                        </Shape>
                        <String CONTENT="as otherwise the people of the town and the cossacks will be starved. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l41" HPOS="353" VPOS="2987" WIDTH="1772" HEIGHT="63" BASELINE="355 3033 2125 3026" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 3033 355 3050 2122 3044 2125 3026 2120 2998 1585 2987 1583 2987 1527 2998 435 2992 433 2992 353 3003 355 3033"/>
                        </Shape>
                        <String CONTENT="trade of the country at present is carried on chiefly with the produce of rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l42" HPOS="351" VPOS="3050" WIDTH="1774" HEIGHT="61" BASELINE="353 3093 2125 3089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 3093 353 3109 2120 3111 2125 3089 2120 3061 1256 3050 1254 3050 1178 3061 377 3052 375 3052 373 3052 351 3061 353 3093"/>
                        </Shape>
                        <String CONTENT="deer-breeding, such as fawn-skins, curried leather, etc. The costly peltries,"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l43" HPOS="353" VPOS="3109" WIDTH="1772" HEIGHT="65" BASELINE="355 3154 2125 3148" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 3154 355 3167 2107 3174 2109 3174 2112 3174 2114 3174 2125 3163 2125 3148 2120 3119 1555 3109 1553 3109 1551 3109 1527 3122 353 3122 355 3154"/>
                        </Shape>
                        <String CONTENT="before coming to the market, also pass through the hands of the wealthy"/>
                    </TextLine>

                    <TextLine ID="mz_1-125_l44" HPOS="353" VPOS="3182" WIDTH="1769" HEIGHT="52" BASELINE="353 3213 2122 3213" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 3213 353 3232 2120 3234 2122 3213 2122 3182 353 3182 353 3213"/>
                        </Shape>
                        <String CONTENT="reindeer-breeders, who buy them with slaughter-animals from the Tungus, Lamut,"/>
                    </TextLine>
