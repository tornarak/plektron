                        <Shape>
                            <Polygon POINTS="377 2914 377 2927 2132 2921 2134 2908 2128 2876 376 2886 377 2914"/>
                        </Shape>
                        <String CONTENT="to the cheeks, and the lips almost wanted to speak. Scabby-One shouted, “Give me the soul!”"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l43" HPOS="377" VPOS="2931" WIDTH="1765" HEIGHT="45" BASELINE="377 2959 2142 2959" TAGREFS="TYPE_6">
