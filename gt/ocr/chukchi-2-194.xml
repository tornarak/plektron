                    <TextLine ID="mz_2-194_l36" HPOS="454" VPOS="2606" WIDTH="1692" HEIGHT="43" BASELINE="454 2633 2146 2633" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="454 2633 454 2649 2146 2649 2146 2633 2146 2606 454 2606 454 2633"/>
                        </Shape>
                        <String CONTENT="He [the shaman] called his keˊlet and gave them the boy’s soul to hold, and then looked"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l37" HPOS="376" VPOS="2649" WIDTH="1768" HEIGHT="55" BASELINE="377 2677 2144 2680" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="377 2677 376 2690 1390 2704 1392 2704 2142 2694 2144 2680 2142 2655 377 2649 377 2677"/>
                        </Shape>
                        <String CONTENT="hard at the decayed heap [of the half-decomposed corpse], and gulped it down, spattering the"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l38" HPOS="377" VPOS="2700" WIDTH="1767" HEIGHT="45" BASELINE="377 2727 2144 2727" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="377 2727 377 2745 2144 2741 2144 2727 2144 2700 377 2700 377 2727"/>
                        </Shape>
                        <String CONTENT="putrid fluid about. Then he shouted, “Bring a new white skin!” He vomited, and spat out the boy’s"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l39" HPOS="376" VPOS="2743" WIDTH="1766" HEIGHT="45" BASELINE="377 2771 2142 2774" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="377 2771 376 2782 2138 2788 2142 2774 2140 2747 377 2743 377 2771"/>
                        </Shape>
                        <String CONTENT="body. All the bones were in their right places, and the flesh stuck to the bones again. Then"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l40" HPOS="377" VPOS="2792" WIDTH="1767" HEIGHT="43" BASELINE="377 2820 2144 2820" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="377 2810 377 2820 377 2833 2142 2835 2144 2820 2144 2792 385 2792 377 2810"/>
                        </Shape>
                        <String CONTENT="he swallowed the body a second time and spat it out again. It was covered with new skin, all"/>
                    </TextLine>

                    <TextLine ID="mz_2-194_l41" HPOS="374" VPOS="2835" WIDTH="1770" HEIGHT="45" BASELINE="376 2863 2144 2867" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="376 2863 374 2876 2140 2880 2144 2867 2142 2835 376 2835 376 2863"/>
                        </Shape>
                        <String CONTENT="sores were smoothed down. He swallowed it a third time and spat it out again: blood mounted"/>
                    </TextLine>

