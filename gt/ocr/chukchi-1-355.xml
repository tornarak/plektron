                    <TextLine ID="mz_1-355_l28" HPOS="435" VPOS="2245" WIDTH="1778" HEIGHT="49" BASELINE="435 2277 2213 2277" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 2277 435 2294 2213 2294 2213 2277 2211 2245 435 2245 435 2277"/>
                        </Shape>
                        <String CONTENT="of it was obtained on Anadyr Bay (Fig. 197, d). It consists of a horizontal"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l29" HPOS="435" VPOS="2294" WIDTH="1776" HEIGHT="61" BASELINE="435 2338 2211 2338" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 2338 435 2355 2211 2355 2211 2338 2211 2305 2185 2294 2182 2294 2180 2294 2074 2305 2037 2294 2035 2294 2033 2294 2031 2294 1996 2305 1570 2294 1567 2294 1444 2305 1416 2294 1414 2294 1412 2294 1340 2305 1310 2294 1308 2294 1305 2294 1303 2294 1269 2305 1210 2294 1208 2294 1206 2294 1169 2305 1061 2294 1059 2294 872 2305 816 2294 814 2294 744 2305 697 2294 695 2294 693 2294 690 2294 651 2305 608 2294 606 2294 604 2294 602 2294 576 2305 513 2294 511 2294 435 2305 435 2338"/>
                        </Shape>
                        <String CONTENT="antler handle with one end broadened and containing a hole, through which"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l30" HPOS="435" VPOS="2355" WIDTH="1778" HEIGHT="69" BASELINE="437 2400 2213 2394" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="437 2400 437 2418 955 2413 1020 2424 1022 2424 1024 2424 1026 2424 1041 2411 1191 2411 1210 2422 1212 2422 1214 2422 1217 2422 1531 2411 1617 2422 1619 2422 1622 2422 1650 2409 1671 2420 1674 2420 1676 2420 2211 2407 2213 2394 2208 2364 1065 2355 1063 2355 1000 2366 615 2357 612 2357 435 2368 437 2400"/>
                        </Shape>
                        <String CONTENT="passes the rod of the top to be spun. This is kept from slipping out of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l31" HPOS="435" VPOS="2424" WIDTH="1776" HEIGHT="50" BASELINE="437 2459 2211 2455" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="437 2459 437 2474 2208 2470 2211 2455 2206 2424 435 2424 437 2459"/>
                        </Shape>
                        <String CONTENT="handle by a knob at the upper end and a square piece of wood at the bottom."/>
