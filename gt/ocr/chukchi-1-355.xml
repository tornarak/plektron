                        </Shape>
                        <String CONTENT="Children have various toys, most of them small imitations of objects of"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l19" HPOS="435" VPOS="1708" WIDTH="1776" HEIGHT="47" BASELINE="435 1738 2211 1738" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 1738 435 1755 2211 1755 2211 1738 2211 1708 435 1708 435 1738"/>
                        </Shape>
                        <String CONTENT="every-day life, such as little boots, sledges, wooden or ivory dogs and reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l20" HPOS="437" VPOS="1766" WIDTH="1774" HEIGHT="50" BASELINE="437 1799 2211 1799" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="437 1799 437 1816 2211 1816 2211 1799 2208 1766 437 1766 437 1799"/>
