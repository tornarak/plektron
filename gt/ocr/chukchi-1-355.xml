                        </Shape>
                        <String CONTENT="around the rod above where it passes through the handle and just under the"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l34" HPOS="435" VPOS="2589" WIDTH="1773" HEIGHT="65" BASELINE="437 2639 2208 2632" TAGREFS="TYPE_6">
                        <Shape>
