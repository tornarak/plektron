                        </Shape>
                        <String CONTENT="catches the gristle gets the stakes, which are usually matches, copper caps,"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l13" HPOS="435" VPOS="1335" WIDTH="589" HEIGHT="61" BASELINE="437 1381 1024 1376" TAGREFS="TYPE_6">
                        <Shape>
