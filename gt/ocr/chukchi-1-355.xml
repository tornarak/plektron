                <TextBlock ID="text_1-355" HPOS="409" VPOS="621" WIDTH="1785" HEIGHT="2702"><TextLine ID="mz_1-355_l1" HPOS="988" VPOS="621" WIDTH="621" HEIGHT="54" BASELINE="990 656 1609 660" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1596 623 999 621 990 625 990 656 988 671 1605 675 1609 660 1607 649 1596 623"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l2" HPOS="2090" VPOS="632" WIDTH="87" HEIGHT="60" BASELINE="2090 669 2177 669" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2090 669 2090 692 2177 684 2177 669 2177 632 2090 632 2090 669"/>
                        </Shape>
                        <String CONTENT="273"/>
                    </TextLine>
<TextLine ID="mz_1-355_l3" HPOS="414" VPOS="736" WIDTH="1771" HEIGHT="47" BASELINE="414 766 2185 766" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 766 414 783 2185 783 2185 766 2185 736 414 736 414 766"/>
                        </Shape>
                        <String CONTENT="winner has the right to give the loser a stroke on the palm of his hand with"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l4" HPOS="412" VPOS="786" WIDTH="1773" HEIGHT="58" BASELINE="414 827 2185 822" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 827 414 844 2183 840 2185 822 2181 794 431 786 429 786 427 786 425 786 412 792 414 827"/>
                        </Shape>
                        <String CONTENT="the stick used in the game, for every point he has gained on him. The game"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l5" HPOS="414" VPOS="853" WIDTH="1769" HEIGHT="56" BASELINE="414 887 2183 887" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 887 414 902 2181 909 2183 887 2183 857 414 853 414 887"/>
                        </Shape>
                        <String CONTENT="is sometimes varied by throwing a bundle of sticks into the air and catching"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l6" HPOS="412" VPOS="902" WIDTH="1773" HEIGHT="68" BASELINE="414 944 2185 948" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 944 412 961 425 970 427 970 429 970 431 970 2183 961 2185 948 2183 918 1759 905 1756 905 1692 915 1661 905 1659 905 1657 905 1655 905 1633 915 1607 905 1605 905 1603 905 1488 915 1449 905 1447 905 1445 905 1442 905 1440 905 1423 918 1319 918 1302 902 1300 902 1297 902 1295 902 1232 913 1189 902 1187 902 1185 902 1107 913 1029 902 1027 902 1025 902 992 913 897 902 895 902 892 902 847 913 804 902 801 902 799 902 797 902 775 913 713 902 710 902 708 902 685 913 639 902 637 902 635 902 414 911 414 944"/>
                        </Shape>
                        <String CONTENT="them with the hand as they fall. The scoring and the ultimate reward are"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l7" HPOS="412" VPOS="972" WIDTH="885" HEIGHT="56" BASELINE="414 1002 1297 1006" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1002 412 1019 418 1026 418 1028 420 1028 422 1028 425 1028 1295 1019 1297 1006 1295 976 414 972 414 1002"/>
                        </Shape>
                        <String CONTENT="identical with those of the hoop-game."/>
                    </TextLine>
<TextLine ID="mz_1-355_l8" HPOS="516" VPOS="1030" WIDTH="1674" HEIGHT="59" BASELINE="518 1063 2190 1067" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="518 1063 516 1076 542 1089 544 1089 546 1089 2187 1080 2190 1067 2187 1035 518 1030 518 1063"/>
                        </Shape>
                        <String CONTENT="Gambling-games are little known among the Chukchee. I was told that"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l9" HPOS="409" VPOS="1082" WIDTH="1778" HEIGHT="61" BASELINE="412 1128 2187 1123" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="412 1128 412 1143 2185 1138 2187 1123 2183 1095 1666 1082 1663 1082 1661 1082 1627 1093 1529 1082 1527 1082 1525 1082 1486 1093 1367 1082 1365 1082 1250 1095 702 1084 700 1084 697 1084 672 1095 609 1084 607 1084 604 1084 602 1084 587 1097 409 1097 412 1128"/>
                        </Shape>
                        <String CONTENT="among the Maritime Chukchee on the Arctic shore there is a simple game"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l10" HPOS="414" VPOS="1156" WIDTH="1776" HEIGHT="54" BASELINE="414 1186 2190 1186" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1186 414 1210 2190 1201 2190 1186 2190 1156 414 1156 414 1186"/>
                        </Shape>
                        <String CONTENT="played for stakes, which consists in throwing a small piece of gristle against"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l11" HPOS="412" VPOS="1201" WIDTH="1775" HEIGHT="59" BASELINE="414 1247 2187 1242" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1247 414 1260 2185 1255 2187 1242 2185 1214 2135 1201 2133 1201 2131 1201 2129 1201 2084 1212 1882 1201 1880 1201 1808 1212 1780 1201 1778 1201 1776 1201 1702 1212 1679 1201 1676 1201 1674 1201 1672 1201 1627 1212 1592 1201 1590 1201 1588 1201 1585 1201 1555 1212 1458 1201 1455 1201 1453 1201 1451 1201 1438 1212 1412 1201 1410 1201 1408 1201 1321 1212 1304 1201 1302 1201 1300 1201 1297 1201 1295 1201 1248 1214 1217 1203 1215 1203 1213 1203 1135 1214 973 1203 970 1203 968 1203 966 1203 947 1216 704 1216 633 1203 630 1203 628 1203 594 1214 481 1203 479 1203 412 1216 414 1247"/>
                        </Shape>
                        <String CONTENT="a large flat stone so that it will rebound high in the air. The one who"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l12" HPOS="412" VPOS="1262" WIDTH="1773" HEIGHT="63" BASELINE="414 1307 2185 1303" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1307 414 1322 2181 1325 2185 1303 2181 1275 1529 1262 1527 1262 1525 1262 1523 1262 1505 1275 1399 1275 1306 1262 1304 1262 1302 1262 1265 1275 1178 1264 1176 1264 853 1275 756 1264 754 1264 685 1275 624 1264 622 1264 620 1264 583 1275 479 1264 477 1264 412 1277 414 1307"/>
                        </Shape>
                        <String CONTENT="catches the gristle gets the stakes, which are usually matches, copper caps,"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l13" HPOS="414" VPOS="1320" WIDTH="589" HEIGHT="61" BASELINE="416 1366 1003 1361" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 1366 416 1381 1001 1379 1003 1361 999 1333 780 1320 778 1320 775 1320 754 1331 546 1322 544 1322 542 1322 516 1333 487 1322 485 1322 483 1322 414 1335 416 1366"/>
                        </Shape>
                        <String CONTENT="and similar small objects."/>
                    </TextLine>
<TextLine ID="mz_1-355_l14" HPOS="524" VPOS="1394" WIDTH="1666" HEIGHT="48" BASELINE="524 1424 2190 1424" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="524 1424 524 1442 2190 1442 2190 1424 2190 1394 524 1394 524 1424"/>
                        </Shape>
                        <String CONTENT="At the present time many camps and villages have learned to play cards"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l15" HPOS="412" VPOS="1442" WIDTH="1775" HEIGHT="60" BASELINE="414 1483 2187 1478" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1483 414 1502 2185 1498 2187 1478 2183 1450 429 1442 427 1442 425 1442 422 1442 412 1448 414 1483"/>
                        </Shape>
                        <String CONTENT="from their Russian neighbors or from American whalers. Among the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l16" HPOS="412" VPOS="1502" WIDTH="1775" HEIGHT="59" BASELINE="414 1543 2187 1539" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1543 414 1561 2185 1556 2187 1539 2183 1511 429 1502 427 1502 425 1502 422 1502 412 1509 414 1543"/>
                        </Shape>
                        <String CONTENT="Chukchee of the Kolyma, passionate gamblers may now be met who have lost"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l17" HPOS="414" VPOS="1574" WIDTH="1284" HEIGHT="58" BASELINE="414 1604 1698 1604" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1604 414 1619 672 1619 682 1628 682 1630 685 1630 687 1630 689 1632 775 1632 775 1630 778 1630 780 1630 780 1628 791 1619 827 1630 830 1630 832 1630 970 1619 1458 1619 1523 1630 1525 1630 1698 1617 1698 1604 1698 1574 414 1574 414 1604"/>
                        </Shape>
                        <String CONTENT="their all in play against more clever Russian neighbors."/>
                    </TextLine>
<TextLine ID="mz_1-355_l18" HPOS="518" VPOS="1621" WIDTH="1676" HEIGHT="59" BASELINE="520 1665 2194 1660" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="520 1665 520 1680 2192 1675 2194 1660 2190 1626 539 1621 537 1621 535 1621 533 1621 518 1628 520 1665"/>
                        </Shape>
                        <String CONTENT="Children have various toys, most of them small imitations of objects of"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l19" HPOS="414" VPOS="1693" WIDTH="1776" HEIGHT="47" BASELINE="414 1723 2190 1723" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 1723 414 1740 2190 1740 2190 1723 2190 1693 414 1693 414 1723"/>
                        </Shape>
                        <String CONTENT="every-day life, such as little boots, sledges, wooden or ivory dogs and reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l20" HPOS="416" VPOS="1751" WIDTH="1774" HEIGHT="50" BASELINE="416 1784 2190 1784" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 1784 416 1801 2190 1801 2190 1784 2187 1751 416 1751 416 1784"/>
                        </Shape>
                        <String CONTENT="with the proper harness, snowshoes, bows and arrows. Grasping in each hand"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l21" HPOS="414" VPOS="1801" WIDTH="1776" HEIGHT="61" BASELINE="416 1844 2190 1840" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 1844 416 1862 2187 1857 2190 1840 2185 1812 1332 1801 1330 1801 1328 1801 1297 1812 496 1803 494 1803 414 1814 416 1844"/>
                        </Shape>
                        <String CONTENT="a slender willow branch having many offshoots to represent antlers, the boys"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l22" HPOS="414" VPOS="1859" WIDTH="983" HEIGHT="72" BASELINE="416 1905 1397 1901" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 1905 416 1920 646 1931 648 1931 650 1931 682 1920 723 1931 726 1931 728 1931 730 1931 732 1931 732 1929 743 1920 1176 1929 1178 1929 1180 1929 1183 1929 1183 1927 1193 1918 1395 1918 1397 1901 1393 1872 1245 1859 1243 1859 1148 1870 1113 1859 1111 1859 1109 1859 1107 1859 1081 1870 1048 1859 1046 1859 1044 1859 1042 1859 1020 1870 882 1862 879 1862 877 1862 853 1872 830 1862 827 1862 825 1862 823 1862 821 1862 821 1864 810 1875 659 1875 572 1862 570 1862 513 1872 455 1862 453 1862 451 1862 414 1875 416 1905"/>
                        </Shape>
                        <String CONTENT="will gallop up and down, playing reindeer."/>
                    </TextLine>
<TextLine ID="mz_1-355_l23" HPOS="526" VPOS="1924" WIDTH="1668" HEIGHT="67" BASELINE="529 1965 2194 1957" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="529 1965 529 1978 901 1991 903 1991 981 1978 1345 1989 1347 1989 1349 1989 1393 1976 1566 1976 1590 1987 1592 1987 1594 1987 1715 1976 1748 1987 1750 1987 1752 1987 1754 1987 1756 1987 1774 1974 1787 1985 1789 1985 1791 1985 1793 1985 2192 1972 2194 1957 2187 1924 526 1924 529 1965"/>
                        </Shape>
                        <String CONTENT="Tops (Fig. 197, b) are favorite toys. Their shape is similar to that of"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l24" HPOS="414" VPOS="1978" WIDTH="1769" HEIGHT="63" BASELINE="416 2024 2183 2020" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2024 416 2041 2181 2037 2183 2020 2179 1991 2027 1978 2025 1978 2023 1978 2021 1978 2006 1991 1839 1991 1811 1978 1808 1978 1806 1978 1750 1989 1720 1978 1718 1978 1715 1978 1713 1978 1670 1989 1637 1978 1635 1978 1633 1978 1475 1989 1451 1978 1449 1978 1447 1978 1445 1978 1442 1978 1427 1989 529 1981 526 1981 524 1981 494 1991 440 1981 438 1981 435 1981 433 1981 414 1989 416 2024"/>
                        </Shape>
                        <String CONTENT="the American Eskimo top. Buzzes (Fig. 197, c) are made of various materials, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l25" HPOS="414" VPOS="2052" WIDTH="1773" HEIGHT="48" BASELINE="414 2082 2187 2082" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 2082 414 2100 2187 2100 2187 2082 2187 2052 414 2052 414 2082"/>
                        </Shape>
                        <String CONTENT="ivory, wood, tough skin, and even a piece of dried fish. Much of the ivory"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l26" HPOS="416" VPOS="2113" WIDTH="1774" HEIGHT="45" BASELINE="416 2141 2190 2141" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2141 416 2158 2190 2158 2190 2141 2190 2113 416 2113 416 2141"/>
                        </Shape>
                        <String CONTENT="carving is also used by children for toys. An implement exactly like that"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l27" HPOS="414" VPOS="2171" WIDTH="1776" HEIGHT="48" BASELINE="414 2201 2190 2201" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 2201 414 2219 2190 2219 2190 2201 2190 2171 414 2171 414 2201"/>
                        </Shape>
                        <String CONTENT="represented by Nelson¹ is used by the Chukchee as a kind of top. A specimen"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l28" HPOS="414" VPOS="2230" WIDTH="1778" HEIGHT="49" BASELINE="414 2262 2192 2262" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 2262 414 2279 2192 2279 2192 2262 2190 2230 414 2230 414 2262"/>
                        </Shape>
                        <String CONTENT="of it was obtained on Anadyr Bay (Fig. 197, d). It consists of a horizontal"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l29" HPOS="414" VPOS="2279" WIDTH="1776" HEIGHT="61" BASELINE="414 2323 2190 2323" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="414 2323 414 2340 2190 2340 2190 2323 2190 2290 2164 2279 2161 2279 2159 2279 2053 2290 2016 2279 2014 2279 2012 2279 2010 2279 1975 2290 1549 2279 1546 2279 1423 2290 1395 2279 1393 2279 1391 2279 1319 2290 1289 2279 1287 2279 1284 2279 1282 2279 1248 2290 1189 2279 1187 2279 1185 2279 1148 2290 1040 2279 1038 2279 851 2290 795 2279 793 2279 723 2290 676 2279 674 2279 672 2279 669 2279 630 2290 587 2279 585 2279 583 2279 581 2279 555 2290 492 2279 490 2279 414 2290 414 2323"/>
                        </Shape>
                        <String CONTENT="antler handle with one end broadened and containing a hole, through which"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l30" HPOS="414" VPOS="2340" WIDTH="1778" HEIGHT="69" BASELINE="416 2385 2192 2379" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2385 416 2403 934 2398 999 2409 1001 2409 1003 2409 1005 2409 1020 2396 1170 2396 1189 2407 1191 2407 1193 2407 1196 2407 1510 2396 1596 2407 1598 2407 1601 2407 1629 2394 1650 2405 1653 2405 1655 2405 2190 2392 2192 2379 2187 2349 1044 2340 1042 2340 979 2351 594 2342 591 2342 414 2353 416 2385"/>
                        </Shape>
                        <String CONTENT="passes the rod of the top to be spun. This is kept from slipping out of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l31" HPOS="414" VPOS="2409" WIDTH="1776" HEIGHT="50" BASELINE="416 2444 2190 2440" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2444 416 2459 2187 2455 2190 2440 2185 2409 414 2409 416 2444"/>
                        </Shape>
                        <String CONTENT="handle by a knob at the upper end and a square piece of wood at the bottom."/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l32" HPOS="418" VPOS="2463" WIDTH="1772" HEIGHT="55" BASELINE="420 2500 2190 2496" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="420 2500 420 2518 2187 2513 2190 2496 2183 2463 418 2466 420 2500"/>
                        </Shape>
                        <String CONTENT="The latter forms the body of the top. In spinning the top, a cord is wound"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l33" HPOS="414" VPOS="2518" WIDTH="1778" HEIGHT="60" BASELINE="416 2563 2192 2559" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2563 416 2578 2190 2574 2192 2559 2187 2528 1330 2518 1328 2518 1326 2518 1297 2528 557 2520 555 2520 414 2531 416 2563"/>
                        </Shape>
                        <String CONTENT="around the rod above where it passes through the handle and just under the"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l34" HPOS="414" VPOS="2574" WIDTH="1773" HEIGHT="65" BASELINE="416 2624 2187 2617" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2624 416 2639 2185 2634 2187 2617 2181 2580 1863 2585 1826 2574 1824 2574 1821 2574 1726 2585 1705 2574 1702 2574 1700 2574 1698 2574 1696 2574 1681 2585 1577 2576 1575 2576 1490 2587 1451 2576 1449 2576 1447 2576 1373 2587 1352 2576 1349 2576 1347 2576 1252 2587 1146 2576 1144 2576 814 2589 736 2578 734 2578 732 2578 730 2578 715 2589 687 2578 685 2578 682 2578 680 2578 678 2578 661 2589 598 2578 596 2578 539 2589 526 2578 524 2578 522 2578 427 2578 425 2578 422 2578 420 2578 420 2580 414 2585 416 2624"/>
                        </Shape>
                        <String CONTENT="knob. By holding the top vertically and pulling the string off quickly, it will"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l35" HPOS="414" VPOS="2641" WIDTH="1531" HEIGHT="58" BASELINE="416 2684 1945 2678" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="416 2684 416 2699 1943 2699 1945 2678 1941 2647 472 2641 470 2641 414 2652 416 2684"/>
                        </Shape>
                        <String CONTENT="spin rapidly for a short time with the knob resting on the handle."/>
                    </TextLine>
<TextLine ID="mz_1-355_l36" HPOS="529" VPOS="2706" WIDTH="1658" HEIGHT="52" BASELINE="529 2743 2187 2743" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="529 2743 529 2758 2187 2758 2187 2743 2187 2710 529 2706 529 2743"/>
                        </Shape>
                        <String CONTENT="I obtained from the Kerek three specimens of the same implement (Fig."/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l37" HPOS="420" VPOS="2758" WIDTH="1767" HEIGHT="63" BASELINE="422 2808 2187 2799" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="422 2808 422 2821 2185 2814 2187 2799 2183 2767 1334 2758 1332 2758 1330 2758 1293 2769 940 2760 938 2760 420 2773 422 2808"/>
                        </Shape>
                        <String CONTENT="197, e). They are made of ivory and adorned with various geometrical designs."/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l38" HPOS="418" VPOS="2823" WIDTH="1767" HEIGHT="60" BASELINE="420 2857 2185 2862" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="420 2857 418 2873 433 2883 435 2883 438 2883 440 2883 2183 2879 2185 2862 2183 2829 420 2823 420 2857"/>
                        </Shape>
                        <String CONTENT="The handle is bent slightly downwards. The hole and the knob are serrated,"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l39" HPOS="416" VPOS="2879" WIDTH="1771" HEIGHT="59" BASELINE="418 2922 2187 2918" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="418 2922 418 2938 2185 2933 2187 2918 2183 2890 1326 2879 1323 2879 1250 2890 516 2881 513 2881 416 2892 418 2922"/>
                        </Shape>
                        <String CONTENT="so that in revolving the constant chafing produces a sort of buzzing noise."/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l40" HPOS="418" VPOS="2935" WIDTH="1774" HEIGHT="61" BASELINE="420 2981 2192 2977" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="420 2981 420 2996 2190 2992 2192 2977 2190 2948 2140 2935 2138 2935 2135 2935 2075 2946 1980 2935 1977 2935 1923 2946 1854 2935 1852 2935 1850 2935 1826 2946 1540 2935 1538 2935 1388 2946 1358 2935 1356 2935 1354 2935 1352 2935 1302 2948 1287 2938 1284 2938 1282 2938 1280 2938 1185 2948 1146 2938 1144 2938 1141 2938 1061 2948 975 2938 973 2938 914 2948 821 2938 819 2938 817 2938 782 2948 706 2938 704 2938 702 2938 674 2948 646 2938 643 2938 641 2938 639 2938 602 2948 568 2938 565 2938 563 2938 561 2938 531 2948 479 2938 477 2938 418 2944 420 2981"/>
                        </Shape>
                        <String CONTENT="The knob has four sides, with similar face designs on opposite sides. The"/>
