                    <TextLine ID="mz_1-355_l27" HPOS="435" VPOS="2186" WIDTH="1776" HEIGHT="48" BASELINE="435 2216 2211 2216" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 2216 435 2234 2211 2234 2211 2216 2211 2186 435 2186 435 2216"/>
                        </Shape>
                        <String CONTENT="represented by Nelson¹ is used by the Chukchee as a kind of top. A specimen"/>
