                        <String CONTENT="with the proper harness, snowshoes, bows and arrows. Grasping in each hand"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l21" HPOS="435" VPOS="1816" WIDTH="1776" HEIGHT="61" BASELINE="437 1859 2211 1855" TAGREFS="TYPE_6">
