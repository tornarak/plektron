                    <TextLine ID="mz_1-355_l8" HPOS="537" VPOS="1045" WIDTH="1674" HEIGHT="59" BASELINE="539 1078 2211 1082" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="539 1078 537 1091 563 1104 565 1104 567 1104 2208 1095 2211 1082 2208 1050 539 1045 539 1078"/>
                        </Shape>
                        <String CONTENT="Gambling-games are little known among the Chukchee. I was told that"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l9" HPOS="430" VPOS="1097" WIDTH="1778" HEIGHT="61" BASELINE="433 1143 2208 1138" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="433 1143 433 1158 2206 1153 2208 1138 2204 1110 1687 1097 1684 1097 1682 1097 1648 1108 1550 1097 1548 1097 1546 1097 1507 1108 1388 1097 1386 1097 1271 1110 723 1099 721 1099 718 1099 693 1110 630 1099 628 1099 625 1099 623 1099 608 1112 430 1112 433 1143"/>
                        </Shape>
                        <String CONTENT="among the Maritime Chukchee on the Arctic shore there is a simple game"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l10" HPOS="435" VPOS="1171" WIDTH="1776" HEIGHT="54" BASELINE="435 1201 2211 1201" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 1201 435 1225 2211 1216 2211 1201 2211 1171 435 1171 435 1201"/>
                        </Shape>
                        <String CONTENT="played for stakes, which consists in throwing a small piece of gristle against"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l11" HPOS="433" VPOS="1216" WIDTH="1775" HEIGHT="59" BASELINE="435 1262 2208 1257" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="435 1262 435 1275 2206 1270 2208 1257 2206 1229 2156 1216 2154 1216 2152 1216 2150 1216 2105 1227 1903 1216 1901 1216 1829 1227 1801 1216 1799 1216 1797 1216 1723 1227 1700 1216 1697 1216 1695 1216 1693 1216 1648 1227 1613 1216 1611 1216 1609 1216 1606 1216 1576 1227 1479 1216 1476 1216 1474 1216 1472 1216 1459 1227 1433 1216 1431 1216 1429 1216 1342 1227 1325 1216 1323 1216 1321 1216 1318 1216 1316 1216 1269 1229 1238 1218 1236 1218 1234 1218 1156 1229 994 1218 991 1218 989 1218 987 1218 968 1231 725 1231 654 1218 651 1218 649 1218 615 1229 502 1218 500 1218 433 1231 435 1262"/>
                        </Shape>
                        <String CONTENT="a large flat stone so that it will rebound high in the air. The one who"/>
                    </TextLine>

                    <TextLine ID="mz_1-355_l12" HPOS="433" VPOS="1277" WIDTH="1773" HEIGHT="63" BASELINE="435 1322 2206 1318" TAGREFS="TYPE_6">
