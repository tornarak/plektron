                        </Shape>
                        <String CONTENT="coast, there are only five underground houses still inhabited, — one in Uweˊlen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l5" HPOS="729" VPOS="868" WIDTH="1772" HEIGHT="62" BASELINE="731 915 2501 911" TAGREFS="TYPE_6">
                        <Shape>
