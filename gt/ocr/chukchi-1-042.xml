                    <TextLine ID="mz_1-042_l41" HPOS="817" VPOS="2630" WIDTH="1663" HEIGHT="76" BASELINE="819 2676 2480 2686" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2445 2641 2421 2650 2408 2639 2406 2639 2404 2639 2400 2639 2198 2639 2196 2639 2194 2639 2155 2650 2097 2637 2094 2637 1841 2647 1756 2634 1754 2634 1512 2645 1468 2632 1466 2632 1464 2632 1462 2632 1436 2643 1332 2632 1330 2632 1235 2643 1211 2632 1209 2632 1206 2632 1204 2632 1165 2643 1152 2632 1152 2630 1150 2630 1148 2630 1146 2630 1144 2630 1118 2641 1033 2630 1031 2630 1029 2630 1001 2643 866 2643 851 2630 849 2630 847 2630 845 2630 843 2630 836 2632 819 2643 819 2676 817 2691 2475 2706 2480 2686 2480 2650 2462 2641 2445 2641"/>
                        </Shape>
                        <String CONTENT="In regard to the legend cited by Wrangell, about the Eskimo chief Krächoj,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l42" HPOS="713" VPOS="2706" WIDTH="1769" HEIGHT="58" BASELINE="715 2736 2482 2743" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="715 2736 713 2749 990 2762 992 2762 1235 2754 1306 2764 1308 2764 2480 2758 2482 2743 2480 2712 715 2706 715 2736"/>
                        </Shape>
                        <String CONTENT="who is said to have emigrated across the sea to certain islands, I may say"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l43" HPOS="713" VPOS="2764" WIDTH="1771" HEIGHT="54" BASELINE="715 2795 2484 2803" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="715 2795 713 2810 2480 2818 2484 2803 2482 2769 715 2764 715 2795"/>
                        </Shape>
                        <String CONTENT="that I too heard it among the Chukchee; but it is mythical in character, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l44" HPOS="713" VPOS="2821" WIDTH="1769" HEIGHT="65" BASELINE="715 2857 2482 2866" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="715 2857 713 2870 2478 2886 2482 2866 2480 2834 715 2821 715 2857"/>
                        </Shape>
                        <String CONTENT="is connected with other tales about vanished tribes, similar to corresponding"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l45" HPOS="713" VPOS="2875" WIDTH="1771" HEIGHT="63" BASELINE="715 2916 2484 2922" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="715 2916 713 2931 2480 2938 2484 2922 2482 2892 2233 2879 2231 2879 2229 2879 2226 2879 2211 2890 2187 2879 2185 2879 2183 2879 2181 2879 2153 2890 2107 2879 2105 2879 2103 2879 2006 2890 1984 2879 1982 2879 1980 2879 1915 2890 1830 2877 1828 2877 1826 2877 1795 2888 1713 2877 1711 2877 1709 2877 1707 2877 1687 2890 1510 2890 1486 2877 1484 2877 1481 2877 1479 2877 1477 2877 1462 2890 1330 2890 1308 2875 1306 2875 1304 2875 1302 2875 1300 2875 1278 2886 1256 2875 1254 2875 1252 2875 1250 2875 1213 2886 1100 2875 1098 2875 715 2883 715 2916"/>
                        </Shape>
                        <String CONTENT="tales of the Eskimo. It is true, however, that the northern Chukchee believe"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l46" HPOS="713" VPOS="2944" WIDTH="1769" HEIGHT="59" BASELINE="715 2977 2482 2985" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="715 2977 713 2990 2478 3003 2482 2985 2480 2953 715 2944 715 2977"/>
                        </Shape>
                        <String CONTENT="that in some northern land, not very far distant from the continent of Asia,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l47" HPOS="710" VPOS="3005" WIDTH="1774" HEIGHT="62" BASELINE="713 3035 2484 3044" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="713 3035 710 3048 778 3061 780 3061 1141 3052 1172 3063 1174 3063 1176 3063 1928 3057 2040 3067 2042 3067 2482 3057 2484 3044 2482 3013 713 3005 713 3035"/>
                        </Shape>
                        <String CONTENT="there lives a race of men sprung from these ancient emigrants. This land is,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l48" HPOS="710" VPOS="3063" WIDTH="1772" HEIGHT="56" BASELINE="713 3093 2482 3104" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="713 3093 710 3109 2478 3119 2482 3104 2480 3074 713 3063 713 3093"/>
                        </Shape>
                        <String CONTENT="said to have been seen by the crew of a boat which drifted out into the open"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l49" HPOS="710" VPOS="3122" WIDTH="1772" HEIGHT="62" BASELINE="713 3152 2482 3165" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="713 3152 710 3171 721 3180 723 3180 726 3180 728 3180 1274 3174 1304 3184 1306 3184 1308 3184 2480 3180 2482 3165 2480 3135 713 3122 713 3152"/>
                        </Shape>
                        <String CONTENT="sea. It corresponds to Wrangell’s Land, and I have heard from people from"/>
                    </TextLine>
