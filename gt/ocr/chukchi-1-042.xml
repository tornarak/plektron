                        </Shape>
                        <String CONTENT="and four in Nɵˊɵkan. It is easy, however, to understand that to Wrangell,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l6" HPOS="734" VPOS="941" WIDTH="1769" HEIGHT="48" BASELINE="734 969 2503 969" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="734 969 734 989 2503 989 2503 969 2503 941 734 941 734 969"/>
                        </Shape>
                        <String CONTENT="who approached the northern shore from the Kolyma side, the tents of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l7" HPOS="729" VPOS="998" WIDTH="1774" HEIGHT="49" BASELINE="731 1030 2503 1026" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="731 1030 731 1047 2501 1043 2503 1026 2499 998 729 998 731 1030"/>
                        </Shape>
                        <String CONTENT="Reindeer people appeared to be typical Chukchee dwellings. The difference,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l8" HPOS="731" VPOS="1047" WIDTH="1772" HEIGHT="61" BASELINE="734 1091 2503 1086" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="734 1091 734 1108 2501 1104 2503 1086 2499 1058 1617 1047 1615 1047 1513 1058 866 1050 864 1050 731 1060 734 1091"/>
                        </Shape>
                        <String CONTENT="was the more striking, since around Kuluˊči Bay the inhabitants turned from"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l9" HPOS="729" VPOS="1108" WIDTH="1774" HEIGHT="61" BASELINE="731 1151 2503 1147" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="731 1151 731 1169 2501 1164 2503 1147 2499 1119 1650 1108 1648 1108 1645 1108 1611 1119 822 1110 820 1110 729 1121 731 1151"/>
                        </Shape>
                        <String CONTENT="maritime pursuits to reindeer-breeding. I know of some, whom I saw on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l10" HPOS="731" VPOS="1182" WIDTH="1774" HEIGHT="45" BASELINE="731 1210 2505 1210" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="731 1210 731 1227 2505 1227 2505 1210 2494 1182 731 1182 731 1210"/>
                        </Shape>
