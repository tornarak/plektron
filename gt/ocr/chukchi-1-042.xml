                    <TextLine ID="mz_1-042_l41" HPOS="838" VPOS="2645" WIDTH="1663" HEIGHT="76" BASELINE="840 2691 2501 2701" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2466 2656 2442 2665 2429 2654 2427 2654 2425 2654 2421 2654 2219 2654 2217 2654 2215 2654 2176 2665 2118 2652 2115 2652 1862 2662 1777 2649 1775 2649 1533 2660 1489 2647 1487 2647 1485 2647 1483 2647 1457 2658 1353 2647 1351 2647 1256 2658 1232 2647 1230 2647 1227 2647 1225 2647 1186 2658 1173 2647 1173 2645 1171 2645 1169 2645 1167 2645 1165 2645 1139 2656 1054 2645 1052 2645 1050 2645 1022 2658 887 2658 872 2645 870 2645 868 2645 866 2645 864 2645 857 2647 840 2658 840 2691 838 2706 2496 2721 2501 2701 2501 2665 2483 2656 2466 2656"/>
                        </Shape>
                        <String CONTENT="In regard to the legend cited by Wrangell, about the Eskimo chief Krächoj,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l42" HPOS="734" VPOS="2721" WIDTH="1769" HEIGHT="58" BASELINE="736 2751 2503 2758" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="736 2751 734 2764 1011 2777 1013 2777 1256 2769 1327 2779 1329 2779 2501 2773 2503 2758 2501 2727 736 2721 736 2751"/>
                        </Shape>
                        <String CONTENT="who is said to have emigrated across the sea to certain islands, I may say"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l43" HPOS="734" VPOS="2779" WIDTH="1771" HEIGHT="54" BASELINE="736 2810 2505 2818" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="736 2810 734 2825 2501 2833 2505 2818 2503 2784 736 2779 736 2810"/>
                        </Shape>
                        <String CONTENT="that I too heard it among the Chukchee; but it is mythical in character, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l44" HPOS="734" VPOS="2836" WIDTH="1769" HEIGHT="65" BASELINE="736 2872 2503 2881" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="736 2872 734 2885 2499 2901 2503 2881 2501 2849 736 2836 736 2872"/>
                        </Shape>
                        <String CONTENT="is connected with other tales about vanished tribes, similar to corresponding"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l45" HPOS="734" VPOS="2890" WIDTH="1771" HEIGHT="63" BASELINE="736 2931 2505 2937" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="736 2931 734 2946 2501 2953 2505 2937 2503 2907 2254 2894 2252 2894 2250 2894 2247 2894 2232 2905 2208 2894 2206 2894 2204 2894 2202 2894 2174 2905 2128 2894 2126 2894 2124 2894 2027 2905 2005 2894 2003 2894 2001 2894 1936 2905 1851 2892 1849 2892 1847 2892 1816 2903 1734 2892 1732 2892 1730 2892 1728 2892 1708 2905 1531 2905 1507 2892 1505 2892 1502 2892 1500 2892 1498 2892 1483 2905 1351 2905 1329 2890 1327 2890 1325 2890 1323 2890 1321 2890 1299 2901 1277 2890 1275 2890 1273 2890 1271 2890 1234 2901 1121 2890 1119 2890 736 2898 736 2931"/>
                        </Shape>
                        <String CONTENT="tales of the Eskimo. It is true, however, that the northern Chukchee believe"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l46" HPOS="734" VPOS="2959" WIDTH="1769" HEIGHT="59" BASELINE="736 2992 2503 3000" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="736 2992 734 3005 2499 3018 2503 3000 2501 2968 736 2959 736 2992"/>
                        </Shape>
                        <String CONTENT="that in some northern land, not very far distant from the continent of Asia,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l47" HPOS="731" VPOS="3020" WIDTH="1774" HEIGHT="62" BASELINE="734 3050 2505 3059" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="734 3050 731 3063 799 3076 801 3076 1162 3067 1193 3078 1195 3078 1197 3078 1949 3072 2061 3082 2063 3082 2503 3072 2505 3059 2503 3028 734 3020 734 3050"/>
                        </Shape>
                        <String CONTENT="there lives a race of men sprung from these ancient emigrants. This land is,"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l48" HPOS="731" VPOS="3078" WIDTH="1772" HEIGHT="56" BASELINE="734 3108 2503 3119" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="734 3108 731 3124 2499 3134 2503 3119 2501 3089 734 3078 734 3108"/>
                        </Shape>
                        <String CONTENT="said to have been seen by the crew of a boat which drifted out into the open"/>
                    </TextLine>

                    <TextLine ID="mz_1-042_l49" HPOS="731" VPOS="3137" WIDTH="1772" HEIGHT="62" BASELINE="734 3167 2503 3180" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="734 3167 731 3186 742 3195 744 3195 747 3195 749 3195 1295 3189 1325 3199 1327 3199 1329 3199 2501 3195 2503 3180 2501 3150 734 3137 734 3167"/>
                        </Shape>
                        <String CONTENT="sea. It corresponds to Wrangell’s Land, and I have heard from people from"/>
                    </TextLine>
