                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l2" HPOS="641" VPOS="628" WIDTH="89" HEIGHT="54" BASELINE="646 671 730 666" TAGREFS="TYPE_4">
