<TextLine ID="mz_1-224_l3" HPOS="633" VPOS="742" WIDTH="1771" HEIGHT="50" BASELINE="633 773 2404 773" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2387 744 2365 744 2343 742 2322 742 633 742 633 773 633 792 2404 792 2404 773 2404 744 2387 744"/>
                        </Shape>
                        <String CONTENT="who have small children, cease to move about, and settle down for three or"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l4" HPOS="1947" VPOS="801" WIDTH="459" HEIGHT="45" BASELINE="1947 831 2406 831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1947 831 1947 846 2406 846 2406 831 2406 801 1947 801 1947 831"/>
                        </Shape>
                        <String CONTENT="four months within"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l5" HPOS="1945" VPOS="848" WIDTH="459" HEIGHT="65" BASELINE="1947 889 2404 894" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1947 889 1945 905 1958 913 1960 913 1962 913 1964 913 2402 907 2404 894 2402 863 2339 851 2337 851 2270 861 2257 851 2255 851 2252 851 2250 851 2196 861 2099 848 2097 848 1947 857 1947 889"/>
                        </Shape>
                        <String CONTENT="the forest border,"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l6" HPOS="1947" VPOS="924" WIDTH="457" HEIGHT="46" BASELINE="1947 952 2404 952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1947 952 1947 970 2404 970 2404 952 2404 924 1947 924 1947 952"/>
                        </Shape>
                        <String CONTENT="and construct a spe-"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l7" HPOS="1947" VPOS="970" WIDTH="455" HEIGHT="58" BASELINE="1949 1013 2402 1009" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1949 1013 1949 1028 2402 1028 2402 1009 2398 978 1980 970 1977 970 1975 970 1947 980 1949 1013"/>
                        </Shape>
                        <String CONTENT="cial winter dwelling"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l8" HPOS="1947" VPOS="1026" WIDTH="453" HEIGHT="73" BASELINE="1949 1076 2400 1071" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1949 1076 1949 1089 1973 1099 1975 1099 1977 1099 2183 1086 2213 1097 2216 1097 2218 1097 2220 1097 2263 1086 2307 1097 2309 1097 2311 1097 2313 1097 2315 1097 2330 1086 2374 1097 2376 1097 2378 1097 2380 1097 2382 1097 2400 1084 2400 1071 2395 1041 2235 1026 2233 1026 2231 1026 2168 1041 2058 1028 2055 1028 2053 1028 2051 1028 2051 1030 2038 1041 1964 1028 1962 1028 1960 1028 1958 1028 1958 1030 1947 1039 1949 1076"/>
                        </Shape>
                        <String CONTENT="(see Plate V, Fig. 2)."/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l9" HPOS="1949" VPOS="1086" WIDTH="455" HEIGHT="63" BASELINE="1951 1132 2404 1128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1951 1132 1951 1149 2402 1145 2404 1128 2400 1099 2268 1086 2265 1086 2263 1086 2237 1099 1949 1099 1951 1132"/>
                        </Shape>
                        <String CONTENT="This consists of three"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l10" HPOS="1947" VPOS="1151" WIDTH="457" HEIGHT="61" BASELINE="1949 1195 2404 1190" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1949 1195 1949 1212 2402 1206 2404 1190 2400 1160 2034 1151 2032 1151 1947 1162 1949 1195"/>
                        </Shape>
                        <String CONTENT="parts. The entrance-"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l11" HPOS="1945" VPOS="1210" WIDTH="459" HEIGHT="67" BASELINE="1947 1253 2404 1249" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1947 1253 1947 1266 2103 1266 2138 1277 2140 1277 2142 1277 2348 1264 2380 1275 2382 1275 2385 1275 2387 1275 2389 1275 2404 1262 2404 1249 2400 1219 2170 1210 2168 1210 1945 1221 1947 1253"/>
                        </Shape>
                        <String CONTENT="room (tɪˊʟɪ-ran) is"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l12" HPOS="1945" VPOS="1271" WIDTH="459" HEIGHT="64" BASELINE="1947 1312 2404 1307" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1947 1312 1947 1322 2099 1335 2101 1335 2103 1335 2146 1322 2166 1335 2168 1335 2170 1335 2172 1335 2174 1335 2207 1320 2244 1333 2246 1333 2248 1333 2250 1333 2281 1320 2380 1333 2382 1333 2385 1333 2387 1333 2404 1318 2404 1307 2400 1279 1958 1271 1956 1271 1954 1271 1951 1271 1951 1273 1945 1277 1947 1312"/>
                        </Shape>
                        <String CONTENT="formed of a few"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l13" HPOS="633" VPOS="1340" WIDTH="1773" HEIGHT="47" BASELINE="633 1370 2406 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1370 633 1387 2406 1387 2406 1370 2406 1340 633 1340 633 1370"/>
                        </Shape>
                        <String CONTENT="stakes tied together, and loosely covered with an old tent-cover. It serves"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l14" HPOS="630" VPOS="1385" WIDTH="1774" HEIGHT="70" BASELINE="633 1431 2404 1426" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1431 633 1444 986 1455 988 1455 990 1455 992 1455 1009 1444 1505 1452 1507 1452 1510 1452 1555 1442 1793 1442 1988 1452 1990 1452 1993 1452 2034 1442 2073 1452 2075 1452 2077 1452 2079 1452 2081 1452 2094 1442 2107 1452 2109 1452 2112 1452 2114 1455 2385 1455 2385 1452 2387 1452 2389 1452 2404 1439 2404 1426 2400 1398 2270 1398 2252 1385 2250 1385 2248 1385 2246 1385 2170 1396 2148 1385 2146 1385 2144 1385 2081 1396 2055 1385 2053 1385 2051 1385 2049 1385 2047 1385 2029 1398 1772 1398 1720 1385 1718 1385 1635 1396 1583 1385 1581 1385 1494 1398 1421 1387 1419 1387 1187 1398 1135 1387 1133 1387 1131 1387 1109 1398 1063 1387 1061 1387 1059 1387 994 1398 888 1387 886 1387 884 1387 858 1398 825 1387 823 1387 821 1387 819 1387 786 1398 659 1387 656 1387 654 1387 630 1398 633 1431"/>
                        </Shape>
                        <String CONTENT="chiefly to keep off the wind and snow from the entrance. It often has no"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l15" HPOS="635" VPOS="1461" WIDTH="1767" HEIGHT="45" BASELINE="635 1489 2402 1489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1489 635 1506 2400 1506 2402 1489 2400 1461 635 1461 635 1489"/>
                        </Shape>
                        <String CONTENT="door; and in order to get in, one has to crawl in under the tent-cover. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l16" HPOS="633" VPOS="1515" WIDTH="1771" HEIGHT="50" BASELINE="635 1548 2404 1552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1548 633 1561 2400 1565 2404 1552 2402 1515 635 1515 635 1548"/>
                        </Shape>
                        <String CONTENT="main tent is constructed in the ordinary way, only, for the most part, an old"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l17" HPOS="633" VPOS="1574" WIDTH="1769" HEIGHT="56" BASELINE="635 1606 2402 1613" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1606 633 1621 646 1630 648 1630 650 1630 652 1630 2400 1623 2402 1613 2400 1580 635 1574 635 1606"/>
                        </Shape>
                        <String CONTENT="cover is used, because it is likely to be damaged by the hearth-fire within."/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l18" HPOS="635" VPOS="1630" WIDTH="1771" HEIGHT="65" BASELINE="637 1667 2406 1673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="637 1667 635 1680 793 1693 795 1693 1193 1684 1235 1695 1237 1695 1239 1695 2404 1686 2406 1673 2404 1641 637 1630 637 1667"/>
                        </Shape>
                        <String CONTENT="This fire is kept up all day long; and on this account, as well as on account"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l19" HPOS="633" VPOS="1695" WIDTH="1769" HEIGHT="58" BASELINE="635 1725 2402 1732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1725 633 1740 648 1751 650 1751 652 1751 654 1753 2400 1753 2402 1732 2400 1701 635 1695 635 1725"/>
                        </Shape>
                        <String CONTENT="of the well-sheltered entrance, the temperature of the tent is not very low,"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l20" HPOS="630" VPOS="1749" WIDTH="1768" HEIGHT="65" BASELINE="633 1786 2398 1790" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1786 630 1801 646 1812 648 1812 650 1812 652 1812 1319 1803 1523 1814 1525 1814 2395 1803 2398 1790 2393 1749 633 1753 633 1786"/>
                        </Shape>
                        <String CONTENT="usually 10°-12° above zero Fahrenheit, while outside it may range from 50°"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l21" HPOS="630" VPOS="1810" WIDTH="1774" HEIGHT="67" BASELINE="633 1844 2404 1853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1844 630 1862 643 1870 646 1870 648 1870 650 1870 1492 1864 1518 1875 1520 1875 1523 1875 1884 1866 1960 1877 1962 1877 2402 1866 2404 1853 2402 1823 1993 1823 1962 1810 1960 1810 1958 1810 633 1812 633 1844"/>
                        </Shape>
                        <String CONTENT="to 60° below. The sledges are piled up near the tent, high enough not to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l22" HPOS="630" VPOS="1875" WIDTH="1776" HEIGHT="58" BASELINE="633 1905 2406 1911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1905 630 1920 646 1931 648 1931 650 1931 652 1931 1193 1922 1226 1933 1228 1933 1230 1933 2404 1924 2406 1911 2404 1881 633 1875 633 1905"/>
                        </Shape>
                        <String CONTENT="covered by the drifting snow, and after this are tied with thongs to prevent"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l23" HPOS="630" VPOS="1933" WIDTH="1776" HEIGHT="58" BASELINE="633 1965 2406 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1965 630 1981 646 1991 648 1991 650 1991 652 1991 2404 1985 2406 1972 2404 1939 633 1933 633 1965"/>
                        </Shape>
                        <String CONTENT="the wind from throwing down the pile. Only a few driving-sledges are left"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l24" HPOS="633" VPOS="1998" WIDTH="420" HEIGHT="45" BASELINE="633 2028 1053 2028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2028 633 2043 1053 2043 1053 2028 1053 1998 633 1998 633 2028"/>
                        </Shape>
                        <String CONTENT="free for daily use."/>
                    </TextLine>
<TextLine ID="mz_1-224_l25" HPOS="739" VPOS="2050" WIDTH="1667" HEIGHT="67" BASELINE="741 2087 2406 2093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 2087 739 2098 825 2113 827 2113 830 2113 832 2113 847 2102 916 2113 918 2113 1263 2102 1319 2113 1321 2113 1821 2104 1854 2115 1856 2115 1858 2115 1975 2106 2107 2117 2109 2117 2404 2104 2406 2093 2404 2059 741 2050 741 2087"/>
                        </Shape>
                        <String CONTENT="The sleeping-room is much larger than that of the movable tent, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l26" HPOS="630" VPOS="2104" WIDTH="1774" HEIGHT="61" BASELINE="633 2147 2404 2152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2147 630 2160 2400 2165 2404 2152 2402 2119 2350 2106 2348 2106 2261 2117 2220 2106 2218 2106 2216 2106 2213 2106 2190 2117 2166 2106 2164 2106 2161 2106 2159 2106 2135 2117 2101 2106 2099 2106 2097 2106 2094 2106 2058 2119 1949 2119 1934 2106 1932 2106 1930 2106 1928 2106 1925 2106 1904 2117 1882 2106 1880 2106 1878 2106 1876 2106 1854 2117 1832 2106 1830 2106 1828 2106 1774 2117 1570 2106 1568 2106 1566 2106 1520 2117 1503 2104 1501 2104 1499 2104 1497 2104 1494 2104 1471 2115 1449 2104 1447 2104 1445 2104 1442 2104 1408 2115 1326 2104 1323 2104 1321 2104 1291 2115 1139 2104 1137 2104 1135 2104 1107 2115 1094 2104 1092 2104 1089 2104 1087 2104 1085 2104 1042 2115 1014 2104 1012 2104 1009 2104 1007 2104 1005 2104 990 2115 953 2104 951 2104 949 2104 947 2104 905 2115 890 2104 888 2104 886 2104 884 2104 882 2104 856 2115 633 2111 633 2147"/>
                        </Shape>
                        <String CONTENT="bears marked similarity to that of the Maritime Chukchee, only it is dirtier"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l27" HPOS="630" VPOS="2175" WIDTH="1770" HEIGHT="50" BASELINE="633 2208 2400 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2208 630 2221 2395 2225 2400 2212 2398 2178 633 2175 633 2208"/>
                        </Shape>
                        <String CONTENT="and is made more carelessly. The usual dimensions are 5 feet in height, 8"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l28" HPOS="630" VPOS="2236" WIDTH="1774" HEIGHT="61" BASELINE="633 2266 2404 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2266 630 2282 641 2290 643 2290 646 2290 648 2290 819 2282 884 2292 886 2292 1488 2282 1520 2295 1523 2295 1525 2295 1655 2284 1769 2284 1787 2295 1789 2295 1791 2295 1793 2297 1951 2297 1951 2295 1954 2295 1956 2295 1971 2284 2313 2295 2315 2295 2317 2295 2343 2284 2378 2295 2380 2295 2382 2295 2385 2295 2387 2295 2402 2282 2404 2271 2402 2240 633 2236 633 2266"/>
                        </Shape>
                        <String CONTENT="feet in breadth, and 14-16 feet in length. It occupies the whole rear of"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l29" HPOS="630" VPOS="2286" WIDTH="1772" HEIGHT="67" BASELINE="633 2327 2402 2331" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2327 630 2340 817 2353 819 2353 2400 2344 2402 2331 2402 2301 2356 2288 2354 2288 2352 2288 2287 2299 2168 2288 2166 2288 2049 2299 1949 2288 1947 2288 1945 2288 1919 2301 1819 2301 1804 2288 1802 2288 1800 2288 1798 2288 1795 2288 1765 2299 1713 2288 1711 2288 1655 2299 1596 2288 1594 2288 1592 2288 1557 2299 1341 2299 1326 2286 1323 2286 1321 2286 1319 2286 1267 2297 1111 2286 1109 2286 1107 2286 1066 2297 960 2286 957 2286 955 2286 916 2297 875 2286 873 2286 871 2286 869 2286 836 2297 676 2286 674 2286 633 2295 633 2327"/>
                        </Shape>
                        <String CONTENT="the tent, leaving only a small space on the sides for storing provisions. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l30" HPOS="633" VPOS="2344" WIDTH="1769" HEIGHT="61" BASELINE="635 2385 2402 2390" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 2385 633 2401 2398 2405 2402 2390 2402 2360 2376 2347 2374 2347 2372 2347 2369 2347 2339 2357 2138 2347 2135 2347 2133 2347 2097 2357 2071 2347 2068 2347 2066 2347 2064 2347 2040 2357 2016 2347 2014 2347 2012 2347 1962 2357 1941 2347 1938 2347 1936 2347 1934 2347 1895 2357 1824 2347 1821 2347 1767 2357 1739 2347 1737 2347 1735 2347 1733 2347 1694 2357 1661 2347 1659 2347 1657 2347 1655 2347 1609 2357 1553 2347 1551 2347 1549 2347 1525 2357 1464 2344 1462 2344 1403 2355 1339 2344 1336 2344 1276 2355 1191 2344 1189 2344 1102 2355 1046 2344 1044 2344 1042 2344 1014 2355 910 2344 908 2344 905 2344 882 2357 730 2357 706 2344 704 2344 702 2344 635 2353 635 2385"/>
                        </Shape>
                        <String CONTENT="skin cover is made of fawn-skins taken late in the fall, the hair side out. It"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l31" HPOS="633" VPOS="2411" WIDTH="1771" HEIGHT="61" BASELINE="635 2444 2404 2450" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 2444 633 2457 756 2470 758 2470 1222 2461 1239 2472 1241 2472 1243 2472 1245 2472 2402 2463 2404 2450 2402 2420 635 2411 635 2444"/>
                        </Shape>
                        <String CONTENT="is drawn tightly across a rectangular frame made of flat, narrow sticks. On"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l32" HPOS="633" VPOS="2472" WIDTH="1771" HEIGHT="54" BASELINE="635 2502 2404 2511" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 2502 633 2518 2400 2526 2404 2511 2402 2481 635 2472 635 2502"/>
                        </Shape>
                        <String CONTENT="the outside it is covered with a thick layer of dried grass tied up in sheaves"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l33" HPOS="630" VPOS="2533" WIDTH="1774" HEIGHT="58" BASELINE="633 2563 2404 2572" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2563 630 2576 769 2589 771 2589 1053 2580 1074 2591 1076 2591 1079 2591 2402 2585 2404 2572 2402 2541 633 2533 633 2563"/>
                        </Shape>
                        <String CONTENT="and fastened side by side. The frame is so strong that a man can walk on"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l34" HPOS="630" VPOS="2593" WIDTH="1772" HEIGHT="61" BASELINE="633 2624 2402 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2624 630 2637 669 2650 672 2650 674 2650 1728 2643 1811 2654 1813 2654 2400 2643 2402 2630 2400 2600 633 2593 633 2624"/>
                        </Shape>
                        <String CONTENT="top of it. The whole structure is covered with a piece of tent-covering, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l35" HPOS="630" VPOS="2643" WIDTH="1774" HEIGHT="61" BASELINE="633 2684 2404 2691" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2684 630 2697 2400 2704 2404 2691 2404 2660 2354 2647 2352 2647 2350 2647 2101 2658 2045 2647 2042 2647 2040 2647 2001 2658 1973 2647 1971 2647 1969 2647 1815 2658 1776 2645 1774 2645 1772 2645 1769 2645 1741 2656 1386 2645 1384 2645 1382 2645 1380 2645 1365 2656 1339 2645 1336 2645 1334 2645 1332 2645 1304 2656 1274 2645 1271 2645 1269 2645 1267 2645 1265 2645 1250 2656 1224 2643 1222 2643 1219 2643 633 2652 633 2684"/>
                        </Shape>
                        <String CONTENT="the ends carefully tucked in below. The floor is covered with skins of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l36" HPOS="630" VPOS="2715" WIDTH="1774" HEIGHT="49" BASELINE="633 2745 2404 2751" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2745 630 2758 2400 2764 2404 2751 2402 2721 633 2715 633 2745"/>
                        </Shape>
                        <String CONTENT="thong-seal or of the walrus, and over them some scraps of reindeer-skin are"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l37" HPOS="633" VPOS="2771" WIDTH="1767" HEIGHT="58" BASELINE="633 2803 2400 2814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 2803 633 2829 2398 2829 2400 2814 2398 2782 633 2771 633 2803"/>
                        </Shape>
                        <String CONTENT="put for seats, while the bedding is rolled up and taken away during the day."/>
                    </TextLine>
<TextLine ID="mz_1-224_l38" HPOS="739" VPOS="2834" WIDTH="1663" HEIGHT="60" BASELINE="741 2864 2402 2870" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 2864 739 2877 1492 2892 1494 2892 1772 2883 1850 2894 1852 2894 2400 2883 2402 2870 2400 2840 741 2834 741 2864"/>
                        </Shape>
                        <String CONTENT="One or two lamps burn constantly within, to keep the place dry. There"/>
                    </TextLine>

                    <TextLine ID="mz_1-224_l39" HPOS="628" VPOS="2892" WIDTH="1774" HEIGHT="54" BASELINE="630 2925 2402 2933" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 2925 628 2938 2398 2946 2402 2933 2400 2901 630 2892 630 2925"/>
                        </Shape>
                        <String CONTENT="is no kind of ventilation whatsoever: therefore the sleeping-room, although"/>
                    </TextLine>

