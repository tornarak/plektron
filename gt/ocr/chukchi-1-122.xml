                    <TextLine ID="mz_1-122_l1" HPOS="1183" VPOS="610" WIDTH="617" HEIGHT="54" BASELINE="1185 645 1800 649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1791 623 1778 612 1200 610 1185 617 1185 645 1183 660 1795 664 1800 649 1798 634 1791 623"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l2" HPOS="607" VPOS="621" WIDTH="78" HEIGHT="58" BASELINE="611 658 685 653" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="611 658 611 671 630 679 633 679 635 679 637 679 685 664 685 653 678 621 607 623 611 658"/>
                        </Shape>
                        <String CONTENT="94"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-122_r2" HPOS="604" VPOS="702" WIDTH="1778" HEIGHT="1456" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="604 702 2382 702 2382 2158 604 2158"/>
                    </Shape>
                    <TextLine ID="mz_1-122_l3" HPOS="607" VPOS="725" WIDTH="1775" HEIGHT="48" BASELINE="607 755 2382 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 755 607 773 2382 773 2382 755 2382 725 607 725 607 755"/>
                        </Shape>
                        <String CONTENT="and watched in all the weaker parts by old women and children. The herds-"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l4" HPOS="607" VPOS="786" WIDTH="1778" HEIGHT="49" BASELINE="607 816 2385 816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 816 607 835 2385 835 2385 816 2385 786 607 786 607 816"/>
                        </Shape>
                        <String CONTENT="men bring the herd, and first of all try to catch with their lassos, or by means"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l5" HPOS="604" VPOS="842" WIDTH="1778" HEIGHT="50" BASELINE="607 872 2382 876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 872 604 887 2378 892 2382 876 2380 846 607 842 607 872"/>
                        </Shape>
                        <String CONTENT="of the urine-tube, about ten harness-reindeer, which are placed at the entrance"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l6" HPOS="604" VPOS="902" WIDTH="1776" HEIGHT="59" BASELINE="607 933 2380 937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 933 604 948 620 959 622 959 624 959 626 959 1347 950 1501 961 1503 961 2378 950 2380 937 2378 907 607 902 607 933"/>
                        </Shape>
                        <String CONTENT="of the corral; otherwise no free reindeer could be induced to enter it. Then"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l7" HPOS="604" VPOS="954" WIDTH="1778" HEIGHT="59" BASELINE="604 998 2382 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="604 998 604 1013 2382 1013 2382 998 2382 967 1865 954 1863 954 1806 965 1776 954 1774 954 1772 954 1616 965 1590 954 1588 954 1585 954 1583 954 1536 965 1403 954 1401 954 1399 954 1367 965 1317 954 1315 954 1313 954 1289 965 1263 954 1261 954 1258 954 1161 965 1126 954 1124 954 1122 954 1120 954 1100 965 1087 954 1085 954 1083 954 988 954 986 954 983 954 951 965 899 954 897 954 895 954 849 965 754 954 752 954 749 954 713 965 630 954 628 954 626 954 604 965 604 998"/>
                        </Shape>
                        <String CONTENT="they drive the herd to and fro before the corral, picking out one by one"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l8" HPOS="607" VPOS="1026" WIDTH="1778" HEIGHT="47" BASELINE="607 1054 2385 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1054 607 1073 2385 1073 2385 1054 2385 1026 607 1026 607 1054"/>
                        </Shape>
                        <String CONTENT="other harness-animals and driving them into the corral. The wildest ones are"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l9" HPOS="604" VPOS="1076" WIDTH="1776" HEIGHT="56" BASELINE="607 1117 2380 1112" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1117 607 1132 2378 1128 2380 1112 2376 1084 710 1076 708 1076 604 1086 607 1117"/>
                        </Shape>
                        <String CONTENT="caught with the lasso, which is thrown over them, or spread like a snare on"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l10" HPOS="607" VPOS="1141" WIDTH="1773" HEIGHT="52" BASELINE="607 1175 2380 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1175 607 1193 2380 1193 2380 1175 2378 1141 607 1143 607 1175"/>
                        </Shape>
                        <String CONTENT="their track. When all the harness-reindeer are inside, the entrance is barred"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l11" HPOS="609" VPOS="1206" WIDTH="1773" HEIGHT="47" BASELINE="609 1234 2382 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="609 1234 609 1253 2382 1253 2382 1234 2382 1206 609 1206 609 1234"/>
                        </Shape>
                        <String CONTENT="with a heavy rope, and all the men and women immediately enter and secure"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l12" HPOS="607" VPOS="1253" WIDTH="1773" HEIGHT="59" BASELINE="607 1294 2380 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1294 607 1312 2380 1312 2380 1294 2380 1264 2354 1253 2352 1253 2350 1253 2348 1253 2315 1264 2229 1253 2226 1253 2224 1253 2194 1264 2125 1253 2122 1253 1289 1264 1258 1253 1256 1253 1254 1253 1165 1264 1025 1253 1022 1253 1020 1253 999 1264 942 1253 940 1253 843 1264 749 1253 747 1253 685 1264 633 1253 630 1253 628 1253 607 1264 607 1294"/>
                        </Shape>
                        <String CONTENT="the reindeer with halters and traces. A few usually escape, breaking through"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l13" HPOS="607" VPOS="1327" WIDTH="1775" HEIGHT="50" BASELINE="607 1355 2382 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1355 607 1370 2380 1377 2382 1355 2382 1327 607 1327 607 1355"/>
                        </Shape>
                        <String CONTENT="the corral, or jumping it; and sometimes the whole pack succeed in over-"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l14" HPOS="607" VPOS="1385" WIDTH="1775" HEIGHT="57" BASELINE="607 1416 2382 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1416 607 1429 769 1442 771 1442 773 1442 821 1431 1018 1442 1020 1442 1126 1431 1384 1442 1386 1442 1440 1431 1529 1442 1531 1442 1533 1442 1577 1431 1663 1442 1666 1442 2181 1431 2294 1442 2296 1442 2382 1429 2382 1416 2382 1385 607 1385 607 1416"/>
                        </Shape>
                        <String CONTENT="throwing the sledges, and running away to join the herd. This happens"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l15" HPOS="607" VPOS="1442" WIDTH="1775" HEIGHT="49" BASELINE="607 1474 2382 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1474 607 1491 2382 1491 2382 1474 2380 1442 607 1442 607 1474"/>
                        </Shape>
                        <String CONTENT="especially when any of the unbroken breeding-bucks have entered the corral"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l16" HPOS="604" VPOS="1489" WIDTH="1774" HEIGHT="63" BASELINE="607 1535 2378 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1535 607 1552 2376 1550 2378 1530 2376 1502 2339 1489 2337 1489 2335 1489 2333 1489 2311 1500 2274 1489 2272 1489 2270 1489 2268 1489 2246 1500 2029 1489 2027 1489 2025 1489 1984 1500 1893 1489 1891 1489 1889 1489 1886 1489 1871 1500 1843 1489 1841 1489 1839 1489 1746 1500 1713 1489 1711 1489 1709 1489 1707 1489 1681 1500 1640 1489 1637 1489 1635 1489 1549 1500 1520 1489 1518 1489 1516 1489 1436 1502 1358 1491 1356 1491 1174 1502 1087 1491 1085 1491 1083 1491 1035 1502 795 1491 793 1491 791 1491 788 1491 773 1504 604 1504 607 1535"/>
                        </Shape>
                        <String CONTENT="among the harness-reindeer. When all the animals are in their places, somebody"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l17" HPOS="604" VPOS="1554" WIDTH="1776" HEIGHT="61" BASELINE="607 1595 2380 1591" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1595 607 1615 2378 1606 2380 1591 2376 1563 639 1554 637 1554 635 1554 604 1565 607 1595"/>
                        </Shape>
                        <String CONTENT="gives the signal, and all the sledges drop to position at the same moment"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l18" HPOS="604" VPOS="1610" WIDTH="1776" HEIGHT="61" BASELINE="607 1656 2380 1652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1656 607 1671 2378 1667 2380 1652 2376 1623 2302 1610 2300 1610 2298 1610 2276 1621 1847 1610 1845 1610 1843 1610 1806 1621 1715 1610 1713 1610 1711 1610 1709 1610 1694 1623 1605 1623 1553 1610 1551 1610 1425 1623 1206 1613 1204 1613 1202 1613 1157 1623 1120 1613 1118 1613 1115 1613 1055 1623 1014 1613 1012 1613 1009 1613 836 1623 756 1613 754 1613 752 1613 717 1623 680 1613 678 1613 676 1613 604 1626 607 1656"/>
                        </Shape>
                        <String CONTENT="and start on, going in their respective lines. This difficult process requires"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l19" HPOS="604" VPOS="1678" WIDTH="1776" HEIGHT="51" BASELINE="607 1710 2380 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1710 604 1725 2376 1729 2380 1714 2376 1678 607 1678 607 1710"/>
                        </Shape>
                        <String CONTENT="the help of several people, and occupies usually three or four hours. A small"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l20" HPOS="604" VPOS="1740" WIDTH="1774" HEIGHT="59" BASELINE="607 1773 2378 1777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1773 604 1786 710 1799 713 1799 2376 1792 2378 1777 2376 1745 607 1740 607 1773"/>
                        </Shape>
                        <String CONTENT="family, living by chance in a separate camp, especially when lacking young,"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l21" HPOS="604" VPOS="1799" WIDTH="1774" HEIGHT="50" BASELINE="607 1829 2378 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1829 604 1844 2374 1849 2378 1833 2376 1803 607 1799 607 1829"/>
                        </Shape>
                        <String CONTENT="swift men, will sometimes fail to catch their own harness-animals for two or"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l22" HPOS="604" VPOS="1859" WIDTH="1772" HEIGHT="59" BASELINE="607 1890 2376 1894" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1890 604 1905 620 1916 622 1916 624 1916 626 1916 1358 1907 1492 1918 1494 1918 2374 1907 2376 1894 2374 1864 607 1859 607 1890"/>
                        </Shape>
                        <String CONTENT="three days in succession. The Koryak and the Lamut harness-reindeer, on"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l23" HPOS="604" VPOS="1918" WIDTH="1776" HEIGHT="58" BASELINE="607 1948 2380 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 1948 604 1965 620 1976 622 1976 624 1976 626 1976 2378 1968 2380 1952 2378 1922 607 1918 607 1948"/>
                        </Shape>
                        <String CONTENT="the other hand, are taken without any corral, by means of a long leather"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l24" HPOS="604" VPOS="1974" WIDTH="1772" HEIGHT="65" BASELINE="607 2009 2376 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2009 604 2022 646 2037 648 2037 650 2037 741 2026 810 2037 812 2037 890 2026 918 2037 921 2037 923 2037 925 2037 957 2026 1014 2037 1016 2037 1421 2026 1492 2039 1494 2039 1618 2028 1821 2028 1837 2039 1839 2039 1841 2039 1843 2039 2374 2026 2376 2013 2372 1974 607 1976 607 2009"/>
                        </Shape>
                        <String CONTENT="rope, which is drawn around the required animals (Plate VI, Fig. 2). All"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l25" HPOS="607" VPOS="2043" WIDTH="1771" HEIGHT="46" BASELINE="607 2074 2378 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2074 607 2089 2378 2089 2378 2074 2378 2043 607 2043 607 2074"/>
                        </Shape>
                        <String CONTENT="those not surrounded by the rope will come in of their own will. Many can"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l26" HPOS="604" VPOS="2095" WIDTH="1631" HEIGHT="52" BASELINE="607 2130 2235 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2130 604 2143 2231 2147 2235 2134 2233 2104 607 2095 607 2130"/>
                        </Shape>
                        <String CONTENT="be taken by hand. The whole operation takes not more than an hour."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-122_r3" HPOS="604" VPOS="2158" WIDTH="1778" HEIGHT="593" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="604 2158 2382 2158 2382 2751 604 2751"/>
                    </Shape>
                    <TextLine ID="mz_1-122_l27" HPOS="710" VPOS="2158" WIDTH="1666" HEIGHT="52" BASELINE="713 2191 2376 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="713 2191 710 2206 2372 2210 2376 2195 2374 2162 713 2158 713 2191"/>
                        </Shape>
                        <String CONTENT="Lieut. Polander,¹ as an eye-witness, describes one very docile Chukchee herd,"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l28" HPOS="607" VPOS="2223" WIDTH="1769" HEIGHT="50" BASELINE="607 2253 2376 2253" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2253 607 2269 2374 2273 2376 2253 2376 2223 607 2223 607 2253"/>
                        </Shape>
                        <String CONTENT="about fifty head strong, that every morning came to greet their master. Then,"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l29" HPOS="609" VPOS="2271" WIDTH="1769" HEIGHT="58" BASELINE="609 2314 2378 2314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="609 2314 609 2329 2378 2329 2378 2314 2378 2284 2324 2271 2322 2271 2257 2282 2109 2271 2107 2271 1956 2282 1908 2271 1906 2271 1904 2271 1902 2271 1858 2282 1815 2271 1813 2271 1811 2271 1808 2271 1785 2282 1746 2271 1744 2271 1741 2271 1739 2271 1694 2282 1605 2271 1603 2271 1531 2282 1497 2271 1494 2271 1492 2271 1490 2271 1468 2282 1423 2271 1421 2271 1419 2271 1345 2282 1291 2271 1289 2271 1287 2271 1284 2271 1267 2284 1061 2284 1009 2271 1007 2271 1005 2271 983 2282 949 2271 947 2271 944 2271 942 2271 899 2282 886 2271 884 2271 882 2271 773 2271 771 2271 769 2271 767 2271 752 2284 609 2284 609 2314"/>
                        </Shape>
                        <String CONTENT="at a signal of the master, the animals, which all the time stood in regular"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l30" HPOS="604" VPOS="2338" WIDTH="1774" HEIGHT="50" BASELINE="607 2372 2378 2368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2372 607 2388 2376 2385 2378 2368 2374 2340 604 2338 607 2372"/>
                        </Shape>
                        <String CONTENT="line, wheeled about and walked away to the pasture in the same unbroken"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l31" HPOS="609" VPOS="2390" WIDTH="1769" HEIGHT="58" BASELINE="609 2433 2378 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="609 2433 609 2448 2378 2448 2378 2433 2378 2401 2352 2390 2350 2390 2348 2390 2346 2390 2320 2401 1860 2390 1858 2390 1856 2390 1834 2401 1804 2390 1802 2390 1800 2390 1798 2390 1776 2401 1748 2390 1746 2390 1744 2390 1575 2401 1514 2390 1512 2390 1510 2390 1473 2401 1421 2390 1419 2390 1416 2390 1414 2390 1399 2403 1224 2403 1172 2390 1170 2390 1070 2401 1018 2390 1016 2390 1014 2390 1012 2390 996 2403 897 2403 858 2390 856 2390 853 2390 851 2390 849 2390 836 2401 799 2390 797 2390 795 2390 734 2401 672 2390 669 2390 609 2401 609 2433"/>
                        </Shape>
                        <String CONTENT="order. I do not know the reason for this unusual docility. Possibly, since it"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l32" HPOS="604" VPOS="2448" WIDTH="1776" HEIGHT="67" BASELINE="607 2487 2380 2492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2487 604 2502 656 2515 659 2515 2378 2507 2380 2492 2376 2450 1494 2459 1412 2448 607 2448 607 2487"/>
                        </Shape>
                        <String CONTENT="happened early in the morning, the animals were attracted by the pieces of"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l33" HPOS="604" VPOS="2507" WIDTH="1776" HEIGHT="69" BASELINE="607 2548 2380 2552" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2548 604 2561 637 2574 639 2574 641 2574 1412 2565 1510 2576 1512 2576 2378 2565 2380 2552 2378 2522 2027 2509 2025 2509 1891 2520 1867 2509 1865 2509 1863 2509 1860 2509 1858 2509 1845 2520 1817 2509 1815 2509 1813 2509 1705 2520 1674 2509 1672 2509 1670 2509 1668 2509 1624 2520 1581 2509 1579 2509 1577 2509 1494 2520 1475 2507 1473 2507 1471 2507 1468 2507 1466 2507 1440 2518 1373 2507 1371 2507 1297 2518 1267 2507 1265 2507 1263 2507 1161 2518 1066 2507 1063 2507 1061 2507 1038 2518 1020 2507 1018 2507 1016 2507 1014 2507 1012 2507 979 2520 756 2520 736 2507 734 2507 732 2507 730 2507 607 2515 607 2548"/>
                        </Shape>
                        <String CONTENT="the large snow-clod, soaked with urine, that is carried out of the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l34" HPOS="604" VPOS="2576" WIDTH="1772" HEIGHT="61" BASELINE="607 2606 2376 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2606 604 2621 1523 2637 1525 2637 2374 2626 2376 2611 2374 2580 607 2576 607 2606"/>
                        </Shape>
                        <String CONTENT="tent every morning and eagerly consumed by the reindeer when near at hand."/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l35" HPOS="607" VPOS="2632" WIDTH="1771" HEIGHT="54" BASELINE="609 2667 2378 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="609 2667 607 2682 2374 2686 2378 2671 2376 2641 609 2632 609 2667"/>
                        </Shape>
                        <String CONTENT="I can hardly imagine Chukchee reindeer, however, making turns at a given"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l36" HPOS="604" VPOS="2695" WIDTH="1631" HEIGHT="59" BASELINE="607 2725 2235 2730" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2725 604 2743 622 2754 624 2754 626 2754 628 2754 2233 2745 2235 2730 2233 2699 607 2695 607 2725"/>
                        </Shape>
                        <String CONTENT="signal, “like the crew on a man-of-war,” to use the words of Polander."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-122_r4" HPOS="604" VPOS="2751" WIDTH="1778" HEIGHT="380" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="604 2751 2382 2751 2382 3131 604 3131"/>
                    </Shape>
                    <TextLine ID="mz_1-122_l37" HPOS="717" VPOS="2751" WIDTH="1659" HEIGHT="65" BASELINE="719 2786 2376 2793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 2786 717 2801 929 2814 931 2814 1252 2805 1332 2816 1334 2816 2374 2810 2376 2793 2374 2762 719 2751 719 2786"/>
                        </Shape>
                        <String CONTENT="When driving a single sledge and stopping for the night in the open air,"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l38" HPOS="607" VPOS="2818" WIDTH="1771" HEIGHT="48" BASELINE="607 2851 2378 2851" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2851 607 2866 2378 2866 2378 2851 2376 2818 607 2818 607 2851"/>
                        </Shape>
                        <String CONTENT="the Chukchee traveller cannot turn his reindeer loose, because they would"/>
                    </TextLine>

                    <TextLine ID="mz_1-122_l39" HPOS="607" VPOS="2868" WIDTH="1769" HEIGHT="65" BASELINE="607 2912 2376 2912" TAGREFS="TYPE_5">
                        <Shape>
