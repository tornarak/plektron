<Shape>
                        <Polygon POINTS="498 2862 2280 2862 2280 3112 498 3112"/>
                    </Shape>
                    <TextLine ID="mz_3-196_l45" HPOS="553" VPOS="2858" WIDTH="1715" HEIGHT="58" BASELINE="553 2901 2268 2901" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="553 2901 553 2916 2268 2916 2268 2901 2268 2871 2202 2858 2200 2858 2198 2858 2165 2868 2116 2858 2114 2858 2112 2858 2110 2858 2093 2869 1933 2858 1931 2858 1929 2858 1927 2858 1907 2869 1867 2858 1865 2858 1863 2858 1861 2858 1822 2871 1576 2871 1518 2858 1516 2858 1514 2858 1475 2869 1459 2858 1457 2858 1455 2858 1453 2858 1451 2858 1426 2868 1401 2858 1399 2858 1397 2858 1395 2858 1362 2871 1143 2871 1114 2858 1112 2858 1007 2858 1005 2858 929 2869 880 2858 878 2858 876 2858 874 2858 873 2858 855 2869 806 2858 804 2858 802 2858 800 2858 798 2858 781 2869 734 2858 732 2858 730 2858 728 2858 726 2858 711 2869 646 2858 645 2858 643 2858 641 2858 625 2869 582 2858 580 2858 578 2858 576 2858 553 2869 553 2901"/>
                        </Shape>
                        <String CONTENT="At Mariinsky Post, Kɪlaˊtɪ was rewarded with some tea and tobacco. Father"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l46" HPOS="506" VPOS="2916" WIDTH="1758" HEIGHT="63" BASELINE="508 2955 2264 2961" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="508 2955 506 2967 528 2979 530 2979 531 2979 2262 2973 2264 2961 2262 2932 1952 2920 1950 2920 1948 2920 1946 2920 1931 2932 1775 2932 1681 2918 1679 2918 1677 2918 1646 2928 1584 2918 1582 2918 1580 2918 1547 2928 1410 2918 1409 2918 1214 2928 1143 2918 1141 2918 1140 2918 1097 2928 993 2916 991 2916 989 2916 964 2926 933 2916 931 2916 929 2916 678 2926 643 2916 641 2916 639 2916 570 2926 508 2916 508 2955"/>
                        </Shape>
                        <String CONTENT="Venedict himself had no shirt on, and his fur clothes were full of insects."/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l47" HPOS="502" VPOS="2977" WIDTH="1762" HEIGHT="60" BASELINE="504 3020 2264 3016" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 3020 504 3037 2262 3037 2264 3016 2262 2988 2221 2977 2219 2977 2217 2977 2215 2977 2192 2988 2052 2988 2036 2977 2034 2977 2032 2977 2030 2977 2028 2977 2026 2977 2011 2986 1935 2977 1933 2977 1931 2977 1907 2986 1876 2977 1874 2977 1872 2977 1818 2986 1763 2977 1761 2977 1759 2977 1720 2988 1594 2988 1578 2977 1576 2977 1574 2977 1572 2977 1381 2988 1288 2979 1286 2979 1284 2979 1258 2988 1231 2979 1229 2979 1227 2979 1225 2979 1200 2990 1042 2990 1027 2979 1025 2979 1023 2979 1021 2979 1019 2979 993 2988 970 2979 968 2979 966 2979 902 2988 828 2979 826 2979 502 2983 504 3020"/>
                        </Shape>
                        <String CONTENT="He proceeded to Markova, and thence to Kolyma. On this last journey he"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l48" HPOS="502" VPOS="3039" WIDTH="1762" HEIGHT="60" BASELINE="502 3080 2264 3080" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 3080 502 3096 2262 3099 2264 3080 2262 3041 1767 3049 1734 3039 1732 3039 1730 3039 1728 3039 1709 3049 1681 3039 1679 3039 1677 3039 1603 3049 1572 3039 1570 3039 1568 3039 1496 3049 1467 3039 1465 3039 1463 3039 1461 3039 1436 3051 1270 3051 1175 3039 1173 3039 1079 3049 1019 3039 1017 3039 951 3049 925 3039 923 3039 921 3039 919 3039 898 3049 824 3039 822 3039 820 3039 818 3039 802 3049 654 3039 652 3039 650 3039 625 3049 588 3039 586 3039 584 3039 502 3049 502 3080"/>
                        </Shape>
                        <String CONTENT="again had bad luck. He and his companions lost their way in the snow, and"/>
                    </TextLine>
