                        <Shape>
                            <Polygon POINTS="604 1885 602 1901 639 1913 641 1913 643 1913 2264 1911 2266 1893 2266 1868 604 1860 604 1885"/>
                        </Shape>
                        <String CONTENT="“Our place is not very windy; but farther on to the south, halfway to the village Rêˊtkên,"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l25" HPOS="500" VPOS="1909" WIDTH="1766" HEIGHT="46" BASELINE="500 1940 2266 1940" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 1940 500 1953 2262 1955 2266 1940 2262 1909 500 1911 500 1940"/>
                        </Shape>
                        <String CONTENT="near the river Iruˊ-veˊem, the wind blows all the time: so it was impossible to go there. We told"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l26" HPOS="500" VPOS="1955" WIDTH="1766" HEIGHT="47" BASELINE="500 1987 2266 1987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 1987 500 2000 2262 2002 2266 1987 2264 1955 500 1955 500 1987"/>
                        </Shape>
                        <String CONTENT="him so. He would not believe us, and, after a few days of waiting, left on foot, quite alone, and"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l27" HPOS="500" VPOS="2002" WIDTH="1764" HEIGHT="45" BASELINE="502 2029 2264 2033" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2029 500 2043 2260 2047 2264 2033 2262 2006 502 2002 502 2029"/>
                        </Shape>
                        <String CONTENT="without provisions. He was much afraid to stay with our people for another winter. We said to"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l28" HPOS="502" VPOS="2047" WIDTH="1764" HEIGHT="49" BASELINE="502 2080 2266 2080" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2080 502 2096 2266 2096 2266 2080 2266 2055 502 2047 502 2080"/>
                        </Shape>
                        <String CONTENT="him, ‘The Russian settlement is not far, you will have time to reach there;’ but he thought we"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l29" HPOS="502" VPOS="2100" WIDTH="1762" HEIGHT="44" BASELINE="502 2127 2264 2127" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2127 502 2144 2264 2144 2264 2127 2264 2100 502 2100 502 2127"/>
                        </Shape>
                        <String CONTENT="were deceiving him, so he left on foot along the shore. I caught him, however, and brought him"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l30" HPOS="500" VPOS="2139" WIDTH="1764" HEIGHT="48" BASELINE="502 2170 2264 2174" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2170 500 2183 2260 2187 2264 2174 2260 2139 502 2139 502 2170"/>
                        </Shape>
                        <String CONTENT="back. He left again, and this time gained quite a little headway. The wind was cutting; but I"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l31" HPOS="500" VPOS="2185" WIDTH="1762" HEIGHT="51" BASELINE="502 2217 2262 2220" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2217 500 2230 2258 2236 2262 2220 2258 2185 502 2185 502 2217"/>
                        </Shape>
                        <String CONTENT="harnessed my team and went in pursuit. After some time I saw him on the shore. Then I stopped"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l32" HPOS="500" VPOS="2238" WIDTH="1764" HEIGHT="45" BASELINE="502 2267 2264 2263" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2267 502 2283 2262 2281 2264 2263 2258 2238 500 2240 502 2267"/>
                        </Shape>
                        <String CONTENT="my dogs, and began to steal along towards him as one steals up to a wild reindeer, because he was"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l33" HPOS="498" VPOS="2277" WIDTH="1764" HEIGHT="55" BASELINE="500 2314 2262 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 2314 500 2332 2260 2332 2262 2310 2258 2285 586 2277 584 2277 498 2287 500 2314"/>
                        </Shape>
                        <String CONTENT="greatly agitated, and I was afraid that he would run away. Then all of a sudden I stepped out in"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l34" HPOS="502" VPOS="2332" WIDTH="1762" HEIGHT="42" BASELINE="502 2357 2264 2357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2357 502 2374 2264 2374 2264 2357 2264 2332 502 2332 502 2357"/>
                        </Shape>
                        <String CONTENT="front of him. Then I said, ‘Now, do come back! You see it is impossible to go. We have no"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l35" HPOS="500" VPOS="2373" WIDTH="1764" HEIGHT="48" BASELINE="502 2400 2264 2406" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2400 500 2415 2260 2421 2264 2406 2262 2378 502 2373 502 2400"/>
                        </Shape>
                        <String CONTENT="chiefs or authorities. So, if the wind should blow you into the sea, your people would not believe"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l36" HPOS="502" VPOS="2417" WIDTH="1764" HEIGHT="49" BASELINE="504 2449 2266 2452" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 2449 502 2462 2262 2466 2266 2452 2264 2425 504 2417 504 2449"/>
                        </Shape>
                        <String CONTENT="it. They would say that we killed you. It would be a bad thing, a great calamity, and interrupt"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l37" HPOS="502" VPOS="2472" WIDTH="1762" HEIGHT="43" BASELINE="502 2497 2264 2497" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2497 502 2515 2264 2515 2264 2497 2264 2472 502 2472 502 2497"/>
                        </Shape>
                        <String CONTENT="the traffic.’ He said nothing, but lay down on the ground and turned away from me. All at once"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l38" HPOS="500" VPOS="2513" WIDTH="1764" HEIGHT="47" BASELINE="502 2540 2264 2546" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2540 500 2554 2260 2560 2264 2546 2262 2519 502 2513 502 2540"/>
                        </Shape>
                        <String CONTENT="a white fox jumped out from the stones. The dogs followed. I caught hold of the sledge, but was"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l39" HPOS="504" VPOS="2565" WIDTH="1762" HEIGHT="43" BASELINE="504 2591 2266 2591" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 2591 504 2608 2266 2608 2266 2591 2266 2565 504 2565 504 2591"/>
                        </Shape>
                        <String CONTENT="unable to stop it: so I tried at least to direct it properly; but we were so near to the brink, that"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l40" HPOS="502" VPOS="2606" WIDTH="1762" HEIGHT="57" BASELINE="504 2634 2264 2640" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 2634 502 2649 1874 2663 1876 2663 2262 2653 2264 2640 2262 2612 504 2606 504 2634"/>
                        </Shape>
                        <String CONTENT="I expected every minute to fall into the water. At last I succeeded in stopping the dogs. The"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l41" HPOS="502" VPOS="2657" WIDTH="1762" HEIGHT="45" BASELINE="504 2684 2264 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 2684 504 2702 2262 2700 2264 2680 2258 2657 502 2659 504 2684"/>
                        </Shape>
                        <String CONTENT="water was as if boiling underneath. I felt very angry, and said to the priest, ‘See, now! For your"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l42" HPOS="500" VPOS="2698" WIDTH="1764" HEIGHT="55" BASELINE="502 2727 2264 2731" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2727 500 2741 721 2753 722 2753 2262 2745 2264 2731 2262 2698 502 2700 502 2727"/>
                        </Shape>
                        <String CONTENT="sake I nearly lost my life by being drowned in the water. Sit down on the sledge! Otherwise I"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l43" HPOS="500" VPOS="2747" WIDTH="1764" HEIGHT="52" BASELINE="502 2774 2264 2780" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="502 2774 500 2790 512 2797 514 2797 516 2797 518 2799 2262 2799 2264 2780 2262 2751 502 2747 502 2774"/>
                        </Shape>
                        <String CONTENT="shall bind you.’ So I brought him back. In a week after that the wind subsided. Then I said,"/>
                    </TextLine>

                    <TextLine ID="mz_3-196_l44" HPOS="504" VPOS="2790" WIDTH="1101" HEIGHT="60" BASELINE="504 2823 1605 2823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 2823 504 2836 730 2848 732 2848 797 2838 1042 2848 1044 2848 1046 2848 1069 2838 1124 2848 1126 2848 1128 2848 1147 2838 1179 2848 1180 2848 1182 2850 1288 2850 1288 2848 1290 2848 1292 2848 1292 2846 1299 2840 1309 2848 1311 2848 1313 2848 1315 2850 1475 2850 1475 2848 1477 2848 1479 2848 1479 2846 1488 2838 1537 2848 1539 2848 1605 2836 1605 2823 1603 2790 504 2795 504 2823"/>
                        </Shape>
                        <String CONTENT="‘Now let us go!’ So we went, and reached Mariinsky Post.”"/>
                    </TextLine>
</TextBlock>
