                    <TextLine ID="mz_1-119_l6" HPOS="409" VPOS="937" WIDTH="1771" HEIGHT="69" BASELINE="411 978 2180 974" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 978 411 991 844 991 907 1004 909 1004 911 1004 946 991 991 1004 994 1004 996 1006 1082 1006 1082 1004 1084 1004 1087 1004 1104 991 1271 1000 1273 1000 1275 1000 1297 989 1355 1002 1357 1002 1360 1002 1399 991 1502 1002 1505 1002 1507 1002 1509 1002 1531 989 1587 1000 1589 1000 1591 1000 1593 1000 1606 989 1639 1000 1641 1000 1643 1000 1793 989 1836 1002 1838 1002 1840 1002 2178 991 2180 974 2176 946 450 937 448 937 446 937 409 948 411 978"/>
                        </Shape>
