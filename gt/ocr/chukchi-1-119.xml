                    <TextLine ID="mz_1-119_l24" HPOS="409" VPOS="2017" WIDTH="1771" HEIGHT="61" BASELINE="411 2048 2180 2054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2048 409 2065 424 2076 426 2076 428 2076 430 2076 944 2067 1013 2078 1015 2078 2178 2069 2180 2054 2178 2024 411 2017 411 2048"/>
                        </Shape>
                        <String CONTENT="combination of both. Driving-sledges are not ungraceful in shape; but they"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l25" HPOS="409" VPOS="2080" WIDTH="1769" HEIGHT="50" BASELINE="411 2110 2178 2115" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2110 409 2126 2174 2130 2178 2115 2176 2084 411 2080 411 2110"/>
                        </Shape>
                        <String CONTENT="are very brittle, and can be shivered to pieces by striking against any obstacle."/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l26" HPOS="413" VPOS="2134" WIDTH="1769" HEIGHT="63" BASELINE="415 2169 2182 2173" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="415 2169 413 2184 495 2197 498 2197 2180 2188 2182 2173 2180 2143 415 2134 415 2169"/>
                        </Shape>
                        <String CONTENT="They vary in form and dimension. The woman’s sledge is usually larger than"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l27" HPOS="411" VPOS="2203" WIDTH="1771" HEIGHT="48" BASELINE="411 2234 2182 2234" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2234 411 2251 2182 2251 2182 2234 2182 2203 411 2203 411 2234"/>
                        </Shape>
                        <String CONTENT="others, and has a wider and more comfortable seat. The usual measurements"/>
