                    <TextLine ID="mz_1-119_l22" HPOS="413" VPOS="1894" WIDTH="1767" HEIGHT="63" BASELINE="415 1929 2180 1935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="415 1929 413 1944 487 1957 489 1957 2178 1950 2180 1935 2178 1905 415 1894 415 1929"/>
                        </Shape>
                        <String CONTENT="This shoeing is fastened with thongs, which are sunk into grooves in order"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l23" HPOS="409" VPOS="1961" WIDTH="1771" HEIGHT="58" BASELINE="411 1991 2180 1996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1991 409 2004 851 2017 853 2017 1273 2009 1412 2019 1414 2019 2178 2009 2180 1996 2178 1965 411 1961 411 1991"/>
                        </Shape>
