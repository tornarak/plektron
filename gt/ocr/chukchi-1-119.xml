                    <TextLine ID="mz_1-119_l24" HPOS="388" VPOS="2002" WIDTH="1771" HEIGHT="61" BASELINE="390 2033 2159 2039" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2033 388 2050 403 2061 405 2061 407 2061 409 2061 923 2052 992 2063 994 2063 2157 2054 2159 2039 2157 2009 390 2002 390 2033"/>
                        </Shape>
                        <String CONTENT="combination of both. Driving-sledges are not ungraceful in shape; but they"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l25" HPOS="388" VPOS="2065" WIDTH="1769" HEIGHT="50" BASELINE="390 2095 2157 2100" TAGREFS="TYPE_4">
                        <Shape>
