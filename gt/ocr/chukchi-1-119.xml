                        <Shape>
                            <Polygon POINTS="390 1680 390 1697 2159 1697 2159 1680 2159 1649 390 1649 390 1680"/>
                        </Shape>
                        <String CONTENT="middle in an upright position, from which to suspend a bell. In the spring-"/>
                    </TextLine>

