                    <TextLine ID="mz_1-119_l5" HPOS="409" VPOS="881" WIDTH="1771" HEIGHT="60" BASELINE="411 913 2180 922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 913 409 930 422 939 424 939 426 939 428 941 2178 941 2180 922 2178 889 411 881 411 913"/>
                        </Shape>
