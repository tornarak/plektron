                        <Shape>
                            <Polygon POINTS="411 1331 409 1346 2178 1353 2182 1337 2180 1307 411 1299 411 1331"/>
                        </Shape>
                        <String CONTENT="largest; those for house utensils, kettles, etc., are supplied with a framework"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l13" HPOS="409" VPOS="1361" WIDTH="1773" HEIGHT="59" BASELINE="411 1392 2182 1398" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1392 409 1407 424 1418 426 1418 428 1418 430 1418 998 1409 1011 1420 1013 1420 1015 1420 1017 1420 2180 1411 2182 1398 2180 1368 411 1361 411 1392"/>
                        </Shape>
                        <String CONTENT="open on one side (Fig. 17, d); and the smallest ones, on which the poles"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l14" HPOS="409" VPOS="1411" WIDTH="1773" HEIGHT="67" BASELINE="411 1452 2182 1457" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1452 409 1465 662 1478 664 1478 2180 1470 2182 1457 2180 1426 1964 1413 1962 1413 1903 1424 1879 1413 1877 1413 1875 1413 1873 1413 1871 1413 1855 1426 1732 1426 1650 1413 1648 1413 1645 1413 1609 1424 1511 1413 1509 1413 1422 1424 1394 1413 1392 1413 1390 1413 1388 1413 1347 1424 1286 1411 1284 1411 1225 1422 1188 1411 1186 1411 1184 1411 1093 1422 1078 1411 1076 1411 1074 1411 1071 1411 1069 1411 1033 1422 874 1411 872 1411 870 1411 842 1422 764 1411 762 1411 760 1411 721 1422 667 1411 664 1411 411 1420 411 1452"/>
                        </Shape>
                        <String CONTENT="are carried, often have a forked rail in the middle (Fig. 17, e). The tent-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l15" HPOS="420" VPOS="1478" WIDTH="1749" HEIGHT="63" BASELINE="420 1515 2169 1519" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="420 1515 420 1537 1292 1530 2165 1541 2169 1519 2165 1478 420 1480 420 1515"/>
                        </Shape>
                        <String CONTENT="poles are attached to the arms of this fork. The driving-sledge (Fig. 17, f)"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l16" HPOS="411" VPOS="1537" WIDTH="1774" HEIGHT="54" BASELINE="413 1571 2185 1576" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="413 1571 411 1586 2180 1591 2185 1576 2185 1537 413 1537 413 1571"/>
                        </Shape>
                        <String CONTENT="is made of birch-wood, with thin, flat runners, curved ribs, and a frame of"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l17" HPOS="409" VPOS="1599" WIDTH="1773" HEIGHT="61" BASELINE="411 1630 2182 1634" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1630 409 1645 485 1658 487 1658 1260 1649 1351 1660 1353 1660 2180 1649 2182 1634 2180 1604 411 1599 411 1630"/>
                        </Shape>
                        <String CONTENT="flat, slender sticks tied together with thongs. Often a hoop is fastened in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l18" HPOS="411" VPOS="1664" WIDTH="1769" HEIGHT="48" BASELINE="411 1695 2180 1695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1695 411 1712 2180 1712 2180 1695 2180 1664 411 1664 411 1695"/>
                        </Shape>
                        <String CONTENT="middle in an upright position, from which to suspend a bell. In the spring-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l19" HPOS="411" VPOS="1723" WIDTH="1771" HEIGHT="47" BASELINE="411 1755 2182 1755" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1755 411 1770 2182 1770 2182 1755 2180 1723 411 1723 411 1755"/>
                        </Shape>
                        <String CONTENT="time, when the birch runners do not glide so smoothly over the half-melted"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l20" HPOS="411" VPOS="1773" WIDTH="1774" HEIGHT="58" BASELINE="411 1816 2185 1816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1816 411 1831 2185 1831 2185 1816 2185 1786 2128 1773 2126 1773 2042 1783 1970 1773 1968 1773 1966 1773 1918 1783 1866 1773 1864 1773 1386 1783 1368 1773 1366 1773 1364 1773 1193 1773 1191 1773 1134 1783 1052 1773 1050 1773 1048 1773 1009 1783 948 1773 946 1773 944 1773 905 1783 809 1773 807 1773 805 1773 803 1773 783 1786 671 1786 586 1773 584 1773 582 1773 580 1773 565 1786 411 1786 411 1816"/>
                        </Shape>
                        <String CONTENT="snow, they are shod with slabs of whalebone, or with several lengths of flat"/>
