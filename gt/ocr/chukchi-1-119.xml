                        </Shape>
                        <String CONTENT="A special sledge, larger and broader than any pack-sledge, has a square"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l37" HPOS="407" VPOS="2797" WIDTH="1775" HEIGHT="58" BASELINE="409 2829 2182 2833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 2829 407 2842 565 2855 567 2855 2180 2846 2182 2833 2182 2801 409 2797 409 2829"/>
                        </Shape>
                        <String CONTENT="frame (Fig. 18, a) covered with skin, and is used for carrying small children"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l38" HPOS="411" VPOS="2862" WIDTH="1771" HEIGHT="45" BASELINE="411 2890 2182 2890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2890 411 2907 2182 2907 2182 2890 2182 2862 411 2862 411 2890"/>
                        </Shape>
                        <String CONTENT="when changing the abode in the cold season. The woman’s driving-sledge is"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l39" HPOS="409" VPOS="2907" WIDTH="1771" HEIGHT="59" BASELINE="411 2948 2180 2953" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2948 409 2961 2176 2966 2180 2953 2178 2920 411 2907 411 2948"/>
                        </Shape>
                        <String CONTENT="sometimes furnished with a small covered space on the back seat in which to"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l40" HPOS="411" VPOS="2981" WIDTH="1771" HEIGHT="45" BASELINE="411 3011 2182 3011" TAGREFS="TYPE_4">
                        <Shape>
