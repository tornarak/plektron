                    <TextLine ID="mz_1-119_l7" HPOS="409" VPOS="991" WIDTH="1771" HEIGHT="63" BASELINE="411 1041 2180 1034" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1041 411 1054 2178 1047 2180 1034 2176 1004 1970 991 1968 991 1886 1002 1832 991 1829 991 1827 991 1825 991 1810 1004 1721 1004 1702 991 1700 991 1697 991 1695 991 1587 1004 1563 993 1561 993 1559 993 1557 993 1526 1004 1331 993 1329 993 1243 1004 1212 993 1210 993 1208 993 1104 1004 1000 993 998 993 931 1006 879 995 877 995 524 1006 422 995 420 995 417 995 415 995 415 998 409 1002 411 1041"/>
                        </Shape>
                        <String CONTENT="(Fig. 17, b) is made of larch-wood, and is of rude workmanship. The fore-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l8" HPOS="411" VPOS="1067" WIDTH="1771" HEIGHT="45" BASELINE="411 1097 2182 1097" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1097 411 1112 2182 1112 2182 1097 2182 1067 411 1067 411 1097"/>
                        </Shape>
                        <String CONTENT="ends of the rails are often straight, and tied to the runners in a very simple"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l9" HPOS="411" VPOS="1112" WIDTH="1769" HEIGHT="67" BASELINE="413 1153 2180 1158" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="413 1153 411 1166 469 1179 472 1179 2178 1171 2180 1158 2178 1127 2085 1114 1977 1114 1975 1114 1972 1114 1970 1114 1955 1125 1931 1114 1929 1114 1743 1114 1741 1114 1739 1114 1736 1114 1723 1125 1684 1114 1682 1114 1680 1114 1678 1114 1632 1125 1572 1114 1570 1114 1567 1114 1535 1125 1463 1114 1461 1114 1459 1114 1427 1125 1381 1114 1379 1114 1377 1114 957 1123 924 1112 922 1112 920 1112 851 1123 786 1112 783 1112 781 1112 760 1123 602 1112 599 1112 413 1121 413 1153"/>
                        </Shape>
                        <String CONTENT="way (Fig. 17, c). The runners are thick; but the ribs frequently break or"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l10" HPOS="409" VPOS="1182" WIDTH="1771" HEIGHT="49" BASELINE="411 1210 2180 1214" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1210 409 1227 2176 1231 2180 1214 2178 1186 411 1182 411 1210"/>
                        </Shape>
                        <String CONTENT="become unfastened under pressure. These sledges vary in size, according to"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l11" HPOS="409" VPOS="1242" WIDTH="1773" HEIGHT="59" BASELINE="411 1273 2182 1277" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1273 409 1288 424 1299 426 1299 428 1299 430 1299 1238 1290 1301 1301 1303 1301 2180 1290 2182 1277 2180 1247 411 1242 411 1273"/>
                        </Shape>
                        <String CONTENT="their special loads. Those carrying the halves of the outer tent-cover are the"/>
                    </TextLine>

