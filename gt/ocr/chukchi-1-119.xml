                        <Shape>
                            <Polygon POINTS="390 1740 390 1755 2161 1755 2161 1740 2159 1708 390 1708 390 1740"/>
                        </Shape>
                        <String CONTENT="time, when the birch runners do not glide so smoothly over the half-melted"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l20" HPOS="390" VPOS="1758" WIDTH="1774" HEIGHT="58" BASELINE="390 1801 2164 1801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1801 390 1816 2164 1816 2164 1801 2164 1771 2107 1758 2105 1758 2021 1768 1949 1758 1947 1758 1945 1758 1897 1768 1845 1758 1843 1758 1365 1768 1347 1758 1345 1758 1343 1758 1172 1758 1170 1758 1113 1768 1031 1758 1029 1758 1027 1758 988 1768 927 1758 925 1758 923 1758 884 1768 788 1758 786 1758 784 1758 782 1758 762 1771 650 1771 565 1758 563 1758 561 1758 559 1758 544 1771 390 1771 390 1801"/>
                        </Shape>
                        <String CONTENT="snow, they are shod with slabs of whalebone, or with several lengths of flat"/>
