                        <Shape>
                            <Polygon POINTS="390 1377 388 1392 403 1403 405 1403 407 1403 409 1403 977 1394 990 1405 992 1405 994 1405 996 1405 2159 1396 2161 1383 2159 1353 390 1346 390 1377"/>
                        </Shape>
                        <String CONTENT="open on one side (Fig. 17, d); and the smallest ones, on which the poles"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l14" HPOS="388" VPOS="1396" WIDTH="1773" HEIGHT="67" BASELINE="390 1437 2161 1442" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1437 388 1450 641 1463 643 1463 2159 1455 2161 1442 2159 1411 1943 1398 1941 1398 1882 1409 1858 1398 1856 1398 1854 1398 1852 1398 1850 1398 1834 1411 1711 1411 1629 1398 1627 1398 1624 1398 1588 1409 1490 1398 1488 1398 1401 1409 1373 1398 1371 1398 1369 1398 1367 1398 1326 1409 1265 1396 1263 1396 1204 1407 1167 1396 1165 1396 1163 1396 1072 1407 1057 1396 1055 1396 1053 1396 1050 1396 1048 1396 1012 1407 853 1396 851 1396 849 1396 821 1407 743 1396 741 1396 739 1396 700 1407 646 1396 643 1396 390 1405 390 1437"/>
                        </Shape>
                        <String CONTENT="are carried, often have a forked rail in the middle (Fig. 17, e). The tent-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l15" HPOS="399" VPOS="1463" WIDTH="1749" HEIGHT="63" BASELINE="399 1500 2148 1504" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="399 1500 399 1522 1271 1515 2144 1526 2148 1504 2144 1463 399 1465 399 1500"/>
                        </Shape>
                        <String CONTENT="poles are attached to the arms of this fork. The driving-sledge (Fig. 17, f)"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l16" HPOS="390" VPOS="1522" WIDTH="1774" HEIGHT="54" BASELINE="392 1556 2164 1561" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="392 1556 390 1571 2159 1576 2164 1561 2164 1522 392 1522 392 1556"/>
                        </Shape>
                        <String CONTENT="is made of birch-wood, with thin, flat runners, curved ribs, and a frame of"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l17" HPOS="388" VPOS="1584" WIDTH="1773" HEIGHT="61" BASELINE="390 1615 2161 1619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1615 388 1630 464 1643 466 1643 1239 1634 1330 1645 1332 1645 2159 1634 2161 1619 2159 1589 390 1584 390 1615"/>
                        </Shape>
                        <String CONTENT="flat, slender sticks tied together with thongs. Often a hoop is fastened in the"/>
                    </TextLine>

