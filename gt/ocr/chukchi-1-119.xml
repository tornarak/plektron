                    <TextLine ID="mz_1-119_l28" HPOS="409" VPOS="2260" WIDTH="1773" HEIGHT="50" BASELINE="411 2290 2182 2294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2290 409 2305 2178 2310 2182 2294 2180 2264 411 2260 411 2290"/>
                        </Shape>
                        <String CONTENT="for the man’s driving-sledge are: length, 180-200 cm.; distance between the"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l29" HPOS="407" VPOS="2310" WIDTH="1773" HEIGHT="60" BASELINE="409 2355 2180 2351" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 2355 409 2370 2178 2366 2180 2351 2176 2323 1879 2310 1877 2310 1875 2310 1873 2310 1858 2323 1643 2323 1541 2310 1539 2310 1481 2320 1427 2310 1424 2310 1422 2310 1388 2320 1355 2310 1353 2310 1351 2310 1349 2310 1347 2310 1331 2320 1297 2310 1295 2310 1292 2310 1173 2323 799 2312 796 2312 742 2323 686 2312 684 2312 682 2312 680 2312 662 2323 610 2312 608 2312 606 2312 604 2312 586 2325 407 2325 409 2355"/>
                        </Shape>
                        <String CONTENT="runners, in the middle, 30-35 cm.; height in the middle, 24 cm. The measure-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l30" HPOS="409" VPOS="2370" WIDTH="1773" HEIGHT="61" BASELINE="411 2413 2182 2409" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2413 411 2431 2180 2426 2182 2409 2178 2381 1353 2370 1351 2370 1277 2381 515 2372 513 2372 409 2383 411 2413"/>
                        </Shape>
                        <String CONTENT="ments for the woman’s driving-sledge are: length, 220-250 cm.; distance between"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l31" HPOS="411" VPOS="2439" WIDTH="1767" HEIGHT="57" BASELINE="413 2470 2178 2476" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="413 2470 411 2483 476 2496 478 2496 2176 2494 2178 2476 2176 2446 413 2439 413 2470"/>
                        </Shape>
                        <String CONTENT="the runners, 35-40 cm.; height, 25 cm. The racing-sledge, on the contrary,"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l32" HPOS="409" VPOS="2494" WIDTH="1773" HEIGHT="56" BASELINE="411 2526 2182 2535" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 2526 409 2541 2178 2550 2182 2535 2180 2504 411 2494 411 2526"/>
                        </Shape>
                        <String CONTENT="is so small, that the driver has hardly room to sit. Even the woman’s sledge"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l33" HPOS="413" VPOS="2552" WIDTH="1767" HEIGHT="65" BASELINE="413 2587 2180 2593" TAGREFS="TYPE_4">
                        <Shape>
