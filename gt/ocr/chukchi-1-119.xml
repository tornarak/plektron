                    <TextLine ID="mz_1-119_l26" HPOS="392" VPOS="2119" WIDTH="1769" HEIGHT="63" BASELINE="394 2154 2161 2158" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 2154 392 2169 474 2182 477 2182 2159 2173 2161 2158 2159 2128 394 2119 394 2154"/>
                        </Shape>
                        <String CONTENT="They vary in form and dimension. The woman’s sledge is usually larger than"/>
