                        <Shape>
                            <Polygon POINTS="390 1859 390 1881 864 1872 1120 1883 1122 1883 1269 1875 1284 1885 1287 1885 1289 1885 1291 1885 1657 1877 1696 1888 1698 1888 1700 1888 1845 1877 1958 1888 1960 1888 1962 1888 2001 1877 2131 1888 2133 1888 2135 1888 2138 1888 2153 1875 2155 1866 2155 1831 2135 1820 2133 1820 2131 1820 2129 1820 2127 1820 2092 1831 1769 1820 1767 1820 1657 1831 1624 1820 1622 1820 1620 1820 1618 1820 1590 1831 1570 1818 1568 1818 1566 1818 1564 1818 1401 1829 1146 1818 1144 1818 1076 1829 1025 1818 1022 1818 1020 1818 977 1829 897 1816 895 1816 892 1816 860 1829 678 1829 652 1816 650 1816 648 1816 390 1825 390 1859"/>
                        </Shape>
                        <String CONTENT="pieces of bone cut from the whale’s jaw and joined together (Fig. 17, g)."/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l22" HPOS="392" VPOS="1879" WIDTH="1767" HEIGHT="63" BASELINE="394 1914 2159 1920" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1914 392 1929 466 1942 468 1942 2157 1935 2159 1920 2157 1890 394 1879 394 1914"/>
                        </Shape>
                        <String CONTENT="This shoeing is fastened with thongs, which are sunk into grooves in order"/>
