                    <TextLine ID="mz_1-119_l21" HPOS="411" VPOS="1831" WIDTH="1765" HEIGHT="72" BASELINE="411 1874 2176 1881" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="411 1874 411 1896 885 1887 1141 1898 1143 1898 1290 1890 1305 1900 1308 1900 1310 1900 1312 1900 1678 1892 1717 1903 1719 1903 1721 1903 1866 1892 1979 1903 1981 1903 1983 1903 2022 1892 2152 1903 2154 1903 2156 1903 2159 1903 2174 1890 2176 1881 2176 1846 2156 1835 2154 1835 2152 1835 2150 1835 2148 1835 2113 1846 1790 1835 1788 1835 1678 1846 1645 1835 1643 1835 1641 1835 1639 1835 1611 1846 1591 1833 1589 1833 1587 1833 1585 1833 1422 1844 1167 1833 1165 1833 1097 1844 1046 1833 1043 1833 1041 1833 998 1844 918 1831 916 1831 913 1831 881 1844 699 1844 673 1831 671 1831 669 1831 411 1840 411 1874"/>
                        </Shape>
                        <String CONTENT="pieces of bone cut from the whale’s jaw and joined together (Fig. 17, g)."/>
