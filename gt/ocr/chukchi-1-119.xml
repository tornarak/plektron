                        </Shape>
                        <String CONTENT="A special sledge, larger and broader than any pack-sledge, has a square"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l37" HPOS="386" VPOS="2782" WIDTH="1775" HEIGHT="58" BASELINE="388 2814 2161 2818" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2814 386 2827 544 2840 546 2840 2159 2831 2161 2818 2161 2786 388 2782 388 2814"/>
                        </Shape>
                        <String CONTENT="frame (Fig. 18, a) covered with skin, and is used for carrying small children"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l38" HPOS="390" VPOS="2847" WIDTH="1771" HEIGHT="45" BASELINE="390 2875 2161 2875" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2875 390 2892 2161 2892 2161 2875 2161 2847 390 2847 390 2875"/>
                        </Shape>
                        <String CONTENT="when changing the abode in the cold season. The woman’s driving-sledge is"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l39" HPOS="388" VPOS="2892" WIDTH="1771" HEIGHT="59" BASELINE="390 2933 2159 2938" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2933 388 2946 2155 2951 2159 2938 2157 2905 390 2892 390 2933"/>
                        </Shape>
                        <String CONTENT="sometimes furnished with a small covered space on the back seat in which to"/>
                    </TextLine>

