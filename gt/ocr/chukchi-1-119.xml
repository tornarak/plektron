                        </Shape>
                        <String CONTENT="is so light, that a man can easily lift it with one hand and carry it on his"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l34" HPOS="390" VPOS="2600" WIDTH="1774" HEIGHT="52" BASELINE="390 2637 2164 2637" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2155 2600 390 2600 390 2637 390 2652 2164 2652 2164 2637 2164 2615 2155 2600"/>
                        </Shape>
                        <String CONTENT="back, not to speak of drawing it with a rope over the snow. The seats of"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l35" HPOS="388" VPOS="2652" WIDTH="1680" HEIGHT="71" BASELINE="390 2693 2068 2699" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2693 388 2706 1003 2721 1005 2721 1468 2712 1507 2723 1510 2723 1512 2723 2066 2712 2068 2699 2068 2669 2036 2656 2034 2656 1941 2656 1938 2656 1936 2656 1934 2656 1921 2667 1572 2656 1570 2656 1507 2667 1427 2654 1425 2654 1349 2667 1096 2667 1081 2654 1079 2654 1076 2654 1074 2654 1072 2654 1044 2665 905 2665 875 2652 873 2652 871 2652 869 2652 823 2663 808 2652 806 2652 804 2652 801 2652 799 2652 756 2663 643 2652 641 2652 639 2652 615 2663 600 2652 598 2652 596 2652 594 2652 591 2652 563 2663 492 2652 490 2652 390 2660 390 2693"/>
                        </Shape>
                        <String CONTENT="driving-sledges, of whatever shape, are usually supplied with a low back."/>
