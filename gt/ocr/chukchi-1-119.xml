                    <TextLine ID="mz_1-119_l6" HPOS="388" VPOS="922" WIDTH="1771" HEIGHT="69" BASELINE="390 963 2159 959" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 963 390 976 823 976 886 989 888 989 890 989 925 976 970 989 973 989 975 991 1061 991 1061 989 1063 989 1066 989 1083 976 1250 985 1252 985 1254 985 1276 974 1334 987 1336 987 1339 987 1378 976 1481 987 1484 987 1486 987 1488 987 1510 974 1566 985 1568 985 1570 985 1572 985 1585 974 1618 985 1620 985 1622 985 1772 974 1815 987 1817 987 1819 987 2157 976 2159 959 2155 931 429 922 427 922 425 922 388 933 390 963"/>
