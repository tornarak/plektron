                        <Shape>
                            <Polygon POINTS="390 2219 390 2236 2161 2236 2161 2219 2161 2188 390 2188 390 2219"/>
                        </Shape>
                        <String CONTENT="others, and has a wider and more comfortable seat. The usual measurements"/>
