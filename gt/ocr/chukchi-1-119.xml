<Shape>
                        <Polygon POINTS="408 2736 2186 2736 2186 3213 408 3213"/>
                    </Shape>
                    <TextLine ID="mz_1-119_l36" HPOS="517" VPOS="2736" WIDTH="1665" HEIGHT="63" BASELINE="519 2766 2182 2773" TAGREFS="TYPE_4">
                        <Shape>
