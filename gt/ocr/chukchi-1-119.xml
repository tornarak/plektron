                    </TextLine>

                    <TextLine ID="mz_1-119_l9" HPOS="390" VPOS="1097" WIDTH="1769" HEIGHT="67" BASELINE="392 1138 2159 1143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="392 1138 390 1151 448 1164 451 1164 2157 1156 2159 1143 2157 1112 2064 1099 1956 1099 1954 1099 1951 1099 1949 1099 1934 1110 1910 1099 1908 1099 1722 1099 1720 1099 1718 1099 1715 1099 1702 1110 1663 1099 1661 1099 1659 1099 1657 1099 1611 1110 1551 1099 1549 1099 1546 1099 1514 1110 1442 1099 1440 1099 1438 1099 1406 1110 1360 1099 1358 1099 1356 1099 936 1108 903 1097 901 1097 899 1097 830 1108 765 1097 762 1097 760 1097 739 1108 581 1097 578 1097 392 1106 392 1138"/>
                        </Shape>
                        <String CONTENT="way (Fig. 17, c). The runners are thick; but the ribs frequently break or"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l10" HPOS="388" VPOS="1167" WIDTH="1771" HEIGHT="49" BASELINE="390 1195 2159 1199" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1195 388 1212 2155 1216 2159 1199 2157 1171 390 1167 390 1195"/>
                        </Shape>
                        <String CONTENT="become unfastened under pressure. These sledges vary in size, according to"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l11" HPOS="388" VPOS="1227" WIDTH="1773" HEIGHT="59" BASELINE="390 1258 2161 1262" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1258 388 1273 403 1284 405 1284 407 1284 409 1284 1217 1275 1280 1286 1282 1286 2159 1275 2161 1262 2159 1232 390 1227 390 1258"/>
                        </Shape>
