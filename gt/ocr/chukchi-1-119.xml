                    <TextLine ID="mz_1-119_l28" HPOS="388" VPOS="2245" WIDTH="1773" HEIGHT="50" BASELINE="390 2275 2161 2279" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2275 388 2290 2157 2295 2161 2279 2159 2249 390 2245 390 2275"/>
                        </Shape>
                        <String CONTENT="for the man’s driving-sledge are: length, 180-200 cm.; distance between the"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l29" HPOS="386" VPOS="2295" WIDTH="1773" HEIGHT="60" BASELINE="388 2340 2159 2336" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2340 388 2355 2157 2351 2159 2336 2155 2308 1858 2295 1856 2295 1854 2295 1852 2295 1837 2308 1622 2308 1520 2295 1518 2295 1460 2305 1406 2295 1403 2295 1401 2295 1367 2305 1334 2295 1332 2295 1330 2295 1328 2295 1326 2295 1310 2305 1276 2295 1274 2295 1271 2295 1152 2308 778 2297 775 2297 721 2308 665 2297 663 2297 661 2297 659 2297 641 2308 589 2297 587 2297 585 2297 583 2297 565 2310 386 2310 388 2340"/>
                        </Shape>
                        <String CONTENT="runners, in the middle, 30-35 cm.; height in the middle, 24 cm. The measure-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l30" HPOS="388" VPOS="2355" WIDTH="1773" HEIGHT="61" BASELINE="390 2398 2161 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2398 390 2416 2159 2411 2161 2394 2157 2366 1332 2355 1330 2355 1256 2366 494 2357 492 2357 388 2368 390 2398"/>
                        </Shape>
                        <String CONTENT="ments for the woman’s driving-sledge are: length, 220-250 cm.; distance between"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l31" HPOS="390" VPOS="2424" WIDTH="1767" HEIGHT="57" BASELINE="392 2455 2157 2461" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="392 2455 390 2468 455 2481 457 2481 2155 2479 2157 2461 2155 2431 392 2424 392 2455"/>
                        </Shape>
                        <String CONTENT="the runners, 35-40 cm.; height, 25 cm. The racing-sledge, on the contrary,"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l32" HPOS="388" VPOS="2479" WIDTH="1773" HEIGHT="56" BASELINE="390 2511 2161 2520" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2511 388 2526 2157 2535 2161 2520 2159 2489 390 2479 390 2511"/>
                        </Shape>
                        <String CONTENT="is so small, that the driver has hardly room to sit. Even the woman’s sledge"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l33" HPOS="392" VPOS="2537" WIDTH="1767" HEIGHT="65" BASELINE="392 2572 2159 2578" TAGREFS="TYPE_4">
                        <Shape>
