                        </Shape>
                        <String CONTENT="(Fig. 17, b) is made of larch-wood, and is of rude workmanship. The fore-"/>
                    </TextLine>

                    <TextLine ID="mz_1-119_l8" HPOS="390" VPOS="1052" WIDTH="1771" HEIGHT="45" BASELINE="390 1082 2161 1082" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 1082 390 1097 2161 1097 2161 1082 2161 1052 390 1052 390 1082"/>
                        </Shape>
