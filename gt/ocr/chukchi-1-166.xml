                        </Shape>
                        <String CONTENT="Ivory plugs for stopping the wounds of seal are known to the Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l9" HPOS="649" VPOS="1106" WIDTH="1776" HEIGHT="45" BASELINE="649 1136 2425 1136" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1136 649 1151 2425 1151 2425 1136 2425 1106 649 1106 649 1136"/>
                        </Shape>
                        <String CONTENT="and have nearly the same shape as those of the American Eskimo. Seal-"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l10" HPOS="649" VPOS="1162" WIDTH="1774" HEIGHT="59" BASELINE="651 1192 2423 1197" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1192 649 1208 721 1221 723 1221 2421 1212 2423 1197 2421 1166 651 1162 651 1192"/>
                        </Shape>
                        <String CONTENT="drags, however, are not used, but the seal is dragged along by means of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l11" HPOS="649" VPOS="1212" WIDTH="1295" HEIGHT="71" BASELINE="651 1253 1944 1260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1253 649 1264 690 1279 693 1279 695 1279 926 1268 1082 1281 1084 1281 1087 1281 1123 1270 1541 1270 1552 1281 1552 1283 1554 1283 1557 1283 1559 1283 1561 1283 1593 1273 1732 1283 1734 1283 1736 1283 1739 1283 1754 1273 1814 1283 1816 1283 1942 1273 1944 1260 1944 1227 1929 1216 1927 1216 1925 1216 1923 1216 1920 1216 1886 1227 1821 1216 1819 1216 1752 1227 1617 1216 1615 1216 1412 1225 1394 1214 1392 1214 1390 1214 1388 1214 1331 1225 1301 1214 1299 1214 1297 1214 1295 1214 1269 1227 1119 1227 1108 1216 1108 1214 1106 1214 1104 1214 1102 1214 994 1223 983 1214 983 1212 981 1212 978 1212 976 1212 974 1212 944 1223 926 1212 924 1212 922 1212 920 1212 918 1212 892 1223 651 1223 651 1253"/>
                        </Shape>
                        <String CONTENT="rope passed through a cut in his nose (Plate X, Fig. 2)."/>
                    </TextLine>
