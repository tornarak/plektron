                        </Shape>
                        <String CONTENT="boats with skins of the Okhotsk variety of ground-seal, having indeed no other"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l38" HPOS="651" VPOS="2831" WIDTH="1774" HEIGHT="59" BASELINE="651 2875 2425 2875" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2875 651 2890 2425 2890 2425 2875 2425 2844 2364 2831 2362 2831 2308 2842 2286 2831 2284 2831 2282 2831 2280 2831 2241 2842 2187 2831 2185 2831 2182 2831 2156 2842 1587 2831 1585 2831 1481 2842 1409 2831 1407 2831 1405 2831 1368 2842 1338 2831 1336 2831 1334 2831 1262 2842 1234 2831 1232 2831 1230 2831 1227 2831 1225 2831 1210 2844 1011 2844 913 2831 911 2831 848 2842 786 2831 783 2831 651 2842 651 2875"/>
                        </Shape>
                        <String CONTENT="material. I have never heard of large Chukchee boats, being made of skins"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l39" HPOS="649" VPOS="2892" WIDTH="1774" HEIGHT="56" BASELINE="651 2933 2423 2929" TAGREFS="TYPE_4">
