                        <Shape>
                            <Polygon POINTS="760 1316 760 1331 1134 1331 1225 1342 1227 1342 1230 1342 1256 1331 1589 1340 1591 1340 1648 1329 1695 1340 1697 1340 1700 1340 1702 1340 1704 1340 1719 1329 1825 1329 2031 1340 2033 1340 2035 1340 2037 1340 2055 1329 2135 1340 2137 1340 2139 1340 2161 1329 2230 1340 2232 1340 2234 1340 2237 1340 2250 1329 2263 1340 2265 1340 2267 1340 2269 1342 2408 1342 2408 1340 2410 1340 2412 1340 2425 1327 2425 1311 2423 1283 2388 1270 2386 1270 2384 1270 2382 1270 2358 1281 2334 1270 2332 1270 2330 1270 2328 1270 2325 1270 2308 1281 2289 1270 2286 1270 2284 1270 2282 1270 2260 1281 2133 1270 2130 1270 2128 1270 2126 1270 2113 1283 1992 1283 1966 1270 1964 1270 1962 1270 1959 1270 1957 1270 1942 1281 1920 1270 1918 1270 1916 1270 1914 1270 1912 1270 1899 1281 1838 1270 1836 1270 1780 1281 1752 1270 1749 1270 1747 1270 1689 1281 1615 1270 1613 1270 1611 1270 1578 1286 1424 1286 1409 1273 1407 1273 1405 1273 1403 1273 1401 1273 1377 1283 1344 1273 1342 1273 1340 1273 1282 1283 1156 1273 1154 1273 1152 1273 1117 1283 1067 1273 1065 1273 757 1281 760 1316"/>
                        </Shape>
                        <String CONTENT="BOATS. — The large skin boats used by the Chukchee and the Asiatic"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l13" HPOS="651" VPOS="1340" WIDTH="1774" HEIGHT="52" BASELINE="651 1376 2425 1376" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2416 1344 651 1340 651 1376 651 1392 2425 1392 2425 1376 2425 1370 2416 1344"/>
                        </Shape>
                        <String CONTENT="Eskimo are very similar to those of arctic America in shape and in details"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l14" HPOS="649" VPOS="1396" WIDTH="1776" HEIGHT="56" BASELINE="651 1437 2425 1433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1437 651 1452 2423 1448 2425 1433 2421 1396 686 1396 684 1396 682 1396 649 1407 651 1437"/>
                        </Shape>
                        <String CONTENT="of construction. The differences are not greater than those between boats of"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l15" HPOS="649" VPOS="1457" WIDTH="1776" HEIGHT="60" BASELINE="651 1498 2425 1491" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1498 651 1511 2408 1517 2410 1517 2412 1517 2414 1517 2425 1506 2425 1491 2421 1457 667 1457 664 1457 662 1457 660 1457 649 1463 651 1498"/>
                        </Shape>
                        <String CONTENT="the western and eastern Eskimo, especially since whole frames and parts of"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l16" HPOS="651" VPOS="1526" WIDTH="1772" HEIGHT="47" BASELINE="651 1554 2423 1554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1554 651 1573 2423 1573 2423 1554 2423 1526 651 1526 651 1554"/>
                        </Shape>
                        <String CONTENT="them have been carried from ancient times across Bering Strait as objects for"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l17" HPOS="651" VPOS="1569" WIDTH="1770" HEIGHT="63" BASELINE="654 1617 2421 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1617 654 1632 2419 1630 2421 1610 2419 1578 2408 1569 2406 1569 2403 1569 2401 1569 2399 1569 2397 1569 2382 1582 2143 1582 2120 1569 2118 1569 2115 1569 2113 1569 2070 1580 2011 1569 2009 1569 1914 1580 1886 1569 1884 1569 1881 1569 1821 1582 1418 1571 1416 1571 1414 1571 1381 1582 1325 1571 1323 1571 1321 1571 1288 1582 935 1573 933 1573 931 1573 907 1584 816 1573 814 1573 747 1584 703 1573 701 1573 699 1573 697 1573 651 1586 654 1617"/>
                        </Shape>
                        <String CONTENT="sale. The Koryak boats, with their flaring sides and semicircular stern and"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l18" HPOS="651" VPOS="1641" WIDTH="1772" HEIGHT="52" BASELINE="654 1675 2423 1671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1675 654 1693 2421 1688 2423 1671 2419 1643 651 1641 654 1675"/>
                        </Shape>
                        <String CONTENT="bow, on the contrary, form a quite separate type; while the Kamchadal have"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l19" HPOS="651" VPOS="1701" WIDTH="1772" HEIGHT="61" BASELINE="654 1732 2423 1736" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1732 651 1747 881 1760 883 1760 1537 1751 1650 1762 1652 1762 2421 1751 2423 1736 2421 1706 654 1701 654 1732"/>
                        </Shape>
                        <String CONTENT="no skin boats, but use instead dug-outs with planks fastened to the upper edges."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-166_r5" HPOS="649" VPOS="1759" WIDTH="1778" HEIGHT="595" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 1759 2427 1759 2427 2354 649 2354"/>
                    </Shape>
                    <TextLine ID="mz_1-166_l20" HPOS="757" VPOS="1751" WIDTH="1666" HEIGHT="58" BASELINE="760 1792 2423 1796" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="760 1792 757 1805 2419 1809 2423 1796 2423 1766 2377 1753 2375 1753 2373 1753 2276 1764 2122 1753 2120 1753 2042 1764 1983 1753 1981 1753 1979 1753 1949 1764 1914 1753 1912 1753 1910 1753 1832 1764 1786 1753 1784 1753 1782 1753 1780 1753 1752 1764 1723 1753 1721 1753 1719 1753 1717 1753 1691 1764 1665 1753 1663 1753 1661 1753 1658 1753 1632 1764 1314 1764 1290 1751 1288 1751 1286 1751 1284 1751 1258 1762 1214 1751 1212 1751 1210 1751 1152 1762 1082 1751 1080 1751 1078 1751 1052 1762 760 1757 760 1792"/>
                        </Shape>
                        <String CONTENT="The reason for this does not rest exclusively with the difference of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l21" HPOS="649" VPOS="1812" WIDTH="1774" HEIGHT="60" BASELINE="651 1855 2423 1851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1855 651 1872 2421 1868 2423 1851 2419 1822 1537 1812 1535 1812 1533 1812 1496 1822 718 1814 716 1814 649 1825 651 1855"/>
                        </Shape>
                        <String CONTENT="natural surroundings of the tribes mentioned. It is true, that with the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l22" HPOS="651" VPOS="1872" WIDTH="1772" HEIGHT="59" BASELINE="651 1913 2423 1913" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 1913 651 1931 2423 1931 2423 1913 2423 1883 2386 1872 2384 1872 2382 1872 2325 1883 2263 1872 2260 1872 2258 1872 2228 1883 2167 1872 2165 1872 2163 1872 2137 1883 1957 1872 1955 1872 1851 1883 1819 1872 1816 1872 1814 1872 1812 1872 1810 1872 1797 1883 1771 1872 1769 1872 1767 1872 1702 1883 1630 1872 1628 1872 1531 1883 1492 1872 1489 1872 1487 1872 1485 1872 1446 1883 1360 1872 1357 1872 1290 1883 1264 1872 1262 1872 1260 1872 1152 1883 1121 1872 1119 1872 1117 1872 1054 1883 998 1872 996 1872 859 1883 807 1872 805 1872 734 1883 682 1872 680 1872 677 1872 651 1883 651 1913"/>
                        </Shape>
                        <String CONTENT="chee the scarcity of wood sufficiently explains their predilection for the skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l23" HPOS="651" VPOS="1939" WIDTH="1772" HEIGHT="52" BASELINE="654 1976 2423 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 1976 654 1991 2421 1987 2423 1972 2419 1942 651 1939 654 1976"/>
                        </Shape>
                        <String CONTENT="boat, but the Koryak shore abounds in large trunks of driftwood suitable for"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l24" HPOS="651" VPOS="2000" WIDTH="1772" HEIGHT="52" BASELINE="651 2035 2423 2035" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2035 651 2052 2423 2052 2423 2035 2423 2004 651 2000 651 2035"/>
                        </Shape>
                        <String CONTENT="building wooden boats. On the other hand, the shores of Kamchatka are"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l25" HPOS="649" VPOS="2052" WIDTH="1772" HEIGHT="65" BASELINE="651 2097 2421 2093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2097 651 2117 2419 2115 2421 2093 2416 2063 1554 2052 1552 2052 1550 2052 1548 2052 1528 2063 725 2054 723 2054 649 2065 651 2097"/>
                        </Shape>
                        <String CONTENT="probably even richer in sea-mammals than those of the Chukchee Peninsula,"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l26" HPOS="651" VPOS="2123" WIDTH="1772" HEIGHT="52" BASELINE="651 2156 2423 2156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2156 651 2171 2421 2175 2423 2156 2423 2123 651 2123 651 2156"/>
                        </Shape>
                        <String CONTENT="and thus afford every convenience for constructing skin boats. The Kamchadal,"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l27" HPOS="647" VPOS="2171" WIDTH="1776" HEIGHT="63" BASELINE="649 2216 2423 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2216 649 2234 2421 2229 2423 2212 2419 2182 2310 2171 2308 2171 2245 2182 2217 2171 2215 2171 2213 2171 2211 2171 2208 2171 2193 2182 2167 2171 2165 2171 2163 2171 2161 2171 2159 2171 2143 2184 1897 2184 1834 2171 1832 2171 1829 2171 1799 2184 1626 2184 1593 2171 1591 2171 1589 2171 1587 2171 1554 2182 1539 2171 1537 2171 1535 2171 1533 2171 1455 2184 1388 2173 1386 2173 1318 2184 1173 2173 1171 2173 1097 2184 1056 2173 1054 2173 1052 2173 920 2184 786 2173 783 2173 647 2184 649 2216"/>
                        </Shape>
                        <String CONTENT="nevertheless, remain a fishing tribe, with clumsy wooden canoes; and they have"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l28" HPOS="649" VPOS="2240" WIDTH="1774" HEIGHT="52" BASELINE="651 2273 2423 2277" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2273 649 2288 2419 2292 2423 2277 2421 2240 651 2240 651 2273"/>
                        </Shape>
                        <String CONTENT="never shown much skill in maritime pursuits, although they crave blubber and"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l29" HPOS="654" VPOS="2299" WIDTH="1061" HEIGHT="52" BASELINE="654 2333 1715 2333" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2333 654 2351 1715 2351 1715 2333 1715 2305 654 2299 654 2333"/>
                        </Shape>
                        <String CONTENT="hides as much as do their northern neighbors."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-166_r6" HPOS="649" VPOS="2354" WIDTH="1778" HEIGHT="729" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="649 2354 2427 2354 2427 3083 649 3083"/>
                    </Shape>
                    <TextLine ID="mz_1-166_l30" HPOS="762" VPOS="2351" WIDTH="1661" HEIGHT="62" BASELINE="762 2394 2423 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="762 2394 762 2409 2421 2413 2423 2394 2423 2364 2369 2351 2367 2351 2295 2362 2228 2351 2226 2351 2224 2351 2195 2362 2118 2351 2115 2351 2046 2364 1942 2364 1927 2351 1925 2351 1923 2351 1920 2351 1918 2351 1897 2362 1873 2351 1871 2351 1868 2351 1866 2351 1840 2362 1823 2351 1821 2351 1819 2351 1816 2351 1814 2351 1788 2364 1580 2364 1544 2351 1541 2351 1539 2351 1461 2362 1431 2351 1429 2351 1427 2351 1424 2351 1399 2362 1377 2351 1375 2351 1373 2351 1370 2351 1351 2362 1336 2351 1334 2351 1331 2351 1329 2351 1327 2351 1301 2362 1245 2351 1243 2351 1240 2351 1214 2362 1197 2351 1195 2351 1193 2351 1191 2351 1188 2351 1165 2362 762 2357 762 2394"/>
                        </Shape>
                        <String CONTENT="The Chukchee and the Asiatic Eskimo cover their boats with walrus-hide,"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l31" HPOS="654" VPOS="2424" WIDTH="1769" HEIGHT="48" BASELINE="654 2455 2423 2455" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2455 654 2472 2423 2472 2423 2455 2423 2424 654 2424 654 2455"/>
                        </Shape>
                        <String CONTENT="which is split for the purpose, one thin strip being left intact for joining the"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l32" HPOS="654" VPOS="2472" WIDTH="1769" HEIGHT="58" BASELINE="654 2513 2423 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2513 654 2530 2423 2530 2423 2513 2423 2485 2176 2485 2159 2472 2156 2472 2154 2472 2152 2472 2070 2483 2055 2472 2053 2472 2050 2472 2048 2472 1946 2483 1886 2472 1884 2472 1881 2472 1853 2483 1756 2472 1754 2472 1695 2483 1561 2472 1559 2472 1557 2472 1526 2483 1414 2472 1412 2472 1409 2472 1375 2483 1282 2472 1279 2472 1277 2472 1249 2483 1212 2472 1210 2472 1208 2472 1110 2483 1069 2472 1067 2472 1065 2472 989 2483 920 2472 918 2472 853 2483 654 2478 654 2513"/>
                        </Shape>
                        <String CONTENT="halves. The walrus-hide is so large that a skin and a half suffice to cover"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l33" HPOS="654" VPOS="2543" WIDTH="1767" HEIGHT="48" BASELINE="654 2574 2421 2574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2574 654 2591 2419 2591 2421 2574 2419 2543 654 2543 654 2574"/>
                        </Shape>
                        <String CONTENT="the largest boat. The specimen in the American Museum of Natural History"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l34" HPOS="649" VPOS="2598" WIDTH="1772" HEIGHT="51" BASELINE="651 2634 2421 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="651 2634 651 2649 2419 2647 2421 2630 2414 2598 649 2600 651 2634"/>
                        </Shape>
                        <String CONTENT="is thirty-five feet long and is covered with less than two skins. Ground-seal"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l35" HPOS="651" VPOS="2665" WIDTH="1772" HEIGHT="45" BASELINE="651 2693 2423 2693" TAGREFS="TYPE_4">
                        <Shape>
