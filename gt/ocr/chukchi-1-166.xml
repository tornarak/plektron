                        </Shape>
                        <String CONTENT="skin, though quite suitable for boat-coverings, is never used because of its"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l36" HPOS="654" VPOS="2712" WIDTH="1769" HEIGHT="63" BASELINE="654 2753 2423 2753" TAGREFS="TYPE_4">
                        <Shape>
