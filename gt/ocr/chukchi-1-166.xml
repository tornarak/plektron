                        </Shape>
                        <String CONTENT="great value for thongs and soles. The Koryak, on the contrary, cover their"/>
                    </TextLine>

                    <TextLine ID="mz_1-166_l37" HPOS="654" VPOS="2771" WIDTH="1769" HEIGHT="60" BASELINE="654 2814 2423 2814" TAGREFS="TYPE_4">
                        <Shape>
