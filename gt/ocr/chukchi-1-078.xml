                    <TextLine ID="mz_1-078_l1" HPOS="1334" VPOS="614" WIDTH="617" HEIGHT="54" BASELINE="1336 647 1951 651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1942 614 1641 614 1639 614 1617 614 1596 614 1574 614 1552 614 1531 614 1509 614 1487 614 1466 614 1444 614 1422 614 1401 614 1379 614 1357 614 1336 614 1336 647 1334 664 1946 668 1951 651 1949 632 1942 614"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-078_r2" HPOS="758" VPOS="722" WIDTH="1778" HEIGHT="414" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="758 722 2536 722 2536 1136 758 1136"/>
                    </Shape>
                    <TextLine ID="mz_1-078_l2" HPOS="762" VPOS="729" WIDTH="1773" HEIGHT="50" BASELINE="762 762 2535 762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2516 733 2494 733 2473 731 2451 731 2429 729 2408 729 2386 729 762 729 762 762 762 779 2535 779 2535 762 2535 733 2516 733"/>
                        </Shape>
                        <String CONTENT="was spent, however, in war, and very little is known about the trade relations"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l3" HPOS="762" VPOS="790" WIDTH="1773" HEIGHT="47" BASELINE="762 820 2535 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 820 762 837 2535 837 2535 820 2535 790 762 790 762 820"/>
                        </Shape>
                        <String CONTENT="of that period. I heard in the Anadyr that the bartering of iron arms to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l4" HPOS="760" VPOS="844" WIDTH="1773" HEIGHT="58" BASELINE="762 876 2533 881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 876 760 889 783 902 786 902 788 902 2531 894 2533 881 2531 848 762 844 762 876"/>
                        </Shape>
                        <String CONTENT="Chukchee was strictly forbidden, but that they bought kettles and cut iron"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l5" HPOS="760" VPOS="902" WIDTH="1773" HEIGHT="52" BASELINE="762 937 2533 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 937 760 950 2529 954 2533 941 2531 909 762 902 762 937"/>
                        </Shape>
                        <String CONTENT="into knives and arrow-points. Even now old kettles are utilized in this manner."/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l6" HPOS="760" VPOS="961" WIDTH="1771" HEIGHT="60" BASELINE="762 998 2531 1002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 998 760 1013 770 1021 773 1021 775 1021 777 1021 2529 1013 2531 1002 2529 969 762 961 762 998"/>
                        </Shape>
                        <String CONTENT="Firelocks taken in battle were hammered with stones into rough spears.¹ At"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l7" HPOS="762" VPOS="1024" WIDTH="1771" HEIGHT="49" BASELINE="764 1056 2533 1060" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 1056 762 1069 2529 1073 2533 1060 2531 1028 764 1024 764 1056"/>
                        </Shape>
                        <String CONTENT="the present time the Chukchee make knives and adzes out of American files"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l8" HPOS="762" VPOS="1080" WIDTH="1005" HEIGHT="60" BASELINE="764 1112 1767 1117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 1112 762 1134 770 1140 773 1140 775 1140 777 1140 1765 1132 1767 1117 1765 1086 764 1080 764 1112"/>
                        </Shape>
                        <String CONTENT="by hammering them into the desired shape."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-078_r3" HPOS="758" VPOS="1136" WIDTH="1778" HEIGHT="1983" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="758 1136 2536 1136 2536 3119 758 3119"/>
                    </Shape>
                    <TextLine ID="mz_1-078_l9" HPOS="870" VPOS="1136" WIDTH="1665" HEIGHT="59" BASELINE="870 1177 2535 1177" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="870 1177 870 1195 2535 1195 2535 1177 2535 1147 2165 1136 2163 1136 2074 1147 1996 1136 1994 1136 1992 1136 1964 1147 1912 1136 1910 1136 1907 1136 1879 1147 1808 1136 1806 1136 1803 1136 1777 1149 1515 1149 1442 1136 1440 1136 1437 1136 1412 1147 1353 1136 1351 1136 1271 1147 1227 1136 1225 1136 1223 1136 1221 1136 1219 1136 1204 1149 1113 1149 1013 1136 1011 1136 1009 1136 1007 1136 991 1147 892 1136 890 1136 887 1136 885 1136 870 1145 870 1177"/>
                        </Shape>
                        <String CONTENT="ANUI FAIR. — In 1788, forty-one years after the defeat of Pavlutsky, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l10" HPOS="760" VPOS="1203" WIDTH="1771" HEIGHT="52" BASELINE="762 1236 2531 1240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1236 760 1249 2527 1255 2531 1240 2529 1208 762 1203 762 1236"/>
                        </Shape>
                        <String CONTENT="twenty-four years after the recall of the garrison from the fort of Anadyrsk,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l11" HPOS="762" VPOS="1255" WIDTH="1769" HEIGHT="63" BASELINE="764 1296 2531 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 1296 762 1309 2527 1318 2531 1301 2529 1268 2442 1255 2440 1255 2371 1266 2330 1255 2328 1255 2139 1255 2137 1255 2135 1255 2133 1255 2118 1266 2079 1255 2076 1255 2074 1255 2072 1255 2040 1268 1933 1268 1918 1255 1916 1255 1914 1255 1912 1255 1845 1266 1816 1255 1814 1255 1812 1255 1756 1266 1734 1255 1732 1255 1730 1255 764 1257 764 1296"/>
                        </Shape>
                        <String CONTENT="Banner, the chief officer of the town of Sashiversk, on the Indighirka River,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l12" HPOS="760" VPOS="1314" WIDTH="1771" HEIGHT="65" BASELINE="762 1359 2531 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1359 762 1374 2527 1379 2531 1355 2527 1324 1645 1314 1643 1314 1559 1324 803 1316 801 1316 799 1316 760 1327 762 1359"/>
                        </Shape>
                        <String CONTENT="who also held command over the Kolyma country, succeeded in establishing"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l13" HPOS="757" VPOS="1383" WIDTH="1772" HEIGHT="56" BASELINE="760 1420 2529 1415" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1420 760 1433 2525 1439 2529 1415 2522 1383 757 1385 760 1420"/>
                        </Shape>
                        <String CONTENT="anew peaceful relations with the western Reindeer Chukchee. As a result,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l14" HPOS="760" VPOS="1437" WIDTH="1771" HEIGHT="61" BASELINE="762 1480 2531 1476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1480 762 1493 2527 1498 2531 1476 2527 1446 909 1437 907 1437 760 1448 762 1480"/>
                        </Shape>
                        <String CONTENT="a regular trade was started the following year. A few Chukchee were induced,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l15" HPOS="762" VPOS="1502" WIDTH="1769" HEIGHT="52" BASELINE="764 1539 2531 1532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 1539 764 1554 2529 1552 2531 1532 2527 1504 762 1502 764 1539"/>
                        </Shape>
                        <String CONTENT="by means of gifts and promises, to subject themselves to Russian authority"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l16" HPOS="760" VPOS="1556" WIDTH="1771" HEIGHT="54" BASELINE="762 1597 2531 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1597 762 1610 2529 1608 2531 1593 2527 1565 829 1556 827 1556 760 1567 762 1597"/>
                        </Shape>
                        <String CONTENT="and to pay tribute. The Chukchee were more anxious for trade than the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l17" HPOS="760" VPOS="1621" WIDTH="1771" HEIGHT="61" BASELINE="762 1651 2531 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1651 760 1667 818 1680 820 1680 1589 1671 1669 1682 1671 1682 2529 1671 2531 1656 2529 1625 762 1621 762 1651"/>
                        </Shape>
                        <String CONTENT="Russians. From the Anadyr came complaints that the people of the district"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l18" HPOS="760" VPOS="1675" WIDTH="1775" HEIGHT="65" BASELINE="762 1716 2535 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 1716 762 1729 1643 1740 1645 1740 1708 1729 2533 1729 2535 1712 2531 1675 907 1675 905 1675 760 1686 762 1716"/>
                        </Shape>
                        <String CONTENT="were forgotten by the Russians and did not get any wares. A tradition of"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l19" HPOS="760" VPOS="1744" WIDTH="1773" HEIGHT="48" BASELINE="760 1775 2533 1775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1775 760 1792 2533 1792 2533 1775 2533 1744 760 1744 760 1775"/>
                        </Shape>
                        <String CONTENT="the Anui Chukchee relates that three Chukchee warriors took captive the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l20" HPOS="760" VPOS="1805" WIDTH="1773" HEIGHT="48" BASELINE="760 1835 2533 1835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1835 760 1853 2533 1853 2533 1835 2533 1805 760 1805 760 1835"/>
                        </Shape>
                        <String CONTENT="deputy of the Czarina,² and consented to release him only upon his promise"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l21" HPOS="757" VPOS="1861" WIDTH="1774" HEIGHT="59" BASELINE="760 1892 2531 1896" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1892 757 1907 773 1918 775 1918 777 1918 779 1918 1563 1909 1648 1920 1650 1920 2529 1909 2531 1896 2529 1866 760 1861 760 1892"/>
                        </Shape>
                        <String CONTENT="to establish an annual fair. After this, to appease his anger, they gave him"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l22" HPOS="760" VPOS="1911" WIDTH="1773" HEIGHT="59" BASELINE="760 1957 2533 1957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 1957 760 1970 2533 1970 2533 1957 2533 1924 2447 1911 2445 1911 2393 1922 2371 1911 2369 1911 2367 1911 2364 1911 2362 1911 2343 1922 1931 1911 1929 1911 1866 1922 1808 1911 1806 1911 1713 1922 1652 1911 1650 1911 1591 1922 1565 1911 1563 1911 1561 1911 1492 1922 1429 1911 1427 1911 1424 1911 1422 1911 1409 1922 1386 1911 1383 1911 1381 1911 1282 1922 1258 1911 1256 1911 1253 1911 1251 1911 1227 1922 1126 1911 1123 1911 1121 1911 1095 1924 853 1924 792 1911 790 1911 788 1911 760 1922 760 1957"/>
                        </Shape>
                        <String CONTENT="rich presents of black and blue fox-skins. The Chukchee fair was held at"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l23" HPOS="755" VPOS="1970" WIDTH="1778" HEIGHT="62" BASELINE="757 2017 2533 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="757 2017 757 2032 2531 2028 2533 2013 2529 1980 2440 1970 2438 1970 2436 1970 2434 1970 2419 1983 2252 1983 2195 1970 2193 1970 2087 1980 2020 1970 2018 1970 2016 1970 2014 1970 1998 1983 1875 1983 1767 1970 1765 1970 1762 1970 1730 1980 1643 1970 1641 1970 1639 1970 1637 1970 1622 1983 1580 1972 1578 1972 1576 1972 1574 1972 1539 1983 1353 1972 1351 1972 1299 1985 1173 1985 1158 1972 1156 1972 1154 1972 1152 1972 755 1980 757 2017"/>
                        </Shape>
                        <String CONTENT="irregular intervals, sometimes on the Dry Anui, near Mount Obrom, and at"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l24" HPOS="757" VPOS="2030" WIDTH="1776" HEIGHT="63" BASELINE="760 2078 2533 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2078 760 2093 2533 2087 2533 2074 2531 2043 2481 2030 2479 2030 2477 2030 2475 2030 2449 2043 2319 2043 2302 2030 2299 2030 2297 2030 2295 2030 2241 2041 2219 2030 2217 2030 2215 2030 2213 2030 2211 2030 2195 2043 2098 2043 2050 2030 2048 2030 2046 2030 2044 2030 2005 2041 1977 2030 1975 2030 1972 2030 1970 2030 1968 2030 1949 2043 1814 2043 1762 2030 1760 2030 1637 2043 1591 2032 1589 2032 1587 2032 1585 2032 1546 2043 1528 2032 1526 2032 1524 2032 1522 2032 1461 2043 1383 2032 1381 2032 1275 2043 998 2032 996 2032 887 2043 846 2032 844 2032 842 2032 757 2045 760 2078"/>
                        </Shape>
                        <String CONTENT="a place called Ostrovnoye (“Insular”), sometimes on the Large Anui, near the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l25" HPOS="757" VPOS="2089" WIDTH="1774" HEIGHT="63" BASELINE="760 2136 2531 2130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2136 760 2152 2529 2145 2531 2130 2527 2102 2330 2102 2310 2089 2308 2089 2306 2089 2304 2089 2302 2089 2280 2100 2243 2089 2241 2089 2239 2089 2237 2089 2198 2100 1858 2091 1855 2091 1853 2091 1812 2102 1760 2091 1758 2091 1756 2091 1732 2102 1663 2091 1661 2091 1596 2102 1541 2091 1539 2091 1474 2102 1418 2091 1416 2091 1414 2091 1412 2091 1396 2102 965 2093 963 2093 913 2104 874 2093 872 2093 870 2093 757 2106 760 2136"/>
                        </Shape>
                        <String CONTENT="mouth of its affluent, the Angarka. Finally Ostrovnoye prevailed, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l26" HPOS="760" VPOS="2165" WIDTH="1769" HEIGHT="49" BASELINE="760 2195 2529 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2195 760 2208 2527 2214 2529 2195 2529 2165 760 2165 760 2195"/>
                        </Shape>
                        <String CONTENT="the Chukchee were more numerous on the Dry Anui; moreover, travelling"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l27" HPOS="757" VPOS="2210" WIDTH="1772" HEIGHT="61" BASELINE="760 2255 2529 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2520 2221 2397 2210 2395 2210 2343 2221 2319 2210 2317 2210 2315 2210 2312 2210 2291 2221 2269 2210 2267 2210 2265 2210 2263 2210 2260 2210 2243 2223 2089 2223 2044 2210 2042 2210 2040 2210 1972 2221 1886 2210 1884 2210 1881 2210 1836 2221 1806 2210 1803 2210 1801 2210 1667 2221 1645 2210 1643 2210 1641 2210 1639 2210 1606 2223 1550 2212 1548 2212 1546 2212 1518 2223 1494 2212 1492 2212 1489 2212 1487 2212 1453 2223 1362 2212 1360 2212 1357 2212 1355 2212 1338 2225 1238 2225 1223 2212 1221 2212 1219 2212 1121 2212 1119 2212 1117 2212 1084 2223 955 2212 952 2212 950 2212 924 2223 866 2212 864 2212 757 2225 760 2255 760 2271 2527 2268 2529 2251 2527 2240 2520 2221"/>
                        </Shape>
                        <String CONTENT="on the Large Anui was difficult for dogs and reindeer because of the heavy"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l28" HPOS="760" VPOS="2284" WIDTH="1769" HEIGHT="47" BASELINE="760 2312 2529 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2312 760 2331 2529 2331 2529 2312 2529 2284 760 2284 760 2312"/>
                        </Shape>
                        <String CONTENT="snowfalls; while the Dry Anui, which is contiguous to the tundra, is more"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l29" HPOS="760" VPOS="2342" WIDTH="1771" HEIGHT="48" BASELINE="760 2372 2531 2372" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2372 760 2390 2531 2390 2531 2372 2529 2342 760 2342 760 2372"/>
                        </Shape>
                        <String CONTENT="open to the winds. The Russians built at Ostrovnoye, a wooden fort called"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l30" HPOS="757" VPOS="2392" WIDTH="1774" HEIGHT="65" BASELINE="760 2429 2531 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2429 757 2448 770 2457 773 2457 775 2457 777 2457 2529 2448 2531 2433 2531 2403 2501 2392 2499 2392 2496 2392 760 2394 760 2429"/>
                        </Shape>
                        <String CONTENT="Fort Anuisk. The fair grew rapidly in importance, and in the second decade"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l31" HPOS="757" VPOS="2448" WIDTH="1768" HEIGHT="65" BASELINE="760 2491 2525 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2491 757 2504 2520 2513 2525 2496 2525 2463 2483 2450 2481 2450 2479 2450 2044 2461 2016 2450 2014 2450 2011 2450 2009 2450 2007 2450 1994 2461 1981 2450 1979 2450 1977 2450 1803 2450 1801 2450 1799 2450 1797 2450 1782 2463 1680 2463 1615 2448 1613 2448 1524 2461 1390 2461 1366 2448 1364 2448 1362 2448 1262 2459 1208 2448 1206 2448 1204 2448 1180 2461 955 2461 937 2448 935 2448 933 2448 931 2448 929 2448 907 2459 864 2448 861 2448 859 2448 760 2457 760 2491"/>
                        </Shape>
                        <String CONTENT="of the last century its traffic amounted to two hundred thousand rubles³ yearly,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l32" HPOS="760" VPOS="2511" WIDTH="1767" HEIGHT="58" BASELINE="760 2554 2527 2554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2520 2517 2507 2511 2505 2511 2503 2511 2501 2511 2397 2522 2291 2511 2289 2511 2286 2511 2250 2522 2211 2511 2208 2511 2206 2511 2204 2511 2174 2522 1648 2511 1645 2511 1589 2522 1518 2511 1515 2511 1466 2522 1429 2511 1427 2511 1424 2511 1422 2511 1420 2511 1405 2524 1295 2524 1271 2511 1269 2511 1121 2511 1119 2511 1117 2511 1115 2511 1100 2524 952 2524 922 2511 920 2511 918 2511 916 2511 892 2522 803 2511 801 2511 799 2511 760 2522 760 2554 760 2569 2525 2569 2527 2554 2527 2537 2520 2517"/>
                        </Shape>
                        <String CONTENT="which is a considerable sum in view of the scarcity of money in that period."/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l33" HPOS="757" VPOS="2574" WIDTH="1772" HEIGHT="56" BASELINE="760 2615 2529 2608" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2615 760 2630 2527 2626 2529 2608 2522 2574 757 2578 760 2615"/>
                        </Shape>
                        <String CONTENT="Some of the best peltries (such as beaver, marten, and lynx), muskrat and"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l34" HPOS="757" VPOS="2636" WIDTH="1772" HEIGHT="52" BASELINE="760 2673 2529 2667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2673 760 2688 2527 2682 2529 2667 2522 2636 757 2641 760 2673"/>
                        </Shape>
                        <String CONTENT="marten garments, also a large portion of every kind of fox and polar-bear"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l35" HPOS="757" VPOS="2697" WIDTH="1770" HEIGHT="52" BASELINE="760 2734 2527 2727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2734 760 2749 2525 2747 2527 2727 2520 2697 757 2701 760 2734"/>
                        </Shape>
                        <String CONTENT="skins and of walrus-tusks, came from the American shore. For instance, in"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l36" HPOS="760" VPOS="2751" WIDTH="1771" HEIGHT="57" BASELINE="762 2795 2531 2790" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 2795 762 2808 2529 2803 2531 2790 2527 2760 801 2751 799 2751 796 2751 760 2762 762 2795"/>
                        </Shape>
                        <String CONTENT="1837, according to data contained in the official records found among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l37" HPOS="760" VPOS="2823" WIDTH="1767" HEIGHT="49" BASELINE="760 2853 2527 2853" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="760 2853 760 2866 2522 2872 2527 2853 2525 2823 760 2823 760 2853"/>
                        </Shape>
                        <String CONTENT="archives of Kolyma, there were sold at the fair 100 beavers, 395 martens,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l38" HPOS="762" VPOS="2879" WIDTH="1767" HEIGHT="54" BASELINE="764 2916 2529 2909" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="764 2916 764 2933 2527 2931 2529 2909 2522 2879 762 2883 764 2916"/>
                        </Shape>
