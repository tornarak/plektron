                        <Shape>
                            <Polygon POINTS="1921 599 1620 599 1618 599 1596 599 1575 599 1553 599 1531 599 1510 599 1488 599 1466 599 1445 599 1423 599 1401 599 1380 599 1358 599 1336 599 1315 599 1315 632 1313 649 1925 653 1930 636 1928 617 1921 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-078_r2" HPOS="737" VPOS="707" WIDTH="1778" HEIGHT="414" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="737 707 2515 707 2515 1121 737 1121"/>
                    </Shape>
                    <TextLine ID="mz_1-078_l2" HPOS="741" VPOS="714" WIDTH="1773" HEIGHT="50" BASELINE="741 747 2514 747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2495 718 2473 718 2452 716 2430 716 2408 714 2387 714 2365 714 741 714 741 747 741 764 2514 764 2514 747 2514 718 2495 718"/>
                        </Shape>
                        <String CONTENT="was spent, however, in war, and very little is known about the trade relations"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l3" HPOS="741" VPOS="775" WIDTH="1773" HEIGHT="47" BASELINE="741 805 2514 805" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 805 741 822 2514 822 2514 805 2514 775 741 775 741 805"/>
                        </Shape>
                        <String CONTENT="of that period. I heard in the Anadyr that the bartering of iron arms to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l4" HPOS="739" VPOS="829" WIDTH="1773" HEIGHT="58" BASELINE="741 861 2512 866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 861 739 874 762 887 765 887 767 887 2510 879 2512 866 2510 833 741 829 741 861"/>
                        </Shape>
                        <String CONTENT="Chukchee was strictly forbidden, but that they bought kettles and cut iron"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l5" HPOS="739" VPOS="887" WIDTH="1773" HEIGHT="52" BASELINE="741 922 2512 926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 922 739 935 2508 939 2512 926 2510 894 741 887 741 922"/>
                        </Shape>
                        <String CONTENT="into knives and arrow-points. Even now old kettles are utilized in this manner."/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l6" HPOS="739" VPOS="946" WIDTH="1771" HEIGHT="60" BASELINE="741 983 2510 987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 983 739 998 749 1006 752 1006 754 1006 756 1006 2508 998 2510 987 2508 954 741 946 741 983"/>
                        </Shape>
                        <String CONTENT="Firelocks taken in battle were hammered with stones into rough spears.¹ At"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l7" HPOS="741" VPOS="1009" WIDTH="1771" HEIGHT="49" BASELINE="743 1041 2512 1045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1041 741 1054 2508 1058 2512 1045 2510 1013 743 1009 743 1041"/>
                        </Shape>
                        <String CONTENT="the present time the Chukchee make knives and adzes out of American files"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l8" HPOS="741" VPOS="1065" WIDTH="1005" HEIGHT="60" BASELINE="743 1097 1746 1102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1097 741 1119 749 1125 752 1125 754 1125 756 1125 1744 1117 1746 1102 1744 1071 743 1065 743 1097"/>
                        </Shape>
                        <String CONTENT="by hammering them into the desired shape."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-078_r3" HPOS="737" VPOS="1121" WIDTH="1778" HEIGHT="1983" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="737 1121 2515 1121 2515 3104 737 3104"/>
                    </Shape>
                    <TextLine ID="mz_1-078_l9" HPOS="849" VPOS="1121" WIDTH="1665" HEIGHT="59" BASELINE="849 1162 2514 1162" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="849 1162 849 1180 2514 1180 2514 1162 2514 1132 2144 1121 2142 1121 2053 1132 1975 1121 1973 1121 1971 1121 1943 1132 1891 1121 1889 1121 1886 1121 1858 1132 1787 1121 1785 1121 1782 1121 1756 1134 1494 1134 1421 1121 1419 1121 1416 1121 1391 1132 1332 1121 1330 1121 1250 1132 1206 1121 1204 1121 1202 1121 1200 1121 1198 1121 1183 1134 1092 1134 992 1121 990 1121 988 1121 986 1121 970 1132 871 1121 869 1121 866 1121 864 1121 849 1130 849 1162"/>
                        </Shape>
                        <String CONTENT="ANUI FAIR. — In 1788, forty-one years after the defeat of Pavlutsky, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l10" HPOS="739" VPOS="1188" WIDTH="1771" HEIGHT="52" BASELINE="741 1221 2510 1225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1221 739 1234 2506 1240 2510 1225 2508 1193 741 1188 741 1221"/>
                        </Shape>
                        <String CONTENT="twenty-four years after the recall of the garrison from the fort of Anadyrsk,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l11" HPOS="741" VPOS="1240" WIDTH="1769" HEIGHT="63" BASELINE="743 1281 2510 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1281 741 1294 2506 1303 2510 1286 2508 1253 2421 1240 2419 1240 2350 1251 2309 1240 2307 1240 2118 1240 2116 1240 2114 1240 2112 1240 2097 1251 2058 1240 2055 1240 2053 1240 2051 1240 2019 1253 1912 1253 1897 1240 1895 1240 1893 1240 1891 1240 1824 1251 1795 1240 1793 1240 1791 1240 1735 1251 1713 1240 1711 1240 1709 1240 743 1242 743 1281"/>
                        </Shape>
                        <String CONTENT="Banner, the chief officer of the town of Sashiversk, on the Indighirka River,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l12" HPOS="739" VPOS="1299" WIDTH="1771" HEIGHT="65" BASELINE="741 1344 2510 1340" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1344 741 1359 2506 1364 2510 1340 2506 1309 1624 1299 1622 1299 1538 1309 782 1301 780 1301 778 1301 739 1312 741 1344"/>
                        </Shape>
                        <String CONTENT="who also held command over the Kolyma country, succeeded in establishing"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l13" HPOS="736" VPOS="1368" WIDTH="1772" HEIGHT="56" BASELINE="739 1405 2508 1400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1405 739 1418 2504 1424 2508 1400 2501 1368 736 1370 739 1405"/>
                        </Shape>
                        <String CONTENT="anew peaceful relations with the western Reindeer Chukchee. As a result,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l14" HPOS="739" VPOS="1422" WIDTH="1771" HEIGHT="61" BASELINE="741 1465 2510 1461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1465 741 1478 2506 1483 2510 1461 2506 1431 888 1422 886 1422 739 1433 741 1465"/>
                        </Shape>
                        <String CONTENT="a regular trade was started the following year. A few Chukchee were induced,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l15" HPOS="741" VPOS="1487" WIDTH="1769" HEIGHT="52" BASELINE="743 1524 2510 1517" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 1524 743 1539 2508 1537 2510 1517 2506 1489 741 1487 743 1524"/>
                        </Shape>
                        <String CONTENT="by means of gifts and promises, to subject themselves to Russian authority"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l16" HPOS="739" VPOS="1541" WIDTH="1771" HEIGHT="54" BASELINE="741 1582 2510 1578" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1582 741 1595 2508 1593 2510 1578 2506 1550 808 1541 806 1541 739 1552 741 1582"/>
                        </Shape>
                        <String CONTENT="and to pay tribute. The Chukchee were more anxious for trade than the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l17" HPOS="739" VPOS="1606" WIDTH="1771" HEIGHT="61" BASELINE="741 1636 2510 1641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1636 739 1652 797 1665 799 1665 1568 1656 1648 1667 1650 1667 2508 1656 2510 1641 2508 1610 741 1606 741 1636"/>
                        </Shape>
                        <String CONTENT="Russians. From the Anadyr came complaints that the people of the district"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l18" HPOS="739" VPOS="1660" WIDTH="1775" HEIGHT="65" BASELINE="741 1701 2514 1697" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1701 741 1714 1622 1725 1624 1725 1687 1714 2512 1714 2514 1697 2510 1660 886 1660 884 1660 739 1671 741 1701"/>
                        </Shape>
                        <String CONTENT="were forgotten by the Russians and did not get any wares. A tradition of"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l19" HPOS="739" VPOS="1729" WIDTH="1773" HEIGHT="48" BASELINE="739 1760 2512 1760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1760 739 1777 2512 1777 2512 1760 2512 1729 739 1729 739 1760"/>
                        </Shape>
                        <String CONTENT="the Anui Chukchee relates that three Chukchee warriors took captive the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l20" HPOS="739" VPOS="1790" WIDTH="1773" HEIGHT="48" BASELINE="739 1820 2512 1820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1820 739 1838 2512 1838 2512 1820 2512 1790 739 1790 739 1820"/>
                        </Shape>
                        <String CONTENT="deputy of the Czarina,² and consented to release him only upon his promise"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l21" HPOS="736" VPOS="1846" WIDTH="1774" HEIGHT="59" BASELINE="739 1877 2510 1881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1877 736 1892 752 1903 754 1903 756 1903 758 1903 1542 1894 1627 1905 1629 1905 2508 1894 2510 1881 2508 1851 739 1846 739 1877"/>
                        </Shape>
                        <String CONTENT="to establish an annual fair. After this, to appease his anger, they gave him"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l22" HPOS="739" VPOS="1896" WIDTH="1773" HEIGHT="59" BASELINE="739 1942 2512 1942" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1942 739 1955 2512 1955 2512 1942 2512 1909 2426 1896 2424 1896 2372 1907 2350 1896 2348 1896 2346 1896 2343 1896 2341 1896 2322 1907 1910 1896 1908 1896 1845 1907 1787 1896 1785 1896 1692 1907 1631 1896 1629 1896 1570 1907 1544 1896 1542 1896 1540 1896 1471 1907 1408 1896 1406 1896 1403 1896 1401 1896 1388 1907 1365 1896 1362 1896 1360 1896 1261 1907 1237 1896 1235 1896 1232 1896 1230 1896 1206 1907 1105 1896 1102 1896 1100 1896 1074 1909 832 1909 771 1896 769 1896 767 1896 739 1907 739 1942"/>
                        </Shape>
                        <String CONTENT="rich presents of black and blue fox-skins. The Chukchee fair was held at"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l23" HPOS="734" VPOS="1955" WIDTH="1778" HEIGHT="62" BASELINE="736 2002 2512 1998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2002 736 2017 2510 2013 2512 1998 2508 1965 2419 1955 2417 1955 2415 1955 2413 1955 2398 1968 2231 1968 2174 1955 2172 1955 2066 1965 1999 1955 1997 1955 1995 1955 1993 1955 1977 1968 1854 1968 1746 1955 1744 1955 1741 1955 1709 1965 1622 1955 1620 1955 1618 1955 1616 1955 1601 1968 1559 1957 1557 1957 1555 1957 1553 1957 1518 1968 1332 1957 1330 1957 1278 1970 1152 1970 1137 1957 1135 1957 1133 1957 1131 1957 734 1965 736 2002"/>
                        </Shape>
                        <String CONTENT="irregular intervals, sometimes on the Dry Anui, near Mount Obrom, and at"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l24" HPOS="736" VPOS="2015" WIDTH="1776" HEIGHT="63" BASELINE="739 2063 2512 2059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2063 739 2078 2512 2072 2512 2059 2510 2028 2460 2015 2458 2015 2456 2015 2454 2015 2428 2028 2298 2028 2281 2015 2278 2015 2276 2015 2274 2015 2220 2026 2198 2015 2196 2015 2194 2015 2192 2015 2190 2015 2174 2028 2077 2028 2029 2015 2027 2015 2025 2015 2023 2015 1984 2026 1956 2015 1954 2015 1951 2015 1949 2015 1947 2015 1928 2028 1793 2028 1741 2015 1739 2015 1616 2028 1570 2017 1568 2017 1566 2017 1564 2017 1525 2028 1507 2017 1505 2017 1503 2017 1501 2017 1440 2028 1362 2017 1360 2017 1254 2028 977 2017 975 2017 866 2028 825 2017 823 2017 821 2017 736 2030 739 2063"/>
                        </Shape>
                        <String CONTENT="a place called Ostrovnoye (“Insular”), sometimes on the Large Anui, near the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l25" HPOS="736" VPOS="2074" WIDTH="1774" HEIGHT="63" BASELINE="739 2121 2510 2115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2121 739 2137 2508 2130 2510 2115 2506 2087 2309 2087 2289 2074 2287 2074 2285 2074 2283 2074 2281 2074 2259 2085 2222 2074 2220 2074 2218 2074 2216 2074 2177 2085 1837 2076 1834 2076 1832 2076 1791 2087 1739 2076 1737 2076 1735 2076 1711 2087 1642 2076 1640 2076 1575 2087 1520 2076 1518 2076 1453 2087 1397 2076 1395 2076 1393 2076 1391 2076 1375 2087 944 2078 942 2078 892 2089 853 2078 851 2078 849 2078 736 2091 739 2121"/>
                        </Shape>
                        <String CONTENT="mouth of its affluent, the Angarka. Finally Ostrovnoye prevailed, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l26" HPOS="739" VPOS="2150" WIDTH="1769" HEIGHT="49" BASELINE="739 2180 2508 2180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2180 739 2193 2506 2199 2508 2180 2508 2150 739 2150 739 2180"/>
                        </Shape>
                        <String CONTENT="the Chukchee were more numerous on the Dry Anui; moreover, travelling"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l27" HPOS="736" VPOS="2195" WIDTH="1772" HEIGHT="61" BASELINE="739 2240 2508 2236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2499 2206 2376 2195 2374 2195 2322 2206 2298 2195 2296 2195 2294 2195 2291 2195 2270 2206 2248 2195 2246 2195 2244 2195 2242 2195 2239 2195 2222 2208 2068 2208 2023 2195 2021 2195 2019 2195 1951 2206 1865 2195 1863 2195 1860 2195 1815 2206 1785 2195 1782 2195 1780 2195 1646 2206 1624 2195 1622 2195 1620 2195 1618 2195 1585 2208 1529 2197 1527 2197 1525 2197 1497 2208 1473 2197 1471 2197 1468 2197 1466 2197 1432 2208 1341 2197 1339 2197 1336 2197 1334 2197 1317 2210 1217 2210 1202 2197 1200 2197 1198 2197 1100 2197 1098 2197 1096 2197 1063 2208 934 2197 931 2197 929 2197 903 2208 845 2197 843 2197 736 2210 739 2240 739 2256 2506 2253 2508 2236 2506 2225 2499 2206"/>
                        </Shape>
                        <String CONTENT="on the Large Anui was difficult for dogs and reindeer because of the heavy"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l28" HPOS="739" VPOS="2269" WIDTH="1769" HEIGHT="47" BASELINE="739 2297 2508 2297" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2297 739 2316 2508 2316 2508 2297 2508 2269 739 2269 739 2297"/>
                        </Shape>
                        <String CONTENT="snowfalls; while the Dry Anui, which is contiguous to the tundra, is more"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l29" HPOS="739" VPOS="2327" WIDTH="1771" HEIGHT="48" BASELINE="739 2357 2510 2357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2357 739 2375 2510 2375 2510 2357 2508 2327 739 2327 739 2357"/>
                        </Shape>
                        <String CONTENT="open to the winds. The Russians built at Ostrovnoye, a wooden fort called"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l30" HPOS="736" VPOS="2377" WIDTH="1774" HEIGHT="65" BASELINE="739 2414 2510 2418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2414 736 2433 749 2442 752 2442 754 2442 756 2442 2508 2433 2510 2418 2510 2388 2480 2377 2478 2377 2475 2377 739 2379 739 2414"/>
                        </Shape>
                        <String CONTENT="Fort Anuisk. The fair grew rapidly in importance, and in the second decade"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l31" HPOS="736" VPOS="2433" WIDTH="1768" HEIGHT="65" BASELINE="739 2476 2504 2481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2476 736 2489 2499 2498 2504 2481 2504 2448 2462 2435 2460 2435 2458 2435 2023 2446 1995 2435 1993 2435 1990 2435 1988 2435 1986 2435 1973 2446 1960 2435 1958 2435 1956 2435 1782 2435 1780 2435 1778 2435 1776 2435 1761 2448 1659 2448 1594 2433 1592 2433 1503 2446 1369 2446 1345 2433 1343 2433 1341 2433 1241 2444 1187 2433 1185 2433 1183 2433 1159 2446 934 2446 916 2433 914 2433 912 2433 910 2433 908 2433 886 2444 843 2433 840 2433 838 2433 739 2442 739 2476"/>
                        </Shape>
                        <String CONTENT="of the last century its traffic amounted to two hundred thousand rubles³ yearly,"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l32" HPOS="739" VPOS="2496" WIDTH="1767" HEIGHT="58" BASELINE="739 2539 2506 2539" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2499 2502 2486 2496 2484 2496 2482 2496 2480 2496 2376 2507 2270 2496 2268 2496 2265 2496 2229 2507 2190 2496 2187 2496 2185 2496 2183 2496 2153 2507 1627 2496 1624 2496 1568 2507 1497 2496 1494 2496 1445 2507 1408 2496 1406 2496 1403 2496 1401 2496 1399 2496 1384 2509 1274 2509 1250 2496 1248 2496 1100 2496 1098 2496 1096 2496 1094 2496 1079 2509 931 2509 901 2496 899 2496 897 2496 895 2496 871 2507 782 2496 780 2496 778 2496 739 2507 739 2539 739 2554 2504 2554 2506 2539 2506 2522 2499 2502"/>
                        </Shape>
                        <String CONTENT="which is a considerable sum in view of the scarcity of money in that period."/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l33" HPOS="736" VPOS="2559" WIDTH="1772" HEIGHT="56" BASELINE="739 2600 2508 2593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2600 739 2615 2506 2611 2508 2593 2501 2559 736 2563 739 2600"/>
                        </Shape>
                        <String CONTENT="Some of the best peltries (such as beaver, marten, and lynx), muskrat and"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l34" HPOS="736" VPOS="2621" WIDTH="1772" HEIGHT="52" BASELINE="739 2658 2508 2652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2658 739 2673 2506 2667 2508 2652 2501 2621 736 2626 739 2658"/>
                        </Shape>
                        <String CONTENT="marten garments, also a large portion of every kind of fox and polar-bear"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l35" HPOS="736" VPOS="2682" WIDTH="1770" HEIGHT="52" BASELINE="739 2719 2506 2712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2719 739 2734 2504 2732 2506 2712 2499 2682 736 2686 739 2719"/>
                        </Shape>
                        <String CONTENT="skins and of walrus-tusks, came from the American shore. For instance, in"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l36" HPOS="739" VPOS="2736" WIDTH="1771" HEIGHT="57" BASELINE="741 2780 2510 2775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 2780 741 2793 2508 2788 2510 2775 2506 2745 780 2736 778 2736 775 2736 739 2747 741 2780"/>
                        </Shape>
                        <String CONTENT="1837, according to data contained in the official records found among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-078_l37" HPOS="739" VPOS="2808" WIDTH="1767" HEIGHT="49" BASELINE="739 2838 2506 2838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2838 739 2851 2501 2857 2506 2838 2504 2808 739 2808 739 2838"/>
                        </Shape>
                        <String CONTENT="archives of Kolyma, there were sold at the fair 100 beavers, 395 martens,"/>
                    </TextLine>

