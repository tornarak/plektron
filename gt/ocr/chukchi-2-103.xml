                <TextBlock ID="text_2-103" HPOS="407" VPOS="499" WIDTH="1782" HEIGHT="2620"><TextLine ID="mz_2-103_l1" HPOS="992" VPOS="499" WIDTH="617" HEIGHT="49" BASELINE="992 530 1609 530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1600 503 1592 499 1004 499 992 509 992 530 992 548 1609 548 1609 530 1609 509 1600 503"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l2" HPOS="2081" VPOS="499" WIDTH="94" HEIGHT="57" BASELINE="2085 544 2175 538" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2085 544 2085 556 2175 554 2175 538 2170 499 2081 507 2085 544"/>
                        </Shape>
                        <String CONTENT="375"/>
                    </TextLine>
<TextLine ID="mz_2-103_l3" HPOS="407" VPOS="597" WIDTH="1776" HEIGHT="57" BASELINE="409 640 2183 636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 603 603 603 589 603 575 611 407 611 409 640 409 654 2181 650 2183 636 2181 609 2158 597 2156 597 2154 597 2152 597 2125 607 2111 597 2109 597 2107 597 2105 597 2103 597 2072 607 1666 597 1664 597 1607 607 1504 597 1502 597 1437 607 1370 597 1369 597 1271 609 1169 599 1167 599 1165 599 1132 609 785 599 783 599 714 609 634 601 622 603"/>
                        </Shape>
                        <String CONTENT="camps of the neighborhood on the same day. Rich reindeer-breeders at their"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l4" HPOS="411" VPOS="669" WIDTH="1772" HEIGHT="47" BASELINE="411 699 2183 699" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 699 411 716 2183 716 2183 699 2183 669 411 669 411 699"/>
                        </Shape>
                        <String CONTENT="slaughtering have guests gathered from far and near, including even members"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l5" HPOS="409" VPOS="714" WIDTH="1553" HEIGHT="67" BASELINE="411 755 1962 761" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 755 409 769 423 779 425 779 426 779 428 779 924 771 938 781 940 781 942 781 944 781 1960 773 1962 761 1962 732 1929 718 1927 718 1925 718 1858 730 1821 718 1819 718 1817 718 1666 728 1635 718 1633 718 1631 718 1629 718 1602 730 1570 718 1568 718 1566 718 1564 718 1527 730 1464 718 1463 718 1461 718 1459 718 1443 730 1325 730 1288 716 1286 716 1284 716 1061 728 1014 716 1012 716 1010 716 1008 716 1006 716 991 730 930 730 898 714 897 714 895 714 893 714 863 728 755 728 722 714 720 714 718 714 656 726 577 714 575 714 573 714 548 726 505 714 503 714 501 714 411 724 411 755"/>
                        </Shape>
                        <String CONTENT="of foreign tribes, such as Lamut, Eskimo, or Russianized Yukaghir."/>
                    </TextLine>
<TextLine ID="mz_2-103_l6" HPOS="519" VPOS="777" WIDTH="1662" HEIGHT="57" BASELINE="520 816 2181 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="520 816 519 828 2177 834 2181 820 2179 791 1997 779 1995 779 1993 779 1954 789 1903 779 1901 779 1684 789 1662 779 1660 779 1533 779 1531 779 1439 789 1408 779 1406 779 1404 779 1402 779 1367 789 1333 777 1331 777 1180 777 1179 777 1177 777 1175 777 1161 787 520 779 520 816"/>
                        </Shape>
                        <String CONTENT="The invitations are sent out beforehand; and if the guests live far away,"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l7" HPOS="407" VPOS="840" WIDTH="1776" HEIGHT="53" BASELINE="409 877 2183 873" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 877 409 893 2181 889 2183 873 2179 847 425 840 423 840 421 840 419 840 407 846 409 877"/>
                        </Shape>
                        <String CONTENT="the host sends some one to bring them, so that there may be no excuse for"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l8" HPOS="409" VPOS="898" WIDTH="1768" HEIGHT="55" BASELINE="409 938 2177 938" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 938 409 953 2175 953 2177 938 2173 898 2126 908 2046 898 2044 898 2042 898 2013 908 1837 898 1835 898 1747 908 1694 898 1692 898 1613 908 1562 898 1560 898 1558 898 1535 908 1486 898 1484 898 1482 898 1447 908 1390 898 1388 898 1386 898 1384 898 1369 910 1116 910 1085 898 1083 898 1081 898 1079 898 1049 908 1012 898 1010 898 1008 898 906 908 850 898 848 898 846 898 810 908 755 898 754 898 679 908 591 898 589 898 520 908 428 898 426 898 425 898 423 898 409 906 409 938"/>
                        </Shape>
                        <String CONTENT="their missing the feast. It is customary for the host, if possible, to “wrap”"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l9" HPOS="411" VPOS="959" WIDTH="1772" HEIGHT="55" BASELINE="411 998 2183 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 998 411 1014 2183 1014 2183 998 2183 971 2103 959 2101 959 2099 959 2060 969 1568 959 1566 959 1564 959 1539 971 1312 971 1220 959 1218 959 1216 959 1179 969 1126 959 1124 959 1122 959 1100 971 957 971 922 959 920 959 918 959 916 959 893 969 814 959 812 959 810 959 808 959 793 971 575 971 517 959 515 959 513 959 491 969 436 959 434 959 432 959 411 969 411 998"/>
                        </Shape>
                        <String CONTENT="all the guests; that is, to make them presents of fawn-skins, killing a fawn"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l10" HPOS="407" VPOS="1018" WIDTH="1778" HEIGHT="64" BASELINE="409 1057 2185 1053" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1057 409 1073 752 1073 820 1082 822 1082 824 1082 826 1082 842 1073 1155 1073 1294 1082 1296 1082 1298 1082 1300 1082 1316 1071 1531 1081 1533 1081 2183 1069 2185 1053 2181 1028 1376 1018 1374 1018 1292 1030 407 1030 409 1057"/>
                        </Shape>
                        <String CONTENT="for each. If any distinction is made, a female guest takes precedence over"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l11" HPOS="407" VPOS="1079" WIDTH="1778" HEIGHT="54" BASELINE="409 1120 2185 1116" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1120 409 1133 2183 1129 2185 1116 2181 1090 1410 1079 1408 1079 1347 1088 1296 1079 1294 1079 1182 1090 832 1081 830 1081 738 1090 691 1081 689 1081 589 1090 536 1081 534 1081 407 1092 409 1120"/>
                        </Shape>
                        <String CONTENT="a male, and a stranger over a relative. Usually one fawn-skin is given to"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l12" HPOS="409" VPOS="1137" WIDTH="1776" HEIGHT="57" BASELINE="411 1178 2185 1173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1178 411 1194 2183 1190 2185 1173 2181 1147 1652 1137 1651 1137 1586 1147 479 1141 477 1141 409 1151 411 1178"/>
                        </Shape>
                        <String CONTENT="each guest, while the first-comer gets two or three skins. Any other guest"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l13" HPOS="411" VPOS="1198" WIDTH="1774" HEIGHT="55" BASELINE="413 1237 2185 1233" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1237 413 1253 2183 1253 2185 1233 2179 1198 1294 1208 446 1200 444 1200 442 1200 411 1210 413 1237"/>
                        </Shape>
                        <String CONTENT="who is bold enough to ask may also get more. To refuse such a demand"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l14" HPOS="411" VPOS="1259" WIDTH="1772" HEIGHT="55" BASELINE="411 1298 2183 1298" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1298 411 1314 2183 1314 2183 1298 2183 1270 2091 1259 2089 1259 2087 1259 2050 1269 2013 1259 2011 1259 2009 1259 2007 1259 1972 1269 1944 1259 1942 1259 1750 1259 1748 1259 1747 1259 1711 1269 1558 1259 1557 1259 1496 1269 1419 1259 1417 1259 1361 1269 1302 1259 1300 1259 1206 1269 411 1263 411 1298"/>
                        </Shape>
                        <String CONTENT="is dangerous, because the guest might take offence, and bewitch the host."/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l15" HPOS="409" VPOS="1323" WIDTH="1776" HEIGHT="51" BASELINE="411 1359 2185 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1359 411 1374 2183 1370 2185 1355 2181 1327 409 1323 411 1359"/>
                        </Shape>
                        <String CONTENT="It is considered improper to make a present of meat, and keep the skin for"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l16" HPOS="411" VPOS="1390" WIDTH="1776" HEIGHT="41" BASELINE="411 1417 2187 1417" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1417 411 1431 2187 1431 2187 1417 2187 1390 411 1390 411 1417"/>
                        </Shape>
                        <String CONTENT="one’s own use. One who receives such a gift resents it, and may declare"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l17" HPOS="407" VPOS="1435" WIDTH="1778" HEIGHT="57" BASELINE="409 1478 2185 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1478 409 1492 2183 1490 2185 1474 2183 1447 2160 1435 2158 1435 2156 1435 2154 1435 2128 1445 2105 1435 2103 1435 2101 1435 2099 1435 2072 1447 1821 1447 1795 1435 1794 1435 1792 1435 1741 1445 1694 1435 1692 1435 1617 1445 1551 1435 1549 1435 1486 1445 1457 1435 1455 1435 1453 1435 1365 1445 1296 1435 1294 1435 1292 1435 1251 1447 1214 1437 1212 1437 1210 1437 959 1447 924 1437 922 1437 920 1437 918 1437 877 1447 785 1437 783 1437 781 1437 755 1447 699 1437 697 1437 695 1437 661 1447 583 1437 581 1437 579 1437 558 1447 544 1437 542 1437 540 1437 438 1437 436 1437 434 1437 407 1447 409 1478"/>
                        </Shape>
                        <String CONTENT="aloud that the fawn does not walk without the skin. On the contrary, it is"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l18" HPOS="409" VPOS="1498" WIDTH="1774" HEIGHT="56" BASELINE="411 1537 2183 1533" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1537 411 1554 2181 1551 2183 1533 2179 1507 1310 1498 1308 1498 1306 1498 1282 1507 468 1500 466 1500 409 1509 411 1537"/>
                        </Shape>
                        <String CONTENT="quite proper to keep the larger part of the meat, and to give only the skin."/>
                    </TextLine>
<TextLine ID="mz_2-103_l19" HPOS="520" VPOS="1556" WIDTH="1665" HEIGHT="67" BASELINE="522 1598 2185 1594" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 1598 522 1611 924 1611 949 1621 951 1621 953 1621 1075 1611 1202 1621 1204 1623 1204 1621 1355 1609 1551 1609 1588 1619 1590 1619 1592 1621 1782 1621 1782 1619 1784 1619 1786 1619 1801 1609 1921 1619 1923 1619 1925 1619 1968 1609 2077 1619 2079 1619 2183 1607 2185 1594 2183 1568 2154 1556 2152 1556 2150 1556 2148 1556 2119 1566 2054 1556 2052 1556 2005 1568 1852 1568 1837 1556 1835 1556 1833 1556 1831 1556 1829 1556 1807 1566 1788 1556 1786 1556 1784 1556 1523 1566 1459 1556 1457 1556 1351 1568 1337 1558 1335 1558 1333 1558 1192 1558 1190 1558 1188 1558 1169 1568 1122 1558 1120 1558 1118 1558 1083 1568 955 1558 953 1558 853 1568 520 1562 522 1598"/>
                        </Shape>
                        <String CONTENT="The number of fawns slaughtered at this ceremonial by a well-to-do"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l20" HPOS="409" VPOS="1617" WIDTH="1778" HEIGHT="55" BASELINE="411 1658 2187 1654" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1658 411 1672 2185 1670 2187 1654 2183 1627 1298 1617 1296 1617 1294 1617 1267 1627 456 1619 454 1619 409 1629 411 1658"/>
                        </Shape>
                        <String CONTENT="reindeer-breeder ranges from about a hundred to a hundred and twenty. At"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l21" HPOS="409" VPOS="1680" WIDTH="1776" HEIGHT="57" BASELINE="411 1715 2185 1719" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1715 409 1729 2181 1737 2185 1719 2183 1688 411 1680 411 1715"/>
                        </Shape>
                        <String CONTENT="least one third of these are distributed among the guests, while the remaining"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l22" HPOS="409" VPOS="1737" WIDTH="1778" HEIGHT="56" BASELINE="409 1776 2187 1776" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1776 409 1793 2185 1793 2187 1776 2185 1748 2138 1737 2136 1737 2134 1737 2105 1748 1982 1748 1964 1737 1962 1737 1960 1737 1866 1737 1864 1737 1862 1737 1860 1737 1844 1746 1633 1737 1631 1737 1629 1737 1594 1746 1557 1737 1555 1737 1553 1737 1551 1737 1519 1746 1486 1737 1484 1737 1482 1737 1416 1746 1382 1737 1380 1737 1378 1737 1376 1737 1357 1746 1278 1737 1276 1737 1275 1737 1273 1737 1257 1746 1231 1737 1229 1737 1227 1737 1226 1737 1224 1737 1208 1748 1098 1748 1083 1737 1081 1737 1079 1737 938 1737 936 1737 934 1737 900 1746 863 1737 861 1737 859 1737 857 1737 832 1748 646 1748 536 1737 534 1737 532 1737 530 1737 513 1748 409 1748 409 1776"/>
                        </Shape>
                        <String CONTENT="two thirds are evenly divided; one half being destined for household uses, the"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l23" HPOS="409" VPOS="1799" WIDTH="1776" HEIGHT="53" BASELINE="411 1838 2185 1834" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1838 411 1852 2183 1848 2185 1834 2181 1807 452 1799 450 1799 448 1799 409 1809 411 1838"/>
                        </Shape>
                        <String CONTENT="other for trade. Guests are not supposed to give return-presents. The poor"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l24" HPOS="411" VPOS="1866" WIDTH="1776" HEIGHT="49" BASELINE="411 1895 2187 1895" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1895 411 1915 2187 1915 2187 1895 2187 1868 411 1866 411 1895"/>
                        </Shape>
                        <String CONTENT="fellow-tribesmen, in truth, give none; but the neighbors afterwards present the"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l25" HPOS="409" VPOS="1913" WIDTH="1778" HEIGHT="68" BASELINE="411 1958 2187 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1958 411 1972 824 1972 879 1981 881 1981 1004 1970 1298 1970 1355 1979 1357 1979 1421 1970 1529 1979 1531 1979 1605 1968 1888 1977 1889 1977 2185 1968 2187 1952 2185 1927 2136 1913 2134 1913 2132 1913 2130 1913 2105 1927 1923 1927 1903 1913 1901 1913 1899 1913 1897 1913 1725 1925 1668 1913 1666 1913 1592 1927 1541 1915 1539 1915 1537 1915 1535 1915 1508 1927 1470 1915 1468 1915 1466 1915 1464 1915 1433 1927 1331 1915 1329 1915 1327 1915 1300 1927 1198 1915 1196 1915 1094 1927 1006 1915 1004 1915 1002 1915 1000 1915 983 1928 910 1917 908 1917 848 1928 771 1917 687 1917 685 1917 683 1917 681 1917 663 1928 626 1917 624 1917 622 1917 538 1928 501 1917 499 1917 497 1917 409 1923 411 1958"/>
                        </Shape>
                        <String CONTENT="host with similar gifts. The visitors from foreign tribes usually return the"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l26" HPOS="409" VPOS="1974" WIDTH="1776" HEIGHT="58" BASELINE="411 2019 2185 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2019 411 2032 2183 2026 2185 2013 2181 1985 1972 1974 1970 1974 1889 1983 1833 1974 1831 1974 1829 1974 1805 1983 1745 1974 1743 1974 1696 1983 1629 1974 1627 1974 1625 1974 1588 1985 1478 1975 1476 1975 1474 1975 1447 1985 1222 1975 1220 1975 1218 1975 1192 1987 1000 1987 983 1977 981 1977 979 1977 977 1977 873 1987 816 1977 814 1977 812 1977 793 1987 528 1977 526 1977 409 1989 411 2019"/>
                        </Shape>
                        <String CONTENT="compliment later by giving some of their products. The Maritime Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l27" HPOS="409" VPOS="2032" WIDTH="1780" HEIGHT="67" BASELINE="411 2077 2189 2071" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2077 411 2091 1594 2099 1596 2099 1651 2089 2170 2097 2172 2097 2173 2097 2175 2097 2189 2087 2189 2071 2181 2034 2140 2044 2093 2032 2091 2032 2089 2032 2087 2032 2085 2032 2064 2046 1907 2046 1872 2032 1870 2032 1868 2032 1813 2044 1794 2032 1792 2032 1790 2032 1721 2032 1719 2032 1717 2032 1715 2032 1696 2046 1582 2046 1557 2034 1555 2034 1553 2034 1551 2034 1549 2034 1531 2048 1425 2048 1396 2034 1394 2034 1392 2034 1390 2034 1359 2046 1339 2034 1337 2034 1335 2034 1333 2034 1331 2034 1308 2044 1275 2034 1273 2034 1271 2034 1204 2046 1122 2034 1120 2034 1118 2034 1083 2046 1047 2034 1045 2034 1043 2034 975 2048 844 2036 842 2036 779 2048 716 2036 614 2036 613 2036 611 2036 609 2036 593 2046 479 2036 477 2036 409 2050 411 2077"/>
                        </Shape>
                        <String CONTENT="and the Eskimo, for example, bring their former host a little oil or a coil of"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l28" HPOS="409" VPOS="2095" WIDTH="1778" HEIGHT="57" BASELINE="411 2138 2187 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2138 411 2152 2185 2148 2187 2134 2183 2101 2093 2095 2091 2095 2089 2095 2060 2105 2029 2095 2027 2095 2025 2095 1974 2105 1927 2095 1925 2095 1880 2105 1852 2095 1850 2095 1848 2095 1846 2095 1825 2107 1701 2107 1592 2095 1590 2095 1523 2105 1488 2095 1486 2095 1484 2095 1355 2105 1320 2095 1318 2095 1316 2095 1092 2107 1012 2097 1010 2097 1008 2097 965 2107 908 2097 906 2097 850 2107 699 2097 697 2097 695 2097 667 2107 609 2097 607 2097 548 2107 432 2097 430 2097 428 2097 426 2097 409 2105 411 2138"/>
                        </Shape>
                        <String CONTENT="thong; the Lamut give flint, and tinder made of fungus; the Russianized"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l29" HPOS="417" VPOS="2156" WIDTH="1768" HEIGHT="54" BASELINE="417 2195 2185 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2195 417 2210 2183 2210 2185 2195 2183 2167 2101 2156 2099 2156 2097 2156 2064 2165 2025 2156 2023 2156 2021 2156 1952 2165 1801 2156 1799 2156 1797 2156 1795 2156 1780 2167 1564 2167 1535 2156 1533 2156 1531 2156 1453 2165 1425 2156 1423 2156 1421 2156 1322 2165 1292 2156 1290 2156 1288 2156 1286 2156 1263 2167 893 2167 826 2156 824 2156 822 2156 799 2165 785 2156 783 2156 781 2156 687 2156 685 2156 626 2165 564 2156 562 2156 560 2156 532 2165 417 2156 417 2195"/>
                        </Shape>
                        <String CONTENT="Yukaghir, dried fish or a quarter of a cake of compressed tea. The host"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l30" HPOS="409" VPOS="2220" WIDTH="1545" HEIGHT="61" BASELINE="411 2254 1954 2257" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2254 409 2265 450 2279 452 2279 454 2279 456 2279 499 2269 620 2279 622 2279 707 2269 787 2279 789 2279 1171 2269 1233 2281 1235 2281 1237 2281 1276 2271 1369 2281 1370 2281 1423 2271 1756 2281 1758 2281 1952 2269 1954 2257 1952 2226 411 2220 411 2254"/>
                        </Shape>
                        <String CONTENT="has no right to grumble, should they bring little or nothing at all."/>
                    </TextLine>
<TextLine ID="mz_2-103_l31" HPOS="519" VPOS="2275" WIDTH="1662" HEIGHT="63" BASELINE="520 2316 2181 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="520 2316 520 2332 2177 2338 2181 2312 2177 2287 1895 2287 1874 2275 1872 2275 1870 2275 1868 2275 1841 2285 1803 2275 1801 2275 1799 2275 1447 2285 1414 2275 1412 2275 1410 2275 1347 2287 1292 2277 1290 2277 1157 2287 519 2281 520 2316"/>
                        </Shape>
                        <String CONTENT="The ceremonial is accompanied by a foot-race, in which, in most cases,"/>
                    </TextLine>

                    <TextLine ID="mz_2-103_l32" HPOS="409" VPOS="2334" WIDTH="1776" HEIGHT="66" BASELINE="411 2377 2185 2373" TAGREFS="TYPE_5">
                        <Shape>
