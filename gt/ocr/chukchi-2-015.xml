                            <Polygon POINTS="415 1940 413 1954 2175 1964 2179 1946 2177 1917 2054 1905 2052 1905 1872 1915 1823 1905 1821 1905 1596 1915 1576 1903 1574 1903 1572 1903 1570 1903 1290 1913 1175 1903 1173 1903 1171 1903 1149 1913 1104 1903 1102 1903 1100 1903 1079 1913 1002 1901 1000 1901 955 1911 912 1901 910 1901 908 1901 906 1901 873 1911 840 1901 838 1901 836 1901 834 1901 802 1913 675 1913 660 1901 658 1901 656 1901 654 1901 652 1901 626 1911 538 1901 536 1901 415 1909 415 1940"/>
                        </Shape>
                        <String CONTENT="world, and move freely within its limits. These beings are anthropomorphous,"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l26" HPOS="411" VPOS="1970" WIDTH="1768" HEIGHT="56" BASELINE="413 2001 2179 2005" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2001 411 2015 650 2026 652 2026 2177 2019 2179 2005 2177 1975 413 1970 413 2001"/>
                        </Shape>
                        <String CONTENT="but more powerful than men; they are invisible, but may appear at will to"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l27" HPOS="413" VPOS="2026" WIDTH="1604" HEIGHT="53" BASELINE="413 2066 2017 2066" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2066 413 2077 2015 2079 2017 2066 2017 2036 1177 2026 1175 2026 1173 2026 1139 2036 1081 2026 1079 2026 1077 2026 1075 2026 1061 2038 577 2038 487 2026 485 2026 413 2036 413 2066"/>
                        </Shape>
                        <String CONTENT="various persons, or are seen by shamans even, against their own will."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_2-015_r6" HPOS="417" VPOS="2127" WIDTH="1776" HEIGHT="999" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="417 2127 2193 2127 2193 3126 417 3126"/>
                    </Shape>
                    <TextLine ID="mz_2-015_l28" HPOS="519" VPOS="2138" WIDTH="1664" HEIGHT="43" BASELINE="519 2163 2183 2163" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="519 2163 519 2181 2181 2181 2183 2163 2181 2138 519 2138 519 2163"/>
                        </Shape>
                        <String CONTENT="¹ See Bogoras, American Anthropologist, Vol. IV, p. 643; Jochelson, Yukaghir Materials, p. 101. Stories about"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l29" HPOS="415" VPOS="2181" WIDTH="1764" HEIGHT="41" BASELINE="415 2205 2179 2205" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2205 415 2222 2179 2222 2179 2205 2179 2181 415 2181 415 2205"/>
                        </Shape>
                        <String CONTENT="the mountains, quite similar to those of the Yukaghir, were in vogue among the Aleut. Thus, according to a"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l30" HPOS="413" VPOS="2220" WIDTH="1768" HEIGHT="45" BASELINE="415 2250 2181 2246" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2250 415 2265 2179 2261 2181 2246 2175 2220 413 2224 415 2250"/>
                        </Shape>
                        <String CONTENT="native story in Veniaminoff (cited from Elie Reclus, Les Primitifs, p. 59), the mountains on Unimak and"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l31" HPOS="413" VPOS="2263" WIDTH="1768" HEIGHT="43" BASELINE="415 2291 2181 2287" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2291 415 2306 2179 2304 2181 2287 2175 2263 413 2265 415 2291"/>
                        </Shape>
                        <String CONTENT="Unalashka once wrestled, and threw fire and stones at one another. Several smaller volcanoes, who could not"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l32" HPOS="413" VPOS="2304" WIDTH="1768" HEIGHT="46" BASELINE="415 2334 2181 2328" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2334 415 2350 2179 2346 2181 2328 2175 2304 413 2308 415 2334"/>
                        </Shape>
                        <String CONTENT="fight against the larger ones, split, and were extinguished. Only two large mountains were left, Makushin and"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l33" HPOS="413" VPOS="2350" WIDTH="1768" HEIGHT="41" BASELINE="413 2373 2181 2373" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2373 413 2391 2179 2391 2181 2373 2179 2350 413 2350 413 2373"/>
                        </Shape>
                        <String CONTENT="Retcheshnoy. Stones, fire, and ashes killed every living thing. Retcheshnoy was vanquished, and, when he"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l34" HPOS="411" VPOS="2391" WIDTH="1770" HEIGHT="43" BASELINE="413 2418 2181 2414" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2418 413 2434 2179 2430 2181 2414 2175 2391 411 2393 413 2418"/>
                        </Shape>
                        <String CONTENT="saw his defeat, he mustered his remaining force, and swelled himself to the utmost. Then he burst and was"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l35" HPOS="413" VPOS="2434" WIDTH="1768" HEIGHT="43" BASELINE="413 2459 2181 2459" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2459 413 2477 2179 2477 2181 2459 2179 2434 413 2434 413 2459"/>
                        </Shape>
                        <String CONTENT="extinguished. Makushin went to sleep, and now only a light smoke sometimes issues from him. This tale is"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l36" HPOS="413" VPOS="2475" WIDTH="632" HEIGHT="43" BASELINE="415 2504 1045 2500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2504 415 2518 1043 2514 1045 2500 1039 2475 413 2477 415 2504"/>
                        </Shape>
                        <String CONTENT="quite similar to that told by Jochelson."/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l37" HPOS="522" VPOS="2516" WIDTH="486" HEIGHT="51" BASELINE="524 2541 1008 2545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 2541 522 2553 564 2565 566 2565 567 2565 750 2557 767 2567 769 2567 771 2567 773 2567 1006 2557 1008 2545 1006 2520 524 2516 524 2541"/>
                        </Shape>
                        <String CONTENT="² Compare p. 19, Footnote 2."/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l38" HPOS="519" VPOS="2555" WIDTH="1660" HEIGHT="49" BASELINE="520 2583 2179 2586" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="520 2583 519 2598 2175 2604 2179 2586 2177 2559 520 2555 520 2583"/>
                        </Shape>
                        <String CONTENT="³ The Russo-Chukchee trading-jargon is a kind of broken dialect, with simplified grammar and pronunciation,"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l39" HPOS="411" VPOS="2602" WIDTH="1766" HEIGHT="43" BASELINE="413 2630 2177 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2630 413 2645 2175 2645 2177 2626 2172 2602 411 2604 413 2630"/>
                        </Shape>
                        <String CONTENT="adapted to the use of both parties. The vocabulary is Chukchee with a slight admixture of Russian words. It"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l40" HPOS="411" VPOS="2641" WIDTH="1766" HEIGHT="49" BASELINE="413 2669 2177 2673" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2669 411 2682 2173 2690 2177 2673 2175 2645 413 2641 413 2669"/>
                        </Shape>
                        <String CONTENT="uses also a few dozen other alien words, which the Chukchee call “words of Taˊn˙ñɪt” (Taˊn˙ñɪn-wêˊthaw), meaning,"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l41" HPOS="411" VPOS="2684" WIDTH="1766" HEIGHT="49" BASELINE="413 2710 2177 2714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2710 411 2724 2173 2733 2177 2714 2175 2688 413 2684 413 2710"/>
                        </Shape>
                        <String CONTENT="by this name, likewise the Russians. Nevertheless, these words have nothing in common with the Russian language,"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l42" HPOS="413" VPOS="2729" WIDTH="1762" HEIGHT="44" BASELINE="413 2755 2175 2755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2755 413 2773 2175 2773 2175 2755 2175 2729 413 2729 413 2755"/>
                        </Shape>
                        <String CONTENT="and, on examining them, I found that four-fifths of them belong to the language of the Koryak, who also are"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l43" HPOS="413" VPOS="2773" WIDTH="1659" HEIGHT="41" BASELINE="413 2796 2072 2796" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2796 413 2814 2072 2814 2072 2796 2072 2773 413 2773 413 2796"/>
                        </Shape>
                        <String CONTENT="called by the Chukchee by the name “Genuine Taˊn˙ñɪt” (see p. 19). Such words are, for instance: —"/>
                    </TextLine>

                    <TextLine ID="mz_2-015_l44" HPOS="1615" VPOS="2812" WIDTH="194" HEIGHT="41" BASELINE="1617 2839 1809 2835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1617 2839 1617 2853 1809 2849 1809 2835 1803 2812 1615 2814 1617 2839"/>
                        </Shape>
                        <String CONTENT="Meaning in"/>
                    </TextLine>

