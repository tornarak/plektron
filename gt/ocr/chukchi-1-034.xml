                <TextBlock ID="text_1-034" HPOS="568" VPOS="634" WIDTH="1806" HEIGHT="2622"><TextLine ID="mz_1-034_l1" HPOS="1148" VPOS="634" WIDTH="619" HEIGHT="56" BASELINE="1150 671 1767 675" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1756 664 1737 636 1170 634 1150 643 1150 671 1148 686 1763 690 1767 675 1765 638 1756 636 1756 664"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l2" HPOS="574" VPOS="645" WIDTH="72" HEIGHT="52" BASELINE="576 675 646 682" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 675 574 690 643 697 646 682 646 651 576 645 576 675"/>
                        </Shape>
                        <String CONTENT="14"/>
                    </TextLine>
<TextLine ID="mz_1-034_l3" HPOS="672" VPOS="751" WIDTH="1669" HEIGHT="45" BASELINE="672 781 2341 781" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="672 781 672 796 2341 796 2341 781 2341 751 672 751 672 781"/>
                        </Shape>
                        <String CONTENT="Perhaps it will not be out of place to mention here another Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l4" HPOS="568" VPOS="809" WIDTH="1771" HEIGHT="48" BASELINE="570 842 2339 838" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 842 570 857 2337 855 2339 838 2335 809 568 809 570 842"/>
                        </Shape>
                        <String CONTENT="legend which seems to be even more ancient. In olden times there lived in"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l5" HPOS="570" VPOS="857" WIDTH="1769" HEIGHT="67" BASELINE="572 900 2339 905" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 900 570 915 583 924 585 924 587 924 589 924 2337 920 2339 905 2337 872 2250 859 2248 859 2116 870 2099 859 2097 859 2094 859 2092 859 2014 870 1867 859 1865 859 1811 870 1774 859 1772 859 1769 859 1767 859 1735 870 1698 859 1696 859 1694 859 1313 868 1297 857 1295 857 1293 857 1291 857 1289 857 1263 870 1176 870 1161 857 1159 857 1157 857 1154 857 1152 857 1122 868 999 857 996 857 994 857 992 857 975 868 869 857 866 857 814 868 788 857 786 857 784 857 782 857 780 857 762 868 708 857 706 857 704 857 702 857 687 868 607 857 604 857 602 857 572 866 572 900"/>
                        </Shape>
                        <String CONTENT="the Anui Mountains a large beast called Keliˊlhu.¹ He was tall and long,"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l6" HPOS="570" VPOS="928" WIDTH="1771" HEIGHT="50" BASELINE="570 961 2341 961" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 961 570 978 2341 978 2341 961 2341 933 570 928 570 961"/>
                        </Shape>
                        <String CONTENT="had a huge mouth which opened wide, and long-clawed paws. A certain"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l7" HPOS="568" VPOS="980" WIDTH="1773" HEIGHT="65" BASELINE="570 1024 2341 1019" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 1024 570 1045 2339 1037 2341 1019 2337 985 739 980 736 980 568 991 570 1024"/>
                        </Shape>
                        <String CONTENT="young herdsman wandered among the crags, looking for a lost reindeer, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l8" HPOS="570" VPOS="1039" WIDTH="743" HEIGHT="58" BASELINE="572 1082 1313 1078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1082 572 1097 1310 1095 1313 1078 1308 1050 1042 1039 1040 1039 570 1052 572 1082"/>
                        </Shape>
                        <String CONTENT="was seen and eaten by Keliˊlhu."/>
                    </TextLine>
<TextLine ID="mz_1-034_l9" HPOS="676" VPOS="1099" WIDTH="1665" HEIGHT="59" BASELINE="678 1143 2341 1138" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="678 1143 678 1158 2339 1154 2341 1138 2337 1108 689 1099 687 1099 685 1099 682 1099 682 1102 676 1106 678 1143"/>
                        </Shape>
                        <String CONTENT="Some time afterward the young man’s father started to look for him."/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l10" HPOS="572" VPOS="1158" WIDTH="1771" HEIGHT="61" BASELINE="572 1201 2343 1201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1201 572 1219 2343 1219 2343 1201 2343 1171 2239 1158 2237 1158 2235 1158 2207 1169 2151 1158 2008 1158 2006 1158 2003 1158 2001 1158 1988 1169 1964 1158 1962 1158 1960 1158 1897 1169 1828 1158 1826 1158 1767 1169 1679 1158 1551 1158 1549 1158 1546 1158 1544 1158 1529 1171 1315 1171 1300 1158 1297 1158 1295 1158 1293 1158 1239 1171 1022 1171 1007 1158 1005 1158 1003 1158 1001 1158 999 1158 968 1169 572 1167 572 1201"/>
                        </Shape>
                        <String CONTENT="He went among the crags, and soon met Keliˊlhu. He said, “Keliˊlhu, have"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l11" HPOS="568" VPOS="1219" WIDTH="1775" HEIGHT="69" BASELINE="570 1264 2343 1260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 1264 570 1277 1113 1288 1115 1288 1180 1277 1494 1286 1497 1286 1499 1286 1520 1275 1583 1286 1585 1286 1588 1286 1590 1286 1605 1275 1893 1275 1910 1286 1912 1286 1915 1286 1917 1288 2103 1288 2103 1286 2159 1275 2183 1286 2185 1286 2187 1286 2257 1275 2322 1286 2324 1286 2326 1286 2328 1286 2343 1273 2343 1260 2339 1232 2239 1219 2237 1219 2164 1229 1657 1219 1655 1219 1449 1232 635 1221 633 1221 568 1234 570 1264"/>
                        </Shape>
                        <String CONTENT="a laugh! I am fat, you will eat me; my reindeer are fatter, you will eat"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l12" HPOS="570" VPOS="1277" WIDTH="1771" HEIGHT="69" BASELINE="572 1320 2341 1316" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1320 572 1335 951 1335 1040 1346 1042 1346 1044 1346 1068 1335 1144 1346 1146 1346 1148 1346 1150 1346 1165 1335 1293 1335 1399 1346 1401 1346 1481 1333 1676 1344 1679 1344 1681 1344 1715 1333 1982 1344 1984 1344 2094 1333 2109 1344 2112 1344 2114 1344 2116 1346 2255 1346 2255 1344 2257 1344 2259 1344 2272 1333 2317 1344 2320 1344 2322 1344 2324 1344 2326 1344 2341 1331 2341 1316 2337 1288 1455 1277 1453 1277 1451 1277 1449 1277 1449 1279 1438 1288 591 1279 589 1279 587 1279 585 1279 570 1286 572 1320"/>
                        </Shape>
                        <String CONTENT="them too.” — “Ha, ha, ha!” laughed Keliˊlhu; and his mouth opened so"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l13" HPOS="576" VPOS="1351" WIDTH="1765" HEIGHT="47" BASELINE="576 1381 2341 1381" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 1381 576 1398 2341 1398 2341 1381 2341 1351 576 1351 576 1381"/>
                        </Shape>
                        <String CONTENT="wide that his upper jaw reached his back, while his lower jaw hung down to"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l14" HPOS="570" VPOS="1403" WIDTH="1769" HEIGHT="58" BASELINE="572 1437 2339 1444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1437 570 1452 2335 1461 2339 1444 2337 1411 572 1403 572 1437"/>
                        </Shape>
                        <String CONTENT="his breast. When he stopped laughing, he closed his jaws with his paws,"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l15" HPOS="570" VPOS="1468" WIDTH="1769" HEIGHT="47" BASELINE="572 1498 2339 1502" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1498 570 1511 2335 1515 2339 1502 2337 1472 572 1468 572 1498"/>
                        </Shape>
                        <String CONTENT="and continued his pursuit; but the man had succeeded in gaining ground."/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l16" HPOS="570" VPOS="1526" WIDTH="1767" HEIGHT="54" BASELINE="572 1558 2337 1563" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1558 570 1574 2333 1580 2337 1563 2335 1530 572 1526 572 1558"/>
                        </Shape>
                        <String CONTENT="After a while the beast approached him again; but the man repeated, “Keliˊlhu,"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l17" HPOS="570" VPOS="1584" WIDTH="1773" HEIGHT="59" BASELINE="572 1617 2343 1621" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 1617 570 1634 581 1643 583 1643 585 1643 587 1643 2341 1634 2343 1621 2341 1584 572 1584 572 1617"/>
                        </Shape>
                        <String CONTENT="have a laugh! I am fat, you will eat me; my reindeer are fatter, you will"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l18" HPOS="574" VPOS="1639" WIDTH="1767" HEIGHT="69" BASELINE="574 1680 2341 1680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1680 574 1697 1048 1697 1122 1708 1124 1708 1126 1708 1152 1697 1219 1708 1222 1708 1224 1708 1254 1697 1451 1708 1453 1708 1575 1697 2259 1708 2261 1708 2339 1695 2341 1680 2339 1652 1488 1639 1486 1639 1434 1649 1412 1639 1410 1639 1271 1639 1269 1639 1267 1639 1222 1649 1176 1639 1174 1639 1172 1639 1118 1649 1038 1639 1035 1639 938 1649 901 1639 899 1639 897 1639 784 1649 693 1639 691 1639 689 1639 650 1649 604 1639 602 1639 600 1639 598 1639 574 1649 574 1680"/>
                        </Shape>
                        <String CONTENT="eat them too.” — “Ha, ha, ha!” laughed Keliˊlhu; and his jaws sprang as"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l19" HPOS="572" VPOS="1701" WIDTH="1771" HEIGHT="59" BASELINE="574 1742 2343 1736" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1742 574 1760 2341 1753 2343 1736 2339 1706 609 1701 607 1701 604 1701 572 1712 574 1742"/>
                        </Shape>
                        <String CONTENT="wide apart as before, and he closed them in the same manner, and continued"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l20" HPOS="572" VPOS="1764" WIDTH="1771" HEIGHT="61" BASELINE="574 1797 2343 1801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1797 572 1812 661 1825 663 1825 2341 1816 2343 1801 2341 1771 574 1764 574 1797"/>
                        </Shape>
                        <String CONTENT="his pursuit. At last they reached the village, where a number of young men"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l21" HPOS="572" VPOS="1823" WIDTH="1771" HEIGHT="54" BASELINE="574 1857 2343 1862" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1857 572 1872 2339 1877 2343 1862 2341 1829 574 1823 574 1857"/>
                        </Shape>
                        <String CONTENT="killed Keliˊlhu with spears; but he had also killed many, because he was light"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l22" HPOS="572" VPOS="1877" WIDTH="1631" HEIGHT="67" BASELINE="574 1918 2203 1922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 1918 572 1935 583 1944 585 1944 587 1944 589 1944 2200 1935 2203 1922 2200 1892 1904 1879 1902 1879 1707 1890 1683 1879 1681 1879 1679 1879 1577 1890 1549 1879 1546 1879 1544 1879 1445 1890 1388 1877 1386 1877 1384 1877 1382 1877 1380 1877 1367 1888 1345 1877 1343 1877 1341 1877 1265 1888 1230 1877 1228 1877 1226 1877 1170 1888 1137 1877 1135 1877 1133 1877 574 1885 574 1918"/>
                        </Shape>
                        <String CONTENT="and nimble, jumped high, bit with his teeth, and smote with his paws."/>
                    </TextLine>
<TextLine ID="mz_1-034_l23" HPOS="676" VPOS="1935" WIDTH="1667" HEIGHT="63" BASELINE="678 1981 2343 1976" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="678 1981 678 1998 2341 1994 2343 1976 2341 1946 2320 1935 2317 1935 2315 1935 2313 1935 2311 1935 2298 1948 2216 1948 2192 1935 2190 1935 2187 1935 2185 1935 2183 1935 2170 1948 2010 1948 1986 1935 1984 1935 1982 1935 1980 1935 1958 1946 1945 1935 1943 1935 1941 1935 1938 1935 1936 1935 1906 1946 1854 1935 1852 1935 1782 1946 1722 1935 1720 1935 1718 1935 1694 1946 1635 1935 1633 1935 1631 1935 1583 1946 1514 1935 1512 1935 1510 1935 1481 1950 1384 1950 1367 1937 1365 1937 1362 1937 1360 1937 1297 1948 1232 1937 1230 1937 1170 1948 938 1937 936 1937 676 1946 678 1981"/>
                        </Shape>
                        <String CONTENT="PRESENT HABITAT. — The villages of the Maritime Chukchee are situated"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l24" HPOS="570" VPOS="2000" WIDTH="1773" HEIGHT="65" BASELINE="572 2035 2343 2039" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2035 570 2050 676 2063 678 2063 1380 2054 1507 2065 1510 2065 2341 2054 2343 2039 2339 2000 572 2004 572 2035"/>
                        </Shape>
                        <String CONTENT="on the Arctic coast between Cape Erri and East Cape, and on the coast of"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l25" HPOS="572" VPOS="2059" WIDTH="1769" HEIGHT="60" BASELINE="572 2100 2341 2100" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2100 572 2119 2341 2119 2341 2100 2341 2072 2263 2059 2172 2059 2170 2059 2168 2059 2166 2059 2153 2069 2099 2059 2097 2059 2094 2059 2064 2072 1947 2072 1932 2059 1930 2059 1928 2059 1925 2059 1923 2059 1878 2072 1659 2072 1635 2059 1633 2059 1631 2059 1629 2059 1590 2069 1536 2059 1533 2059 1531 2059 1503 2069 1445 2059 1442 2059 1440 2059 1414 2069 1393 2059 1391 2059 1388 2059 1386 2059 1358 2072 1237 2072 1213 2059 1211 2059 1209 2059 1206 2059 1165 2069 1087 2059 1085 2059 1083 2059 1035 2069 572 2065 572 2100"/>
                        </Shape>
                        <String CONTENT="Bering Sea between East Cape and Anadyr Bay, except where a few Eskimo"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l26" HPOS="572" VPOS="2126" WIDTH="1767" HEIGHT="52" BASELINE="574 2156 2339 2162" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2156 572 2171 2335 2178 2339 2162 2337 2132 574 2126 574 2156"/>
                        </Shape>
                        <String CONTENT="settlements are interspersed, — two near East Cape, and seven between Indian"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l27" HPOS="576" VPOS="2182" WIDTH="1767" HEIGHT="56" BASELINE="576 2221 2343 2221" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="576 2221 576 2238 2341 2238 2343 2221 2341 2191 576 2182 576 2221"/>
                        </Shape>
                        <String CONTENT="Point and Cape Ulakhpen (Улахпенъ). The latter is called by the natives"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l28" HPOS="578" VPOS="2238" WIDTH="1124" HEIGHT="65" BASELINE="581 2277 1702 2284" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="581 2277 578 2290 613 2303 615 2303 617 2303 1700 2297 1702 2284 1700 2253 581 2238 581 2277"/>
                        </Shape>
                        <String CONTENT="Wuteˊen, the same name as the village close by."/>
                    </TextLine>
<TextLine ID="mz_1-034_l29" HPOS="678" VPOS="2303" WIDTH="1670" HEIGHT="54" BASELINE="680 2338 2348 2342" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="680 2338 678 2353 2343 2357 2348 2342 2346 2312 680 2303 680 2338"/>
                        </Shape>
                        <String CONTENT="The Reindeer camps are scattered over the whole country to the northeast"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l30" HPOS="570" VPOS="2360" WIDTH="1773" HEIGHT="58" BASELINE="570 2401 2343 2401" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="570 2390 570 2401 570 2418 2343 2418 2343 2401 2343 2372 1520 2360 1518 2360 1516 2360 1492 2370 1397 2360 1395 2360 1336 2370 1310 2360 1308 2360 1306 2360 1174 2370 1122 2360 1120 2360 1042 2370 988 2360 986 2360 983 2360 949 2370 834 2360 832 2360 765 2370 708 2360 706 2360 646 2370 613 2360 611 2360 609 2360 607 2360 572 2368 570 2390"/>
                        </Shape>
                        <String CONTENT="of a line drawn from the mouth of the Indighirka River to Cape Anannon."/>
                    </TextLine>
<TextLine ID="mz_1-034_l31" HPOS="680" VPOS="2424" WIDTH="1663" HEIGHT="55" BASELINE="680 2461 2343 2461" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="680 2461 680 2479 2343 2479 2343 2461 2343 2431 680 2424 680 2461"/>
                        </Shape>
                        <String CONTENT="The part of the country lying to the west of the rivers Chaun and Anadyr"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l32" HPOS="570" VPOS="2485" WIDTH="1776" HEIGHT="63" BASELINE="572 2518 2346 2524" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2518 570 2531 782 2544 784 2544 1063 2535 2341 2548 2346 2524 2343 2492 572 2485 572 2518"/>
                        </Shape>
                        <String CONTENT="forms the so-called “Chukchee territory”² (Чукотская землица). This territory,"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l33" HPOS="572" VPOS="2537" WIDTH="1802" HEIGHT="71" BASELINE="574 2578 2330 2583 2374 2591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2578 572 2591 752 2604 754 2604 1512 2595 1601 2606 1603 2608 2372 2608 2374 2591 2374 2552 2296 2539 2161 2539 2159 2539 2157 2539 2155 2539 2142 2550 2107 2539 2105 2539 2103 2539 2006 2550 1962 2539 1960 2539 1958 2539 1956 2539 1917 2552 1737 2552 1722 2539 1720 2539 1718 2539 1715 2539 1713 2539 1672 2550 1659 2539 1657 2539 1655 2539 1653 2539 1287 2548 1230 2537 1228 2537 1226 2537 1191 2548 1115 2537 1113 2537 1111 2537 1079 2548 1046 2537 1044 2537 1042 2537 1040 2537 1009 2548 929 2537 927 2537 925 2537 895 2550 760 2550 736 2537 734 2537 732 2537 574 2546 574 2578"/>
                        </Shape>
                        <String CONTENT="according to the obsolete but not yet abolished paragraph of the Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l34" HPOS="572" VPOS="2604" WIDTH="1771" HEIGHT="63" BASELINE="574 2634 2343 2641" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2634 572 2647 596 2660 598 2660 600 2660 1107 2652 1256 2665 1258 2665 1261 2665 1297 2654 1334 2665 1336 2665 1339 2667 1540 2667 1540 2665 1542 2665 1564 2654 2142 2667 2144 2667 2146 2667 2170 2656 2341 2656 2343 2641 2341 2606 574 2604 574 2634"/>
                        </Shape>
                        <String CONTENT="Code, is considered to be “not thoroughly subdued.” Its inhabitants, as well"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l35" HPOS="570" VPOS="2665" WIDTH="1771" HEIGHT="54" BASELINE="572 2697 2341 2702" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2697 570 2712 2337 2719 2341 2702 2339 2669 572 2665 572 2697"/>
                        </Shape>
                        <String CONTENT="as all other Chukchee, have the privilege of settling all their affairs according"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l36" HPOS="570" VPOS="2725" WIDTH="1773" HEIGHT="52" BASELINE="572 2756 2343 2762" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="572 2756 570 2771 2339 2777 2343 2762 2341 2732 572 2725 572 2756"/>
                        </Shape>
                        <String CONTENT="to their own customs, including even murder if committed within the limits"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l37" HPOS="572" VPOS="2782" WIDTH="1717" HEIGHT="60" BASELINE="574 2812 2289 2823" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="574 2812 572 2829 587 2840 589 2840 591 2840 594 2840 877 2831 916 2842 918 2842 921 2842 2287 2838 2289 2823 2287 2793 574 2782 574 2812"/>
                        </Shape>
                        <String CONTENT="of their own territories. Such privileges sometimes lead to strange results."/>
                    </TextLine>
<TextLine ID="mz_1-034_l38" HPOS="676" VPOS="2844" WIDTH="1672" HEIGHT="59" BASELINE="678 2877 2348 2883" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="678 2877 676 2890 704 2903 706 2903 708 2903 2346 2896 2348 2883 2346 2851 678 2844 678 2877"/>
                        </Shape>
                        <String CONTENT="G. Dyachkoff³ relates the following incident, that occurred among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-034_l39" HPOS="570" VPOS="2894" WIDTH="1780" HEIGHT="63" BASELINE="572 2935 2350 2944" TAGREFS="TYPE_4">
                        <Shape>
