                <TextBlock ID="text_1-041" HPOS="370" VPOS="625" WIDTH="1776" HEIGHT="2639"><TextLine ID="mz_1-041_l1" HPOS="947" VPOS="625" WIDTH="619" HEIGHT="54" BASELINE="949 660 1566 664" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1555 628 949 625 949 660 947 675 1562 679 1566 664 1564 643 1555 628"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l2" HPOS="2077" VPOS="638" WIDTH="63" HEIGHT="46" BASELINE="2077 669 2140 669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2120 638 2077 638 2077 669 2077 684 2140 684 2140 669 2140 640 2120 638"/>
                        </Shape>
                        <String CONTENT="21"/>
                    </TextLine>
<TextLine ID="mz_1-041_l3" HPOS="373" VPOS="736" WIDTH="1773" HEIGHT="52" BASELINE="375 768 2146 773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="546 738 524 738 503 740 481 740 459 742 438 742 416 742 394 744 375 744 375 768 373 783 2142 788 2146 773 2144 740 561 736 546 738"/>
                        </Shape>
                        <String CONTENT="mainland is considerable, even at the present time, while the old families of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l4" HPOS="370" VPOS="788" WIDTH="1774" HEIGHT="60" BASELINE="373 833 2144 829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 833 373 848 2142 846 2144 829 2142 801 2116 788 2114 788 2112 788 2053 799 1956 788 1954 788 1951 788 1949 788 1930 801 1778 801 1754 788 1752 788 1750 788 1748 788 1746 788 1728 801 1566 801 1473 788 1471 788 1468 788 1466 788 1451 801 370 801 373 833"/>
                        </Shape>
                        <String CONTENT="island are slowly dying out. Of course, some influence and connection with"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l5" HPOS="375" VPOS="851" WIDTH="1386" HEIGHT="58" BASELINE="377 894 1761 889" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 894 377 909 1759 905 1761 889 1756 859 394 851 392 851 390 851 388 851 375 857 377 894"/>
                        </Shape>
                        <String CONTENT="America have also existed on the island from ancient times."/>
                    </TextLine>
<TextLine ID="mz_1-041_l6" HPOS="483" VPOS="918" WIDTH="1661" HEIGHT="52" BASELINE="485 952 2144 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 952 485 970 2142 965 2144 948 2140 918 483 918 485 952"/>
                        </Shape>
                        <String CONTENT="The categorical assertion of Mr. Gondatti, however, that the Asiatic Eskimo"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l7" HPOS="373" VPOS="970" WIDTH="1771" HEIGHT="58" BASELINE="375 1013 2144 1009" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1013 375 1028 2142 1024 2144 1009 2140 978 522 970 520 970 373 980 375 1013"/>
                        </Shape>
                        <String CONTENT="came from St. Lawrence Island, seems to me highly improbable, though I also"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l8" HPOS="373" VPOS="1028" WIDTH="1771" HEIGHT="61" BASELINE="375 1071 2144 1067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1071 375 1089 2142 1084 2144 1067 2140 1039 1291 1028 1289 1028 1191 1039 565 1030 563 1030 373 1041 375 1071"/>
                        </Shape>
                        <String CONTENT="assume that the Asiatic Eskimo are not indigenous to the Pacific coast. Whether"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l9" HPOS="375" VPOS="1095" WIDTH="1767" HEIGHT="56" BASELINE="377 1128 2142 1134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1128 375 1143 2138 1151 2142 1134 2140 1102 377 1095 377 1128"/>
                        </Shape>
                        <String CONTENT="they came from the Arctic coast of Asia or that of America is another question;"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l10" HPOS="377" VPOS="1151" WIDTH="1765" HEIGHT="57" BASELINE="379 1188 2142 1193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1188 377 1203 2138 1208 2142 1193 2140 1156 379 1151 379 1188"/>
                        </Shape>
                        <String CONTENT="but, in any case, they migrated from north to south, and St. Lawrence Island"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l11" HPOS="375" VPOS="1216" WIDTH="1769" HEIGHT="52" BASELINE="375 1251 2144 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1251 375 1268 2144 1268 2144 1251 2144 1221 375 1216 375 1251"/>
                        </Shape>
                        <String CONTENT="is the limit of their migrations. W. H. Dall repeats a statement of a native"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l12" HPOS="373" VPOS="1271" WIDTH="1767" HEIGHT="67" BASELINE="375 1307 2140 1314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1307 373 1322 388 1333 390 1333 392 1333 394 1333 890 1325 1003 1335 1005 1335 1527 1327 2135 1338 2140 1314 2135 1271 375 1273 375 1307"/>
                        </Shape>
                        <String CONTENT="of Plover Bay by the name of Nokum, who told that the “Bowhead [whale]"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l13" HPOS="373" VPOS="1338" WIDTH="1769" HEIGHT="52" BASELINE="375 1370 2142 1374" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1370 373 1383 2138 1390 2142 1374 2140 1342 375 1338 375 1370"/>
                        </Shape>
                        <String CONTENT="men” came to Asia long ago from the Islands to the northeast (the Diomedes),"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l14" HPOS="373" VPOS="1390" WIDTH="1708" HEIGHT="67" BASELINE="375 1431 2081 1426" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1431 375 1446 793 1446 840 1457 843 1457 845 1457 847 1457 849 1457 864 1446 1209 1455 1211 1455 1213 1455 1215 1455 1232 1444 1609 1444 1653 1455 1655 1455 1657 1457 1906 1457 1906 1455 1908 1455 1910 1455 1923 1446 1934 1455 1936 1455 1938 1455 1941 1457 2049 1457 2049 1455 2051 1455 2081 1442 2081 1426 2077 1390 442 1390 440 1390 373 1400 375 1431"/>
                        </Shape>
                        <String CONTENT="and were allowed by the “Deer men” to settle on the barren, rocky coast.¹"/>
                    </TextLine>
<TextLine ID="mz_1-041_l15" HPOS="485" VPOS="1452" WIDTH="1653" HEIGHT="65" BASELINE="485 1491 2138 1491" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 1491 485 1506 2135 1517 2138 1491 2135 1452 485 1452 485 1491"/>
                        </Shape>
                        <String CONTENT="The inhabitants of the Diomede Islands are called Yɪkɪrg̣aˊulɪt (“the [large]"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l16" HPOS="373" VPOS="1506" WIDTH="1771" HEIGHT="61" BASELINE="375 1552 2144 1548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1552 375 1567 2142 1563 2144 1548 2140 1519 1356 1506 1354 1506 1352 1506 1317 1517 1267 1506 1265 1506 1263 1506 1261 1506 1245 1519 1200 1509 1198 1509 1196 1509 899 1519 823 1509 821 1509 747 1519 654 1509 652 1509 650 1509 613 1519 600 1509 598 1509 596 1509 490 1509 487 1509 373 1522 375 1552"/>
                        </Shape>
                        <String CONTENT="mouthed”), from yɪkɪˊrg̣ɪn (“mouth”), the labrets which they wore in former"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l17" HPOS="373" VPOS="1580" WIDTH="1771" HEIGHT="48" BASELINE="373 1613 2144 1613" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 1613 373 1628 2144 1628 2144 1613 2144 1580 373 1580 373 1613"/>
                        </Shape>
                        <String CONTENT="times having made their mouths their most conspicuous feature. The American"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l18" HPOS="375" VPOS="1628" WIDTH="1769" HEIGHT="58" BASELINE="377 1671 2144 1667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1671 377 1686 2142 1682 2144 1667 2140 1636 392 1628 390 1628 388 1628 386 1628 375 1634 377 1671"/>
                        </Shape>
                        <String CONTENT="Continent is called Kɪˊɪmɪn.² Its inhabitants are called Kɪˊɪmɪlɪt, and also"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l19" HPOS="381" VPOS="1688" WIDTH="1306" HEIGHT="61" BASELINE="381 1732 1687 1732" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1732 381 1749 1685 1749 1687 1732 1687 1701 1661 1688 1659 1688 1657 1688 1568 1701 1403 1701 1393 1691 1393 1688 1391 1688 1388 1688 1386 1688 1384 1688 1356 1699 1304 1688 1302 1688 1300 1688 1269 1699 1157 1688 1154 1688 1152 1688 1115 1699 1061 1688 1059 1688 957 1699 947 1691 947 1688 944 1688 942 1688 940 1688 938 1688 899 1699 847 1688 845 1688 782 1699 381 1691 381 1732"/>
                        </Shape>
                        <String CONTENT="Yɪkɪrg̣aˊulɪt, or, again, Roˊčhɪlɪt (“opposite-shore people”)."/>
                    </TextLine>
<TextLine ID="mz_1-041_l20" HPOS="483" VPOS="1755" WIDTH="1661" HEIGHT="52" BASELINE="483 1792 2144 1792" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="483 1792 483 1807 2144 1807 2144 1792 2144 1762 483 1755 483 1792"/>
                        </Shape>
                        <String CONTENT="It is a question open to discussion, whether in former times there were"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l21" HPOS="375" VPOS="1823" WIDTH="1769" HEIGHT="45" BASELINE="375 1851 2144 1851" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1851 375 1868 2144 1868 2144 1851 2144 1823 375 1823 375 1851"/>
                        </Shape>
                        <String CONTENT="any Eskimo villages on the Arctic coast. At present there are none except"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l22" HPOS="375" VPOS="1872" WIDTH="1767" HEIGHT="55" BASELINE="377 1907 2142 1911" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1907 375 1922 2138 1927 2142 1911 2140 1881 377 1872 377 1907"/>
                        </Shape>
                        <String CONTENT="Nɵˊɵkan; though some of the inhabitants of Uweˊlen, the nearest settlement"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l23" HPOS="373" VPOS="1924" WIDTH="1767" HEIGHT="65" BASELINE="375 1968 2140 1974" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1968 373 1981 2135 1989 2140 1974 2140 1939 2122 1929 2120 1929 2118 1929 2116 1929 1772 1939 1666 1929 1663 1929 1575 1939 1555 1927 1553 1927 1551 1927 1549 1927 1546 1927 1525 1937 1349 1927 1347 1927 1193 1937 1139 1927 1137 1927 1061 1937 1001 1927 999 1927 996 1927 962 1937 862 1924 860 1924 375 1933 375 1968"/>
                        </Shape>
                        <String CONTENT="to the west, are Eskimo. The older travellers, such as Lütke and Wrangell,"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l24" HPOS="373" VPOS="1996" WIDTH="1769" HEIGHT="54" BASELINE="375 2026 2142 2030" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2026 373 2043 2138 2050 2142 2030 2140 2000 375 1996 375 2026"/>
                        </Shape>
                        <String CONTENT="mention a few tribal names supposed to be Eskimo, as Onkilon and Namollo;"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l25" HPOS="373" VPOS="2046" WIDTH="1767" HEIGHT="62" BASELINE="375 2091 2140 2087" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2091 375 2108 2138 2104 2140 2087 2135 2059 1936 2046 1934 2046 1856 2056 1808 2046 1806 2046 1804 2046 1802 2046 1778 2056 1720 2046 1718 2046 1715 2046 1681 2056 1650 2046 1648 2046 1646 2046 1644 2046 1601 2056 1568 2046 1566 2046 1564 2046 1393 2056 1371 2046 1369 2046 1367 2046 1365 2046 1343 2056 1321 2046 1319 2046 1317 2046 1315 2046 1291 2056 1258 2046 1256 2046 1254 2046 1252 2046 1219 2059 1174 2048 1172 2048 1170 2048 1167 2048 1137 2059 1076 2048 1074 2048 1022 2059 784 2048 782 2048 780 2048 743 2059 706 2048 704 2048 702 2048 700 2048 663 2059 563 2048 561 2048 373 2056 375 2091"/>
                        </Shape>
                        <String CONTENT="but of these, the former resembles the Chukchee añqaˊlɪn,³ while Namollo brings"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l26" HPOS="370" VPOS="2115" WIDTH="1770" HEIGHT="58" BASELINE="373 2147 2140 2152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2147 370 2162 386 2173 388 2173 390 2173 392 2173 2138 2165 2140 2152 2138 2119 373 2115 373 2147"/>
                        </Shape>
                        <String CONTENT="to mind the Koryak word for “maritime settlers,” nɪˊmɪḷu, which in Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l27" HPOS="370" VPOS="2175" WIDTH="1523" HEIGHT="52" BASELINE="373 2206 1893 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2206 370 2223 1889 2227 1893 2210 1891 2180 373 2175 373 2206"/>
                        </Shape>
                        <String CONTENT="takes the form nɪˊmɪlɪt (“inhabitants”), from nɪˊmnɪm (“habitation”)."/>
                    </TextLine>
<TextLine ID="mz_1-041_l28" HPOS="485" VPOS="2227" WIDTH="1655" HEIGHT="63" BASELINE="485 2269 2140 2269" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 2269 485 2290 2138 2290 2140 2269 2138 2240 1999 2227 1997 2227 1995 2227 1947 2238 1860 2227 1858 2227 1856 2227 1832 2240 1679 2240 1663 2227 1661 2227 1659 2227 1657 2227 1655 2227 1627 2238 1592 2227 1590 2227 1588 2227 1585 2227 1540 2238 1501 2227 1499 2227 1497 2227 1494 2227 1473 2238 1406 2227 1403 2227 1401 2227 1365 2238 1336 2227 1334 2227 1332 2227 1263 2238 1228 2227 1226 2227 1224 2227 1107 2238 1055 2227 1053 2227 1050 2227 1014 2238 988 2227 986 2227 983 2227 931 2238 871 2227 869 2227 866 2227 838 2238 808 2227 806 2227 804 2227 801 2227 778 2238 485 2230 485 2269"/>
                        </Shape>
                        <String CONTENT="Wrangell, and also Nordenskiöld, following in his footsteps,⁴ mention an"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l29" HPOS="373" VPOS="2297" WIDTH="1769" HEIGHT="50" BASELINE="373 2329 2142 2329" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2329 373 2347 2142 2347 2142 2329 2142 2301 373 2297 373 2329"/>
                        </Shape>
                        <String CONTENT="Eskimo tribe that some two hundred years ago occupied the whole Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l30" HPOS="370" VPOS="2347" WIDTH="1770" HEIGHT="73" BASELINE="373 2392 2140 2388" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2392 373 2407 1012 2418 1014 2418 1016 2418 1018 2418 1031 2409 1042 2418 1044 2418 1046 2418 1048 2420 1159 2420 1159 2418 1161 2418 1163 2418 1178 2407 1551 2416 1553 2416 1555 2416 1557 2416 1572 2405 1934 2405 2045 2416 2047 2416 2049 2416 2071 2405 2116 2416 2118 2416 2120 2416 2122 2416 2125 2416 2140 2403 2140 2388 2135 2357 1256 2347 1254 2347 1252 2347 1250 2347 1237 2357 520 2349 518 2349 370 2360 373 2392"/>
                        </Shape>
                        <String CONTENT="coast from Cape Shelagskoy (Erri) to Bering Strait, and was driven away by"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l31" HPOS="373" VPOS="2420" WIDTH="1767" HEIGHT="46" BASELINE="373 2450 2140 2450" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2450 373 2466 2138 2466 2140 2450 2138 2420 373 2420 373 2450"/>
                        </Shape>
                        <String CONTENT="the Chukchee. They base their chief argument upon the difference between"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l32" HPOS="373" VPOS="2479" WIDTH="1767" HEIGHT="49" BASELINE="373 2509 2140 2509" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2509 373 2528 2138 2528 2140 2509 2138 2479 373 2479 373 2509"/>
                        </Shape>
                        <String CONTENT="the actual Chukchee dwellings and the remnants of the old underground houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l33" HPOS="370" VPOS="2526" WIDTH="1772" HEIGHT="65" BASELINE="373 2572 2142 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2572 373 2585 2125 2591 2127 2591 2129 2591 2131 2591 2142 2580 2142 2565 2138 2537 1778 2526 1776 2526 370 2539 373 2572"/>
                        </Shape>
                        <String CONTENT="found here and there. In reality, this difference means nothing more than"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l34" HPOS="370" VPOS="2589" WIDTH="1768" HEIGHT="61" BASELINE="373 2630 2138 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2630 373 2650 2135 2650 2138 2626 2133 2598 390 2589 388 2589 386 2589 383 2589 370 2595 373 2630"/>
                        </Shape>
                        <String CONTENT="that, with the increase of reindeer-breeding, the underground houses, being"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l35" HPOS="373" VPOS="2650" WIDTH="1767" HEIGHT="60" BASELINE="375 2691 2140 2686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2691 375 2710 2138 2706 2140 2686 2135 2654 464 2650 461 2650 373 2660 375 2691"/>
                        </Shape>
                        <String CONTENT="unwholesome, and requiring a great consumption of oil, were gradually abandoned"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l36" HPOS="370" VPOS="2706" WIDTH="1770" HEIGHT="65" BASELINE="373 2751 2140 2747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2751 373 2771 2138 2771 2140 2747 2135 2719 1791 2706 1789 2706 1787 2706 1765 2717 1744 2706 1741 2706 1739 2706 1737 2706 1735 2706 1720 2719 1551 2719 1494 2706 1492 2706 1490 2706 1462 2719 1289 2719 1261 2706 1258 2706 1256 2706 1254 2706 1219 2719 1105 2708 1102 2708 1100 2708 1074 2719 864 2708 862 2708 860 2708 858 2708 845 2719 823 2708 821 2708 819 2708 706 2719 669 2708 667 2708 383 2708 381 2708 379 2708 377 2708 377 2710 370 2715 373 2751"/>
                        </Shape>
                        <String CONTENT="by both Eskimo and Chukchee for another type of house, probably also ancient,"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l37" HPOS="375" VPOS="2775" WIDTH="1765" HEIGHT="54" BASELINE="375 2810 2140 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2810 375 2829 2140 2829 2140 2810 2140 2780 375 2775 375 2810"/>
                        </Shape>
                        <String CONTENT="but more similar to the tents of the Reindeer people, and with a sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l38" HPOS="370" VPOS="2825" WIDTH="479" HEIGHT="61" BASELINE="373 2866 849 2870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2866 370 2881 845 2886 849 2870 847 2840 611 2825 609 2825 607 2825 585 2836 572 2825 570 2825 568 2825 565 2825 373 2834 373 2866"/>
                        </Shape>
                        <String CONTENT="made of thick skins."/>
                    </TextLine>
<TextLine ID="mz_1-041_l39" HPOS="479" VPOS="2883" WIDTH="1661" HEIGHT="65" BASELINE="481 2931 2140 2925" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="481 2931 481 2948 2138 2942 2140 2925 2135 2896 2045 2883 2042 2883 2040 2883 2003 2894 1986 2883 1984 2883 1982 2883 1980 2883 1908 2894 1886 2883 1884 2883 1882 2883 1789 2894 1756 2883 1754 2883 1752 2883 1750 2883 1748 2883 1731 2894 1570 2886 1568 2886 1566 2886 1564 2886 1549 2896 1499 2886 1497 2886 1438 2896 1362 2886 1360 2886 1308 2899 1135 2899 1111 2886 1109 2886 1107 2886 1007 2899 860 2888 858 2888 479 2894 481 2931"/>
                        </Shape>
                        <String CONTENT="The Pacific Eskimo were slower to effect this change, since they had no"/>
                    </TextLine>
<TextLine ID="mz_1-041_l40" HPOS="481" VPOS="2992" WIDTH="290" HEIGHT="58" BASELINE="483 3022 771 3026" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="483 3022 481 3035 626 3050 628 3050 769 3039 771 3026 771 2996 483 2992 483 3022"/>
                        </Shape>
                        <String CONTENT="¹ Dall, I, p. 375."/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l41" HPOS="481" VPOS="3037" WIDTH="1659" HEIGHT="48" BASELINE="481 3063 2140 3063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="481 3063 481 3085 2140 3085 2140 3063 2140 3037 481 3037 481 3063"/>
                        </Shape>
