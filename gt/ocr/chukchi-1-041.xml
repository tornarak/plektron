                <TextBlock ID="mz_1-041_r2" HPOS="396" VPOS="738" WIDTH="1778" HEIGHT="189" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="396 738 2174 738 2174 927 396 927"/>
                    </Shape>
                    <TextLine ID="mz_1-041_l3" HPOS="394" VPOS="751" WIDTH="1773" HEIGHT="52" BASELINE="396 783 2167 788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="567 753 545 753 524 755 502 755 480 757 459 757 437 757 415 759 396 759 396 783 394 798 2163 803 2167 788 2165 755 582 751 567 753"/>
                        </Shape>
                        <String CONTENT="mainland is considerable, even at the present time, while the old families of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l4" HPOS="391" VPOS="803" WIDTH="1774" HEIGHT="60" BASELINE="394 848 2165 844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 848 394 863 2163 861 2165 844 2163 816 2137 803 2135 803 2133 803 2074 814 1977 803 1975 803 1972 803 1970 803 1951 816 1799 816 1775 803 1773 803 1771 803 1769 803 1767 803 1749 816 1587 816 1494 803 1492 803 1489 803 1487 803 1472 816 391 816 394 848"/>
                        </Shape>
                        <String CONTENT="island are slowly dying out. Of course, some influence and connection with"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l5" HPOS="396" VPOS="866" WIDTH="1386" HEIGHT="58" BASELINE="398 909 1782 904" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="398 909 398 924 1780 920 1782 904 1777 874 415 866 413 866 411 866 409 866 396 872 398 909"/>
                        </Shape>
                        <String CONTENT="America have also existed on the island from ancient times."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-041_r3" HPOS="396" VPOS="927" WIDTH="1778" HEIGHT="536" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="396 927 2174 927 2174 1463 396 1463"/>
                    </Shape>
                    <TextLine ID="mz_1-041_l6" HPOS="504" VPOS="933" WIDTH="1661" HEIGHT="52" BASELINE="506 967 2165 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="506 967 506 985 2163 980 2165 963 2161 933 504 933 506 967"/>
                        </Shape>
                        <String CONTENT="The categorical assertion of Mr. Gondatti, however, that the Asiatic Eskimo"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l7" HPOS="394" VPOS="985" WIDTH="1771" HEIGHT="58" BASELINE="396 1028 2165 1024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1028 396 1043 2163 1039 2165 1024 2161 993 543 985 541 985 394 995 396 1028"/>
                        </Shape>
                        <String CONTENT="came from St. Lawrence Island, seems to me highly improbable, though I also"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l8" HPOS="394" VPOS="1043" WIDTH="1771" HEIGHT="61" BASELINE="396 1086 2165 1082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1086 396 1104 2163 1099 2165 1082 2161 1054 1312 1043 1310 1043 1212 1054 586 1045 584 1045 394 1056 396 1086"/>
                        </Shape>
                        <String CONTENT="assume that the Asiatic Eskimo are not indigenous to the Pacific coast. Whether"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l9" HPOS="396" VPOS="1110" WIDTH="1767" HEIGHT="56" BASELINE="398 1143 2163 1149" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="398 1143 396 1158 2159 1166 2163 1149 2161 1117 398 1110 398 1143"/>
                        </Shape>
                        <String CONTENT="they came from the Arctic coast of Asia or that of America is another question;"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l10" HPOS="398" VPOS="1166" WIDTH="1765" HEIGHT="57" BASELINE="400 1203 2163 1208" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="400 1203 398 1218 2159 1223 2163 1208 2161 1171 400 1166 400 1203"/>
                        </Shape>
                        <String CONTENT="but, in any case, they migrated from north to south, and St. Lawrence Island"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l11" HPOS="396" VPOS="1231" WIDTH="1769" HEIGHT="52" BASELINE="396 1266 2165 1266" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1266 396 1283 2165 1283 2165 1266 2165 1236 396 1231 396 1266"/>
                        </Shape>
                        <String CONTENT="is the limit of their migrations. W. H. Dall repeats a statement of a native"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l12" HPOS="394" VPOS="1286" WIDTH="1767" HEIGHT="67" BASELINE="396 1322 2161 1329" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1322 394 1337 409 1348 411 1348 413 1348 415 1348 911 1340 1024 1350 1026 1350 1548 1342 2156 1353 2161 1329 2156 1286 396 1288 396 1322"/>
                        </Shape>
                        <String CONTENT="of Plover Bay by the name of Nokum, who told that the “Bowhead [whale]"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l13" HPOS="394" VPOS="1353" WIDTH="1769" HEIGHT="52" BASELINE="396 1385 2163 1389" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1385 394 1398 2159 1405 2163 1389 2161 1357 396 1353 396 1385"/>
                        </Shape>
                        <String CONTENT="men” came to Asia long ago from the Islands to the northeast (the Diomedes),"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l14" HPOS="394" VPOS="1405" WIDTH="1708" HEIGHT="67" BASELINE="396 1446 2102 1441" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1446 396 1461 814 1461 861 1472 864 1472 866 1472 868 1472 870 1472 885 1461 1230 1470 1232 1470 1234 1470 1236 1470 1253 1459 1630 1459 1674 1470 1676 1470 1678 1472 1927 1472 1927 1470 1929 1470 1931 1470 1944 1461 1955 1470 1957 1470 1959 1470 1962 1472 2070 1472 2070 1470 2072 1470 2102 1457 2102 1441 2098 1405 463 1405 461 1405 394 1415 396 1446"/>
                        </Shape>
                        <String CONTENT="and were allowed by the “Deer men” to settle on the barren, rocky coast.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-041_r4" HPOS="396" VPOS="1463" WIDTH="1778" HEIGHT="304" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="396 1463 2174 1463 2174 1767 396 1767"/>
                    </Shape>
                    <TextLine ID="mz_1-041_l15" HPOS="506" VPOS="1467" WIDTH="1653" HEIGHT="65" BASELINE="506 1506 2159 1506" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="506 1506 506 1521 2156 1532 2159 1506 2156 1467 506 1467 506 1506"/>
                        </Shape>
                        <String CONTENT="The inhabitants of the Diomede Islands are called Yɪkɪrg̣aˊulɪt (“the [large]"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l16" HPOS="394" VPOS="1521" WIDTH="1771" HEIGHT="61" BASELINE="396 1567 2165 1563" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1567 396 1582 2163 1578 2165 1563 2161 1534 1377 1521 1375 1521 1373 1521 1338 1532 1288 1521 1286 1521 1284 1521 1282 1521 1266 1534 1221 1524 1219 1524 1217 1524 920 1534 844 1524 842 1524 768 1534 675 1524 673 1524 671 1524 634 1534 621 1524 619 1524 617 1524 511 1524 508 1524 394 1537 396 1567"/>
                        </Shape>
                        <String CONTENT="mouthed”), from yɪkɪˊrg̣ɪn (“mouth”), the labrets which they wore in former"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l17" HPOS="394" VPOS="1595" WIDTH="1771" HEIGHT="48" BASELINE="394 1628 2165 1628" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1628 394 1643 2165 1643 2165 1628 2165 1595 394 1595 394 1628"/>
                        </Shape>
                        <String CONTENT="times having made their mouths their most conspicuous feature. The American"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l18" HPOS="396" VPOS="1643" WIDTH="1769" HEIGHT="58" BASELINE="398 1686 2165 1682" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="398 1686 398 1701 2163 1697 2165 1682 2161 1651 413 1643 411 1643 409 1643 407 1643 396 1649 398 1686"/>
                        </Shape>
                        <String CONTENT="Continent is called Kɪˊɪmɪn.² Its inhabitants are called Kɪˊɪmɪlɪt, and also"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l19" HPOS="402" VPOS="1703" WIDTH="1306" HEIGHT="61" BASELINE="402 1747 1708 1747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="402 1747 402 1764 1706 1764 1708 1747 1708 1716 1682 1703 1680 1703 1678 1703 1589 1716 1424 1716 1414 1706 1414 1703 1412 1703 1409 1703 1407 1703 1405 1703 1377 1714 1325 1703 1323 1703 1321 1703 1290 1714 1178 1703 1175 1703 1173 1703 1136 1714 1082 1703 1080 1703 978 1714 968 1706 968 1703 965 1703 963 1703 961 1703 959 1703 920 1714 868 1703 866 1703 803 1714 402 1706 402 1747"/>
                        </Shape>
                        <String CONTENT="Yɪkɪrg̣aˊulɪt, or, again, Roˊčhɪlɪt (“opposite-shore people”)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-041_r5" HPOS="396" VPOS="1767" WIDTH="1778" HEIGHT="482" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="396 1767 2174 1767 2174 2249 396 2249"/>
                    </Shape>
                    <TextLine ID="mz_1-041_l20" HPOS="504" VPOS="1770" WIDTH="1661" HEIGHT="52" BASELINE="504 1807 2165 1807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="504 1807 504 1822 2165 1822 2165 1807 2165 1777 504 1770 504 1807"/>
                        </Shape>
                        <String CONTENT="It is a question open to discussion, whether in former times there were"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l21" HPOS="396" VPOS="1838" WIDTH="1769" HEIGHT="45" BASELINE="396 1866 2165 1866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1866 396 1883 2165 1883 2165 1866 2165 1838 396 1838 396 1866"/>
                        </Shape>
                        <String CONTENT="any Eskimo villages on the Arctic coast. At present there are none except"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l22" HPOS="396" VPOS="1887" WIDTH="1767" HEIGHT="55" BASELINE="398 1922 2163 1926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="398 1922 396 1937 2159 1942 2163 1926 2161 1896 398 1887 398 1922"/>
                        </Shape>
                        <String CONTENT="Nɵˊɵkan; though some of the inhabitants of Uweˊlen, the nearest settlement"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l23" HPOS="394" VPOS="1939" WIDTH="1767" HEIGHT="65" BASELINE="396 1983 2161 1989" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1983 394 1996 2156 2004 2161 1989 2161 1954 2143 1944 2141 1944 2139 1944 2137 1944 1793 1954 1687 1944 1684 1944 1596 1954 1576 1942 1574 1942 1572 1942 1570 1942 1567 1942 1546 1952 1370 1942 1368 1942 1214 1952 1160 1942 1158 1942 1082 1952 1022 1942 1020 1942 1017 1942 983 1952 883 1939 881 1939 396 1948 396 1983"/>
                        </Shape>
                        <String CONTENT="to the west, are Eskimo. The older travellers, such as Lütke and Wrangell,"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l24" HPOS="394" VPOS="2011" WIDTH="1769" HEIGHT="54" BASELINE="396 2041 2163 2045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2041 394 2058 2159 2065 2163 2045 2161 2015 396 2011 396 2041"/>
                        </Shape>
                        <String CONTENT="mention a few tribal names supposed to be Eskimo, as Onkilon and Namollo;"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l25" HPOS="394" VPOS="2061" WIDTH="1767" HEIGHT="62" BASELINE="396 2106 2161 2102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2106 396 2123 2159 2119 2161 2102 2156 2074 1957 2061 1955 2061 1877 2071 1829 2061 1827 2061 1825 2061 1823 2061 1799 2071 1741 2061 1739 2061 1736 2061 1702 2071 1671 2061 1669 2061 1667 2061 1665 2061 1622 2071 1589 2061 1587 2061 1585 2061 1414 2071 1392 2061 1390 2061 1388 2061 1386 2061 1364 2071 1342 2061 1340 2061 1338 2061 1336 2061 1312 2071 1279 2061 1277 2061 1275 2061 1273 2061 1240 2074 1195 2063 1193 2063 1191 2063 1188 2063 1158 2074 1097 2063 1095 2063 1043 2074 805 2063 803 2063 801 2063 764 2074 727 2063 725 2063 723 2063 721 2063 684 2074 584 2063 582 2063 394 2071 396 2106"/>
                        </Shape>
                        <String CONTENT="but of these, the former resembles the Chukchee añqaˊlɪn,³ while Namollo brings"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l26" HPOS="391" VPOS="2130" WIDTH="1770" HEIGHT="58" BASELINE="394 2162 2161 2167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2162 391 2177 407 2188 409 2188 411 2188 413 2188 2159 2180 2161 2167 2159 2134 394 2130 394 2162"/>
                        </Shape>
                        <String CONTENT="to mind the Koryak word for “maritime settlers,” nɪˊmɪḷu, which in Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l27" HPOS="391" VPOS="2190" WIDTH="1523" HEIGHT="52" BASELINE="394 2221 1914 2225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2221 391 2238 1910 2242 1914 2225 1912 2195 394 2190 394 2221"/>
                        </Shape>
                        <String CONTENT="takes the form nɪˊmɪlɪt (“inhabitants”), from nɪˊmnɪm (“habitation”)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-041_r6" HPOS="396" VPOS="2249" WIDTH="1778" HEIGHT="658" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="396 2249 2174 2249 2174 2907 396 2907"/>
                    </Shape>
                    <TextLine ID="mz_1-041_l28" HPOS="506" VPOS="2242" WIDTH="1655" HEIGHT="63" BASELINE="506 2284 2161 2284" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="506 2284 506 2305 2159 2305 2161 2284 2159 2255 2020 2242 2018 2242 2016 2242 1968 2253 1881 2242 1879 2242 1877 2242 1853 2255 1700 2255 1684 2242 1682 2242 1680 2242 1678 2242 1676 2242 1648 2253 1613 2242 1611 2242 1609 2242 1606 2242 1561 2253 1522 2242 1520 2242 1518 2242 1515 2242 1494 2253 1427 2242 1424 2242 1422 2242 1386 2253 1357 2242 1355 2242 1353 2242 1284 2253 1249 2242 1247 2242 1245 2242 1128 2253 1076 2242 1074 2242 1071 2242 1035 2253 1009 2242 1007 2242 1004 2242 952 2253 892 2242 890 2242 887 2242 859 2253 829 2242 827 2242 825 2242 822 2242 799 2253 506 2245 506 2284"/>
                        </Shape>
                        <String CONTENT="Wrangell, and also Nordenskiöld, following in his footsteps,⁴ mention an"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l29" HPOS="394" VPOS="2312" WIDTH="1769" HEIGHT="50" BASELINE="394 2344 2163 2344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2344 394 2362 2163 2362 2163 2344 2163 2316 394 2312 394 2344"/>
                        </Shape>
                        <String CONTENT="Eskimo tribe that some two hundred years ago occupied the whole Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l30" HPOS="391" VPOS="2362" WIDTH="1770" HEIGHT="73" BASELINE="394 2407 2161 2403" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2407 394 2422 1033 2433 1035 2433 1037 2433 1039 2433 1052 2424 1063 2433 1065 2433 1067 2433 1069 2435 1180 2435 1180 2433 1182 2433 1184 2433 1199 2422 1572 2431 1574 2431 1576 2431 1578 2431 1593 2420 1955 2420 2066 2431 2068 2431 2070 2431 2092 2420 2137 2431 2139 2431 2141 2431 2143 2431 2146 2431 2161 2418 2161 2403 2156 2372 1277 2362 1275 2362 1273 2362 1271 2362 1258 2372 541 2364 539 2364 391 2375 394 2407"/>
                        </Shape>
                        <String CONTENT="coast from Cape Shelagskoy (Erri) to Bering Strait, and was driven away by"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l31" HPOS="394" VPOS="2435" WIDTH="1767" HEIGHT="46" BASELINE="394 2465 2161 2465" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2465 394 2481 2159 2481 2161 2465 2159 2435 394 2435 394 2465"/>
                        </Shape>
                        <String CONTENT="the Chukchee. They base their chief argument upon the difference between"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l32" HPOS="394" VPOS="2494" WIDTH="1767" HEIGHT="49" BASELINE="394 2524 2161 2524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2524 394 2543 2159 2543 2161 2524 2159 2494 394 2494 394 2524"/>
                        </Shape>
                        <String CONTENT="the actual Chukchee dwellings and the remnants of the old underground houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l33" HPOS="391" VPOS="2541" WIDTH="1772" HEIGHT="65" BASELINE="394 2587 2163 2580" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2587 394 2600 2146 2606 2148 2606 2150 2606 2152 2606 2163 2595 2163 2580 2159 2552 1799 2541 1797 2541 391 2554 394 2587"/>
                        </Shape>
                        <String CONTENT="found here and there. In reality, this difference means nothing more than"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l34" HPOS="391" VPOS="2604" WIDTH="1768" HEIGHT="61" BASELINE="394 2645 2159 2641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2645 394 2665 2156 2665 2159 2641 2154 2613 411 2604 409 2604 407 2604 404 2604 391 2610 394 2645"/>
                        </Shape>
                        <String CONTENT="that, with the increase of reindeer-breeding, the underground houses, being"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l35" HPOS="394" VPOS="2665" WIDTH="1767" HEIGHT="60" BASELINE="396 2706 2161 2701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2706 396 2725 2159 2721 2161 2701 2156 2669 485 2665 482 2665 394 2675 396 2706"/>
                        </Shape>
                        <String CONTENT="unwholesome, and requiring a great consumption of oil, were gradually abandoned"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l36" HPOS="391" VPOS="2721" WIDTH="1770" HEIGHT="65" BASELINE="394 2766 2161 2762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2766 394 2786 2159 2786 2161 2762 2156 2734 1812 2721 1810 2721 1808 2721 1786 2732 1765 2721 1762 2721 1760 2721 1758 2721 1756 2721 1741 2734 1572 2734 1515 2721 1513 2721 1511 2721 1483 2734 1310 2734 1282 2721 1279 2721 1277 2721 1275 2721 1240 2734 1126 2723 1123 2723 1121 2723 1095 2734 885 2723 883 2723 881 2723 879 2723 866 2734 844 2723 842 2723 840 2723 727 2734 690 2723 688 2723 404 2723 402 2723 400 2723 398 2723 398 2725 391 2730 394 2766"/>
                        </Shape>
                        <String CONTENT="by both Eskimo and Chukchee for another type of house, probably also ancient,"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l37" HPOS="396" VPOS="2790" WIDTH="1765" HEIGHT="54" BASELINE="396 2825 2161 2825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2825 396 2844 2161 2844 2161 2825 2161 2795 396 2790 396 2825"/>
                        </Shape>
                        <String CONTENT="but more similar to the tents of the Reindeer people, and with a sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l38" HPOS="391" VPOS="2840" WIDTH="479" HEIGHT="61" BASELINE="394 2881 870 2885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2881 391 2896 866 2901 870 2885 868 2855 632 2840 630 2840 628 2840 606 2851 593 2840 591 2840 589 2840 586 2840 394 2849 394 2881"/>
                        </Shape>
                        <String CONTENT="made of thick skins."/>
