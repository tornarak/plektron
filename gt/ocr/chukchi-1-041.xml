                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-041_l2" HPOS="2098" VPOS="653" WIDTH="63" HEIGHT="46" BASELINE="2098 684 2161 684" TAGREFS="TYPE_5">
                        <Shape>
