                        </Shape>
                        <String CONTENT="These two are even called “dream-echoes” (rêˊtɪ-taaˊññɪrg̣ɪn), showing how often"/>
                    </TextLine>

                    <TextLine ID="mz_2-220_l25" HPOS="368" VPOS="1897" WIDTH="1764" HEIGHT="55" BASELINE="370 1938 2132 1932" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1938 370 1952 2130 1948 2132 1932 2126 1897 475 1907 387 1897 385 1897 383 1897 381 1897 368 1905 370 1938"/>
                        </Shape>
                        <String CONTENT="they are arranged solely on indications of a dream. Indeed, even if a small"/>
