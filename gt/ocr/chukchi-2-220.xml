                        <Shape>
                            <Polygon POINTS="368 1402 368 1419 2128 1410 2130 1394 2125 1363 366 1368 368 1402"/>
                        </Shape>
                        <String CONTENT="prognosticate bad luck. Many persons, however, succeeded in my presence in"/>
