                        </Shape>
                        <String CONTENT="the thanksgiving ceremonial and the races, dreams are especially important."/>
                    </TextLine>

                    <TextLine ID="mz_2-220_l24" HPOS="370" VPOS="1833" WIDTH="1760" HEIGHT="60" BASELINE="372 1880 2130 1872" TAGREFS="TYPE_5">
