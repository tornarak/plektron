                    <TextLine ID="mz_1-090_l3" HPOS="885" VPOS="731" WIDTH="1774" HEIGHT="57" BASELINE="887 772 2659 768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 772 887 788 2657 785 2659 768 2655 740 907 731 905 731 903 731 900 731 885 738 887 772"/>
                        </Shape>
                        <String CONTENT="to last for the trade of the whole year. They have even bought wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l4" HPOS="885" VPOS="792" WIDTH="1207" HEIGHT="58" BASELINE="887 833 2092 829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 833 887 850 2089 846 2092 829 2087 801 996 792 994 792 885 803 887 833"/>
                        </Shape>
                        <String CONTENT="storehouses brought on purpose from San Francisco."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r3" HPOS="887" VPOS="854" WIDTH="1778" HEIGHT="238" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="887 854 2665 854 2665 1092 887 1092"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l5" HPOS="996" VPOS="853" WIDTH="1665" HEIGHT="58" BASELINE="998 894 2661 887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="998 894 998 911 2659 904 2661 887 2655 857 1017 853 1015 853 1013 853 1011 853 996 859 998 894"/>
                        </Shape>
                        <String CONTENT="At the present time the whole number of such storehouses on the Pacific"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l6" HPOS="885" VPOS="909" WIDTH="1772" HEIGHT="65" BASELINE="887 954 2657 950" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="885 939 887 954 887 967 2652 974 2657 950 2652 920 1786 909 1784 909 1782 909 1780 909 1765 920 916 911 913 911 911 911 887 920 885 939"/>
                        </Shape>
                        <String CONTENT="shore is fourteen. Indian Point has five, of which three belong to Kuvaˊr,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l7" HPOS="887" VPOS="969" WIDTH="1770" HEIGHT="61" BASELINE="887 1013 2657 1013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 1013 887 1028 2655 1030 2657 1013 2657 982 2585 969 2583 969 2278 980 2245 969 2243 969 2037 969 2035 969 1964 980 1929 969 1927 969 1925 969 1923 969 1884 980 1847 969 1845 969 1842 969 1840 969 1816 980 1765 969 1762 969 1697 980 1669 969 1667 969 1665 969 1663 969 1661 969 1645 980 1541 969 1539 969 1537 969 1507 980 1463 969 1461 969 1459 969 1457 969 1455 969 1435 982 1178 982 1117 969 1115 969 1054 980 1026 969 1024 969 1022 969 1020 969 1017 969 1000 982 887 982 887 1013"/>
                        </Shape>
                        <String CONTENT="now the richest man on the Chukchee Peninsula. Nɵˊɵkan has three; Uweˊlen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l8" HPOS="885" VPOS="1028" WIDTH="1739" HEIGHT="60" BASELINE="887 1073 2624 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 1073 887 1088 2622 1084 2624 1069 2620 1041 2499 1028 2496 1028 2434 1039 2169 1028 2167 1028 2053 1039 1886 1028 1884 1028 1749 1041 1706 1030 1704 1030 1702 1030 1396 1041 1223 1030 1221 1030 1219 1030 1173 1041 1043 1030 1041 1030 1039 1030 1037 1030 1022 1043 885 1043 887 1073"/>
                        </Shape>
                        <String CONTENT="one. Single storehouses are found in several Eskimo and Chukchee villages."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r4" HPOS="887" VPOS="1092" WIDTH="1778" HEIGHT="724" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="887 1092 2665 1092 2665 1816 887 1816"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l9" HPOS="998" VPOS="1084" WIDTH="1661" HEIGHT="65" BASELINE="1000 1134 2659 1125" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1000 1134 1000 1149 2657 1143 2659 1125 2655 1095 2360 1084 2358 1084 2269 1095 2245 1084 2243 1084 2241 1084 2239 1084 2237 1084 2221 1097 2206 1086 2204 1086 2202 1086 2200 1086 2198 1086 2169 1097 998 1097 1000 1134"/>
                        </Shape>
                        <String CONTENT="The whalers seldom skirt the Arctic coast westward from Uweˊlen, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l10" HPOS="885" VPOS="1147" WIDTH="1774" HEIGHT="61" BASELINE="887 1192 2659 1188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 1192 887 1208 2657 1203 2659 1188 2657 1160 2624 1147 2622 1147 2620 1147 2618 1147 2592 1158 2293 1147 2291 1147 2289 1147 2243 1158 2217 1147 2215 1147 2213 1147 2211 1147 2180 1158 2118 1147 2115 1147 2113 1147 2111 1147 2096 1160 2009 1160 1953 1147 1951 1147 1949 1147 1946 1147 1936 1158 1923 1147 1920 1147 1918 1147 1773 1147 1771 1147 1769 1147 1767 1147 1749 1160 1736 1149 1734 1149 1732 1149 1730 1149 1728 1149 1700 1160 1182 1149 1180 1149 1128 1160 1046 1149 1043 1149 1041 1149 1039 1149 1022 1162 885 1162 887 1192"/>
                        </Shape>
                        <String CONTENT="even then almost never go beyond Kuluˊči Bay. All the Maritime people"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l11" HPOS="887" VPOS="1212" WIDTH="1770" HEIGHT="58" BASELINE="890 1255 2657 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1255 890 1268 2652 1270 2657 1251 2652 1221 929 1212 926 1212 924 1212 887 1223 890 1255"/>
                        </Shape>
                        <String CONTENT="who wish to take part in this trading, resort, those from the Arctic villages,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l12" HPOS="887" VPOS="1264" WIDTH="1772" HEIGHT="69" BASELINE="890 1316 2659 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1316 890 1333 2657 1324 2659 1307 2655 1277 2217 1264 2215 1264 2213 1264 2211 1264 2193 1277 2057 1266 2055 1266 2053 1266 2050 1266 2035 1279 1868 1279 1812 1266 1810 1266 1808 1266 1769 1279 1732 1268 1730 1268 1728 1268 1459 1279 1407 1268 1405 1268 1403 1268 1401 1268 1386 1279 974 1270 972 1270 887 1283 890 1316"/>
                        </Shape>
                        <String CONTENT="to East Cape; those from the Pacific villages, to Indian Point. No positive"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l13" HPOS="887" VPOS="1331" WIDTH="1770" HEIGHT="61" BASELINE="890 1374 2657 1370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1374 890 1389 2652 1392 2657 1370 2652 1340 913 1331 911 1331 909 1331 887 1340 890 1374"/>
                        </Shape>
                        <String CONTENT="times are set for these gatherings; but, beginning with the middle of March,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l14" HPOS="887" VPOS="1387" WIDTH="1770" HEIGHT="63" BASELINE="890 1435 2657 1426" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1435 890 1450 2655 1446 2657 1426 2652 1398 2224 1387 2221 1387 2219 1387 2195 1398 907 1394 905 1394 903 1394 900 1394 887 1400 890 1435"/>
                        </Shape>
                        <String CONTENT="the dog-teams and reindeer-caravans begin to appear one after another. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l15" HPOS="887" VPOS="1448" WIDTH="1770" HEIGHT="63" BASELINE="890 1496 2657 1489" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1496 890 1511 2655 1504 2657 1489 2652 1459 2111 1448 2109 1448 2107 1448 2061 1461 887 1461 890 1496"/>
                        </Shape>
                        <String CONTENT="keep coming long after the appearance of the first whaling-ships, because the"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l16" HPOS="887" VPOS="1506" WIDTH="1772" HEIGHT="74" BASELINE="890 1554 2659 1547" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1554 890 1569 1282 1580 1284 1580 1286 1580 1318 1569 1399 1580 1401 1580 1520 1567 1829 1578 1832 1578 1834 1578 1836 1578 1851 1567 2115 1576 2118 1576 2120 1576 2122 1576 2137 1565 2360 1565 2458 1576 2460 1576 2462 1576 2505 1565 2594 1576 2596 1576 2657 1563 2659 1547 2655 1519 2600 1506 2598 1506 2596 1506 2568 1517 2525 1506 2522 1506 2520 1506 2518 1506 2494 1517 2375 1506 2373 1506 2371 1506 2341 1517 2282 1506 2280 1506 2278 1506 2234 1517 2180 1506 2178 1506 2176 1506 2141 1517 1899 1509 1897 1509 1797 1519 1762 1509 1760 1509 1758 1509 1671 1519 1617 1509 1615 1509 1613 1509 1576 1519 1539 1509 1537 1509 1535 1509 1533 1509 1531 1509 1515 1519 1370 1511 1368 1511 1158 1521 1100 1511 1097 1511 887 1524 890 1554"/>
                        </Shape>
                        <String CONTENT="snow melts away only late in the spring. Travelling with skin boats begins"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l17" HPOS="890" VPOS="1569" WIDTH="1767" HEIGHT="61" BASELINE="890 1610 2657 1610" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1610 890 1630 2655 1630 2657 1610 2655 1582 2561 1569 2559 1569 2481 1580 2449 1569 2447 1569 2445 1569 2364 1580 2122 1569 2120 1569 2031 1580 1998 1569 1996 1569 1994 1569 1907 1580 1851 1569 1849 1569 1847 1569 1845 1569 1829 1580 1806 1569 1803 1569 1801 1569 1676 1580 1589 1569 1587 1569 1524 1580 1476 1569 1474 1569 1472 1569 1470 1569 1468 1569 1455 1580 1429 1569 1427 1569 1424 1569 1295 1580 1195 1569 1193 1569 1191 1569 1154 1580 1126 1569 1123 1569 1121 1569 1119 1569 1117 1569 1102 1582 1015 1582 985 1569 983 1569 981 1569 890 1580 890 1610"/>
                        </Shape>
                        <String CONTENT="at the end of May, and from July on wholly replaces journeying with sledges."/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l18" HPOS="890" VPOS="1641" WIDTH="1769" HEIGHT="47" BASELINE="890 1671 2659 1671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1671 890 1688 2659 1688 2659 1671 2659 1641 890 1641 890 1671"/>
                        </Shape>
                        <String CONTENT="Only skin boats are used, since it is difficult to make a landing with wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l19" HPOS="890" VPOS="1688" WIDTH="1769" HEIGHT="61" BASELINE="892 1732 2659 1727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="892 1732 892 1749 2657 1744 2659 1727 2655 1699 1801 1688 1799 1688 1797 1688 1765 1699 931 1690 929 1690 926 1690 890 1701 892 1732"/>
                        </Shape>
                        <String CONTENT="whaling-boats, owing to the heavy surf, and because they are too heavy to"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l20" HPOS="890" VPOS="1762" WIDTH="400" HEIGHT="47" BASELINE="890 1790 1290 1790" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 1790 890 1807 1288 1809 1290 1790 1290 1762 890 1762 890 1790"/>
                        </Shape>
                        <String CONTENT="be pulled ashore."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r5" HPOS="887" VPOS="1816" WIDTH="1778" HEIGHT="241" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="887 1816 2665 1816 2665 2057 887 2057"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l21" HPOS="994" VPOS="1805" WIDTH="1667" HEIGHT="63" BASELINE="996 1851 2661 1846" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="996 1851 996 1868 2661 1864 2661 1846 2655 1816 2585 1805 2583 1805 2581 1805 2551 1816 2535 1805 2533 1805 2531 1805 2529 1805 2527 1805 2505 1816 2427 1805 2425 1805 2423 1805 2399 1818 2260 1818 2185 1805 2182 1805 2107 1816 2029 1805 2027 1805 1959 1816 1933 1805 1931 1805 1929 1805 1871 1816 1832 1805 1829 1805 1827 1805 1825 1805 1823 1805 1806 1818 1656 1807 1654 1807 1576 1818 1552 1807 1550 1807 1548 1807 1489 1818 1463 1807 1461 1807 1459 1807 1457 1807 1424 1818 1368 1807 1366 1807 1284 1818 1232 1807 1230 1807 1104 1818 1007 1807 1004 1807 1002 1807 1000 1807 1000 1809 994 1814 996 1851"/>
                        </Shape>
                        <String CONTENT="Direct trading with the American natives has fallen off, because the whalers"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l22" HPOS="885" VPOS="1877" WIDTH="1774" HEIGHT="52" BASELINE="887 1911 2659 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 1911 887 1929 2657 1924 2659 1907 2652 1877 885 1879 887 1911"/>
                        </Shape>
                        <String CONTENT="act as middle-men. At the present time the American Eskimo have not enough"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l23" HPOS="885" VPOS="1929" WIDTH="1772" HEIGHT="64" BASELINE="887 1974 2657 1967" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 1974 887 1993 2655 1985 2657 1967 2652 1937 1533 1929 1531 1929 1455 1939 946 1931 944 1931 885 1942 887 1974"/>
                        </Shape>
                        <String CONTENT="peltries and seal-skins to trade with the Asiatic natives, because all such things"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l24" HPOS="887" VPOS="2002" WIDTH="693" HEIGHT="48" BASELINE="887 2032 1580 2032" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 2032 887 2050 1580 2045 1580 2032 1580 2002 887 2002 887 2032"/>
                        </Shape>
                        <String CONTENT="go to the local white traders."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r6" HPOS="887" VPOS="2057" WIDTH="1778" HEIGHT="712" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="887 2057 2665 2057 2665 2769 887 2769"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l25" HPOS="996" VPOS="2058" WIDTH="1663" HEIGHT="50" BASELINE="996 2091 2659 2091" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="996 2091 996 2108 2659 2108 2659 2091 2659 2061 996 2058 996 2091"/>
                        </Shape>
                        <String CONTENT="People from St. Lawrence and Diomede Islands often come over to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l26" HPOS="887" VPOS="2106" WIDTH="1770" HEIGHT="63" BASELINE="890 2154 2657 2147" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 2154 890 2169 2655 2165 2657 2147 2655 2119 2620 2106 2618 2106 2616 2106 2559 2117 2455 2106 2453 2106 2380 2117 2347 2106 2345 2106 2343 2106 2159 2117 2070 2106 2068 2106 2066 2106 2033 2119 1894 2108 1892 2108 1814 2119 1786 2108 1784 2108 1782 2108 1780 2108 1777 2108 1762 2121 1474 2121 907 2110 905 2110 903 2110 900 2110 887 2119 890 2154"/>
                        </Shape>
                        <String CONTENT="Asiatic shore, for the most part on board the whalers, carrying their skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l27" HPOS="887" VPOS="2165" WIDTH="1770" HEIGHT="64" BASELINE="890 2214 2657 2206" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 2214 890 2229 2655 2223 2657 2206 2652 2177 2438 2165 2436 2165 2434 2165 2412 2175 2380 2165 2377 2165 2375 2165 2289 2175 2260 2165 2258 2165 2256 2165 2254 2165 2206 2177 2178 2167 2176 2167 2174 2167 2035 2177 1897 2167 1894 2167 1892 2167 1890 2167 1875 2180 1754 2182 1598 2182 1583 2169 1580 2169 1578 2169 1576 2169 1574 2169 1533 2180 1340 2169 1338 2169 1336 2169 1299 2182 1204 2171 1201 2171 1199 2171 1167 2182 1130 2171 1128 2171 1126 2171 887 2177 890 2214"/>
                        </Shape>
                        <String CONTENT="boats with them for cases of emergency. Trading-parties from Indian Point"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l28" HPOS="887" VPOS="2229" WIDTH="1770" HEIGHT="61" BASELINE="890 2275 2657 2268" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 2275 890 2290 2655 2284 2657 2268 2652 2238 1479 2229 1476 2229 1474 2229 1450 2240 924 2232 922 2232 920 2232 887 2242 890 2275"/>
                        </Shape>
                        <String CONTENT="still go over in boats to St. Lawrence Island to barter reindeer-skins for spare"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l29" HPOS="890" VPOS="2297" WIDTH="1769" HEIGHT="54" BASELINE="890 2331 2659 2331" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 2331 890 2351 2659 2351 2659 2331 2659 2301 890 2297 890 2331"/>
                        </Shape>
                        <String CONTENT="blubber, walrus-hides, and some whalebone, which last now forms an important"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l30" HPOS="885" VPOS="2346" WIDTH="1772" HEIGHT="61" BASELINE="887 2392 2657 2387" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 2392 887 2407 2655 2403 2657 2387 2652 2359 2590 2346 2587 2346 2585 2346 2557 2357 2267 2346 2265 2346 2198 2357 2070 2346 2068 2346 2007 2357 1959 2346 1957 2346 1955 2346 1864 2357 1803 2346 1801 2346 1799 2346 1760 2359 1717 2349 1715 2349 1713 2349 1710 2349 1687 2359 1663 2349 1661 2349 1658 2349 1656 2349 1628 2359 1266 2349 1264 2349 1171 2359 1115 2349 1113 2349 1110 2349 1067 2359 1028 2349 1026 2349 1024 2349 1022 2349 989 2359 898 2349 896 2349 894 2349 892 2349 892 2351 885 2355 887 2392"/>
                        </Shape>
                        <String CONTENT="item in the native trade before it is sold to the whalers. They also gather"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l31" HPOS="887" VPOS="2420" WIDTH="1772" HEIGHT="48" BASELINE="887 2450 2659 2450" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="887 2450 887 2468 2659 2468 2659 2450 2659 2420 887 2420 887 2450"/>
                        </Shape>
                        <String CONTENT="driftwood on the northern shore of the island, or buy roughly-hewn runners"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l32" HPOS="887" VPOS="2465" WIDTH="1770" HEIGHT="63" BASELINE="890 2513 2657 2507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="890 2513 890 2528 2655 2522 2657 2507 2652 2476 2068 2465 2066 2465 1472 2478 957 2470 955 2470 887 2481 890 2513"/>
                        </Shape>
                        <String CONTENT="and parts of skin-boat frames from the natives of the island. A similar trade"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l33" HPOS="890" VPOS="2537" WIDTH="1767" HEIGHT="52" BASELINE="892 2572 2657 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="892 2572 892 2589 2655 2582 2657 2565 2652 2537 890 2537 892 2572"/>
                        </Shape>
                        <String CONTENT="in wood and in roughly-hewn runners, dishes, trays, etc., is carried on across"/>
                    </TextLine>

