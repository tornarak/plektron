                    <TextLine ID="mz_1-090_l3" HPOS="864" VPOS="716" WIDTH="1774" HEIGHT="57" BASELINE="866 757 2638 753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 757 866 773 2636 770 2638 753 2634 725 886 716 884 716 882 716 879 716 864 723 866 757"/>
                        </Shape>
                        <String CONTENT="to last for the trade of the whole year. They have even bought wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l4" HPOS="864" VPOS="777" WIDTH="1207" HEIGHT="58" BASELINE="866 818 2071 814" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 818 866 835 2068 831 2071 814 2066 786 975 777 973 777 864 788 866 818"/>
                        </Shape>
                        <String CONTENT="storehouses brought on purpose from San Francisco."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r3" HPOS="866" VPOS="839" WIDTH="1778" HEIGHT="238" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="866 839 2644 839 2644 1077 866 1077"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l5" HPOS="975" VPOS="838" WIDTH="1665" HEIGHT="58" BASELINE="977 879 2640 872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="977 879 977 896 2638 889 2640 872 2634 842 996 838 994 838 992 838 990 838 975 844 977 879"/>
                        </Shape>
                        <String CONTENT="At the present time the whole number of such storehouses on the Pacific"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l6" HPOS="864" VPOS="894" WIDTH="1772" HEIGHT="65" BASELINE="866 939 2636 935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="864 924 866 939 866 952 2631 959 2636 935 2631 905 1765 894 1763 894 1761 894 1759 894 1744 905 895 896 892 896 890 896 866 905 864 924"/>
                        </Shape>
                        <String CONTENT="shore is fourteen. Indian Point has five, of which three belong to Kuvaˊr,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l7" HPOS="866" VPOS="954" WIDTH="1770" HEIGHT="61" BASELINE="866 998 2636 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 998 866 1013 2634 1015 2636 998 2636 967 2564 954 2562 954 2257 965 2224 954 2222 954 2016 954 2014 954 1943 965 1908 954 1906 954 1904 954 1902 954 1863 965 1826 954 1824 954 1821 954 1819 954 1795 965 1744 954 1741 954 1676 965 1648 954 1646 954 1644 954 1642 954 1640 954 1624 965 1520 954 1518 954 1516 954 1486 965 1442 954 1440 954 1438 954 1436 954 1434 954 1414 967 1157 967 1096 954 1094 954 1033 965 1005 954 1003 954 1001 954 999 954 996 954 979 967 866 967 866 998"/>
                        </Shape>
                        <String CONTENT="now the richest man on the Chukchee Peninsula. Nɵˊɵkan has three; Uweˊlen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l8" HPOS="864" VPOS="1013" WIDTH="1739" HEIGHT="60" BASELINE="866 1058 2603 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 1058 866 1073 2601 1069 2603 1054 2599 1026 2478 1013 2475 1013 2413 1024 2148 1013 2146 1013 2032 1024 1865 1013 1863 1013 1728 1026 1685 1015 1683 1015 1681 1015 1375 1026 1202 1015 1200 1015 1198 1015 1152 1026 1022 1015 1020 1015 1018 1015 1016 1015 1001 1028 864 1028 866 1058"/>
                        </Shape>
                        <String CONTENT="one. Single storehouses are found in several Eskimo and Chukchee villages."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r4" HPOS="866" VPOS="1077" WIDTH="1778" HEIGHT="724" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="866 1077 2644 1077 2644 1801 866 1801"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l9" HPOS="977" VPOS="1069" WIDTH="1661" HEIGHT="65" BASELINE="979 1119 2638 1110" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="979 1119 979 1134 2636 1128 2638 1110 2634 1080 2339 1069 2337 1069 2248 1080 2224 1069 2222 1069 2220 1069 2218 1069 2216 1069 2200 1082 2185 1071 2183 1071 2181 1071 2179 1071 2177 1071 2148 1082 977 1082 979 1119"/>
                        </Shape>
                        <String CONTENT="The whalers seldom skirt the Arctic coast westward from Uweˊlen, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l10" HPOS="864" VPOS="1132" WIDTH="1774" HEIGHT="61" BASELINE="866 1177 2638 1173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 1177 866 1193 2636 1188 2638 1173 2636 1145 2603 1132 2601 1132 2599 1132 2597 1132 2571 1143 2272 1132 2270 1132 2268 1132 2222 1143 2196 1132 2194 1132 2192 1132 2190 1132 2159 1143 2097 1132 2094 1132 2092 1132 2090 1132 2075 1145 1988 1145 1932 1132 1930 1132 1928 1132 1925 1132 1915 1143 1902 1132 1899 1132 1897 1132 1752 1132 1750 1132 1748 1132 1746 1132 1728 1145 1715 1134 1713 1134 1711 1134 1709 1134 1707 1134 1679 1145 1161 1134 1159 1134 1107 1145 1025 1134 1022 1134 1020 1134 1018 1134 1001 1147 864 1147 866 1177"/>
                        </Shape>
                        <String CONTENT="even then almost never go beyond Kuluˊči Bay. All the Maritime people"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l11" HPOS="866" VPOS="1197" WIDTH="1770" HEIGHT="58" BASELINE="869 1240 2636 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1240 869 1253 2631 1255 2636 1236 2631 1206 908 1197 905 1197 903 1197 866 1208 869 1240"/>
                        </Shape>
                        <String CONTENT="who wish to take part in this trading, resort, those from the Arctic villages,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l12" HPOS="866" VPOS="1249" WIDTH="1772" HEIGHT="69" BASELINE="869 1301 2638 1292" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1301 869 1318 2636 1309 2638 1292 2634 1262 2196 1249 2194 1249 2192 1249 2190 1249 2172 1262 2036 1251 2034 1251 2032 1251 2029 1251 2014 1264 1847 1264 1791 1251 1789 1251 1787 1251 1748 1264 1711 1253 1709 1253 1707 1253 1438 1264 1386 1253 1384 1253 1382 1253 1380 1253 1365 1264 953 1255 951 1255 866 1268 869 1301"/>
                        </Shape>
                        <String CONTENT="to East Cape; those from the Pacific villages, to Indian Point. No positive"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l13" HPOS="866" VPOS="1316" WIDTH="1770" HEIGHT="61" BASELINE="869 1359 2636 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1359 869 1374 2631 1377 2636 1355 2631 1325 892 1316 890 1316 888 1316 866 1325 869 1359"/>
                        </Shape>
                        <String CONTENT="times are set for these gatherings; but, beginning with the middle of March,"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l14" HPOS="866" VPOS="1372" WIDTH="1770" HEIGHT="63" BASELINE="869 1420 2636 1411" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1420 869 1435 2634 1431 2636 1411 2631 1383 2203 1372 2200 1372 2198 1372 2174 1383 886 1379 884 1379 882 1379 879 1379 866 1385 869 1420"/>
                        </Shape>
                        <String CONTENT="the dog-teams and reindeer-caravans begin to appear one after another. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l15" HPOS="866" VPOS="1433" WIDTH="1770" HEIGHT="63" BASELINE="869 1481 2636 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1481 869 1496 2634 1489 2636 1474 2631 1444 2090 1433 2088 1433 2086 1433 2040 1446 866 1446 869 1481"/>
                        </Shape>
                        <String CONTENT="keep coming long after the appearance of the first whaling-ships, because the"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l16" HPOS="866" VPOS="1491" WIDTH="1772" HEIGHT="74" BASELINE="869 1539 2638 1532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1539 869 1554 1261 1565 1263 1565 1265 1565 1297 1554 1378 1565 1380 1565 1499 1552 1808 1563 1811 1563 1813 1563 1815 1563 1830 1552 2094 1561 2097 1561 2099 1561 2101 1561 2116 1550 2339 1550 2437 1561 2439 1561 2441 1561 2484 1550 2573 1561 2575 1561 2636 1548 2638 1532 2634 1504 2579 1491 2577 1491 2575 1491 2547 1502 2504 1491 2501 1491 2499 1491 2497 1491 2473 1502 2354 1491 2352 1491 2350 1491 2320 1502 2261 1491 2259 1491 2257 1491 2213 1502 2159 1491 2157 1491 2155 1491 2120 1502 1878 1494 1876 1494 1776 1504 1741 1494 1739 1494 1737 1494 1650 1504 1596 1494 1594 1494 1592 1494 1555 1504 1518 1494 1516 1494 1514 1494 1512 1494 1510 1494 1494 1504 1349 1496 1347 1496 1137 1506 1079 1496 1076 1496 866 1509 869 1539"/>
                        </Shape>
                        <String CONTENT="snow melts away only late in the spring. Travelling with skin boats begins"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l17" HPOS="869" VPOS="1554" WIDTH="1767" HEIGHT="61" BASELINE="869 1595 2636 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1595 869 1615 2634 1615 2636 1595 2634 1567 2540 1554 2538 1554 2460 1565 2428 1554 2426 1554 2424 1554 2343 1565 2101 1554 2099 1554 2010 1565 1977 1554 1975 1554 1973 1554 1886 1565 1830 1554 1828 1554 1826 1554 1824 1554 1808 1565 1785 1554 1782 1554 1780 1554 1655 1565 1568 1554 1566 1554 1503 1565 1455 1554 1453 1554 1451 1554 1449 1554 1447 1554 1434 1565 1408 1554 1406 1554 1403 1554 1274 1565 1174 1554 1172 1554 1170 1554 1133 1565 1105 1554 1102 1554 1100 1554 1098 1554 1096 1554 1081 1567 994 1567 964 1554 962 1554 960 1554 869 1565 869 1595"/>
                        </Shape>
                        <String CONTENT="at the end of May, and from July on wholly replaces journeying with sledges."/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l18" HPOS="869" VPOS="1626" WIDTH="1769" HEIGHT="47" BASELINE="869 1656 2638 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1656 869 1673 2638 1673 2638 1656 2638 1626 869 1626 869 1656"/>
                        </Shape>
                        <String CONTENT="Only skin boats are used, since it is difficult to make a landing with wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l19" HPOS="869" VPOS="1673" WIDTH="1769" HEIGHT="61" BASELINE="871 1717 2638 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="871 1717 871 1734 2636 1729 2638 1712 2634 1684 1780 1673 1778 1673 1776 1673 1744 1684 910 1675 908 1675 905 1675 869 1686 871 1717"/>
                        </Shape>
                        <String CONTENT="whaling-boats, owing to the heavy surf, and because they are too heavy to"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l20" HPOS="869" VPOS="1747" WIDTH="400" HEIGHT="47" BASELINE="869 1775 1269 1775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 1775 869 1792 1267 1794 1269 1775 1269 1747 869 1747 869 1775"/>
                        </Shape>
                        <String CONTENT="be pulled ashore."/>
