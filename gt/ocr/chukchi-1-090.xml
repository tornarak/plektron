                        <Polygon POINTS="866 1801 2644 1801 2644 2042 866 2042"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l21" HPOS="973" VPOS="1790" WIDTH="1667" HEIGHT="63" BASELINE="975 1836 2640 1831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="975 1836 975 1853 2640 1849 2640 1831 2634 1801 2564 1790 2562 1790 2560 1790 2530 1801 2514 1790 2512 1790 2510 1790 2508 1790 2506 1790 2484 1801 2406 1790 2404 1790 2402 1790 2378 1803 2239 1803 2164 1790 2161 1790 2086 1801 2008 1790 2006 1790 1938 1801 1912 1790 1910 1790 1908 1790 1850 1801 1811 1790 1808 1790 1806 1790 1804 1790 1802 1790 1785 1803 1635 1792 1633 1792 1555 1803 1531 1792 1529 1792 1527 1792 1468 1803 1442 1792 1440 1792 1438 1792 1436 1792 1403 1803 1347 1792 1345 1792 1263 1803 1211 1792 1209 1792 1083 1803 986 1792 983 1792 981 1792 979 1792 979 1794 973 1799 975 1836"/>
                        </Shape>
                        <String CONTENT="Direct trading with the American natives has fallen off, because the whalers"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l22" HPOS="864" VPOS="1862" WIDTH="1774" HEIGHT="52" BASELINE="866 1896 2638 1892" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 1896 866 1914 2636 1909 2638 1892 2631 1862 864 1864 866 1896"/>
                        </Shape>
                        <String CONTENT="act as middle-men. At the present time the American Eskimo have not enough"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l23" HPOS="864" VPOS="1914" WIDTH="1772" HEIGHT="64" BASELINE="866 1959 2636 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 1959 866 1978 2634 1970 2636 1952 2631 1922 1512 1914 1510 1914 1434 1924 925 1916 923 1916 864 1927 866 1959"/>
                        </Shape>
                        <String CONTENT="peltries and seal-skins to trade with the Asiatic natives, because all such things"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l24" HPOS="866" VPOS="1987" WIDTH="693" HEIGHT="48" BASELINE="866 2017 1559 2017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 2017 866 2035 1559 2030 1559 2017 1559 1987 866 1987 866 2017"/>
                        </Shape>
                        <String CONTENT="go to the local white traders."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-090_r6" HPOS="866" VPOS="2042" WIDTH="1778" HEIGHT="712" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="866 2042 2644 2042 2644 2754 866 2754"/>
                    </Shape>
                    <TextLine ID="mz_1-090_l25" HPOS="975" VPOS="2043" WIDTH="1663" HEIGHT="50" BASELINE="975 2076 2638 2076" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="975 2076 975 2093 2638 2093 2638 2076 2638 2046 975 2043 975 2076"/>
                        </Shape>
                        <String CONTENT="People from St. Lawrence and Diomede Islands often come over to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l26" HPOS="866" VPOS="2091" WIDTH="1770" HEIGHT="63" BASELINE="869 2139 2636 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 2139 869 2154 2634 2150 2636 2132 2634 2104 2599 2091 2597 2091 2595 2091 2538 2102 2434 2091 2432 2091 2359 2102 2326 2091 2324 2091 2322 2091 2138 2102 2049 2091 2047 2091 2045 2091 2012 2104 1873 2093 1871 2093 1793 2104 1765 2093 1763 2093 1761 2093 1759 2093 1756 2093 1741 2106 1453 2106 886 2095 884 2095 882 2095 879 2095 866 2104 869 2139"/>
                        </Shape>
                        <String CONTENT="Asiatic shore, for the most part on board the whalers, carrying their skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l27" HPOS="866" VPOS="2150" WIDTH="1770" HEIGHT="64" BASELINE="869 2199 2636 2191" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 2199 869 2214 2634 2208 2636 2191 2631 2162 2417 2150 2415 2150 2413 2150 2391 2160 2359 2150 2356 2150 2354 2150 2268 2160 2239 2150 2237 2150 2235 2150 2233 2150 2185 2162 2157 2152 2155 2152 2153 2152 2014 2162 1876 2152 1873 2152 1871 2152 1869 2152 1854 2165 1733 2167 1577 2167 1562 2154 1559 2154 1557 2154 1555 2154 1553 2154 1512 2165 1319 2154 1317 2154 1315 2154 1278 2167 1183 2156 1180 2156 1178 2156 1146 2167 1109 2156 1107 2156 1105 2156 866 2162 869 2199"/>
                        </Shape>
                        <String CONTENT="boats with them for cases of emergency. Trading-parties from Indian Point"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l28" HPOS="866" VPOS="2214" WIDTH="1770" HEIGHT="61" BASELINE="869 2260 2636 2253" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 2260 869 2275 2634 2269 2636 2253 2631 2223 1458 2214 1455 2214 1453 2214 1429 2225 903 2217 901 2217 899 2217 866 2227 869 2260"/>
                        </Shape>
                        <String CONTENT="still go over in boats to St. Lawrence Island to barter reindeer-skins for spare"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l29" HPOS="869" VPOS="2282" WIDTH="1769" HEIGHT="54" BASELINE="869 2316 2638 2316" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 2316 869 2336 2638 2336 2638 2316 2638 2286 869 2282 869 2316"/>
                        </Shape>
                        <String CONTENT="blubber, walrus-hides, and some whalebone, which last now forms an important"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l30" HPOS="864" VPOS="2331" WIDTH="1772" HEIGHT="61" BASELINE="866 2377 2636 2372" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 2377 866 2392 2634 2388 2636 2372 2631 2344 2569 2331 2566 2331 2564 2331 2536 2342 2246 2331 2244 2331 2177 2342 2049 2331 2047 2331 1986 2342 1938 2331 1936 2331 1934 2331 1843 2342 1782 2331 1780 2331 1778 2331 1739 2344 1696 2334 1694 2334 1692 2334 1689 2334 1666 2344 1642 2334 1640 2334 1637 2334 1635 2334 1607 2344 1245 2334 1243 2334 1150 2344 1094 2334 1092 2334 1089 2334 1046 2344 1007 2334 1005 2334 1003 2334 1001 2334 968 2344 877 2334 875 2334 873 2334 871 2334 871 2336 864 2340 866 2377"/>
                        </Shape>
                        <String CONTENT="item in the native trade before it is sold to the whalers. They also gather"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l31" HPOS="866" VPOS="2405" WIDTH="1772" HEIGHT="48" BASELINE="866 2435 2638 2435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="866 2435 866 2453 2638 2453 2638 2435 2638 2405 866 2405 866 2435"/>
                        </Shape>
                        <String CONTENT="driftwood on the northern shore of the island, or buy roughly-hewn runners"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l32" HPOS="866" VPOS="2450" WIDTH="1770" HEIGHT="63" BASELINE="869 2498 2636 2492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="869 2498 869 2513 2634 2507 2636 2492 2631 2461 2047 2450 2045 2450 1451 2463 936 2455 934 2455 866 2466 869 2498"/>
                        </Shape>
                        <String CONTENT="and parts of skin-boat frames from the natives of the island. A similar trade"/>
                    </TextLine>

                    <TextLine ID="mz_1-090_l33" HPOS="869" VPOS="2522" WIDTH="1767" HEIGHT="52" BASELINE="871 2557 2636 2550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="871 2557 871 2574 2634 2567 2636 2550 2631 2522 869 2522 871 2557"/>
                        </Shape>
                        <String CONTENT="in wood and in roughly-hewn runners, dishes, trays, etc., is carried on across"/>
                    </TextLine>

