                            <Polygon POINTS="521 2695 521 2712 2174 2704 2176 2686 2172 2656 519 2656 521 2695"/>
                        </Shape>
                        <String CONTENT="Tobacco has found its way from Siberia far eastward into arctic America."/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l36" HPOS="407" VPOS="2717" WIDTH="1769" HEIGHT="56" BASELINE="409 2756 2176 2747" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 2756 409 2773 2174 2769 2176 2747 2172 2717 407 2717 409 2756"/>
                        </Shape>
                        <String CONTENT="The Chukchee tradition in regard to the ancient trade, previously referred to,"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l37" HPOS="404" VPOS="2782" WIDTH="553" HEIGHT="54" BASELINE="407 2810 957 2814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2810 404 2829 413 2836 415 2836 417 2836 420 2836 955 2827 957 2814 955 2786 407 2782 407 2810"/>
                        </Shape>
                        <String CONTENT="continues as follows: —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-085_r7" HPOS="400" VPOS="2839" WIDTH="1778" HEIGHT="234" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="400 2839 2178 2839 2178 3073 400 3073"/>
                    </Shape>
                    <TextLine ID="mz_1-085_l38" HPOS="519" VPOS="2829" WIDTH="1659" HEIGHT="61" BASELINE="521 2872 2178 2868" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="521 2872 521 2890 2176 2890 2178 2868 2174 2840 1349 2829 1347 2829 1344 2829 1316 2842 519 2842 521 2872"/>
                        </Shape>
                        <String CONTENT="“Farther on live men who dissever themselves at will. They stay among"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l39" HPOS="402" VPOS="2896" WIDTH="1774" HEIGHT="61" BASELINE="404 2933 2176 2924" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="404 2933 404 2948 1180 2946 1208 2957 1210 2957 1212 2957 1334 2944 1520 2944 1535 2955 1537 2955 1539 2955 1541 2955 2174 2942 2176 2924 2169 2896 402 2903 404 2933"/>
                        </Shape>
                        <String CONTENT="the trees on the shores of the lakes, cleft in halves; but, at the slightest"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l40" HPOS="402" VPOS="2950" WIDTH="1772" HEIGHT="63" BASELINE="404 2996 2174 2987" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="404 2996 404 3013 2172 3013 2174 2987 2169 2959 1310 2950 1308 2950 838 2963 485 2955 482 2955 402 2966 404 2996"/>
                        </Shape>
                        <String CONTENT="rustling, the parts come together, and they dive into the water. These, too,"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l41" HPOS="404" VPOS="3007" WIDTH="1614" HEIGHT="73" BASELINE="407 3056 2018 3048" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 3056 407 3069 755 3080 757 3080 760 3080 762 3080 775 3069 1046 3078 1048 3078 1050 3078 1052 3078 1067 3067 1195 3078 1197 3078 1262 3065 1526 3065 1611 3076 1613 3076 1615 3076 1654 3063 1814 3074 1816 3074 2016 3061 2018 3048 2014 3018 1678 3007 1676 3007 1596 3018 1284 3009 1282 3009 1201 3020 809 3011 807 3011 805 3011 773 3024 404 3024 407 3056"/>
                        </Shape>
                        <String CONTENT="have a longing for tobacco, and pay for it with large fish and otters."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-085_r8" HPOS="400" VPOS="3073" WIDTH="1778" HEIGHT="189" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="400 3073 2178 3073 2178 3262 400 3262"/>
                    </Shape>
                    <TextLine ID="mz_1-085_l42" HPOS="526" VPOS="3078" WIDTH="1652" HEIGHT="50" BASELINE="526 3108 2178 3108" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="526 3108 526 3128 2178 3128 2178 3108 2178 3080 526 3078 526 3108"/>
                        </Shape>
                        <String CONTENT="“Still deeper in the woods live dwarfs not larger than the fore-arm of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l43" HPOS="404" VPOS="3124" WIDTH="1772" HEIGHT="67" BASELINE="407 3178 2176 3165" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 3178 407 3191 2174 3189 2176 3165 2172 3137 1933 3124 1931 3124 1847 3137 1715 3126 1713 3126 1710 3126 1708 3126 1693 3139 1169 3141 1152 3130 1149 3130 1147 3130 1028 3130 1026 3130 1024 3130 1022 3130 1007 3141 760 3132 757 3132 755 3132 729 3143 571 3134 569 3134 567 3134 565 3134 552 3145 498 3137 495 3137 404 3147 407 3178"/>
                        </Shape>
                        <String CONTENT="man. Three of them can hardly overcome one goose. They dwell in trees,"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l44" HPOS="404" VPOS="3189" WIDTH="1490" HEIGHT="62" BASELINE="407 3236 1894 3228" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 3236 407 3251 1894 3243 1894 3228 1890 3197 1186 3189 1184 3189 1182 3189 1145 3199 844 3191 842 3191 404 3204 407 3236"/>
                        </Shape>
                        <String CONTENT="and buy tobacco with the skins of the lynx and of the muskrat."/>
                    </TextLine>
