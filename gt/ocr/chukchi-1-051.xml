                <TextBlock ID="mz_1-051_r1" HPOS="396" VPOS="618" WIDTH="1778" HEIGHT="90" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="396 618 2174 618 2174 708 396 708"/>
                    </Shape>
                    <TextLine ID="mz_1-051_l1" HPOS="963" VPOS="632" WIDTH="622" HEIGHT="56" BASELINE="965 664 1585 671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1576 634 983 632 965 660 965 664 963 681 1580 688 1585 671 1583 643 1576 634"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l2" HPOS="2102" VPOS="643" WIDTH="31" HEIGHT="56" BASELINE="2107 675 2133 673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2126 647 2102 643 2107 675 2107 697 2133 699 2133 673 2128 647 2126 647"/>
                        </Shape>
                        <String CONTENT="29"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-051_r2" HPOS="396" VPOS="729" WIDTH="1778" HEIGHT="564" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="396 729 2174 729 2174 1293 396 1293"/>
                    </Shape>
                    <TextLine ID="mz_1-051_l3" HPOS="398" VPOS="738" WIDTH="1763" HEIGHT="52" BASELINE="400 770 2161 766" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="528 738 506 740 485 740 463 740 441 742 420 742 398 742 400 770 400 790 2159 785 2161 766 2156 738 550 738 528 738"/>
                        </Shape>
                        <String CONTENT="Valkaˊʟ̣ên (“having houses of whale’s jaw-bone”), which had during my visit 4 houses with 28 people"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l4" HPOS="469" VPOS="788" WIDTH="1690" HEIGHT="47" BASELINE="472 820 2159 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 820 472 835 2156 831 2159 816 2152 788 469 790 472 820"/>
                        </Shape>
                        <String CONTENT="(Register, 7 houses, 39 inhabitants). The underground houses alluded to in the name went"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l5" HPOS="472" VPOS="829" WIDTH="1682" HEIGHT="54" BASELINE="474 866 2154 859" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 866 474 883 2152 876 2154 859 2148 829 472 835 474 866"/>
                        </Shape>
                        <String CONTENT="out of use long ago, and the inhabitants now live in large “genuine houses” of the usual type.¹"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l6" HPOS="394" VPOS="894" WIDTH="1767" HEIGHT="52" BASELINE="396 926 2161 922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 926 396 946 2159 946 2161 922 2154 894 394 896 396 926"/>
                        </Shape>
                        <String CONTENT="ᴇˊnmɪlɪn (“craggy”), in the Aiˊwan Eskimo language Tɪkɪˊvak, which lies five miles farther on, along"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l7" HPOS="476" VPOS="941" WIDTH="1683" HEIGHT="50" BASELINE="476 969 2159 969" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 969 476 989 2156 991 2159 969 2159 941 476 941 476 969"/>
                        </Shape>
                        <String CONTENT="the shore. It had 17 houses, and a mile from it 2 more, with a total population of 126 (Register,"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l8" HPOS="476" VPOS="987" WIDTH="502" HEIGHT="52" BASELINE="478 1021 978 1015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="478 1021 478 1039 976 1032 978 1015 972 987 476 991 478 1021"/>
                        </Shape>
                        <String CONTENT="19 houses, 104 inhabitants)."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l9" HPOS="394" VPOS="1039" WIDTH="1767" HEIGHT="52" BASELINE="396 1073 2161 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1073 396 1091 2159 1084 2161 1067 2154 1039 394 1043 396 1073"/>
                        </Shape>
                        <String CONTENT="Nuˊnlig̣ren (see Plate I, Fig. 2), which had 17 houses in one place, and 4 in another near by, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l10" HPOS="472" VPOS="1084" WIDTH="1050" HEIGHT="54" BASELINE="474 1121 1522 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1121 474 1138 1520 1132 1522 1112 1515 1084 472 1091 474 1121"/>
                        </Shape>
                        <String CONTENT="a population of 104 (Register, 25 houses, 110 inhabitants)."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l11" HPOS="396" VPOS="1143" WIDTH="1763" HEIGHT="62" BASELINE="398 1179 2159 1171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 1179 398 1205 2156 1188 2159 1171 2152 1143 396 1149 398 1179"/>
                        </Shape>
                        <String CONTENT="Aˊčon, the last Chukchee village, which had during my visit 5 houses with 24 inhabitants. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l12" HPOS="474" VPOS="1192" WIDTH="1687" HEIGHT="52" BASELINE="476 1227 2161 1221" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 1227 476 1244 2159 1238 2161 1221 2154 1192 474 1197 476 1227"/>
                        </Shape>
                        <String CONTENT="were very poor Reindeer people, who had turned to seal-hunting as a last resort, but were not"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l13" HPOS="472" VPOS="1240" WIDTH="1063" HEIGHT="52" BASELINE="474 1273 1535 1268" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1273 474 1292 1533 1288 1535 1268 1528 1240 472 1242 474 1273"/>
                        </Shape>
                        <String CONTENT="successful even at that (Register, 4 houses, 19 inhabitants)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-051_r3" HPOS="396" VPOS="1317" WIDTH="1778" HEIGHT="1087" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="396 1317 2174 1317 2174 2404 396 2404"/>
                    </Shape>
                    <TextLine ID="mz_1-051_l14" HPOS="1197" VPOS="1322" WIDTH="160" HEIGHT="52" BASELINE="1199 1359 1357 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1199 1359 1199 1374 1355 1370 1357 1353 1351 1322 1197 1327 1199 1359"/>
                        </Shape>
                        <String CONTENT="ESKIMO."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l15" HPOS="396" VPOS="1398" WIDTH="1765" HEIGHT="52" BASELINE="398 1431 2161 1426" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 1431 398 1450 2159 1446 2161 1426 2154 1398 396 1400 398 1431"/>
                        </Shape>
                        <String CONTENT="Wuteˊen or Wuˊturen (Eskimo, Čeṛiˊnak), the first Eskimo village, which lies near Cape Ulakhpen."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l16" HPOS="472" VPOS="1439" WIDTH="1329" HEIGHT="59" BASELINE="474 1480 1801 1474" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1480 474 1498 1799 1491 1801 1474 1795 1439 472 1450 474 1480"/>
                        </Shape>
                        <String CONTENT="It had 8 houses with 58 inhabitants (Register, 14 houses, 77 inhabitants).²"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l17" HPOS="396" VPOS="1502" WIDTH="1758" HEIGHT="61" BASELINE="398 1541 2154 1530" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 1541 398 1563 2152 1547 2154 1530 2148 1502 396 1511 398 1541"/>
                        </Shape>
                        <String CONTENT="Between Aˊčon and Wuteˊen, in former times, there was a small settlement, Čeˊnlin, occupied by"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l18" HPOS="474" VPOS="1550" WIDTH="1687" HEIGHT="54" BASELINE="476 1586 2161 1578" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 1586 476 1604 2159 1595 2161 1578 2154 1550 474 1556 476 1586"/>
                        </Shape>
                        <String CONTENT="the Wuteˊelɪt and the Chukchee. The greater part of its inhabitants, however, perished in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l19" HPOS="474" VPOS="1597" WIDTH="1687" HEIGHT="52" BASELINE="476 1632 2161 1625" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 1632 476 1649 2159 1643 2161 1625 2154 1597 474 1602 476 1632"/>
                        </Shape>
                        <String CONTENT="famine of 1880. The remainder turned to reindeer-breeding or emigrated to Wuteˊen and to"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l20" HPOS="474" VPOS="1651" WIDTH="377" HEIGHT="48" BASELINE="474 1680 851 1680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1680 474 1699 851 1699 851 1680 851 1651 474 1651 474 1680"/>
                        </Shape>
                        <String CONTENT="St. Lawrence Island."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l21" HPOS="396" VPOS="1697" WIDTH="1763" HEIGHT="54" BASELINE="398 1734 2159 1725" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1706 398 1734 398 1751 2156 1747 2159 1725 2152 1697 396 1703 396 1706"/>
                        </Shape>
                        <String CONTENT="Iˊmtun (Eskimo, Iˊmtuk), a few miles off, which had 12 houses with 65 inhabitants (Register, 9"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l22" HPOS="472" VPOS="1744" WIDTH="1689" HEIGHT="63" BASELINE="474 1783 2161 1773" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1783 474 1807 2159 1788 2161 1773 2154 1744 472 1753 474 1783"/>
                        </Shape>
                        <String CONTENT="houses, 43 inhabitants). Most of the people are Aiˊwan, but four families came from Wuteˊen."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l23" HPOS="396" VPOS="1803" WIDTH="1763" HEIGHT="54" BASELINE="398 1838 2159 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 1838 398 1857 2156 1855 2159 1831 2152 1803 396 1807 398 1838"/>
                        </Shape>
                        <String CONTENT="Iˊᵋen (Eskimo, Ṛɪˊṛak), in Plover Bay, which had only 2 houses with 9 inhabitants (Register, 4"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l24" HPOS="476" VPOS="1851" WIDTH="1683" HEIGHT="54" BASELINE="478 1887 2159 1879" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="478 1887 478 1905 2156 1898 2159 1879 2152 1851 476 1857 478 1887"/>
                        </Shape>
                        <String CONTENT="houses, 24 inhabitants); but two families moved to Euˊnmun a little while before our coming."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l25" HPOS="476" VPOS="1903" WIDTH="710" HEIGHT="49" BASELINE="478 1935 1186 1931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="478 1935 478 1952 1184 1952 1186 1931 1180 1903 476 1905 478 1935"/>
                        </Shape>
                        <String CONTENT="The people are Aiˊwan, and very poor."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l26" HPOS="398" VPOS="1946" WIDTH="1763" HEIGHT="58" BASELINE="400 1989 2161 1974" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 1989 400 2004 2161 1989 2161 1974 2154 1946 398 1959 400 1989"/>
                        </Shape>
                        <String CONTENT="Euˊnmun (Eskimo, Aˊvak), near Cape Chukotsky, which during our visit had 12 houses with 88"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l27" HPOS="474" VPOS="1998" WIDTH="1689" HEIGHT="52" BASELINE="476 2035 2163 2026" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 2035 476 2050 2161 2041 2163 2026 2156 1998 474 2004 476 2035"/>
                        </Shape>
                        <String CONTENT="inhabitants. Besides these, two families with 10 men came over from Iˊᵋen, where of late"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l28" HPOS="474" VPOS="2043" WIDTH="1685" HEIGHT="57" BASELINE="476 2082 2159 2069" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 2082 476 2100 2156 2087 2159 2069 2152 2043 474 2054 476 2082"/>
                        </Shape>
                        <String CONTENT="sealing has been very unsuccessful. There were then 98 inhabitants in Euˊnmun (Register, 16,"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l29" HPOS="472" VPOS="2093" WIDTH="1126" HEIGHT="52" BASELINE="474 2128 1598 2121" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 2128 474 2145 1596 2139 1598 2121 1591 2093 472 2097 474 2128"/>
                        </Shape>
                        <String CONTENT="houses, 101 inhabitants). The people of Euˊnmun are Aiˊwan."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l30" HPOS="391" VPOS="2145" WIDTH="1772" HEIGHT="61" BASELINE="394 2190 2163 2175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 2190 394 2206 2161 2193 2163 2175 2156 2145 391 2156 394 2190"/>
                        </Shape>
                        <String CONTENT="Čeˊčin (Eskimo, Teˊsik), on the west shore of the bay of the same name (Čečiˊkin quˊim, i. e., Čeˊčin"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l31" HPOS="476" VPOS="2197" WIDTH="1685" HEIGHT="54" BASELINE="478 2234 2161 2225" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="478 2234 478 2251 2159 2242 2161 2225 2154 2197 476 2203 478 2234"/>
                        </Shape>
                        <String CONTENT="Bay),³ which had 18 houses with 94 inhabitants (Register, 25 houses, 142 inhabitants). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l32" HPOS="469" VPOS="2245" WIDTH="865" HEIGHT="56" BASELINE="472 2284 1334 2275" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 2284 472 2301 1331 2297 1334 2275 1327 2245 469 2253 472 2284"/>
                        </Shape>
                        <String CONTENT="people are Chukchee and Aiˊwan, half and half."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l33" HPOS="398" VPOS="2301" WIDTH="1767" HEIGHT="58" BASELINE="400 2344 2165 2331" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 2344 400 2359 2165 2346 2165 2331 2159 2301 398 2312 400 2344"/>
                        </Shape>
                        <String CONTENT="Uñiˊin (Eskimo, Uñiˊsak), on Cape Chaplin (Indian Point) (Plate I, Figs. 1, 3), which had 61 houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l34" HPOS="474" VPOS="2342" WIDTH="1431" HEIGHT="65" BASELINE="476 2390 1905 2377" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="476 2390 476 2407 1905 2394 1905 2377 1899 2342 474 2362 476 2390"/>
                        </Shape>
                        <String CONTENT="with 442 inhabitants, all of them Aiˊwan (Register, 51 houses, 500 inhabitants).⁴"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-051_r4" HPOS="396" VPOS="2431" WIDTH="1778" HEIGHT="179" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="396 2431 2174 2431 2174 2610 396 2610"/>
                    </Shape>
                    <TextLine ID="mz_1-051_l35" HPOS="1026" VPOS="2435" WIDTH="502" HEIGHT="52" BASELINE="1028 2472 1528 2463" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1028 2472 1028 2487 1528 2478 1528 2463 1522 2435 1026 2442 1028 2472"/>
                        </Shape>
                        <String CONTENT="NORTH OF INDIAN POINT.⁵"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l36" HPOS="394" VPOS="2504" WIDTH="1769" HEIGHT="72" BASELINE="396 2552 1745 2537 2163 2541" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2552 396 2576 2161 2556 2163 2541 2159 2504 394 2517 396 2552"/>
                        </Shape>
                        <String CONTENT="Nepeˊkuten (Eskimo, Napaˊkutak), on the island called Ipeˊkut in Chukchee (Eskimo, Ciˊṛluk⁶),"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l37" HPOS="469" VPOS="2559" WIDTH="1521" HEIGHT="54" BASELINE="472 2598 1990 2587" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 2598 472 2613 1988 2602 1990 2587 1983 2559 469 2567 472 2598"/>
                        </Shape>
                        <String CONTENT="the last Aiˊwan village: 4 houses, 37 inhabitants (Register, 5 houses, 52 inhabitants)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-051_r5" HPOS="396" VPOS="2633" WIDTH="1778" HEIGHT="637" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="396 2633 2174 2633 2174 3270 396 3270"/>
                    </Shape>
                    <TextLine ID="mz_1-051_l38" HPOS="511" VPOS="2619" WIDTH="1652" HEIGHT="54" BASELINE="513 2656 2163 2645" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="513 2656 513 2673 2161 2662 2163 2645 2156 2619 511 2628 513 2656"/>
                        </Shape>
                        <String CONTENT="¹ The Chukchee use the expression “genuine house” for a tent-like dwelling with an inner sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l39" HPOS="391" VPOS="2662" WIDTH="1341" HEIGHT="55" BASELINE="394 2699 1732 2691" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 2699 394 2717 1730 2708 1732 2691 1726 2662 391 2669 394 2699"/>
                        </Shape>
                        <String CONTENT="made of heavy skins. For description see the chapter on “Habitations,” farther on."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l40" HPOS="504" VPOS="2708" WIDTH="208" HEIGHT="48" BASELINE="506 2736 712 2740" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="506 2736 504 2751 708 2756 712 2740 710 2712 506 2708 506 2736"/>
                        </Shape>
                        <String CONTENT="² See p. 20."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l41" HPOS="502" VPOS="2745" WIDTH="1663" HEIGHT="54" BASELINE="504 2782 2165 2771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="504 2782 504 2799 2163 2790 2165 2771 2159 2745 502 2753 504 2782"/>
                        </Shape>
                        <String CONTENT="³ Mr. Gondatti has confounded Providence Bay with Čeˊčin Bay, which led him to many misunderstand-"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l42" HPOS="394" VPOS="2788" WIDTH="1769" HEIGHT="56" BASELINE="396 2827 2163 2814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2827 396 2844 2161 2831 2163 2814 2156 2788 394 2799 396 2827"/>
                        </Shape>
                        <String CONTENT="ings, and induced Mr. Bogdanovitch to hint that Mr. Gondatti did not visit all the places that he mentioned"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l43" HPOS="396" VPOS="2829" WIDTH="1765" HEIGHT="59" BASELINE="398 2870 2161 2855" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 2870 398 2888 2159 2872 2161 2855 2154 2829 396 2842 398 2870"/>
                        </Shape>
                        <String CONTENT="(BOGDANOVITCH, pp. 66, 67). On the Russian maps Čeˊčin Bay is called Tkachen Bay or Admiral Butakoff’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l44" HPOS="396" VPOS="2870" WIDTH="1312" HEIGHT="57" BASELINE="398 2911 1708 2903" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 2911 398 2927 1706 2918 1708 2903 1702 2870 396 2883 398 2911"/>
                        </Shape>
                        <String CONTENT="Bay. American whalers call it Marquis Bay, of which Krause made “Marcus Bay.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l45" HPOS="506" VPOS="2911" WIDTH="1657" HEIGHT="65" BASELINE="508 2948 2163 2937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="508 2948 508 2976 2161 2959 2163 2937 2156 2911 506 2920 508 2948"/>
                        </Shape>
                        <String CONTENT="⁴ The decrease in population on this coast since Mr. Gondatti’s visit is due undoubtedly to the epidemic"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l46" HPOS="396" VPOS="2970" WIDTH="465" HEIGHT="43" BASELINE="396 2996 861 2996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2996 396 3013 861 3013 861 2996 861 2970 396 2970 396 2996"/>
                        </Shape>
                        <String CONTENT="of measles in the year 1899."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l47" HPOS="502" VPOS="2996" WIDTH="1659" HEIGHT="56" BASELINE="504 3033 2161 3022" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="504 3033 504 3052 2159 3041 2161 3022 2154 2996 502 3005 504 3033"/>
                        </Shape>
                        <String CONTENT="⁵ Northward from Indian Point my information is reliable only for the number of houses. The Register"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l48" HPOS="396" VPOS="3041" WIDTH="1765" HEIGHT="59" BASELINE="398 3082 2161 3067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 3082 398 3100 2159 3082 2161 3067 2154 3041 396 3054 398 3082"/>
                        </Shape>
                        <String CONTENT="gives the number of inhabitants in every case, but I fear the figures are often only approximate. The average"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l49" HPOS="398" VPOS="3082" WIDTH="1763" HEIGHT="59" BASELINE="400 3121 2161 3108" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 3121 400 3141 2159 3128 2161 3108 2154 3082 398 3093 400 3121"/>
                        </Shape>
                        <String CONTENT="of inmates in a house, according to my calculations, which agree with the data given by Mr. Gondatti, is about"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l50" HPOS="398" VPOS="3126" WIDTH="1765" HEIGHT="56" BASELINE="400 3165 2163 3152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 3165 400 3182 2161 3171 2163 3152 2156 3126 398 3137 400 3165"/>
                        </Shape>
                        <String CONTENT="6½ or 7. Lieut. Nordquist allows for the villages of the Arctic shore not more than 5 to a house, but this"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l51" HPOS="398" VPOS="3180" WIDTH="472" HEIGHT="45" BASELINE="398 3206 870 3206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 3206 398 3225 870 3225 870 3206 870 3180 398 3180 398 3206"/>
                        </Shape>
                        <String CONTENT="seems to me rather too little."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l52" HPOS="504" VPOS="3215" WIDTH="862" HEIGHT="51" BASELINE="506 3247 1366 3241" TAGREFS="TYPE_4">
