                    </TextLine>

                    <TextLine ID="mz_1-126_l34" HPOS="604" VPOS="2580" WIDTH="1768" HEIGHT="50" BASELINE="607 2611 2372 2615" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="607 2611 604 2626 2367 2630 2372 2615 2369 2585 607 2580 607 2611"/>
                        </Shape>
                        <String CONTENT="which, as I said before, are considered the most palatable of the common diet."/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l35" HPOS="604" VPOS="2639" WIDTH="1768" HEIGHT="52" BASELINE="607 2673 2372 2669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="607 2673 607 2691 2369 2686 2372 2669 2367 2641 604 2639 607 2673"/>
                        </Shape>
                        <String CONTENT="Moreover, the Maritime hunter is more daring, used to greater danger and to"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l36" HPOS="602" VPOS="2704" WIDTH="1772" HEIGHT="47" BASELINE="602 2734 2374 2734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="602 2734 602 2749 2372 2751 2374 2734 2374 2704 602 2704 602 2734"/>
                        </Shape>
                        <String CONTENT="every kind of adventure, than the lonely herdsman living on the dull plain,"/>
