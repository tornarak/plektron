                    <TextLine ID="mz_1-126_l37" HPOS="602" VPOS="2760" WIDTH="1772" HEIGHT="50" BASELINE="604 2790 2374 2795" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 2790 602 2805 2369 2810 2374 2795 2372 2764 604 2760 604 2790"/>
                        </Shape>
                        <String CONTENT="always encumbered with his herd. However, a herdsman is considered to be"/>
