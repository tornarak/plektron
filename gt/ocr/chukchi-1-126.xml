                        </Shape>
                        <String CONTENT="According to Krasheninnikoff, the same relations have existed from very"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l26" HPOS="621" VPOS="2110" WIDTH="1774" HEIGHT="57" BASELINE="623 2152 2395 2147" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 2152 623 2167 2393 2162 2395 2147 2390 2119 699 2110 697 2110 621 2121 623 2152"/>
                        </Shape>
                        <String CONTENT="ancient times farther to the south, between the Maritime and the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l27" HPOS="625" VPOS="2169" WIDTH="1770" HEIGHT="58" BASELINE="625 2210 2395 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="625 2210 625 2227 2395 2227 2395 2210 2395 2182 2343 2169 2341 2169 2338 2169 2308 2180 2211 2169 2208 2169 2206 2169 2178 2180 2072 2169 2070 2169 2068 2169 2031 2180 1972 2169 1970 2169 1899 2180 1868 2169 1866 2169 1864 2169 1862 2169 1816 2180 1762 2169 1760 2169 1695 2180 1622 2169 1619 2169 1617 2169 1587 2180 1544 2169 1541 2169 1539 2169 1433 2180 1321 2169 1318 2169 1253 2180 1193 2169 1191 2169 1141 2180 1104 2169 1102 2169 1100 2169 1097 2169 1067 2180 1004 2169 1002 2169 1000 2169 963 2180 905 2169 903 2169 900 2169 861 2180 625 2175 625 2210"/>
                        </Shape>
                        <String CONTENT="Koryak. On the Anadyr River, which the red and pink salmon from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l28" HPOS="625" VPOS="2234" WIDTH="1770" HEIGHT="56" BASELINE="625 2271 2395 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="625 2271 625 2290 2395 2290 2395 2271 2395 2240 625 2234 625 2271"/>
                        </Shape>
                        <String CONTENT="Pacific Ocean ascend in countless numbers, and which the wild reindeer twice"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l29" HPOS="621" VPOS="2290" WIDTH="1776" HEIGHT="59" BASELINE="623 2329 2397 2325" TAGREFS="TYPE_4">
                        <Shape>
