                        </Shape>
                        <String CONTENT="The relations between the Reindeer and the Maritime Chukchee are more"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l32" HPOS="619" VPOS="2465" WIDTH="1776" HEIGHT="63" BASELINE="621 2511 2395 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2511 621 2528 2393 2524 2395 2507 2390 2476 1563 2465 1561 2465 1463 2476 742 2468 740 2468 619 2478 621 2511"/>
                        </Shape>
                        <String CONTENT="complicated, since the breeders, though rich in reindeer, depend on the Mari-"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l33" HPOS="623" VPOS="2526" WIDTH="1770" HEIGHT="63" BASELINE="625 2569 2393 2565" TAGREFS="TYPE_4">
                        <Shape>
