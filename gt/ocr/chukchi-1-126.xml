                        <Shape>
                            <Polygon POINTS="623 1853 623 1868 2397 1868 2397 1853 2397 1822 623 1818 623 1853"/>
                        </Shape>
                        <String CONTENT="in no way hinders every river inhabitant — from the well-to-do trader down"/>
