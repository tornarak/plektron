                        <Shape>
                            <Polygon POINTS="602 2137 602 2152 2372 2147 2374 2132 2369 2104 678 2095 676 2095 600 2106 602 2137"/>
                        </Shape>
                        <String CONTENT="ancient times farther to the south, between the Maritime and the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l27" HPOS="604" VPOS="2154" WIDTH="1770" HEIGHT="58" BASELINE="604 2195 2374 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 2195 604 2212 2374 2212 2374 2195 2374 2167 2322 2154 2320 2154 2317 2154 2287 2165 2190 2154 2187 2154 2185 2154 2157 2165 2051 2154 2049 2154 2047 2154 2010 2165 1951 2154 1949 2154 1878 2165 1847 2154 1845 2154 1843 2154 1841 2154 1795 2165 1741 2154 1739 2154 1674 2165 1601 2154 1598 2154 1596 2154 1566 2165 1523 2154 1520 2154 1518 2154 1412 2165 1300 2154 1297 2154 1232 2165 1172 2154 1170 2154 1120 2165 1083 2154 1081 2154 1079 2154 1076 2154 1046 2165 983 2154 981 2154 979 2154 942 2165 884 2154 882 2154 879 2154 840 2165 604 2160 604 2195"/>
                        </Shape>
                        <String CONTENT="Koryak. On the Anadyr River, which the red and pink salmon from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l28" HPOS="604" VPOS="2219" WIDTH="1770" HEIGHT="56" BASELINE="604 2256 2374 2256" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 2256 604 2275 2374 2275 2374 2256 2374 2225 604 2219 604 2256"/>
                        </Shape>
                        <String CONTENT="Pacific Ocean ascend in countless numbers, and which the wild reindeer twice"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l29" HPOS="600" VPOS="2275" WIDTH="1776" HEIGHT="59" BASELINE="602 2314 2376 2310" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="602 2314 602 2334 2374 2329 2376 2310 2372 2275 739 2275 736 2275 600 2286 602 2314"/>
                        </Shape>
                        <String CONTENT="cross in large herds, the Russianized fishermen are much more independent of"/>
