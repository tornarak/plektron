                    </TextLine>

                    <TextLine ID="mz_1-126_l34" HPOS="625" VPOS="2595" WIDTH="1768" HEIGHT="50" BASELINE="628 2626 2393 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2626 625 2641 2388 2645 2393 2630 2390 2600 628 2595 628 2626"/>
                        </Shape>
                        <String CONTENT="which, as I said before, are considered the most palatable of the common diet."/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l35" HPOS="625" VPOS="2654" WIDTH="1768" HEIGHT="52" BASELINE="628 2688 2393 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2688 628 2706 2390 2701 2393 2684 2388 2656 625 2654 628 2688"/>
                        </Shape>
                        <String CONTENT="Moreover, the Maritime hunter is more daring, used to greater danger and to"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l36" HPOS="623" VPOS="2719" WIDTH="1772" HEIGHT="47" BASELINE="623 2749 2395 2749" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 2749 623 2764 2393 2766 2395 2749 2395 2719 623 2719 623 2749"/>
                        </Shape>
