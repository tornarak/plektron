                    <TextLine ID="mz_1-126_l31" HPOS="713" VPOS="2392" WIDTH="1663" HEIGHT="61" BASELINE="713 2435 2376 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2435 713 2453 2376 2453 2376 2435 2376 2405 2120 2405 2086 2392 2084 2392 2081 2392 2079 2392 2051 2403 2038 2392 2036 2392 2034 2392 2032 2392 1928 2403 1847 2392 1845 2392 1789 2403 1767 2392 1765 2392 1763 2392 1705 2403 1661 2392 1659 2392 1657 2392 1655 2392 1627 2403 1611 2392 1609 2392 1607 2392 1605 2392 1603 2392 1577 2403 1442 2392 1440 2392 1438 2392 1416 2403 1393 2392 1391 2392 1388 2392 1304 2403 1263 2392 1261 2392 1258 2392 1256 2392 1226 2403 713 2398 713 2435"/>
                        </Shape>
                        <String CONTENT="The relations between the Reindeer and the Maritime Chukchee are more"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l32" HPOS="598" VPOS="2450" WIDTH="1776" HEIGHT="63" BASELINE="600 2496 2374 2492" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="600 2496 600 2513 2372 2509 2374 2492 2369 2461 1542 2450 1540 2450 1442 2461 721 2453 719 2453 598 2463 600 2496"/>
                        </Shape>
                        <String CONTENT="complicated, since the breeders, though rich in reindeer, depend on the Mari-"/>
                    </TextLine>

                    <TextLine ID="mz_1-126_l33" HPOS="602" VPOS="2511" WIDTH="1770" HEIGHT="63" BASELINE="604 2554 2372 2550" TAGREFS="TYPE_4">
                        <Shape>
