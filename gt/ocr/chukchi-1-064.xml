                <TextBlock ID="text_1-064" HPOS="693" VPOS="597" WIDTH="1780" HEIGHT="2618"><TextLine ID="mz_1-064_l1" HPOS="1271" VPOS="597" WIDTH="620" HEIGHT="54" BASELINE="1274 634 1891 630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1878 599 1871 597 1282 599 1271 606 1274 634 1274 651 1889 647 1891 630 1884 604 1878 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l2" HPOS="704" VPOS="606" WIDTH="67" HEIGHT="47" BASELINE="708 643 771 638" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 643 708 653 771 651 771 638 765 606 704 608 708 643"/>
                        </Shape>
                        <String CONTENT="42"/>
                    </TextLine>
<TextLine ID="mz_1-064_l3" HPOS="697" VPOS="697" WIDTH="1772" HEIGHT="63" BASELINE="700 742 2469 738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2452 710 2430 710 2408 710 2387 708 2365 708 2343 708 2322 705 2317 705 2300 705 2278 705 2257 705 2244 703 1737 697 1735 697 697 710 700 742 700 760 2467 755 2469 738 2465 710 2452 710"/>
                        </Shape>
                        <String CONTENT="west, and therefore must be considered as coming from the Russian settlements."/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l4" HPOS="702" VPOS="755" WIDTH="1765" HEIGHT="63" BASELINE="704 803 2467 796" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 803 704 818 2465 814 2467 796 2462 768 2385 755 2382 755 2380 755 2343 768 2086 768 2068 755 2066 755 2064 755 2062 755 1865 768 1769 757 1767 757 1765 757 1731 768 1685 757 1683 757 1681 757 1629 768 1616 757 1614 757 1611 757 1609 757 1607 757 1568 768 1540 757 1538 757 1536 757 1274 770 702 766 704 803"/>
                        </Shape>
                        <String CONTENT="The Chukchee are very much afraid of this disease, since it occurs so often."/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l5" HPOS="702" VPOS="818" WIDTH="1767" HEIGHT="63" BASELINE="702 863 2469 863" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="702 863 702 876 2465 881 2469 863 2469 833 2426 818 2424 818 2421 818 2302 831 2187 818 2185 818 2183 818 2129 831 2088 818 2086 818 1995 818 1993 818 1990 818 1964 831 1928 818 1925 818 1923 818 1921 818 1889 829 1843 818 1841 818 1839 818 1837 818 1834 818 1815 831 1702 818 1700 818 1698 818 1644 831 1598 818 1596 818 1594 818 1592 818 1559 833 1432 833 1403 818 1401 818 1399 818 1250 833 1131 833 1111 818 1109 818 1107 818 1105 818 1102 818 1070 831 1033 818 1031 818 1029 818 957 831 890 818 888 818 886 818 884 818 866 829 836 818 834 818 832 818 830 818 786 831 702 827 702 863"/>
                        </Shape>
                        <String CONTENT="In 1896, while I was travelling on the Upper Anui, all the Chaun people,"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l6" HPOS="697" VPOS="887" WIDTH="1774" HEIGHT="50" BASELINE="700 922 2471 918" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 922 700 937 2469 933 2471 918 2467 887 697 887 700 922"/>
                        </Shape>
                        <String CONTENT="hearing of some cases of the disease on the Wolverine River, fled from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l7" HPOS="697" VPOS="939" WIDTH="1772" HEIGHT="63" BASELINE="700 983 2469 978" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 983 700 998 2465 1002 2469 978 2465 948 741 939 739 939 736 939 697 950 700 983"/>
                        </Shape>
                        <String CONTENT="whole western part of the Chaun tundra in order to avoid the “spirits seeking"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l8" HPOS="697" VPOS="1000" WIDTH="226" HEIGHT="69" BASELINE="697 1041 923 1041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 1041 697 1056 771 1056 784 1067 784 1069 786 1069 788 1069 791 1069 923 1054 923 1041 921 1000 697 1009 697 1041"/>
                        </Shape>
                        <String CONTENT="for prey.”"/>
                    </TextLine>
<TextLine ID="mz_1-064_l9" HPOS="801" VPOS="1056" WIDTH="1670" HEIGHT="61" BASELINE="804 1102 2471 1095" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="804 1102 804 1117 2469 1110 2471 1095 2467 1065 1358 1056 1356 1056 1354 1056 1313 1067 819 1058 817 1058 814 1058 812 1058 801 1065 804 1102"/>
                        </Shape>
                        <String CONTENT="Of nervous diseases, which are also dreaded and considered “subject to"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l10" HPOS="693" VPOS="1115" WIDTH="1778" HEIGHT="62" BASELINE="695 1162 2471 1156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="695 1162 695 1177 2469 1171 2471 1156 2469 1128 2441 1115 2439 1115 2437 1115 2434 1115 2413 1125 2181 1115 2179 1115 2177 1115 2174 1115 2159 1128 2036 1128 1988 1115 1986 1115 1984 1115 1865 1128 1813 1117 1811 1117 1462 1128 1397 1117 1395 1117 1284 1130 1222 1119 1219 1119 1012 1130 996 1119 994 1119 992 1119 726 1119 723 1119 721 1119 693 1130 695 1162"/>
                        </Shape>
                        <String CONTENT="shunning,” I may make mention of iteˊyun, akin to epilepsy. Sometimes it"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l11" HPOS="695" VPOS="1177" WIDTH="1776" HEIGHT="74" BASELINE="697 1223 2471 1216" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 1223 697 1251 847 1236 1310 1247 1313 1247 1315 1247 1317 1247 1332 1236 1819 1245 1821 1245 2146 1232 2181 1242 2183 1242 2185 1245 2382 1245 2382 1242 2385 1242 2408 1232 2424 1242 2426 1242 2428 1242 2430 1242 2432 1242 2471 1229 2471 1216 2467 1177 1824 1177 1821 1177 1744 1188 1657 1177 1655 1177 1579 1188 1185 1180 1183 1180 1087 1190 903 1180 901 1180 695 1193 697 1223"/>
                        </Shape>
                        <String CONTENT="occurs with the usual fits; sometimes with convulsions or with contraction of"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l12" HPOS="697" VPOS="1242" WIDTH="1772" HEIGHT="57" BASELINE="700 1281 2469 1275" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1281 700 1299 2467 1294 2469 1275 2462 1242 697 1251 700 1281"/>
                        </Shape>
                        <String CONTENT="the muscles, amounting almost to a temporary catalepsy. It lasts for several"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l13" HPOS="697" VPOS="1294" WIDTH="1770" HEIGHT="67" BASELINE="700 1342 2467 1333" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1342 700 1361 2465 1353 2467 1333 2462 1305 2109 1294 2107 1294 2019 1307 697 1307 700 1342"/>
                        </Shape>
                        <String CONTENT="hours, and the patient is unconscious during the whole time; then it gradually"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l14" HPOS="697" VPOS="1368" WIDTH="1770" HEIGHT="56" BASELINE="700 1405 2467 1398" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1405 700 1424 2465 1411 2467 1398 2460 1368 697 1372 700 1405"/>
                        </Shape>
                        <String CONTENT="passes away, but in a few days returns, perhaps in a more violent form."/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l15" HPOS="697" VPOS="1416" WIDTH="1770" HEIGHT="62" BASELINE="700 1463 2467 1457" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1463 700 1478 2465 1472 2467 1457 2462 1426 1904 1416 1902 1416 1899 1416 1871 1429 697 1429 700 1463"/>
                        </Shape>
                        <String CONTENT="Iteˊyun progresses rapidly, and invariably ends in the death of the sufferer."/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l16" HPOS="697" VPOS="1485" WIDTH="1384" HEIGHT="50" BASELINE="700 1515 2081 1519" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1515 697 1530 2077 1535 2081 1519 2079 1489 700 1485 700 1515"/>
                        </Shape>
                        <String CONTENT="Sometimes, however, it lasts for years before the fatal issue."/>
                    </TextLine>
<TextLine ID="mz_1-064_l17" HPOS="808" VPOS="1535" WIDTH="1663" HEIGHT="62" BASELINE="810 1580 2471 1576" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="810 1580 810 1597 2469 1593 2471 1576 2467 1548 1947 1535 1945 1535 1943 1535 1941 1535 1925 1548 1774 1548 1685 1535 1683 1535 1681 1535 1661 1545 1644 1535 1642 1535 1640 1535 1637 1535 1635 1535 1633 1535 1611 1548 1313 1537 1310 1537 1261 1548 1230 1537 1228 1537 1226 1537 1126 1548 1033 1537 1031 1537 1029 1537 1001 1548 923 1537 921 1537 918 1537 886 1548 832 1537 830 1537 827 1537 825 1537 808 1545 810 1580"/>
                        </Shape>
                        <String CONTENT="Another disease of a like character is iuˊmetun, a kind of violent nervous"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l18" HPOS="697" VPOS="1600" WIDTH="1772" HEIGHT="65" BASELINE="700 1641 2469 1634" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1641 700 1656 1271 1665 1274 1665 1412 1654 1490 1665 1492 1665 1559 1654 1631 1665 1633 1665 1635 1665 1668 1654 1746 1665 1748 1665 1912 1652 2187 1662 2190 1662 2192 1662 2218 1652 2231 1662 2233 1662 2235 1662 2237 1665 2359 1665 2359 1662 2361 1662 2363 1662 2380 1652 2447 1662 2450 1662 2452 1662 2454 1662 2469 1649 2469 1634 2465 1606 734 1600 732 1600 730 1600 697 1610 700 1641"/>
                        </Shape>
                        <String CONTENT="affection, which comes on at night like nightmare. During an attack the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l19" HPOS="697" VPOS="1667" WIDTH="1772" HEIGHT="52" BASELINE="700 1701 2469 1695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1701 700 1719 2467 1712 2469 1695 2465 1667 697 1667 700 1701"/>
                        </Shape>
                        <String CONTENT="breath appears shortened, the blood rushes to the face, and sometimes the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l20" HPOS="700" VPOS="1727" WIDTH="1771" HEIGHT="50" BASELINE="700 1760 2471 1760" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1760 700 1777 2471 1777 2471 1760 2469 1727 700 1727 700 1760"/>
                        </Shape>
                        <String CONTENT="sufferer chokes on the spot. The Chukchee attribute both diseases to special"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l21" HPOS="697" VPOS="1779" WIDTH="1774" HEIGHT="59" BASELINE="700 1820 2471 1816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1820 700 1838 2469 1833 2471 1816 2467 1786 749 1779 747 1779 697 1790 700 1820"/>
                        </Shape>
                        <String CONTENT="spirits, and do not like even to mention their names. A man suddenly afflicted"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l22" HPOS="697" VPOS="1836" WIDTH="1774" HEIGHT="58" BASELINE="700 1881 2471 1877" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 1881 700 1894 2471 1890 2471 1877 2469 1849 2419 1836 2417 1836 2415 1836 2413 1836 2389 1846 2250 1836 2248 1836 2164 1846 2140 1836 2138 1836 2135 1836 2068 1846 2045 1836 2042 1836 2040 1836 2038 1836 2036 1836 2019 1849 1824 1849 1772 1836 1769 1836 1767 1836 1720 1846 1668 1836 1666 1836 1551 1849 1025 1838 1022 1838 927 1849 892 1838 890 1838 888 1838 806 1849 741 1838 739 1838 736 1838 697 1851 700 1881"/>
                        </Shape>
                        <String CONTENT="with such an illness while travelling, may be almost sure that he will not be"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l23" HPOS="695" VPOS="1905" WIDTH="1716" HEIGHT="50" BASELINE="697 1939 2411 1935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 1939 697 1955 2408 1950 2411 1935 2404 1905 695 1907 697 1939"/>
                        </Shape>
                        <String CONTENT="allowed to enter any house, nor will he be given either fire or warm food."/>
                    </TextLine>
<TextLine ID="mz_1-064_l24" HPOS="806" VPOS="1955" WIDTH="1663" HEIGHT="62" BASELINE="808 2000 2469 1996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="808 2000 808 2015 2465 2017 2469 1996 2465 1968 2302 1968 2287 1955 2285 1955 2283 1955 2281 1955 2278 1955 2257 1965 2120 1955 2118 1955 2060 1965 1932 1955 1930 1955 1928 1955 1902 1965 1878 1955 1876 1955 1873 1955 1767 1965 1707 1955 1705 1955 1618 1965 1564 1957 1562 1957 1559 1957 1557 1957 1544 1968 1520 1957 1518 1957 1423 1957 1421 1957 1419 1957 1416 1957 1406 1968 1393 1957 1391 1957 1388 1957 1386 1957 1384 1957 1339 1970 1250 1970 1235 1957 1232 1957 1230 1957 1228 1957 1226 1957 1193 1968 1050 1957 1048 1957 806 1963 808 2000"/>
                        </Shape>
                        <String CONTENT="The well-known form of Arctic hysteria, which is so widespread among"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l25" HPOS="695" VPOS="2013" WIDTH="1772" HEIGHT="65" BASELINE="697 2061 2467 2054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2061 697 2078 2465 2072 2467 2054 2465 2026 2428 2013 2426 2013 2424 2013 2174 2024 2151 2013 2148 2013 2146 2013 2144 2013 2125 2024 2103 2013 2101 2013 2099 2013 2097 2013 2094 2013 2081 2024 2021 2013 2019 2013 1964 2024 1941 2013 1938 2013 1936 2013 1871 2028 1512 2028 1481 2015 1479 2015 1477 2015 1475 2015 1473 2015 1458 2028 1284 2028 721 2017 719 2017 717 2017 715 2017 695 2026 697 2061"/>
                        </Shape>
                        <String CONTENT="the Yukaghir and Lamut women, is very rare among the Chukchee, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l26" HPOS="697" VPOS="2076" WIDTH="1770" HEIGHT="61" BASELINE="700 2121 2467 2115" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 2121 700 2137 2465 2132 2467 2115 2462 2085 1304 2076 1302 2076 1300 2076 1297 2076 1280 2087 888 2078 886 2078 697 2089 700 2121"/>
                        </Shape>
                        <String CONTENT="among the Reindeer branch of the tribe. This disease develops chiefly in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l27" HPOS="700" VPOS="2150" WIDTH="1767" HEIGHT="47" BASELINE="700 2180 2467 2180" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 2180 700 2197 2465 2197 2467 2180 2465 2150 700 2150 700 2180"/>
                        </Shape>
                        <String CONTENT="form of an uncontrollable desire to repeat in a loud voice each word spoken"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l28" HPOS="697" VPOS="2206" WIDTH="1772" HEIGHT="50" BASELINE="700 2240 2469 2236" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 2240 700 2256 2467 2251 2469 2236 2465 2208 697 2206 700 2240"/>
                        </Shape>
                        <String CONTENT="by somebody else, and to imitate every sudden gesture or action. Even the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l29" HPOS="700" VPOS="2269" WIDTH="1769" HEIGHT="47" BASELINE="700 2299 2469 2299" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 2299 700 2316 2469 2316 2469 2299 2469 2269 700 2269 700 2299"/>
                        </Shape>
                        <String CONTENT="women among the Russianized natives, and Russians, are affected with it to"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l30" HPOS="697" VPOS="2329" WIDTH="1772" HEIGHT="48" BASELINE="697 2357 2469 2357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2357 697 2377 2469 2377 2469 2357 2469 2329 697 2329 697 2357"/>
                        </Shape>
                        <String CONTENT="a considerable extent, while those of the Chukchee are practically exempt"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l31" HPOS="695" VPOS="2383" WIDTH="191" HEIGHT="52" BASELINE="697 2414 886 2420" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2414 695 2429 882 2435 886 2420 886 2390 697 2383 697 2414"/>
                        </Shape>
                        <String CONTENT="from it."/>
                    </TextLine>
<TextLine ID="mz_1-064_l32" HPOS="801" VPOS="2444" WIDTH="1666" HEIGHT="58" BASELINE="804 2476 2467 2481" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="804 2476 801 2492 817 2502 819 2502 821 2502 823 2502 2465 2496 2467 2481 2465 2448 804 2444 804 2476"/>
                        </Shape>
                        <String CONTENT="Leprosy, so frequent among the Yakut, does not attack the Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l33" HPOS="697" VPOS="2498" WIDTH="1772" HEIGHT="59" BASELINE="700 2539 2469 2533" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="700 2539 700 2557 2467 2550 2469 2533 2465 2505 734 2498 732 2498 730 2498 697 2509 700 2539"/>
                        </Shape>
                        <String CONTENT="who have, however, various kinds of skin-diseases, perhaps on account of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l34" HPOS="695" VPOS="2552" WIDTH="1767" HEIGHT="74" BASELINE="697 2600 2462 2593" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2600 697 2615 1200 2626 1202 2626 1204 2626 1206 2626 1222 2615 1865 2621 1867 2621 1919 2611 1982 2621 1984 2621 2097 2611 2135 2621 2138 2621 2140 2624 2432 2624 2432 2621 2434 2621 2462 2608 2462 2593 2456 2559 1971 2563 1947 2552 1945 2552 1943 2552 1869 2565 1791 2554 1789 2554 1685 2565 1661 2554 1659 2554 1657 2554 1655 2554 1631 2565 1594 2554 1592 2554 1590 2554 1518 2565 1445 2554 1442 2554 1380 2565 1284 2554 1282 2554 1280 2554 1248 2567 1042 2557 1040 2557 981 2567 847 2557 845 2557 843 2557 821 2567 715 2557 713 2557 710 2557 708 2557 695 2565 697 2600"/>
                        </Shape>
                        <String CONTENT="filthy habits of living. They often call themselves “the not-washing people”"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l35" HPOS="697" VPOS="2626" WIDTH="438" HEIGHT="52" BASELINE="697 2658 1135 2658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2658 697 2678 1135 2678 1135 2658 1135 2626 697 2626 697 2658"/>
                        </Shape>
                        <String CONTENT="(ilhɪteuˊkä-reˊmkɪn)."/>
                    </TextLine>
<TextLine ID="mz_1-064_l36" HPOS="808" VPOS="2676" WIDTH="1663" HEIGHT="60" BASELINE="808 2719 2471 2719" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="808 2719 808 2736 2471 2736 2471 2719 2471 2686 2437 2676 2434 2676 2432 2676 2328 2686 2248 2676 2246 2676 2172 2686 2090 2676 2088 2676 2086 2676 2042 2686 2001 2676 1999 2676 1997 2676 1891 2686 1811 2676 1808 2676 1731 2686 1661 2676 1659 2676 1657 2676 1631 2689 1516 2689 1499 2676 1497 2676 1494 2676 1492 2676 1490 2676 1449 2686 1416 2676 1414 2676 1412 2676 1356 2686 1339 2676 1336 2676 1334 2676 1332 2676 1330 2676 1287 2686 808 2682 808 2719"/>
                        </Shape>
                        <String CONTENT="The most common of skin-diseases is scabies, which often afflicts whole"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l37" HPOS="695" VPOS="2734" WIDTH="1774" HEIGHT="61" BASELINE="697 2780 2469 2775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="697 2780 697 2795 2467 2790 2469 2775 2462 2743 2274 2745 2250 2734 2248 2734 2246 2734 2244 2734 2216 2745 2187 2734 2185 2734 2183 2734 2038 2745 1975 2734 1973 2734 1971 2734 1949 2745 1906 2734 1904 2734 1902 2734 1839 2745 1808 2734 1806 2734 1804 2734 1802 2734 1800 2734 1785 2747 1683 2747 1646 2734 1644 2734 1642 2734 1640 2734 1601 2745 1403 2736 1401 2736 1399 2736 1397 2736 1382 2749 1243 2749 1061 2736 1059 2736 1057 2736 1020 2747 934 2736 931 2736 869 2747 713 2736 710 2736 708 2736 706 2736 695 2743 697 2780"/>
                        </Shape>
                        <String CONTENT="families. The Chukchee pay little attention to it. Scabby people have told"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l38" HPOS="700" VPOS="2797" WIDTH="1771" HEIGHT="60" BASELINE="700 2838 2471 2838" TAGREFS="TYPE_4">
