                        <String CONTENT="(ilhɪteuˊkä-reˊmkɪn)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-064_r7" HPOS="721" VPOS="2693" WIDTH="1778" HEIGHT="241" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="721 2693 2499 2693 2499 2934 721 2934"/>
                    </Shape>
