                    </Shape>
                    <TextLine ID="mz_1-064_l17" HPOS="829" VPOS="1550" WIDTH="1663" HEIGHT="62" BASELINE="831 1595 2492 1591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="831 1595 831 1612 2490 1608 2492 1591 2488 1563 1968 1550 1966 1550 1964 1550 1962 1550 1946 1563 1795 1563 1706 1550 1704 1550 1702 1550 1682 1560 1665 1550 1663 1550 1661 1550 1658 1550 1656 1550 1654 1550 1632 1563 1334 1552 1331 1552 1282 1563 1251 1552 1249 1552 1247 1552 1147 1563 1054 1552 1052 1552 1050 1552 1022 1563 944 1552 942 1552 939 1552 907 1563 853 1552 851 1552 848 1552 846 1552 829 1560 831 1595"/>
                        </Shape>
                        <String CONTENT="Another disease of a like character is iuˊmetun, a kind of violent nervous"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l18" HPOS="718" VPOS="1615" WIDTH="1772" HEIGHT="65" BASELINE="721 1656 2490 1649" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 1656 721 1671 1292 1680 1295 1680 1433 1669 1511 1680 1513 1680 1580 1669 1652 1680 1654 1680 1656 1680 1689 1669 1767 1680 1769 1680 1933 1667 2208 1677 2211 1677 2213 1677 2239 1667 2252 1677 2254 1677 2256 1677 2258 1680 2380 1680 2380 1677 2382 1677 2384 1677 2401 1667 2468 1677 2471 1677 2473 1677 2475 1677 2490 1664 2490 1649 2486 1621 755 1615 753 1615 751 1615 718 1625 721 1656"/>
                        </Shape>
                        <String CONTENT="affection, which comes on at night like nightmare. During an attack the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l19" HPOS="718" VPOS="1682" WIDTH="1772" HEIGHT="52" BASELINE="721 1716 2490 1710" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 1716 721 1734 2488 1727 2490 1710 2486 1682 718 1682 721 1716"/>
                        </Shape>
                        <String CONTENT="breath appears shortened, the blood rushes to the face, and sometimes the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l20" HPOS="721" VPOS="1742" WIDTH="1771" HEIGHT="50" BASELINE="721 1775 2492 1775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 1775 721 1792 2492 1792 2492 1775 2490 1742 721 1742 721 1775"/>
                        </Shape>
                        <String CONTENT="sufferer chokes on the spot. The Chukchee attribute both diseases to special"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l21" HPOS="718" VPOS="1794" WIDTH="1774" HEIGHT="59" BASELINE="721 1835 2492 1831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 1835 721 1853 2490 1848 2492 1831 2488 1801 770 1794 768 1794 718 1805 721 1835"/>
                        </Shape>
                        <String CONTENT="spirits, and do not like even to mention their names. A man suddenly afflicted"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l22" HPOS="718" VPOS="1851" WIDTH="1774" HEIGHT="58" BASELINE="721 1896 2492 1892" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 1896 721 1909 2492 1905 2492 1892 2490 1864 2440 1851 2438 1851 2436 1851 2434 1851 2410 1861 2271 1851 2269 1851 2185 1861 2161 1851 2159 1851 2156 1851 2089 1861 2066 1851 2063 1851 2061 1851 2059 1851 2057 1851 2040 1864 1845 1864 1793 1851 1790 1851 1788 1851 1741 1861 1689 1851 1687 1851 1572 1864 1046 1853 1043 1853 948 1864 913 1853 911 1853 909 1853 827 1864 762 1853 760 1853 757 1853 718 1866 721 1896"/>
                        </Shape>
                        <String CONTENT="with such an illness while travelling, may be almost sure that he will not be"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l23" HPOS="716" VPOS="1920" WIDTH="1716" HEIGHT="50" BASELINE="718 1954 2432 1950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 1954 718 1970 2429 1965 2432 1950 2425 1920 716 1922 718 1954"/>
                        </Shape>
                        <String CONTENT="allowed to enter any house, nor will he be given either fire or warm food."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-064_r5" HPOS="721" VPOS="1978" WIDTH="1778" HEIGHT="477" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="721 1978 2499 1978 2499 2455 721 2455"/>
                    </Shape>
                    <TextLine ID="mz_1-064_l24" HPOS="827" VPOS="1970" WIDTH="1663" HEIGHT="62" BASELINE="829 2015 2490 2011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="829 2015 829 2030 2486 2032 2490 2011 2486 1983 2323 1983 2308 1970 2306 1970 2304 1970 2302 1970 2299 1970 2278 1980 2141 1970 2139 1970 2081 1980 1953 1970 1951 1970 1949 1970 1923 1980 1899 1970 1897 1970 1894 1970 1788 1980 1728 1970 1726 1970 1639 1980 1585 1972 1583 1972 1580 1972 1578 1972 1565 1983 1541 1972 1539 1972 1444 1972 1442 1972 1440 1972 1437 1972 1427 1983 1414 1972 1412 1972 1409 1972 1407 1972 1405 1972 1360 1985 1271 1985 1256 1972 1253 1972 1251 1972 1249 1972 1247 1972 1214 1983 1071 1972 1069 1972 827 1978 829 2015"/>
                        </Shape>
                        <String CONTENT="The well-known form of Arctic hysteria, which is so widespread among"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l25" HPOS="716" VPOS="2028" WIDTH="1772" HEIGHT="65" BASELINE="718 2076 2488 2069" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 2076 718 2093 2486 2087 2488 2069 2486 2041 2449 2028 2447 2028 2445 2028 2195 2039 2172 2028 2169 2028 2167 2028 2165 2028 2146 2039 2124 2028 2122 2028 2120 2028 2118 2028 2115 2028 2102 2039 2042 2028 2040 2028 1985 2039 1962 2028 1959 2028 1957 2028 1892 2043 1533 2043 1502 2030 1500 2030 1498 2030 1496 2030 1494 2030 1479 2043 1305 2043 742 2032 740 2032 738 2032 736 2032 716 2041 718 2076"/>
                        </Shape>
                        <String CONTENT="the Yukaghir and Lamut women, is very rare among the Chukchee, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l26" HPOS="718" VPOS="2091" WIDTH="1770" HEIGHT="61" BASELINE="721 2136 2488 2130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2136 721 2152 2486 2147 2488 2130 2483 2100 1325 2091 1323 2091 1321 2091 1318 2091 1301 2102 909 2093 907 2093 718 2104 721 2136"/>
                        </Shape>
                        <String CONTENT="among the Reindeer branch of the tribe. This disease develops chiefly in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l27" HPOS="721" VPOS="2165" WIDTH="1767" HEIGHT="47" BASELINE="721 2195 2488 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2195 721 2212 2486 2212 2488 2195 2486 2165 721 2165 721 2195"/>
                        </Shape>
                        <String CONTENT="form of an uncontrollable desire to repeat in a loud voice each word spoken"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l28" HPOS="718" VPOS="2221" WIDTH="1772" HEIGHT="50" BASELINE="721 2255 2490 2251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2255 721 2271 2488 2266 2490 2251 2486 2223 718 2221 721 2255"/>
                        </Shape>
                        <String CONTENT="by somebody else, and to imitate every sudden gesture or action. Even the"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l29" HPOS="721" VPOS="2284" WIDTH="1769" HEIGHT="47" BASELINE="721 2314 2490 2314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2314 721 2331 2490 2331 2490 2314 2490 2284 721 2284 721 2314"/>
                        </Shape>
                        <String CONTENT="women among the Russianized natives, and Russians, are affected with it to"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l30" HPOS="718" VPOS="2344" WIDTH="1772" HEIGHT="48" BASELINE="718 2372 2490 2372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 2372 718 2392 2490 2392 2490 2372 2490 2344 718 2344 718 2372"/>
                        </Shape>
                        <String CONTENT="a considerable extent, while those of the Chukchee are practically exempt"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l31" HPOS="716" VPOS="2398" WIDTH="191" HEIGHT="52" BASELINE="718 2429 907 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 2429 716 2444 903 2450 907 2435 907 2405 718 2398 718 2429"/>
                        </Shape>
                        <String CONTENT="from it."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-064_r6" HPOS="721" VPOS="2455" WIDTH="1778" HEIGHT="238" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="721 2455 2499 2455 2499 2693 721 2693"/>
                    </Shape>
                    <TextLine ID="mz_1-064_l32" HPOS="822" VPOS="2459" WIDTH="1666" HEIGHT="58" BASELINE="825 2491 2488 2496" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="825 2491 822 2507 838 2517 840 2517 842 2517 844 2517 2486 2511 2488 2496 2486 2463 825 2459 825 2491"/>
                        </Shape>
                        <String CONTENT="Leprosy, so frequent among the Yakut, does not attack the Chukchee,"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l33" HPOS="718" VPOS="2513" WIDTH="1772" HEIGHT="59" BASELINE="721 2554 2490 2548" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2554 721 2572 2488 2565 2490 2548 2486 2520 755 2513 753 2513 751 2513 718 2524 721 2554"/>
                        </Shape>
                        <String CONTENT="who have, however, various kinds of skin-diseases, perhaps on account of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l34" HPOS="716" VPOS="2567" WIDTH="1767" HEIGHT="74" BASELINE="718 2615 2483 2608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 2615 718 2630 1221 2641 1223 2641 1225 2641 1227 2641 1243 2630 1886 2636 1888 2636 1940 2626 2003 2636 2005 2636 2118 2626 2156 2636 2159 2636 2161 2639 2453 2639 2453 2636 2455 2636 2483 2623 2483 2608 2477 2574 1992 2578 1968 2567 1966 2567 1964 2567 1890 2580 1812 2569 1810 2569 1706 2580 1682 2569 1680 2569 1678 2569 1676 2569 1652 2580 1615 2569 1613 2569 1611 2569 1539 2580 1466 2569 1463 2569 1401 2580 1305 2569 1303 2569 1301 2569 1269 2582 1063 2572 1061 2572 1002 2582 868 2572 866 2572 864 2572 842 2582 736 2572 734 2572 731 2572 729 2572 716 2580 718 2615"/>
                        </Shape>
                        <String CONTENT="filthy habits of living. They often call themselves “the not-washing people”"/>
                    </TextLine>

                    <TextLine ID="mz_1-064_l35" HPOS="718" VPOS="2641" WIDTH="438" HEIGHT="52" BASELINE="718 2673 1156 2673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="718 2673 718 2693 1156 2693 1156 2673 1156 2641 718 2641 718 2673"/>
