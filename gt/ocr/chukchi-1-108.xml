                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l2" HPOS="624" VPOS="606" WIDTH="82" HEIGHT="58" BASELINE="626 638 706 643" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 638 624 649 663 664 665 664 667 664 669 664 704 653 706 643 706 610 626 606 626 638"/>
                        </Shape>
                        <String CONTENT="80"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-108_r2" HPOS="622" VPOS="704" WIDTH="1778" HEIGHT="1086" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="622 704 2400 704 2400 1790 622 1790"/>
                    </Shape>
                    <TextLine ID="mz_1-108_l3" HPOS="726" VPOS="705" WIDTH="1674" HEIGHT="57" BASELINE="728 747 2400 740" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2393 710 2372 710 2350 710 2328 708 2307 708 2285 708 2263 708 2261 705 739 705 736 705 734 705 732 705 732 708 726 712 728 747 728 762 2398 755 2400 740 2395 710 2393 710"/>
                        </Shape>
                        <String CONTENT="During the greater part of the summer the reindeer are much worried"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l4" HPOS="622" VPOS="762" WIDTH="1778" HEIGHT="63" BASELINE="624 807 2400 801" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 807 624 825 2398 818 2400 801 2395 773 1897 762 1895 762 1791 775 622 775 624 807"/>
                        </Shape>
                        <String CONTENT="by large and small mosquitoes, and still more by two kinds of reindeer-flies."/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l5" HPOS="626" VPOS="831" WIDTH="1774" HEIGHT="54" BASELINE="628 868 2400 861" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="628 868 628 885 2398 885 2400 861 2395 831 626 831 628 868"/>
                        </Shape>
                        <String CONTENT="The first one (Œstrus tarandi Nordenskiöld, Tabanus tarandinus Slunin)"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l6" HPOS="622" VPOS="894" WIDTH="1778" HEIGHT="50" BASELINE="624 928 2400 922" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 928 624 944 2398 937 2400 922 2395 894 622 894 624 928"/>
                        </Shape>
                        <String CONTENT="lays its eggs on the hair of the reindeer, fastening them to the ends of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l7" HPOS="622" VPOS="939" WIDTH="1778" HEIGHT="65" BASELINE="624 989 2400 980" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 989 624 1004 2398 996 2400 980 2398 952 2372 939 2369 939 2367 939 2255 950 2185 939 2183 939 2181 939 2179 939 2164 950 1616 941 1614 941 1494 954 1401 944 1399 944 1347 957 1215 957 1191 944 1189 944 1187 944 1096 954 622 954 624 989"/>
                        </Shape>
                        <String CONTENT="hair. After a little while a small maggot hatches from the egg, and immedi-"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l8" HPOS="622" VPOS="1000" WIDTH="1778" HEIGHT="63" BASELINE="624 1050 2400 1043" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1050 624 1063 2398 1056 2400 1043 2393 1009 1943 1011 1917 1000 1915 1000 1912 1000 1910 1000 1908 1000 1893 1011 1793 1002 1791 1002 1789 1002 1748 1013 1733 1002 1731 1002 1728 1002 1624 1002 1622 1002 1553 1013 1401 1002 1399 1002 1326 1013 1271 1002 1269 1002 1267 1002 1265 1002 1250 1013 1144 1004 1141 1004 1139 1004 1137 1004 1122 1017 990 1017 944 1004 942 1004 940 1004 938 1004 908 1015 834 1004 832 1004 743 1015 697 1004 695 1004 693 1004 622 1017 624 1050"/>
                        </Shape>
                        <String CONTENT="ately makes its way into the epidermis. While there it grows rapidly, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l9" HPOS="622" VPOS="1065" WIDTH="1773" HEIGHT="56" BASELINE="624 1106 2395 1102" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1106 624 1121 2393 1119 2395 1102 2391 1073 639 1065 637 1065 635 1065 633 1065 622 1071 624 1106"/>
                        </Shape>
                        <String CONTENT="finally reaches the size of a hazel-nut. When full grown, it protrudes from"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l10" HPOS="622" VPOS="1121" WIDTH="1773" HEIGHT="65" BASELINE="624 1169 2395 1162" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1169 624 1182 2391 1186 2395 1162 2391 1134 2229 1121 2226 1121 2224 1121 2222 1121 2207 1134 2068 1134 2016 1121 2014 1121 2012 1121 1977 1132 1917 1121 1915 1121 1778 1134 1375 1123 1373 1123 1371 1123 1369 1123 1354 1134 1278 1123 1276 1123 1196 1136 1152 1125 1150 1125 1148 1125 825 1136 749 1125 747 1125 745 1125 702 1136 643 1125 641 1125 639 1125 637 1125 622 1134 624 1169"/>
                        </Shape>
                        <String CONTENT="the skin, and is ready to fall down. The maggots evidently cause itching,"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l11" HPOS="622" VPOS="1182" WIDTH="1778" HEIGHT="60" BASELINE="624 1229 2400 1223" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1229 624 1242 2398 1236 2400 1223 2395 1193 1808 1182 1806 1182 1804 1182 1802 1182 1789 1193 650 1186 648 1186 646 1186 622 1195 624 1229"/>
                        </Shape>
                        <String CONTENT="since the reindeer scratches its back whenever possible. When the maggots"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l12" HPOS="622" VPOS="1251" WIDTH="1776" HEIGHT="54" BASELINE="624 1288 2398 1279" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1288 624 1305 2395 1296 2398 1279 2391 1251 622 1258 624 1288"/>
                        </Shape>
                        <String CONTENT="are very numerous, the reindeer loses its fat, and sometimes even dies. Later"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l13" HPOS="622" VPOS="1303" WIDTH="1778" HEIGHT="63" BASELINE="624 1351 2400 1342" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1351 624 1366 2398 1357 2400 1342 2395 1312 1529 1303 1527 1303 1525 1303 1503 1314 1126 1305 1124 1305 622 1316 624 1351"/>
                        </Shape>
                        <String CONTENT="in spring the backs of some hapless animals look as if they were stuffed over"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l14" HPOS="624" VPOS="1359" WIDTH="1774" HEIGHT="65" BASELINE="626 1409 2398 1400" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 1409 626 1424 2395 1418 2398 1400 2393 1372 2190 1359 2187 1359 2185 1359 2183 1359 2168 1372 2081 1372 2051 1359 2049 1359 2047 1359 2045 1359 2023 1370 2001 1359 1999 1359 1997 1359 1995 1359 1993 1359 1980 1370 1956 1359 1954 1359 1951 1359 1949 1359 1919 1372 1588 1361 1585 1361 1583 1361 1540 1372 1514 1361 1512 1361 1510 1361 1507 1361 1505 1361 1492 1374 1460 1364 1458 1364 1455 1364 1397 1374 1263 1364 1261 1364 1042 1377 895 1366 892 1366 732 1377 695 1366 693 1366 691 1366 624 1379 626 1409"/>
                        </Shape>
                        <String CONTENT="and over with maggots, and the skin is riddled with small holes. Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l15" HPOS="622" VPOS="1435" WIDTH="1776" HEIGHT="50" BASELINE="624 1468 2398 1463" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1468 624 1485 2395 1481 2398 1463 2393 1435 622 1435 624 1468"/>
                        </Shape>
                        <String CONTENT="herdsmen very dexterously pick out these maggots, when large enough, from"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l16" HPOS="622" VPOS="1483" WIDTH="1778" HEIGHT="58" BASELINE="624 1526 2400 1522" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1526 624 1541 2398 1537 2400 1522 2395 1494 1512 1483 1510 1483 1507 1483 1464 1494 648 1485 646 1485 643 1485 622 1494 624 1526"/>
                        </Shape>
                        <String CONTENT="the reindeer’s back, and eat them with great relish. The Lamut sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l17" HPOS="624" VPOS="1541" WIDTH="1776" HEIGHT="67" BASELINE="626 1587 2400 1582" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 1587 626 1608 2398 1600 2400 1582 2398 1554 2352 1541 2350 1541 2348 1541 2346 1541 2320 1552 2257 1541 2255 1541 2252 1541 2224 1552 2200 1541 2198 1541 2196 1541 2194 1541 2166 1552 1882 1541 1880 1541 1878 1541 1841 1552 1798 1541 1795 1541 1793 1541 1735 1552 1655 1541 1653 1541 1650 1541 1648 1541 1633 1554 1455 1554 1408 1543 1406 1543 1403 1543 1401 1543 1375 1554 1115 1543 1113 1543 1031 1554 968 1543 966 1543 782 1554 702 1543 700 1543 624 1556 626 1587"/>
                        </Shape>
                        <String CONTENT="gather a quantity and boil them in water. Although this fly, when laying its"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l18" HPOS="624" VPOS="1604" WIDTH="1774" HEIGHT="58" BASELINE="626 1647 2398 1643" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 1647 626 1662 2395 1658 2398 1643 2393 1615 1577 1604 1575 1604 1505 1615 782 1606 780 1606 624 1617 626 1647"/>
                        </Shape>
                        <String CONTENT="eggs, does not cause the reindeer any pain or discomfort, the animal is much"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l19" HPOS="622" VPOS="1662" WIDTH="1776" HEIGHT="61" BASELINE="624 1706 2398 1701" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1706 624 1723 2395 1719 2398 1701 2393 1673 1653 1662 1650 1662 1505 1673 797 1665 795 1665 622 1675 624 1706"/>
                        </Shape>
                        <String CONTENT="more afraid of it than of the stinging mosquito, and the herd will not remain"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l20" HPOS="624" VPOS="1738" WIDTH="803" HEIGHT="46" BASELINE="624 1766 1427 1766" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1766 624 1784 1427 1784 1427 1766 1427 1738 624 1738 624 1766"/>
                        </Shape>
                        <String CONTENT="quiet when the flies are numerous."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-108_r3" HPOS="622" VPOS="1790" WIDTH="1778" HEIGHT="707" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="622 1790 2400 1790 2400 2497 622 2497"/>
                    </Shape>
                    <TextLine ID="mz_1-108_l21" HPOS="730" VPOS="1784" WIDTH="1670" HEIGHT="60" BASELINE="732 1829 2400 1825" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="732 1829 732 1844 2398 1842 2400 1825 2395 1792 754 1784 752 1784 749 1784 730 1792 732 1829"/>
                        </Shape>
                        <String CONTENT="Another fly, of smaller size and darker color (Œdemagena tarandi Slunin),"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l22" HPOS="622" VPOS="1851" WIDTH="1776" HEIGHT="52" BASELINE="624 1890 2398 1883" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1890 624 1903 2395 1896 2398 1883 2391 1851 622 1853 624 1890"/>
                        </Shape>
                        <String CONTENT="lays its eggs in the reindeer’s nostrils. The larvæ go up to the throat, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l23" HPOS="622" VPOS="1905" WIDTH="1773" HEIGHT="63" BASELINE="624 1950 2395 1944" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 1950 624 1968 2393 1965 2395 1944 2391 1914 1226 1905 1224 1905 1222 1905 1219 1905 1206 1916 741 1907 739 1907 622 1918 624 1950"/>
                        </Shape>
                        <String CONTENT="penetrate the cartilage. The next year, when the maggots are full-grown,"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l24" HPOS="624" VPOS="1965" WIDTH="1774" HEIGHT="59" BASELINE="626 2007 2398 2000" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2007 626 2024 2395 2017 2398 2000 2393 1972 643 1965 641 1965 639 1965 637 1965 624 1972 626 2007"/>
                        </Shape>
                        <String CONTENT="they cause a constant cough, which continues until the last one drops to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l25" HPOS="626" VPOS="2020" WIDTH="1772" HEIGHT="69" BASELINE="628 2069 2398 2061" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="628 2069 628 2089 2395 2078 2398 2061 2393 2033 2326 2020 2324 2020 1951 2033 1906 2022 1904 2022 1902 2022 1899 2022 1873 2033 1442 2024 1440 2024 1438 2024 1436 2024 1421 2035 1369 2024 1367 2024 1198 2035 1070 2024 1068 2024 964 2037 769 2026 767 2026 626 2039 628 2069"/>
                        </Shape>
                        <String CONTENT="ground. The Yukaghir and the Tungus, following the example of Yakut"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l26" HPOS="624" VPOS="2082" WIDTH="1774" HEIGHT="63" BASELINE="626 2126 2398 2121" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2126 626 2145 2395 2141 2398 2121 2393 2093 1512 2082 1510 2082 1507 2082 1505 2082 1486 2093 710 2085 708 2085 624 2095 626 2126"/>
                        </Shape>
                        <String CONTENT="cattle-breeders, try to protect their reindeer from obnoxious insects by a smudge"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l27" HPOS="624" VPOS="2145" WIDTH="1771" HEIGHT="56" BASELINE="626 2186 2395 2182" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2186 626 2201 2393 2197 2395 2182 2391 2154 665 2145 663 2145 661 2145 624 2156 626 2186"/>
                        </Shape>
                        <String CONTENT="of smouldering dung, or of a fire covered with green leaves. But with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l28" HPOS="626" VPOS="2214" WIDTH="1774" HEIGHT="48" BASELINE="626 2245 2400 2245" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2245 626 2262 2400 2262 2400 2245 2400 2214 626 2214 626 2245"/>
                        </Shape>
                        <String CONTENT="wild and large herds of the Chukchee such fires are of little value, and not"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l29" HPOS="626" VPOS="2277" WIDTH="1772" HEIGHT="54" BASELINE="626 2305 2398 2305" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2305 626 2318 897 2331 899 2331 1001 2321 1157 2331 1159 2331 1161 2331 1196 2321 1436 2321 1451 2331 1453 2331 1455 2331 1458 2331 1583 2321 1614 2331 1616 2331 1618 2331 1722 2321 1815 2331 1817 2331 1906 2321 2398 2321 2398 2305 2398 2277 626 2277 626 2305"/>
                        </Shape>
                        <String CONTENT="without danger. Thus, some five years ago, Tungus herdsmen who were"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l30" HPOS="626" VPOS="2334" WIDTH="1772" HEIGHT="49" BASELINE="626 2364 2398 2364" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2364 626 2383 2398 2383 2398 2364 2395 2334 626 2334 626 2364"/>
                        </Shape>
                        <String CONTENT="tending the herd of a rich Chukchee on the Alaseya River tried to surround"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l31" HPOS="622" VPOS="2379" WIDTH="1773" HEIGHT="65" BASELINE="624 2427 2395 2420" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 2427 624 2444 2393 2437 2395 2420 2393 2392 2343 2379 2341 2379 2339 2379 2337 2379 2313 2390 2196 2379 2194 2379 2192 2379 2168 2390 2151 2379 2148 2379 2146 2379 2144 2379 2142 2379 2140 2379 2125 2390 2109 2379 2107 2379 2105 2379 2103 2379 2034 2390 1934 2379 1932 2379 1930 2379 1928 2379 1912 2392 1800 2394 1640 2394 1611 2381 1609 2381 1607 2381 1605 2381 1583 2392 1559 2381 1557 2381 1555 2381 1488 2392 1440 2381 1438 2381 1436 2381 1434 2381 1403 2392 1373 2381 1371 2381 1369 2381 1367 2381 1332 2392 1241 2381 1239 2381 1237 2381 1209 2394 1185 2383 1183 2383 1180 2383 918 2394 830 2383 827 2383 825 2383 795 2394 730 2383 728 2383 674 2394 637 2383 635 2383 633 2383 630 2383 628 2383 628 2385 622 2390 624 2427"/>
                        </Shape>
                        <String CONTENT="it with fires, and finally burned the whole pasture, and injured half of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l32" HPOS="624" VPOS="2455" WIDTH="195" HEIGHT="50" BASELINE="624 2485 819 2485" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 2485 624 2505 819 2505 819 2485 819 2455 624 2455 624 2485"/>
                        </Shape>
                        <String CONTENT="animals."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-108_r4" HPOS="622" VPOS="2497" WIDTH="1778" HEIGHT="731" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="622 2497 2400 2497 2400 3228 622 3228"/>
                    </Shape>
                    <TextLine ID="mz_1-108_l33" HPOS="730" VPOS="2500" WIDTH="1670" HEIGHT="63" BASELINE="732 2546 2400 2541" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="732 2546 732 2563 2398 2559 2400 2541 2395 2513 2283 2500 2281 2500 2278 2500 2244 2513 2081 2513 2062 2500 2060 2500 2058 2500 2055 2500 2053 2500 2051 2500 2036 2513 1845 2513 1806 2500 1804 2500 1802 2500 1728 2511 1711 2500 1709 2500 1707 2500 1568 2500 1566 2500 1564 2500 1538 2513 743 2502 741 2502 739 2502 736 2502 736 2505 730 2509 732 2546"/>
                        </Shape>
                        <String CONTENT="Hoof-swelling is the most common of reindeer-diseases, and occurs almost"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l34" HPOS="622" VPOS="2563" WIDTH="1773" HEIGHT="58" BASELINE="624 2606 2395 2602" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 2606 624 2621 2393 2617 2395 2602 2391 2574 1525 2563 1523 2563 1520 2563 1518 2563 1501 2574 901 2565 899 2565 622 2576 624 2606"/>
                        </Shape>
                        <String CONTENT="every year to a greater or less extent in most herds. It develops where the"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l35" HPOS="622" VPOS="2621" WIDTH="1773" HEIGHT="70" BASELINE="624 2665 2395 2660" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 2665 624 2680 1048 2680 1113 2691 1115 2691 1118 2691 1120 2691 1135 2680 1347 2680 1403 2691 1406 2691 1544 2678 1603 2689 1605 2689 1731 2678 1956 2678 1975 2689 1977 2689 1980 2689 1982 2689 2393 2676 2395 2660 2391 2632 1510 2621 1507 2621 1505 2621 1503 2621 1490 2632 680 2624 678 2624 622 2634 624 2665"/>
                        </Shape>
                        <String CONTENT="animals walk on dry and hot ground. Large abscesses break out between"/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l36" HPOS="624" VPOS="2682" WIDTH="1769" HEIGHT="61" BASELINE="624 2723 2393 2723" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="624 2723 624 2743 2393 2743 2393 2723 2393 2693 2372 2682 2369 2682 2268 2682 2265 2682 2263 2682 2261 2682 2248 2693 2229 2682 2226 2682 2224 2682 1731 2693 1692 2682 1689 2682 1687 2682 1685 2682 1683 2682 1666 2695 1542 2695 1516 2682 1514 2682 1512 2682 1460 2693 1436 2682 1434 2682 1432 2682 1347 2693 1304 2682 1302 2682 1300 2682 1219 2693 1174 2682 1172 2682 1170 2682 1167 2682 1165 2682 1150 2695 1057 2695 1027 2682 1025 2682 1022 2682 1020 2682 975 2693 899 2682 897 2682 838 2693 730 2682 728 2682 726 2682 700 2693 650 2682 648 2682 646 2682 624 2693 624 2723"/>
                        </Shape>
                        <String CONTENT="the joints of the foot. Sometimes the foot swells to the size of a child’s head."/>
                    </TextLine>

                    <TextLine ID="mz_1-108_l37" HPOS="626" VPOS="2749" WIDTH="1769" HEIGHT="54" BASELINE="626 2784 2395 2784" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="626 2784 626 2803 2395 2803 2395 2784 2395 2756 626 2749 626 2784"/>
                        </Shape>
                        <String CONTENT="The disease is catching, and is more dangerous in the mountains than on the"/>
                    </TextLine>

