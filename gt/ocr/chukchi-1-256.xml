                    <TextLine ID="mz_1-256_l1" HPOS="1213" VPOS="606" WIDTH="617" HEIGHT="54" BASELINE="1213 643 1830 638" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1817 615 1795 606 1230 606 1213 625 1213 643 1213 660 1828 656 1830 638 1826 617 1817 615"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l2" HPOS="626" VPOS="619" WIDTH="108" HEIGHT="41" BASELINE="626 647 734 647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="719 619 626 619 626 647 626 660 734 660 734 647 734 643 719 619"/>
                        </Shape>
                        <String CONTENT="200"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r2" HPOS="623" VPOS="704" WIDTH="1778" HEIGHT="967" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="623 704 2401 704 2401 1671 623 1671"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l3" HPOS="624" VPOS="705" WIDTH="1780" HEIGHT="61" BASELINE="626 753 2404 747" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 753 626 766 2404 760 2404 747 2400 716 1945 705 1943 705 1802 718 624 718 626 753"/>
                        </Shape>
                        <String CONTENT="Roasted rye-meal is sometimes used in the north as a substitute for tea, but"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l4" HPOS="622" VPOS="764" WIDTH="1780" HEIGHT="63" BASELINE="624 812 2402 805" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 812 624 827 2400 820 2402 805 2398 777 2177 764 2174 764 2172 764 2170 764 2151 777 1958 777 1928 764 1925 764 1923 764 1921 764 1895 775 1865 764 1863 764 1860 764 1787 777 1492 766 1490 766 1429 777 1391 766 1388 766 1386 766 1258 777 1219 766 1217 766 1215 766 1213 766 1187 779 986 768 983 768 981 768 979 768 962 779 934 768 931 768 929 768 723 779 691 768 689 768 687 768 685 768 682 768 669 779 637 768 635 768 633 768 630 768 628 768 628 770 622 775 624 812"/>
                        </Shape>
                        <String CONTENT="it is not much liked by the people. They drink tea in large quantities three"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l5" HPOS="624" VPOS="838" WIDTH="1776" HEIGHT="58" BASELINE="626 870 2400 866" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 870 626 885 1096 896 1098 896 1100 896 1102 896 1118 885 2398 885 2400 866 2393 838 624 840 626 870"/>
                        </Shape>
                        <String CONTENT="or four times daily, sometimes as much as forty large cups a day; but it"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l6" HPOS="624" VPOS="900" WIDTH="1778" HEIGHT="46" BASELINE="624 931 2402 931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 931 624 946 2402 946 2402 931 2402 900 624 900 624 931"/>
                        </Shape>
                        <String CONTENT="does not seem to affect their nervous system. This is due to the fact that"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l7" HPOS="624" VPOS="957" WIDTH="1778" HEIGHT="56" BASELINE="626 991 2402 987" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 991 626 1004 2237 1013 2239 1013 2402 1000 2402 987 2395 957 624 959 626 991"/>
                        </Shape>
                        <String CONTENT="compressed tea, being prepared of the refuse leaves mixed with sheep or ox"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l8" HPOS="624" VPOS="1004" WIDTH="1776" HEIGHT="63" BASELINE="626 1052 2400 1048" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1052 626 1067 2398 1063 2400 1048 2398 1017 2361 1004 2359 1004 2356 1004 2354 1004 2333 1015 2263 1004 2261 1004 2259 1004 2211 1017 1930 1017 1867 1004 1865 1004 1863 1004 1817 1015 1804 1004 1802 1004 1800 1004 1657 1004 1655 1004 1605 1015 1559 1004 1557 1004 1555 1004 1553 1004 1533 1015 1516 1004 1514 1004 1512 1004 1510 1004 1507 1004 1473 1017 1399 1006 1397 1006 1315 1017 1213 1006 1211 1006 1209 1006 1161 1017 1022 1006 1020 1006 1018 1006 988 1017 925 1006 923 1006 624 1015 626 1052"/>
                        </Shape>
                        <String CONTENT="blood, contains but small quantities of the alkaloid. Europeans travelling in"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l9" HPOS="624" VPOS="1069" WIDTH="1774" HEIGHT="56" BASELINE="626 1110 2398 1106" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1110 626 1125 2395 1123 2398 1106 2393 1078 643 1069 641 1069 639 1069 637 1069 624 1076 626 1110"/>
                        </Shape>
                        <String CONTENT="that country generally consume nearly as much tea without ill effects. Tea"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l10" HPOS="622" VPOS="1134" WIDTH="1776" HEIGHT="59" BASELINE="624 1167 2398 1171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1167 622 1184 635 1193 637 1193 639 1193 641 1193 2395 1188 2398 1171 2395 1138 624 1134 624 1167"/>
                        </Shape>
                        <String CONTENT="is considered by the people as a substitute for food. Its chief importance,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l11" HPOS="622" VPOS="1186" WIDTH="1778" HEIGHT="65" BASELINE="624 1232 2400 1227" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1232 624 1247 2395 1251 2400 1227 2395 1197 1724 1186 1722 1186 622 1197 624 1232"/>
                        </Shape>
                        <String CONTENT="however, is that it presents an excellent means of restoring heat after travelling"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l12" HPOS="622" VPOS="1245" WIDTH="1778" HEIGHT="60" BASELINE="624 1292 2400 1288" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1292 624 1305 2398 1301 2400 1288 2398 1258 2348 1245 2346 1245 2343 1245 2341 1245 2320 1255 2298 1245 2296 1245 2294 1245 2291 1245 2270 1255 2097 1245 2094 1245 2092 1245 2047 1255 2025 1245 2023 1245 2021 1245 2019 1245 1975 1255 1951 1245 1949 1245 1947 1245 1878 1255 1852 1245 1850 1245 1847 1245 1791 1255 1731 1245 1728 1245 1726 1245 1724 1245 1709 1258 1611 1258 1579 1245 1577 1245 1575 1245 1572 1245 1549 1255 1516 1245 1514 1245 1512 1245 1510 1245 1507 1245 1492 1258 1442 1247 1440 1247 1380 1258 1022 1247 1020 1247 877 1258 762 1247 760 1247 622 1260 624 1292"/>
                        </Shape>
                        <String CONTENT="or walking out of doors in the cold. It is considered to be healthy; and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l13" HPOS="622" VPOS="1309" WIDTH="1776" HEIGHT="63" BASELINE="624 1351 2398 1346" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1351 624 1366 2393 1372 2398 1346 2393 1318 691 1309 689 1309 622 1320 624 1351"/>
                        </Shape>
                        <String CONTENT="natives believe that in the summer-time, when camping on the damp tundra,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l14" HPOS="626" VPOS="1368" WIDTH="1772" HEIGHT="65" BASELINE="626 1411 2398 1411" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1411 626 1433 2398 1433 2398 1411 2398 1381 1683 1368 1681 1368 1603 1379 1540 1368 1538 1368 1488 1379 1436 1368 1434 1368 1373 1379 1252 1368 1250 1368 1248 1368 1245 1368 1228 1381 949 1381 832 1368 830 1368 771 1379 661 1368 659 1368 656 1368 626 1379 626 1411"/>
                        </Shape>
                        <String CONTENT="plenty of hot strong tea keeps off cold and fever. For all these reasons,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l15" HPOS="624" VPOS="1435" WIDTH="1774" HEIGHT="52" BASELINE="626 1468 2398 1472" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1468 624 1481 2393 1487 2398 1472 2395 1439 626 1435 626 1468"/>
                        </Shape>
                        <String CONTENT="scarcity of tea is considered almost everywhere as nothing short of a calamity,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l16" HPOS="626" VPOS="1496" WIDTH="1774" HEIGHT="56" BASELINE="628 1526 2400 1530" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1526 626 1539 674 1552 676 1552 678 1552 2398 1543 2400 1530 2398 1500 628 1496 628 1526"/>
                        </Shape>
                        <String CONTENT="which, however, befalls the people almost every year for several weeks, when-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l17" HPOS="622" VPOS="1552" WIDTH="1776" HEIGHT="63" BASELINE="624 1582 2398 1589" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1582 622 1600 637 1610 639 1610 641 1610 643 1610 734 1600 767 1610 769 1610 771 1610 840 1600 864 1610 866 1610 869 1610 1014 1600 1172 1610 1174 1610 1176 1610 1206 1600 1267 1613 1269 1615 1408 1615 1408 1613 1410 1613 1412 1613 1425 1602 1471 1613 1473 1613 1475 1613 1642 1602 1826 1613 1828 1613 1945 1604 1967 1615 1969 1615 1971 1615 1973 1615 2019 1604 2330 1604 2354 1615 2356 1615 2359 1615 2361 1615 2395 1604 2398 1589 2395 1558 624 1552 624 1582"/>
                        </Shape>
                        <String CONTENT="ever the arrival of the merchant caravans is retarded by blizzards or by"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l18" HPOS="626" VPOS="1606" WIDTH="338" HEIGHT="59" BASELINE="626 1647 964 1647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1647 626 1665 964 1665 964 1647 964 1619 715 1606 713 1606 626 1617 626 1647"/>
                        </Shape>
                        <String CONTENT="swollen rivers."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r3" HPOS="623" VPOS="1671" WIDTH="1778" HEIGHT="122" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="623 1671 2401 1671 2401 1793 623 1793"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l19" HPOS="736" VPOS="1665" WIDTH="1666" HEIGHT="62" BASELINE="736 1708 2402 1708" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1708 736 1727 2402 1727 2402 1708 2402 1678 2326 1665 2324 1665 2209 1675 1834 1665 1832 1665 1754 1675 1676 1665 1674 1665 1510 1675 1434 1665 1432 1665 1289 1675 1254 1665 1252 1665 1250 1665 1248 1665 1245 1665 1230 1678 1111 1678 1079 1665 1076 1665 1074 1665 1072 1665 1025 1675 871 1665 869 1665 808 1675 760 1665 758 1665 756 1665 754 1665 752 1665 736 1673 736 1708"/>
                        </Shape>
                        <String CONTENT="As substitutes for tea, leaves of the sweet-brier, of Epilobium angustifolium"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l20" HPOS="622" VPOS="1725" WIDTH="1776" HEIGHT="61" BASELINE="624 1768 2398 1764" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1768 624 1786 2395 1781 2398 1764 2393 1736 1510 1725 1507 1725 1505 1725 1481 1736 695 1727 693 1727 622 1738 624 1768"/>
                        </Shape>
                        <String CONTENT="and of various berries, such as Rubus chamæmorus and Rubus arcticus, are used."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r4" HPOS="623" VPOS="1793" WIDTH="1778" HEIGHT="891" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="623 1793 2401 1793 2401 2684 623 2684"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l21" HPOS="734" VPOS="1786" WIDTH="1664" HEIGHT="60" BASELINE="736 1827 2398 1833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1827 734 1838 2393 1846 2398 1833 2395 1799 1873 1799 1845 1786 1843 1786 1841 1786 736 1790 736 1827"/>
                        </Shape>
                        <String CONTENT="As stated before, the principal meal of the Chukchee is in the evening,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l22" HPOS="622" VPOS="1844" WIDTH="1778" HEIGHT="61" BASELINE="624 1890 2400 1885" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1890 624 1905 2398 1901 2400 1885 2395 1855 1518 1844 1516 1844 1514 1844 1512 1844 1499 1855 663 1846 661 1846 659 1846 622 1857 624 1890"/>
                        </Shape>
                        <String CONTENT="after all the people have entered the sleeping-room. At this time the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l23" HPOS="624" VPOS="1907" WIDTH="1776" HEIGHT="67" BASELINE="626 1948 2400 1944" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1948 626 1963 1308 1974 1310 1974 1388 1963 1484 1974 1486 1974 1488 1974 1514 1961 1750 1972 1752 1972 1828 1961 1850 1972 1852 1972 1854 1972 2062 1961 2341 1972 2343 1972 2398 1959 2400 1944 2395 1916 650 1907 648 1907 646 1907 624 1916 626 1948"/>
                        </Shape>
                        <String CONTENT="chee eat much and ravenously. They swallow large quantities of meat, gnaw"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l24" HPOS="624" VPOS="1972" WIDTH="1776" HEIGHT="61" BASELINE="626 2002 2400 2007" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2002 624 2017 1609 2033 1611 2033 2398 2022 2400 2007 2398 1976 626 1972 626 2002"/>
                        </Shape>
                        <String CONTENT="the bones, and try to outdo each other in quickness. Nevertheless the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l25" HPOS="624" VPOS="2037" WIDTH="1776" HEIGHT="48" BASELINE="624 2065 2400 2065" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2065 624 2085 2400 2085 2400 2065 2400 2037 624 2037 624 2065"/>
                        </Shape>
                        <String CONTENT="chee do not seem to be greater eaters than their neighbors; and my cossacks"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l26" HPOS="622" VPOS="2093" WIDTH="1778" HEIGHT="61" BASELINE="624 2124 2400 2128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2124 622 2137 970 2152 973 2154 1154 2154 1154 2152 1157 2152 1159 2152 1174 2141 1449 2152 1451 2152 1453 2152 1475 2141 1516 2154 1518 2154 1520 2154 1523 2154 1562 2143 1592 2154 1594 2154 1596 2154 1702 2143 1951 2154 1954 2154 2006 2143 2118 2154 2120 2154 2398 2141 2400 2128 2398 2093 624 2093 624 2124"/>
                        </Shape>
                        <String CONTENT="and other companions, after a long day spent in travelling through the cold"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l27" HPOS="624" VPOS="2143" WIDTH="1778" HEIGHT="58" BASELINE="626 2182 2402 2186" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2182 624 2197 2398 2201 2402 2186 2400 2158 1518 2158 1375 2145 1373 2145 691 2154 626 2143 626 2182"/>
                        </Shape>
                        <String CONTENT="weather, ate just as swiftly and ravenously as the natives. There are some"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l28" HPOS="622" VPOS="2201" WIDTH="1776" HEIGHT="68" BASELINE="624 2243 2398 2249" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2243 622 2256 646 2269 648 2269 650 2269 2395 2262 2398 2249 2398 2217 2380 2206 2378 2206 2376 2206 2374 2206 2021 2217 1982 2206 1980 2206 1977 2206 1975 2206 1973 2206 1956 2217 1928 2206 1925 2206 1923 2206 1871 2217 1804 2204 1802 2204 1800 2204 1765 2214 1670 2204 1520 2204 1518 2204 1516 2204 1514 2204 1501 2214 1451 2204 1449 2204 1447 2204 1419 2214 916 2214 888 2201 886 2201 884 2201 882 2201 836 2212 782 2201 780 2201 778 2201 749 2212 624 2212 624 2243"/>
                        </Shape>
                        <String CONTENT="exceptionally great eaters among the Chukchee, although I myself met such"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l29" HPOS="622" VPOS="2271" WIDTH="1778" HEIGHT="60" BASELINE="624 2303 2400 2308" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2303 622 2316 784 2329 786 2329 1419 2321 1523 2331 1525 2331 2398 2321 2400 2308 2398 2275 624 2271 624 2303"/>
                        </Shape>
                        <String CONTENT="a one only among the Russianized Yukaghir of the Kolyma. I was told about"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l30" HPOS="622" VPOS="2331" WIDTH="1778" HEIGHT="59" BASELINE="624 2364 2400 2368" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2364 622 2375 646 2388 648 2388 650 2388 1384 2379 1514 2390 1516 2390 2398 2379 2400 2368 2398 2336 624 2331 624 2364"/>
                        </Shape>
                        <String CONTENT="one Reindeer Chukchee of the Telqäˊp tundra who was able to consume at"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l31" HPOS="624" VPOS="2390" WIDTH="1776" HEIGHT="50" BASELINE="626 2420 2400 2424" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2420 624 2435 2395 2440 2400 2424 2398 2394 626 2390 626 2420"/>
                        </Shape>
                        <String CONTENT="one eating a two-year-old reindeer-buck. I was told that before a meal the"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l32" HPOS="624" VPOS="2440" WIDTH="1774" HEIGHT="60" BASELINE="626 2481 2398 2485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2481 624 2496 2393 2500 2398 2485 2395 2453 2131 2442 2129 2442 2003 2453 1977 2442 1975 2442 1973 2442 1897 2453 1873 2442 1871 2442 1869 2442 1750 2453 1728 2442 1726 2442 1724 2442 1722 2442 1694 2453 1611 2442 1609 2442 1533 2453 1514 2440 1512 2440 1510 2440 1507 2440 1421 2450 1313 2440 1310 2440 1308 2440 1280 2450 1250 2440 1248 2440 1245 2440 1243 2440 1215 2450 1163 2440 1161 2440 1159 2440 1126 2450 1102 2440 1100 2440 1098 2440 1096 2440 1066 2453 905 2453 886 2440 884 2440 882 2440 879 2440 626 2448 626 2481"/>
                        </Shape>
                        <String CONTENT="skin on his stomach lay in large folds, which he gathered up with his belt."/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l33" HPOS="626" VPOS="2507" WIDTH="1774" HEIGHT="60" BASELINE="628 2539 2400 2546" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2539 626 2552 687 2565 689 2565 1152 2557 1241 2567 1243 2567 2398 2559 2400 2546 2398 2515 628 2507 628 2539"/>
                        </Shape>
                        <String CONTENT="He could stay without food for two or three days. Then, after a sumptuous"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l34" HPOS="624" VPOS="2563" WIDTH="1778" HEIGHT="56" BASELINE="626 2600 2402 2604" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2600 624 2615 2398 2619 2402 2604 2398 2563 626 2567 626 2600"/>
                        </Shape>
                        <String CONTENT="meal, his stomach would be enormously distended, so that the skin would"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l35" HPOS="624" VPOS="2626" WIDTH="1711" HEIGHT="63" BASELINE="626 2658 2335 2667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2658 624 2673 1055 2689 1057 2689 2333 2682 2335 2667 2333 2637 626 2626 626 2658"/>
                        </Shape>
                        <String CONTENT="look quite smooth, and he would spend a whole day motionless digesting."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r5" HPOS="623" VPOS="2684" WIDTH="1778" HEIGHT="238" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="623 2684 2401 2684 2401 2922 623 2922"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l36" HPOS="734" VPOS="2686" WIDTH="1666" HEIGHT="55" BASELINE="736 2719 2400 2725" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 2719 734 2734 2395 2741 2400 2725 2398 2695 736 2686 736 2719"/>
                        </Shape>
                        <String CONTENT="The Reindeer Chukchee, as well as the Lamut and the Koryak in Kam-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l37" HPOS="622" VPOS="2749" WIDTH="1778" HEIGHT="52" BASELINE="624 2780 2400 2786" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2780 622 2795 2395 2801 2400 2786 2398 2756 624 2749 624 2780"/>
                        </Shape>
                        <String CONTENT="chatka, occasionally use as food a kind of white clay, which is called nuˊte-"/>
