                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l2" HPOS="647" VPOS="634" WIDTH="108" HEIGHT="41" BASELINE="647 662 755 662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="740 634 647 634 647 662 647 675 755 675 755 662 755 658 740 634"/>
                        </Shape>
                        <String CONTENT="200"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r2" HPOS="644" VPOS="719" WIDTH="1778" HEIGHT="967" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="644 719 2422 719 2422 1686 644 1686"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l3" HPOS="645" VPOS="720" WIDTH="1780" HEIGHT="61" BASELINE="647 768 2425 762" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 768 647 781 2425 775 2425 762 2421 731 1966 720 1964 720 1823 733 645 733 647 768"/>
                        </Shape>
                        <String CONTENT="Roasted rye-meal is sometimes used in the north as a substitute for tea, but"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l4" HPOS="643" VPOS="779" WIDTH="1780" HEIGHT="63" BASELINE="645 827 2423 820" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 827 645 842 2421 835 2423 820 2419 792 2198 779 2195 779 2193 779 2191 779 2172 792 1979 792 1949 779 1946 779 1944 779 1942 779 1916 790 1886 779 1884 779 1881 779 1808 792 1513 781 1511 781 1450 792 1412 781 1409 781 1407 781 1279 792 1240 781 1238 781 1236 781 1234 781 1208 794 1007 783 1004 783 1002 783 1000 783 983 794 955 783 952 783 950 783 744 794 712 783 710 783 708 783 706 783 703 783 690 794 658 783 656 783 654 783 651 783 649 783 649 785 643 790 645 827"/>
                        </Shape>
                        <String CONTENT="it is not much liked by the people. They drink tea in large quantities three"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l5" HPOS="645" VPOS="853" WIDTH="1776" HEIGHT="58" BASELINE="647 885 2421 881" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 885 647 900 1117 911 1119 911 1121 911 1123 911 1139 900 2419 900 2421 881 2414 853 645 855 647 885"/>
                        </Shape>
                        <String CONTENT="or four times daily, sometimes as much as forty large cups a day; but it"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l6" HPOS="645" VPOS="915" WIDTH="1778" HEIGHT="46" BASELINE="645 946 2423 946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 946 645 961 2423 961 2423 946 2423 915 645 915 645 946"/>
                        </Shape>
                        <String CONTENT="does not seem to affect their nervous system. This is due to the fact that"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l7" HPOS="645" VPOS="972" WIDTH="1778" HEIGHT="56" BASELINE="647 1006 2423 1002" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1006 647 1019 2258 1028 2260 1028 2423 1015 2423 1002 2416 972 645 974 647 1006"/>
                        </Shape>
                        <String CONTENT="compressed tea, being prepared of the refuse leaves mixed with sheep or ox"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l8" HPOS="645" VPOS="1019" WIDTH="1776" HEIGHT="63" BASELINE="647 1067 2421 1063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1067 647 1082 2419 1078 2421 1063 2419 1032 2382 1019 2380 1019 2377 1019 2375 1019 2354 1030 2284 1019 2282 1019 2280 1019 2232 1032 1951 1032 1888 1019 1886 1019 1884 1019 1838 1030 1825 1019 1823 1019 1821 1019 1678 1019 1676 1019 1626 1030 1580 1019 1578 1019 1576 1019 1574 1019 1554 1030 1537 1019 1535 1019 1533 1019 1531 1019 1528 1019 1494 1032 1420 1021 1418 1021 1336 1032 1234 1021 1232 1021 1230 1021 1182 1032 1043 1021 1041 1021 1039 1021 1009 1032 946 1021 944 1021 645 1030 647 1067"/>
                        </Shape>
                        <String CONTENT="blood, contains but small quantities of the alkaloid. Europeans travelling in"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l9" HPOS="645" VPOS="1084" WIDTH="1774" HEIGHT="56" BASELINE="647 1125 2419 1121" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1125 647 1140 2416 1138 2419 1121 2414 1093 664 1084 662 1084 660 1084 658 1084 645 1091 647 1125"/>
                        </Shape>
                        <String CONTENT="that country generally consume nearly as much tea without ill effects. Tea"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l10" HPOS="643" VPOS="1149" WIDTH="1776" HEIGHT="59" BASELINE="645 1182 2419 1186" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1182 643 1199 656 1208 658 1208 660 1208 662 1208 2416 1203 2419 1186 2416 1153 645 1149 645 1182"/>
                        </Shape>
                        <String CONTENT="is considered by the people as a substitute for food. Its chief importance,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l11" HPOS="643" VPOS="1201" WIDTH="1778" HEIGHT="65" BASELINE="645 1247 2421 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1247 645 1262 2416 1266 2421 1242 2416 1212 1745 1201 1743 1201 643 1212 645 1247"/>
                        </Shape>
                        <String CONTENT="however, is that it presents an excellent means of restoring heat after travelling"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l12" HPOS="643" VPOS="1260" WIDTH="1778" HEIGHT="60" BASELINE="645 1307 2421 1303" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1307 645 1320 2419 1316 2421 1303 2419 1273 2369 1260 2367 1260 2364 1260 2362 1260 2341 1270 2319 1260 2317 1260 2315 1260 2312 1260 2291 1270 2118 1260 2115 1260 2113 1260 2068 1270 2046 1260 2044 1260 2042 1260 2040 1260 1996 1270 1972 1260 1970 1260 1968 1260 1899 1270 1873 1260 1871 1260 1868 1260 1812 1270 1752 1260 1749 1260 1747 1260 1745 1260 1730 1273 1632 1273 1600 1260 1598 1260 1596 1260 1593 1260 1570 1270 1537 1260 1535 1260 1533 1260 1531 1260 1528 1260 1513 1273 1463 1262 1461 1262 1401 1273 1043 1262 1041 1262 898 1273 783 1262 781 1262 643 1275 645 1307"/>
                        </Shape>
                        <String CONTENT="or walking out of doors in the cold. It is considered to be healthy; and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l13" HPOS="643" VPOS="1324" WIDTH="1776" HEIGHT="63" BASELINE="645 1366 2419 1361" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1366 645 1381 2414 1387 2419 1361 2414 1333 712 1324 710 1324 643 1335 645 1366"/>
                        </Shape>
                        <String CONTENT="natives believe that in the summer-time, when camping on the damp tundra,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l14" HPOS="647" VPOS="1383" WIDTH="1772" HEIGHT="65" BASELINE="647 1426 2419 1426" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1426 647 1448 2419 1448 2419 1426 2419 1396 1704 1383 1702 1383 1624 1394 1561 1383 1559 1383 1509 1394 1457 1383 1455 1383 1394 1394 1273 1383 1271 1383 1269 1383 1266 1383 1249 1396 970 1396 853 1383 851 1383 792 1394 682 1383 680 1383 677 1383 647 1394 647 1426"/>
                        </Shape>
                        <String CONTENT="plenty of hot strong tea keeps off cold and fever. For all these reasons,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l15" HPOS="645" VPOS="1450" WIDTH="1774" HEIGHT="52" BASELINE="647 1483 2419 1487" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1483 645 1496 2414 1502 2419 1487 2416 1454 647 1450 647 1483"/>
                        </Shape>
                        <String CONTENT="scarcity of tea is considered almost everywhere as nothing short of a calamity,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l16" HPOS="647" VPOS="1511" WIDTH="1774" HEIGHT="56" BASELINE="649 1541 2421 1545" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1541 647 1554 695 1567 697 1567 699 1567 2419 1558 2421 1545 2419 1515 649 1511 649 1541"/>
                        </Shape>
                        <String CONTENT="which, however, befalls the people almost every year for several weeks, when-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l17" HPOS="643" VPOS="1567" WIDTH="1776" HEIGHT="63" BASELINE="645 1597 2419 1604" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1597 643 1615 658 1625 660 1625 662 1625 664 1625 755 1615 788 1625 790 1625 792 1625 861 1615 885 1625 887 1625 890 1625 1035 1615 1193 1625 1195 1625 1197 1625 1227 1615 1288 1628 1290 1630 1429 1630 1429 1628 1431 1628 1433 1628 1446 1617 1492 1628 1494 1628 1496 1628 1663 1617 1847 1628 1849 1628 1966 1619 1988 1630 1990 1630 1992 1630 1994 1630 2040 1619 2351 1619 2375 1630 2377 1630 2380 1630 2382 1630 2416 1619 2419 1604 2416 1573 645 1567 645 1597"/>
                        </Shape>
                        <String CONTENT="ever the arrival of the merchant caravans is retarded by blizzards or by"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l18" HPOS="647" VPOS="1621" WIDTH="338" HEIGHT="59" BASELINE="647 1662 985 1662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1662 647 1680 985 1680 985 1662 985 1634 736 1621 734 1621 647 1632 647 1662"/>
                        </Shape>
                        <String CONTENT="swollen rivers."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r3" HPOS="644" VPOS="1686" WIDTH="1778" HEIGHT="122" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="644 1686 2422 1686 2422 1808 644 1808"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l19" HPOS="757" VPOS="1680" WIDTH="1666" HEIGHT="62" BASELINE="757 1723 2423 1723" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 1723 757 1742 2423 1742 2423 1723 2423 1693 2347 1680 2345 1680 2230 1690 1855 1680 1853 1680 1775 1690 1697 1680 1695 1680 1531 1690 1455 1680 1453 1680 1310 1690 1275 1680 1273 1680 1271 1680 1269 1680 1266 1680 1251 1693 1132 1693 1100 1680 1097 1680 1095 1680 1093 1680 1046 1690 892 1680 890 1680 829 1690 781 1680 779 1680 777 1680 775 1680 773 1680 757 1688 757 1723"/>
                        </Shape>
                        <String CONTENT="As substitutes for tea, leaves of the sweet-brier, of Epilobium angustifolium"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l20" HPOS="643" VPOS="1740" WIDTH="1776" HEIGHT="61" BASELINE="645 1783 2419 1779" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1783 645 1801 2416 1796 2419 1779 2414 1751 1531 1740 1528 1740 1526 1740 1502 1751 716 1742 714 1742 643 1753 645 1783"/>
                        </Shape>
                        <String CONTENT="and of various berries, such as Rubus chamæmorus and Rubus arcticus, are used."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r4" HPOS="644" VPOS="1808" WIDTH="1778" HEIGHT="891" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="644 1808 2422 1808 2422 2699 644 2699"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l21" HPOS="755" VPOS="1801" WIDTH="1664" HEIGHT="60" BASELINE="757 1842 2419 1848" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 1842 755 1853 2414 1861 2419 1848 2416 1814 1894 1814 1866 1801 1864 1801 1862 1801 757 1805 757 1842"/>
                        </Shape>
                        <String CONTENT="As stated before, the principal meal of the Chukchee is in the evening,"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l22" HPOS="643" VPOS="1859" WIDTH="1778" HEIGHT="61" BASELINE="645 1905 2421 1900" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1905 645 1920 2419 1916 2421 1900 2416 1870 1539 1859 1537 1859 1535 1859 1533 1859 1520 1870 684 1861 682 1861 680 1861 643 1872 645 1905"/>
                        </Shape>
                        <String CONTENT="after all the people have entered the sleeping-room. At this time the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l23" HPOS="645" VPOS="1922" WIDTH="1776" HEIGHT="67" BASELINE="647 1963 2421 1959" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1963 647 1978 1329 1989 1331 1989 1409 1978 1505 1989 1507 1989 1509 1989 1535 1976 1771 1987 1773 1987 1849 1976 1871 1987 1873 1987 1875 1987 2083 1976 2362 1987 2364 1987 2419 1974 2421 1959 2416 1931 671 1922 669 1922 667 1922 645 1931 647 1963"/>
                        </Shape>
                        <String CONTENT="chee eat much and ravenously. They swallow large quantities of meat, gnaw"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l24" HPOS="645" VPOS="1987" WIDTH="1776" HEIGHT="61" BASELINE="647 2017 2421 2022" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2017 645 2032 1630 2048 1632 2048 2419 2037 2421 2022 2419 1991 647 1987 647 2017"/>
                        </Shape>
                        <String CONTENT="the bones, and try to outdo each other in quickness. Nevertheless the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l25" HPOS="645" VPOS="2052" WIDTH="1776" HEIGHT="48" BASELINE="645 2080 2421 2080" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2080 645 2100 2421 2100 2421 2080 2421 2052 645 2052 645 2080"/>
                        </Shape>
                        <String CONTENT="chee do not seem to be greater eaters than their neighbors; and my cossacks"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l26" HPOS="643" VPOS="2108" WIDTH="1778" HEIGHT="61" BASELINE="645 2139 2421 2143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2139 643 2152 991 2167 994 2169 1175 2169 1175 2167 1178 2167 1180 2167 1195 2156 1470 2167 1472 2167 1474 2167 1496 2156 1537 2169 1539 2169 1541 2169 1544 2169 1583 2158 1613 2169 1615 2169 1617 2169 1723 2158 1972 2169 1975 2169 2027 2158 2139 2169 2141 2169 2419 2156 2421 2143 2419 2108 645 2108 645 2139"/>
                        </Shape>
                        <String CONTENT="and other companions, after a long day spent in travelling through the cold"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l27" HPOS="645" VPOS="2158" WIDTH="1778" HEIGHT="58" BASELINE="647 2197 2423 2201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2197 645 2212 2419 2216 2423 2201 2421 2173 1539 2173 1396 2160 1394 2160 712 2169 647 2158 647 2197"/>
                        </Shape>
                        <String CONTENT="weather, ate just as swiftly and ravenously as the natives. There are some"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l28" HPOS="643" VPOS="2216" WIDTH="1776" HEIGHT="68" BASELINE="645 2258 2419 2264" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2258 643 2271 667 2284 669 2284 671 2284 2416 2277 2419 2264 2419 2232 2401 2221 2399 2221 2397 2221 2395 2221 2042 2232 2003 2221 2001 2221 1998 2221 1996 2221 1994 2221 1977 2232 1949 2221 1946 2221 1944 2221 1892 2232 1825 2219 1823 2219 1821 2219 1786 2229 1691 2219 1541 2219 1539 2219 1537 2219 1535 2219 1522 2229 1472 2219 1470 2219 1468 2219 1440 2229 937 2229 909 2216 907 2216 905 2216 903 2216 857 2227 803 2216 801 2216 799 2216 770 2227 645 2227 645 2258"/>
                        </Shape>
                        <String CONTENT="exceptionally great eaters among the Chukchee, although I myself met such"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l29" HPOS="643" VPOS="2286" WIDTH="1778" HEIGHT="60" BASELINE="645 2318 2421 2323" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2318 643 2331 805 2344 807 2344 1440 2336 1544 2346 1546 2346 2419 2336 2421 2323 2419 2290 645 2286 645 2318"/>
                        </Shape>
                        <String CONTENT="a one only among the Russianized Yukaghir of the Kolyma. I was told about"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l30" HPOS="643" VPOS="2346" WIDTH="1778" HEIGHT="59" BASELINE="645 2379 2421 2383" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2379 643 2390 667 2403 669 2403 671 2403 1405 2394 1535 2405 1537 2405 2419 2394 2421 2383 2419 2351 645 2346 645 2379"/>
                        </Shape>
                        <String CONTENT="one Reindeer Chukchee of the Telqäˊp tundra who was able to consume at"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l31" HPOS="645" VPOS="2405" WIDTH="1776" HEIGHT="50" BASELINE="647 2435 2421 2439" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2435 645 2450 2416 2455 2421 2439 2419 2409 647 2405 647 2435"/>
                        </Shape>
                        <String CONTENT="one eating a two-year-old reindeer-buck. I was told that before a meal the"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l32" HPOS="645" VPOS="2455" WIDTH="1774" HEIGHT="60" BASELINE="647 2496 2419 2500" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2496 645 2511 2414 2515 2419 2500 2416 2468 2152 2457 2150 2457 2024 2468 1998 2457 1996 2457 1994 2457 1918 2468 1894 2457 1892 2457 1890 2457 1771 2468 1749 2457 1747 2457 1745 2457 1743 2457 1715 2468 1632 2457 1630 2457 1554 2468 1535 2455 1533 2455 1531 2455 1528 2455 1442 2465 1334 2455 1331 2455 1329 2455 1301 2465 1271 2455 1269 2455 1266 2455 1264 2455 1236 2465 1184 2455 1182 2455 1180 2455 1147 2465 1123 2455 1121 2455 1119 2455 1117 2455 1087 2468 926 2468 907 2455 905 2455 903 2455 900 2455 647 2463 647 2496"/>
                        </Shape>
                        <String CONTENT="skin on his stomach lay in large folds, which he gathered up with his belt."/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l33" HPOS="647" VPOS="2522" WIDTH="1774" HEIGHT="60" BASELINE="649 2554 2421 2561" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2554 647 2567 708 2580 710 2580 1173 2572 1262 2582 1264 2582 2419 2574 2421 2561 2419 2530 649 2522 649 2554"/>
                        </Shape>
                        <String CONTENT="He could stay without food for two or three days. Then, after a sumptuous"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l34" HPOS="645" VPOS="2578" WIDTH="1778" HEIGHT="56" BASELINE="647 2615 2423 2619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2615 645 2630 2419 2634 2423 2619 2419 2578 647 2582 647 2615"/>
                        </Shape>
                        <String CONTENT="meal, his stomach would be enormously distended, so that the skin would"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l35" HPOS="645" VPOS="2641" WIDTH="1711" HEIGHT="63" BASELINE="647 2673 2356 2682" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2673 645 2688 1076 2704 1078 2704 2354 2697 2356 2682 2354 2652 647 2641 647 2673"/>
                        </Shape>
                        <String CONTENT="look quite smooth, and he would spend a whole day motionless digesting."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-256_r5" HPOS="644" VPOS="2699" WIDTH="1778" HEIGHT="238" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="644 2699 2422 2699 2422 2937 644 2937"/>
                    </Shape>
                    <TextLine ID="mz_1-256_l36" HPOS="755" VPOS="2701" WIDTH="1666" HEIGHT="55" BASELINE="757 2734 2421 2740" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 2734 755 2749 2416 2756 2421 2740 2419 2710 757 2701 757 2734"/>
                        </Shape>
                        <String CONTENT="The Reindeer Chukchee, as well as the Lamut and the Koryak in Kam-"/>
                    </TextLine>

                    <TextLine ID="mz_1-256_l37" HPOS="643" VPOS="2764" WIDTH="1778" HEIGHT="52" BASELINE="645 2795 2421 2801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2795 643 2810 2416 2816 2421 2801 2419 2771 645 2764 645 2795"/>
                        </Shape>
                        <String CONTENT="chatka, occasionally use as food a kind of white clay, which is called nuˊte-"/>
