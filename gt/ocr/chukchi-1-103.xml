                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l2" HPOS="2083" VPOS="640" WIDTH="30" HEIGHT="61" BASELINE="2087 681 2113 679" TAGREFS="TYPE_5">
