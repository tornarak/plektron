                <TextBlock ID="mz_1-103_r2" HPOS="375" VPOS="738" WIDTH="1778" HEIGHT="902" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="375 738 2153 738 2153 1640 375 1640"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l3" HPOS="381" VPOS="746" WIDTH="1769" HEIGHT="50" BASELINE="381 777 2150 777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 746 424 749 402 751 381 751 381 777 381 796 2150 796 2150 777 2150 746 467 746 446 746"/>
                        </Shape>
                        <String CONTENT="animals, especially the younger ones, during the season of insects, pent up in"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l4" HPOS="378" VPOS="794" WIDTH="1772" HEIGHT="59" BASELINE="381 840 2150 835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 840 381 853 2148 850 2150 835 2146 805 1264 794 1262 794 1260 794 1258 794 1240 805 407 796 404 796 402 796 378 805 381 840"/>
                        </Shape>
                        <String CONTENT="sheds to avoid losing them in the thick forest. They feed them all this"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l5" HPOS="381" VPOS="853" WIDTH="1769" HEIGHT="64" BASELINE="383 900 2150 896" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 900 383 915 2146 917 2150 896 2148 866 2107 853 2105 853 2102 853 2100 853 2098 853 2083 863 2014 853 2011 853 2009 853 1988 863 1687 853 1684 853 1622 863 1574 853 1572 853 1570 853 1567 853 1544 863 1437 853 1435 853 1318 863 1266 853 1264 853 1262 853 1230 866 1162 855 1160 855 736 866 632 855 630 855 628 855 589 866 530 855 528 855 459 866 407 855 404 855 402 855 400 855 381 866 383 900"/>
                        </Shape>
                        <String CONTENT="time with willow-sprouts and fresh fish. Two small graylings (Thymallus vulgaris)"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l6" HPOS="381" VPOS="926" WIDTH="1769" HEIGHT="48" BASELINE="383 961 2150 956" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 961 383 974 2148 969 2150 956 2146 926 381 926 383 961"/>
                        </Shape>
                        <String CONTENT="is the daily allowance of a grown reindeer. Frequently the reindeer has a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l7" HPOS="378" VPOS="972" WIDTH="1774" HEIGHT="62" BASELINE="381 1021 2152 1015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1021 381 1034 2150 1032 2152 1015 2148 985 1996 972 1994 972 1931 982 1914 972 1912 972 1910 972 1907 972 1858 982 1814 972 1812 972 1810 972 1808 972 1806 972 1790 985 1652 985 1628 972 1626 972 1624 972 1622 972 1591 982 1563 972 1561 972 1559 972 1557 972 1524 985 1498 974 1496 974 1494 974 1253 985 1223 974 1221 974 1219 974 1217 974 1214 974 1201 985 1147 974 1145 974 1143 974 1119 985 1056 974 1054 974 1052 974 1050 974 1035 987 378 987 381 1021"/>
                        </Shape>
                        <String CONTENT="liking for animal food. Occasionally it catches mice in the moss,¹ and unfledged"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l8" HPOS="381" VPOS="1043" WIDTH="1769" HEIGHT="54" BASELINE="383 1082 2150 1076" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1082 383 1097 2148 1091 2150 1076 2143 1043 381 1043 383 1082"/>
                        </Shape>
                        <String CONTENT="birds among the sprouts, and picks up around the houses scraps of fish and"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l9" HPOS="378" VPOS="1099" WIDTH="1770" HEIGHT="57" BASELINE="381 1143 2148 1134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1143 381 1156 2146 1151 2148 1134 2143 1106 879 1099 877 1099 378 1112 381 1143"/>
                        </Shape>
                        <String CONTENT="meat. Some even steal frozen reindeer-meat from the stores; but such a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l10" HPOS="378" VPOS="1151" WIDTH="1772" HEIGHT="65" BASELINE="381 1201 2150 1195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1201 381 1216 2148 1210 2150 1195 2146 1164 2092 1151 2089 1151 2087 1151 2085 1151 2068 1162 1940 1151 1938 1151 1936 1151 1933 1151 1918 1164 1758 1164 1689 1151 1687 1151 1596 1162 1565 1151 1563 1151 1561 1151 1496 1164 1418 1153 1416 1153 1414 1153 1373 1164 1329 1153 1327 1153 1325 1153 1271 1164 846 1156 844 1156 842 1156 840 1156 827 1166 794 1156 792 1156 790 1156 521 1166 430 1156 428 1156 426 1156 378 1169 381 1201"/>
                        </Shape>
                        <String CONTENT="reindeer is speedily killed, for it is considered to bring misfortune. The rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l11" HPOS="381" VPOS="1227" WIDTH="1767" HEIGHT="48" BASELINE="381 1257 2148 1257" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1257 381 1275 2146 1275 2148 1257 2146 1227 381 1227 381 1257"/>
                        </Shape>
                        <String CONTENT="deer drinks water in the summer-time; but in the winter it is contented with"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l12" HPOS="381" VPOS="1277" WIDTH="1765" HEIGHT="63" BASELINE="381 1318 2146 1318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1318 381 1333 2143 1340 2146 1318 2146 1286 2128 1277 2126 1277 2124 1277 2122 1277 2044 1288 2001 1277 1998 1277 1996 1277 1994 1277 1957 1288 1918 1277 1916 1277 1914 1277 1609 1288 1489 1277 1487 1277 1485 1277 1457 1288 1377 1277 1375 1277 1191 1288 1158 1277 1156 1277 1154 1277 1039 1288 1000 1277 998 1277 996 1277 994 1277 959 1288 907 1277 905 1277 903 1277 900 1277 883 1290 491 1290 454 1277 452 1277 450 1277 381 1288 381 1318"/>
                        </Shape>
                        <String CONTENT="eating snow, as are the dog and every other Arctic animal. If in the fall,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l13" HPOS="376" VPOS="1344" WIDTH="1770" HEIGHT="54" BASELINE="378 1376 2146 1381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1376 376 1389 2141 1398 2146 1381 2143 1348 378 1344 378 1376"/>
                        </Shape>
                        <String CONTENT="after the lakes and rivers are frozen over, snow does not fall for a long time,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l14" HPOS="376" VPOS="1394" WIDTH="1772" HEIGHT="60" BASELINE="378 1437 2148 1433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1437 378 1454 2146 1450 2148 1433 2143 1405 1262 1394 1260 1394 1258 1394 1256 1394 1240 1405 404 1396 402 1396 400 1396 376 1405 378 1437"/>
                        </Shape>
                        <String CONTENT="the herd is in a sad plight, as the reindeer, on account of the peculiar position"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l15" HPOS="376" VPOS="1457" WIDTH="1772" HEIGHT="58" BASELINE="378 1500 2148 1496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1500 378 1515 2146 1511 2148 1496 2143 1465 420 1457 417 1457 415 1457 376 1467 378 1500"/>
                        </Shape>
                        <String CONTENT="of its convex hoofs, is unable to walk on ice toward open places. The herds-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l16" HPOS="376" VPOS="1515" WIDTH="1772" HEIGHT="58" BASELINE="378 1558 2148 1552" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1558 378 1573 2146 1571 2148 1552 2143 1524 968 1515 965 1515 963 1515 961 1515 946 1526 511 1517 508 1517 376 1528 378 1558"/>
                        </Shape>
                        <String CONTENT="man breaks water-holes in the ice near the banks. Nevertheless, without"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l17" HPOS="376" VPOS="1589" WIDTH="875" HEIGHT="45" BASELINE="376 1619 1251 1619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1619 376 1634 1251 1634 1251 1619 1251 1589 376 1589 376 1619"/>
                        </Shape>
                        <String CONTENT="snow, the herd loses fat very quickly."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-103_r3" HPOS="375" VPOS="1640" WIDTH="1778" HEIGHT="243" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="375 1640 2153 1640 2153 1883 375 1883"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l18" HPOS="482" VPOS="1634" WIDTH="1666" HEIGHT="63" BASELINE="485 1680 2148 1675" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 1680 485 1697 2146 1695 2148 1675 2143 1645 1444 1634 1442 1634 1310 1647 482 1647 485 1680"/>
                        </Shape>
                        <String CONTENT="Reindeer-moss grows throughout the year, but, if too much trampled upon,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l19" HPOS="372" VPOS="1695" WIDTH="1776" HEIGHT="69" BASELINE="374 1740 2148 1734" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1740 374 1753 835 1753 903 1764 905 1764 907 1764 937 1753 959 1764 961 1764 963 1764 965 1764 1017 1751 1201 1751 1217 1762 1219 1762 1221 1762 1223 1762 2146 1749 2148 1734 2143 1706 1827 1695 1825 1695 372 1708 374 1740"/>
                        </Shape>
                        <String CONTENT="it will wither and dry up. Such spoiled pastures are exceedingly slow in"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l20" HPOS="374" VPOS="1766" WIDTH="1772" HEIGHT="50" BASELINE="376 1801 2146 1796" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1801 376 1816 2143 1812 2146 1796 2139 1766 374 1768 376 1801"/>
                        </Shape>
                        <String CONTENT="recovering, and they sometimes remain waste for more than twenty years."/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l21" HPOS="381" VPOS="1827" WIDTH="1139" HEIGHT="47" BASELINE="381 1859 1520 1859" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1859 381 1874 1520 1874 1520 1859 1520 1829 381 1827 381 1859"/>
                        </Shape>
                        <String CONTENT="The same is true of districts that are burnt over."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-103_r4" HPOS="375" VPOS="1883" WIDTH="1778" HEIGHT="1265" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="375 1883 2153 1883 2153 3148 375 3148"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l22" HPOS="485" VPOS="1885" WIDTH="1663" HEIGHT="54" BASELINE="487 1920 2148 1913" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="487 1920 487 1939 2146 1939 2148 1913 2143 1885 485 1885 487 1920"/>
                        </Shape>
                        <String CONTENT="Reindeer cannot remain too long at one place, since the constant scraping"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l23" HPOS="374" VPOS="1935" WIDTH="1774" HEIGHT="61" BASELINE="376 1980 2148 1974" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1980 376 1996 2146 1989 2148 1974 2143 1944 965 1935 963 1935 961 1935 937 1946 417 1937 415 1937 413 1937 374 1948 376 1980"/>
                        </Shape>
                        <String CONTENT="of their hoofs hardens the snow, and it becomes difficult to reach the moss"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l24" HPOS="374" VPOS="1998" WIDTH="1774" HEIGHT="58" BASELINE="376 2041 2148 2037" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2041 376 2054 2143 2056 2148 2037 2143 2006 448 1998 446 1998 374 2009 376 2041"/>
                        </Shape>
                        <String CONTENT="under it. Large herds especially have to move forward after a few hours,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l25" HPOS="376" VPOS="2052" WIDTH="1767" HEIGHT="65" BASELINE="378 2102 2143 2093" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 2102 378 2117 2141 2110 2143 2093 2139 2065 2001 2065 1983 2052 1981 2052 1979 2052 1977 2052 1975 2052 1942 2063 1916 2052 1914 2052 1912 2052 1910 2052 1886 2063 1840 2052 1838 2052 1836 2052 1741 2063 1713 2052 1710 2052 1708 2052 1706 2052 1704 2052 1687 2065 1299 2054 1297 2054 1295 2054 1256 2067 1219 2056 1217 2056 1214 2056 1087 2067 1030 2056 1028 2056 1026 2056 1000 2067 924 2056 922 2056 814 2069 552 2058 550 2058 487 2069 448 2058 446 2058 443 2058 376 2071 378 2102"/>
                        </Shape>
                        <String CONTENT="and actually keep moving the whole winter. Therefore the animals in very"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l26" HPOS="374" VPOS="2113" WIDTH="1774" HEIGHT="67" BASELINE="376 2160 2148 2152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2160 376 2180 2146 2169 2148 2152 2143 2123 1754 2113 1752 2113 1700 2123 1500 2115 1498 2115 374 2126 376 2160"/>
                        </Shape>
                        <String CONTENT="large herds do not have much fat. A pasture, after having been grazed over"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l27" HPOS="374" VPOS="2180" WIDTH="1772" HEIGHT="56" BASELINE="376 2221 2146 2214" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2221 376 2236 2143 2229 2146 2214 2141 2186 387 2180 385 2180 383 2180 381 2180 381 2182 374 2186 376 2221"/>
                        </Shape>
                        <String CONTENT="for a day or two, is useless till the next year, and will not be resorted to"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l28" HPOS="374" VPOS="2238" WIDTH="1772" HEIGHT="63" BASELINE="376 2284 2146 2273" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2284 376 2297 1435 2301 1437 2301 1496 2290 1788 2299 1790 2299 1793 2299 1823 2288 1849 2297 1851 2297 1853 2297 2143 2286 2146 2273 2141 2245 1084 2238 1082 2238 1080 2238 1050 2249 450 2242 448 2242 374 2253 376 2284"/>
                        </Shape>
                        <String CONTENT="again in the same season. A pasture that has been used for three or four"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l29" HPOS="374" VPOS="2305" WIDTH="1772" HEIGHT="52" BASELINE="376 2340 2146 2333" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2340 376 2357 2143 2351 2146 2333 2139 2305 374 2310 376 2340"/>
                        </Shape>
                        <String CONTENT="successive years has to be given a rest for five or six years. Thus reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l30" HPOS="374" VPOS="2355" WIDTH="1774" HEIGHT="58" BASELINE="376 2398 2148 2394" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2398 376 2413 2146 2409 2148 2394 2143 2366 1262 2355 1260 2355 1258 2355 1227 2368 374 2368 376 2398"/>
                        </Shape>
                        <String CONTENT="herds will thrive only when the available grounds are large enough for a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l31" HPOS="374" VPOS="2416" WIDTH="1772" HEIGHT="60" BASELINE="376 2459 2146 2455" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2459 376 2476 2143 2472 2146 2455 2141 2426 1292 2416 1290 2416 1288 2416 1247 2426 469 2418 467 2418 374 2429 376 2459"/>
                        </Shape>
                        <String CONTENT="continuous change of good pastures, carefully picked out among the vast spaces"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l32" HPOS="374" VPOS="2485" WIDTH="1769" HEIGHT="50" BASELINE="376 2520 2143 2513" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2520 376 2535 2141 2528 2143 2513 2137 2485 374 2489 376 2520"/>
                        </Shape>
                        <String CONTENT="of poor land and coarse fodder. The summer pastures are not so easily"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l33" HPOS="374" VPOS="2535" WIDTH="1772" HEIGHT="63" BASELINE="376 2580 2146 2576" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2580 376 2598 2143 2598 2146 2576 2141 2548 2031 2535 2029 2535 1972 2546 1946 2535 1944 2535 1942 2535 1890 2546 1210 2537 1208 2537 1206 2537 1204 2537 1186 2550 1091 2550 1074 2537 1071 2537 1069 2537 1067 2537 617 2548 602 2537 599 2537 597 2537 433 2537 430 2537 428 2537 374 2550 376 2580"/>
                        </Shape>
                        <String CONTENT="exhausted; and on the Arctic seashore, between the Kolyma and Chaun,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l34" HPOS="372" VPOS="2593" WIDTH="1774" HEIGHT="63" BASELINE="374 2641 2146 2634" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2641 374 2656 2143 2649 2146 2634 2141 2604 1554 2593 1552 2593 1550 2593 1526 2604 407 2598 404 2598 402 2598 372 2606 374 2641"/>
                        </Shape>
                        <String CONTENT="although resorted to every year for half a century, they still thrive, and sprout"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l35" HPOS="374" VPOS="2656" WIDTH="1772" HEIGHT="61" BASELINE="376 2701 2146 2695" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2701 376 2717 2143 2714 2146 2695 2141 2665 974 2656 972 2656 970 2656 968 2656 955 2667 461 2658 459 2658 374 2669 376 2701"/>
                        </Shape>
                        <String CONTENT="again every spring. The best strip of pasture-land here lies close to the shore,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l36" HPOS="374" VPOS="2712" WIDTH="1774" HEIGHT="76" BASELINE="376 2762 2148 2751" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2762 376 2777 701 2788 703 2788 706 2788 731 2775 1046 2786 1048 2786 1126 2775 1299 2784 1301 2784 1303 2784 1305 2784 1323 2773 1784 2782 1786 2782 1788 2782 1790 2782 1803 2769 1836 2779 1838 2779 1840 2779 1842 2779 1881 2769 1977 2779 1979 2779 2146 2769 2148 2751 2143 2723 1819 2712 1816 2712 1754 2723 441 2721 439 2721 374 2732 376 2762"/>
                        </Shape>
                        <String CONTENT="and is usually occupied by poor people, who quite overcrowd it, — at least"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l37" HPOS="374" VPOS="2773" WIDTH="1774" HEIGHT="71" BASELINE="376 2823 2148 2814" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2823 376 2836 948 2844 950 2844 1132 2833 1197 2844 1199 2844 1201 2844 1204 2844 1221 2833 1606 2842 1609 2842 1704 2829 1721 2840 1723 2840 1726 2840 1728 2840 2146 2829 2148 2814 2143 2786 2066 2773 2063 2773 1981 2784 1957 2773 1955 2773 1953 2773 1951 2773 1949 2773 1931 2786 1797 2786 1736 2773 1734 2773 1732 2773 1700 2786 1407 2775 1405 2775 1353 2786 1325 2775 1323 2775 1321 2775 1230 2788 1167 2777 1165 2777 1162 2777 1134 2788 1119 2777 1117 2777 1115 2777 1113 2777 1110 2777 1071 2788 985 2777 983 2777 807 2790 712 2779 710 2779 374 2786 376 2823"/>
                        </Shape>
                        <String CONTENT="in the Chukchee conception of the word. They live so close together that"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l38" HPOS="381" VPOS="2836" WIDTH="1765" HEIGHT="60" BASELINE="383 2879 2146 2872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 2879 383 2896 2143 2890 2146 2872 2139 2836 381 2846 383 2879"/>
                        </Shape>
                        <String CONTENT="“the tents are visible one from the other” (am-yaˊra-wuˊrra). In the spring of"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l39" HPOS="374" VPOS="2905" WIDTH="1767" HEIGHT="52" BASELINE="376 2940 2141 2933" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2940 376 2957 2139 2950 2141 2933 2135 2905 374 2909 376 2940"/>
                        </Shape>
