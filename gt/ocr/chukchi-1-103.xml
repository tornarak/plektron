                <TextBlock ID="mz_1-103_r2" HPOS="354" VPOS="723" WIDTH="1778" HEIGHT="902" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="354 723 2132 723 2132 1625 354 1625"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l3" HPOS="360" VPOS="731" WIDTH="1769" HEIGHT="50" BASELINE="360 762 2129 762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="425 731 403 734 381 736 360 736 360 762 360 781 2129 781 2129 762 2129 731 446 731 425 731"/>
                        </Shape>
                        <String CONTENT="animals, especially the younger ones, during the season of insects, pent up in"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l4" HPOS="357" VPOS="779" WIDTH="1772" HEIGHT="59" BASELINE="360 825 2129 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 825 360 838 2127 835 2129 820 2125 790 1243 779 1241 779 1239 779 1237 779 1219 790 386 781 383 781 381 781 357 790 360 825"/>
                        </Shape>
                        <String CONTENT="sheds to avoid losing them in the thick forest. They feed them all this"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l5" HPOS="360" VPOS="838" WIDTH="1769" HEIGHT="64" BASELINE="362 885 2129 881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 885 362 900 2125 902 2129 881 2127 851 2086 838 2084 838 2081 838 2079 838 2077 838 2062 848 1993 838 1990 838 1988 838 1967 848 1666 838 1663 838 1601 848 1553 838 1551 838 1549 838 1546 838 1523 848 1416 838 1414 838 1297 848 1245 838 1243 838 1241 838 1209 851 1141 840 1139 840 715 851 611 840 609 840 607 840 568 851 509 840 507 840 438 851 386 840 383 840 381 840 379 840 360 851 362 885"/>
                        </Shape>
                        <String CONTENT="time with willow-sprouts and fresh fish. Two small graylings (Thymallus vulgaris)"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l6" HPOS="360" VPOS="911" WIDTH="1769" HEIGHT="48" BASELINE="362 946 2129 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 946 362 959 2127 954 2129 941 2125 911 360 911 362 946"/>
                        </Shape>
                        <String CONTENT="is the daily allowance of a grown reindeer. Frequently the reindeer has a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l7" HPOS="357" VPOS="957" WIDTH="1774" HEIGHT="62" BASELINE="360 1006 2131 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1006 360 1019 2129 1017 2131 1000 2127 970 1975 957 1973 957 1910 967 1893 957 1891 957 1889 957 1886 957 1837 967 1793 957 1791 957 1789 957 1787 957 1785 957 1769 970 1631 970 1607 957 1605 957 1603 957 1601 957 1570 967 1542 957 1540 957 1538 957 1536 957 1503 970 1477 959 1475 959 1473 959 1232 970 1202 959 1200 959 1198 959 1196 959 1193 959 1180 970 1126 959 1124 959 1122 959 1098 970 1035 959 1033 959 1031 959 1029 959 1014 972 357 972 360 1006"/>
                        </Shape>
                        <String CONTENT="liking for animal food. Occasionally it catches mice in the moss,¹ and unfledged"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l8" HPOS="360" VPOS="1028" WIDTH="1769" HEIGHT="54" BASELINE="362 1067 2129 1061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1067 362 1082 2127 1076 2129 1061 2122 1028 360 1028 362 1067"/>
                        </Shape>
                        <String CONTENT="birds among the sprouts, and picks up around the houses scraps of fish and"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l9" HPOS="357" VPOS="1084" WIDTH="1770" HEIGHT="57" BASELINE="360 1128 2127 1119" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1128 360 1141 2125 1136 2127 1119 2122 1091 858 1084 856 1084 357 1097 360 1128"/>
                        </Shape>
                        <String CONTENT="meat. Some even steal frozen reindeer-meat from the stores; but such a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l10" HPOS="357" VPOS="1136" WIDTH="1772" HEIGHT="65" BASELINE="360 1186 2129 1180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1186 360 1201 2127 1195 2129 1180 2125 1149 2071 1136 2068 1136 2066 1136 2064 1136 2047 1147 1919 1136 1917 1136 1915 1136 1912 1136 1897 1149 1737 1149 1668 1136 1666 1136 1575 1147 1544 1136 1542 1136 1540 1136 1475 1149 1397 1138 1395 1138 1393 1138 1352 1149 1308 1138 1306 1138 1304 1138 1250 1149 825 1141 823 1141 821 1141 819 1141 806 1151 773 1141 771 1141 769 1141 500 1151 409 1141 407 1141 405 1141 357 1154 360 1186"/>
                        </Shape>
                        <String CONTENT="reindeer is speedily killed, for it is considered to bring misfortune. The rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l11" HPOS="360" VPOS="1212" WIDTH="1767" HEIGHT="48" BASELINE="360 1242 2127 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1242 360 1260 2125 1260 2127 1242 2125 1212 360 1212 360 1242"/>
                        </Shape>
                        <String CONTENT="deer drinks water in the summer-time; but in the winter it is contented with"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l12" HPOS="360" VPOS="1262" WIDTH="1765" HEIGHT="63" BASELINE="360 1303 2125 1303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1303 360 1318 2122 1325 2125 1303 2125 1271 2107 1262 2105 1262 2103 1262 2101 1262 2023 1273 1980 1262 1977 1262 1975 1262 1973 1262 1936 1273 1897 1262 1895 1262 1893 1262 1588 1273 1468 1262 1466 1262 1464 1262 1436 1273 1356 1262 1354 1262 1170 1273 1137 1262 1135 1262 1133 1262 1018 1273 979 1262 977 1262 975 1262 973 1262 938 1273 886 1262 884 1262 882 1262 879 1262 862 1275 470 1275 433 1262 431 1262 429 1262 360 1273 360 1303"/>
                        </Shape>
                        <String CONTENT="eating snow, as are the dog and every other Arctic animal. If in the fall,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l13" HPOS="355" VPOS="1329" WIDTH="1770" HEIGHT="54" BASELINE="357 1361 2125 1366" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1361 355 1374 2120 1383 2125 1366 2122 1333 357 1329 357 1361"/>
                        </Shape>
                        <String CONTENT="after the lakes and rivers are frozen over, snow does not fall for a long time,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l14" HPOS="355" VPOS="1379" WIDTH="1772" HEIGHT="60" BASELINE="357 1422 2127 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1422 357 1439 2125 1435 2127 1418 2122 1390 1241 1379 1239 1379 1237 1379 1235 1379 1219 1390 383 1381 381 1381 379 1381 355 1390 357 1422"/>
                        </Shape>
                        <String CONTENT="the herd is in a sad plight, as the reindeer, on account of the peculiar position"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l15" HPOS="355" VPOS="1442" WIDTH="1772" HEIGHT="58" BASELINE="357 1485 2127 1481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1485 357 1500 2125 1496 2127 1481 2122 1450 399 1442 396 1442 394 1442 355 1452 357 1485"/>
                        </Shape>
                        <String CONTENT="of its convex hoofs, is unable to walk on ice toward open places. The herds-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l16" HPOS="355" VPOS="1500" WIDTH="1772" HEIGHT="58" BASELINE="357 1543 2127 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1543 357 1558 2125 1556 2127 1537 2122 1509 947 1500 944 1500 942 1500 940 1500 925 1511 490 1502 487 1502 355 1513 357 1543"/>
                        </Shape>
                        <String CONTENT="man breaks water-holes in the ice near the banks. Nevertheless, without"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l17" HPOS="355" VPOS="1574" WIDTH="875" HEIGHT="45" BASELINE="355 1604 1230 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1604 355 1619 1230 1619 1230 1604 1230 1574 355 1574 355 1604"/>
                        </Shape>
                        <String CONTENT="snow, the herd loses fat very quickly."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-103_r3" HPOS="354" VPOS="1625" WIDTH="1778" HEIGHT="243" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="354 1625 2132 1625 2132 1868 354 1868"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l18" HPOS="461" VPOS="1619" WIDTH="1666" HEIGHT="63" BASELINE="464 1665 2127 1660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 1665 464 1682 2125 1680 2127 1660 2122 1630 1423 1619 1421 1619 1289 1632 461 1632 464 1665"/>
                        </Shape>
                        <String CONTENT="Reindeer-moss grows throughout the year, but, if too much trampled upon,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l19" HPOS="351" VPOS="1680" WIDTH="1776" HEIGHT="69" BASELINE="353 1725 2127 1719" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1725 353 1738 814 1738 882 1749 884 1749 886 1749 916 1738 938 1749 940 1749 942 1749 944 1749 996 1736 1180 1736 1196 1747 1198 1747 1200 1747 1202 1747 2125 1734 2127 1719 2122 1691 1806 1680 1804 1680 351 1693 353 1725"/>
                        </Shape>
                        <String CONTENT="it will wither and dry up. Such spoiled pastures are exceedingly slow in"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l20" HPOS="353" VPOS="1751" WIDTH="1772" HEIGHT="50" BASELINE="355 1786 2125 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1786 355 1801 2122 1797 2125 1781 2118 1751 353 1753 355 1786"/>
                        </Shape>
                        <String CONTENT="recovering, and they sometimes remain waste for more than twenty years."/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l21" HPOS="360" VPOS="1812" WIDTH="1139" HEIGHT="47" BASELINE="360 1844 1499 1844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1844 360 1859 1499 1859 1499 1844 1499 1814 360 1812 360 1844"/>
                        </Shape>
                        <String CONTENT="The same is true of districts that are burnt over."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-103_r4" HPOS="354" VPOS="1868" WIDTH="1778" HEIGHT="1265" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="354 1868 2132 1868 2132 3133 354 3133"/>
                    </Shape>
                    <TextLine ID="mz_1-103_l22" HPOS="464" VPOS="1870" WIDTH="1663" HEIGHT="54" BASELINE="466 1905 2127 1898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="466 1905 466 1924 2125 1924 2127 1898 2122 1870 464 1870 466 1905"/>
                        </Shape>
                        <String CONTENT="Reindeer cannot remain too long at one place, since the constant scraping"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l23" HPOS="353" VPOS="1920" WIDTH="1774" HEIGHT="61" BASELINE="355 1965 2127 1959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1965 355 1981 2125 1974 2127 1959 2122 1929 944 1920 942 1920 940 1920 916 1931 396 1922 394 1922 392 1922 353 1933 355 1965"/>
                        </Shape>
                        <String CONTENT="of their hoofs hardens the snow, and it becomes difficult to reach the moss"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l24" HPOS="353" VPOS="1983" WIDTH="1774" HEIGHT="58" BASELINE="355 2026 2127 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2026 355 2039 2122 2041 2127 2022 2122 1991 427 1983 425 1983 353 1994 355 2026"/>
                        </Shape>
                        <String CONTENT="under it. Large herds especially have to move forward after a few hours,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l25" HPOS="355" VPOS="2037" WIDTH="1767" HEIGHT="65" BASELINE="357 2087 2122 2078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2087 357 2102 2120 2095 2122 2078 2118 2050 1980 2050 1962 2037 1960 2037 1958 2037 1956 2037 1954 2037 1921 2048 1895 2037 1893 2037 1891 2037 1889 2037 1865 2048 1819 2037 1817 2037 1815 2037 1720 2048 1692 2037 1689 2037 1687 2037 1685 2037 1683 2037 1666 2050 1278 2039 1276 2039 1274 2039 1235 2052 1198 2041 1196 2041 1193 2041 1066 2052 1009 2041 1007 2041 1005 2041 979 2052 903 2041 901 2041 793 2054 531 2043 529 2043 466 2054 427 2043 425 2043 422 2043 355 2056 357 2087"/>
                        </Shape>
                        <String CONTENT="and actually keep moving the whole winter. Therefore the animals in very"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l26" HPOS="353" VPOS="2098" WIDTH="1774" HEIGHT="67" BASELINE="355 2145 2127 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2145 355 2165 2125 2154 2127 2137 2122 2108 1733 2098 1731 2098 1679 2108 1479 2100 1477 2100 353 2111 355 2145"/>
                        </Shape>
                        <String CONTENT="large herds do not have much fat. A pasture, after having been grazed over"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l27" HPOS="353" VPOS="2165" WIDTH="1772" HEIGHT="56" BASELINE="355 2206 2125 2199" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2206 355 2221 2122 2214 2125 2199 2120 2171 366 2165 364 2165 362 2165 360 2165 360 2167 353 2171 355 2206"/>
                        </Shape>
                        <String CONTENT="for a day or two, is useless till the next year, and will not be resorted to"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l28" HPOS="353" VPOS="2223" WIDTH="1772" HEIGHT="63" BASELINE="355 2269 2125 2258" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2269 355 2282 1414 2286 1416 2286 1475 2275 1767 2284 1769 2284 1772 2284 1802 2273 1828 2282 1830 2282 1832 2282 2122 2271 2125 2258 2120 2230 1063 2223 1061 2223 1059 2223 1029 2234 429 2227 427 2227 353 2238 355 2269"/>
                        </Shape>
                        <String CONTENT="again in the same season. A pasture that has been used for three or four"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l29" HPOS="353" VPOS="2290" WIDTH="1772" HEIGHT="52" BASELINE="355 2325 2125 2318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2325 355 2342 2122 2336 2125 2318 2118 2290 353 2295 355 2325"/>
                        </Shape>
                        <String CONTENT="successive years has to be given a rest for five or six years. Thus reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l30" HPOS="353" VPOS="2340" WIDTH="1774" HEIGHT="58" BASELINE="355 2383 2127 2379" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2383 355 2398 2125 2394 2127 2379 2122 2351 1241 2340 1239 2340 1237 2340 1206 2353 353 2353 355 2383"/>
                        </Shape>
                        <String CONTENT="herds will thrive only when the available grounds are large enough for a"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l31" HPOS="353" VPOS="2401" WIDTH="1772" HEIGHT="60" BASELINE="355 2444 2125 2440" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2444 355 2461 2122 2457 2125 2440 2120 2411 1271 2401 1269 2401 1267 2401 1226 2411 448 2403 446 2403 353 2414 355 2444"/>
                        </Shape>
                        <String CONTENT="continuous change of good pastures, carefully picked out among the vast spaces"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l32" HPOS="353" VPOS="2470" WIDTH="1769" HEIGHT="50" BASELINE="355 2505 2122 2498" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2505 355 2520 2120 2513 2122 2498 2116 2470 353 2474 355 2505"/>
                        </Shape>
                        <String CONTENT="of poor land and coarse fodder. The summer pastures are not so easily"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l33" HPOS="353" VPOS="2520" WIDTH="1772" HEIGHT="63" BASELINE="355 2565 2125 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2565 355 2583 2122 2583 2125 2561 2120 2533 2010 2520 2008 2520 1951 2531 1925 2520 1923 2520 1921 2520 1869 2531 1189 2522 1187 2522 1185 2522 1183 2522 1165 2535 1070 2535 1053 2522 1050 2522 1048 2522 1046 2522 596 2533 581 2522 578 2522 576 2522 412 2522 409 2522 407 2522 353 2535 355 2565"/>
                        </Shape>
                        <String CONTENT="exhausted; and on the Arctic seashore, between the Kolyma and Chaun,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l34" HPOS="351" VPOS="2578" WIDTH="1774" HEIGHT="63" BASELINE="353 2626 2125 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2626 353 2641 2122 2634 2125 2619 2120 2589 1533 2578 1531 2578 1529 2578 1505 2589 386 2583 383 2583 381 2583 351 2591 353 2626"/>
                        </Shape>
                        <String CONTENT="although resorted to every year for half a century, they still thrive, and sprout"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l35" HPOS="353" VPOS="2641" WIDTH="1772" HEIGHT="61" BASELINE="355 2686 2125 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2686 355 2702 2122 2699 2125 2680 2120 2650 953 2641 951 2641 949 2641 947 2641 934 2652 440 2643 438 2643 353 2654 355 2686"/>
                        </Shape>
                        <String CONTENT="again every spring. The best strip of pasture-land here lies close to the shore,"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l36" HPOS="353" VPOS="2697" WIDTH="1774" HEIGHT="76" BASELINE="355 2747 2127 2736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2747 355 2762 680 2773 682 2773 685 2773 710 2760 1025 2771 1027 2771 1105 2760 1278 2769 1280 2769 1282 2769 1284 2769 1302 2758 1763 2767 1765 2767 1767 2767 1769 2767 1782 2754 1815 2764 1817 2764 1819 2764 1821 2764 1860 2754 1956 2764 1958 2764 2125 2754 2127 2736 2122 2708 1798 2697 1795 2697 1733 2708 420 2706 418 2706 353 2717 355 2747"/>
                        </Shape>
                        <String CONTENT="and is usually occupied by poor people, who quite overcrowd it, — at least"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l37" HPOS="353" VPOS="2758" WIDTH="1774" HEIGHT="71" BASELINE="355 2808 2127 2799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2808 355 2821 927 2829 929 2829 1111 2818 1176 2829 1178 2829 1180 2829 1183 2829 1200 2818 1585 2827 1588 2827 1683 2814 1700 2825 1702 2825 1705 2825 1707 2825 2125 2814 2127 2799 2122 2771 2045 2758 2042 2758 1960 2769 1936 2758 1934 2758 1932 2758 1930 2758 1928 2758 1910 2771 1776 2771 1715 2758 1713 2758 1711 2758 1679 2771 1386 2760 1384 2760 1332 2771 1304 2760 1302 2760 1300 2760 1209 2773 1146 2762 1144 2762 1141 2762 1113 2773 1098 2762 1096 2762 1094 2762 1092 2762 1089 2762 1050 2773 964 2762 962 2762 786 2775 691 2764 689 2764 353 2771 355 2808"/>
                        </Shape>
                        <String CONTENT="in the Chukchee conception of the word. They live so close together that"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l38" HPOS="360" VPOS="2821" WIDTH="1765" HEIGHT="60" BASELINE="362 2864 2125 2857" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2864 362 2881 2122 2875 2125 2857 2118 2821 360 2831 362 2864"/>
                        </Shape>
                        <String CONTENT="“the tents are visible one from the other” (am-yaˊra-wuˊrra). In the spring of"/>
                    </TextLine>

                    <TextLine ID="mz_1-103_l39" HPOS="353" VPOS="2890" WIDTH="1767" HEIGHT="52" BASELINE="355 2925 2120 2918" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2925 355 2942 2118 2935 2120 2918 2114 2890 353 2894 355 2925"/>
                        </Shape>
                        <String CONTENT="the year, when going to the shore, several camps often start a running-match"/>
                    </TextLine>

