                <TextBlock ID="mz_1-070_r1" HPOS="737" VPOS="631" WIDTH="1778" HEIGHT="90" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="737 631 2515 631 2515 721 737 721"/>
                    </Shape>
                    <TextLine ID="mz_1-070_l1" HPOS="1314" VPOS="649" WIDTH="622" HEIGHT="52" BASELINE="1314 681 1936 681" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="1920 649 1323 649 1314 655 1314 681 1314 701 1936 701 1936 681 1936 653 1920 649"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l2" HPOS="742" VPOS="645" WIDTH="65" HEIGHT="56" BASELINE="747 690 807 686" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="799 645 742 653 747 690 747 701 805 699 807 686 801 645 799 645"/>
                        </Shape>
                        <String CONTENT="48"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-070_r2" HPOS="737" VPOS="746" WIDTH="1778" HEIGHT="606" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="737 746 2515 746 2515 1352 737 1352"/>
                    </Shape>
                    <TextLine ID="mz_1-070_l3" HPOS="840" VPOS="759" WIDTH="1665" HEIGHT="52" BASELINE="840 790 2505 790" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="840 790 840 807 2503 811 2505 790 2505 759 840 759 840 790"/>
                        </Shape>
                        <String CONTENT="I heard of no cases of cannibalism among the Chukchee, notwithstanding"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l4" HPOS="736" VPOS="816" WIDTH="1769" HEIGHT="52" BASELINE="736 850 2505 850" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 850 736 868 2505 868 2505 850 2503 816 736 818 736 850"/>
                        </Shape>
                        <String CONTENT="the fact that several cases of famine which wiped out whole villages were still"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l5" HPOS="734" VPOS="866" WIDTH="1771" HEIGHT="71" BASELINE="736 907 2505 911" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 907 734 920 788 935 790 935 792 935 859 924 1013 935 1015 935 1017 935 1020 935 1035 924 1106 935 1108 935 1613 924 1626 935 1628 935 1630 935 1632 935 2172 926 2280 937 2282 937 2360 926 2483 937 2486 937 2488 937 2490 937 2503 924 2505 911 2505 881 2473 868 2471 868 2371 868 2369 868 2367 868 2364 868 2351 878 2323 868 2321 868 2319 868 2256 878 2217 868 2215 868 2213 868 2118 878 2042 868 2040 868 2037 868 2016 878 1953 868 1951 868 1949 868 1925 878 1855 868 1853 868 1851 868 1823 878 1741 868 1739 868 1736 868 1706 878 1650 868 1648 868 1552 876 1531 866 1528 866 1526 866 1524 866 1485 878 1368 878 1353 866 1351 866 1349 866 1347 866 1253 878 1004 878 989 866 987 866 985 866 983 866 981 866 955 876 892 866 890 866 887 866 885 866 868 876 833 866 831 866 829 866 736 874 736 907"/>
                        </Shape>
                        <String CONTENT="fresh in the memory of the people. On the other hand, a Yukaghir family"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l6" HPOS="736" VPOS="935" WIDTH="1767" HEIGHT="52" BASELINE="738 965 2503 972" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 965 736 980 2499 987 2503 972 2501 941 738 935 738 965"/>
                        </Shape>
                        <String CONTENT="which was starved in 1895 on the Middle Omolon had recourse to the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l7" HPOS="738" VPOS="989" WIDTH="1767" HEIGHT="58" BASELINE="738 1030 2505 1030" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1030 738 1047 2503 1047 2505 1030 2503 1002 2408 989 2406 989 2328 1000 2282 989 2280 989 2278 989 2276 989 2234 1002 2020 1002 2005 989 2003 989 2001 989 1998 989 1996 989 1955 1002 1717 1002 1702 989 1700 989 1697 989 1695 989 1693 989 1648 1002 1494 1002 1476 989 1474 989 1472 989 1470 989 1468 989 1433 1000 1295 989 1292 989 1230 1000 1126 989 1123 989 978 1000 738 993 738 1030"/>
                        </Shape>
                        <String CONTENT="horrible cannibalism. Nor am I aware of any cases of exposure of new-born"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l8" HPOS="736" VPOS="1047" WIDTH="1771" HEIGHT="65" BASELINE="738 1093 2507 1086" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1093 738 1112 2505 1104 2507 1086 2503 1056 1327 1047 1325 1047 1269 1058 770 1050 768 1050 766 1050 736 1060 738 1093"/>
                        </Shape>
                        <String CONTENT="girls, as among the American Eskimo. New-born babes, indeed, after the death"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l9" HPOS="738" VPOS="1121" WIDTH="1771" HEIGHT="45" BASELINE="738 1149 2509 1149" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1149 738 1166 2509 1166 2509 1149 2509 1121 738 1121 738 1149"/>
                        </Shape>
                        <String CONTENT="of their mothers, are frequently smothered, and carried out with them to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l10" HPOS="738" VPOS="1166" WIDTH="1771" HEIGHT="61" BASELINE="738 1210 2509 1210" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1210 738 1227 2509 1227 2509 1210 2509 1179 2406 1166 2403 1166 2338 1179 2228 1179 2211 1166 2208 1166 2206 1166 2204 1166 2202 1166 2176 1177 2100 1166 2098 1166 2040 1177 2003 1166 2001 1166 1998 1166 1996 1166 1957 1177 1888 1166 1886 1166 1797 1177 1684 1166 1682 1166 1680 1166 1652 1177 1613 1166 1611 1166 1609 1166 1524 1177 1342 1166 1340 1166 1338 1166 1312 1177 1286 1166 1284 1166 1282 1166 1279 1166 1253 1177 1225 1166 1223 1166 1221 1166 1162 1177 1084 1166 1082 1166 1080 1166 1054 1177 946 1166 944 1166 738 1175 738 1210"/>
                        </Shape>
                        <String CONTENT="funeral-places, but this is because of the impossibility of raising them. I have"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l11" HPOS="736" VPOS="1231" WIDTH="1771" HEIGHT="55" BASELINE="738 1266 2507 1270" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1266 736 1281 2503 1286 2507 1270 2505 1240 738 1231 738 1266"/>
                        </Shape>
                        <String CONTENT="heard, too, of women just delivered, who, when feeling very ill, would smother"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l12" HPOS="738" VPOS="1299" WIDTH="953" HEIGHT="45" BASELINE="738 1327 1691 1327" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1327 738 1342 1689 1344 1691 1327 1691 1299 738 1299 738 1327"/>
                        </Shape>
                        <String CONTENT="their children as a sacrifice to the spirits."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-070_r3" HPOS="737" VPOS="1352" WIDTH="1778" HEIGHT="471" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="737 1352 2515 1352 2515 1823 737 1823"/>
                    </Shape>
                    <TextLine ID="mz_1-070_l13" HPOS="844" VPOS="1344" WIDTH="1663" HEIGHT="61" BASELINE="846 1385 2507 1389" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="846 1385 844 1400 2503 1405 2507 1389 2507 1359 2471 1346 2468 1346 2373 1346 2371 1346 2369 1346 2367 1346 2351 1357 2282 1346 2280 1346 2221 1357 2206 1346 2204 1346 2202 1346 2200 1346 2137 1357 2096 1346 2094 1346 2092 1346 2089 1346 2059 1359 1890 1359 1877 1346 1875 1346 1873 1346 1871 1346 1816 1357 1780 1346 1777 1346 1775 1346 1583 1355 1570 1344 1567 1344 1565 1344 1563 1344 1561 1344 1533 1355 1420 1344 1418 1344 1416 1344 1388 1355 1318 1344 1316 1344 1256 1355 846 1353 846 1385"/>
                        </Shape>
                        <String CONTENT="Hospitality to travellers is much more liberal among the Maritime Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l14" HPOS="734" VPOS="1415" WIDTH="1773" HEIGHT="57" BASELINE="736 1444 2507 1448" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1444 734 1461 749 1472 751 1472 753 1472 755 1472 2505 1463 2507 1448 2505 1420 736 1415 736 1444"/>
                        </Shape>
                        <String CONTENT="chee than among the reindeer-breeders. The Arctic people say, that, even"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l15" HPOS="734" VPOS="1472" WIDTH="1769" HEIGHT="52" BASELINE="736 1506 2503 1511" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1506 734 1519 2499 1524 2503 1511 2501 1478 736 1472 736 1506"/>
                        </Shape>
                        <String CONTENT="if a guest wants to strike his host, the latter must continue to be friendly."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l16" HPOS="736" VPOS="1532" WIDTH="1771" HEIGHT="59" BASELINE="738 1565 2507 1569" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1565 736 1578 762 1591 764 1591 766 1591 2505 1582 2507 1569 2505 1539 738 1532 738 1565"/>
                        </Shape>
                        <String CONTENT="During my last journey along the Pacific coast, when we were several times"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l17" HPOS="734" VPOS="1593" WIDTH="1771" HEIGHT="61" BASELINE="736 1625 2505 1630" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1625 734 1638 818 1651 820 1651 1507 1643 1648 1654 1650 1654 2503 1643 2505 1630 2503 1597 736 1593 736 1625"/>
                        </Shape>
                        <String CONTENT="detained in Chukchee or Eskimo dwellings by a storm, it would often happen"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l18" HPOS="736" VPOS="1658" WIDTH="1771" HEIGHT="45" BASELINE="736 1688 2507 1688" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1688 736 1703 2507 1703 2507 1688 2507 1658 736 1658 736 1688"/>
                        </Shape>
                        <String CONTENT="that the master of the house, having little blubber and no wood to feed the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l19" HPOS="736" VPOS="1719" WIDTH="1771" HEIGHT="45" BASELINE="736 1749 2507 1749" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1749 736 1764 2507 1764 2507 1749 2507 1719 736 1719 736 1749"/>
                        </Shape>
                        <String CONTENT="fire, would break up his sleds, and even tear out one by one the wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l20" HPOS="736" VPOS="1773" WIDTH="1152" HEIGHT="60" BASELINE="738 1803 1888 1807" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1803 736 1816 779 1831 781 1831 783 1831 931 1820 1234 1831 1236 1831 1238 1831 1262 1820 1855 1833 1858 1833 1860 1833 1886 1820 1888 1807 1886 1777 738 1773 738 1803"/>
                        </Shape>
                        <String CONTENT="supports of his house, thus endangering its safety."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-070_r4" HPOS="737" VPOS="1823" WIDTH="1778" HEIGHT="960" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="737 1823 2515 1823 2515 2783 737 2783"/>
                    </Shape>
                    <TextLine ID="mz_1-070_l21" HPOS="848" VPOS="1825" WIDTH="1661" HEIGHT="58" BASELINE="848 1868 2509 1868" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="848 1868 848 1883 2509 1883 2509 1868 2509 1835 2483 1825 2481 1825 2479 1825 2477 1825 2451 1838 2217 1838 2202 1825 2200 1825 2198 1825 2195 1825 2193 1825 2165 1835 2130 1825 2128 1825 2126 1825 2124 1825 2083 1835 2061 1825 2059 1825 2057 1825 2055 1825 2016 1835 1929 1825 1927 1825 1866 1835 1775 1825 1773 1825 1710 1835 1674 1825 1671 1825 1669 1825 1619 1835 1574 1825 1572 1825 1570 1825 1567 1825 1539 1835 1511 1825 1509 1825 1507 1825 1505 1825 1479 1835 1444 1825 1442 1825 1440 1825 1375 1835 848 1827 848 1868"/>
                        </Shape>
                        <String CONTENT="With the Reindeer people it is otherwise. First of all, they are much"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l22" HPOS="734" VPOS="1892" WIDTH="1773" HEIGHT="50" BASELINE="736 1924 2507 1929" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 1924 734 1937 2503 1942 2507 1929 2505 1896 736 1892 736 1924"/>
                        </Shape>
                        <String CONTENT="more superstitious about the “shunning” of diseases. In times of disease, even"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l23" HPOS="736" VPOS="1952" WIDTH="1769" HEIGHT="50" BASELINE="738 1983 2505 1987" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 1983 736 1998 2501 2002 2505 1987 2503 1957 738 1952 738 1983"/>
                        </Shape>
                        <String CONTENT="a healthy traveller, when he comes to a Chukchee camp from afar, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l24" HPOS="734" VPOS="2009" WIDTH="1771" HEIGHT="54" BASELINE="736 2043 2505 2050" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2043 734 2056 2501 2063 2505 2050 2503 2017 736 2009 736 2043"/>
                        </Shape>
                        <String CONTENT="if he arrives at night, runs the risk of not being admitted to any of the tents."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l25" HPOS="738" VPOS="2061" WIDTH="1769" HEIGHT="71" BASELINE="740 2102 2507 2108" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="740 2102 738 2117 753 2128 755 2128 757 2128 760 2128 851 2117 885 2128 887 2128 890 2128 1366 2119 1381 2130 1383 2130 1386 2130 1388 2130 1390 2130 1433 2119 1461 2130 1463 2130 1466 2130 1468 2130 1494 2119 1522 2130 1524 2130 1526 2130 1717 2119 1866 2130 1868 2130 1871 2130 1916 2119 1968 2132 1970 2132 1972 2132 2505 2119 2507 2108 2507 2078 2460 2065 2458 2065 2455 2065 2453 2065 2421 2076 2403 2065 2401 2065 2399 2065 2397 2065 2395 2065 2351 2076 2224 2065 2221 2065 2031 2076 1966 2065 1964 2065 1962 2065 1918 2076 1814 2063 1812 2063 1741 2074 1648 2063 1645 2063 1589 2074 1567 2063 1565 2063 1563 2063 1502 2074 1396 2063 1394 2063 1392 2063 1366 2074 1206 2061 1204 2061 1201 2061 1175 2071 740 2065 740 2102"/>
                        </Shape>
                        <String CONTENT="This would never happen in a Maritime village. Many travellers of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l26" HPOS="736" VPOS="2128" WIDTH="1767" HEIGHT="58" BASELINE="738 2162 2503 2169" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="738 2162 736 2177 2499 2186 2503 2169 2501 2136 738 2128 738 2162"/>
                        </Shape>
                        <String CONTENT="Reindeer tribe are themselves averse to entering strange houses at such times,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l27" HPOS="734" VPOS="2190" WIDTH="1769" HEIGHT="59" BASELINE="736 2223 2503 2229" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2223 734 2236 773 2249 775 2249 777 2249 2501 2247 2503 2229 2501 2197 736 2190 736 2223"/>
                        </Shape>
                        <String CONTENT="and prefer to sleep in the open, content with an incantation against the spirits,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l28" HPOS="731" VPOS="2249" WIDTH="1774" HEIGHT="61" BASELINE="734 2284 2505 2288" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="734 2284 731 2297 855 2310 857 2310 2503 2301 2505 2288 2503 2258 734 2249 734 2284"/>
                        </Shape>
                        <String CONTENT="in lieu of supper. Even at ordinary times a guest arriving at the camp is"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l29" HPOS="734" VPOS="2314" WIDTH="1771" HEIGHT="50" BASELINE="734 2346 2505 2346" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="734 2346 734 2364 2505 2364 2505 2346 2503 2314 734 2314 734 2346"/>
                        </Shape>
                        <String CONTENT="considered as having no more rights than the inmates of the house. He will"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l30" HPOS="731" VPOS="2362" WIDTH="1772" HEIGHT="69" BASELINE="734 2403 2503 2407" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="734 2403 731 2416 1095 2429 1097 2429 1598 2420 1615 2431 1617 2431 1619 2431 1622 2431 2501 2420 2503 2407 2501 2377 2427 2364 2425 2364 2362 2375 2347 2364 2345 2364 2343 2364 2341 2364 2338 2364 2306 2375 2245 2364 2243 2364 2241 2364 2204 2375 2128 2364 2126 2364 2070 2375 1983 2364 1981 2364 1979 2364 1942 2375 1726 2364 1723 2364 1619 2375 1544 2362 1541 2362 1487 2372 1422 2362 1420 2362 1418 2362 1388 2372 1349 2362 1347 2362 1344 2362 1264 2372 1210 2362 1208 2362 1106 2372 1030 2362 1028 2362 955 2372 734 2368 734 2403"/>
                        </Shape>
                        <String CONTENT="have to wait outside with the other people till evening, when the sleeping-"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l31" HPOS="736" VPOS="2431" WIDTH="1773" HEIGHT="50" BASELINE="736 2465 2509 2465" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2465 736 2481 2509 2481 2509 2465 2507 2431 736 2433 736 2465"/>
                        </Shape>
                        <String CONTENT="room is made ready. Sometimes he will be given no food until the time of"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l32" HPOS="734" VPOS="2489" WIDTH="1773" HEIGHT="57" BASELINE="736 2522 2507 2528" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2522 734 2537 747 2546 749 2546 751 2546 753 2546 2505 2539 2507 2528 2505 2496 736 2489 736 2522"/>
                        </Shape>
                        <String CONTENT="the principal meal, which is eaten in the evening. At the time of the great"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l33" HPOS="734" VPOS="2550" WIDTH="1769" HEIGHT="58" BASELINE="736 2580 2503 2587" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2580 734 2593 792 2606 794 2606 1240 2598 1327 2608 1329 2608 2501 2600 2503 2587 2501 2556 736 2550 736 2580"/>
                        </Shape>
                        <String CONTENT="reindeer races, scores of people come to take part in the races or to look on."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l34" HPOS="734" VPOS="2608" WIDTH="1769" HEIGHT="59" BASELINE="736 2639 2503 2645" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2639 734 2654 913 2667 916 2667 2501 2665 2503 2645 2501 2615 736 2608 736 2639"/>
                        </Shape>
                        <String CONTENT="Often they are given no food at all, and, after a whole day spent in the open,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l35" HPOS="731" VPOS="2667" WIDTH="1778" HEIGHT="56" BASELINE="734 2697 2509 2706" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="734 2697 731 2714 2505 2723 2509 2706 2507 2675 734 2667 734 2697"/>
                        </Shape>
                        <String CONTENT="return in the evening to their respective camps, scattered around at a distance"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l36" HPOS="736" VPOS="2721" WIDTH="682" HEIGHT="67" BASELINE="736 2762 1418 2762" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="736 2762 736 2775 1033 2788 1035 2788 1037 2788 1071 2777 1106 2788 1108 2788 1110 2788 1113 2788 1139 2777 1232 2788 1234 2788 1418 2777 1418 2762 1418 2734 1357 2721 1355 2721 1071 2732 965 2721 963 2721 961 2721 959 2721 944 2734 809 2734 779 2721 777 2721 775 2721 773 2721 736 2732 736 2762"/>
                        </Shape>
                        <String CONTENT="of some thirty or forty miles."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-070_r5" HPOS="737" VPOS="2783" WIDTH="1778" HEIGHT="490" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="737 2783 2515 2783 2515 3273 737 3273"/>
                    </Shape>
                    <TextLine ID="mz_1-070_l37" HPOS="844" VPOS="2784" WIDTH="1665" HEIGHT="65" BASELINE="846 2820 2509 2827" TAGREFS="TYPE_3">
