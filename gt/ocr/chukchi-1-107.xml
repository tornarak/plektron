                        <Shape>
                            <Polygon POINTS="368 1489 368 1506 2139 1506 2139 1489 2139 1461 368 1457 368 1489"/>
                        </Shape>
                        <String CONTENT="be a barren doe, fit to use for the harness.¹ Breeding-bucks are best at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l16" HPOS="368" VPOS="1519" WIDTH="1771" HEIGHT="48" BASELINE="368 1550 2139 1550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1550 368 1567 2139 1567 2139 1550 2139 1519 368 1519 368 1550"/>
                        </Shape>
