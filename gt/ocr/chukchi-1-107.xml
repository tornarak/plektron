                    </TextLine>

                    <TextLine ID="mz_1-107_l11" HPOS="368" VPOS="1216" WIDTH="1769" HEIGHT="52" BASELINE="368 1251 2137 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1251 368 1268 2137 1268 2137 1251 2137 1221 368 1216 368 1251"/>
                        </Shape>
