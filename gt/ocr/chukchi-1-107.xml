                <TextBlock ID="text_1-107" HPOS="342" VPOS="608" WIDTH="1778" HEIGHT="2635"><TextLine ID="mz_1-107_l1" HPOS="923" VPOS="608" WIDTH="621" HEIGHT="56" BASELINE="925 643 1544 647" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1533 610 925 608 925 643 923 660 1540 664 1544 647 1542 623 1533 610"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l2" HPOS="2060" VPOS="619" WIDTH="21" HEIGHT="60" BASELINE="2060 658 2081 658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2060 619 2060 658 2062 679 2081 669 2081 658 2081 625 2060 619"/>
                        </Shape>
                        <String CONTENT="79"/>
                    </TextLine>
<TextLine ID="mz_1-107_l3" HPOS="342" VPOS="710" WIDTH="1774" HEIGHT="65" BASELINE="344 757 2116 753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 718 344 718 342 721 344 757 344 770 2112 775 2116 753 2114 723 2077 710 2075 710 2073 710 2071 710 2042 721 2008 710 2006 710 2003 710 2001 710 1977 723 1733 723 1705 710 1702 710 1700 710 1592 721 1468 710 1466 710 1386 721 1330 710 1328 710 1271 721 1241 710 1239 710 1237 710 1146 723 518 712 516 712 513 712 511 712 496 725 401 725 377 716 364 718"/>
                        </Shape>
                        <String CONTENT="fawn. Even twins are often born dead. One of living twins, or even both,"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l4" HPOS="344" VPOS="779" WIDTH="1776" HEIGHT="52" BASELINE="347 812 2120 816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 812 344 827 2116 831 2120 816 2118 779 347 779 347 812"/>
                        </Shape>
                        <String CONTENT="are often killed by the Chukchee because they are afraid of anything unusual"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l5" HPOS="347" VPOS="842" WIDTH="1771" HEIGHT="50" BASELINE="349 876 2118 870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 876 349 892 2116 885 2118 870 2114 842 347 842 349 876"/>
                        </Shape>
                        <String CONTENT="in connection with their herd. Some of the breeders, however, value twins"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l6" HPOS="344" VPOS="892" WIDTH="1774" HEIGHT="60" BASELINE="347 937 2118 933" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 937 347 952 2116 948 2118 933 2116 905 2066 892 2064 892 2062 892 2060 892 2029 902 1962 892 1960 892 1891 902 1860 892 1858 892 1856 892 1854 892 1832 902 1737 892 1735 892 1733 892 1687 905 1503 905 1471 892 1468 892 1466 892 1332 902 1250 892 1248 892 1245 892 1243 892 1224 905 910 894 908 894 856 905 784 894 782 894 780 894 741 905 678 894 676 894 344 900 347 937"/>
                        </Shape>
                        <String CONTENT="highly, asserting that when grown up they will be very swift, and will make"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l7" HPOS="344" VPOS="950" WIDTH="1772" HEIGHT="67" BASELINE="347 996 2116 991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 996 347 1017 2114 1015 2116 991 2114 961 2094 950 2092 950 2090 950 2088 950 2086 950 2060 961 1943 950 1941 950 1938 950 1915 961 1893 950 1891 950 1889 950 1800 961 1774 950 1772 950 1769 950 1674 961 1646 950 1644 950 1642 950 1640 950 1637 950 1622 963 1503 963 1466 950 1464 950 1462 950 1358 961 1269 950 1267 950 1206 963 1174 952 1172 952 1170 952 1167 952 1120 963 682 952 680 952 600 963 561 952 559 952 557 952 481 963 448 952 446 952 444 952 344 965 347 996"/>
                        </Shape>
                        <String CONTENT="good racing-reindeer. Therefore when living twins are born into their herd,"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l8" HPOS="344" VPOS="1011" WIDTH="1774" HEIGHT="58" BASELINE="347 1056 2118 1052" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1056 347 1069 2116 1067 2118 1052 2112 1019 1923 1022 1895 1011 1893 1011 1891 1011 1889 1011 1886 1011 1873 1022 1847 1011 1845 1011 1843 1011 1841 1011 1804 1022 1774 1011 1772 1011 1769 1011 1767 1011 1765 1011 1750 1024 1607 1024 1501 1011 1499 1011 1497 1011 1464 1022 1380 1011 1378 1011 1319 1022 1241 1011 1239 1011 1237 1011 1235 1011 1219 1024 1025 1013 1022 1013 951 1024 916 1013 914 1013 912 1013 849 1024 795 1013 793 1013 678 1024 615 1013 613 1013 611 1013 578 1024 479 1013 477 1013 474 1013 453 1024 366 1013 364 1013 362 1013 360 1013 344 1022 347 1056"/>
                        </Shape>
                        <String CONTENT="they look for another doe that has just given birth to a dead fawn, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l9" HPOS="344" VPOS="1069" WIDTH="1774" HEIGHT="63" BASELINE="347 1117 2118 1110" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1117 347 1132 2116 1125 2118 1110 2114 1082 1681 1069 1679 1069 1676 1069 1653 1080 1471 1071 1468 1071 1401 1082 1373 1071 1371 1071 1369 1071 1306 1082 1248 1071 1245 1071 1243 1071 1217 1082 1159 1071 1157 1071 1087 1082 964 1071 962 1071 960 1071 957 1071 942 1082 836 1073 834 1073 832 1073 808 1086 542 1086 446 1073 444 1073 344 1086 347 1117"/>
                        </Shape>
                        <String CONTENT="carefully wrap one of the living twins into the placenta of the dead fawn to"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l10" HPOS="344" VPOS="1132" WIDTH="1772" HEIGHT="58" BASELINE="347 1177 2116 1173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1177 347 1190 2114 1186 2116 1173 2112 1143 1230 1132 1228 1132 1226 1132 1204 1143 418 1134 416 1134 344 1145 347 1177"/>
                        </Shape>
                        <String CONTENT="make the dam raise it as its own. Of course, this is feasible only in large"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l11" HPOS="347" VPOS="1201" WIDTH="1769" HEIGHT="52" BASELINE="347 1236 2116 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1236 347 1253 2116 1253 2116 1236 2116 1206 347 1201 347 1236"/>
                        </Shape>
                        <String CONTENT="herds, where in calving-time there are daily about twenty or thirty fawns born."/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l12" HPOS="347" VPOS="1262" WIDTH="1771" HEIGHT="50" BASELINE="347 1294 2118 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1294 347 1312 2118 1312 2118 1294 2118 1264 347 1262 347 1294"/>
                        </Shape>
                        <String CONTENT="If a suitable reindeer-dam is wanting, they will sometimes kill some new-born"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l13" HPOS="347" VPOS="1325" WIDTH="1769" HEIGHT="47" BASELINE="347 1355 2116 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1355 347 1372 2116 1372 2116 1355 2116 1325 347 1325 347 1355"/>
                        </Shape>
                        <String CONTENT="fawn and put one of the twins in its place. If they prefer to kill one of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l14" HPOS="344" VPOS="1374" WIDTH="1774" HEIGHT="59" BASELINE="347 1416 2118 1411" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1416 347 1433 2116 1429 2118 1411 2114 1383 403 1374 401 1374 344 1385 347 1416"/>
                        </Shape>
                        <String CONTENT="twins, they keep a female one, because they believe that it will grow up to"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l15" HPOS="347" VPOS="1442" WIDTH="1771" HEIGHT="49" BASELINE="347 1474 2118 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1474 347 1491 2118 1491 2118 1474 2118 1446 347 1442 347 1474"/>
                        </Shape>
                        <String CONTENT="be a barren doe, fit to use for the harness.¹ Breeding-bucks are best at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l16" HPOS="347" VPOS="1504" WIDTH="1771" HEIGHT="48" BASELINE="347 1535 2118 1535" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1535 347 1552 2118 1552 2118 1535 2118 1504 347 1504 347 1535"/>
                        </Shape>
                        <String CONTENT="age of three and four years; later on, their value decreases, although the bulk"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l17" HPOS="344" VPOS="1554" WIDTH="1772" HEIGHT="56" BASELINE="347 1593 2116 1589" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1593 347 1610 2114 1606 2116 1589 2112 1563 386 1554 383 1554 381 1554 344 1565 347 1593"/>
                        </Shape>
                        <String CONTENT="of the body and the dimension of the antlers continue to increase until the"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l18" HPOS="344" VPOS="1610" WIDTH="1391" HEIGHT="59" BASELINE="347 1654 1735 1649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1654 347 1669 1733 1665 1735 1649 1731 1610 1040 1610 1038 1610 1035 1610 1033 1610 1033 1613 1022 1621 362 1613 360 1613 357 1613 355 1613 344 1619 347 1654"/>
                        </Shape>
                        <String CONTENT="fifth or sixth year. The doe breeds to the end of her life.²"/>
                    </TextLine>
<TextLine ID="mz_1-107_l19" HPOS="451" VPOS="1671" WIDTH="1667" HEIGHT="61" BASELINE="453 1717 2118 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="453 1717 453 1732 2116 1727 2118 1712 2114 1684 2021 1671 2019 1671 2016 1671 2014 1671 1999 1684 1912 1684 1886 1671 1884 1671 1882 1671 1811 1682 1765 1671 1763 1671 1761 1671 1705 1682 1657 1671 1655 1671 1653 1671 1650 1671 1648 1671 1635 1682 1577 1671 1575 1671 1507 1682 1471 1671 1468 1671 1466 1671 1464 1671 1462 1671 1445 1684 1330 1684 1297 1671 1295 1671 1293 1671 1217 1684 925 1673 923 1673 921 1673 879 1684 849 1673 847 1673 845 1673 843 1673 810 1684 734 1673 732 1673 451 1682 453 1717"/>
                        </Shape>
                        <String CONTENT="The Chukchee herdsmen are careful to select for breeding those does"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l20" HPOS="344" VPOS="1745" WIDTH="1772" HEIGHT="47" BASELINE="344 1775 2116 1775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1775 344 1792 2116 1792 2116 1775 2116 1745 344 1745 344 1775"/>
                        </Shape>
                        <String CONTENT="that bear the strongest fawns. Those whose fawns have died for several years"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l21" HPOS="342" VPOS="1790" WIDTH="1776" HEIGHT="63" BASELINE="344 1838 2118 1831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1838 344 1853 2116 1846 2118 1831 2114 1803 1975 1803 1951 1790 1949 1790 1947 1790 1828 1801 1772 1790 1769 1790 1767 1790 1722 1801 1692 1790 1689 1790 1687 1790 1685 1790 1646 1801 1583 1790 1581 1790 1579 1790 1577 1790 1562 1801 1438 1792 1436 1792 1434 1792 1410 1803 905 1794 903 1794 901 1794 899 1794 888 1805 875 1794 873 1794 871 1794 869 1794 394 1805 357 1794 355 1794 353 1794 351 1794 349 1794 349 1797 342 1801 344 1838"/>
                        </Shape>
                        <String CONTENT="in succession are killed first, when meat is required. The herdsman observes"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l22" HPOS="342" VPOS="1849" WIDTH="1774" HEIGHT="67" BASELINE="344 1898 2116 1890" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1898 344 1916 2114 1907 2116 1890 2114 1862 2073 1849 2071 1849 2068 1849 1982 1859 1964 1849 1962 1849 1960 1849 1958 1849 1956 1849 1954 1849 1934 1862 1720 1862 1696 1849 1694 1849 1692 1849 1689 1849 1687 1849 1666 1862 1492 1851 1490 1851 1488 1851 1453 1862 1427 1851 1425 1851 1423 1851 1347 1862 1300 1851 1297 1851 1295 1851 1293 1851 1258 1862 1232 1851 1230 1851 1228 1851 1226 1851 1196 1864 1161 1853 1159 1853 1157 1853 1154 1853 1118 1864 1050 1853 1048 1853 944 1864 910 1853 908 1853 905 1853 847 1864 817 1853 814 1853 812 1853 635 1855 633 1855 630 1855 615 1866 368 1855 366 1855 364 1855 362 1855 342 1864 344 1898"/>
                        </Shape>
                        <String CONTENT="the lineage (yɪčhɪˊyɪkwɪn) of his animals through three or four generations in"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l23" HPOS="344" VPOS="1911" WIDTH="748" HEIGHT="63" BASELINE="347 1957 1092 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1957 347 1974 1089 1970 1092 1952 1087 1924 873 1911 871 1911 797 1922 773 1911 771 1911 769 1911 767 1911 765 1911 765 1914 754 1922 659 1914 656 1914 607 1924 583 1914 581 1914 578 1914 509 1924 472 1914 470 1914 468 1914 466 1914 433 1924 396 1914 394 1914 392 1914 390 1914 344 1927 347 1957"/>
                        </Shape>
                        <String CONTENT="selecting the best breeding-does."/>
                    </TextLine>
<TextLine ID="mz_1-107_l24" HPOS="448" VPOS="1970" WIDTH="1668" HEIGHT="65" BASELINE="451 2020 2116 2011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 2020 451 2035 2114 2026 2116 2011 2109 1978 1793 1981 1763 1970 1761 1970 1759 1970 1756 1970 1731 1983 1499 1983 1462 1972 1460 1972 1458 1972 1388 1983 1336 1972 1334 1972 1332 1972 1330 1972 1315 1985 1085 1985 1033 1974 1031 1974 1029 1974 1027 1974 1009 1985 886 1974 884 1974 672 1987 656 1976 654 1976 652 1976 470 1976 468 1976 466 1976 464 1976 448 1985 451 2020"/>
                        </Shape>
                        <String CONTENT="Although the Chukchee have a very imperfect system of numerals, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l25" HPOS="342" VPOS="2035" WIDTH="1776" HEIGHT="60" BASELINE="344 2080 2118 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2080 344 2095 2118 2087 2118 2074 2114 2043 955 2035 953 2035 869 2046 498 2037 496 2037 342 2048 344 2080"/>
                        </Shape>
                        <String CONTENT="never know the exact number of animals in their herd, still they keep a strict"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l26" HPOS="342" VPOS="2091" WIDTH="1772" HEIGHT="67" BASELINE="344 2141 2114 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2141 344 2158 2112 2150 2114 2134 2109 2102 1523 2091 1520 2091 1518 2091 1490 2102 1012 2093 1009 2093 921 2104 509 2095 507 2095 342 2106 344 2141"/>
                        </Shape>
                        <String CONTENT="proportion between its integral parts. Fertile does always form a large majority."/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l27" HPOS="349" VPOS="2152" WIDTH="1767" HEIGHT="60" BASELINE="351 2197 2116 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 2197 351 2212 2114 2208 2116 2193 2114 2162 2094 2152 2092 2152 2090 2152 2088 2152 1984 2162 1897 2152 1895 2152 1843 2165 1614 2165 1588 2152 1585 2152 1583 2152 1525 2162 1468 2152 1466 2152 1464 2152 1436 2162 1330 2152 1328 2152 1228 2165 1131 2154 1128 2154 1126 2154 1096 2165 990 2154 988 2154 986 2154 955 2165 910 2154 908 2154 905 2154 849 2165 745 2154 743 2154 741 2154 708 2165 672 2154 669 2154 667 2154 665 2154 637 2165 349 2162 351 2197"/>
                        </Shape>
                        <String CONTENT="The largest bucks, aside from those used for breeding, are usually gelded."/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l28" HPOS="344" VPOS="2212" WIDTH="1772" HEIGHT="61" BASELINE="347 2258 2116 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2258 347 2273 2114 2266 2116 2251 2112 2223 1525 2212 1523 2212 1520 2212 1486 2223 983 2214 981 2214 344 2225 347 2258"/>
                        </Shape>
                        <String CONTENT="Such geldings and a few barren does are allowed to fatten. The harness-"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l29" HPOS="344" VPOS="2275" WIDTH="1772" HEIGHT="61" BASELINE="347 2318 2116 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2318 347 2336 2114 2327 2116 2310 2112 2282 821 2275 819 2275 817 2275 775 2286 394 2277 392 2277 390 2277 344 2288 347 2318"/>
                        </Shape>
                        <String CONTENT="reindeer are also geldings, with the exception of a few large barren females"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l30" HPOS="347" VPOS="2336" WIDTH="1769" HEIGHT="67" BASELINE="349 2377 2116 2370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 2377 349 2392 563 2403 565 2403 568 2403 596 2392 1126 2401 1128 2401 1131 2401 1133 2401 1148 2390 1237 2390 1306 2401 1308 2401 1310 2401 1332 2390 1373 2401 1375 2401 1378 2401 1564 2388 1798 2388 1817 2398 1819 2398 1821 2398 1824 2398 2114 2388 2116 2370 2112 2342 390 2336 388 2336 386 2336 347 2347 349 2377"/>
                        </Shape>
                        <String CONTENT="with large antlers. The majority of the bucks are killed for their skins in"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l31" HPOS="344" VPOS="2396" WIDTH="1772" HEIGHT="57" BASELINE="347 2437 2116 2431" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2437 347 2453 2114 2446 2116 2431 2112 2403 364 2396 362 2396 360 2396 357 2396 344 2403 347 2437"/>
                        </Shape>
                        <String CONTENT="the first fall of their lives. On an average, there are in a herd, to every"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l32" HPOS="344" VPOS="2450" WIDTH="1772" HEIGHT="65" BASELINE="347 2496 2116 2489" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2496 347 2515 2114 2509 2116 2489 2112 2461 1570 2450 1568 2450 1512 2463 344 2463 347 2496"/>
                        </Shape>
                        <String CONTENT="hundred breeding-does, about a dozen breeding-bucks, from ten to fifteen sledge-"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l33" HPOS="342" VPOS="2515" WIDTH="1774" HEIGHT="59" BASELINE="344 2557 2116 2550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2557 344 2574 2114 2567 2116 2550 2112 2522 394 2515 392 2515 342 2526 344 2557"/>
                        </Shape>
                        <String CONTENT="reindeer, and from sixty to seventy half-grown fawns. In a large herd (Plate"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l34" HPOS="342" VPOS="2570" WIDTH="1774" HEIGHT="67" BASELINE="344 2619 2116 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2619 344 2637 2114 2637 2116 2611 2112 2583 2053 2570 2051 2570 2049 2570 2025 2580 1876 2570 1873 2570 1800 2580 1776 2570 1774 2570 1772 2570 1769 2570 1748 2580 1676 2570 1674 2570 1672 2570 1627 2583 1271 2572 1269 2572 1267 2572 1228 2583 1109 2574 1107 2574 1105 2574 1102 2574 1083 2587 949 2587 892 2574 890 2574 771 2587 433 2576 431 2576 342 2589 344 2619"/>
                        </Shape>
                        <String CONTENT="IV, Fig. 1) there may be to a thousand breeding-does thirty breeding-bucks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l35" HPOS="342" VPOS="2630" WIDTH="1774" HEIGHT="63" BASELINE="344 2676 2116 2669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2676 344 2693 2114 2686 2116 2669 2112 2641 1525 2630 1523 2630 1520 2630 1518 2630 1505 2641 949 2632 947 2632 944 2632 912 2643 377 2634 375 2634 373 2634 342 2645 344 2676"/>
                        </Shape>
                        <String CONTENT="eighty sledge-reindeer, and from three hundred to four hundred fawns. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l36" HPOS="342" VPOS="2695" WIDTH="1774" HEIGHT="59" BASELINE="344 2738 2116 2730" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2738 344 2754 2114 2747 2116 2730 2112 2702 801 2695 799 2695 342 2708 344 2738"/>
                        </Shape>
                        <String CONTENT="number of fattened bucks varies from a very few to about as many as there"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l37" HPOS="344" VPOS="2754" WIDTH="1772" HEIGHT="60" BASELINE="344 2797 2116 2797" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2797 344 2812 2114 2814 2116 2797 2116 2764 2094 2754 2092 2754 2090 2754 1962 2764 1917 2754 1915 2754 1912 2754 1640 2764 1603 2754 1601 2754 1598 2754 1596 2754 1562 2764 1386 2754 1384 2754 1297 2764 1252 2754 1250 2754 1248 2754 1245 2754 1243 2754 1228 2764 1176 2754 1174 2754 1079 2764 1046 2754 1044 2754 1042 2754 1040 2754 1038 2754 1020 2767 875 2767 812 2754 810 2754 808 2754 806 2754 791 2767 700 2767 667 2754 665 2754 663 2754 609 2764 563 2754 561 2754 559 2754 483 2764 461 2754 459 2754 457 2754 344 2764 344 2797"/>
                        </Shape>
                        <String CONTENT="are breeding-does. However, large bucks and barren does are highly prized,"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l38" HPOS="342" VPOS="2810" WIDTH="1776" HEIGHT="65" BASELINE="344 2860 2118 2851" TAGREFS="TYPE_5">
