                        </Shape>
                        <String CONTENT="they look for another doe that has just given birth to a dead fawn, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l9" HPOS="365" VPOS="1084" WIDTH="1774" HEIGHT="63" BASELINE="368 1132 2139 1125" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1132 368 1147 2137 1140 2139 1125 2135 1097 1702 1084 1700 1084 1697 1084 1674 1095 1492 1086 1489 1086 1422 1097 1394 1086 1392 1086 1390 1086 1327 1097 1269 1086 1266 1086 1264 1086 1238 1097 1180 1086 1178 1086 1108 1097 985 1086 983 1086 981 1086 978 1086 963 1097 857 1088 855 1088 853 1088 829 1101 563 1101 467 1088 465 1088 365 1101 368 1132"/>
                        </Shape>
                        <String CONTENT="carefully wrap one of the living twins into the placenta of the dead fawn to"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l10" HPOS="365" VPOS="1147" WIDTH="1772" HEIGHT="58" BASELINE="368 1192 2137 1188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1192 368 1205 2135 1201 2137 1188 2133 1158 1251 1147 1249 1147 1247 1147 1225 1158 439 1149 437 1149 365 1160 368 1192"/>
                        </Shape>
