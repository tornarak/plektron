                    </TextLine>

                    <TextLine ID="mz_1-107_l5" HPOS="368" VPOS="857" WIDTH="1771" HEIGHT="50" BASELINE="370 891 2139 885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 891 370 907 2137 900 2139 885 2135 857 368 857 370 891"/>
                        </Shape>
                        <String CONTENT="in connection with their herd. Some of the breeders, however, value twins"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l6" HPOS="365" VPOS="907" WIDTH="1774" HEIGHT="60" BASELINE="368 952 2139 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 952 368 967 2137 963 2139 948 2137 920 2087 907 2085 907 2083 907 2081 907 2050 917 1983 907 1981 907 1912 917 1881 907 1879 907 1877 907 1875 907 1853 917 1758 907 1756 907 1754 907 1708 920 1524 920 1492 907 1489 907 1487 907 1353 917 1271 907 1269 907 1266 907 1264 907 1245 920 931 909 929 909 877 920 805 909 803 909 801 909 762 920 699 909 697 909 365 915 368 952"/>
                        </Shape>
                        <String CONTENT="highly, asserting that when grown up they will be very swift, and will make"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l7" HPOS="365" VPOS="965" WIDTH="1772" HEIGHT="67" BASELINE="368 1011 2137 1006" TAGREFS="TYPE_5">
