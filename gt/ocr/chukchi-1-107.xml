                        </Shape>
                        <String CONTENT="with large antlers. The majority of the bucks are killed for their skins in"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l31" HPOS="365" VPOS="2411" WIDTH="1772" HEIGHT="57" BASELINE="368 2452 2137 2446" TAGREFS="TYPE_5">
