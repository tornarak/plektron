                        </Shape>
                        <String CONTENT="fawn. Even twins are often born dead. One of living twins, or even both,"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l4" HPOS="365" VPOS="794" WIDTH="1776" HEIGHT="52" BASELINE="368 827 2141 831" TAGREFS="TYPE_5">
