                    </TextLine>

                    <TextLine ID="mz_1-107_l12" HPOS="368" VPOS="1277" WIDTH="1771" HEIGHT="50" BASELINE="368 1309 2139 1309" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1309 368 1327 2139 1327 2139 1309 2139 1279 368 1277 368 1309"/>
                        </Shape>
                        <String CONTENT="If a suitable reindeer-dam is wanting, they will sometimes kill some new-born"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l13" HPOS="368" VPOS="1340" WIDTH="1769" HEIGHT="47" BASELINE="368 1370 2137 1370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1370 368 1387 2137 1387 2137 1370 2137 1340 368 1340 368 1370"/>
                        </Shape>
                        <String CONTENT="fawn and put one of the twins in its place. If they prefer to kill one of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-107_l14" HPOS="365" VPOS="1389" WIDTH="1774" HEIGHT="59" BASELINE="368 1431 2139 1426" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1431 368 1448 2137 1444 2139 1426 2135 1398 424 1389 422 1389 365 1400 368 1431"/>
                        </Shape>
                        <String CONTENT="twins, they keep a female one, because they believe that it will grow up to"/>
                    </TextLine>

