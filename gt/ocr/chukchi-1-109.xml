                    <TextLine ID="mz_1-109_l3" HPOS="411" VPOS="725" WIDTH="1778" HEIGHT="60" BASELINE="413 770 2189 766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="660 727 526 738 502 731 498 731 476 731 454 733 450 733 411 740 413 770 413 785 2187 785 2189 766 2187 738 2141 725 2139 725 2137 725 2074 736 2005 725 2003 725 1892 736 1866 725 1864 725 1862 725 1752 736 1665 725 1663 725 1661 725 1630 736 1578 725 1576 725 1574 725 1544 736 1500 725 1498 725 1496 725 1414 736 1377 725 1375 725 1373 725 1284 738 1253 727 1251 727 1249 727 1188 738 905 727 903 727 840 738 777 727 775 727 773 727 740 738 662 727 660 727"/>
                        </Shape>
                        <String CONTENT="scab covering the whole skin, and causing all the hair to drop off. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l4" HPOS="413" VPOS="798" WIDTH="1778" HEIGHT="48" BASELINE="413 829 2191 829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 829 413 846 2191 846 2191 829 2191 798 413 798 413 829"/>
                        </Shape>
                        <String CONTENT="disease is said to proceed from a very small insect that burrows through the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l5" HPOS="411" VPOS="846" WIDTH="1778" HEIGHT="61" BASELINE="413 891 2189 887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 891 413 907 2187 904 2189 887 2187 859 2161 846 2159 846 2156 846 2154 846 2133 857 1680 846 1678 846 1606 857 1570 846 1567 846 1565 846 1437 857 1308 846 1305 846 1303 846 1301 846 1286 859 1236 848 1234 848 1180 859 1119 848 1117 848 744 859 615 848 612 848 513 859 439 848 437 848 435 848 411 859 413 891"/>
                        </Shape>
                        <String CONTENT="skin, probably a species of tick. Dr. Slunin mentions having seen it, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l6" HPOS="415" VPOS="913" WIDTH="1776" HEIGHT="52" BASELINE="415 950 2191 950" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 950 415 965 2191 965 2191 950 2191 917 415 913 415 950"/>
                        </Shape>
                        <String CONTENT="he does not give the name of the species. It develops in mid-winter, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l7" HPOS="413" VPOS="974" WIDTH="1776" HEIGHT="50" BASELINE="415 1006 2189 1011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1006 413 1019 2185 1024 2189 1011 2187 974 415 974 415 1006"/>
                        </Shape>
                        <String CONTENT="the reindeer die of cold and exhaustion. This disease is also catching; and"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l8" HPOS="411" VPOS="1028" WIDTH="1780" HEIGHT="58" BASELINE="413 1071 2191 1067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1071 413 1086 2189 1082 2191 1067 2187 1037 472 1028 469 1028 411 1039 413 1071"/>
                        </Shape>
                        <String CONTENT="a herd, once infected, will generally be exterminated. Sometimes the disease"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l9" HPOS="413" VPOS="1093" WIDTH="1776" HEIGHT="60" BASELINE="415 1123 2189 1130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1123 413 1138 1028 1153 1030 1153 2187 1145 2189 1130 2187 1099 415 1093 415 1123"/>
                        </Shape>
                        <String CONTENT="will last for several years, disappear for a while, and then break out with"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l10" HPOS="411" VPOS="1145" WIDTH="1778" HEIGHT="58" BASELINE="413 1186 2189 1190" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1186 411 1199 2185 1203 2189 1190 2187 1160 2070 1147 2068 1147 1953 1158 1888 1147 1743 1147 1741 1147 1739 1147 1736 1147 1723 1158 1669 1147 1667 1147 1665 1147 1639 1158 1524 1147 1522 1147 1520 1147 1489 1158 1407 1147 1405 1147 1026 1156 1011 1145 1009 1145 1007 1145 1004 1145 1002 1145 972 1156 894 1145 892 1145 801 1156 675 1145 673 1145 671 1145 634 1156 602 1145 599 1145 597 1145 413 1153 413 1186"/>
                        </Shape>
                        <String CONTENT="renewed vigor. “When it assumes a violent form, the Chukchee herdsmen"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l11" HPOS="417" VPOS="1218" WIDTH="1772" HEIGHT="48" BASELINE="417 1249 2189 1249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1249 417 1266 2189 1266 2189 1249 2189 1218 417 1218 417 1249"/>
                        </Shape>
                        <String CONTENT="often leave the whole herd, house and everything in it, even stripping them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l12" HPOS="413" VPOS="1279" WIDTH="1776" HEIGHT="45" BASELINE="413 1307 2189 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1307 413 1324 2189 1324 2189 1307 2189 1279 413 1279 413 1307"/>
                        </Shape>
                        <String CONTENT="selves to the last fur shirt, as a sacrifice to the spirit of the disease. Some-"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l13" HPOS="415" VPOS="1335" WIDTH="1774" HEIGHT="59" BASELINE="417 1366 2189 1370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1366 415 1383 428 1392 430 1392 433 1392 435 1392 1225 1383 1305 1394 1308 1394 2187 1383 2189 1370 2187 1340 417 1335 417 1366"/>
                        </Shape>
                        <String CONTENT="times they kill all their animals, and pile them together around the tent."/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l14" HPOS="417" VPOS="1398" WIDTH="1772" HEIGHT="52" BASELINE="417 1431 2189 1431" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1431 417 1446 2187 1450 2189 1431 2189 1398 417 1398 417 1431"/>
                        </Shape>
                        <String CONTENT="According to data contained in the archives of Nishne-Kolymsk, in the spring"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l15" HPOS="415" VPOS="1444" WIDTH="1774" HEIGHT="62" BASELINE="417 1489 2189 1485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1489 417 1506 2187 1502 2189 1485 2185 1454 1303 1444 1301 1444 1299 1444 1262 1454 456 1446 454 1446 452 1446 415 1457 417 1489"/>
                        </Shape>
                        <String CONTENT="of 1872 a Chukchee reindeer-breeder, Tɪñeiˊmɪt, brought his whole herd, stricken"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l16" HPOS="413" VPOS="1506" WIDTH="1776" HEIGHT="59" BASELINE="415 1550 2189 1545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1550 415 1565 2187 1565 2189 1545 2185 1517 1338 1506 1336 1506 1258 1517 454 1509 452 1509 450 1509 413 1519 415 1550"/>
                        </Shape>
                        <String CONTENT="with scabies and about three thousand head strong, to that town to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l17" HPOS="413" VPOS="1563" WIDTH="1776" HEIGHT="69" BASELINE="415 1606 2189 1610" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1606 413 1619 450 1632 452 1632 454 1632 2187 1628 2189 1610 2187 1578 2109 1565 2107 1565 2027 1576 1821 1565 1819 1565 1816 1565 1814 1565 1799 1578 1708 1578 1663 1565 1661 1565 1658 1565 1570 1576 1539 1565 1537 1565 1535 1565 1533 1565 1492 1576 1399 1565 1396 1565 1316 1576 1282 1563 1279 1563 1277 1563 1275 1563 1251 1573 1230 1563 1227 1563 1225 1563 1223 1563 1178 1573 1156 1563 1154 1563 1152 1563 1149 1563 1113 1573 978 1563 976 1563 918 1573 903 1563 900 1563 898 1563 896 1563 840 1573 781 1563 779 1563 725 1573 664 1563 662 1563 660 1563 658 1563 643 1573 547 1563 545 1563 415 1571 415 1606"/>
                        </Shape>
                        <String CONTENT="slaughtered. The inhabitants of all the neighboring villages flocked together,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l18" HPOS="415" VPOS="1625" WIDTH="1776" HEIGHT="59" BASELINE="415 1669 2191 1669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1669 415 1684 2191 1684 2191 1669 2191 1638 2139 1625 2137 1625 2135 1625 2111 1636 2085 1625 2083 1625 2081 1625 2079 1625 2037 1636 1814 1625 1812 1625 1700 1636 1639 1625 1637 1625 1635 1625 1632 1625 1617 1638 1522 1638 1492 1625 1489 1625 1487 1625 1403 1636 1355 1625 1353 1625 1351 1625 1349 1625 1308 1636 1275 1625 1273 1625 1271 1625 1195 1636 1160 1625 1158 1625 1156 1625 1154 1625 1152 1625 1134 1638 961 1638 844 1625 842 1625 783 1636 749 1625 747 1625 744 1625 693 1636 645 1625 643 1625 641 1625 638 1625 608 1636 565 1625 563 1625 560 1625 558 1625 521 1636 491 1625 489 1625 487 1625 415 1636 415 1669"/>
                        </Shape>
                        <String CONTENT="and all the slaughtering was done in three days. The scabies infected the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l19" HPOS="415" VPOS="1699" WIDTH="1778" HEIGHT="48" BASELINE="415 1729 2193 1729" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1729 415 1747 2193 1747 2193 1729 2193 1699 415 1699 415 1729"/>
                        </Shape>
                        <String CONTENT="dogs and the people, who had touched and eaten the diseased meat; but the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l20" HPOS="413" VPOS="1744" WIDTH="1780" HEIGHT="70" BASELINE="415 1790 2193 1786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1790 415 1814 2191 1801 2193 1786 2189 1757 2120 1744 2118 1744 2115 1744 2089 1755 1988 1744 1985 1744 1983 1744 1981 1744 1964 1757 1834 1757 1808 1744 1806 1744 1803 1744 1752 1755 1719 1744 1717 1744 1715 1744 1713 1744 1687 1755 1624 1744 1622 1744 1619 1744 1583 1755 1524 1744 1522 1744 1414 1755 1323 1744 1321 1744 1318 1744 1277 1757 1219 1747 1217 1747 1214 1747 1180 1757 1106 1747 1104 1747 994 1757 885 1747 883 1747 881 1747 879 1747 864 1760 567 1760 506 1747 504 1747 413 1760 415 1790"/>
                        </Shape>
                        <String CONTENT="results were not so fatal as with the reindeer. Dr. Slunin also mentions that"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l21" HPOS="417" VPOS="1820" WIDTH="1772" HEIGHT="50" BASELINE="417 1851 2189 1851" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1851 417 1864 2187 1870 2189 1851 2189 1820 417 1820 417 1851"/>
                        </Shape>
                        <String CONTENT="scabies may be conveyed to men. Other diseases — such as muzzle-swelling,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l22" HPOS="417" VPOS="1868" WIDTH="1774" HEIGHT="56" BASELINE="417 1909 2191 1909" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1909 417 1924 2191 1924 2191 1909 2191 1881 2115 1868 1975 1868 1972 1868 1970 1868 1968 1868 1955 1879 1905 1868 1903 1868 1836 1879 1552 1868 1550 1868 1548 1868 1546 1868 1528 1881 1390 1881 1301 1868 1299 1868 1297 1868 1269 1881 955 1881 866 1868 864 1868 861 1868 814 1879 760 1868 757 1868 755 1868 753 1868 734 1881 625 1881 450 1868 448 1868 446 1868 417 1879 417 1909"/>
                        </Shape>
                        <String CONTENT="abscesses on the sides, etc. — are of no great importance. The Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l23" HPOS="415" VPOS="1933" WIDTH="1776" HEIGHT="50" BASELINE="417 1963 2191 1967" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1963 415 1978 2187 1983 2191 1967 2189 1933 417 1933 417 1963"/>
                        </Shape>
                        <String CONTENT="do not undertake to cure any of them, but slaughter the affected animal, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l24" HPOS="417" VPOS="1987" WIDTH="1774" HEIGHT="58" BASELINE="417 2028 2191 2028" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2028 417 2045 2191 2045 2191 2028 2191 2000 1862 1987 1860 1987 1858 1987 1814 1998 1777 1987 1775 1987 1773 1987 1708 1998 1643 1987 1641 1987 1639 1987 1637 1987 1622 2000 1483 2000 1394 1987 1392 1987 1390 1987 1368 1998 1323 1987 1321 1987 1318 1987 1262 1998 1204 1987 1201 1987 1082 1998 1013 1987 1011 1987 909 1998 835 1987 833 1987 671 1998 638 1987 636 1987 634 1987 632 1987 630 1987 612 2000 417 2000 417 2028"/>
                        </Shape>
                        <String CONTENT="consume it as readily as they would a healthy one. Occasionally they tie up,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l25" HPOS="417" VPOS="2058" WIDTH="1774" HEIGHT="50" BASELINE="417 2089 2191 2089" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2089 417 2108 2191 2108 2191 2089 2191 2058 417 2058 417 2089"/>
                        </Shape>
                        <String CONTENT="a fawn’s broken leg in thin boards, or they cut open the swollen penis of a buck"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l26" HPOS="417" VPOS="2119" WIDTH="1772" HEIGHT="48" BASELINE="417 2149 2189 2149" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2149 417 2167 2189 2167 2189 2149 2189 2119 417 2119 417 2149"/>
                        </Shape>
                        <String CONTENT="that is too much affected by the rut, and sometimes they even bore with a"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l27" HPOS="415" VPOS="2167" WIDTH="806" HEIGHT="56" BASELINE="417 2206 1221 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2206 415 2219 1217 2223 1221 2210 1219 2180 1156 2167 1154 2167 1091 2177 1037 2167 1035 2167 1033 2167 996 2177 942 2167 939 2167 937 2167 907 2177 853 2167 851 2167 417 2171 417 2206"/>
                        </Shape>
                        <String CONTENT="knife an extra outlet for the urine."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-109_r3" HPOS="412" VPOS="2230" WIDTH="1778" HEIGHT="1030" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="412 2230 2190 2230 2190 3260 412 3260"/>
                    </Shape>
                    <TextLine ID="mz_1-109_l28" HPOS="526" VPOS="2227" WIDTH="1667" HEIGHT="57" BASELINE="528 2268 2193 2264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="528 2268 528 2284 2191 2279 2193 2264 2189 2236 543 2227 541 2227 539 2227 537 2227 526 2234 528 2268"/>
                        </Shape>
                        <String CONTENT="A number of beasts of prey are dangerous to the herds. The wolverine"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l29" HPOS="415" VPOS="2286" WIDTH="1778" HEIGHT="60" BASELINE="415 2329 2193 2329" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2329 415 2346 2193 2346 2193 2329 2193 2297 2161 2286 2159 2286 2156 2286 2068 2297 1591 2286 1589 2286 1357 2297 1273 2286 1271 2286 1269 2286 1247 2297 1193 2286 1191 2286 1188 2286 1167 2297 1104 2286 1102 2286 1100 2286 1097 2286 1080 2299 983 2299 931 2286 929 2286 846 2297 773 2286 770 2286 768 2286 766 2286 749 2297 725 2286 723 2286 721 2286 718 2286 693 2297 636 2286 634 2286 632 2286 586 2297 556 2286 554 2286 552 2286 550 2286 521 2297 493 2286 491 2286 489 2286 415 2297 415 2329"/>
                        </Shape>
                        <String CONTENT="and the black bear will occasionally kill a stray reindeer. The polar wolf is"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l30" HPOS="415" VPOS="2344" WIDTH="1776" HEIGHT="61" BASELINE="417 2387 2191 2383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2387 417 2405 2189 2400 2191 2383 2187 2355 1364 2344 1362 2344 1260 2355 508 2346 506 2346 415 2357 417 2387"/>
                        </Shape>
                        <String CONTENT="much more dangerous, since, in the localities where the Chukchee herds are"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l31" HPOS="415" VPOS="2407" WIDTH="1776" HEIGHT="58" BASELINE="417 2450 2191 2446" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2450 417 2465 2189 2461 2191 2446 2187 2418 1457 2407 1455 2407 415 2420 417 2450"/>
                        </Shape>
                        <String CONTENT="numerous, it follows them wherever they wander, and generally lives on them."/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l32" HPOS="420" VPOS="2474" WIDTH="1773" HEIGHT="50" BASELINE="422 2509 2193 2504" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="422 2509 422 2524 2191 2520 2193 2504 2189 2476 420 2474 422 2509"/>
                        </Shape>
                        <String CONTENT="The natives assert that there are two varieties of polar wolf. One is smaller"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l33" HPOS="415" VPOS="2526" WIDTH="1778" HEIGHT="59" BASELINE="417 2569 2193 2563" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2569 417 2585 2191 2578 2193 2563 2189 2535 1074 2526 1071 2526 916 2537 485 2528 482 2528 415 2539 417 2569"/>
                        </Shape>
                        <String CONTENT="and swifter than the other; it hunts the wild reindeer, and never approaches"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l34" HPOS="415" VPOS="2585" WIDTH="1778" HEIGHT="58" BASELINE="417 2630 2193 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2630 417 2643 2191 2639 2193 2626 2189 2595 1308 2585 1305 2585 1303 2585 1282 2595 437 2587 435 2587 433 2587 430 2587 415 2593 417 2630"/>
                        </Shape>
                        <String CONTENT="the herds, since it dreads the smell of man. The other variety is of larger"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l35" HPOS="415" VPOS="2647" WIDTH="1778" HEIGHT="59" BASELINE="417 2691 2193 2686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2691 417 2706 2191 2701 2193 2686 2189 2656 443 2647 441 2647 439 2647 415 2656 417 2691"/>
                        </Shape>
                        <String CONTENT="size, and, since it is not swift enough to overtake the wild reindeer, it preys"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l36" HPOS="417" VPOS="2706" WIDTH="1776" HEIGHT="58" BASELINE="420 2749 2193 2743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="420 2749 420 2764 2191 2758 2193 2743 2189 2714 1067 2706 1065 2706 922 2717 482 2708 480 2708 417 2719 420 2749"/>
                        </Shape>
                        <String CONTENT="entirely on the domesticated herds. In winter the wolf selects for its raids"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l37" HPOS="417" VPOS="2777" WIDTH="1776" HEIGHT="48" BASELINE="417 2808 2193 2808" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2808 417 2825 2193 2825 2193 2808 2193 2777 417 2777 417 2808"/>
                        </Shape>
                        <String CONTENT="dark, windy nights, or those with heavy snowfalls. Oftentimes several wolves"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l38" HPOS="417" VPOS="2829" WIDTH="1774" HEIGHT="56" BASELINE="420 2870 2191 2864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="420 2870 420 2885 2189 2881 2191 2864 2187 2836 485 2829 482 2829 417 2840 420 2870"/>
                        </Shape>
                        <String CONTENT="make a joint attack from various points. In such case they may in a single,"/>
                    </TextLine>

