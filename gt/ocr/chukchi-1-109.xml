                    </TextLine>

                    <TextLine ID="mz_1-109_l8" HPOS="390" VPOS="1013" WIDTH="1780" HEIGHT="58" BASELINE="392 1056 2170 1052" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1056 392 1071 2168 1067 2170 1052 2166 1022 451 1013 448 1013 390 1024 392 1056"/>
                        </Shape>
                        <String CONTENT="a herd, once infected, will generally be exterminated. Sometimes the disease"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l9" HPOS="392" VPOS="1078" WIDTH="1776" HEIGHT="60" BASELINE="394 1108 2168 1115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1108 392 1123 1007 1138 1009 1138 2166 1130 2168 1115 2166 1084 394 1078 394 1108"/>
                        </Shape>
                        <String CONTENT="will last for several years, disappear for a while, and then break out with"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l10" HPOS="390" VPOS="1130" WIDTH="1778" HEIGHT="58" BASELINE="392 1171 2168 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1171 390 1184 2164 1188 2168 1175 2166 1145 2049 1132 2047 1132 1932 1143 1867 1132 1722 1132 1720 1132 1718 1132 1715 1132 1702 1143 1648 1132 1646 1132 1644 1132 1618 1143 1503 1132 1501 1132 1499 1132 1468 1143 1386 1132 1384 1132 1005 1141 990 1130 988 1130 986 1130 983 1130 981 1130 951 1141 873 1130 871 1130 780 1141 654 1130 652 1130 650 1130 613 1141 581 1130 578 1130 576 1130 392 1138 392 1171"/>
                        </Shape>
                        <String CONTENT="renewed vigor. “When it assumes a violent form, the Chukchee herdsmen"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l11" HPOS="396" VPOS="1203" WIDTH="1772" HEIGHT="48" BASELINE="396 1234 2168 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1234 396 1251 2168 1251 2168 1234 2168 1203 396 1203 396 1234"/>
                        </Shape>
                        <String CONTENT="often leave the whole herd, house and everything in it, even stripping them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l12" HPOS="392" VPOS="1264" WIDTH="1776" HEIGHT="45" BASELINE="392 1292 2168 1292" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1292 392 1309 2168 1309 2168 1292 2168 1264 392 1264 392 1292"/>
                        </Shape>
                        <String CONTENT="selves to the last fur shirt, as a sacrifice to the spirit of the disease. Some-"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l13" HPOS="394" VPOS="1320" WIDTH="1774" HEIGHT="59" BASELINE="396 1351 2168 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1351 394 1368 407 1377 409 1377 412 1377 414 1377 1204 1368 1284 1379 1287 1379 2166 1368 2168 1355 2166 1325 396 1320 396 1351"/>
                        </Shape>
                        <String CONTENT="times they kill all their animals, and pile them together around the tent."/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l14" HPOS="396" VPOS="1383" WIDTH="1772" HEIGHT="52" BASELINE="396 1416 2168 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1416 396 1431 2166 1435 2168 1416 2168 1383 396 1383 396 1416"/>
                        </Shape>
                        <String CONTENT="According to data contained in the archives of Nishne-Kolymsk, in the spring"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l15" HPOS="394" VPOS="1429" WIDTH="1774" HEIGHT="62" BASELINE="396 1474 2168 1470" TAGREFS="TYPE_5">
                        <Shape>
