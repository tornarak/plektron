                        <String CONTENT="scab covering the whole skin, and causing all the hair to drop off. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l4" HPOS="392" VPOS="783" WIDTH="1778" HEIGHT="48" BASELINE="392 814 2170 814" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 814 392 831 2170 831 2170 814 2170 783 392 783 392 814"/>
                        </Shape>
                        <String CONTENT="disease is said to proceed from a very small insect that burrows through the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l5" HPOS="390" VPOS="831" WIDTH="1778" HEIGHT="61" BASELINE="392 876 2168 872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 876 392 892 2166 889 2168 872 2166 844 2140 831 2138 831 2135 831 2133 831 2112 842 1659 831 1657 831 1585 842 1549 831 1546 831 1544 831 1416 842 1287 831 1284 831 1282 831 1280 831 1265 844 1215 833 1213 833 1159 844 1098 833 1096 833 723 844 594 833 591 833 492 844 418 833 416 833 414 833 390 844 392 876"/>
                        </Shape>
