                    </TextLine>

                    <TextLine ID="mz_1-109_l6" HPOS="394" VPOS="898" WIDTH="1776" HEIGHT="52" BASELINE="394 935 2170 935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 935 394 950 2170 950 2170 935 2170 902 394 898 394 935"/>
                        </Shape>
                        <String CONTENT="he does not give the name of the species. It develops in mid-winter, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l7" HPOS="392" VPOS="959" WIDTH="1776" HEIGHT="50" BASELINE="394 991 2168 996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 991 392 1004 2164 1009 2168 996 2166 959 394 959 394 991"/>
                        </Shape>
