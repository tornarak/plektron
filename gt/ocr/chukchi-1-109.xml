                        </Shape>
                        <String CONTENT="of 1872 a Chukchee reindeer-breeder, Tɪñeiˊmɪt, brought his whole herd, stricken"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l16" HPOS="392" VPOS="1491" WIDTH="1776" HEIGHT="59" BASELINE="394 1535 2168 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1535 394 1550 2166 1550 2168 1530 2164 1502 1317 1491 1315 1491 1237 1502 433 1494 431 1494 429 1494 392 1504 394 1535"/>
                        </Shape>
                        <String CONTENT="with scabies and about three thousand head strong, to that town to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l17" HPOS="392" VPOS="1548" WIDTH="1776" HEIGHT="69" BASELINE="394 1591 2168 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1591 392 1604 429 1617 431 1617 433 1617 2166 1613 2168 1595 2166 1563 2088 1550 2086 1550 2006 1561 1800 1550 1798 1550 1795 1550 1793 1550 1778 1563 1687 1563 1642 1550 1640 1550 1637 1550 1549 1561 1518 1550 1516 1550 1514 1550 1512 1550 1471 1561 1378 1550 1375 1550 1295 1561 1261 1548 1258 1548 1256 1548 1254 1548 1230 1558 1209 1548 1206 1548 1204 1548 1202 1548 1157 1558 1135 1548 1133 1548 1131 1548 1128 1548 1092 1558 957 1548 955 1548 897 1558 882 1548 879 1548 877 1548 875 1548 819 1558 760 1548 758 1548 704 1558 643 1548 641 1548 639 1548 637 1548 622 1558 526 1548 524 1548 394 1556 394 1591"/>
                        </Shape>
                        <String CONTENT="slaughtered. The inhabitants of all the neighboring villages flocked together,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l18" HPOS="394" VPOS="1610" WIDTH="1776" HEIGHT="59" BASELINE="394 1654 2170 1654" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1654 394 1669 2170 1669 2170 1654 2170 1623 2118 1610 2116 1610 2114 1610 2090 1621 2064 1610 2062 1610 2060 1610 2058 1610 2016 1621 1793 1610 1791 1610 1679 1621 1618 1610 1616 1610 1614 1610 1611 1610 1596 1623 1501 1623 1471 1610 1468 1610 1466 1610 1382 1621 1334 1610 1332 1610 1330 1610 1328 1610 1287 1621 1254 1610 1252 1610 1250 1610 1174 1621 1139 1610 1137 1610 1135 1610 1133 1610 1131 1610 1113 1623 940 1623 823 1610 821 1610 762 1621 728 1610 726 1610 723 1610 672 1621 624 1610 622 1610 620 1610 617 1610 587 1621 544 1610 542 1610 539 1610 537 1610 500 1621 470 1610 468 1610 466 1610 394 1621 394 1654"/>
                        </Shape>
                        <String CONTENT="and all the slaughtering was done in three days. The scabies infected the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l19" HPOS="394" VPOS="1684" WIDTH="1778" HEIGHT="48" BASELINE="394 1714 2172 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1714 394 1732 2172 1732 2172 1714 2172 1684 394 1684 394 1714"/>
                        </Shape>
                        <String CONTENT="dogs and the people, who had touched and eaten the diseased meat; but the"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l20" HPOS="392" VPOS="1729" WIDTH="1780" HEIGHT="70" BASELINE="394 1775 2172 1771" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1775 394 1799 2170 1786 2172 1771 2168 1742 2099 1729 2097 1729 2094 1729 2068 1740 1967 1729 1964 1729 1962 1729 1960 1729 1943 1742 1813 1742 1787 1729 1785 1729 1782 1729 1731 1740 1698 1729 1696 1729 1694 1729 1692 1729 1666 1740 1603 1729 1601 1729 1598 1729 1562 1740 1503 1729 1501 1729 1393 1740 1302 1729 1300 1729 1297 1729 1256 1742 1198 1732 1196 1732 1193 1732 1159 1742 1085 1732 1083 1732 973 1742 864 1732 862 1732 860 1732 858 1732 843 1745 546 1745 485 1732 483 1732 392 1745 394 1775"/>
                        </Shape>
                        <String CONTENT="results were not so fatal as with the reindeer. Dr. Slunin also mentions that"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l21" HPOS="396" VPOS="1805" WIDTH="1772" HEIGHT="50" BASELINE="396 1836 2168 1836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1836 396 1849 2166 1855 2168 1836 2168 1805 396 1805 396 1836"/>
                        </Shape>
                        <String CONTENT="scabies may be conveyed to men. Other diseases — such as muzzle-swelling,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l22" HPOS="396" VPOS="1853" WIDTH="1774" HEIGHT="56" BASELINE="396 1894 2170 1894" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1894 396 1909 2170 1909 2170 1894 2170 1866 2094 1853 1954 1853 1951 1853 1949 1853 1947 1853 1934 1864 1884 1853 1882 1853 1815 1864 1531 1853 1529 1853 1527 1853 1525 1853 1507 1866 1369 1866 1280 1853 1278 1853 1276 1853 1248 1866 934 1866 845 1853 843 1853 840 1853 793 1864 739 1853 736 1853 734 1853 732 1853 713 1866 604 1866 429 1853 427 1853 425 1853 396 1864 396 1894"/>
                        </Shape>
                        <String CONTENT="abscesses on the sides, etc. — are of no great importance. The Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l23" HPOS="394" VPOS="1918" WIDTH="1776" HEIGHT="50" BASELINE="396 1948 2170 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 1948 394 1963 2166 1968 2170 1952 2168 1918 396 1918 396 1948"/>
                        </Shape>
                        <String CONTENT="do not undertake to cure any of them, but slaughter the affected animal, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l24" HPOS="396" VPOS="1972" WIDTH="1774" HEIGHT="58" BASELINE="396 2013 2170 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2013 396 2030 2170 2030 2170 2013 2170 1985 1841 1972 1839 1972 1837 1972 1793 1983 1756 1972 1754 1972 1752 1972 1687 1983 1622 1972 1620 1972 1618 1972 1616 1972 1601 1985 1462 1985 1373 1972 1371 1972 1369 1972 1347 1983 1302 1972 1300 1972 1297 1972 1241 1983 1183 1972 1180 1972 1061 1983 992 1972 990 1972 888 1983 814 1972 812 1972 650 1983 617 1972 615 1972 613 1972 611 1972 609 1972 591 1985 396 1985 396 2013"/>
                        </Shape>
                        <String CONTENT="consume it as readily as they would a healthy one. Occasionally they tie up,"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l25" HPOS="396" VPOS="2043" WIDTH="1774" HEIGHT="50" BASELINE="396 2074 2170 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2074 396 2093 2170 2093 2170 2074 2170 2043 396 2043 396 2074"/>
                        </Shape>
                        <String CONTENT="a fawn’s broken leg in thin boards, or they cut open the swollen penis of a buck"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l26" HPOS="396" VPOS="2104" WIDTH="1772" HEIGHT="48" BASELINE="396 2134 2168 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2134 396 2152 2168 2152 2168 2134 2168 2104 396 2104 396 2134"/>
                        </Shape>
                        <String CONTENT="that is too much affected by the rut, and sometimes they even bore with a"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l27" HPOS="394" VPOS="2152" WIDTH="806" HEIGHT="56" BASELINE="396 2191 1200 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2191 394 2204 1196 2208 1200 2195 1198 2165 1135 2152 1133 2152 1070 2162 1016 2152 1014 2152 1012 2152 975 2162 921 2152 918 2152 916 2152 886 2162 832 2152 830 2152 396 2156 396 2191"/>
                        </Shape>
                        <String CONTENT="knife an extra outlet for the urine."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-109_r3" HPOS="391" VPOS="2215" WIDTH="1778" HEIGHT="1030" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="391 2215 2169 2215 2169 3245 391 3245"/>
                    </Shape>
                    <TextLine ID="mz_1-109_l28" HPOS="505" VPOS="2212" WIDTH="1667" HEIGHT="57" BASELINE="507 2253 2172 2249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="507 2253 507 2269 2170 2264 2172 2249 2168 2221 522 2212 520 2212 518 2212 516 2212 505 2219 507 2253"/>
                        </Shape>
                        <String CONTENT="A number of beasts of prey are dangerous to the herds. The wolverine"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l29" HPOS="394" VPOS="2271" WIDTH="1778" HEIGHT="60" BASELINE="394 2314 2172 2314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2314 394 2331 2172 2331 2172 2314 2172 2282 2140 2271 2138 2271 2135 2271 2047 2282 1570 2271 1568 2271 1336 2282 1252 2271 1250 2271 1248 2271 1226 2282 1172 2271 1170 2271 1167 2271 1146 2282 1083 2271 1081 2271 1079 2271 1076 2271 1059 2284 962 2284 910 2271 908 2271 825 2282 752 2271 749 2271 747 2271 745 2271 728 2282 704 2271 702 2271 700 2271 697 2271 672 2282 615 2271 613 2271 611 2271 565 2282 535 2271 533 2271 531 2271 529 2271 500 2282 472 2271 470 2271 468 2271 394 2282 394 2314"/>
                        </Shape>
                        <String CONTENT="and the black bear will occasionally kill a stray reindeer. The polar wolf is"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l30" HPOS="394" VPOS="2329" WIDTH="1776" HEIGHT="61" BASELINE="396 2372 2170 2368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2372 396 2390 2168 2385 2170 2368 2166 2340 1343 2329 1341 2329 1239 2340 487 2331 485 2331 394 2342 396 2372"/>
                        </Shape>
                        <String CONTENT="much more dangerous, since, in the localities where the Chukchee herds are"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l31" HPOS="394" VPOS="2392" WIDTH="1776" HEIGHT="58" BASELINE="396 2435 2170 2431" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2435 396 2450 2168 2446 2170 2431 2166 2403 1436 2392 1434 2392 394 2405 396 2435"/>
                        </Shape>
                        <String CONTENT="numerous, it follows them wherever they wander, and generally lives on them."/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l32" HPOS="399" VPOS="2459" WIDTH="1773" HEIGHT="50" BASELINE="401 2494 2172 2489" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 2494 401 2509 2170 2505 2172 2489 2168 2461 399 2459 401 2494"/>
                        </Shape>
                        <String CONTENT="The natives assert that there are two varieties of polar wolf. One is smaller"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l33" HPOS="394" VPOS="2511" WIDTH="1778" HEIGHT="59" BASELINE="396 2554 2172 2548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2554 396 2570 2170 2563 2172 2548 2168 2520 1053 2511 1050 2511 895 2522 464 2513 461 2513 394 2524 396 2554"/>
                        </Shape>
                        <String CONTENT="and swifter than the other; it hunts the wild reindeer, and never approaches"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l34" HPOS="394" VPOS="2570" WIDTH="1778" HEIGHT="58" BASELINE="396 2615 2172 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2615 396 2628 2170 2624 2172 2611 2168 2580 1287 2570 1284 2570 1282 2570 1261 2580 416 2572 414 2572 412 2572 409 2572 394 2578 396 2615"/>
                        </Shape>
                        <String CONTENT="the herds, since it dreads the smell of man. The other variety is of larger"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l35" HPOS="394" VPOS="2632" WIDTH="1778" HEIGHT="59" BASELINE="396 2676 2172 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2676 396 2691 2170 2686 2172 2671 2168 2641 422 2632 420 2632 418 2632 394 2641 396 2676"/>
                        </Shape>
                        <String CONTENT="size, and, since it is not swift enough to overtake the wild reindeer, it preys"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l36" HPOS="396" VPOS="2691" WIDTH="1776" HEIGHT="58" BASELINE="399 2734 2172 2728" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="399 2734 399 2749 2170 2743 2172 2728 2168 2699 1046 2691 1044 2691 901 2702 461 2693 459 2693 396 2704 399 2734"/>
                        </Shape>
                        <String CONTENT="entirely on the domesticated herds. In winter the wolf selects for its raids"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l37" HPOS="396" VPOS="2762" WIDTH="1776" HEIGHT="48" BASELINE="396 2793 2172 2793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2793 396 2810 2172 2810 2172 2793 2172 2762 396 2762 396 2793"/>
                        </Shape>
                        <String CONTENT="dark, windy nights, or those with heavy snowfalls. Oftentimes several wolves"/>
                    </TextLine>

                    <TextLine ID="mz_1-109_l38" HPOS="396" VPOS="2814" WIDTH="1774" HEIGHT="56" BASELINE="399 2855 2170 2849" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="399 2855 399 2870 2168 2866 2170 2849 2166 2821 464 2814 461 2814 396 2825 399 2855"/>
                        </Shape>
                        <String CONTENT="make a joint attack from various points. In such case they may in a single,"/>
                    </TextLine>

