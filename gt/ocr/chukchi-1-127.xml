                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-127_l2" HPOS="377" VPOS="725" WIDTH="1776" HEIGHT="61" BASELINE="379 768 2153 764" TAGREFS="TYPE_4">
