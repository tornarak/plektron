                        </Shape>
                        <String CONTENT="their name, Aiˊwan, was used among reindeer-breeders as an expression of"/>
                    </TextLine>

                    <TextLine ID="mz_1-127_l3" HPOS="377" VPOS="786" WIDTH="1771" HEIGHT="67" BASELINE="377 829 2148 822" TAGREFS="TYPE_4">
