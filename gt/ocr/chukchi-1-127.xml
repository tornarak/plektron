                    </TextLine>

                    <TextLine ID="mz_1-127_l7" HPOS="383" VPOS="1028" WIDTH="1768" HEIGHT="56" BASELINE="383 1067 2151 1067" TAGREFS="TYPE_4">
                        <Shape>
