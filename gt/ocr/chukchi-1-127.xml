                        </Shape>
                        <String CONTENT="contempt. With the coming of American whalers, however, Eskimo traders"/>
                    </TextLine>

                    <TextLine ID="mz_1-127_l4" HPOS="377" VPOS="857" WIDTH="1771" HEIGHT="50" BASELINE="377 889 2148 885" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 889 377 907 2146 902 2148 885 2142 857 386 859 377 889"/>
                        </Shape>
