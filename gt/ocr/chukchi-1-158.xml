            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-158" HPOS="589" VPOS="608" WIDTH="1787" HEIGHT="2620"><TextLine ID="mz_1-158_l1" HPOS="1170" VPOS="608" WIDTH="619" HEIGHT="54" BASELINE="1172 640 1789 645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1778 612 1765 608 1479 608 1475 608 1453 608 1432 608 1410 608 1388 608 1367 608 1345 608 1323 608 1302 608 1280 608 1258 608 1237 608 1215 608 1193 608 1172 617 1172 640 1170 658 1785 662 1789 645 1787 628 1778 612"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l2" HPOS="600" VPOS="619" WIDTH="106" HEIGHT="43" BASELINE="600 649 706 649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 625 600 649 600 662 706 662 706 649 706 619 607 619 600 625"/>
                        </Shape>
                        <String CONTENT="120"/>
                    </TextLine>
<TextLine ID="mz_1-158_l3" HPOS="596" VPOS="723" WIDTH="1769" HEIGHT="47" BASELINE="596 755 2365 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2350 725 2328 723 596 723 596 755 596 770 2365 770 2365 755 2365 727 2350 725"/>
                        </Shape>
                        <String CONTENT="Gradually he approaches so close to the seal as to be able to play the harpoon."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l4" HPOS="596" VPOS="768" WIDTH="1667" HEIGHT="61" BASELINE="598 814 2263 809" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 814 598 829 2261 825 2263 809 2255 768 2231 779 2157 768 2155 768 2051 779 1967 768 1964 768 1962 768 1938 779 1858 768 1856 768 1854 768 1830 779 1765 768 1763 768 1672 781 1579 781 1564 768 1562 768 1559 768 1557 768 1416 781 1393 770 1391 770 1388 770 1293 781 1228 770 1226 770 1161 783 1046 783 1027 770 1025 770 1022 770 1020 770 596 777 598 814"/>
                        </Shape>
                        <String CONTENT="These two methods are quite similar to those of the American Eskimo.¹"/>
                    </TextLine>
<TextLine ID="mz_1-158_l5" HPOS="700" VPOS="829" WIDTH="1669" HEIGHT="69" BASELINE="702 874 2369 870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="702 874 702 887 1523 898 1525 898 1527 898 1570 887 2350 896 2352 896 2354 896 2356 896 2369 885 2369 870 2365 842 2265 829 2263 829 2174 840 2151 829 2148 829 2146 829 2144 829 2142 829 2129 842 2021 842 1997 829 1995 829 1993 829 1941 840 1863 829 1860 829 1785 840 1722 829 1720 829 1635 840 1609 829 1607 829 1605 829 1514 842 1432 831 1429 831 1427 831 1397 842 1048 831 1046 831 1044 831 1042 831 1025 842 960 831 957 831 830 842 713 831 710 831 708 831 706 831 706 833 700 838 702 874"/>
                        </Shape>
                        <String CONTENT="Seals are also killed in the spring on the edges of the ice-cracks, where"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l6" HPOS="594" VPOS="887" WIDTH="1773" HEIGHT="70" BASELINE="596 935 2367 928" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 935 596 950 1774 957 1776 957 2365 944 2367 928 2363 900 2092 900 2068 887 2066 887 2064 887 2062 887 2016 898 1990 887 1988 887 1986 887 1984 887 1982 887 1967 898 1941 887 1938 887 1936 887 1934 887 1908 898 1720 889 1718 889 1715 889 1692 900 1635 889 1633 889 1631 889 1609 900 1367 889 1365 889 1300 900 1222 889 1219 889 1154 902 726 892 723 892 721 892 719 892 704 902 613 892 611 892 609 892 607 892 594 900 596 935"/>
                        </Shape>
                        <String CONTENT="they like to sleep at noontime. Before the breaking-up of the ice, wherever"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l7" HPOS="594" VPOS="952" WIDTH="1773" HEIGHT="63" BASELINE="596 993 2367 987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 993 596 1009 1774 1015 1776 1015 1867 1004 2365 1004 2367 987 2363 959 680 952 678 952 594 963 596 993"/>
                        </Shape>
                        <String CONTENT="small streams of fresh water run into the sea along an ice-crack, seals gather"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l8" HPOS="594" VPOS="1006" WIDTH="1771" HEIGHT="67" BASELINE="596 1048 2365 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1048 594 1065 604 1073 607 1073 609 1073 611 1073 2363 1067 2365 1054 2365 1022 2350 1011 2348 1011 2346 1011 2343 1011 2222 1022 2090 1011 2088 1011 2086 1011 2051 1022 2023 1011 2021 1011 2019 1011 2016 1011 1986 1022 1973 1011 1971 1011 1969 1011 1967 1011 1726 1019 1711 1009 1709 1009 1707 1009 1705 1009 1702 1009 1672 1019 1514 1009 1512 1009 1399 1019 1352 1009 1349 1009 1347 1009 1345 1009 1306 1019 1271 1009 1269 1009 1267 1009 1265 1009 1243 1019 1219 1009 1217 1009 1215 1009 1213 1009 1191 1019 1161 1006 1159 1006 1157 1006 1154 1006 1126 1017 1001 1006 999 1006 940 1017 862 1006 860 1006 858 1006 836 1017 814 1006 812 1006 810 1006 808 1006 784 1017 749 1006 747 1006 745 1006 743 1006 721 1017 596 1017 596 1048"/>
                        </Shape>
                        <String CONTENT="around their outlet to bask in the sunshine. A sealer will tie into a rough"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l9" HPOS="598" VPOS="1073" WIDTH="1769" HEIGHT="55" BASELINE="598 1110 2367 1110" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1110 598 1128 2367 1128 2367 1110 2367 1082 598 1073 598 1110"/>
                        </Shape>
                        <String CONTENT="bundle some scraps of old skin and send it downstream. It will float down"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l10" HPOS="594" VPOS="1136" WIDTH="1773" HEIGHT="50" BASELINE="596 1167 2367 1171" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1167 594 1182 2363 1186 2367 1171 2365 1141 596 1136 596 1167"/>
                        </Shape>
                        <String CONTENT="unobserved, but, on coming to one of the small whirlpools which form in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l11" HPOS="596" VPOS="1201" WIDTH="1769" HEIGHT="48" BASELINE="596 1229 2365 1229" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1229 596 1249 2365 1249 2365 1229 2365 1201 596 1201 596 1229"/>
                        </Shape>
                        <String CONTENT="crack, it will pop out suddenly and frighten away the seals lying around, so"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l12" HPOS="596" VPOS="1262" WIDTH="1771" HEIGHT="45" BASELINE="596 1292 2367 1292" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1292 596 1307 2367 1307 2367 1292 2367 1262 596 1262 596 1292"/>
                        </Shape>
                        <String CONTENT="that they can easily be overtaken on the ice. Seals sleeping on the ice, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l13" HPOS="594" VPOS="1316" WIDTH="1771" HEIGHT="58" BASELINE="596 1348 2365 1353" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1348 594 1361 752 1374 754 1374 2363 1370 2365 1353 2363 1320 596 1316 596 1348"/>
                        </Shape>
                        <String CONTENT="suddenly frightened, will often lose their holes and crawl away in the wrong"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l14" HPOS="598" VPOS="1381" WIDTH="1767" HEIGHT="45" BASELINE="598 1411 2365 1411" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1411 598 1426 2363 1426 2365 1411 2363 1381 598 1381 598 1411"/>
                        </Shape>
                        <String CONTENT="direction. Then they can easily be overtaken, especially the younger ones."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l15" HPOS="594" VPOS="1435" WIDTH="1771" HEIGHT="54" BASELINE="596 1472 2365 1465" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1472 596 1489 2363 1485 2365 1465 2361 1435 594 1435 596 1472"/>
                        </Shape>
                        <String CONTENT="Perhaps this accounts for the method of hunting of the Netchillirmiut, reported"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l16" HPOS="598" VPOS="1494" WIDTH="1767" HEIGHT="54" BASELINE="598 1530 2365 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1530 598 1548 2363 1548 2365 1530 2363 1500 598 1494 598 1530"/>
                        </Shape>
                        <String CONTENT="by J. Ross,² where a party of hunters slowly approach the sleeping seal, then"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l17" HPOS="596" VPOS="1556" WIDTH="1769" HEIGHT="50" BASELINE="596 1589 2365 1589" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1589 596 1606 2365 1606 2365 1589 2363 1556 596 1558 596 1589"/>
                        </Shape>
                        <String CONTENT="those in front shout as loudly as they can, and the others run up to the seal"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l18" HPOS="591" VPOS="1615" WIDTH="1774" HEIGHT="60" BASELINE="594 1649 2365 1645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1649 594 1665 1213 1675 1215 1675 1217 1675 1219 1675 1235 1665 2363 1665 2365 1645 2359 1615 591 1617 594 1649"/>
                        </Shape>
                        <String CONTENT="and spear it. A basking seal sometimes sleeps so soundly that it may be"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l19" HPOS="594" VPOS="1675" WIDTH="1771" HEIGHT="59" BASELINE="596 1706 2365 1710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1706 594 1721 609 1732 611 1732 613 1732 615 1732 1440 1723 1486 1734 1488 1734 1490 1734 2363 1723 2365 1710 2363 1680 596 1675 596 1706"/>
                        </Shape>
                        <String CONTENT="caught by a fast-running dog-team before it wakes up. At other times it"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l20" HPOS="594" VPOS="1723" WIDTH="1769" HEIGHT="61" BASELINE="596 1764 2363 1768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1764 594 1779 2359 1784 2363 1768 2361 1738 2298 1725 2296 1725 2294 1725 2265 1736 2209 1725 2207 1725 2094 1736 1938 1725 1936 1725 1934 1725 1932 1725 1917 1736 1895 1725 1893 1725 1891 1725 1834 1736 1789 1725 1787 1725 1785 1725 1676 1736 1650 1725 1648 1725 1646 1725 1579 1736 1551 1725 1549 1725 1546 1725 1494 1736 1479 1723 1477 1723 1475 1723 1473 1723 1360 1734 1339 1723 1336 1723 1334 1723 1282 1734 1163 1723 1161 1723 1087 1734 1042 1723 1040 1723 1038 1723 1035 1723 1012 1734 949 1723 947 1723 944 1723 923 1734 897 1723 895 1723 892 1723 890 1723 866 1736 741 1736 717 1723 715 1723 713 1723 596 1732 596 1764"/>
                        </Shape>
                        <String CONTENT="will lose its hole altogether, and will be found crawling helplessly on the ice."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l21" HPOS="596" VPOS="1792" WIDTH="1769" HEIGHT="52" BASELINE="598 1829 2365 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1829 598 1844 2363 1842 2365 1825 2361 1797 596 1792 598 1829"/>
                        </Shape>
                        <String CONTENT="The natives say that this is because the seal wants to take a walk on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l22" HPOS="591" VPOS="1846" WIDTH="1269" HEIGHT="59" BASELINE="591 1888 1860 1888" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1888 591 1901 1858 1905 1860 1888 1860 1859 1698 1846 1696 1846 1694 1846 1670 1857 1572 1846 1570 1846 1568 1846 1540 1857 1475 1846 1473 1846 1471 1846 1445 1857 1382 1846 1380 1846 1378 1846 1343 1857 1332 1846 1330 1846 1328 1846 1326 1846 1323 1846 1297 1857 1256 1846 1254 1846 1252 1846 1172 1857 1092 1846 1089 1846 1035 1857 713 1846 710 1846 591 1855 591 1888"/>
                        </Shape>
                        <String CONTENT="ice from one to another of its holes, but loses its way."/>
                    </TextLine>
<TextLine ID="mz_1-158_l23" HPOS="669" VPOS="1903" WIDTH="1698" HEIGHT="69" BASELINE="672 1946 2367 1948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="672 1946 669 1959 882 1972 884 1972 2365 1961 2367 1948 2365 1916 754 1916 672 1903 672 1946"/>
                        </Shape>
                        <String CONTENT="In some places large numbers of seals are killed while trying to go over"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l24" HPOS="594" VPOS="1965" WIDTH="1773" HEIGHT="59" BASELINE="594 2009 2367 2009" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2009 594 2024 2367 2024 2367 2009 2367 1978 2315 1965 2313 1965 2311 1965 2278 1976 2242 1965 2239 1965 2237 1965 2159 1976 2135 1965 2133 1965 2131 1965 2129 1965 2101 1976 1854 1965 1852 1965 1785 1976 1722 1965 1720 1965 1718 1965 1694 1976 1642 1965 1640 1965 1637 1965 1616 1976 1588 1965 1585 1965 1583 1965 1403 1976 1352 1965 1349 1965 1347 1965 1306 1976 1096 1965 1094 1965 1092 1965 1055 1976 983 1965 981 1965 927 1976 888 1965 886 1965 884 1965 594 1976 594 2009"/>
                        </Shape>
                        <String CONTENT="a narrow strip of land between the sea and the inner bay. Occasionally the"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l25" HPOS="594" VPOS="2033" WIDTH="1771" HEIGHT="58" BASELINE="596 2063 2365 2067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2063 594 2078 693 2091 695 2091 2363 2087 2365 2067 2363 2037 596 2033 596 2063"/>
                        </Shape>
                        <String CONTENT="seals make quite long trips overland. Thus they ascend the largest rivers,"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l26" HPOS="594" VPOS="2089" WIDTH="1771" HEIGHT="61" BASELINE="596 2124 2365 2130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2124 594 2141 604 2150 607 2150 609 2150 611 2150 2363 2145 2365 2130 2363 2098 596 2089 596 2124"/>
                        </Shape>
                        <String CONTENT="like the Kolyma and the Anadyr, for more than a hundred miles. During"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l27" HPOS="594" VPOS="2154" WIDTH="1771" HEIGHT="56" BASELINE="596 2184 2365 2188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2184 594 2197 620 2210 622 2210 624 2210 2363 2201 2365 2188 2363 2158 596 2154 596 2184"/>
                        </Shape>
                        <String CONTENT="my stay in the Kolyma country a seal was even caught on the middle course"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l28" HPOS="594" VPOS="2199" WIDTH="1769" HEIGHT="65" BASELINE="596 2240 2363 2249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2240 594 2256 2359 2264 2363 2249 2361 2219 2255 2206 2252 2206 1824 2214 1789 2204 1787 2204 1785 2204 1782 2204 1748 2214 1538 2204 1536 2204 1488 2214 1473 2201 1471 2201 1468 2201 1466 2201 1352 2212 1304 2201 1302 2201 1300 2201 1297 2201 1295 2201 1276 2214 1102 2214 1079 2201 1076 2201 1074 2201 1072 2201 1040 2212 1003 2199 1001 2199 999 2199 996 2199 975 2210 925 2199 923 2199 921 2199 899 2210 810 2199 808 2199 806 2199 769 2210 704 2199 702 2199 596 2208 596 2240"/>
                        </Shape>
                        <String CONTENT="of the Dry Anui, about two hundred miles from the mouth of the Kolyma."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l29" HPOS="596" VPOS="2262" WIDTH="1769" HEIGHT="69" BASELINE="598 2303 2365 2308" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2303 596 2316 1666 2331 1668 2331 2363 2321 2365 2308 2365 2277 2330 2264 2328 2264 2326 2264 2324 2264 2276 2275 2211 2264 2209 2264 2207 2264 2159 2275 1899 2264 1897 2264 1895 2264 1871 2275 1845 2264 1843 2264 1841 2264 1689 2275 1601 2264 1598 2264 1540 2275 1505 2264 1503 2264 1501 2264 1499 2264 1497 2264 1481 2275 1373 2262 1371 2262 1369 2262 1339 2273 1256 2262 1254 2262 1252 2262 1219 2273 1131 2262 1128 2262 1070 2273 1016 2262 1014 2262 1012 2262 975 2273 598 2264 598 2303"/>
                        </Shape>
                        <String CONTENT="Trustworthy people relate that the seals which ascend the Anadyr after the"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l30" HPOS="591" VPOS="2331" WIDTH="1770" HEIGHT="50" BASELINE="594 2364 2361 2368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2364 591 2377 2356 2381 2361 2368 2359 2336 594 2331 594 2364"/>
                        </Shape>
                        <String CONTENT="salmon-shoals often turn into its affluents, the Kanchalan and Big Rivers."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l31" HPOS="594" VPOS="2388" WIDTH="1769" HEIGHT="62" BASELINE="596 2422 2363 2427" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2422 594 2435 734 2448 736 2448 1399 2440 1484 2450 1486 2450 2361 2440 2363 2427 2361 2396 596 2388 596 2422"/>
                        </Shape>
                        <String CONTENT="If belated for return by river, on account of low water or early frosts, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l32" HPOS="591" VPOS="2450" WIDTH="1772" HEIGHT="57" BASELINE="594 2481 2363 2487" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2481 591 2498 604 2507 607 2507 609 2507 611 2507 2361 2505 2363 2487 2361 2457 594 2450 594 2481"/>
                        </Shape>
                        <String CONTENT="start on a quite wonderful overland journey on impracticable roads among"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l33" HPOS="591" VPOS="2500" WIDTH="1772" HEIGHT="67" BASELINE="594 2541 2363 2546" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2541 591 2559 604 2567 607 2567 609 2567 611 2567 2361 2559 2363 2546 2363 2515 2326 2502 2324 2502 2322 2502 2320 2502 2294 2513 1696 2502 1694 2502 1618 2513 1592 2502 1590 2502 1588 2502 1479 2513 1419 2500 1416 2500 1414 2500 1369 2511 1317 2500 1315 2500 1256 2511 1193 2500 1191 2500 1189 2500 1157 2513 1057 2513 1042 2500 1040 2500 1038 2500 1035 2500 1033 2500 1005 2513 895 2513 879 2500 877 2500 875 2500 873 2500 871 2500 838 2511 769 2500 767 2500 594 2509 594 2541"/>
                        </Shape>
                        <String CONTENT="the hills. I was shown the skin of a rough-seal killed on such a journey in"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l34" HPOS="591" VPOS="2557" WIDTH="479" HEIGHT="62" BASELINE="594 2600 1070 2604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2600 591 2615 1066 2619 1070 2604 1068 2572 953 2559 951 2559 892 2570 864 2559 862 2559 860 2559 858 2559 836 2570 827 2559 825 2559 825 2557 823 2557 821 2557 819 2557 817 2557 793 2567 736 2557 734 2557 594 2565 594 2600"/>
                        </Shape>
                        <String CONTENT="the Kanchalan Hills."/>
                    </TextLine>
<TextLine ID="mz_1-158_l35" HPOS="704" VPOS="2621" WIDTH="1663" HEIGHT="65" BASELINE="706 2660 2367 2665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2660 704 2676 713 2684 713 2686 715 2686 717 2686 719 2686 2365 2678 2367 2665 2367 2634 1594 2634 1538 2621 1536 2621 706 2628 706 2660"/>
                        </Shape>
                        <String CONTENT="All through the winter, wherever the open water is not far from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l36" HPOS="591" VPOS="2693" WIDTH="1785" HEIGHT="48" BASELINE="591 2723 2376 2723" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2723 591 2738 2374 2741 2376 2723 2376 2693 591 2693 591 2723"/>
                        </Shape>
                        <String CONTENT="shore, the natives go sealing and walrusing at the edge of the land-ice. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l37" HPOS="589" VPOS="2738" WIDTH="1772" HEIGHT="67" BASELINE="591 2780 2361 2786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2780 589 2797 602 2805 604 2805 607 2805 609 2805 2359 2799 2361 2786 2359 2756 2291 2743 2289 2743 2287 2743 2250 2754 2008 2743 2006 2743 2003 2743 1964 2754 1856 2743 1854 2743 1791 2754 1748 2741 1746 2741 1744 2741 1741 2741 1715 2751 1655 2741 1653 2741 1141 2749 1105 2738 1102 2738 1100 2738 1098 2738 1066 2749 1027 2738 1025 2738 1022 2738 1020 2738 990 2749 927 2738 925 2738 923 2738 892 2751 767 2751 747 2738 745 2738 743 2738 741 2738 591 2747 591 2780"/>
                        </Shape>
                        <String CONTENT="animals are shot in the water or on the drifting ice. Then, if feasible, they"/>
                    </TextLine>

