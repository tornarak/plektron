                        </Shape>
                        <String CONTENT="seals make quite long trips overland. Thus they ascend the largest rivers,"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l26" HPOS="615" VPOS="2104" WIDTH="1771" HEIGHT="61" BASELINE="617 2139 2386 2145" TAGREFS="TYPE_5">
                        <Shape>
