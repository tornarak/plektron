                        <Shape>
                            <Polygon POINTS="727 2675 725 2691 734 2699 734 2701 736 2701 738 2701 740 2701 2386 2693 2388 2680 2388 2649 1615 2649 1559 2636 1557 2636 727 2643 727 2675"/>
