                    </TextLine>

                    <TextLine ID="mz_1-158_l18" HPOS="612" VPOS="1630" WIDTH="1774" HEIGHT="60" BASELINE="615 1664 2386 1660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1664 615 1680 1234 1690 1236 1690 1238 1690 1240 1690 1256 1680 2384 1680 2386 1660 2380 1630 612 1632 615 1664"/>
                        </Shape>
                        <String CONTENT="and spear it. A basking seal sometimes sleeps so soundly that it may be"/>
                    </TextLine>

