                    </TextLine>

                    <TextLine ID="mz_1-158_l12" HPOS="617" VPOS="1277" WIDTH="1771" HEIGHT="45" BASELINE="617 1307 2388 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1307 617 1322 2388 1322 2388 1307 2388 1277 617 1277 617 1307"/>
                        </Shape>
                        <String CONTENT="that they can easily be overtaken on the ice. Seals sleeping on the ice, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l13" HPOS="615" VPOS="1331" WIDTH="1771" HEIGHT="58" BASELINE="617 1363 2386 1368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1363 615 1376 773 1389 775 1389 2384 1385 2386 1368 2384 1335 617 1331 617 1363"/>
                        </Shape>
                        <String CONTENT="suddenly frightened, will often lose their holes and crawl away in the wrong"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l14" HPOS="619" VPOS="1396" WIDTH="1767" HEIGHT="45" BASELINE="619 1426 2386 1426" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1426 619 1441 2384 1441 2386 1426 2384 1396 619 1396 619 1426"/>
                        </Shape>
                        <String CONTENT="direction. Then they can easily be overtaken, especially the younger ones."/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l15" HPOS="615" VPOS="1450" WIDTH="1771" HEIGHT="54" BASELINE="617 1487 2386 1480" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1487 617 1504 2384 1500 2386 1480 2382 1450 615 1450 617 1487"/>
                        </Shape>
                        <String CONTENT="Perhaps this accounts for the method of hunting of the Netchillirmiut, reported"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l16" HPOS="619" VPOS="1509" WIDTH="1767" HEIGHT="54" BASELINE="619 1545 2386 1545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1545 619 1563 2384 1563 2386 1545 2384 1515 619 1509 619 1545"/>
                        </Shape>
                        <String CONTENT="by J. Ross,² where a party of hunters slowly approach the sleeping seal, then"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l17" HPOS="617" VPOS="1571" WIDTH="1769" HEIGHT="50" BASELINE="617 1604 2386 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1604 617 1621 2386 1621 2386 1604 2384 1571 617 1573 617 1604"/>
                        </Shape>
