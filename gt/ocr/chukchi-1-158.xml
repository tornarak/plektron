                        <Shape>
                            <Polygon POINTS="617 2437 615 2450 755 2463 757 2463 1420 2455 1505 2465 1507 2465 2382 2455 2384 2442 2382 2411 617 2403 617 2437"/>
                        </Shape>
                        <String CONTENT="If belated for return by river, on account of low water or early frosts, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l32" HPOS="612" VPOS="2465" WIDTH="1772" HEIGHT="57" BASELINE="615 2496 2384 2502" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2496 612 2513 625 2522 628 2522 630 2522 632 2522 2382 2520 2384 2502 2382 2472 615 2465 615 2496"/>
                        </Shape>
                        <String CONTENT="start on a quite wonderful overland journey on impracticable roads among"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l33" HPOS="612" VPOS="2515" WIDTH="1772" HEIGHT="67" BASELINE="615 2556 2384 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2556 612 2574 625 2582 628 2582 630 2582 632 2582 2382 2574 2384 2561 2384 2530 2347 2517 2345 2517 2343 2517 2341 2517 2315 2528 1717 2517 1715 2517 1639 2528 1613 2517 1611 2517 1609 2517 1500 2528 1440 2515 1437 2515 1435 2515 1390 2526 1338 2515 1336 2515 1277 2526 1214 2515 1212 2515 1210 2515 1178 2528 1078 2528 1063 2515 1061 2515 1059 2515 1056 2515 1054 2515 1026 2528 916 2528 900 2515 898 2515 896 2515 894 2515 892 2515 859 2526 790 2515 788 2515 615 2524 615 2556"/>
                        </Shape>
                        <String CONTENT="the hills. I was shown the skin of a rough-seal killed on such a journey in"/>
