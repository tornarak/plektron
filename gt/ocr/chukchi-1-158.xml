                    <TextLine ID="mz_1-158_l29" HPOS="617" VPOS="2277" WIDTH="1769" HEIGHT="69" BASELINE="619 2318 2386 2323" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 2318 617 2331 1687 2346 1689 2346 2384 2336 2386 2323 2386 2292 2351 2279 2349 2279 2347 2279 2345 2279 2297 2290 2232 2279 2230 2279 2228 2279 2180 2290 1920 2279 1918 2279 1916 2279 1892 2290 1866 2279 1864 2279 1862 2279 1710 2290 1622 2279 1619 2279 1561 2290 1526 2279 1524 2279 1522 2279 1520 2279 1518 2279 1502 2290 1394 2277 1392 2277 1390 2277 1360 2288 1277 2277 1275 2277 1273 2277 1240 2288 1152 2277 1149 2277 1091 2288 1037 2277 1035 2277 1033 2277 996 2288 619 2279 619 2318"/>
                        </Shape>
                        <String CONTENT="Trustworthy people relate that the seals which ascend the Anadyr after the"/>
                    </TextLine>

