                        </Shape>
                        <String CONTENT="around their outlet to bask in the sunshine. A sealer will tie into a rough"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l9" HPOS="619" VPOS="1088" WIDTH="1769" HEIGHT="55" BASELINE="619 1125 2388 1125" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1125 619 1143 2388 1143 2388 1125 2388 1097 619 1088 619 1125"/>
                        </Shape>
                        <String CONTENT="bundle some scraps of old skin and send it downstream. It will float down"/>
                    </TextLine>

                    <TextLine ID="mz_1-158_l10" HPOS="615" VPOS="1151" WIDTH="1773" HEIGHT="50" BASELINE="617 1182 2388 1186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1182 615 1197 2384 1201 2388 1186 2386 1156 617 1151 617 1182"/>
                        </Shape>
                        <String CONTENT="unobserved, but, on coming to one of the small whirlpools which form in the"/>
                    </TextLine>

