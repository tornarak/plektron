                        <Shape>
                            <Polygon POINTS="615 2379 612 2392 2377 2396 2382 2383 2380 2351 615 2346 615 2379"/>
                        </Shape>
                        <String CONTENT="salmon-shoals often turn into its affluents, the Kanchalan and Big Rivers."/>
                    </TextLine>

