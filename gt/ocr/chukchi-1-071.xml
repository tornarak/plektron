                        <Shape>
                            <Polygon POINTS="1232 608 1211 608 1189 608 1167 608 1146 608 1124 608 1102 608 1081 608 1059 608 1038 608 1016 608 994 608 973 608 951 608 929 610 929 640 927 658 1542 662 1546 645 1544 610 1237 608 1232 608"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l2" HPOS="2053" VPOS="612" WIDTH="59" HEIGHT="57" BASELINE="2058 656 2112 651" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2097 617 2084 612 2053 617 2058 656 2058 669 2112 664 2112 651 2105 617 2097 617"/>
                        </Shape>
                        <String CONTENT="49"/>
                    </TextLine>
<TextLine ID="mz_1-071_l3" HPOS="349" VPOS="712" WIDTH="1776" HEIGHT="56" BASELINE="351 755 2125 749" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="652 714 630 714 609 716 587 716 565 718 544 718 522 721 500 721 479 721 457 723 435 723 414 725 392 725 370 727 349 727 351 755 351 768 2122 762 2125 749 2120 716 667 712 652 714"/>
                        </Shape>
                        <String CONTENT="a storehouse in order to sell them to the whalers. The skins were restored"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l4" HPOS="351" VPOS="768" WIDTH="1771" HEIGHT="61" BASELINE="353 814 2122 809" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="353 814 353 829 2120 825 2122 809 2118 779 1302 768 1300 768 1226 779 444 770 442 770 351 781 353 814"/>
                        </Shape>
                        <String CONTENT="to their owner, but the thief was not punished, except with harsh words. As"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l5" HPOS="351" VPOS="831" WIDTH="1774" HEIGHT="61" BASELINE="353 874 2125 868" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="353 874 353 892 2122 885 2125 868 2120 835 394 831 392 831 390 831 351 842 353 874"/>
                        </Shape>
                        <String CONTENT="witnessed by Nordenskiöld, theft, and deceit toward a stranger, are not considered"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l6" HPOS="353" VPOS="887" WIDTH="1769" HEIGHT="65" BASELINE="355 935 2122 926" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 935 355 952 2120 944 2122 926 2118 898 1689 887 1687 887 1685 887 1683 887 1670 898 821 892 819 892 817 892 773 902 405 894 403 894 353 905 355 935"/>
                        </Shape>
                        <String CONTENT="unlawful. I must acknowledge, however, that, during my journey among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l7" HPOS="353" VPOS="959" WIDTH="1769" HEIGHT="52" BASELINE="355 991 2122 987" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 991 355 1009 2118 1011 2122 987 2118 959 353 959 355 991"/>
                        </Shape>
                        <String CONTENT="Maritime Chukchee and the Eskimo, hardly any of my belongings were lost;"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l8" HPOS="353" VPOS="1006" WIDTH="1782" HEIGHT="63" BASELINE="355 1052 2135 1048" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1052 355 1069 2135 1065 2135 1048 2131 1019 1832 1006 1830 1006 1679 1017 1616 1006 1614 1006 1516 1017 1462 1006 1460 1006 1458 1006 1416 1017 1378 1006 1375 1006 1373 1006 1371 1006 1349 1017 1315 1006 1313 1006 1310 1006 1237 1019 762 1009 760 1009 758 1009 736 1019 682 1009 680 1009 678 1009 676 1009 656 1022 474 1022 396 1009 394 1009 392 1009 353 1022 355 1052"/>
                        </Shape>
                        <String CONTENT="while among the Reindeer people not a single trip would pass without almost"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l9" HPOS="353" VPOS="1078" WIDTH="1772" HEIGHT="58" BASELINE="355 1110 2125 1106" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1110 355 1125 1230 1136 1232 1136 1235 1136 1237 1136 1252 1123 1598 1134 1601 1134 1653 1123 1817 1134 1819 1134 1821 1134 1852 1123 2006 1134 2008 1134 2010 1134 2038 1123 2103 1134 2105 1134 2107 1134 2109 1134 2125 1121 2125 1106 2118 1078 353 1080 355 1110"/>
                        </Shape>
                        <String CONTENT="open attempts at stealing, amounting even to robbery. “Look out for my"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l10" HPOS="355" VPOS="1141" WIDTH="1770" HEIGHT="45" BASELINE="355 1171 2125 1171" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1171 355 1186 2125 1186 2125 1171 2125 1141 355 1141 355 1171"/>
                        </Shape>
                        <String CONTENT="mother!” I was once warned by my host. “Her nature is such, that she"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l11" HPOS="353" VPOS="1188" WIDTH="1180" HEIGHT="59" BASELINE="355 1232 1533 1227" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1232 355 1247 1531 1242 1533 1227 1527 1188 929 1199 392 1190 390 1190 388 1190 353 1201 355 1232"/>
                        </Shape>
                        <String CONTENT="will steal even fresh excrement from under a man.”"/>
                    </TextLine>
<TextLine ID="mz_1-071_l12" HPOS="464" VPOS="1260" WIDTH="1661" HEIGHT="47" BASELINE="464 1290 2125 1290" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="464 1290 464 1307 2125 1307 2125 1290 2125 1260 464 1260 464 1290"/>
                        </Shape>
                        <String CONTENT="Among the Reindeer people, indeed, theft between the camps and herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l13" HPOS="351" VPOS="1303" WIDTH="1774" HEIGHT="74" BASELINE="353 1353 2125 1344" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="353 1353 353 1368 921 1366 1100 1377 1102 1377 1546 1364 1611 1374 1614 1374 1616 1374 1618 1374 1635 1364 2014 1372 2016 1372 2019 1372 2021 1372 2036 1361 2103 1372 2105 1372 2107 1372 2109 1372 2125 1359 2125 1344 2120 1314 1947 1303 1945 1303 1943 1303 1899 1314 1878 1303 1876 1303 1873 1303 1871 1303 1869 1303 1854 1316 1676 1316 1659 1305 1657 1305 1655 1305 1653 1305 1650 1305 1627 1316 1583 1305 1581 1305 1579 1305 1577 1305 1551 1316 1505 1305 1503 1305 1501 1305 1499 1305 1477 1316 1453 1305 1451 1305 1449 1305 1356 1316 1291 1305 1289 1305 1287 1305 1235 1318 1211 1307 1209 1307 1206 1307 1081 1318 1050 1307 1048 1307 1046 1307 962 1318 947 1307 944 1307 942 1307 940 1307 838 1318 797 1307 795 1307 793 1307 791 1307 760 1320 351 1316 353 1353"/>
                        </Shape>
                        <String CONTENT="is held to be an almost lawful pursuit. There is in the language, besides the"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l14" HPOS="351" VPOS="1366" WIDTH="1774" HEIGHT="63" BASELINE="353 1411 2125 1407" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="353 1411 353 1429 2122 1424 2125 1407 2120 1377 1239 1366 1237 1366 1167 1377 457 1368 455 1368 351 1379 353 1411"/>
                        </Shape>
                        <String CONTENT="usual word for stealing, tɪ-tuleˊerkɪn (“I steal”), still another, rather euphemistic"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l15" HPOS="353" VPOS="1426" WIDTH="1769" HEIGHT="61" BASELINE="355 1472 2122 1468" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1472 355 1487 2120 1483 2122 1468 2118 1437 1239 1426 1237 1426 1235 1426 1213 1437 739 1429 736 1429 353 1439 355 1472"/>
                        </Shape>
                        <String CONTENT="term, tɪ-ng̣ɪntɪweˊerkɪn (“I abstract;” literally, “I cause [the thing] to flee”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l16" HPOS="353" VPOS="1491" WIDTH="1772" HEIGHT="57" BASELINE="355 1535 2125 1526" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1535 355 1548 2122 1541 2125 1526 2120 1491 366 1491 364 1491 362 1491 360 1491 360 1494 353 1498 355 1535"/>
                        </Shape>
                        <String CONTENT="Quarrels are continually going on between neighbors on account of mutual"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l17" HPOS="353" VPOS="1548" WIDTH="1772" HEIGHT="60" BASELINE="355 1591 2125 1582" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1591 355 1608 2122 1600 2125 1582 2120 1554 806 1548 804 1548 353 1561 355 1591"/>
                        </Shape>
                        <String CONTENT="accusations. Several of the people that I knew were given new derisive names"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l18" HPOS="355" VPOS="1604" WIDTH="1767" HEIGHT="69" BASELINE="357 1647 2122 1643" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 1647 357 1662 992 1673 994 1673 996 1673 999 1673 1014 1662 1089 1673 1092 1673 1241 1660 1795 1671 1798 1671 1958 1660 2040 1671 2042 1671 2120 1658 2122 1643 2118 1615 1263 1604 1261 1604 1258 1604 1235 1615 661 1606 659 1606 355 1617 357 1647"/>
                        </Shape>
                        <String CONTENT="on account of their thieving exploits. One was called “Knee-Walker” (Ñɪreˊ-"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l19" HPOS="353" VPOS="1669" WIDTH="1774" HEIGHT="56" BASELINE="355 1710 2127 1704" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1710 355 1725 2127 1719 2127 1704 2122 1675 366 1669 364 1669 362 1669 360 1669 360 1671 353 1675 355 1710"/>
                        </Shape>
                        <String CONTENT="čeiˊvun) because he was once accused of crawling on all-fours to his neighbor’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l20" HPOS="355" VPOS="1723" WIDTH="1770" HEIGHT="63" BASELINE="357 1768 2125 1762" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 1768 357 1786 2122 1779 2125 1762 2120 1734 1899 1723 1897 1723 355 1734 357 1768"/>
                        </Shape>
                        <String CONTENT="herd in the calving-season with the intention of taking away some of the new-"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l21" HPOS="355" VPOS="1784" WIDTH="1770" HEIGHT="62" BASELINE="357 1829 2125 1825" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 1829 357 1846 2122 1846 2125 1825 2120 1794 1276 1784 1274 1784 1157 1797 355 1797 357 1829"/>
                        </Shape>
                        <String CONTENT="born fawns. Another was called “Necklaced Latuˊwg̣ê” (Êˊnnɪčhɪ-Latuˊᵋwg̣ê)"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l22" HPOS="353" VPOS="1842" WIDTH="1772" HEIGHT="63" BASELINE="355 1890 2125 1881" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1890 355 1905 2122 1896 2125 1881 2120 1853 1694 1842 1692 1842 1689 1842 1687 1842 1674 1853 1352 1844 1349 1844 1235 1857 353 1857 355 1890"/>
                        </Shape>
                        <String CONTENT="because while on a visit to another camp he stole some half-cooked entrails"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l23" HPOS="353" VPOS="1903" WIDTH="1772" HEIGHT="65" BASELINE="355 1950 2125 1944" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 1950 355 1968 2122 1968 2125 1944 2120 1914 1533 1903 1531 1903 890 1916 379 1907 377 1907 375 1907 353 1916 355 1950"/>
                        </Shape>
                        <String CONTENT="that were boiling in the kettle, wound them around his neck, and, when pursued,"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l24" HPOS="353" VPOS="1968" WIDTH="1772" HEIGHT="56" BASELINE="355 2011 2125 2004" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2011 355 2024 2122 2017 2125 2004 2120 1974 446 1968 444 1968 353 1978 355 2011"/>
                        </Shape>
                        <String CONTENT="continued to eat from one end thereof. These names stick so well, that at"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l25" HPOS="353" VPOS="2022" WIDTH="1772" HEIGHT="73" BASELINE="355 2072 2125 2061" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2072 355 2085 687 2085 702 2095 704 2095 706 2095 708 2095 879 2082 1254 2091 1256 2091 1258 2091 1297 2080 2122 2080 2125 2061 2120 2033 1769 2022 1767 2022 1765 2022 1763 2022 1748 2033 1516 2024 1514 2024 1397 2035 1063 2026 1061 2026 353 2037 355 2072"/>
                        </Shape>
                        <String CONTENT="last even the persons themselves begin to use them, especially after some"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l26" HPOS="353" VPOS="2080" WIDTH="1772" HEIGHT="65" BASELINE="355 2130 2125 2121" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2130 355 2145 2122 2137 2125 2121 2122 2093 2094 2080 2092 2080 2090 2080 2088 2080 2066 2091 2045 2080 2042 2080 2040 2080 1904 2091 1865 2080 1863 2080 1860 2080 1858 2080 1856 2080 1839 2093 1720 2093 1685 2080 1683 2080 1681 2080 1679 2080 1648 2093 1239 2082 1237 2082 1235 2082 1196 2095 821 2085 819 2085 817 2085 775 2098 448 2087 446 2087 353 2100 355 2130"/>
                        </Shape>
                        <String CONTENT="trouble with the spirits of disease, when the Chukchee like to change their"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l27" HPOS="355" VPOS="2139" WIDTH="1770" HEIGHT="67" BASELINE="357 2191 2125 2180" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2191 357 2206 2122 2197 2125 2180 2120 2152 2068 2139 2066 2139 2006 2150 1990 2139 1988 2139 1986 2139 1984 2139 1921 2150 1897 2139 1895 2139 1893 2139 1891 2139 1889 2139 1873 2152 1659 2152 1631 2141 1629 2141 1627 2141 1575 2152 1529 2141 1527 2141 1525 2141 1447 2152 1419 2141 1416 2141 1414 2141 1412 2141 1380 2154 1367 2143 1365 2143 1362 2143 1360 2143 1358 2143 1328 2154 1269 2143 1267 2143 1154 2154 1068 2143 1066 2143 1063 2143 1061 2143 1044 2156 773 2145 771 2145 697 2158 572 2147 570 2147 568 2147 565 2147 550 2160 355 2160 357 2191"/>
                        </Shape>
                        <String CONTENT="names. During the Russian fairs small thefts take place every day in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l28" HPOS="355" VPOS="2214" WIDTH="1770" HEIGHT="48" BASELINE="357 2249 2125 2243" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2249 357 2262 2122 2258 2125 2243 2120 2214 355 2214 357 2249"/>
                        </Shape>
                        <String CONTENT="block-houses as well as in the camps, and even inside the tents. In my"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l29" HPOS="353" VPOS="2264" WIDTH="1774" HEIGHT="65" BASELINE="355 2314 2127 2303" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2314 355 2329 2125 2316 2127 2303 2122 2273 1447 2264 1445 2264 1375 2275 1176 2266 1174 2266 353 2282 355 2314"/>
                        </Shape>
                        <String CONTENT="presence, a young man who came into the trading-store, picked up a bunch"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l30" HPOS="357" VPOS="2321" WIDTH="1768" HEIGHT="62" BASELINE="360 2368 2125 2362" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="360 2368 360 2383 2122 2377 2125 2362 2120 2334 1756 2321 1754 2321 1752 2321 1750 2321 1733 2334 1585 2334 1559 2321 1557 2321 1555 2321 1553 2321 1551 2321 1531 2334 1516 2323 1514 2323 1512 2323 1510 2323 1507 2323 1464 2334 901 2325 899 2325 897 2325 895 2325 875 2336 511 2325 509 2325 433 2336 399 2325 396 2325 394 2325 392 2325 357 2338 360 2368"/>
                        </Shape>
                        <String CONTENT="of squirrel-skins from the floor, and tried to sell them to their real owner."/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l31" HPOS="362" VPOS="2390" WIDTH="1765" HEIGHT="52" BASELINE="362 2424 2127 2424" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 2424 362 2442 2127 2442 2127 2424 2127 2394 362 2390 362 2424"/>
                        </Shape>
                        <String CONTENT="When detected, he only said, “Take them, if they are yours,” and then sat"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l32" HPOS="355" VPOS="2440" WIDTH="1772" HEIGHT="62" BASELINE="357 2487 2127 2481" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2487 357 2502 2125 2496 2127 2481 2122 2450 1536 2440 1533 2440 1531 2440 1529 2440 1529 2442 1518 2450 381 2444 379 2444 377 2444 355 2453 357 2487"/>
                        </Shape>
                        <String CONTENT="down on the bench, waiting for the usual hospitality.¹ I have in my collection"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l33" HPOS="353" VPOS="2498" WIDTH="1772" HEIGHT="65" BASELINE="355 2548 2125 2541" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="355 2548 355 2563 2122 2557 2125 2541 2120 2511 2047 2498 2045 2498 2042 2498 2040 2498 2023 2509 1945 2498 1943 2498 1865 2509 1841 2498 1839 2498 1837 2498 1834 2498 1811 2509 1785 2498 1782 2498 1780 2498 1778 2498 1737 2509 1711 2498 1709 2498 1707 2498 1705 2498 1676 2509 1603 2498 1601 2498 1598 2498 1564 2509 1540 2498 1538 2498 1536 2498 1533 2498 1531 2498 1510 2511 1007 2500 1005 2500 921 2513 873 2502 871 2502 869 2502 708 2513 643 2502 641 2502 639 2502 613 2513 555 2502 552 2502 550 2502 524 2513 446 2502 444 2502 353 2515 355 2548"/>
                        </Shape>
                        <String CONTENT="a white fox-skin roughly patched with hare-skin to make it look whole. Norden-"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l34" HPOS="355" VPOS="2557" WIDTH="1612" HEIGHT="64" BASELINE="357 2606 1967 2600" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2606 357 2621 1964 2615 1967 2600 1962 2570 1748 2557 1746 2557 1663 2567 1605 2557 1603 2557 1601 2557 1572 2567 1518 2557 1516 2557 1514 2557 1484 2567 1458 2557 1455 2557 1453 2557 1451 2557 1425 2570 1384 2559 1382 2559 1380 2559 1378 2559 1356 2570 1230 2559 1228 2559 1161 2570 1148 2559 1146 2559 1144 2559 1057 2559 1055 2559 970 2570 914 2559 912 2559 910 2559 873 2572 806 2561 804 2561 801 2561 767 2572 587 2561 585 2561 583 2561 537 2572 524 2561 522 2561 520 2561 390 2561 388 2561 386 2561 355 2572 357 2606"/>
                        </Shape>
                        <String CONTENT="skiöld² relates similar tricks, chiefly of the Arctic Maritime Chukchee."/>
                    </TextLine>
<TextLine ID="mz_1-071_l35" HPOS="466" VPOS="2617" WIDTH="1659" HEIGHT="67" BASELINE="468 2669 2125 2660" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="468 2669 468 2684 2122 2676 2125 2660 2122 2630 2086 2617 2084 2617 2081 2617 2014 2628 1884 2617 1882 2617 1880 2617 1856 2628 1830 2617 1828 2617 1826 2617 1824 2617 1821 2617 1808 2628 1663 2619 1661 2619 1659 2619 1657 2619 1640 2630 1618 2619 1616 2619 1614 2619 1611 2619 1585 2630 1540 2619 1538 2619 1536 2619 1533 2619 1499 2630 1447 2619 1445 2619 1442 2619 1440 2619 1423 2632 1265 2632 1250 2621 1248 2621 1245 2621 1243 2621 1241 2621 1217 2632 1115 2621 1113 2621 940 2632 882 2621 879 2621 730 2634 490 2624 487 2624 485 2624 483 2624 466 2632 468 2669"/>
                        </Shape>
                        <String CONTENT="As mentioned before, quarrelling between the Chukchee and their neigh-"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l36" HPOS="355" VPOS="2680" WIDTH="1772" HEIGHT="61" BASELINE="357 2728 2127 2721" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2728 357 2741 2125 2736 2127 2721 2122 2691 1536 2680 1533 2680 1531 2680 1529 2680 1514 2691 960 2682 957 2682 955 2682 953 2682 940 2695 355 2695 357 2728"/>
                        </Shape>
                        <String CONTENT="bors has almost ceased. The Kerek of Cape Barykoff occasionally complain"/>
                    </TextLine>

                    <TextLine ID="mz_1-071_l37" HPOS="355" VPOS="2738" WIDTH="1767" HEIGHT="67" BASELINE="357 2788 2122 2782" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="357 2788 357 2803 2118 2805 2122 2782 2118 2751 2058 2738 2055 2738 2053 2738 2021 2749 1819 2738 1817 2738 1737 2749 1657 2738 1655 2738 1583 2749 1553 2738 1551 2738 1549 2738 1479 2751 1001 2741 999 2741 996 2741 994 2741 979 2751 574 2743 572 2743 570 2743 548 2754 496 2743 494 2743 492 2743 455 2754 381 2743 379 2743 377 2743 375 2743 355 2754 357 2788"/>
                        </Shape>
                        <String CONTENT="that the Telqäˊp Chukchee ill-treat them, taking their peltries without paying"/>
                    </TextLine>

