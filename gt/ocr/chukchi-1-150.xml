                        <Shape>
                            <Polygon POINTS="619 1257 619 1275 2393 1275 2393 1257 2393 1227 619 1221 619 1257"/>
                        </Shape>
                        <String CONTENT="Kolyma allow for each dog (according to a local saying) “1 pud to carry, 1000"/>
                    </TextLine>

