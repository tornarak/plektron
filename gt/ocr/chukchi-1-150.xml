                        </Shape>
                        <String CONTENT="carry not more than 100 Russian pounds’ weight (90 pounds Avoirdupois)."/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l16" HPOS="621" VPOS="1511" WIDTH="1772" HEIGHT="60" BASELINE="623 1556 2393 1552" TAGREFS="TYPE_5">
                        <Shape>
