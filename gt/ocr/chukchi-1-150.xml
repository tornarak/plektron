                        </Shape>
                        <String CONTENT="impetus, for they can draw it along only at a rapid pace. When stopped,"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l21" HPOS="617" VPOS="1812" WIDTH="1771" HEIGHT="60" BASELINE="619 1855 2388 1851" TAGREFS="TYPE_5">
