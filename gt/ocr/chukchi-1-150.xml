                    <TextLine ID="mz_1-150_l6" HPOS="617" VPOS="924" WIDTH="1776" HEIGHT="52" BASELINE="619 959 2393 954" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 959 619 976 2390 972 2393 954 2388 926 617 924 619 959"/>
