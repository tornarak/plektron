                <TextBlock ID="text_1-150" HPOS="591" VPOS="623" WIDTH="1783" HEIGHT="2615"><TextLine ID="mz_1-150_l1" HPOS="1178" VPOS="623" WIDTH="620" HEIGHT="52" BASELINE="1178 656 1798 656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1787 623 1193 623 1178 638 1178 656 1178 675 1798 675 1798 656 1795 640 1787 623"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l2" HPOS="598" VPOS="628" WIDTH="104" HEIGHT="56" BASELINE="600 658 702 662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 638 600 658 598 669 659 684 661 684 663 684 700 673 702 662 702 630 611 628 600 638"/>
                        </Shape>
                        <String CONTENT="114"/>
                    </TextLine>
<TextLine ID="mz_1-150_l3" HPOS="591" VPOS="729" WIDTH="1781" HEIGHT="54" BASELINE="594 762 2372 766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2367 736 2346 736 2324 736 2302 734 2281 734 2259 734 2237 734 2233 731 594 729 594 762 591 777 2367 783 2372 766 2369 736 2367 736"/>
                        </Shape>
                        <String CONTENT="teams are stronger, though the mountainous roads of that country are more trying"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l4" HPOS="594" VPOS="790" WIDTH="1778" HEIGHT="52" BASELINE="596 825 2372 820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 825 596 842 2369 838 2372 820 2365 790 594 792 596 825"/>
                        </Shape>
                        <String CONTENT="for the dogs than the level tundra. Chukchee teams are not as strong and well"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l5" HPOS="596" VPOS="840" WIDTH="1773" HEIGHT="60" BASELINE="598 885 2369 881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 885 598 900 2367 898 2369 881 2367 851 2350 840 2348 840 2346 840 2343 840 2281 851 2242 840 2239 840 2237 840 2235 840 2213 851 2109 840 2107 840 2055 851 2032 840 2029 840 2027 840 1917 851 1886 840 1884 840 1882 840 1817 851 1752 840 1750 840 1748 840 1720 851 1674 840 1672 840 1670 840 1668 840 1666 840 1648 853 1479 853 1455 842 1453 842 1451 842 775 853 659 842 656 842 596 855 598 885"/>
                        </Shape>
                        <String CONTENT="trained, nor are the drivers so skilful, as are the Koryak or the Kamchadal."/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l6" HPOS="596" VPOS="909" WIDTH="1776" HEIGHT="52" BASELINE="598 944 2372 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 944 598 961 2369 957 2372 939 2367 911 596 909 598 944"/>
                        </Shape>
                        <String CONTENT="Maydell asserts that on the Lower Kolyma a team of from twelve to fourteen"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l7" HPOS="594" VPOS="961" WIDTH="1778" HEIGHT="67" BASELINE="596 1004 2372 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1004 596 1017 687 1028 689 1028 691 1028 693 1028 713 1017 1228 1017 1339 1028 1341 1028 1421 1017 1464 1028 1466 1028 1468 1028 1568 1017 2369 1017 2372 1000 2367 967 615 961 613 961 611 961 609 961 594 967 596 1004"/>
                        </Shape>
                        <String CONTENT="dogs can haul a load of 60 puds (2160 pounds Avoirdupois), which would"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l8" HPOS="594" VPOS="1019" WIDTH="1780" HEIGHT="61" BASELINE="596 1065 2374 1061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1065 596 1080 2372 1076 2374 1061 2369 1030 1507 1019 1505 1019 1438 1030 814 1022 812 1022 594 1032 596 1065"/>
                        </Shape>
                        <String CONTENT="average about 154-180 pounds for each dog.¹ This is evidently a mistake, since"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l9" HPOS="598" VPOS="1093" WIDTH="1776" HEIGHT="48" BASELINE="598 1121 2374 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1121 598 1141 2374 1141 2374 1121 2374 1093 598 1093 598 1121"/>
                        </Shape>
                        <String CONTENT="even postal reindeer-teams often carry only 6 puds on each sledge, which makes"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l10" HPOS="611" VPOS="1134" WIDTH="1763" HEIGHT="78" BASELINE="613 1188 2374 1180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 1188 615 1212 641 1201 934 1210 936 1210 1072 1199 1371 1208 1373 1208 2372 1193 2374 1180 2369 1147 2071 1134 2068 1134 2003 1145 1980 1134 1977 1134 1975 1134 1973 1134 1930 1147 1895 1136 1893 1136 1891 1136 1733 1147 1650 1136 1648 1136 1583 1147 1557 1136 1555 1136 1553 1136 1488 1149 1109 1138 1107 1138 1105 1138 1102 1138 1089 1149 1033 1141 1031 1141 903 1151 871 1141 869 1141 866 1141 864 1141 834 1151 799 1141 797 1141 795 1141 793 1141 771 1151 732 1141 730 1141 728 1141 611 1151 613 1188"/>
                        </Shape>
                        <String CONTENT="3 puds (108 pounds Avoirdupois) for each reindeer. The dog-drivers of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l11" HPOS="598" VPOS="1206" WIDTH="1774" HEIGHT="54" BASELINE="598 1242 2372 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1242 598 1260 2372 1260 2372 1242 2372 1212 598 1206 598 1242"/>
                        </Shape>
                        <String CONTENT="Kolyma allow for each dog (according to a local saying) “1 pud to carry, 1000"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l12" HPOS="596" VPOS="1264" WIDTH="1773" HEIGHT="65" BASELINE="598 1299 2369 1303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1299 596 1316 607 1325 609 1325 611 1325 723 1327 726 1327 791 1316 1455 1327 1458 1327 1460 1327 1484 1316 2346 1329 2348 1329 2350 1329 2352 1329 2367 1316 2369 1303 2367 1271 598 1264 598 1299"/>
                        </Shape>
                        <String CONTENT="herrings to store” (i. e., for winter food). The “herrings” mentioned are, properly"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l13" HPOS="596" VPOS="1327" WIDTH="1516" HEIGHT="63" BASELINE="598 1357 2112 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1357 596 1374 611 1385 613 1385 615 1385 617 1385 1536 1377 1551 1387 1553 1387 1555 1387 1557 1387 1785 1379 1830 1390 1832 1390 1834 1390 2109 1377 2112 1364 2109 1333 598 1327 598 1357"/>
                        </Shape>
                        <String CONTENT="speaking, not herrings at all, but of the species Coregonus albula."/>
                    </TextLine>
<TextLine ID="mz_1-150_l14" HPOS="706" VPOS="1379" WIDTH="1668" HEIGHT="58" BASELINE="706 1422 2374 1422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 1422 706 1437 2372 1437 2374 1422 2372 1392 2268 1379 2265 1379 2200 1390 2103 1379 2101 1379 2099 1379 2055 1390 1986 1379 1984 1379 1982 1379 1954 1390 1865 1379 1863 1379 1860 1379 1837 1390 1772 1379 1769 1379 1767 1379 1739 1390 1705 1379 1702 1379 1700 1379 1698 1379 1672 1390 1594 1379 1592 1379 1590 1379 1564 1390 1546 1379 1544 1379 1542 1379 1540 1379 1538 1379 1503 1390 1488 1379 1486 1379 1484 1379 1481 1379 1425 1390 1369 1379 1367 1379 1365 1379 1334 1392 1180 1392 1165 1379 1163 1379 1161 1379 1159 1379 1157 1379 1128 1392 999 1392 986 1379 983 1379 981 1379 979 1379 706 1385 706 1422"/>
                        </Shape>
                        <String CONTENT="Middendorff says that on the Yenisei each dog is reckoned as able to"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l15" HPOS="594" VPOS="1437" WIDTH="1775" HEIGHT="72" BASELINE="596 1483 2369 1476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1483 596 1498 702 1509 704 1509 706 1509 708 1509 723 1498 2367 1498 2369 1476 2365 1448 1802 1437 1800 1437 1798 1437 1772 1448 1235 1439 1232 1439 1148 1450 808 1442 806 1442 594 1452 596 1483"/>
                        </Shape>
                        <String CONTENT="carry not more than 100 Russian pounds’ weight (90 pounds Avoirdupois)."/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l16" HPOS="600" VPOS="1496" WIDTH="1772" HEIGHT="60" BASELINE="602 1541 2372 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="602 1541 602 1556 2369 1552 2372 1537 2367 1509 2289 1496 2287 1496 2285 1496 2248 1506 2185 1496 2183 1496 2181 1496 2157 1509 2038 1509 2014 1496 2012 1496 2010 1496 2008 1496 1986 1506 1921 1496 1919 1496 1542 1506 1516 1496 1514 1496 1512 1496 1510 1496 1473 1509 1304 1498 1302 1498 1300 1498 1254 1511 1124 1511 1107 1498 1105 1498 1102 1498 1100 1498 1001 1509 600 1504 602 1541"/>
                        </Shape>
                        <String CONTENT="This is also too high an estimate, and seems improbable, since a few lines"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l17" HPOS="596" VPOS="1565" WIDTH="1776" HEIGHT="52" BASELINE="598 1600 2372 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1600 598 1617 2369 1613 2372 1595 2365 1565 596 1565 598 1600"/>
                        </Shape>
                        <String CONTENT="before he calls the system of attaching the dogs on the Yenisei undeveloped"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l18" HPOS="596" VPOS="1613" WIDTH="457" HEIGHT="71" BASELINE="598 1660 1053 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1660 598 1673 817 1684 819 1684 821 1684 849 1673 1025 1682 1027 1682 1029 1682 1053 1669 1053 1656 1042 1613 1027 1623 927 1613 925 1613 923 1613 921 1613 905 1623 886 1613 884 1613 882 1613 879 1613 877 1613 860 1623 838 1613 836 1613 834 1613 832 1613 830 1613 808 1626 672 1615 669 1615 596 1628 598 1660"/>
                        </Shape>
                        <String CONTENT="and full of defects.²"/>
                    </TextLine>
<TextLine ID="mz_1-150_l19" HPOS="704" VPOS="1686" WIDTH="1668" HEIGHT="61" BASELINE="706 1719 2372 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 1719 706 1736 1224 1747 1226 1747 1228 1747 1230 1747 1245 1736 1438 1736 1536 1747 1538 1747 1609 1734 1774 1745 1776 1745 1830 1734 2146 1745 2148 1745 2369 1732 2372 1714 2367 1686 704 1686 706 1719"/>
                        </Shape>
                        <String CONTENT="In dragging a heavily loaded sledge, the dogs take advantage of its"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l20" HPOS="596" VPOS="1747" WIDTH="1773" HEIGHT="60" BASELINE="596 1779 2369 1779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1779 596 1792 652 1805 654 1807 786 1807 786 1805 788 1805 791 1805 806 1794 970 1805 973 1805 975 1805 1014 1794 1421 1805 1423 1805 1479 1794 1542 1805 1544 1805 1546 1805 1585 1794 1752 1805 1754 1805 2369 1799 2369 1779 2369 1751 596 1747 596 1779"/>
                        </Shape>
                        <String CONTENT="impetus, for they can draw it along only at a rapid pace. When stopped,"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l21" HPOS="596" VPOS="1797" WIDTH="1771" HEIGHT="60" BASELINE="598 1840 2367 1836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1840 598 1855 2363 1857 2367 1836 2363 1807 1481 1797 1479 1797 1477 1797 1455 1807 615 1799 613 1799 611 1799 609 1799 596 1805 598 1840"/>
                        </Shape>
                        <String CONTENT="they cannot even start again without the help of the driver. When going up"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l22" HPOS="596" VPOS="1862" WIDTH="1771" HEIGHT="56" BASELINE="598 1896 2367 1901" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1896 596 1909 2363 1918 2367 1901 2365 1868 598 1862 598 1896"/>
                        </Shape>
                        <String CONTENT="hill, the driver has to walk along and pull the sledge with his utmost strength,"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l23" HPOS="598" VPOS="1929" WIDTH="1769" HEIGHT="45" BASELINE="598 1959 2367 1959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1959 598 1972 2365 1974 2367 1959 2367 1929 598 1929 598 1959"/>
                        </Shape>
                        <String CONTENT="and at especially steep places he sometimes has to partially unload. Every"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l24" HPOS="596" VPOS="1974" WIDTH="1773" HEIGHT="61" BASELINE="598 2020 2369 2015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2020 598 2035 2367 2030 2369 2015 2365 1987 2307 1974 2304 1974 2302 1974 2261 1985 2103 1974 2101 1974 2099 1974 2066 1987 1889 1987 1817 1974 1815 1974 1813 1974 1791 1985 1637 1974 1635 1974 1477 1987 1339 1976 1336 1976 1334 1976 1310 1989 1144 1989 1107 1976 1105 1976 1102 1976 1100 1976 1066 1987 1012 1976 1009 1976 1007 1976 977 1987 901 1976 899 1976 845 1987 801 1976 799 1976 797 1976 689 1987 613 1976 611 1976 609 1976 607 1976 596 1985 598 2020"/>
                        </Shape>
                        <String CONTENT="five or six miles the dogs are given a rest of about five or ten minutes, after"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l25" HPOS="598" VPOS="2033" WIDTH="1774" HEIGHT="67" BASELINE="600 2080 2372 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2080 600 2095 2352 2100 2354 2100 2356 2100 2359 2100 2372 2089 2372 2074 2367 2046 1858 2033 1856 2033 1772 2046 1756 2035 1754 2035 1752 2035 1750 2035 1748 2035 1718 2046 1501 2035 1499 2035 1497 2035 1464 2046 1434 2035 1432 2035 1429 2035 1250 2046 1189 2035 1187 2035 1185 2035 1150 2048 1107 2037 1105 2037 1102 2037 862 2048 773 2037 771 2037 769 2037 736 2048 639 2037 637 2037 635 2037 598 2050 600 2080"/>
                        </Shape>
                        <String CONTENT="which they start again with renewed vigor. In the middle of the day there"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l26" HPOS="598" VPOS="2093" WIDTH="1771" HEIGHT="72" BASELINE="600 2139 2369 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2139 600 2154 784 2154 825 2165 827 2165 830 2165 1007 2154 1105 2165 1107 2165 1271 2154 1308 2165 1310 2165 1313 2165 1440 2154 1479 2165 1481 2165 1484 2165 1486 2165 1488 2165 1510 2152 1562 2162 1564 2162 1614 2152 1642 2162 1644 2162 1646 2162 2367 2150 2369 2134 2365 2106 2133 2093 2131 2093 2129 2093 2127 2093 2112 2106 1962 2106 1938 2093 1936 2093 1934 2093 1841 2104 1793 2093 1791 2093 1789 2093 1687 2104 1661 2093 1659 2093 1657 2093 1596 2104 1520 2093 1518 2093 1432 2106 1349 2095 1347 2095 921 2106 830 2095 827 2095 769 2106 641 2095 639 2095 637 2095 598 2108 600 2139"/>
                        </Shape>
                        <String CONTENT="will be given a longer rest (Plate VI, Fig. 4), perhaps three-quarters of an"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l27" HPOS="598" VPOS="2165" WIDTH="1730" HEIGHT="49" BASELINE="600 2197 2328 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2197 600 2214 2326 2210 2328 2193 2324 2165 598 2165 600 2197"/>
                        </Shape>
                        <String CONTENT="hour, while the driver melts snow for drinking, and cooks food for himself."/>
                    </TextLine>
<TextLine ID="mz_1-150_l28" HPOS="713" VPOS="2214" WIDTH="1654" HEIGHT="61" BASELINE="713 2258 2367 2258" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="713 2258 713 2275 2365 2275 2367 2258 2365 2227 2250 2214 2248 2214 2246 2214 2218 2227 2099 2227 2084 2214 2081 2214 2079 2214 2077 2214 2075 2214 2027 2225 1941 2214 1938 2214 1936 2214 1906 2225 1843 2214 1841 2214 1754 2225 1737 2214 1735 2214 1733 2214 1731 2214 1655 2227 1564 2227 1549 2214 1546 2214 1544 2214 1542 2214 1540 2214 1512 2225 713 2219 713 2258"/>
                        </Shape>
                        <String CONTENT="While in harness, the dogs are perhaps still wilder than when at large."/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l29" HPOS="602" VPOS="2275" WIDTH="1767" HEIGHT="61" BASELINE="602 2316 2369 2316" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="602 2316 602 2336 2367 2336 2369 2316 2367 2288 2283 2275 2281 2275 2278 2275 2242 2286 2174 2275 2172 2275 2170 2275 2135 2286 1847 2275 1845 2275 1774 2286 1694 2275 1692 2275 1642 2286 1605 2275 1603 2275 1601 2275 1598 2275 1568 2286 1525 2275 1523 2275 1520 2275 1423 2286 1395 2275 1393 2275 1391 2275 1388 2275 1362 2286 1328 2275 1326 2275 1323 2275 1321 2275 1276 2286 1245 2275 1243 2275 1241 2275 1239 2275 1237 2275 1222 2288 1081 2288 1035 2275 1033 2275 1031 2275 1029 2275 1027 2275 1012 2288 910 2288 821 2275 819 2275 817 2275 775 2286 706 2275 704 2275 702 2275 656 2286 626 2275 624 2275 622 2275 620 2275 617 2275 602 2284 602 2316"/>
                        </Shape>
                        <String CONTENT="A wild reindeer, a hare, or the fresh smell of seal, is quite enough to lure them"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l30" HPOS="598" VPOS="2347" WIDTH="1771" HEIGHT="47" BASELINE="598 2377 2369 2377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2377 598 2394 2369 2394 2369 2377 2369 2347 598 2347 598 2377"/>
                        </Shape>
                        <String CONTENT="off the track, regardless of the driver. When passing by a reindeer-herd, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l31" HPOS="596" VPOS="2401" WIDTH="1773" HEIGHT="49" BASELINE="598 2431 2369 2435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2431 596 2446 2365 2450 2369 2435 2367 2405 598 2401 598 2431"/>
                        </Shape>
                        <String CONTENT="dog-driver may always calculate that the excited animals will carry him into the"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l32" HPOS="598" VPOS="2466" WIDTH="1769" HEIGHT="49" BASELINE="598 2496 2367 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2496 598 2513 2365 2515 2367 2496 2367 2466 598 2466 598 2496"/>
                        </Shape>
                        <String CONTENT="middle of the herd, and may even succeed in seizing a reindeer, notwithstanding"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l33" HPOS="598" VPOS="2513" WIDTH="1611" HEIGHT="59" BASELINE="598 2557 2209 2557" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2557 598 2572 2209 2572 2209 2557 2209 2526 2144 2513 2060 2513 2058 2513 2055 2513 2053 2513 2042 2524 2001 2513 1999 2513 1997 2513 1995 2513 1964 2524 1932 2513 1930 2513 1928 2513 1821 2524 1709 2513 1707 2513 1614 2524 1540 2513 1538 2513 1536 2513 1510 2524 1460 2513 1458 2513 1455 2513 1453 2513 1436 2526 1206 2526 1092 2513 1089 2513 1087 2513 1050 2524 951 2513 949 2513 890 2524 806 2513 804 2513 678 2524 624 2513 622 2513 620 2513 598 2524 598 2557"/>
                        </Shape>
                        <String CONTENT="the exertions of the driver to arrest the heavy sledge with the brake."/>
                    </TextLine>
<TextLine ID="mz_1-150_l34" HPOS="708" VPOS="2576" WIDTH="1657" HEIGHT="65" BASELINE="710 2611 2365 2615" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="710 2611 708 2624 791 2639 793 2639 795 2639 797 2639 812 2628 873 2639 875 2639 942 2628 957 2639 960 2639 962 2639 964 2639 1157 2628 1477 2639 1479 2639 1481 2639 1505 2628 1538 2641 1540 2641 1542 2641 2363 2628 2365 2615 2363 2585 710 2576 710 2611"/>
                        </Shape>
                        <String CONTENT="The dogs preserve their hunting qualities, even while in harness. A"/>
                    </TextLine>

                    <TextLine ID="mz_1-150_l35" HPOS="596" VPOS="2630" WIDTH="1773" HEIGHT="61" BASELINE="598 2676 2369 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2676 598 2691 2367 2686 2369 2671 2365 2643 2233 2630 2231 2630 2229 2630 2198 2641 2164 2630 2161 2630 2159 2630 2107 2641 1869 2630 1867 2630 1793 2641 1737 2630 1735 2630 1609 2641 1583 2630 1581 2630 1579 2630 1479 2643 1419 2632 1416 2632 1414 2632 1382 2643 1289 2632 1287 2632 1150 2643 1113 2632 1111 2632 1109 2632 979 2643 853 2632 851 2632 849 2632 819 2643 615 2632 613 2632 611 2632 609 2632 596 2641 598 2676"/>
                        </Shape>
