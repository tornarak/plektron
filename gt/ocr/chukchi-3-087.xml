                        </Shape>
                        <String CONTENT="In combinations where large and small herds are joined together, the"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l22" HPOS="432" VPOS="1724" WIDTH="1770" HEIGHT="54" BASELINE="432 1763 2202 1763" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="432 1763 432 1778 2200 1778 2202 1763 2202 1735 2161 1724 2159 1724 2157 1724 2155 1724 2116 1733 2026 1724 2024 1724 2022 1724 1987 1733 1847 1724 1845 1724 1744 1733 1701 1724 1699 1724 1697 1724 1557 1735 1342 1735 1317 1724 1315 1724 1313 1724 1311 1724 1272 1733 1163 1724 1161 1724 1159 1724 1128 1733 910 1724 908 1724 853 1735 707 1735 691 1724 689 1724 687 1724 685 1724 639 1733 565 1724 563 1724 432 1731 432 1763"/>
                        </Shape>
                        <String CONTENT="families of new assistants receive only a part of their subsistence from the"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l23" HPOS="430" VPOS="1786" WIDTH="1768" HEIGHT="62" BASELINE="432 1825 2198 1819" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="432 1825 432 1839 588 1848 590 1848 592 1848 594 1848 609 1839 841 1839 915 1848 917 1848 1806 1835 2194 1844 2198 1819 2194 1790 530 1786 528 1786 430 1796 432 1825"/>
                        </Shape>
                        <String CONTENT="master, and take another portion from their own herd. At each slaughtering"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l24" HPOS="432" VPOS="1844" WIDTH="1766" HEIGHT="55" BASELINE="434 1883 2198 1879" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1883 434 1899 2196 1897 2198 1879 2194 1852 450 1844 448 1844 446 1844 444 1844 432 1850 434 1883"/>
                        </Shape>
                        <String CONTENT="the herdsmen slaughter such animals as the master points out, and carry them"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l25" HPOS="432" VPOS="1903" WIDTH="1772" HEIGHT="54" BASELINE="434 1944 2204 1940" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1944 434 1957 2202 1953 2204 1940 2200 1903 1323 1903 1321 1903 1319 1903 1317 1903 1303 1913 450 1905 448 1905 446 1905 444 1905 432 1911 434 1944"/>
                        </Shape>
                        <String CONTENT="to the entrance of such and such a house, according to his order; then, if"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l26" HPOS="430" VPOS="1961" WIDTH="1772" HEIGHT="57" BASELINE="432 2004 2202 1998" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="432 2004 432 2018 2200 2016 2202 1998 2198 1973 1948 1961 1946 1961 1944 1961 1919 1973 1777 1973 1744 1961 1742 1961 1740 1961 1681 1971 1586 1963 1584 1963 1582 1963 1561 1973 1241 1963 1239 1963 1190 1973 943 1965 941 1965 939 1965 908 1975 738 1965 736 1965 734 1965 713 1975 580 1965 578 1965 576 1965 574 1965 559 1975 450 1967 448 1967 446 1967 444 1967 430 1973 432 2004"/>
                        </Shape>
                        <String CONTENT="some house is left without an animal, the people catch one of their own"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l27" HPOS="430" VPOS="2022" WIDTH="1772" HEIGHT="56" BASELINE="432 2065 2202 2061" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="432 2065 432 2078 2200 2076 2202 2061 2198 2033 2019 2022 2017 2022 1956 2031 1921 2022 1919 2022 1917 2022 1726 2031 1672 2022 1670 2022 1668 2022 1666 2022 1650 2033 1483 2033 1428 2022 1426 2022 1424 2022 1422 2022 1407 2033 1295 2033 1241 2024 1239 2024 1034 2033 1001 2024 999 2024 997 2024 995 2024 966 2033 781 2024 779 2024 777 2024 754 2033 709 2024 707 2024 621 2033 479 2024 477 2024 475 2024 430 2035 432 2065"/>
                        </Shape>
                        <String CONTENT="reindeer and slaughter it. In this case, however, the connection between"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l28" HPOS="434" VPOS="2094" WIDTH="1742" HEIGHT="45" BASELINE="434 2123 2176 2123" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 2123 434 2139 2176 2139 2176 2123 2176 2094 434 2094 434 2123"/>
                        </Shape>
                        <String CONTENT="master and assistant is not very strong, and may in a short time be dissolved."/>
                    </TextLine>
</TextBlock>
