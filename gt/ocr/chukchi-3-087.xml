                        </Shape>
                        <String CONTENT="food, also a few live fawns, as a yearly present. In the latter part of the"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l31" HPOS="436" VPOS="2263" WIDTH="1764" HEIGHT="55" BASELINE="436 2300 2200 2300" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 2300 436 2316 2198 2318 2200 2300 2200 2275 2132 2263 2130 2263 1966 2273 1911 2263 1909 2263 1814 2273 1771 2263 1769 2263 1767 2263 1709 2273 1496 2263 1494 2263 1492 2263 1471 2275 1344 2275 1290 2263 1288 2263 1188 2273 1091 2263 1089 2263 1087 2263 1065 2275 871 2275 752 2263 750 2263 748 2263 713 2273 658 2263 656 2263 654 2263 652 2263 635 2275 436 2275 436 2300"/>
                        </Shape>
