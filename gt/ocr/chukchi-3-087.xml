                        <Shape>
                            <Polygon POINTS="428 1646 428 1657 1878 1657 1880 1642 1876 1614 541 1607 539 1607 426 1616 428 1646"/>
                        </Shape>
                        <String CONTENT="remaining for some years in circumstances not utterly hopeless."/>
                    </TextLine>
</TextBlock>
