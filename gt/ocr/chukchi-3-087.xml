                        </Shape>
                        <String CONTENT="be in the possession of the master only, with the exception of a very few,"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l6" HPOS="424" VPOS="763" WIDTH="1768" HEIGHT="62" BASELINE="426 802 2192 806" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="426 802 424 813 2188 825 2192 806 2190 776 2126 765 2124 765 1594 774 1506 765 1504 765 1502 765 1500 765 1485 776 1329 776 1311 763 1309 763 1307 763 1305 763 1247 772 1167 763 1165 763 1163 763 1126 772 1028 763 1027 763 1025 763 991 772 773 763 771 763 717 772 625 763 623 763 621 763 586 772 547 763 545 763 543 763 426 771 426 802"/>
                        </Shape>
                        <String CONTENT="which the assistant may have from his own reindeer. Therefore the master,"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l7" HPOS="426" VPOS="825" WIDTH="1770" HEIGHT="55" BASELINE="426 864 2196 864" TAGREFS="TYPE_6">
                        <Shape>
