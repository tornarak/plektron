                        <Shape>
                            <Polygon POINTS="426 923 426 940 2192 938 2194 919 2192 893 2151 882 2149 882 2147 882 2145 882 2116 891 2071 882 2069 882 1962 893 1539 893 1523 882 1522 882 1520 882 1518 882 1416 891 1323 882 1321 882 1319 882 1317 882 1299 893 424 887 426 923"/>
                        </Shape>
                        <String CONTENT="home, and give to his assistants, especially if they were not successful in the"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l9" HPOS="426" VPOS="942" WIDTH="1770" HEIGHT="66" BASELINE="428 983 2196 977" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 983 428 999 533 1008 535 1008 537 1008 539 1008 555 999 2194 999 2196 977 2190 942 426 948 428 983"/>
                        </Shape>
                        <String CONTENT="hunt, and thus were short of means for making purchases. In the course of"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l10" HPOS="424" VPOS="1002" WIDTH="1772" HEIGHT="57" BASELINE="426 1045 2196 1041" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="426 1045 426 1059 2194 1057 2196 1041 2192 1014 2126 1002 2124 1002 2073 1012 1937 1002 1935 1002 1933 1002 1900 1012 1859 1002 1857 1002 1855 1002 1804 1012 1249 1004 1247 1004 1245 1004 1243 1004 1227 1014 845 1004 843 1004 841 1004 798 1014 738 1004 736 1004 627 1014 563 1004 561 1004 559 1004 533 1014 448 1004 446 1004 444 1004 442 1004 424 1012 426 1045"/>
                        </Shape>
                        <String CONTENT="time the master will give to his assistants some of his tea and tobacco, when"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l11" HPOS="428" VPOS="1065" WIDTH="1479" HEIGHT="54" BASELINE="428 1104 1907 1104" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 1104 428 1119 1907 1119 1907 1104 1907 1076 1828 1065 1826 1065 1824 1065 1790 1075 1549 1065 1547 1065 1490 1075 1447 1065 1446 1065 1444 1065 1442 1065 1407 1075 1373 1065 1371 1065 1370 1065 1323 1075 1295 1065 1294 1065 1292 1065 1290 1065 1255 1076 962 1076 898 1065 896 1065 894 1065 892 1065 880 1076 658 1076 551 1065 549 1065 547 1065 545 1065 531 1075 450 1065 448 1065 446 1065 428 1073 428 1104"/>
                        </Shape>
                        <String CONTENT="they have none; at least, a master who is “good” will act thus."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-087_r3" HPOS="432" VPOS="1124" WIDTH="1782" HEIGHT="551" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="432 1124 2214 1124 2214 1675 432 1675"/>
                    </Shape>
                    <TextLine ID="mz_3-087_l12" HPOS="535" VPOS="1131" WIDTH="1659" HEIGHT="55" BASELINE="537 1164 2194 1160" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="537 1164 537 1178 1874 1186 1876 1186 1878 1186 1880 1186 1894 1176 1995 1176 2190 1186 2194 1160 2190 1131 535 1131 537 1164"/>
                        </Shape>
                        <String CONTENT="Not rarely is it the case that a family whose prosperity has declined,"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l13" HPOS="426" VPOS="1195" WIDTH="1768" HEIGHT="51" BASELINE="426 1225 2194 1225" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="426 1225 426 1238 2192 1246 2194 1225 2194 1195 426 1195 426 1225"/>
                        </Shape>
                        <String CONTENT="and whose herd is not large enough to provide for their subsistence, prefers,"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l14" HPOS="426" VPOS="1242" WIDTH="1770" HEIGHT="57" BASELINE="428 1285 2196 1281" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 1285 428 1299 2194 1295 2196 1281 2194 1254 2153 1242 2151 1242 2149 1242 2096 1252 2056 1242 2054 1242 2052 1242 1987 1254 1853 1254 1837 1242 1835 1242 1833 1242 1831 1242 1829 1242 1792 1254 1609 1254 1588 1242 1586 1242 1584 1242 1582 1242 1549 1252 1504 1242 1502 1242 1430 1252 1276 1244 1274 1244 1272 1244 1270 1244 1255 1254 1114 1244 1005 1244 1003 1244 1001 1244 999 1244 984 1254 871 1244 869 1244 426 1250 428 1285"/>
                        </Shape>
                        <String CONTENT="instead of continuing a half-hungry life, to join the camp of some rich rein-"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l15" HPOS="426" VPOS="1310" WIDTH="1770" HEIGHT="47" BASELINE="428 1340 2196 1343" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 1340 426 1353 2192 1357 2196 1343 2194 1314 428 1310 428 1340"/>
                        </Shape>
                        <String CONTENT="deer-breeder short of hands. Of course, rich owners sometimes have misgivings"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l16" HPOS="426" VPOS="1363" WIDTH="1772" HEIGHT="56" BASELINE="428 1404 2198 1400" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 1404 428 1419 2196 1418 2198 1400 2194 1363 561 1363 559 1363 426 1373 428 1404"/>
                        </Shape>
                        <String CONTENT="regarding such impoverished neighbors, fearing that the bad luck of their herd"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l17" HPOS="426" VPOS="1419" WIDTH="1772" HEIGHT="69" BASELINE="428 1464 2198 1458" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="428 1464 428 1478 572 1488 574 1488 576 1488 602 1478 958 1478 995 1488 997 1488 999 1488 1001 1488 1003 1488 1023 1476 1245 1486 1247 1486 1543 1476 1590 1486 1592 1486 1648 1474 1664 1484 1666 1484 1668 1484 1670 1484 1734 1474 1785 1484 1787 1484 1861 1474 2145 1484 2147 1484 2196 1472 2198 1458 2196 1431 2159 1419 2157 1419 2155 1419 2153 1419 2122 1429 2065 1419 2063 1419 2061 1419 2059 1419 2044 1431 1933 1431 1907 1419 1905 1419 1904 1419 1902 1419 1865 1429 1837 1419 1835 1419 1833 1419 1722 1429 1676 1419 1674 1419 1672 1419 1670 1419 1654 1429 1607 1419 1605 1419 1543 1431 1496 1421 1494 1421 1492 1421 1461 1431 1424 1421 1422 1421 1420 1421 1418 1421 1416 1421 1401 1433 1130 1433 1042 1421 1040 1421 1038 1421 1013 1433 711 1423 709 1423 707 1423 705 1423 689 1435 426 1435 428 1464"/>
                        </Shape>
                        <String CONTENT="may prove detrimental to their own prosperity.¹ Still the need of extra herds-"/>
                    </TextLine>

                    <TextLine ID="mz_3-087_l18" HPOS="430" VPOS="1484" WIDTH="1770" HEIGHT="56" BASELINE="430 1523 2200 1523" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="430 1523 430 1540 2198 1540 2200 1523 2198 1496 2145 1484 2143 1484 2091 1494 2036 1484 2034 1484 1744 1494 1691 1484 1689 1484 1629 1494 1576 1484 1574 1484 1523 1494 1436 1484 1434 1484 1432 1484 1430 1484 1412 1496 1249 1496 1196 1484 1194 1484 1192 1484 1167 1494 1140 1484 1138 1484 1136 1484 1134 1484 1132 1484 1116 1496 1013 1496 962 1484 960 1484 958 1484 956 1484 941 1496 721 1496 645 1484 643 1484 592 1494 555 1484 553 1484 551 1484 549 1484 547 1484 531 1496 430 1496 430 1523"/>
                        </Shape>
                        <String CONTENT="men is often stronger than such fear; especially when the poorer family, after"/>
                    </TextLine>

