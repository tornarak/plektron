                    <TextLine ID="mz_3-110_l2" HPOS="1188" VPOS="453" WIDTH="614" HEIGHT="51" BASELINE="1188 484 1802 484" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1792 466 1779 453 1202 453 1190 470 1188 484 1188 504 1802 504 1802 484 1800 478 1792 466"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-110_r2" HPOS="613" VPOS="547" WIDTH="1782" HEIGHT="818" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="613 547 2395 547 2395 1365 613 1365"/>
                    </Shape>
                    <TextLine ID="mz_3-110_l3" HPOS="611" VPOS="556" WIDTH="1770" HEIGHT="47" BASELINE="613 585 2381 581" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2365 560 2346 560 2326 558 2307 558 2287 558 2268 556 2248 556 2229 556 611 556 613 585 613 603 2379 603 2381 581 2377 560 2365 560"/>
                        </Shape>
                        <String CONTENT="in leaving his master on a lone island in the open sea. Then he came back and took possession"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l4" HPOS="613" VPOS="605" WIDTH="1602" HEIGHT="43" BASELINE="613 630 2215 630" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 630 613 648 2215 648 2215 630 2215 605 613 605 613 630"/>
                        </Shape>
                        <String CONTENT="of all his wealth. He ceased to be a good assistant, and spoke with his old harsh voice."/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l5" HPOS="722" VPOS="646" WIDTH="1661" HEIGHT="47" BASELINE="724 673 2383 679" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="724 673 722 687 2379 693 2383 679 2381 652 724 646 724 673"/>
                        </Shape>
                        <String CONTENT="“He remained in the sleeping-room the whole time, and defecated there in a chamber-vessel."/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l6" HPOS="615" VPOS="691" WIDTH="1768" HEIGHT="50" BASELINE="615 726 2383 722" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 726 615 741 2381 739 2383 722 2377 691 619 696 615 726"/>
                        </Shape>
                        <String CONTENT="The wives of the master refused to live with him; they did not enter the sleeping-room, but staid"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l7" HPOS="615" VPOS="743" WIDTH="1766" HEIGHT="47" BASELINE="615 772 2381 769" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 772 615 786 2377 790 2381 769 2375 743 623 745 615 772"/>
                        </Shape>
                        <String CONTENT="on the beach, weeping. The next morning the slave said to the boys who went to the herd,"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l8" HPOS="615" VPOS="788" WIDTH="1768" HEIGHT="47" BASELINE="615 817 2383 813" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 817 615 835 2381 831 2383 813 2377 788 625 790 615 817"/>
                        </Shape>
                        <String CONTENT="‘Bring me tomorrow a young fawn that has recently shed its coat. My excrement has a bad odor"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l9" HPOS="613" VPOS="839" WIDTH="1770" HEIGHT="45" BASELINE="613 864 2383 864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 864 613 880 2379 884 2383 864 2381 839 613 839 613 864"/>
                        </Shape>
                        <String CONTENT="from this old, tainted meat. From now on I will feed only on reindeer-tongues.’ They thought,"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l10" HPOS="613" VPOS="882" WIDTH="899" HEIGHT="50" BASELINE="615 909 1512 913" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 909 613 923 633 932 635 932 637 932 1510 924 1512 913 1510 886 627 882 615 909"/>
                        </Shape>
                        <String CONTENT="‘He is going to kill us,’ so they brought the fawn."/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l11" HPOS="726" VPOS="924" WIDTH="1657" HEIGHT="49" BASELINE="726 954 2383 954" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="726 954 726 973 2381 973 2383 954 2379 924 726 928 726 954"/>
                        </Shape>
                        <String CONTENT="“The children wept every day in the herd. Each time when they brought a fawn, they asked"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l12" HPOS="609" VPOS="965" WIDTH="1612" HEIGHT="55" BASELINE="611 1006 2221 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="611 1006 611 1020 2219 1014 2221 1000 2215 965 609 977 611 1006"/>
                        </Shape>
                        <String CONTENT="one another, ‘Will he chastise us, or not? Perhaps we have grown stronger by this time.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l13" HPOS="722" VPOS="1024" WIDTH="1665" HEIGHT="43" BASELINE="722 1049 2387 1049" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="722 1049 722 1067 2387 1067 2387 1049 2387 1024 722 1024 722 1049"/>
                        </Shape>
                        <String CONTENT="“Eleˊndi was miraculously saved by birds, and came to the camp. He met one of his wives"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l14" HPOS="615" VPOS="1061" WIDTH="1768" HEIGHT="54" BASELINE="615 1100 2383 1096" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1100 615 1115 2381 1115 2383 1096 2379 1071 1531 1061 1529 1061 1455 1073 619 1073 615 1100"/>
                        </Shape>
                        <String CONTENT="in the open, and said to her, ‘Go and say to the boys, “The next time when that one asks for a"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l15" HPOS="611" VPOS="1114" WIDTH="1772" HEIGHT="48" BASELINE="613 1147 2383 1139" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 1147 613 1162 2381 1154 2383 1139 2377 1114 611 1119 613 1147"/>
                        </Shape>
                        <String CONTENT="fawn, give for answer, ‘You slave! Where have you gotten the habit of eating fawns and of feed-"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l16" HPOS="615" VPOS="1156" WIDTH="1768" HEIGHT="51" BASELINE="615 1193 2383 1188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1193 615 1207 2381 1203 2383 1188 2379 1162 629 1156 615 1193"/>
                        </Shape>
                        <String CONTENT="ing on tongues?’”’ Hearing this, the Eskimo roared with anger. He bounded out from the inner"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l17" HPOS="615" VPOS="1209" WIDTH="1768" HEIGHT="45" BASELINE="615 1238 2383 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1238 615 1254 2381 1254 2383 1234 2377 1209 625 1211 615 1238"/>
                        </Shape>
                        <String CONTENT="room quite naked. The woman said to him, ‘At least put on your breeches!’ He put on his"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l18" HPOS="615" VPOS="1256" WIDTH="1768" HEIGHT="45" BASELINE="615 1285 2383 1281" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1285 615 1301 2381 1299 2383 1281 2377 1256 623 1258 615 1285"/>
                        </Shape>
                        <String CONTENT="breeches. Then he caught the handle of a scraper and pursued the boys. But Eleˊndi suddenly"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l19" HPOS="615" VPOS="1297" WIDTH="1745" HEIGHT="52" BASELINE="615 1332 2360 1324" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1332 615 1349 2358 1342 2360 1324 2354 1297 623 1305 615 1332"/>
                        </Shape>
                        <String CONTENT="sprang upon him, caught him from behind, and shortly afterwards made him die a cruel death.”¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-110_r3" HPOS="613" VPOS="1373" WIDTH="1782" HEIGHT="915" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="613 1373 2395 1373 2395 2288 613 2288"/>
                    </Shape>
                    <TextLine ID="mz_3-110_l20" HPOS="717" VPOS="1375" WIDTH="1670" HEIGHT="60" BASELINE="719 1419 2387 1414" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="719 1419 719 1435 2385 1429 2387 1414 2383 1386 1944 1375 1943 1375 1890 1384 1841 1375 1839 1375 1837 1375 1796 1386 1775 1377 1773 1377 1771 1377 1451 1386 1438 1377 1436 1377 1434 1377 1344 1377 1342 1377 1258 1388 1188 1379 1186 1379 1184 1379 1155 1388 960 1379 958 1379 717 1386 719 1419"/>
                        </Shape>
                        <String CONTENT="I know of no cases in actual life among the Maritime Chukchee, similar to"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l21" HPOS="613" VPOS="1449" WIDTH="1772" HEIGHT="50" BASELINE="613 1480 2385 1480" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 1480 613 1494 2383 1499 2385 1480 2385 1449 613 1449 613 1480"/>
                        </Shape>
                        <String CONTENT="those described above, and occurring among the Reindeer people. It seems that,"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l22" HPOS="615" VPOS="1496" WIDTH="1774" HEIGHT="58" BASELINE="615 1542 2389 1536" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1542 615 1554 2387 1548 2389 1536 2385 1507 2126 1507 2100 1496 2098 1496 2096 1496 2046 1505 2013 1496 2011 1496 2009 1496 1952 1505 1921 1496 1919 1496 1917 1496 1915 1496 1890 1505 1861 1496 1859 1496 1857 1496 1779 1507 1295 1497 1294 1497 1292 1497 1290 1497 1274 1507 843 1499 841 1499 783 1509 722 1499 721 1499 623 1509 615 1542"/>
                        </Shape>
                        <String CONTENT="on the whole, the Maritime Chukchee, though more daring in character, are"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l23" HPOS="615" VPOS="1554" WIDTH="1772" HEIGHT="70" BASELINE="615 1601 2387 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1601 615 1614 878 1614 929 1624 931 1624 1081 1612 1194 1622 1196 1622 1596 1610 1867 1620 1868 1620 2011 1609 2262 1618 2264 1618 2266 1618 2268 1618 2282 1609 2365 1618 2367 1618 2369 1618 2371 1618 2387 1607 2387 1593 2383 1566 2065 1554 2063 1554 2061 1554 2059 1554 2044 1564 1601 1556 1599 1556 1598 1556 1564 1566 1516 1556 1514 1556 1512 1556 1510 1556 1494 1568 1124 1558 1122 1558 1120 1558 1097 1568 1064 1558 1062 1558 1060 1558 980 1572 695 1572 652 1560 650 1560 648 1560 646 1560 625 1568 615 1601"/>
                        </Shape>
                        <String CONTENT="of a more peaceful disposition than the Reindeer-breeders. “Nothing ever"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l24" HPOS="611" VPOS="1614" WIDTH="1778" HEIGHT="61" BASELINE="613 1661 2389 1655" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="613 1661 613 1675 2387 1671 2389 1655 2385 1626 1796 1614 1794 1614 1792 1614 1790 1614 1769 1626 1504 1616 1502 1616 1500 1616 1469 1626 1418 1616 1416 1616 1414 1616 1381 1626 1346 1616 1344 1616 1342 1616 1340 1616 1321 1626 1284 1616 1282 1616 1280 1616 1198 1628 1126 1618 1124 1618 1023 1630 810 1630 795 1618 793 1618 791 1618 789 1618 611 1626 613 1661"/>
                        </Shape>
                        <String CONTENT="happens among us,” the people in the Chukchee and Eskimo maritime villages"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l25" HPOS="615" VPOS="1675" WIDTH="1774" HEIGHT="58" BASELINE="617 1720 2389 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1720 617 1733 2387 1729 2389 1714 2385 1686 2295 1675 2293 1675 2291 1675 2264 1685 2237 1675 2235 1675 2233 1675 2231 1675 2208 1686 1999 1686 1978 1675 1976 1675 1814 1675 1812 1675 1810 1675 1787 1686 1375 1677 1373 1677 1371 1677 1344 1686 857 1679 855 1679 853 1679 851 1679 836 1690 730 1690 662 1679 660 1679 658 1679 615 1690 617 1720"/>
                        </Shape>
                        <String CONTENT="told me, “though we have no officers. At times of drinking, some of those"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l26" HPOS="615" VPOS="1735" WIDTH="1774" HEIGHT="59" BASELINE="617 1778 2389 1772" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1778 617 1794 2387 1790 2389 1772 2385 1747 2217 1735 2215 1735 2171 1745 2139 1735 2137 1735 2135 1735 2034 1745 1978 1735 1976 1735 1878 1745 1839 1735 1837 1735 1835 1735 1833 1735 1831 1735 1816 1745 1650 1737 1648 1737 1527 1747 1473 1737 1471 1737 1469 1737 1467 1737 1449 1749 1264 1749 1208 1737 1206 1737 1204 1737 1165 1749 951 1739 949 1739 947 1739 915 1749 896 1739 894 1739 892 1739 802 1749 756 1739 754 1739 752 1739 713 1749 656 1739 654 1739 652 1739 615 1751 617 1778"/>
                        </Shape>
                        <String CONTENT="who do not drink act like your police, and quiet down those who become"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l27" HPOS="615" VPOS="1794" WIDTH="1770" HEIGHT="60" BASELINE="617 1840 2385 1835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1840 617 1854 2383 1852 2385 1835 2377 1794 2346 1803 2313 1794 2311 1794 2309 1794 2307 1794 2278 1805 2120 1805 2063 1794 2061 1794 2059 1794 2038 1803 1976 1794 1974 1794 1925 1803 1898 1794 1896 1794 1894 1794 1781 1805 1722 1796 1720 1796 1718 1796 1691 1805 1625 1796 1623 1796 1621 1796 1596 1807 1434 1807 1356 1796 1354 1796 1290 1805 1235 1796 1233 1796 1231 1796 1202 1807 1141 1798 1140 1798 853 1807 785 1798 783 1798 615 1809 617 1840"/>
                        </Shape>
                        <String CONTENT="aggressive, even binding them if necessary.” Among the Maritime people I"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l28" HPOS="619" VPOS="1854" WIDTH="1770" HEIGHT="61" BASELINE="619 1901 2389 1893" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1901 619 1915 2387 1907 2389 1893 2385 1866 2100 1854 2098 1854 2096 1854 2095 1854 2079 1866 1943 1866 1592 1856 1590 1856 1588 1856 1586 1856 1572 1866 1504 1856 1502 1856 1500 1856 1451 1868 1368 1858 1366 1858 1319 1868 1136 1858 1134 1858 986 1870 641 1860 639 1860 637 1860 635 1860 629 1862 619 1901"/>
                        </Shape>
                        <String CONTENT="have even met men who refused to drink brandy; while among the Reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l29" HPOS="619" VPOS="1918" WIDTH="1770" HEIGHT="57" BASELINE="619 1959 2389 1953" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1959 619 1975 2387 1969 2389 1953 2385 1926 1239 1918 1237 1918 1235 1918 1204 1928 724 1920 722 1920 627 1930 619 1959"/>
                        </Shape>
                        <String CONTENT="breeders such a thing is almost unknown, even among the women, with the"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l30" HPOS="615" VPOS="1979" WIDTH="1774" HEIGHT="56" BASELINE="617 2018 2389 2012" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2018 617 2035 2387 2029 2389 2012 2385 1987 1311 1979 1309 1979 615 1991 617 2018"/>
                        </Shape>
                        <String CONTENT="exception of those in the most remote parts of the country, on the border-line"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l31" HPOS="619" VPOS="2035" WIDTH="1770" HEIGHT="57" BASELINE="621 2080 2389 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="621 2080 621 2092 2387 2090 2389 2074 2387 2047 2346 2035 2344 2035 2342 2035 2340 2035 2307 2045 2252 2035 2250 2035 2024 2045 1964 2035 1962 2035 1909 2045 1847 2035 1845 2035 1843 2035 1794 2047 1249 2037 1247 2037 1190 2049 656 2039 654 2039 652 2039 619 2051 621 2080"/>
                        </Shape>
                        <String CONTENT="of Kamchatka, where no brandy has ever been sold. On the whole, the"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l32" HPOS="619" VPOS="2094" WIDTH="1770" HEIGHT="60" BASELINE="621 2139 2389 2135" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="621 2139 621 2154 2387 2154 2389 2135 2387 2106 2356 2094 2354 2094 2352 2094 2350 2094 2325 2104 2245 2094 2243 2094 2241 2094 2215 2106 2073 2106 2057 2094 2056 2094 2054 2094 2052 2094 2050 2094 2024 2104 1939 2094 1937 2094 1935 2094 1909 2104 1896 2094 1894 2094 1892 2094 1785 2094 1783 2094 1781 2094 1779 2094 1765 2104 1703 2094 1701 2094 1523 2104 1508 2094 1506 2094 1504 2094 1502 2094 1500 2094 1473 2106 1385 2096 1383 2096 1381 2096 1352 2106 1260 2096 1258 2096 1256 2096 1229 2106 1194 2096 1192 2096 1190 2096 1099 2106 1007 2096 1005 2096 1003 2096 972 2106 958 2096 956 2096 954 2096 952 2096 619 2102 621 2139"/>
                        </Shape>
                        <String CONTENT="Reindeer Chukchee drink less than the Maritime Chukchee, because brandy"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l33" HPOS="619" VPOS="2158" WIDTH="1768" HEIGHT="57" BASELINE="619 2199 2387 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 2199 619 2215 2385 2215 2387 2195 2383 2166 1502 2158 1500 2158 1389 2168 1034 2160 1032 2160 627 2170 619 2199"/>
                        </Shape>
                        <String CONTENT="is more scarce with them; but drunken brawls happen among them much"/>
                    </TextLine>

                    <TextLine ID="mz_3-110_l34" HPOS="619" VPOS="2219" WIDTH="380" HEIGHT="62" BASELINE="621 2259 999 2256" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="621 2259 621 2273 972 2281 974 2281 976 2281 999 2269 999 2256 995 2228 935 2219 933 2219 619 2230 621 2259"/>
                        </Shape>
                        <String CONTENT="more frequently."/>
                    </TextLine>
</TextBlock>
