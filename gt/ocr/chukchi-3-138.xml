                        <Shape>
                            <Polygon POINTS="543 1497 541 1509 2307 1521 2311 1501 2309 1470 543 1466 543 1497"/>
                        </Shape>
                        <String CONTENT="for murder from their youth up, and all three were strong and nimble men;"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l19" HPOS="543" VPOS="1519" WIDTH="1349" HEIGHT="54" BASELINE="543 1560 1892 1560" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="543 1560 543 1572 1890 1573 1892 1560 1892 1531 1822 1519 1820 1519 1818 1519 1790 1529 1769 1519 1767 1519 1765 1519 1677 1529 1021 1519 1019 1519 1017 1519 989 1531 779 1531 748 1519 746 1519 744 1519 742 1519 711 1529 637 1519 635 1519 543 1529 543 1560"/>
                        </Shape>
                        <String CONTENT="so that the wrong of Peñeˊwg̣i was left without retaliation."/>
                    </TextLine>
