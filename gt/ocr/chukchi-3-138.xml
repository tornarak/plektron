                        </Shape>
                        <String CONTENT="of whom I spoke before, Vaatuˊwg̣ê by name, while still quite young, had a"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l11" HPOS="543" VPOS="1038" WIDTH="1770" HEIGHT="62" BASELINE="545 1076 2313 1080" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="545 1076 543 1088 586 1100 588 1100 590 1100 2311 1094 2313 1080 2311 1049 2100 1039 2098 1039 2096 1039 2095 1039 2079 1051 1757 1051 1705 1039 1703 1039 1599 1049 1428 1038 1426 1038 1424 1038 1403 1049 1198 1049 1165 1038 1163 1038 1161 1038 1108 1047 1003 1038 1001 1038 937 1047 886 1038 884 1038 834 1047 779 1038 777 1038 775 1038 748 1047 664 1038 662 1038 545 1045 545 1076"/>
                        </Shape>
                        <String CONTENT="drunken brawl with another young Chukchee, whose name was Peñeˊwg̣i."/>
                    </TextLine>

