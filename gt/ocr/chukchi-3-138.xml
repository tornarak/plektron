                        </Shape>
                        <String CONTENT="one must be able to overcome him in a struggle. Whenever I mentioned"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l6" HPOS="545" VPOS="741" WIDTH="1772" HEIGHT="55" BASELINE="545 780 2317 780" TAGREFS="TYPE_3">
