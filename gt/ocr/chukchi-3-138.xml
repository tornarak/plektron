                        </Shape>
                        <String CONTENT="will be victorious.” This is the leading idea of all ordeals and of single com-"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l8" HPOS="545" VPOS="860" WIDTH="1772" HEIGHT="55" BASELINE="545 899 2317 899" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="545 899 545 915 2317 915 2317 899 2317 872 2221 860 2085 860 2083 860 2081 860 2079 860 2065 870 2044 860 2042 860 2040 860 1921 870 545 864 545 899"/>
                        </Shape>
                        <String CONTENT="bats for the sake of law. In actual life some encounters of this kind have"/>
                    </TextLine>

