                        </Shape>
                        <String CONTENT="Anui River, while I was travelling there. One man, Uˊmkuum by name, took"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l22" HPOS="541" VPOS="1698" WIDTH="1772" HEIGHT="57" BASELINE="543 1739 2313 1735" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="543 1739 543 1755 2311 1755 2313 1735 2307 1700 732 1708 596 1698 594 1698 541 1710 543 1739"/>
                        </Shape>
                        <String CONTENT="a liking to a young woman, the wife of another Chukchee, Oˊoqai, who lived"/>
                    </TextLine>

