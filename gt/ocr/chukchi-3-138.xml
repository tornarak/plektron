                        <Shape>
                            <Polygon POINTS="545 1435 543 1449 2307 1453 2311 1439 2307 1400 545 1404 545 1435"/>
                        </Shape>
                        <String CONTENT="offender, on the contrary, was one of the three brothers who had prepared"/>
