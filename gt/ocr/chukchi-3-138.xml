                        </Shape>
                        <String CONTENT="issues of exactly opposite character. Thus one of the three brother-avengers"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l10" HPOS="545" VPOS="979" WIDTH="1770" HEIGHT="57" BASELINE="545 1020 2315 1020" TAGREFS="TYPE_3">
                        <Shape>
