                        </Shape>
                        <String CONTENT="Another case within my knowledge happened in the country of the Upper"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l21" HPOS="545" VPOS="1638" WIDTH="1768" HEIGHT="56" BASELINE="545 1679 2313 1679" TAGREFS="TYPE_3">
