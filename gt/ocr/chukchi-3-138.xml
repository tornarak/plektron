                        </Shape>
                        <String CONTENT="in a neighboring camp. The young woman refused his courtship; but at last"/>
                    </TextLine>

                    <TextLine ID="mz_3-138_l24" HPOS="543" VPOS="1819" WIDTH="1768" HEIGHT="55" BASELINE="543 1858 2311 1858" TAGREFS="TYPE_3">
