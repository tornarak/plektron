                        </Shape>
                        <String CONTENT="In another case, which happened the same year at the Anui fair, one"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l22" HPOS="338" VPOS="1713" WIDTH="1775" HEIGHT="63" BASELINE="340 1762 2113 1754" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1762 340 1776 2111 1768 2113 1754 2111 1727 2064 1713 2062 1713 2060 1713 2058 1713 2032 1727 1893 1727 1874 1713 1872 1713 1870 1713 1868 1713 1782 1725 1756 1713 1754 1713 1752 1713 1750 1713 1748 1713 1733 1725 1658 1715 1656 1715 1654 1715 1652 1715 1635 1727 1613 1715 1611 1715 1609 1715 1607 1715 1605 1715 1584 1729 1517 1729 1496 1715 1494 1715 1492 1715 1490 1715 1488 1715 1486 1715 1468 1729 1363 1729 1306 1715 1304 1715 1302 1715 1300 1715 1282 1727 1108 1717 1106 1717 1026 1729 910 1717 908 1717 836 1729 785 1717 783 1717 781 1717 611 1731 356 1719 354 1719 352 1719 350 1719 338 1727 340 1762"/>
                        </Shape>
                        <String CONTENT="Chukchee accused his neighbor of killing his son by witchcraft a few months"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l23" HPOS="340" VPOS="1776" WIDTH="1771" HEIGHT="57" BASELINE="342 1819 2111 1815" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1819 342 1833 2109 1831 2111 1815 2107 1787 2046 1776 2044 1776 2042 1776 2015 1787 1854 1787 1833 1776 1831 1776 1829 1776 1770 1787 1680 1787 1664 1776 1662 1776 1660 1776 1658 1776 1592 1786 1570 1776 1568 1776 1566 1776 1510 1786 340 1784 342 1819"/>
                        </Shape>
                        <String CONTENT="before that time. The two families were not very friendly, and it seems that"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l24" HPOS="340" VPOS="1838" WIDTH="1773" HEIGHT="55" BASELINE="342 1880 2113 1876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1880 342 1893 2111 1889 2113 1876 2109 1848 1227 1838 1226 1838 1224 1838 1202 1848 360 1840 358 1840 356 1840 354 1840 340 1846 342 1880"/>
                        </Shape>
                        <String CONTENT="the supposed wizard, when under the influence of brandy, was wont to boast"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l25" HPOS="340" VPOS="1899" WIDTH="1771" HEIGHT="63" BASELINE="340 1940 2111 1940" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1940 340 1950 573 1962 575 1962 656 1952 2109 1956 2111 1940 2111 1911 1443 1899 1441 1899 1439 1899 1402 1909 1351 1899 1349 1899 1347 1899 1345 1899 1327 1911 1169 1911 1135 1899 1133 1899 1132 1899 1130 1899 1128 1899 1112 1911 1024 1911 949 1899 947 1899 898 1909 844 1899 842 1899 787 1909 699 1899 697 1899 646 1909 613 1899 611 1899 609 1899 487 1909 381 1899 379 1899 377 1899 340 1909 340 1940"/>
                        </Shape>
                        <String CONTENT="of his magic skill. Be that as it may, the father, thirsting for revenge,"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l26" HPOS="342" VPOS="1958" WIDTH="1767" HEIGHT="57" BASELINE="344 1999 2109 1993" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1999 344 2015 2107 2015 2109 1993 2103 1958 1036 1968 979 1958 977 1958 912 1970 893 1960 891 1960 889 1960 718 1970 660 1960 658 1960 656 1960 624 1970 415 1960 413 1960 342 1972 344 1999"/>
                        </Shape>
                        <String CONTENT="watched for the wizard as he was passing on a trail among the camps, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l27" HPOS="338" VPOS="2015" WIDTH="1771" HEIGHT="56" BASELINE="340 2060 2109 2054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2060 340 2071 2107 2068 2109 2054 2105 2024 2023 2015 2021 2015 2019 2015 2017 2015 2001 2026 1750 2026 1727 2015 1725 2015 1723 2015 1666 2024 1633 2015 1631 2015 1629 2015 1511 2026 1470 2017 1468 2017 1466 2017 1288 2026 1261 2017 1259 2017 1257 2017 1255 2017 1235 2026 1173 2017 1171 2017 1169 2017 1143 2026 1061 2017 1059 2017 992 2026 930 2017 928 2017 926 2017 924 2017 906 2028 470 2019 468 2019 466 2019 444 2028 366 2019 364 2019 362 2019 338 2026 340 2060"/>
                        </Shape>
                        <String CONTENT="shot him down with a rifle. The brothers of the murdered man wanted to"/>
                    </TextLine>

                    <TextLine ID="mz_2-214_l28" HPOS="338" VPOS="2085" WIDTH="1767" HEIGHT="49" BASELINE="340 2120 2105 2115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2120 340 2134 2103 2132 2105 2115 2101 2085 338 2085 340 2120"/>
                        </Shape>
                        <String CONTENT="have blood for blood; but even they felt that the wronged father was within"/>
                    </TextLine>

