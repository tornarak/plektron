                <TextBlock ID="mz_1-184_r2" HPOS="600" VPOS="653" WIDTH="1778" HEIGHT="359" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="600 653 2378 653 2378 1012 600 1012"/>
                    </Shape>
                    <TextLine ID="mz_1-184_l3" HPOS="596" VPOS="662" WIDTH="1776" HEIGHT="56" BASELINE="598 692 2372 697" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2350 666 2328 666 2326 664 598 662 598 692 596 708 611 718 613 718 615 718 617 718 2369 710 2372 697 2369 666 2350 666"/>
                        </Shape>
                        <String CONTENT="with a rifle. The pregnant bear lies down in some convenient spot on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l4" HPOS="598" VPOS="727" WIDTH="1774" HEIGHT="46" BASELINE="598 755 2372 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 755 598 773 2372 773 2372 755 2372 727 598 727 598 755"/>
                        </Shape>
                        <String CONTENT="rough ice, and allows the snow to cover her over. She is killed in her snow"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l5" HPOS="596" VPOS="775" WIDTH="1773" HEIGHT="58" BASELINE="598 816 2369 812" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 816 598 833 2367 829 2369 812 2365 783 615 775 613 775 611 775 609 775 596 781 598 816"/>
                        </Shape>
                        <String CONTENT="den, together with her young, much in the same way as are brown bears in"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l6" HPOS="598" VPOS="846" WIDTH="1769" HEIGHT="52" BASELINE="598 876 2367 876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 876 598 892 2365 898 2367 876 2367 846 598 846 598 876"/>
                        </Shape>
                        <String CONTENT="more southern latitudes. The polar bear of northeastern Asia is not dangerous,"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l7" HPOS="596" VPOS="892" WIDTH="1776" HEIGHT="60" BASELINE="598 937 2372 933" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 937 598 952 2369 948 2372 933 2367 905 2237 892 2235 892 2179 902 2157 892 2155 892 2153 892 2099 902 2084 892 2081 892 2079 892 2077 892 2075 892 2029 902 2003 892 2001 892 1999 892 1928 902 1854 892 1852 892 1850 892 1847 892 1834 902 1806 892 1804 892 1802 892 1800 892 1769 902 1674 892 1672 892 1590 902 1512 892 1510 892 1445 905 888 894 886 894 884 894 849 905 799 894 797 894 710 905 672 894 669 894 667 894 596 907 598 937"/>
                        </Shape>
                        <String CONTENT="and rarely defends itself. When wounded or hunted down, it simply thrusts"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l8" HPOS="598" VPOS="963" WIDTH="1113" HEIGHT="48" BASELINE="598 996 1711 996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 996 598 1011 1711 1011 1711 996 1711 965 598 963 598 996"/>
                        </Shape>
                        <String CONTENT="its head into the snow, and waits for the blow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-184_r3" HPOS="600" VPOS="1012" WIDTH="1778" HEIGHT="724" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="600 1012 2378 1012 2378 1736 600 1736"/>
                    </Shape>
                    <TextLine ID="mz_1-184_l9" HPOS="704" VPOS="1013" WIDTH="1668" HEIGHT="58" BASELINE="704 1056 2372 1056" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="704 1056 704 1071 2369 1071 2372 1056 2372 1026 2335 1013 2333 1013 2330 1013 2226 1024 2122 1013 2120 1013 2118 1013 2092 1024 2077 1013 2075 1013 2073 1013 2071 1013 2068 1013 2045 1024 2023 1013 2021 1013 2019 1013 1964 1024 1882 1013 1880 1013 1878 1013 1854 1024 1830 1013 1828 1013 1826 1013 1741 1024 1698 1013 1696 1013 1694 1013 1692 1013 1659 1024 1590 1013 1588 1013 1585 1013 1562 1024 1544 1013 1542 1013 1540 1013 1425 1013 1423 1013 1421 1013 1419 1013 1406 1024 1369 1013 1367 1013 1365 1013 1313 1024 1261 1013 1258 1013 1256 1013 1228 1024 704 1022 704 1056"/>
                        </Shape>
                        <String CONTENT="Brown bears are occasionally killed by the Reindeer Chukchee, chiefly"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l10" HPOS="596" VPOS="1080" WIDTH="1776" HEIGHT="63" BASELINE="598 1110 2372 1117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1110 596 1125 611 1136 613 1136 615 1136 617 1136 1070 1128 1191 1141 1193 1141 1196 1141 1198 1141 1217 1130 1800 1130 1871 1143 1873 1143 2369 1130 2372 1117 2369 1086 598 1080 598 1110"/>
                        </Shape>
                        <String CONTENT="during their winter sleep, because that is the least dangerous method. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l11" HPOS="598" VPOS="1145" WIDTH="1774" HEIGHT="48" BASELINE="598 1175 2372 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1175 598 1193 2372 1193 2372 1175 2372 1145 598 1145 598 1175"/>
                        </Shape>
                        <String CONTENT="entrance to the den is sometimes blocked with logs, and the animal is speared"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l12" HPOS="596" VPOS="1193" WIDTH="1776" HEIGHT="58" BASELINE="598 1229 2372 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1229 596 1245 2367 1251 2372 1236 2369 1206 598 1193 598 1229"/>
                        </Shape>
                        <String CONTENT="or shot through a hole made in the roof. The Maritime Chukchee occasion-"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l13" HPOS="596" VPOS="1262" WIDTH="1773" HEIGHT="50" BASELINE="598 1292 2369 1296" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1292 596 1307 2365 1312 2369 1296 2367 1266 598 1262 598 1292"/>
                        </Shape>
                        <String CONTENT="ally have a chance to kill a brown bear, because in the summer-time bears go"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l14" HPOS="596" VPOS="1322" WIDTH="1773" HEIGHT="48" BASELINE="598 1353 2369 1357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1353 596 1366 2365 1370 2369 1357 2367 1327 598 1322 598 1353"/>
                        </Shape>
                        <String CONTENT="to the tundra far away from the forest border. Thus on the Arctic coast, near"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l15" HPOS="596" VPOS="1381" WIDTH="1776" HEIGHT="50" BASELINE="598 1411 2372 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1411 596 1424 2367 1431 2372 1418 2369 1387 598 1381 598 1411"/>
                        </Shape>
                        <String CONTENT="the Kolyma, brown bears are met on the seashore between the mouth of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l16" HPOS="598" VPOS="1437" WIDTH="1771" HEIGHT="54" BASELINE="600 1472 2369 1476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1472 598 1487 2365 1491 2369 1476 2367 1444 600 1437 600 1472"/>
                        </Shape>
                        <String CONTENT="Kolyma and Brown Bear River (Keiˊñu-weˊem). On the Lower Kolyma brown"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l17" HPOS="596" VPOS="1496" WIDTH="1773" HEIGHT="54" BASELINE="598 1532 2369 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1532 596 1545 2365 1550 2369 1537 2367 1504 598 1496 598 1532"/>
                        </Shape>
                        <String CONTENT="bears even hibernate on the steep banks of some brook, well protected from"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l18" HPOS="596" VPOS="1561" WIDTH="1773" HEIGHT="47" BASELINE="598 1593 2369 1597" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1593 596 1604 2365 1608 2369 1597 2367 1565 598 1561 598 1593"/>
                        </Shape>
                        <String CONTENT="the wind, but beyond the border of the forest. On the Pacific coast I met a"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l19" HPOS="598" VPOS="1619" WIDTH="1774" HEIGHT="54" BASELINE="598 1656 2372 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1656 598 1673 2372 1673 2372 1656 2372 1623 598 1619 598 1656"/>
                        </Shape>
                        <String CONTENT="brown bear in Holy Cross Bay, in June, 1901, that was feeding on seaweed"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l20" HPOS="596" VPOS="1671" WIDTH="872" HEIGHT="58" BASELINE="598 1712 1468 1717" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1712 596 1725 1464 1729 1468 1717 1466 1686 1384 1686 1373 1675 1373 1673 1371 1673 1369 1673 1367 1673 1365 1673 1330 1684 1269 1673 1267 1673 1265 1673 1235 1686 1152 1686 1141 1675 1141 1673 1139 1673 1137 1673 1135 1673 1007 1682 966 1671 964 1671 962 1671 598 1680 598 1712"/>
                        </Shape>
                        <String CONTENT="along the land-ice piled on the shore."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-184_r4" HPOS="600" VPOS="1736" WIDTH="1778" HEIGHT="479" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="600 1736 2378 1736 2378 2215 600 2215"/>
                    </Shape>
                    <TextLine ID="mz_1-184_l21" HPOS="704" VPOS="1738" WIDTH="1670" HEIGHT="54" BASELINE="706 1768 2374 1777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 1768 704 1784 2369 1792 2374 1777 2372 1747 706 1738 706 1768"/>
                        </Shape>
                        <String CONTENT="On the edge of the forest the Reindeer Chukchee sometimes catch the"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l22" HPOS="596" VPOS="1799" WIDTH="1776" HEIGHT="58" BASELINE="598 1831 2372 1840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1831 596 1844 799 1857 801 1857 2369 1855 2372 1840 2369 1807 598 1799 598 1831"/>
                        </Shape>
                        <String CONTENT="bear with small thin wooden blocks spiked on their upper surface (Fig. 51, b),"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l23" HPOS="598" VPOS="1855" WIDTH="1774" HEIGHT="56" BASELINE="598 1896 2372 1896" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1896 598 1911 2372 1911 2372 1896 2372 1868 1702 1855 1700 1855 1637 1866 1505 1855 1503 1855 1501 1855 1475 1866 1369 1855 1367 1855 1365 1855 1362 1855 1347 1868 1174 1868 1048 1855 1046 1855 964 1866 901 1855 899 1855 801 1866 786 1855 784 1855 782 1855 667 1855 665 1855 598 1866 598 1896"/>
                        </Shape>
                        <String CONTENT="and left on the pathway among fallen leaves. When the bear steps on one"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l24" HPOS="596" VPOS="1920" WIDTH="1778" HEIGHT="58" BASELINE="598 1950 2374 1955" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1950 596 1963 617 1976 620 1976 622 1976 1434 1968 1497 1978 1499 1978 2372 1968 2374 1955 2372 1924 598 1920 598 1950"/>
                        </Shape>
                        <String CONTENT="of these, the spikes penetrate the sole of its foot. A wound of this kind"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l25" HPOS="596" VPOS="1972" WIDTH="1778" HEIGHT="67" BASELINE="598 2013 2374 2017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2013 596 2026 641 2039 643 2039 646 2039 2372 2030 2374 2017 2372 1987 2307 1974 2304 1974 2302 1974 2300 1974 2283 1987 1923 1987 1889 1974 1886 1974 1884 1974 1793 1985 1752 1974 1750 1974 1748 1974 1659 1985 1620 1974 1618 1974 1616 1974 1614 1974 1568 1985 1484 1972 1481 1972 1479 1972 1455 1985 1291 1985 1267 1972 1265 1972 1263 1972 1148 1983 1083 1972 1081 1972 1079 1972 1040 1983 1009 1972 1007 1972 1005 1972 1003 1972 970 1983 916 1972 914 1972 598 1981 598 2013"/>
                        </Shape>
                        <String CONTENT="rapidly disables it for walking, especially since, in trying to tear away the"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l26" HPOS="596" VPOS="2037" WIDTH="1778" HEIGHT="56" BASELINE="598 2069 2374 2078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2069 596 2085 2369 2093 2374 2078 2372 2048 598 2037 598 2069"/>
                        </Shape>
                        <String CONTENT="block, the bear only makes the wound worse. This implement seems to have"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l27" HPOS="596" VPOS="2098" WIDTH="1778" HEIGHT="54" BASELINE="598 2130 2374 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2130 596 2145 2369 2152 2374 2137 2372 2106 598 2098 598 2130"/>
                        </Shape>
                        <String CONTENT="been copied from some tribe living within the forest limit, though I am not"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l28" HPOS="604" VPOS="2154" WIDTH="1360" HEIGHT="67" BASELINE="607 2191 1964 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="607 2191 604 2206 1352 2221 1354 2221 1356 2221 1403 2210 1752 2210 1763 2219 1763 2221 1765 2221 1767 2221 1769 2221 1962 2208 1964 2195 1960 2154 607 2158 607 2191"/>
                        </Shape>
                        <String CONTENT="aware that any of the neighboring tribes use it at present.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-184_r5" HPOS="600" VPOS="2215" WIDTH="1778" HEIGHT="357" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="600 2215 2378 2215 2378 2572 600 2572"/>
                    </Shape>
                    <TextLine ID="mz_1-184_l29" HPOS="706" VPOS="2214" WIDTH="1668" HEIGHT="68" BASELINE="708 2249 2374 2258" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="708 2249 706 2264 723 2275 726 2275 728 2275 730 2275 1915 2271 1954 2282 1956 2282 1958 2282 2372 2271 2374 2258 2372 2225 708 2214 708 2249"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee catch hares in winter by cornering them and"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l30" HPOS="596" VPOS="2271" WIDTH="1776" HEIGHT="69" BASELINE="598 2312 2372 2318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2312 596 2325 704 2338 706 2338 1187 2329 1284 2340 1287 2340 2369 2331 2372 2318 2369 2288 2294 2275 2291 2275 2192 2286 2168 2275 2166 2275 2164 2275 2084 2288 1971 2288 1951 2275 1949 2275 1947 2275 1945 2275 1698 2284 1683 2273 1681 2273 1679 2273 1676 2273 1191 2284 1113 2271 1111 2271 1109 2271 1079 2282 990 2271 988 2271 986 2271 949 2282 871 2271 869 2271 598 2279 598 2312"/>
                        </Shape>
                        <String CONTENT="finally driving them into a spot surrounded by nets. Women and children"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l31" HPOS="594" VPOS="2340" WIDTH="1778" HEIGHT="52" BASELINE="596 2372 2372 2377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2372 594 2392 2369 2390 2372 2377 2369 2342 596 2340 596 2372"/>
                        </Shape>
                        <String CONTENT="join in the battue with rattles and sticks to drive the hares in the desired"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l32" HPOS="598" VPOS="2401" WIDTH="1774" HEIGHT="58" BASELINE="600 2431 2372 2435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2431 598 2444 875 2457 877 2457 1440 2448 1523 2459 1525 2459 2369 2448 2372 2435 2369 2405 600 2401 600 2431"/>
                        </Shape>
                        <String CONTENT="direction. I was told that in one successful battue several scores might be"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l33" HPOS="596" VPOS="2461" WIDTH="1776" HEIGHT="59" BASELINE="598 2492 2372 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2492 596 2507 676 2520 678 2520 2369 2511 2372 2496 2369 2461 598 2461 598 2492"/>
                        </Shape>
                        <String CONTENT="caught. In times of famine poor families often escape starvation by this kind"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l34" HPOS="598" VPOS="2509" WIDTH="366" HEIGHT="67" BASELINE="600 2548 964 2552" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2548 598 2563 678 2576 680 2576 962 2567 964 2552 962 2522 808 2522 784 2509 782 2509 780 2509 600 2515 600 2548"/>
                        </Shape>
                        <String CONTENT="of hare-hunting."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-184_r6" HPOS="600" VPOS="2572" WIDTH="1778" HEIGHT="542" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="600 2572 2378 2572 2378 3114 600 3114"/>
                    </Shape>
                    <TextLine ID="mz_1-184_l35" HPOS="706" VPOS="2570" WIDTH="1666" HEIGHT="69" BASELINE="708 2611 2372 2617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="708 2611 706 2624 962 2637 964 2637 1228 2628 1280 2639 1282 2639 2369 2630 2372 2617 2372 2587 2348 2574 2346 2574 2343 2574 2268 2585 2222 2574 2220 2574 2218 2574 2159 2587 1819 2587 1787 2572 1785 2572 1782 2572 1527 2583 1211 2583 1178 2570 1176 2570 1174 2570 1111 2580 1009 2570 1007 2570 1005 2570 966 2580 927 2570 925 2570 923 2570 921 2570 888 2580 843 2570 840 2570 838 2570 708 2576 708 2611"/>
                        </Shape>
                        <String CONTENT="Small animals — like marmots, ground-squirrels, etc. — are caught with"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l36" HPOS="598" VPOS="2634" WIDTH="1771" HEIGHT="63" BASELINE="600 2669 2369 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2669 598 2684 2365 2697 2369 2680 2367 2647 2014 2634 2012 2634 600 2634 600 2669"/>
                        </Shape>
                        <String CONTENT="snares; house-mice, with special mouse-traps; ermines, with a kind of self-acting"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l37" HPOS="598" VPOS="2693" WIDTH="1776" HEIGHT="63" BASELINE="600 2730 2374 2738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2730 598 2743 646 2756 648 2756 650 2756 2372 2751 2374 2738 2374 2699 600 2693 600 2730"/>
                        </Shape>
                        <String CONTENT="bow (Fig. 52), probably copied from the Russianized natives. It consists of"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l38" HPOS="596" VPOS="2747" WIDTH="1780" HEIGHT="65" BASELINE="598 2788 2376 2797" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2803 2372 2812 2376 2797 2374 2760 628 2760 600 2747 598 2788 596 2803"/>
                        </Shape>
                        <String CONTENT="a small but strong bow fastened in a vertical position to a wooden frame of"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l39" HPOS="596" VPOS="2818" WIDTH="1776" HEIGHT="52" BASELINE="598 2849 2372 2855" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2849 596 2864 2367 2870 2372 2855 2369 2825 598 2818 598 2849"/>
                        </Shape>
                        <String CONTENT="narrow rectangular shape. The “arrow” is tied at one end to the middle of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-184_l40" HPOS="596" VPOS="2873" WIDTH="1773" HEIGHT="65" BASELINE="598 2909 2369 2916" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2909 596 2922 1189 2938 1191 2938 2367 2929 2369 2916 2367 2886 1854 2886 1778 2873 1776 2873 598 2877 598 2909"/>
                        </Shape>
