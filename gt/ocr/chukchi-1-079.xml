                    <TextLine ID="mz_1-079_l25" HPOS="383" VPOS="2048" WIDTH="1773" HEIGHT="58" BASELINE="385 2091 2156 2087" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2091 385 2106 2154 2102 2156 2087 2152 2058 1303 2048 1301 2048 1154 2058 443 2050 441 2050 383 2061 385 2091"/>
                        </Shape>
                        <String CONTENT="red-fox units. For instance, four white foxes were equal to one red fox, one"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l26" HPOS="383" VPOS="2110" WIDTH="1773" HEIGHT="61" BASELINE="385 2154 2156 2147" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2154 385 2171 2154 2162 2156 2147 2152 2115 517 2110 515 2110 383 2121 385 2154"/>
                        </Shape>
                        <String CONTENT="gray fox or one beaver was equal to two red foxes, one black fox was equal"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l27" HPOS="383" VPOS="2167" WIDTH="1771" HEIGHT="58" BASELINE="385 2210 2154 2206" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2210 385 2225 2152 2223 2154 2206 2150 2177 1331 2167 1329 2167 383 2180 385 2210"/>
                        </Shape>
                        <String CONTENT="to twenty red foxes, etc. The details of these rules were oppressive to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l28" HPOS="385" VPOS="2225" WIDTH="1771" HEIGHT="69" BASELINE="387 2271 2156 2266" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2271 387 2284 706 2294 708 2294 710 2294 712 2294 727 2284 983 2284 1030 2294 1033 2294 1035 2294 1204 2284 1260 2292 1262 2292 1264 2292 1295 2281 1463 2292 1466 2292 2154 2281 2156 2266 2150 2234 1955 2236 1920 2225 1918 2225 1916 2225 1806 2236 1777 2225 1775 2225 1773 2225 1715 2236 1641 2225 1639 2225 1567 2236 1446 2225 1444 2225 1373 2236 1342 2225 1340 2225 1338 2225 1336 2225 1334 2225 1314 2236 1089 2227 1087 2227 835 2238 779 2227 777 2227 697 2238 615 2227 612 2227 521 2238 478 2227 476 2227 474 2227 385 2240 387 2271"/>
                        </Shape>
                        <String CONTENT="small traders, who were punished for the slightest infraction. In several"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l29" HPOS="383" VPOS="2286" WIDTH="1771" HEIGHT="60" BASELINE="385 2331 2154 2325" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2331 385 2346 2152 2342 2154 2325 2150 2297 1617 2286 1615 2286 1515 2299 383 2299 385 2331"/>
                        </Shape>
                        <String CONTENT="instances even the richer merchants forfeited their right to trade with the"/>
