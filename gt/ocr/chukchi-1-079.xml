                        <Shape>
                            <Polygon POINTS="383 2511 383 2526 2150 2530 2154 2507 2150 2478 1587 2465 1585 2465 1583 2465 1541 2476 1489 2465 1487 2465 1485 2465 1446 2476 1407 2465 1405 2465 1403 2465 1401 2465 1399 2465 1381 2476 1214 2468 1212 2468 1149 2478 1110 2468 1108 2468 1106 2468 1104 2468 1082 2478 1024 2468 1022 2468 911 2478 879 2468 877 2468 874 2468 764 2478 703 2468 701 2468 699 2468 697 2468 682 2481 487 2481 400 2468 398 2468 396 2468 394 2468 381 2474 383 2511"/>
                        </Shape>
                        <String CONTENT="four paws to be worth a price in tobacco. In the sixties of the last century,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l33" HPOS="383" VPOS="2526" WIDTH="1771" HEIGHT="61" BASELINE="385 2572 2154 2567" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2572 385 2587 2152 2587 2154 2567 2150 2537 1288 2526 1286 2526 1284 2526 1282 2526 1262 2537 426 2528 424 2528 422 2528 383 2539 385 2572"/>
                        </Shape>
