                        </Shape>
                        <String CONTENT="Reindeer-camps and Kavraˊlɪt traders,¹ but also enterprising men from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l37" HPOS="383" VPOS="2764" WIDTH="1769" HEIGHT="63" BASELINE="385 2812 2152 2805" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2812 385 2827 2150 2820 2152 2805 2148 2775 1563 2764 1561 2764 1559 2764 1531 2775 1022 2766 1020 2766 948 2777 474 2769 472 2769 383 2779 385 2812"/>
                        </Shape>
                        <String CONTENT="maritime villages as far as East Cape and Indian Point, who came with dog-"/>
                    </TextLine>

