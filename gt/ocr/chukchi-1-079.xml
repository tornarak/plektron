                        </Shape>
                        <String CONTENT="of iron kettles was equal to ten red foxes, and one pud of copper kettles"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l22" HPOS="385" VPOS="1870" WIDTH="1771" HEIGHT="56" BASELINE="387 1911 2156 1907" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1911 387 1926 2154 1922 2156 1907 2152 1879 599 1870 597 1870 385 1881 387 1911"/>
                        </Shape>
                        <String CONTENT="was equal to twenty foxes. In later years a wolverine-skin or a large kettle"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l23" HPOS="385" VPOS="1924" WIDTH="1769" HEIGHT="63" BASELINE="387 1972 2154 1965" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1972 387 1987 2152 1983 2154 1965 2152 1937 2126 1924 2124 1924 2122 1924 1708 1935 1591 1924 1589 1924 1587 1924 1559 1937 1117 1926 1115 1926 1113 1926 1087 1937 1033 1926 1030 1926 935 1939 537 1929 534 1929 385 1942 387 1972"/>
                        </Shape>
                        <String CONTENT="was given in addition to the large tobacco-bags of three puds each, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l24" HPOS="385" VPOS="1987" WIDTH="1769" HEIGHT="58" BASELINE="387 2032 2154 2028" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2032 387 2045 2152 2043 2154 2028 2150 1998 1290 1987 1288 1987 1286 1987 1238 1998 567 1989 565 1989 385 2000 387 2032"/>
