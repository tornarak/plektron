                    </TextLine>

                    <TextLine ID="mz_1-079_l7" HPOS="385" VPOS="980" WIDTH="1769" HEIGHT="52" BASELINE="385 1013 2154 1013" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1013 385 1026 2152 1032 2154 1013 2154 980 385 980 385 1013"/>
                        </Shape>
                        <String CONTENT="fair took place in the spring, and lasted three days; it was held in the open,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l8" HPOS="385" VPOS="1037" WIDTH="1771" HEIGHT="51" BASELINE="385 1071 2156 1071" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1071 385 1088 2156 1088 2156 1071 2156 1041 385 1037 385 1071"/>
                        </Shape>
                        <String CONTENT="before the gates of the Russian fort, sometimes even farther away on the ice"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l9" HPOS="383" VPOS="1086" WIDTH="1771" HEIGHT="67" BASELINE="385 1127 2154 1132" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1127 383 1143 398 1153 400 1153 402 1153 404 1153 2152 1149 2154 1132 2152 1101 1758 1088 1756 1088 1754 1088 1752 1088 1736 1101 1576 1101 1515 1088 1513 1088 1511 1088 1472 1099 1442 1088 1440 1088 1437 1088 1299 1099 1271 1086 1269 1086 1266 1086 1191 1097 981 1086 978 1086 385 1095 385 1127"/>
                        </Shape>
                        <String CONTENT="of the river. The Chukchee came fully armed with spears, bows and arrows,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l10" HPOS="383" VPOS="1147" WIDTH="1773" HEIGHT="58" BASELINE="385 1192 2156 1188" TAGREFS="TYPE_6">
                        <Shape>
