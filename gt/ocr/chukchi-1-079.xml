                    <TextLine ID="mz_1-079_l4" HPOS="387" VPOS="801" WIDTH="1767" HEIGHT="49" BASELINE="387 831 2154 831" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 831 387 850 2152 850 2154 831 2152 801 387 801 387 831"/>
                        </Shape>
