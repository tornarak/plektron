                    <TextLine ID="mz_1-079_l30" HPOS="387" VPOS="2359" WIDTH="1767" HEIGHT="48" BASELINE="387 2390 2154 2390" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2390 387 2407 2152 2407 2154 2390 2152 2359 387 2359 387 2390"/>
                        </Shape>
