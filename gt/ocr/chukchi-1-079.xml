                        </Shape>
                        <String CONTENT="and large knives tied to their belts. Altercations and brawls, and even"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l11" HPOS="383" VPOS="1214" WIDTH="1771" HEIGHT="52" BASELINE="385 1247 2154 1251" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1247 383 1262 2150 1266 2154 1251 2152 1221 385 1214 385 1247"/>
                        </Shape>
                        <String CONTENT="bloodshed, were not uncommon because of disagreements about prices. There-"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l12" HPOS="385" VPOS="1268" WIDTH="1771" HEIGHT="61" BASELINE="385 1311 2156 1311" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1311 385 1329 2156 1329 2156 1311 2156 1279 2130 1268 2128 1268 2126 1268 1080 1279 1028 1268 1026 1268 1024 1268 976 1279 909 1268 907 1268 905 1268 903 1268 887 1279 816 1268 814 1268 753 1279 699 1268 697 1268 625 1279 599 1268 597 1268 595 1268 534 1279 502 1268 500 1268 498 1268 435 1279 404 1268 402 1268 400 1268 398 1268 396 1268 385 1275 385 1311"/>
                        </Shape>
                        <String CONTENT="fore in 1812 Gen. Treskin, the governor of Irkutsk, who also ruled the Yakutsk"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l13" HPOS="383" VPOS="1327" WIDTH="1773" HEIGHT="65" BASELINE="385 1374 2156 1368" TAGREFS="TYPE_6">
