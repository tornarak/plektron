                        <Shape>
                            <Polygon POINTS="387 1610 387 1628 2156 1628 2156 1610 2156 1580 387 1580 387 1610"/>
                        </Shape>
                        <String CONTENT="officer, with the advice of prominent merchants. The prices were fixed annually"/>
                    </TextLine>

