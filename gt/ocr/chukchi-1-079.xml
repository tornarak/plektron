                        <Shape>
                            <Polygon POINTS="385 1671 385 1686 2154 1684 2156 1667 2152 1638 383 1638 385 1671"/>
                        </Shape>
                        <String CONTENT="by the common consent of the merchants, and iron and copper kettles were"/>
                    </TextLine>

