                        </Shape>
                        <String CONTENT="At the usual rate, one pud (thirty-six pounds Avoirdupois) of tobacco or"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l21" HPOS="383" VPOS="1809" WIDTH="1773" HEIGHT="68" BASELINE="385 1853 2156 1846" TAGREFS="TYPE_6">
