                <TextBlock ID="text_1-079" HPOS="360" VPOS="612" WIDTH="1778" HEIGHT="2694"><TextLine ID="mz_1-079_l1" HPOS="944" VPOS="612" WIDTH="618" HEIGHT="54" BASELINE="944 645 1562 645" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1551 612 955 612 944 617 944 645 944 666 1562 666 1562 645 1562 630 1551 612"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l2" HPOS="2071" VPOS="617" WIDTH="38" HEIGHT="62" BASELINE="2075 664 2109 662" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2092 617 2079 617 2071 617 2075 664 2075 679 2109 679 2109 662 2103 617 2092 617"/>
                        </Shape>
                        <String CONTENT="57"/>
                    </TextLine>
<TextLine ID="mz_1-079_l3" HPOS="362" VPOS="723" WIDTH="1773" HEIGHT="50" BASELINE="364 757 2135 753" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 727 362 727 364 757 364 773 2133 768 2135 753 2129 723 383 725 383 727"/>
                        </Shape>
                        <String CONTENT="moreover, must be at least doubled to reach the real trade value, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l4" HPOS="366" VPOS="786" WIDTH="1767" HEIGHT="49" BASELINE="366 816 2133 816" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 816 366 835 2131 835 2133 816 2131 786 366 786 366 816"/>
                        </Shape>
                        <String CONTENT="the merchants of Kolyma always greatly underestimate data for official records."/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l5" HPOS="366" VPOS="840" WIDTH="1772" HEIGHT="54" BASELINE="366 876 2138 876" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 876 366 894 2138 892 2138 876 2138 846 366 840 366 876"/>
                        </Shape>
                        <String CONTENT="The products of reindeer-breeding were then of very slight importance, while at"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l6" HPOS="362" VPOS="894" WIDTH="1771" HEIGHT="65" BASELINE="364 937 2133 933" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 937 364 959 2131 950 2133 933 2129 905 1248 894 1245 894 1243 894 1204 905 518 896 516 896 362 907 364 937"/>
                        </Shape>
                        <String CONTENT="present they amount to about three-fifths of the total Anui purchases. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l7" HPOS="364" VPOS="965" WIDTH="1769" HEIGHT="52" BASELINE="364 998 2133 998" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 998 364 1011 2131 1017 2133 998 2133 965 364 965 364 998"/>
                        </Shape>
                        <String CONTENT="fair took place in the spring, and lasted three days; it was held in the open,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l8" HPOS="364" VPOS="1022" WIDTH="1771" HEIGHT="51" BASELINE="364 1056 2135 1056" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1056 364 1073 2135 1073 2135 1056 2135 1026 364 1022 364 1056"/>
                        </Shape>
                        <String CONTENT="before the gates of the Russian fort, sometimes even farther away on the ice"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l9" HPOS="362" VPOS="1071" WIDTH="1771" HEIGHT="67" BASELINE="364 1112 2133 1117" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1112 362 1128 377 1138 379 1138 381 1138 383 1138 2131 1134 2133 1117 2131 1086 1737 1073 1735 1073 1733 1073 1731 1073 1715 1086 1555 1086 1494 1073 1492 1073 1490 1073 1451 1084 1421 1073 1419 1073 1416 1073 1278 1084 1250 1071 1248 1071 1245 1071 1170 1082 960 1071 957 1071 364 1080 364 1112"/>
                        </Shape>
                        <String CONTENT="of the river. The Chukchee came fully armed with spears, bows and arrows,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l10" HPOS="362" VPOS="1132" WIDTH="1773" HEIGHT="58" BASELINE="364 1177 2135 1173" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1177 364 1190 2133 1186 2135 1173 2131 1145 2001 1145 1986 1132 1984 1132 1982 1132 1980 1132 1977 1132 1956 1143 1828 1132 1826 1132 1752 1143 1731 1132 1728 1132 1726 1132 1724 1132 1722 1132 1705 1143 1676 1132 1674 1132 1672 1132 1527 1143 1510 1132 1507 1132 1505 1132 1332 1132 1330 1132 1245 1145 1211 1134 1209 1134 1206 1134 912 1145 827 1134 825 1134 823 1134 778 1145 639 1134 637 1134 635 1134 600 1145 435 1134 433 1134 362 1147 364 1177"/>
                        </Shape>
                        <String CONTENT="and large knives tied to their belts. Altercations and brawls, and even"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l11" HPOS="362" VPOS="1199" WIDTH="1771" HEIGHT="52" BASELINE="364 1232 2133 1236" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1232 362 1247 2129 1251 2133 1236 2131 1206 364 1199 364 1232"/>
                        </Shape>
                        <String CONTENT="bloodshed, were not uncommon because of disagreements about prices. There-"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l12" HPOS="364" VPOS="1253" WIDTH="1771" HEIGHT="61" BASELINE="364 1296 2135 1296" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1296 364 1314 2135 1314 2135 1296 2135 1264 2109 1253 2107 1253 2105 1253 1059 1264 1007 1253 1005 1253 1003 1253 955 1264 888 1253 886 1253 884 1253 882 1253 866 1264 795 1253 793 1253 732 1264 678 1253 676 1253 604 1264 578 1253 576 1253 574 1253 513 1264 481 1253 479 1253 477 1253 414 1264 383 1253 381 1253 379 1253 377 1253 375 1253 364 1260 364 1296"/>
                        </Shape>
                        <String CONTENT="fore in 1812 Gen. Treskin, the governor of Irkutsk, who also ruled the Yakutsk"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l13" HPOS="362" VPOS="1312" WIDTH="1773" HEIGHT="65" BASELINE="364 1359 2135 1353" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1359 364 1377 2133 1366 2135 1353 2131 1325 2077 1312 2075 1312 2073 1312 2051 1322 1984 1312 1982 1312 1980 1312 1958 1322 1893 1312 1891 1312 1889 1312 1863 1322 1839 1312 1837 1312 1834 1312 1832 1312 1785 1322 1479 1314 1477 1314 1475 1314 1473 1314 1458 1325 1038 1314 1035 1314 1033 1314 1031 1314 1016 1325 814 1316 812 1316 730 1327 464 1316 461 1316 362 1329 364 1359"/>
                        </Shape>
                        <String CONTENT="province (i. e., northeastern Siberia as far as Chaun Bay and the Anadyr"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l14" HPOS="364" VPOS="1383" WIDTH="1771" HEIGHT="59" BASELINE="366 1416 2135 1411" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1416 366 1431 1265 1439 1267 1439 1269 1439 1271 1439 1287 1429 1378 1429 1393 1439 1395 1439 1397 1439 1399 1442 1544 1442 1544 1439 1618 1429 1869 1439 1871 1439 1873 1439 1876 1439 1889 1429 1902 1439 1904 1439 1906 1439 1908 1442 2010 1442 2010 1439 2012 1439 2040 1429 2114 1439 2116 1439 2118 1439 2120 1439 2135 1426 2135 1411 2131 1383 364 1383 366 1416"/>
                        </Shape>
                        <String CONTENT="River), ordered that trade in tobacco, the principal commodity, which was"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l15" HPOS="366" VPOS="1442" WIDTH="1769" HEIGHT="52" BASELINE="366 1476 2135 1476" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1476 366 1494 2135 1494 2135 1476 2135 1446 366 1442 366 1476"/>
                        </Shape>
                        <String CONTENT="bartered by the Russians for beavers, foxes, martens, and walrus-tusks brought"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l16" HPOS="362" VPOS="1496" WIDTH="1773" HEIGHT="56" BASELINE="364 1535 2135 1530" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1535 364 1552 2133 1548 2135 1530 2129 1496 362 1500 364 1535"/>
                        </Shape>
                        <String CONTENT="by the natives, should be conducted on terms fixed beforehand by the chief"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l17" HPOS="366" VPOS="1565" WIDTH="1769" HEIGHT="48" BASELINE="366 1595 2135 1595" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1595 366 1613 2135 1613 2135 1595 2135 1565 366 1565 366 1595"/>
                        </Shape>
                        <String CONTENT="officer, with the advice of prominent merchants. The prices were fixed annually"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l18" HPOS="362" VPOS="1623" WIDTH="1773" HEIGHT="48" BASELINE="364 1656 2135 1652" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1656 364 1671 2133 1669 2135 1652 2131 1623 362 1623 364 1656"/>
                        </Shape>
                        <String CONTENT="by the common consent of the merchants, and iron and copper kettles were"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l19" HPOS="362" VPOS="1673" WIDTH="1319" HEIGHT="59" BASELINE="362 1717 1681 1717" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1717 362 1732 1679 1732 1681 1717 1679 1686 1616 1673 1614 1673 1611 1673 1583 1684 1529 1673 1527 1673 1525 1673 1501 1684 1460 1673 1458 1673 1455 1673 1269 1684 1189 1673 1187 1673 1185 1673 1183 1673 1183 1675 1172 1686 1020 1686 992 1673 990 1673 988 1673 931 1684 871 1673 869 1673 866 1673 821 1684 791 1673 788 1673 786 1673 784 1673 747 1684 715 1673 713 1673 710 1673 708 1673 706 1673 691 1684 669 1673 667 1673 665 1673 663 1673 661 1673 648 1684 565 1673 563 1673 561 1673 559 1673 542 1684 507 1673 505 1673 503 1673 500 1673 474 1684 407 1673 405 1673 403 1673 362 1684 362 1717"/>
                        </Shape>
                        <String CONTENT="often included in the list of commodities with fixed price."/>
                    </TextLine>
<TextLine ID="mz_1-079_l20" HPOS="470" VPOS="1732" WIDTH="1668" HEIGHT="67" BASELINE="472 1777 2138 1773" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="472 1777 472 1790 2109 1799 2112 1799 2114 1799 2138 1786 2138 1773 2133 1742 1304 1732 1302 1732 1300 1732 1269 1742 492 1734 490 1734 487 1734 485 1734 470 1740 472 1777"/>
                        </Shape>
                        <String CONTENT="At the usual rate, one pud (thirty-six pounds Avoirdupois) of tobacco or"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l21" HPOS="362" VPOS="1794" WIDTH="1773" HEIGHT="68" BASELINE="364 1838 2135 1831" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1838 364 1851 851 1851 912 1862 914 1862 979 1849 1391 1859 1393 1859 2133 1846 2135 1831 2131 1803 955 1794 953 1794 856 1805 399 1797 396 1797 394 1797 362 1807 364 1838"/>
                        </Shape>
                        <String CONTENT="of iron kettles was equal to ten red foxes, and one pud of copper kettles"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l22" HPOS="364" VPOS="1855" WIDTH="1771" HEIGHT="56" BASELINE="366 1896 2135 1892" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1896 366 1911 2133 1907 2135 1892 2131 1864 578 1855 576 1855 364 1866 366 1896"/>
                        </Shape>
                        <String CONTENT="was equal to twenty foxes. In later years a wolverine-skin or a large kettle"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l23" HPOS="364" VPOS="1909" WIDTH="1769" HEIGHT="63" BASELINE="366 1957 2133 1950" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1957 366 1972 2131 1968 2133 1950 2131 1922 2105 1909 2103 1909 2101 1909 1687 1920 1570 1909 1568 1909 1566 1909 1538 1922 1096 1911 1094 1911 1092 1911 1066 1922 1012 1911 1009 1911 914 1924 516 1914 513 1914 364 1927 366 1957"/>
                        </Shape>
                        <String CONTENT="was given in addition to the large tobacco-bags of three puds each, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l24" HPOS="364" VPOS="1972" WIDTH="1769" HEIGHT="58" BASELINE="366 2017 2133 2013" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2017 366 2030 2131 2028 2133 2013 2129 1983 1269 1972 1267 1972 1265 1972 1217 1983 546 1974 544 1974 364 1985 366 2017"/>
                        </Shape>
                        <String CONTENT="were valued at sixty fox-skins. The value of other peltries was expressed in"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l25" HPOS="362" VPOS="2033" WIDTH="1773" HEIGHT="58" BASELINE="364 2076 2135 2072" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2076 364 2091 2133 2087 2135 2072 2131 2043 1282 2033 1280 2033 1133 2043 422 2035 420 2035 362 2046 364 2076"/>
                        </Shape>
                        <String CONTENT="red-fox units. For instance, four white foxes were equal to one red fox, one"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l26" HPOS="362" VPOS="2095" WIDTH="1773" HEIGHT="61" BASELINE="364 2139 2135 2132" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2139 364 2156 2133 2147 2135 2132 2131 2100 496 2095 494 2095 362 2106 364 2139"/>
                        </Shape>
                        <String CONTENT="gray fox or one beaver was equal to two red foxes, one black fox was equal"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l27" HPOS="362" VPOS="2152" WIDTH="1771" HEIGHT="58" BASELINE="364 2195 2133 2191" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2195 364 2210 2131 2208 2133 2191 2129 2162 1310 2152 1308 2152 362 2165 364 2195"/>
                        </Shape>
                        <String CONTENT="to twenty red foxes, etc. The details of these rules were oppressive to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l28" HPOS="364" VPOS="2210" WIDTH="1771" HEIGHT="69" BASELINE="366 2256 2135 2251" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2256 366 2269 685 2279 687 2279 689 2279 691 2279 706 2269 962 2269 1009 2279 1012 2279 1014 2279 1183 2269 1239 2277 1241 2277 1243 2277 1274 2266 1442 2277 1445 2277 2133 2266 2135 2251 2129 2219 1934 2221 1899 2210 1897 2210 1895 2210 1785 2221 1756 2210 1754 2210 1752 2210 1694 2221 1620 2210 1618 2210 1546 2221 1425 2210 1423 2210 1352 2221 1321 2210 1319 2210 1317 2210 1315 2210 1313 2210 1293 2221 1068 2212 1066 2212 814 2223 758 2212 756 2212 676 2223 594 2212 591 2212 500 2223 457 2212 455 2212 453 2212 364 2225 366 2256"/>
                        </Shape>
                        <String CONTENT="small traders, who were punished for the slightest infraction. In several"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l29" HPOS="362" VPOS="2271" WIDTH="1771" HEIGHT="60" BASELINE="364 2316 2133 2310" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2316 364 2331 2131 2327 2133 2310 2129 2282 1596 2271 1594 2271 1494 2284 362 2284 364 2316"/>
                        </Shape>
                        <String CONTENT="instances even the richer merchants forfeited their right to trade with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l30" HPOS="366" VPOS="2344" WIDTH="1767" HEIGHT="48" BASELINE="366 2375 2133 2375" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2375 366 2392 2131 2392 2133 2375 2131 2344 366 2344 366 2375"/>
                        </Shape>
                        <String CONTENT="Chukchee by accepting a seal-skin as the equivalent of a single missing paw"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l31" HPOS="362" VPOS="2392" WIDTH="1773" HEIGHT="56" BASELINE="364 2435 2135 2431" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2435 364 2448 2133 2444 2135 2431 2131 2398 375 2392 373 2392 370 2392 368 2392 368 2394 362 2398 364 2435"/>
                        </Shape>
                        <String CONTENT="in a lot of many hundred red-fox skins. The fox-skin should have had all"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l32" HPOS="360" VPOS="2450" WIDTH="1773" HEIGHT="65" BASELINE="362 2496 2133 2492" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 2496 362 2511 2129 2515 2133 2492 2129 2463 1566 2450 1564 2450 1562 2450 1520 2461 1468 2450 1466 2450 1464 2450 1425 2461 1386 2450 1384 2450 1382 2450 1380 2450 1378 2450 1360 2461 1193 2453 1191 2453 1128 2463 1089 2453 1087 2453 1085 2453 1083 2453 1061 2463 1003 2453 1001 2453 890 2463 858 2453 856 2453 853 2453 743 2463 682 2453 680 2453 678 2453 676 2453 661 2466 466 2466 379 2453 377 2453 375 2453 373 2453 360 2459 362 2496"/>
                        </Shape>
                        <String CONTENT="four paws to be worth a price in tobacco. In the sixties of the last century,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l33" HPOS="362" VPOS="2511" WIDTH="1771" HEIGHT="61" BASELINE="364 2557 2133 2552" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2557 364 2572 2131 2572 2133 2552 2129 2522 1267 2511 1265 2511 1263 2511 1261 2511 1241 2522 405 2513 403 2513 401 2513 362 2524 364 2557"/>
                        </Shape>
                        <String CONTENT="with the decline of the fair, the rules began to go out of use, and in 1869"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l34" HPOS="362" VPOS="2572" WIDTH="1011" HEIGHT="58" BASELINE="364 2615 1373 2611" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2615 364 2630 1371 2626 1373 2611 1369 2580 388 2572 386 2572 383 2572 362 2580 364 2615"/>
                        </Shape>
                        <String CONTENT="they were abolished by Baron von Maydell."/>
                    </TextLine>
<TextLine ID="mz_1-079_l35" HPOS="468" VPOS="2628" WIDTH="1670" HEIGHT="71" BASELINE="470 2676 2138 2669" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="470 2676 470 2686 1020 2699 1022 2699 1025 2699 1027 2699 1044 2686 1152 2697 1154 2697 1157 2697 1183 2686 1577 2695 1579 2695 1657 2684 2116 2695 2118 2695 2120 2695 2122 2695 2138 2682 2138 2669 2133 2641 1873 2641 1847 2628 1845 2628 1843 2628 1841 2628 1815 2639 1562 2630 1559 2630 1557 2630 1555 2630 1542 2641 1501 2630 1499 2630 1497 2630 1152 2641 1076 2630 1074 2630 999 2643 977 2632 975 2632 973 2632 622 2643 568 2632 565 2632 563 2632 526 2643 483 2632 481 2632 479 2632 477 2632 474 2632 474 2634 468 2639 470 2676"/>
                        </Shape>
                        <String CONTENT="In its most flourishing time, the Anui fair drew not only numerous"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l36" HPOS="364" VPOS="2689" WIDTH="1771" HEIGHT="62" BASELINE="366 2736 2135 2730" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2736 366 2751 2133 2745 2135 2730 2131 2699 1674 2689 1672 2689 1529 2702 364 2702 366 2736"/>
                        </Shape>
                        <String CONTENT="Reindeer-camps and Kavraˊlɪt traders,¹ but also enterprising men from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l37" HPOS="362" VPOS="2749" WIDTH="1769" HEIGHT="63" BASELINE="364 2797 2131 2790" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2797 364 2812 2129 2805 2131 2790 2127 2760 1542 2749 1540 2749 1538 2749 1510 2760 1001 2751 999 2751 927 2762 453 2754 451 2754 362 2764 364 2797"/>
                        </Shape>
                        <String CONTENT="maritime villages as far as East Cape and Indian Point, who came with dog-"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l38" HPOS="362" VPOS="2808" WIDTH="1773" HEIGHT="65" BASELINE="364 2855 2135 2849" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2855 364 2873 2133 2866 2135 2849 2131 2821 2016 2808 2014 2808 1934 2818 1919 2808 1917 2808 1915 2808 1912 2808 1910 2808 1886 2818 1863 2808 1860 2808 1858 2808 1789 2818 1759 2808 1756 2808 1754 2808 1752 2808 1728 2818 1668 2808 1666 2808 1611 2818 1553 2808 1551 2808 1549 2808 1546 2808 1531 2821 1159 2810 1157 2810 1042 2821 953 2810 951 2810 949 2810 910 2823 390 2812 388 2812 386 2812 362 2823 364 2855"/>
                        </Shape>
                        <String CONTENT="sledges the whole long distance, often running the risk of losing their animals"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l39" HPOS="364" VPOS="2883" WIDTH="1769" HEIGHT="48" BASELINE="364 2914 2133 2914" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2914 364 2927 2131 2931 2133 2914 2133 2883 364 2883 364 2914"/>
                        </Shape>
                        <String CONTENT="from exhaustion on the return trip. These were called Aˊᵋttɪ-kavraˊlɪt, i. e.,"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l40" HPOS="368" VPOS="2931" WIDTH="1767" HEIGHT="56" BASELINE="370 2972 2135 2968" TAGREFS="TYPE_6">
                        <Shape>
