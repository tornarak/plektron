                        </Shape>
                        <String CONTENT="province (i. e., northeastern Siberia as far as Chaun Bay and the Anadyr"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l14" HPOS="385" VPOS="1398" WIDTH="1771" HEIGHT="59" BASELINE="387 1431 2156 1426" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1431 387 1446 1286 1454 1288 1454 1290 1454 1292 1454 1308 1444 1399 1444 1414 1454 1416 1454 1418 1454 1420 1457 1565 1457 1565 1454 1639 1444 1890 1454 1892 1454 1894 1454 1897 1454 1910 1444 1923 1454 1925 1454 1927 1454 1929 1457 2031 1457 2031 1454 2033 1454 2061 1444 2135 1454 2137 1454 2139 1454 2141 1454 2156 1441 2156 1426 2152 1398 385 1398 387 1431"/>
                        </Shape>
                        <String CONTENT="River), ordered that trade in tobacco, the principal commodity, which was"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l15" HPOS="387" VPOS="1457" WIDTH="1769" HEIGHT="52" BASELINE="387 1491 2156 1491" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1491 387 1509 2156 1509 2156 1491 2156 1461 387 1457 387 1491"/>
                        </Shape>
                        <String CONTENT="bartered by the Russians for beavers, foxes, martens, and walrus-tusks brought"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l16" HPOS="383" VPOS="1511" WIDTH="1773" HEIGHT="56" BASELINE="385 1550 2156 1545" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1550 385 1567 2154 1563 2156 1545 2150 1511 383 1515 385 1550"/>
                        </Shape>
