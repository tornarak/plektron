                    <TextLine ID="mz_1-079_l5" HPOS="387" VPOS="855" WIDTH="1772" HEIGHT="54" BASELINE="387 891 2159 891" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 891 387 909 2159 907 2159 891 2159 861 387 855 387 891"/>
                        </Shape>
                        <String CONTENT="The products of reindeer-breeding were then of very slight importance, while at"/>
                    </TextLine>

                    <TextLine ID="mz_1-079_l6" HPOS="383" VPOS="909" WIDTH="1771" HEIGHT="65" BASELINE="385 952 2154 948" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 952 385 974 2152 965 2154 948 2150 920 1269 909 1266 909 1264 909 1225 920 539 911 537 911 383 922 385 952"/>
                        </Shape>
