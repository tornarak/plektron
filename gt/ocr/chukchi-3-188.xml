<TextLine ID="mz_3-188_l38" HPOS="650" VPOS="2706" WIDTH="1669" HEIGHT="43" BASELINE="652 2735 2319 2731" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="652 2735 652 2749 2319 2745 2319 2731 2313 2706 650 2708 652 2735"/>
                        </Shape>
                        <String CONTENT="“In the olden times there came an expedition. Its chief was a baron; and another one was"/>
                    </TextLine>

                    <TextLine ID="mz_3-188_l39" HPOS="547" VPOS="2753" WIDTH="1770" HEIGHT="44" BASELINE="549 2782 2317 2778" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="549 2782 549 2797 2317 2793 2317 2778 2311 2753 547 2754 549 2782"/>
                        </Shape>
                        <String CONTENT="a steersman, Anjin (Anjou). They brought with them a large boat, and put it in the middle of the"/>
                    </TextLine>

                    <TextLine ID="mz_3-188_l40" HPOS="549" VPOS="2799" WIDTH="1766" HEIGHT="47" BASELINE="551 2830 2315 2825" TAGREFS="TYPE_6">
                        <Shape>
