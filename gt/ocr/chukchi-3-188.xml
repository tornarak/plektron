                    </TextLine>

                    <TextLine ID="mz_3-188_l43" HPOS="549" VPOS="2940" WIDTH="203" HEIGHT="44" BASELINE="551 2969 752 2965" TAGREFS="TYPE_6">
                        <Shape>
