                        </Shape>
                        <String CONTENT="river; and neither wind nor tempest could do anything to it. It was only rocking slightly under it."/>
                    </TextLine>

                    <TextLine ID="mz_3-188_l41" HPOS="549" VPOS="2846" WIDTH="1766" HEIGHT="45" BASELINE="551 2877 2315 2871" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="551 2877 551 2891 2313 2889 2315 2871 2309 2846 549 2846 551 2877"/>
                        </Shape>
                        <String CONTENT="The steersman ordered his bedding to be hung up like a baby’s cradle. In this cradle he slept"/>
                    </TextLine>

                    <TextLine ID="mz_3-188_l42" HPOS="549" VPOS="2893" WIDTH="1766" HEIGHT="49" BASELINE="551 2924 2315 2920" TAGREFS="TYPE_6">
                        <Shape>
