                        </Shape>
                        <String CONTENT="to peck at it with his knife-beak, after which he may cut off the desired"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l8" HPOS="360" VPOS="871" WIDTH="1768" HEIGHT="67" BASELINE="362 916 2128 912" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 916 362 938 499 928 2125 932 2128 912 2125 885 2046 871 2044 871 2042 871 2005 883 1987 871 1985 871 1983 871 1982 871 1895 883 1835 871 1833 871 1700 883 1651 871 1649 871 1647 871 1508 881 1464 871 1463 871 1461 871 1459 871 1435 883 1302 871 1300 871 1298 871 1296 871 1278 883 1222 873 1220 873 1218 873 1216 873 1200 885 1184 873 1182 873 1180 873 1179 873 1073 885 754 873 752 873 646 885 628 873 626 873 624 873 548 873 546 873 544 873 542 873 522 887 436 887 403 873 401 873 399 873 397 873 360 885 362 916"/>
                        </Shape>
                        <String CONTENT="piece. This method calls to mind the Raven Incantation mentioned before,"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l9" HPOS="360" VPOS="930" WIDTH="1768" HEIGHT="60" BASELINE="362 977 2128 971" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 977 362 990 2126 987 2128 971 2123 936 1842 940 1776 930 1774 930 1631 940 1598 930 1596 930 1594 930 1592 930 1572 940 1449 932 1447 932 1386 941 1357 932 1355 932 1353 932 1351 932 1331 941 1304 932 1302 932 1300 932 1298 932 1261 941 1224 932 1222 932 1220 932 1218 932 1216 932 1202 941 1167 932 1165 932 1163 932 1100 941 1039 932 1038 932 992 941 961 932 959 932 957 932 955 932 953 932 938 941 732 934 730 934 728 934 726 934 710 945 556 945 495 934 493 934 491 934 464 943 434 934 432 934 430 934 360 945 362 977"/>
                        </Shape>
                        <String CONTENT="and also some details of the funeral ritual, in which, also, participants pretend"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l10" HPOS="362" VPOS="1008" WIDTH="313" HEIGHT="41" BASELINE="362 1034 675 1034" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1034 362 1049 675 1049 675 1034 675 1008 362 1008 362 1034"/>
                        </Shape>
