                    </TextLine>
<TextLine ID="mz_2-210_l11" HPOS="466" VPOS="1051" WIDTH="1664" HEIGHT="63" BASELINE="468 1096 2130 1090" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1096 468 1110 2111 1114 2113 1114 2115 1114 2117 1114 2130 1104 2130 1090 2128 1063 2101 1051 2099 1051 2097 1051 2095 1051 2070 1063 1878 1063 1841 1051 1839 1051 1837 1051 1835 1051 1803 1061 1531 1053 1529 1053 1451 1063 1382 1053 1380 1053 1378 1053 1376 1053 1359 1065 1214 1065 1151 1053 1149 1053 1147 1053 1120 1063 1022 1053 1020 1053 930 1065 906 1055 904 1055 902 1055 466 1063 468 1096"/>
                        </Shape>
                        <String CONTENT="In another method of doing the same thing, the person acting pretends"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l12" HPOS="360" VPOS="1110" WIDTH="1766" HEIGHT="61" BASELINE="362 1157 2126 1149" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1157 362 1171 2125 1163 2126 1149 2123 1122 1762 1110 1760 1110 1682 1122 1641 1112 1639 1112 1637 1112 1521 1122 1494 1112 1492 1112 1490 1112 1488 1112 1463 1122 1398 1112 1396 1112 1333 1122 1302 1112 1300 1112 1298 1112 1235 1124 1061 1114 1059 1114 965 1124 926 1114 924 1114 922 1114 801 1126 769 1116 767 1116 765 1116 763 1116 734 1128 560 1128 501 1116 499 1116 497 1116 458 1126 381 1116 379 1116 377 1116 376 1116 360 1124 362 1157"/>
                        </Shape>
                        <String CONTENT="that the corpse is a seal on the ice, and stalks it in the well-known charac-"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l13" HPOS="360" VPOS="1175" WIDTH="1766" HEIGHT="58" BASELINE="362 1216 2126 1212" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1216 362 1227 2123 1233 2126 1212 2123 1182 425 1175 423 1175 360 1184 362 1216"/>
                        </Shape>
                        <String CONTENT="teristic manner. When he is close enough, he thrusts his knife at the corpse,"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l14" HPOS="358" VPOS="1237" WIDTH="1768" HEIGHT="59" BASELINE="360 1278 2126 1269" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1278 360 1296 2125 1286 2126 1269 2121 1237 358 1245 360 1278"/>
                        </Shape>
                        <String CONTENT="pretending that he is throwing the harpoon. After that, the performer is free"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l15" HPOS="364" VPOS="1294" WIDTH="595" HEIGHT="63" BASELINE="364 1333 959 1333" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1333 364 1347 622 1347 632 1355 632 1357 634 1357 636 1357 638 1357 959 1347 959 1333 959 1304 932 1294 930 1294 928 1294 926 1294 897 1304 877 1294 875 1294 873 1294 707 1304 673 1294 671 1294 669 1294 609 1304 556 1294 554 1294 509 1304 481 1294 479 1294 477 1294 475 1294 473 1294 473 1296 464 1306 364 1306 364 1333"/>
                        </Shape>
                        <String CONTENT="to take his piece of flesh."/>
                    </TextLine>
<TextLine ID="mz_2-210_l16" HPOS="470" VPOS="1349" WIDTH="1658" HEIGHT="68" BASELINE="472 1394 2128 1386" TAGREFS="TYPE_5">
                        <Shape>
