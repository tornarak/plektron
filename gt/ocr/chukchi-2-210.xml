                        </Shape>
                        <String CONTENT="the effectiveness of the charm. Another way of doing the same is for the"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l4" HPOS="360" VPOS="632" WIDTH="1768" HEIGHT="67" BASELINE="362 679 2128 671" TAGREFS="TYPE_5">
