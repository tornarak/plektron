                        </Shape>
                        <String CONTENT="The chief purpose of all these methods is evidently, not so much to"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l17" HPOS="360" VPOS="1410" WIDTH="1766" HEIGHT="66" BASELINE="362 1455 2126 1451" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1455 362 1466 689 1476 691 1476 816 1466 832 1476 834 1476 836 1476 838 1476 989 1466 1108 1476 1110 1476 1112 1476 1114 1476 1130 1466 1229 1474 1231 1474 1233 1474 1267 1464 1674 1464 1690 1474 1692 1474 1694 1474 1696 1474 2125 1464 2126 1451 2123 1421 1300 1410 1298 1410 1239 1423 1145 1423 1130 1411 1128 1411 1126 1411 1124 1411 1047 1421 1004 1411 1002 1411 1000 1411 998 1411 965 1421 918 1411 916 1411 914 1411 889 1421 875 1411 873 1411 871 1411 869 1411 867 1411 828 1423 642 1423 609 1411 607 1411 605 1411 603 1411 569 1421 534 1411 532 1411 530 1411 360 1419 362 1455"/>
                        </Shape>
                        <String CONTENT="intensify the power of the “spell,” as to defend one’s self against the revenge"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l18" HPOS="364" VPOS="1472" WIDTH="1198" HEIGHT="65" BASELINE="364 1511 1562 1511" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1511 364 1527 638 1527 648 1535 648 1537 650 1537 652 1537 654 1537 806 1527 1039 1537 1041 1537 1120 1527 1249 1537 1251 1537 1562 1527 1562 1511 1562 1480 1549 1472 1547 1472 1545 1472 1543 1472 1541 1472 1517 1482 1502 1472 1500 1472 1498 1472 1496 1472 1443 1482 1251 1472 1249 1472 1247 1472 1226 1482 1204 1472 1202 1472 1200 1472 1198 1472 1175 1482 1145 1472 1143 1472 1141 1472 1139 1472 1137 1472 1137 1474 1128 1484 887 1484 861 1472 859 1472 857 1472 855 1472 822 1484 642 1484 620 1472 618 1472 616 1472 614 1472 581 1482 546 1472 544 1472 542 1472 481 1482 456 1472 454 1472 452 1472 450 1472 428 1482 407 1472 405 1472 403 1472 401 1472 364 1482 364 1511"/>
                        </Shape>
                        <String CONTENT="of the dead person whose corpse is being despoiled."/>
                    </TextLine>
<TextLine ID="mz_2-210_l19" HPOS="468" VPOS="1529" WIDTH="1660" HEIGHT="61" BASELINE="470 1574 2128 1566" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 1574 470 1590 2126 1584 2128 1566 2125 1539 1895 1529 1893 1529 1709 1541 468 1541 470 1574"/>
                        </Shape>
                        <String CONTENT="It is supposed also that a human skull may be used as a vessel in which"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l20" HPOS="360" VPOS="1590" WIDTH="1768" HEIGHT="58" BASELINE="362 1635 2128 1629" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1635 362 1648 2126 1645 2128 1629 2125 1601 1888 1590 1886 1590 1817 1599 1760 1590 1758 1590 1613 1599 1566 1590 1564 1590 1466 1601 1092 1592 1090 1592 918 1603 869 1594 867 1594 726 1603 613 1594 611 1594 556 1603 517 1594 515 1594 513 1594 446 1603 379 1596 377 1596 376 1596 374 1596 360 1601 362 1635"/>
                        </Shape>
                        <String CONTENT="to cook certain magic preparations, though no details regarding this custom"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l21" HPOS="364" VPOS="1650" WIDTH="1764" HEIGHT="57" BASELINE="366 1693 2128 1690" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1693 366 1707 2126 1707 2128 1690 2126 1662 2095 1650 2093 1650 2091 1650 2040 1660 1842 1650 1841 1650 1772 1660 1739 1650 1737 1650 1735 1650 1629 1660 1443 1650 1441 1650 1394 1660 1329 1650 1327 1650 1224 1662 685 1652 683 1652 681 1652 679 1652 663 1664 532 1664 477 1652 475 1652 364 1664 366 1693"/>
                        </Shape>
                        <String CONTENT="are known. Several tales, however, mention old “women of spell,” who mix"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l22" HPOS="360" VPOS="1707" WIDTH="1770" HEIGHT="65" BASELINE="362 1754 2130 1746" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1754 362 1766 1666 1772 1668 1772 1670 1772 1692 1762 2130 1762 2130 1746 2123 1707 2095 1717 1817 1707 1815 1707 1684 1719 1296 1709 1294 1709 1179 1721 1135 1711 1133 1711 1132 1711 1006 1721 863 1711 861 1711 801 1723 761 1713 759 1713 757 1713 755 1713 726 1723 513 1713 511 1713 509 1713 475 1723 383 1713 381 1713 379 1713 377 1713 360 1721 362 1754"/>
                        </Shape>
                        <String CONTENT="their decoctions in a human skull: therefore our attempts to collect skulls of"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l23" HPOS="362" VPOS="1774" WIDTH="1766" HEIGHT="53" BASELINE="364 1813 2128 1807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1813 364 1827 2126 1823 2128 1807 2125 1780 381 1774 379 1774 377 1774 376 1774 362 1780 364 1813"/>
                        </Shape>
                        <String CONTENT="the natives were discouraged, and even caused us to be suspected of the"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l24" HPOS="364" VPOS="1840" WIDTH="352" HEIGHT="45" BASELINE="366 1868 716 1872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1868 364 1881 712 1885 716 1872 714 1844 366 1840 366 1868"/>
                        </Shape>
                        <String CONTENT="worst practices."/>
                    </TextLine>
<TextLine ID="mz_2-210_l25" HPOS="470" VPOS="1887" WIDTH="1655" HEIGHT="59" BASELINE="472 1932 2125 1927" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="472 1932 472 1946 2123 1946 2125 1927 2121 1899 2064 1887 2062 1887 1880 1897 1848 1887 1846 1887 1844 1887 1842 1887 1823 1897 1705 1887 1703 1887 1701 1887 1700 1887 1684 1897 1551 1889 1549 1889 1547 1889 1513 1899 1374 1889 1372 1889 1370 1889 1337 1901 470 1901 472 1932"/>
                        </Shape>
                        <String CONTENT="Similar methods of sorcery were used by other neighboring peoples."/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l26" HPOS="364" VPOS="1948" WIDTH="1764" HEIGHT="59" BASELINE="366 1991 2128 1987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1991 366 2007 2126 2007 2128 1987 2125 1960 2034 1948 2032 1948 2030 1948 2005 1958 1958 1948 1956 1948 1833 1958 1707 1948 1705 1948 1613 1958 1555 1948 1553 1948 1551 1948 1517 1960 1314 1960 1280 1948 1278 1948 1276 1948 1275 1948 1243 1960 1216 1950 1214 1950 1212 1950 1124 1960 1032 1950 1030 1950 1028 1950 996 1960 981 1950 979 1950 977 1950 975 1950 973 1950 934 1960 883 1950 881 1950 824 1960 738 1950 736 1950 364 1956 366 1991"/>
                        </Shape>
                        <String CONTENT="Thus Sarytcheff mentions¹ that, while he was on the Andreyanoff Islands, a"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l27" HPOS="362" VPOS="2007" WIDTH="1766" HEIGHT="59" BASELINE="364 2052 2128 2046" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2052 364 2066 2126 2064 2128 2046 2126 2019 2095 2007 2093 2007 2091 2007 2089 2007 2066 2017 2044 2007 2042 2007 2040 2007 2038 2007 2009 2017 1876 2007 1874 2007 1825 2017 1776 2007 1774 2007 1772 2007 1770 2007 1754 2019 1658 2019 1625 2007 1623 2007 1621 2007 1537 2019 1508 2009 1506 2009 1504 2009 1502 2009 1468 2019 1257 2009 1255 2009 1253 2009 1224 2021 1016 2021 961 2009 959 2009 957 2009 955 2009 934 2021 544 2011 542 2011 540 2011 501 2021 434 2011 432 2011 362 2022 364 2052"/>
                        </Shape>
                        <String CONTENT="native (Aleut) shaman said to one of his female patients, that her malady"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l28" HPOS="364" VPOS="2069" WIDTH="1764" HEIGHT="57" BASELINE="366 2111 2128 2107" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2111 366 2126 2126 2122 2128 2107 2125 2079 1247 2069 1245 2069 1243 2069 1218 2079 601 2071 599 2071 364 2081 366 2111"/>
                        </Shape>
                        <String CONTENT="was caused by her father, who, when in pursuit of sea-mammals, used to take"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l29" HPOS="364" VPOS="2140" WIDTH="1762" HEIGHT="47" BASELINE="364 2169 2126 2169" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2169 364 2187 2126 2187 2126 2169 2126 2140 364 2140 364 2169"/>
                        </Shape>
                        <String CONTENT="the brains out of dead men’s skulls in order to smear his harpoon-points with them."/>
                    </TextLine>
<TextLine ID="mz_2-210_l30" HPOS="470" VPOS="2185" WIDTH="1656" HEIGHT="71" BASELINE="472 2232 2126 2224" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="472 2232 472 2246 883 2256 885 2256 887 2256 930 2244 944 2254 945 2254 947 2254 949 2254 1137 2244 1220 2244 1233 2254 1235 2254 1237 2254 1239 2254 1351 2242 1498 2242 1513 2252 1515 2252 1517 2252 1519 2252 2125 2242 2126 2224 2123 2197 1936 2185 1935 2185 1839 2195 1813 2185 1811 2185 1809 2185 1807 2185 1770 2195 1748 2185 1747 2185 1745 2185 1743 2185 1707 2197 1647 2187 1645 2187 1643 2187 1613 2197 1582 2187 1580 2187 1578 2187 1576 2187 1574 2187 1560 2199 1378 2199 1298 2187 1296 2187 1294 2187 1292 2187 1273 2199 1061 2189 1059 2189 883 2201 830 2191 828 2191 826 2191 789 2201 752 2191 750 2191 748 2191 746 2191 708 2201 513 2191 511 2191 470 2199 472 2232"/>
                        </Shape>
                        <String CONTENT="SPELLS. — In the preparation of “spells” some typical methods, well known"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l31" HPOS="360" VPOS="2248" WIDTH="1768" HEIGHT="56" BASELINE="362 2293 2128 2287" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2293 362 2304 2126 2303 2128 2287 2125 2259 1686 2248 1684 2248 1598 2257 1545 2248 1543 2248 1541 2248 1539 2248 1527 2257 1419 2250 1417 2250 1416 2250 1414 2250 1398 2259 1122 2250 1120 2250 1118 2250 1086 2259 1049 2250 1047 2250 1045 2250 945 2261 736 2252 734 2252 732 2252 695 2263 360 2263 362 2293"/>
                        </Shape>
                        <String CONTENT="among many tribes, are used also by the Chukchee. Thus, to prepare a"/>
                    </TextLine>

                    <TextLine ID="mz_2-210_l32" HPOS="370" VPOS="2306" WIDTH="1756" HEIGHT="59" BASELINE="372 2350 2126 2344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 2350 372 2365 2125 2363 2126 2344 2123 2318 1968 2318 1952 2306 1950 2306 1948 2306 1946 2306 1944 2306 1917 2316 1705 2306 1703 2306 1652 2316 1604 2306 1602 2306 1513 2318 1439 2308 1437 2308 1435 2308 1400 2318 1182 2308 1180 2308 951 2320 370 2312 372 2350"/>
                        </Shape>
                        <String CONTENT="“spell,” one must procure some particle belonging to the victim’s body, — a"/>
