                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l2" HPOS="2063" VPOS="643" WIDTH="87" HEIGHT="62" BASELINE="2063 681 2150 681" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2128 645 2120 643 2072 643 2063 649 2063 681 2063 692 2094 705 2096 705 2098 705 2150 692 2150 681 2150 651 2128 645"/>
                        </Shape>
                        <String CONTENT="137"/>
