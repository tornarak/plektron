                <TextBlock ID="mz_1-179_r2" HPOS="365" VPOS="729" WIDTH="1778" HEIGHT="237" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="365 729 2143 729 2143 966 365 966"/>
                    </Shape>
                    <TextLine ID="mz_1-179_l3" HPOS="360" VPOS="723" WIDTH="1778" HEIGHT="58" BASELINE="362 766 2138 760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 766 362 781 2135 775 2138 760 2133 731 953 723 951 723 877 734 522 725 520 725 360 736 362 766"/>
                        </Shape>
                        <String CONTENT="account of its meat, which is considered the best of all game; also for its"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l4" HPOS="360" VPOS="792" WIDTH="1778" HEIGHT="50" BASELINE="362 827 2138 822" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 827 362 842 2135 838 2138 822 2133 794 360 792 362 827"/>
                        </Shape>
                        <String CONTENT="horns, which are used for manufacturing spoons, pronged clasps for the rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l5" HPOS="362" VPOS="844" WIDTH="1776" HEIGHT="58" BASELINE="362 885 2138 885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 885 362 902 2138 902 2138 885 2138 853 1993 844 1990 844 1876 855 1800 844 1798 844 1570 855 1538 844 1536 844 1533 844 1460 855 1425 844 1423 844 1421 844 1419 844 1391 857 1211 857 1176 844 1174 844 1172 844 1170 844 1137 855 1072 844 1070 844 1018 855 964 844 962 844 960 844 957 844 942 857 572 857 383 844 381 844 379 844 377 844 362 853 362 885"/>
                        </Shape>
                        <String CONTENT="deer-harness, cups, etc. Its skin is very soft and warm, and is considered"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l6" HPOS="362" VPOS="900" WIDTH="764" HEIGHT="61" BASELINE="364 941 1126 946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 941 362 957 1122 961 1126 946 1124 915 927 902 925 902 923 902 921 902 910 913 877 902 875 902 873 902 754 913 745 902 743 902 743 900 741 900 739 900 736 900 734 900 704 911 663 900 661 900 659 900 364 909 364 941"/>
                        </Shape>
                        <String CONTENT="more valuable than reindeer-skin."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-179_r3" HPOS="365" VPOS="966" WIDTH="1778" HEIGHT="244" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="365 966 2143 966 2143 1210 365 1210"/>
                    </Shape>
                    <TextLine ID="mz_1-179_l7" HPOS="468" VPOS="961" WIDTH="1670" HEIGHT="61" BASELINE="470 1006 2138 1002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 1006 470 1022 2135 1017 2138 1002 2133 974 2064 961 2062 961 1971 974 1889 974 1876 961 1873 961 1871 961 1869 961 1795 974 1622 974 1607 961 1605 961 1603 961 1601 961 1598 961 1557 974 1464 974 1449 961 1447 961 1445 961 1442 961 1300 974 1215 963 1213 963 1109 976 977 976 964 963 962 963 960 963 957 963 955 963 927 974 836 963 834 963 832 963 799 974 769 963 767 963 765 963 468 970 470 1006"/>
                        </Shape>
                        <String CONTENT="The mountain-sheep is very cautious, and lives only on rugged mountains."/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l8" HPOS="362" VPOS="1032" WIDTH="1776" HEIGHT="50" BASELINE="364 1067 2138 1063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1067 364 1082 2135 1078 2138 1063 2133 1032 362 1032 364 1067"/>
                        </Shape>
                        <String CONTENT="When caught on the plain, it immediately makes for the nearest hill, however"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l9" HPOS="362" VPOS="1091" WIDTH="1776" HEIGHT="50" BASELINE="362 1123 2138 1123" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1123 362 1141 2138 1141 2138 1123 2138 1091 362 1091 362 1123"/>
                        </Shape>
                        <String CONTENT="low and easy to climb. In this case the dogs hold the sheep at bay, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l10" HPOS="362" VPOS="1141" WIDTH="1033" HEIGHT="58" BASELINE="364 1186 1395 1182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1186 364 1199 1393 1197 1395 1182 1391 1154 1100 1141 1098 1141 1044 1151 1012 1141 1009 1141 1007 1141 1005 1141 981 1151 957 1141 955 1141 953 1141 873 1154 461 1143 459 1143 457 1143 455 1143 438 1154 383 1143 381 1143 379 1143 377 1143 362 1151 364 1186"/>
                        </Shape>
                        <String CONTENT="the hunter is able to catch it with his lasso."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-179_r4" HPOS="365" VPOS="1210" WIDTH="1778" HEIGHT="2045" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="365 1210 2143 1210 2143 3255 365 3255"/>
                    </Shape>
                    <TextLine ID="mz_1-179_l11" HPOS="466" VPOS="1210" WIDTH="1674" HEIGHT="50" BASELINE="468 1240 2140 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1240 466 1255 2135 1260 2140 1245 2140 1210 468 1210 468 1240"/>
                        </Shape>
                        <String CONTENT="Of fur-bearing animals, the most important are the white and the red"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l12" HPOS="360" VPOS="1264" WIDTH="1780" HEIGHT="58" BASELINE="362 1307 2140 1303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1307 362 1322 2138 1318 2140 1303 2135 1273 377 1264 375 1264 373 1264 370 1264 360 1271 362 1307"/>
                        </Shape>
                        <String CONTENT="fox. The former are much more numerous, though the red variety also lives"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l13" HPOS="360" VPOS="1320" WIDTH="1778" HEIGHT="61" BASELINE="362 1368 2138 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1368 362 1381 2135 1379 2138 1364 2133 1333 2042 1320 2040 1320 2038 1320 2019 1331 1997 1320 1995 1320 1993 1320 1921 1331 1906 1320 1904 1320 1902 1320 1899 1320 1800 1331 1752 1320 1750 1320 1748 1320 1746 1320 1722 1333 1453 1333 1380 1320 1378 1320 1219 1333 1098 1322 1096 1322 847 1333 732 1322 730 1322 678 1333 624 1322 622 1322 620 1322 585 1333 394 1322 392 1322 390 1322 360 1333 362 1368"/>
                        </Shape>
                        <String CONTENT="all along the Arctic and Pacific coasts, and is even met with and killed on"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l14" HPOS="364" VPOS="1396" WIDTH="1774" HEIGHT="48" BASELINE="364 1424 2138 1424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1424 364 1444 2138 1444 2138 1424 2138 1396 364 1396 364 1424"/>
                        </Shape>
                        <String CONTENT="the sea-ice while searching for young seals, or picking up bones left over from"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l15" HPOS="360" VPOS="1439" WIDTH="1780" HEIGHT="61" BASELINE="362 1485 2140 1481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1485 362 1500 2138 1496 2140 1481 2135 1452 1564 1439 1562 1439 1559 1439 1557 1439 1542 1450 1516 1439 1514 1439 1512 1439 1386 1450 1313 1439 1310 1439 1308 1439 1287 1450 1252 1439 1250 1439 1248 1439 1245 1439 1204 1452 1102 1442 1100 1442 1098 1442 1096 1442 1081 1455 960 1455 936 1442 934 1442 931 1442 871 1452 840 1442 838 1442 836 1442 752 1452 695 1442 693 1442 691 1442 689 1442 674 1452 639 1442 637 1442 635 1442 537 1452 481 1442 479 1442 477 1442 440 1452 386 1442 383 1442 381 1442 379 1442 360 1450 362 1485"/>
                        </Shape>
                        <String CONTENT="the feast of the polar bear. The Maritime and Reindeer Chukchee have"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l16" HPOS="362" VPOS="1515" WIDTH="1778" HEIGHT="46" BASELINE="362 1543 2140 1543" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1543 362 1561 2140 1561 2140 1543 2140 1515 362 1515 362 1543"/>
                        </Shape>
                        <String CONTENT="several methods of hunting the fox. The most simple is to run it down on"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l17" HPOS="362" VPOS="1563" WIDTH="1778" HEIGHT="67" BASELINE="364 1604 2140 1600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1604 364 1619 544 1630 546 1630 548 1630 572 1619 1133 1619 1222 1630 1224 1630 1226 1630 1254 1617 1679 1617 1694 1628 1696 1628 1698 1628 1700 1628 1787 1617 1817 1628 1819 1628 1821 1630 2040 1630 2040 1628 2042 1628 2079 1617 2116 1628 2118 1628 2120 1628 2122 1628 2125 1628 2140 1615 2140 1600 2135 1571 448 1563 446 1563 362 1574 364 1604"/>
                        </Shape>
                        <String CONTENT="a sledge with a swift team of dogs or reindeer. The best hunting-time is"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l18" HPOS="362" VPOS="1632" WIDTH="1780" HEIGHT="50" BASELINE="362 1665 2142 1665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1665 362 1682 2142 1682 2142 1665 2140 1632 362 1632 362 1665"/>
                        </Shape>
                        <String CONTENT="after the first snow has fallen, which discloses every trace of the animal, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l19" HPOS="364" VPOS="1695" WIDTH="1778" HEIGHT="45" BASELINE="364 1725 2142 1725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1725 364 1740 2142 1740 2142 1725 2142 1695 364 1695 364 1725"/>
                        </Shape>
                        <String CONTENT="makes it hard for it to escape. Swift reindeer are able to overtake a fox"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l20" HPOS="362" VPOS="1742" WIDTH="1782" HEIGHT="57" BASELINE="364 1786 2144 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1786 364 1799 2144 1794 2144 1781 2140 1745 399 1742 396 1742 394 1742 362 1753 364 1786"/>
                        </Shape>
                        <String CONTENT="after two or three hours of hard pursuit. When accustomed to that kind of"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l21" HPOS="362" VPOS="1801" WIDTH="1780" HEIGHT="61" BASELINE="364 1846 2142 1842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1846 364 1862 2140 1857 2142 1842 2140 1814 2090 1801 2088 1801 2086 1801 2023 1812 1876 1801 1873 1801 1811 1812 1785 1801 1782 1801 1780 1801 1731 1812 1705 1801 1702 1801 1700 1801 1698 1801 1663 1812 1624 1801 1622 1801 1620 1801 1330 1812 1252 1801 1250 1801 1248 1801 1245 1801 1226 1814 1154 1803 1152 1803 1150 1803 1120 1814 1102 1803 1100 1803 1098 1803 1096 1803 999 1814 710 1803 708 1803 362 1812 364 1846"/>
                        </Shape>
                        <String CONTENT="hunting, they become so excited that they try to trample the fox down. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l22" HPOS="364" VPOS="1875" WIDTH="1776" HEIGHT="45" BASELINE="364 1905 2140 1905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1905 364 1920 2140 1920 2140 1905 2140 1875 364 1875 364 1905"/>
                        </Shape>
                        <String CONTENT="reindeer is also used in hunting down the wolf, and will be just as eager to"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l23" HPOS="364" VPOS="1933" WIDTH="1776" HEIGHT="48" BASELINE="364 1963 2140 1963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1963 364 1981 2140 1981 2140 1963 2140 1933 364 1933 364 1963"/>
                        </Shape>
                        <String CONTENT="catch it and to strike it on the head with the hoof. In fox-hunting the rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l24" HPOS="364" VPOS="1994" WIDTH="1778" HEIGHT="49" BASELINE="364 2024 2142 2024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2024 364 2043 2142 2043 2142 2024 2142 1994 364 1994 364 2024"/>
                        </Shape>
                        <String CONTENT="deer-driver often does not rely exclusively on the swiftness of his team, but sends"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l25" HPOS="362" VPOS="2043" WIDTH="1778" HEIGHT="59" BASELINE="364 2087 2140 2082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2087 364 2102 2138 2098 2140 2082 2135 2048 427 2043 425 2043 362 2054 364 2087"/>
                        </Shape>
                        <String CONTENT="a hunting-dog after the fox, replacing it by another when the run has lasted"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l26" HPOS="362" VPOS="2104" WIDTH="1778" HEIGHT="56" BASELINE="364 2145 2140 2141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2145 364 2160 2138 2156 2140 2141 2135 2113 375 2104 373 2104 370 2104 368 2104 368 2106 362 2111 364 2145"/>
                        </Shape>
                        <String CONTENT="for a couple of hours (a dog-driver simply releases the swiftest dogs of his"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l27" HPOS="366" VPOS="2175" WIDTH="1774" HEIGHT="46" BASELINE="366 2204 2140 2204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2204 366 2221 2140 2221 2140 2204 2140 2175 366 2175 366 2204"/>
                        </Shape>
                        <String CONTENT="team one after another for the purpose: the fresh dog will be sure to catch"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l28" HPOS="366" VPOS="2223" WIDTH="1774" HEIGHT="59" BASELINE="366 2264 2140 2264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2264 366 2282 2140 2282 2140 2264 2140 2236 2036 2223 2034 2223 2032 2223 1997 2234 1416 2223 1414 2223 1412 2223 1371 2234 1336 2223 1334 2223 1332 2223 1330 2223 1293 2234 1243 2223 1241 2223 1176 2234 1098 2223 1096 2223 973 2234 840 2223 838 2223 775 2234 762 2223 760 2223 758 2223 659 2223 656 2223 591 2234 490 2223 487 2223 485 2223 442 2234 392 2223 390 2223 388 2223 366 2234 366 2264"/>
                        </Shape>
                        <String CONTENT="the tired animal). When possible, the fox leads the pursuit to some large"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l29" HPOS="364" VPOS="2290" WIDTH="1776" HEIGHT="50" BASELINE="366 2325 2140 2321" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2325 366 2340 2138 2336 2140 2321 2135 2292 364 2290 366 2325"/>
                        </Shape>
                        <String CONTENT="lake where the ice keeps bare of snow for a long time, and therefore is too"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l30" HPOS="366" VPOS="2342" WIDTH="1776" HEIGHT="59" BASELINE="366 2383 2142 2383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2383 366 2401 2142 2401 2142 2383 2142 2353 2116 2342 2114 2342 2112 2342 2109 2342 2084 2353 2029 2342 2027 2342 2025 2342 1990 2353 1954 2342 1951 2342 1949 2342 1564 2353 1505 2342 1503 2342 1501 2342 1466 2353 1369 2342 1367 2342 1271 2353 1241 2342 1239 2342 1237 2342 1170 2353 1118 2342 1115 2342 1113 2342 1070 2353 988 2342 986 2342 923 2353 788 2342 786 2342 723 2353 669 2342 667 2342 665 2342 630 2353 572 2342 570 2342 568 2342 565 2342 550 2355 444 2355 396 2342 394 2342 392 2342 390 2342 366 2353 366 2383"/>
                        </Shape>
                        <String CONTENT="slippery for the reindeer. The short feet of the fox, on such ground, give it"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l31" HPOS="364" VPOS="2409" WIDTH="1778" HEIGHT="52" BASELINE="364 2444 2142 2444" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2444 364 2461 2142 2461 2142 2444 2140 2409 364 2411 364 2444"/>
                        </Shape>
                        <String CONTENT="advantage even over the dog, facilitating sudden turns and retreats. A good"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l32" HPOS="366" VPOS="2474" WIDTH="1776" HEIGHT="46" BASELINE="366 2505 2142 2505" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2505 366 2520 2142 2520 2142 2505 2142 2474 366 2474 366 2505"/>
                        </Shape>
                        <String CONTENT="dog, however, would not give in, but would obstinately keep on with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l33" HPOS="366" VPOS="2522" WIDTH="1776" HEIGHT="63" BASELINE="366 2565 2142 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2565 366 2585 2142 2576 2142 2565 2142 2535 1988 2535 1969 2522 1967 2522 1964 2522 1962 2522 1960 2522 1932 2533 1889 2522 1886 2522 1884 2522 1882 2522 1839 2533 1774 2522 1772 2522 1769 2522 1737 2533 1525 2522 1523 2522 1520 2522 1518 2522 1501 2535 1315 2535 1113 2522 1111 2522 931 2533 875 2522 873 2522 784 2533 598 2522 596 2522 529 2533 492 2522 490 2522 487 2522 366 2533 366 2565"/>
                        </Shape>
                        <String CONTENT="pursuit. Sometimes the two adversaries are so tired that they lie down on"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l34" HPOS="366" VPOS="2593" WIDTH="1778" HEIGHT="48" BASELINE="366 2624 2144 2624" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2624 366 2641 2144 2641 2144 2624 2144 2593 366 2593 366 2624"/>
                        </Shape>
                        <String CONTENT="the ice opposite each other, and rest for a couple of minutes, keeping a close"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l35" HPOS="366" VPOS="2641" WIDTH="1776" HEIGHT="58" BASELINE="368 2684 2142 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2684 368 2699 2140 2695 2142 2680 2138 2652 1254 2641 1252 2641 1250 2641 1228 2652 442 2643 440 2643 366 2654 368 2684"/>
                        </Shape>
                        <String CONTENT="watch on each other’s motions. An old wily fox, when pursued, does not go"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l36" HPOS="366" VPOS="2706" WIDTH="1776" HEIGHT="65" BASELINE="368 2745 2142 2738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2745 368 2760 719 2771 721 2771 723 2771 726 2771 741 2758 1213 2758 1269 2769 1271 2769 1388 2758 1477 2769 1479 2769 1577 2756 1633 2767 1635 2767 1700 2756 1763 2767 1765 2767 1767 2767 1787 2756 1804 2767 1806 2767 1808 2767 1811 2767 2140 2756 2142 2738 2135 2706 366 2708 368 2745"/>
                        </Shape>
                        <String CONTENT="into its burrow, for it knows that it can be dug out from the shallow ground"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l37" HPOS="368" VPOS="2758" WIDTH="1774" HEIGHT="60" BASELINE="370 2803 2142 2799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2803 370 2818 2140 2816 2142 2799 2135 2767 1941 2769 1921 2758 1919 2758 1917 2758 1915 2758 1804 2769 1787 2758 1785 2758 1782 2758 1780 2758 1778 2758 1752 2769 1735 2758 1733 2758 1731 2758 1728 2758 1726 2758 1724 2758 1709 2771 1518 2771 1492 2758 1490 2758 1488 2758 1380 2769 1356 2758 1354 2758 1352 2758 1349 2758 1304 2769 1274 2758 1271 2758 1269 2758 1267 2758 1237 2771 1204 2760 1202 2760 1200 2760 1048 2771 996 2760 994 2760 921 2771 752 2760 749 2760 747 2760 704 2771 607 2760 604 2760 602 2760 578 2771 500 2760 498 2760 496 2760 472 2771 409 2760 407 2760 405 2760 368 2773 370 2803"/>
                        </Shape>
                        <String CONTENT="with but little difficulty. On the Arctic shore the crust of the unfrozen soil"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l38" HPOS="368" VPOS="2829" WIDTH="1774" HEIGHT="50" BASELINE="370 2864 2142 2860" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2864 370 2879 2140 2875 2142 2860 2138 2831 368 2829 370 2864"/>
                        </Shape>
                        <String CONTENT="is so thin, that the ramifications of the burrow extend directly under the sur-"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l39" HPOS="368" VPOS="2888" WIDTH="1774" HEIGHT="52" BASELINE="370 2920 2142 2925" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2920 368 2933 2138 2940 2142 2925 2140 2892 370 2888 370 2920"/>
                        </Shape>
                        <String CONTENT="face, and sometimes the roof can be broken in simply with the foot. Foxes,"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l40" HPOS="366" VPOS="2940" WIDTH="1776" HEIGHT="58" BASELINE="368 2979 2142 2983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2979 366 2994 2138 2998 2142 2983 2140 2953 1289 2953 1258 2940 1256 2940 1254 2940 368 2946 368 2979"/>
                        </Shape>
                        <String CONTENT="therefore, often prefer to lodge in hollow logs of driftwood or among stones"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l41" HPOS="368" VPOS="3011" WIDTH="1776" HEIGHT="48" BASELINE="368 3041 2144 3041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3041 368 3059 2144 3059 2144 3041 2144 3011 368 3011 368 3041"/>
                        </Shape>
                        <String CONTENT="rather than burrow in the ground. If the fox is in the burrow, the hunter"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l42" HPOS="366" VPOS="3070" WIDTH="1776" HEIGHT="49" BASELINE="368 3102 2142 3098" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3102 368 3119 2140 3115 2142 3098 2135 3070 366 3072 368 3102"/>
                        </Shape>
                        <String CONTENT="often enlarges the entrance with an axe or an ice-pick; then the fox is extri-"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l43" HPOS="370" VPOS="3132" WIDTH="1774" HEIGHT="46" BASELINE="370 3163 2144 3163" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 3163 370 3178 2144 3178 2144 3163 2144 3132 370 3132 370 3163"/>
                        </Shape>
                        <String CONTENT="cated with a split stick that catches in some of the hair of its coat, or even"/>
                    </TextLine>

                    <TextLine ID="mz_1-179_l44" HPOS="368" VPOS="3191" WIDTH="1774" HEIGHT="52" BASELINE="368 3223 2142 3223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 3223 368 3243 2142 3243 2142 3223 2142 3191 368 3191 368 3223"/>
                        </Shape>
                        <String CONTENT="simply with the hands, the animal having been dazed with smoke beforehand."/>
                    </TextLine>
</TextBlock>
