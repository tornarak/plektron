                    <TextLine ID="mz_1-136_l2" HPOS="675" VPOS="647" WIDTH="106" HEIGHT="54" BASELINE="675 675 781 675" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="675 649 675 675 675 688 742 701 744 701 747 701 781 688 781 675 781 647 677 647 675 649"/>
