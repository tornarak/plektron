                    <TextLine ID="mz_3-115_l7" HPOS="348" VPOS="804" WIDTH="1770" HEIGHT="58" BASELINE="348 845 2118 845" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 845 348 856 2114 862 2118 845 2116 815 2020 804 2019 804 1958 813 1886 804 1884 804 1882 804 1843 813 1674 804 1672 804 1572 813 1475 804 1473 804 1471 804 1469 804 1453 815 1132 815 1085 804 832 804 830 804 828 804 826 804 810 815 545 815 506 804 504 804 502 804 432 813 368 804 366 804 364 804 362 804 348 811 348 845"/>
                        </Shape>
                        <String CONTENT="this tale represents Head-Nodder as no great hero, and even gives him a"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l8" HPOS="348" VPOS="866" WIDTH="1772" HEIGHT="55" BASELINE="348 905 2120 905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 905 348 917 2118 921 2120 905 2120 870 348 866 348 905"/>
                        </Shape>
                        <String CONTENT="brother with the ridiculous name of Soft-Buttocks. The last name is formed"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l9" HPOS="344" VPOS="921" WIDTH="1776" HEIGHT="64" BASELINE="346 967 2120 962" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="346 967 346 985 2118 981 2120 962 2114 926 1800 930 1744 921 1742 921 1676 930 1623 921 1621 921 1619 921 1617 921 1601 930 1449 923 1447 923 1381 932 1292 923 1290 923 1239 932 1188 923 1186 923 1184 923 1182 923 1169 932 1118 923 1116 923 1114 923 1095 932 1081 923 1079 923 1077 923 974 923 972 923 970 923 968 923 952 932 894 924 892 924 890 924 888 924 871 936 594 936 572 924 570 924 416 924 415 924 344 936 346 967"/>
                        </Shape>
                        <String CONTENT="perhaps in contrast to the hard cheeks of Bony-Face. Bony-Face vanquished"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l10" HPOS="346" VPOS="991" WIDTH="1774" HEIGHT="52" BASELINE="348 1020 2120 1024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 1020 346 1036 358 1043 360 1043 362 1043 364 1043 2118 1036 2120 1024 2118 995 348 991 348 1020"/>
                        </Shape>
                        <String CONTENT="them without difficulty at one time or another. Perhaps these tales are the"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l11" HPOS="346" VPOS="1045" WIDTH="1778" HEIGHT="55" BASELINE="346 1082 2124 1082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="346 1082 346 1100 2122 1100 2124 1082 2120 1045 346 1053 346 1082"/>
                        </Shape>
                        <String CONTENT="reminiscences of some ancient local rivalries, or else an attempt at parody of"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l12" HPOS="348" VPOS="1104" WIDTH="1776" HEIGHT="56" BASELINE="348 1145 2124 1145" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2122 1145 2110 1114 2046 1104 2044 1104 2042 1104 2015 1114 1948 1104 1946 1104 1944 1104 1902 1114 1714 1104 1713 1104 1711 1104 1691 1114 1660 1104 1658 1104 1656 1104 1557 1114 1523 1104 1522 1104 1520 1104 1518 1104 1483 1114 1418 1104 1416 1104 1414 1104 1375 1114 1299 1104 1297 1104 1151 1114 1064 1104 1062 1104 945 1114 894 1104 892 1104 890 1104 851 1114 810 1104 808 1104 806 1104 804 1104 802 1104 787 1115 693 1115 617 1104 615 1104 537 1114 475 1104 473 1104 422 1114 372 1104 370 1104 368 1104 348 1114 348 1145 348 1160 2124 1160 2124 1145 2124 1115 2122 1114 2122 1145"/>
                        </Shape>
                        <String CONTENT="the old traditions. In the parallel case of the Russian epic legends of ancient"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l13" HPOS="350" VPOS="1164" WIDTH="1770" HEIGHT="57" BASELINE="350 1205 2120 1205" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1205 350 1219 2116 1221 2120 1205 2120 1174 2102 1164 2100 1164 2098 1164 2096 1164 1989 1174 1913 1164 1911 1164 1845 1174 1707 1164 1705 1164 1603 1174 1566 1164 1564 1164 1562 1164 1479 1174 1442 1164 1440 1164 1438 1164 1436 1164 1401 1174 1311 1164 1309 1164 1307 1164 1268 1174 1216 1164 1214 1164 1212 1164 1210 1164 1194 1176 1065 1176 1032 1164 1030 1164 1028 1164 951 1174 888 1164 886 1164 773 1174 724 1164 722 1164 646 1174 594 1164 592 1164 491 1174 454 1164 452 1164 450 1164 350 1174 350 1205"/>
                        </Shape>
                        <String CONTENT="warriors, these have given rise to the formation of certain parodies, which"/>
