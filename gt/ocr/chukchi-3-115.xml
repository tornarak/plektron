                        </Shape>
                        <String CONTENT="are also quite ancient."/>
                    </TextLine>
<TextLine ID="mz_3-115_l15" HPOS="461" VPOS="1283" WIDTH="1663" HEIGHT="57" BASELINE="461 1324 2124 1324" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 1324 461 1340 2124 1340 2124 1324 2124 1293 2087 1283 2085 1283 2083 1283 1997 1293 461 1285 461 1324"/>
                        </Shape>
                        <String CONTENT="Temeˊereč, or, in diminutive form, Temeereˊčeqäi, is a young man light"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l16" HPOS="348" VPOS="1343" WIDTH="1774" HEIGHT="57" BASELINE="348 1384 2122 1384" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 1384 348 1400 2122 1400 2122 1384 2110 1351 2079 1343 2077 1343 2075 1343 2003 1353 1523 1343 1522 1343 1520 1343 1518 1343 1502 1355 1184 1355 1106 1343 1104 1343 1009 1353 974 1343 972 1343 970 1343 882 1353 849 1343 847 1343 845 1343 783 1353 717 1343 715 1343 648 1353 615 1343 613 1343 611 1343 475 1353 389 1343 387 1343 385 1343 348 1353 348 1384"/>
                        </Shape>
                        <String CONTENT="of foot and quick of motion. His parents were killed by Taˊn˙ñɪt, and he"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l17" HPOS="348" VPOS="1402" WIDTH="558" HEIGHT="62" BASELINE="350 1439 906 1443" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1439 348 1457 362 1464 364 1464 366 1464 368 1464 904 1457 906 1443 904 1416 798 1404 797 1404 705 1414 627 1402 625 1402 623 1402 594 1412 524 1402 522 1402 350 1410 350 1439"/>
                        </Shape>
                        <String CONTENT="was left a little orphan."/>
                    </TextLine>
<TextLine ID="mz_3-115_l18" HPOS="457" VPOS="1496" WIDTH="1665" HEIGHT="54" BASELINE="459 1525 2122 1531" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="459 1525 457 1536 2118 1550 2122 1531 2120 1501 459 1496 459 1525"/>
                        </Shape>
                        <String CONTENT="“One time the Taˊn˙ñɪt made inroads on the Chukchee territory. The people fled, driving"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l19" HPOS="348" VPOS="1544" WIDTH="1772" HEIGHT="51" BASELINE="350 1572 2120 1575" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1572 348 1583 374 1595 376 1595 378 1595 2118 1593 2120 1575 2118 1548 350 1544 350 1572"/>
                        </Shape>
                        <String CONTENT="with reindeer. The little boy was walking ahead. The first driver overtook him. ‘Take me with"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l20" HPOS="350" VPOS="1591" WIDTH="1768" HEIGHT="49" BASELINE="350 1618 2118 1622" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1618 350 1640 2116 1634 2118 1622 2116 1595 350 1591 350 1618"/>
                        </Shape>
                        <String CONTENT="you!’ — ‘Let the rear drivers take you.’ The rear drivers overtook him. ‘Take me with you!’ —"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l21" HPOS="350" VPOS="1640" WIDTH="1770" HEIGHT="50" BASELINE="352 1667 2120 1671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1667 350 1677 370 1688 372 1688 374 1688 1087 1681 2116 1690 2120 1671 2118 1644 352 1640 352 1667"/>
                        </Shape>
                        <String CONTENT="‘Let the last ones take you.’ Then the very last one came to him. ‘Take me with you!’ — ‘No,"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l22" HPOS="348" VPOS="1677" WIDTH="1351" HEIGHT="52" BASELINE="350 1716 1699 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1716 350 1729 1697 1725 1699 1712 1693 1677 348 1686 350 1716"/>
                        </Shape>
                        <String CONTENT="let them that are behind take you! — ‘Ah me! There is no one behind.’¹"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l23" HPOS="459" VPOS="1727" WIDTH="1665" HEIGHT="49" BASELINE="461 1755 2124 1763" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 1755 459 1768 2120 1776 2124 1763 2122 1735 461 1727 461 1755"/>
                        </Shape>
                        <String CONTENT="“The last man went away, and the boy was left alone. He followed the tracks of the drivers."/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l24" HPOS="350" VPOS="1772" WIDTH="1774" HEIGHT="55" BASELINE="352 1809 2124 1805" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1809 352 1825 2120 1827 2124 1805 2120 1780 370 1772 368 1772 366 1772 364 1772 350 1778 352 1809"/>
                        </Shape>
                        <String CONTENT="A small boy he was, but a clever one. He carried in his hands a child’s bow and one arrow with"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l25" HPOS="352" VPOS="1829" WIDTH="1770" HEIGHT="41" BASELINE="352 1854 2122 1854" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1854 352 1870 2120 1870 2122 1854 2112 1829 352 1829 352 1854"/>
                        </Shape>
                        <String CONTENT="a copper head. The line of the pursuing Taˊn˙ñɪt was approaching from behind, the strongest"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l26" HPOS="348" VPOS="1870" WIDTH="1772" HEIGHT="45" BASELINE="350 1899 2120 1903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1899 348 1911 2116 1915 2120 1903 2118 1870 350 1870 350 1899"/>
                        </Shape>
                        <String CONTENT="warrior was far ahead. The boy looked back and thought, ‘What shall I do?’ He ran and fell"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l27" HPOS="348" VPOS="1913" WIDTH="1770" HEIGHT="52" BASELINE="350 1950 2118 1946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1950 350 1965 2116 1965 2118 1946 2114 1920 366 1913 364 1913 362 1913 360 1913 348 1918 350 1950"/>
                        </Shape>
                        <String CONTENT="down, jumped up and ran again. The Taˊn˙ñɪn warrior saw him running and jumped down from"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l28" HPOS="348" VPOS="1959" WIDTH="1772" HEIGHT="51" BASELINE="350 1996 2120 1992" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1996 350 2010 2118 2006 2120 1992 2116 1967 366 1959 364 1959 362 1959 360 1959 348 1965 350 1996"/>
                        </Shape>
                        <String CONTENT="the sledge. Then he took off his armor and put it on the sledge, and also the spear. The spear"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l29" HPOS="348" VPOS="2012" WIDTH="1772" HEIGHT="45" BASELINE="350 2041 2120 2037" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2041 350 2057 2118 2055 2120 2037 2114 2012 348 2014 350 2041"/>
                        </Shape>
                        <String CONTENT="was a very strong one. The handle was thicker than a man’s arm. He ran, leading the reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l30" HPOS="348" VPOS="2053" WIDTH="1770" HEIGHT="51" BASELINE="350 2090 2118 2086" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2090 350 2104 2116 2100 2118 2086 2112 2053 348 2057 350 2090"/>
                        </Shape>
                        <String CONTENT="by the bridle. The boy thought, ‘This one will crush me with his nail as he would a little louse.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l31" HPOS="346" VPOS="2100" WIDTH="1774" HEIGHT="52" BASELINE="348 2135 2120 2131" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 2135 348 2152 2118 2152 2120 2131 2116 2100 346 2100 348 2135"/>
                        </Shape>
                        <String CONTENT="He looked back again. The Taˊn˙ñɪn warrior was getting nearer. In a few moments he would"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l32" HPOS="348" VPOS="2150" WIDTH="1772" HEIGHT="45" BASELINE="350 2178 2120 2182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2178 348 2191 2116 2195 2120 2182 2118 2154 350 2150 350 2178"/>
                        </Shape>
                        <String CONTENT="overtake him. The fur shirt of the Taˊn˙ñɪn was very short: it hardly covered his abdomen. The"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l33" HPOS="350" VPOS="2195" WIDTH="1770" HEIGHT="49" BASELINE="350 2228 2120 2228" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2228 350 2242 2116 2244 2120 2228 2118 2201 350 2195 350 2228"/>
                        </Shape>
                        <String CONTENT="boy shot his bow and wounded him in the abdomen. The warrior sat down upon the snow."/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l34" HPOS="352" VPOS="2244" WIDTH="1766" HEIGHT="54" BASELINE="354 2273 2118 2277" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="354 2273 352 2283 374 2295 376 2295 378 2295 1165 2287 1286 2296 1288 2298 2116 2298 2118 2277 2116 2248 354 2244 354 2273"/>
                        </Shape>
                        <String CONTENT="‘Stop, boy!’ said the warrior. ‘Come here!’ The boy was afraid to come. The Taˊn˙ñɪn stood up,"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l35" HPOS="350" VPOS="2295" WIDTH="1770" HEIGHT="42" BASELINE="350 2320 2120 2320" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2320 350 2335 2116 2337 2120 2320 2118 2295 350 2295 350 2320"/>
                        </Shape>
                        <String CONTENT="took the spear from the sledge, and put it on the ground. He also took off his armor and put it"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l36" HPOS="350" VPOS="2337" WIDTH="1770" HEIGHT="43" BASELINE="352 2365 2120 2369" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2365 350 2376 2116 2380 2120 2369 2118 2341 352 2337 352 2365"/>
                        </Shape>
                        <String CONTENT="down. ‘Come here! I will not hurt you. It is for your benefit.’ Then the boy came. ‘There, take"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l37" HPOS="348" VPOS="2380" WIDTH="1772" HEIGHT="49" BASELINE="350 2411 2120 2415" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2411 348 2425 2116 2429 2120 2415 2116 2380 350 2382 350 2411"/>
                        </Shape>
                        <String CONTENT="the bow and spear and armor. Put on all of it, take the sledge, and drive on. Do not be afraid"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l38" HPOS="350" VPOS="2425" WIDTH="1528" HEIGHT="51" BASELINE="352 2460 1878 2458" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2460 352 2476 1876 2474 1878 2458 1872 2425 350 2433 352 2460"/>
                        </Shape>
                        <String CONTENT="of our people. They will find my body and turn back, because I am the strongest.’²"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l39" HPOS="461" VPOS="2476" WIDTH="1661" HEIGHT="47" BASELINE="463 2503 2122 2509" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="463 2503 461 2517 2118 2523 2122 2509 2120 2482 463 2476 463 2503"/>
                        </Shape>
                        <String CONTENT="“After that the boy came home and lived with his uncle. He was growing fast, and all the"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l40" HPOS="348" VPOS="2525" WIDTH="1772" HEIGHT="44" BASELINE="350 2552 2120 2556" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 2552 348 2565 2116 2569 2120 2556 2118 2528 350 2525 350 2552"/>
                        </Shape>
                        <String CONTENT="time performing exercises. One time when the people arranged a reindeer-race, the young hero"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l41" HPOS="350" VPOS="2569" WIDTH="1770" HEIGHT="49" BASELINE="352 2599 2120 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2599 350 2612 2116 2618 2120 2602 2116 2569 352 2569 352 2599"/>
                        </Shape>
                        <String CONTENT="offered to draw his uncle’s sledge, acting in place of a reindeer-buck. He prepared the sledge and"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l42" HPOS="352" VPOS="2622" WIDTH="1768" HEIGHT="43" BASELINE="352 2649 2120 2649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2649 352 2663 2118 2665 2120 2649 2120 2622 352 2622 352 2649"/>
                        </Shape>
                        <String CONTENT="attached the traces and put on the breast-collar. Then he said to his uncle, ‘Put the bridle on"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l43" HPOS="350" VPOS="2665" WIDTH="1770" HEIGHT="47" BASELINE="352 2696 2120 2692" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2696 352 2708 2116 2712 2120 2692 2114 2665 350 2667 352 2696"/>
                        </Shape>
                        <String CONTENT="me!’ — ‘No need of it,’ said the uncle. ‘Go along!’ He rushed forward. ‘Wait, wait!’ cried his"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l44" HPOS="350" VPOS="2712" WIDTH="1770" HEIGHT="44" BASELINE="352 2739 2120 2743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2739 350 2751 2116 2756 2120 2743 2118 2716 352 2712 352 2739"/>
                        </Shape>
                        <String CONTENT="uncle. ‘The sledge jolts too much.’ He put the bridle on the young man and took the reins."/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l45" HPOS="354" VPOS="2753" WIDTH="515" HEIGHT="50" BASELINE="354 2786 869 2786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="354 2786 354 2803 869 2803 869 2786 867 2753 354 2758 354 2786"/>
                        </Shape>
                        <String CONTENT="‘Now everything is all right.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-115_l46" HPOS="454" VPOS="2801" WIDTH="1668" HEIGHT="55" BASELINE="455 2829 2122 2834" TAGREFS="TYPE_5">
