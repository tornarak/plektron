                        </Shape>
                        <String CONTENT="like angry reindeer-bucks, inviting our warriors to single combat.”"/>
                    </TextLine>
<TextLine ID="mz_3-117_l30" HPOS="467" VPOS="2193" WIDTH="1670" HEIGHT="59" BASELINE="469 2238 2137 2234" TAGREFS="TYPE_6">
