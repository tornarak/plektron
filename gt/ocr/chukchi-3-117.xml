                        </Shape>
                        <String CONTENT="One tale mentions the first impression of the coming of the Cossacks: —"/>
                    </TextLine>
<TextLine ID="mz_3-117_l25" HPOS="473" VPOS="1920" WIDTH="1664" HEIGHT="49" BASELINE="473 1952 2137 1952" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="473 1952 473 1969 2137 1969 2137 1952 2135 1920 473 1924 473 1952"/>
                        </Shape>
                        <String CONTENT="“When they first, came, our people were very much afraid of them, because they were of"/>
                    </TextLine>

                    <TextLine ID="mz_3-117_l26" HPOS="362" VPOS="1965" WIDTH="1773" HEIGHT="53" BASELINE="364 2004 2135 1998" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2004 364 2018 2134 2012 2135 1998 2132 1973 976 1965 974 1965 894 1975 415 1967 413 1967 362 1977 364 2004"/>
                        </Shape>
                        <String CONTENT="quite unknown appearance. Their whiskers stood out like those of the walrus. Their spear-"/>
                    </TextLine>

                    <TextLine ID="mz_3-117_l27" HPOS="362" VPOS="2016" WIDTH="1773" HEIGHT="51" BASELINE="364 2051 2135 2045" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2051 364 2067 2134 2063 2135 2045 2130 2016 362 2020 364 2051"/>
                        </Shape>
                        <String CONTENT="heads were a cubit long, and so broad that they obscured the sun. Their eyes were of iron, round"/>
