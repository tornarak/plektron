                        </Shape>
                        <String CONTENT="Kalêˊlɪ-taˊɪrg̣ɪn (“spotted taˊɪrg̣ɪn”) covers the skin with large spots of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l4" HPOS="378" VPOS="807" WIDTH="1776" HEIGHT="65" BASELINE="381 857 2154 848" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 857 381 872 2152 863 2154 848 2150 818 1773 807 1771 807 1674 818 1266 809 1264 809 1262 809 1232 822 378 822 381 857"/>
                        </Shape>
                        <String CONTENT="light, ashen color, often over the whole body, including the face and the hair"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l5" HPOS="381" VPOS="872" WIDTH="1773" HEIGHT="58" BASELINE="383 915 2154 911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 915 383 928 2150 930 2154 911 2150 881 422 872 420 872 417 872 381 883 383 915"/>
                        </Shape>
