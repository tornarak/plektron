                    <TextLine ID="mz_1-065_l18" HPOS="491" VPOS="1656" WIDTH="1665" HEIGHT="58" BASELINE="493 1695 2156 1688" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="493 1695 493 1710 2135 1714 2137 1714 2139 1714 2141 1714 2156 1703 2156 1688 2150 1656 491 1660 493 1695"/>
                        </Shape>
                        <String CONTENT="I met two dwarfs. One of them was married, and had three well-developed"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l19" HPOS="381" VPOS="1706" WIDTH="1773" HEIGHT="64" BASELINE="383 1755 2154 1747" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1755 383 1770 2152 1762 2154 1747 2152 1716 2135 1706 2133 1706 2130 1706 2128 1706 2126 1706 2105 1716 2059 1706 2057 1706 2055 1706 2053 1706 2050 1706 2035 1719 1808 1719 1734 1706 1732 1706 1730 1706 1704 1719 1619 1708 1617 1708 1615 1708 1578 1719 1295 1708 1292 1708 1204 1721 1037 1710 1035 1710 790 1723 411 1712 409 1712 407 1712 381 1723 383 1755"/>
                        </Shape>
                        <String CONTENT="children. There were several weak-minded people. One of them was a deaf-"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l20" HPOS="383" VPOS="1773" WIDTH="1771" HEIGHT="58" BASELINE="385 1816 2154 1807" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1816 385 1831 2152 1822 2154 1807 2150 1779 827 1773 825 1773 383 1786 385 1816"/>
                        </Shape>
                        <String CONTENT="mute; another had been struck with the palsy, and could not walk or move"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l21" HPOS="383" VPOS="1835" WIDTH="1771" HEIGHT="55" BASELINE="385 1874 2154 1868" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1874 385 1890 2152 1883 2154 1868 2148 1835 383 1838 385 1874"/>
                        </Shape>
                        <String CONTENT="his left hand. But the Chukchee had no notion of supernatural power possessed"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l22" HPOS="383" VPOS="1887" WIDTH="1771" HEIGHT="63" BASELINE="385 1933 2154 1929" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1933 385 1950 2152 1946 2154 1929 2150 1898 1269 1887 1266 1887 1264 1887 1262 1887 1247 1900 383 1900 385 1933"/>
                        </Shape>
                        <String CONTENT="by such people, as is held by the American Eskimo. Cases of violent madness"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l23" HPOS="383" VPOS="1952" WIDTH="1771" HEIGHT="54" BASELINE="385 1993 2154 1987" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1993 385 2006 2152 2002 2154 1987 2150 1954 413 1952 411 1952 409 1952 383 1961 385 1993"/>
                        </Shape>
                        <String CONTENT="also occur. I was told by a woman shaman that she was out of her mind"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l24" HPOS="383" VPOS="2011" WIDTH="1771" HEIGHT="56" BASELINE="383 2052 2154 2052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2052 383 2067 2154 2067 2154 2052 2154 2024 1749 2011 1747 2011 1661 2022 1602 2011 1600 2011 1598 2011 1596 2011 1580 2022 1507 2011 1505 2011 1409 2022 1355 2011 1353 2011 1221 2022 1175 2011 1173 2011 1171 2011 1052 2022 1020 2011 1017 2011 1015 2011 1013 2011 987 2024 842 2024 794 2011 792 2011 790 2011 788 2011 786 2011 770 2024 573 2024 502 2011 500 2011 498 2011 456 2022 402 2011 400 2011 398 2011 396 2011 383 2019 383 2052"/>
                        </Shape>
                        <String CONTENT="for three years, because of a spell wrought on her by a rival. When in a"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l25" HPOS="383" VPOS="2069" WIDTH="1769" HEIGHT="61" BASELINE="385 2113 2152 2106" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 2113 385 2130 2150 2123 2152 2106 2148 2078 974 2069 972 2069 900 2080 396 2071 394 2071 391 2071 389 2071 389 2074 383 2078 385 2113"/>
                        </Shape>
                        <String CONTENT="fit, she would lose all feeling in her wrists, and sometimes in her whole body."/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l26" HPOS="383" VPOS="2130" WIDTH="1771" HEIGHT="58" BASELINE="385 2171 2154 2167" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 2171 385 2188 2152 2184 2154 2167 2150 2139 409 2130 407 2130 404 2130 383 2139 385 2171"/>
                        </Shape>
                        <String CONTENT="At such times she would snatch a stone and pound her fingers with it, without"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l27" HPOS="381" VPOS="2190" WIDTH="1771" HEIGHT="59" BASELINE="383 2234 2152 2229" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2234 383 2249 2150 2245 2152 2229 2148 2199 398 2190 396 2190 394 2190 391 2190 381 2197 383 2234"/>
                        </Shape>
                        <String CONTENT="feeling any pain. In fact, the upper joints of two of her fingers were missing."/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l28" HPOS="378" VPOS="2255" WIDTH="1774" HEIGHT="55" BASELINE="381 2292 2152 2286" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2292 381 2310 2150 2303 2152 2286 2146 2255 378 2258 381 2292"/>
                        </Shape>
                        <String CONTENT="Frequently she would want to harm other people, and then her housemates"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l29" HPOS="383" VPOS="2307" WIDTH="1399" HEIGHT="61" BASELINE="385 2353 1782 2349" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 2353 385 2368 1780 2364 1782 2349 1777 2320 1704 2307 1702 2307 1700 2307 1697 2307 1678 2320 1544 2320 1520 2307 1518 2307 1515 2307 1463 2318 1446 2307 1444 2307 1442 2307 1440 2307 1437 2307 1435 2307 1418 2318 1392 2307 1390 2307 1388 2307 1386 2307 1357 2320 1119 2320 1093 2307 1091 2307 1089 2307 1087 2307 1084 2307 1084 2310 1082 2310 1076 2318 1067 2310 1065 2310 1063 2310 1061 2310 1059 2310 1037 2320 1015 2310 1013 2310 1011 2310 766 2320 718 2310 716 2310 714 2310 651 2320 623 2310 621 2310 619 2310 617 2310 595 2320 560 2310 558 2310 556 2310 554 2310 530 2320 478 2310 476 2310 383 2323 385 2353"/>
                        </Shape>
                        <String CONTENT="would tie her hands and bind her to one of the house-poles."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-065_r5" HPOS="383" VPOS="2373" WIDTH="1778" HEIGHT="233" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="383 2373 2161 2373 2161 2606 383 2606"/>
                    </Shape>
                    <TextLine ID="mz_1-065_l30" HPOS="489" VPOS="2379" WIDTH="1665" HEIGHT="50" BASELINE="491 2413 2154 2409" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="491 2413 491 2429 2152 2426 2154 2409 2150 2379 489 2379 491 2413"/>
                        </Shape>
                        <String CONTENT="In another case I heard that a man of the Reindeer division of the tribe,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l31" HPOS="381" VPOS="2426" WIDTH="1773" HEIGHT="63" BASELINE="383 2474 2154 2468" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2474 383 2489 2152 2483 2154 2468 2150 2437 1585 2426 1583 2426 1580 2426 1557 2437 424 2431 422 2431 420 2431 381 2442 383 2474"/>
                        </Shape>
                        <String CONTENT="who for a long time was afflicted with similar fits, kept making attempts to"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l32" HPOS="381" VPOS="2487" WIDTH="1771" HEIGHT="63" BASELINE="383 2535 2152 2528" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2535 383 2550 2150 2543 2152 2528 2148 2498 1671 2487 1669 2487 1554 2498 1091 2489 1089 2489 381 2500 383 2535"/>
                        </Shape>
                        <String CONTENT="injure his camp-companions, and ultimately was put out of the way by common"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l33" HPOS="385" VPOS="2563" WIDTH="193" HEIGHT="47" BASELINE="385 2591 578 2591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 2591 385 2610 578 2610 578 2591 578 2563 385 2563 385 2591"/>
                        </Shape>
                        <String CONTENT="consent."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-065_r6" HPOS="383" VPOS="2606" WIDTH="1778" HEIGHT="485" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="383 2606 2161 2606 2161 3091 383 3091"/>
                    </Shape>
                    <TextLine ID="mz_1-065_l34" HPOS="491" VPOS="2617" WIDTH="1663" HEIGHT="52" BASELINE="493 2652 2154 2645" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="493 2652 493 2669 2152 2662 2154 2645 2150 2617 491 2617 493 2652"/>
                        </Shape>
                        <String CONTENT="Blindness occurs often, especially among old people. The young herdsmen"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l35" HPOS="381" VPOS="2680" WIDTH="1775" HEIGHT="54" BASELINE="383 2712 2156 2708" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2712 383 2725 2133 2734 2135 2734 2137 2734 2139 2734 2156 2723 2156 2708 2150 2680 381 2682 383 2712"/>
                        </Shape>
                        <String CONTENT="often have sore eyes on account of loss of sleep in the seasons when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l36" HPOS="381" VPOS="2727" WIDTH="1773" HEIGHT="63" BASELINE="383 2773 2154 2766" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2773 383 2790 2152 2784 2154 2766 2150 2738 1563 2727 1561 2727 1559 2727 1518 2740 381 2740 383 2773"/>
                        </Shape>
                        <String CONTENT="herding of the reindeer requires extra exertion, and because of the corrosive"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l37" HPOS="381" VPOS="2790" WIDTH="1773" HEIGHT="65" BASELINE="383 2833 2154 2827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2833 383 2849 1561 2855 1563 2855 1628 2844 2152 2844 2154 2827 2150 2799 974 2790 972 2790 892 2801 443 2792 441 2792 381 2803 383 2833"/>
                        </Shape>
                        <String CONTENT="action of sweat mixed with dirt. Snow-blindness in the spring is very common"/>
                    </TextLine>

