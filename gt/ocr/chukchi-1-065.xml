                    </TextLine>

                    <TextLine ID="mz_1-065_l6" HPOS="383" VPOS="926" WIDTH="1771" HEIGHT="65" BASELINE="385 974 2154 969" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 974 385 991 2152 987 2154 969 2150 935 1578 926 1576 926 1574 926 1550 939 1379 939 1353 926 1351 926 1349 926 1347 926 1344 926 1327 937 1303 926 1301 926 1299 926 1297 926 1264 939 1238 928 1236 928 1234 928 1232 928 1208 941 1013 941 976 928 974 928 972 928 970 928 931 939 877 928 874 928 872 928 825 939 751 928 749 928 680 939 634 928 632 928 630 928 628 928 602 941 456 941 430 928 428 928 426 928 424 928 383 941 385 974"/>
                        </Shape>
                        <String CONTENT="who was affected by this disease, received the name of Keliˊlɪ-Tuˊrkew (“Spotted"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l7" HPOS="385" VPOS="995" WIDTH="1769" HEIGHT="55" BASELINE="387 1034 2154 1028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="387 1034 387 1050 2152 1043 2154 1028 2148 995 385 995 387 1034"/>
                        </Shape>
                        <String CONTENT="Tuˊrkew”). He was well known in the Anui country on account of his piebald"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l8" HPOS="385" VPOS="1047" WIDTH="1622" HEIGHT="61" BASELINE="385 1088 2007 1093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1088 385 1108 2005 1108 2007 1093 2007 1063 1975 1050 1972 1050 1970 1050 1858 1060 1771 1050 1769 1050 1767 1050 1732 1060 1697 1050 1695 1050 1693 1050 1635 1060 1591 1050 1589 1050 1587 1050 1585 1050 1554 1060 1489 1050 1487 1050 1485 1050 1442 1060 1349 1050 1347 1050 1197 1060 1147 1047 1145 1047 1143 1047 1141 1047 1115 1058 935 1047 933 1047 825 1058 385 1054 385 1088"/>
                        </Shape>
                        <String CONTENT="hair. At the age of fifty years he was still active for his time of life."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-065_r3" HPOS="383" VPOS="1117" WIDTH="1778" HEIGHT="533" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="383 1117 2161 1117 2161 1650 383 1650"/>
                    </Shape>
                    <TextLine ID="mz_1-065_l9" HPOS="487" VPOS="1121" WIDTH="1669" HEIGHT="48" BASELINE="489 1153 2156 1149" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="489 1153 489 1169 2154 1164 2156 1149 2152 1121 487 1121 489 1153"/>
                        </Shape>
                        <String CONTENT="I came across five deaf-mutes. Three of them were full-grown, and took"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l10" HPOS="381" VPOS="1166" WIDTH="1773" HEIGHT="70" BASELINE="383 1214 2154 1208" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1214 383 1236 2152 1223 2154 1208 2150 1179 1765 1166 1762 1166 1760 1166 1736 1177 1108 1169 1106 1169 1052 1179 1004 1169 1002 1169 1000 1169 885 1182 606 1171 604 1171 554 1182 515 1171 513 1171 511 1171 508 1171 506 1171 493 1182 469 1173 467 1173 465 1173 381 1184 383 1214"/>
                        </Shape>
                        <String CONTENT="part in all the daily pursuits of their camp. They communicated with other"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l11" HPOS="383" VPOS="1231" WIDTH="1769" HEIGHT="63" BASELINE="385 1275 2152 1268" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1275 385 1294 2150 1292 2152 1268 2148 1240 1017 1231 1015 1231 383 1244 385 1275"/>
                        </Shape>
                        <String CONTENT="people by means of simple signs. Sleep, for instance, was expressed by leaning"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l12" HPOS="383" VPOS="1292" WIDTH="1771" HEIGHT="58" BASELINE="385 1333 2154 1327" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1333 385 1350 2152 1344 2154 1327 2150 1299 404 1292 402 1292 400 1292 398 1292 383 1299 385 1333"/>
                        </Shape>
                        <String CONTENT="the face on the palm; eating and drinking, by representative motions of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l13" HPOS="383" VPOS="1350" WIDTH="1773" HEIGHT="61" BASELINE="385 1394 2156 1387" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1394 385 1411 2154 1405 2156 1387 2150 1350 383 1357 385 1394"/>
                        </Shape>
                        <String CONTENT="hand to the mouth; woman, by forming an imaginary braid on each side of"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l14" HPOS="381" VPOS="1420" WIDTH="1773" HEIGHT="50" BASELINE="383 1452 2154 1448" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1452 383 1470 2152 1465 2154 1448 2148 1420 381 1422 383 1452"/>
                        </Shape>
                        <String CONTENT="the face; man, by pointing out the mustache; going, by a motion of two"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l15" HPOS="381" VPOS="1467" WIDTH="1773" HEIGHT="63" BASELINE="383 1515 2154 1509" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1515 383 1530 2152 1524 2154 1509 2152 1480 2115 1467 2113 1467 2111 1467 2109 1467 2085 1478 2061 1467 2059 1467 2057 1467 1888 1478 1814 1467 1812 1467 1645 1478 1619 1467 1617 1467 1615 1467 1531 1480 1472 1470 1470 1470 1269 1480 1173 1470 1171 1470 1169 1470 1136 1480 1009 1470 1007 1470 1004 1470 968 1483 398 1472 396 1472 394 1472 391 1472 381 1478 383 1515"/>
                        </Shape>
                        <String CONTENT="fingers on the palm; etc. These signs are similar to those used by the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l16" HPOS="383" VPOS="1543" WIDTH="1771" HEIGHT="48" BASELINE="383 1571 2154 1571" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1571 383 1586 2152 1591 2154 1571 2154 1543 383 1543 383 1571"/>
                        </Shape>
                        <String CONTENT="chee for communicating with people who do not understand their language,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l17" HPOS="383" VPOS="1589" WIDTH="1139" HEIGHT="60" BASELINE="385 1634 1522 1630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="385 1634 385 1649 1520 1645 1522 1630 1518 1602 1284 1589 1282 1589 1279 1589 1234 1599 1197 1589 1195 1589 1193 1589 1191 1589 1188 1589 1171 1599 1119 1589 1117 1589 1026 1599 959 1589 957 1589 955 1589 952 1589 939 1602 918 1591 916 1591 913 1591 911 1591 874 1602 812 1591 809 1591 543 1602 513 1591 511 1591 508 1591 437 1602 407 1591 404 1591 402 1591 400 1591 398 1591 383 1599 385 1634"/>
                        </Shape>
                        <String CONTENT="though no conventional signs exist in either case."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-065_r4" HPOS="383" VPOS="1650" WIDTH="1778" HEIGHT="723" TAGREFS="TYPE_2">
