                <TextBlock ID="text_1-065" HPOS="357" VPOS="632" WIDTH="1778" HEIGHT="2624"><TextLine ID="mz_1-065_l1" HPOS="940" VPOS="632" WIDTH="622" HEIGHT="54" BASELINE="942 664 1562 669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1549 634 1527 634 1505 634 1484 634 1462 634 1440 634 1419 634 1397 634 1375 634 1354 634 1332 634 1310 634 1289 634 1267 634 1245 634 1224 634 1202 634 1180 634 1159 634 1137 634 1115 634 1094 634 1072 634 1050 634 1029 634 1007 634 986 634 964 634 942 634 942 664 940 682 1557 686 1562 669 1559 634 1549 632 1549 634"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l2" HPOS="2062" VPOS="651" WIDTH="60" HEIGHT="48" BASELINE="2066 684 2122 679" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2105 651 2084 651 2062 651 2066 684 2066 697 2120 699 2122 679 2116 651 2105 651"/>
                        </Shape>
                        <String CONTENT="43"/>
                    </TextLine>
<TextLine ID="mz_1-065_l3" HPOS="461" VPOS="731" WIDTH="1672" HEIGHT="65" BASELINE="464 781 2133 775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="464 781 464 796 2131 790 2133 775 2129 744 2064 731 2062 731 2060 731 2034 744 1793 744 1763 731 1761 731 1759 731 1756 731 1733 742 1676 731 1674 731 1616 742 1579 731 1577 731 1575 731 1572 731 1529 744 1464 734 1462 734 1460 734 1429 747 1252 747 1239 734 1237 734 1235 734 1094 734 1092 734 1038 744 1025 734 1022 734 1020 734 1018 734 914 747 862 736 860 736 786 747 477 736 474 736 472 736 470 736 470 738 461 744 464 781"/>
                        </Shape>
                        <String CONTENT="Kalêˊlɪ-taˊɪrg̣ɪn (“spotted taˊɪrg̣ɪn”) covers the skin with large spots of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l4" HPOS="357" VPOS="792" WIDTH="1776" HEIGHT="65" BASELINE="360 842 2133 833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="360 842 360 857 2131 848 2133 833 2129 803 1752 792 1750 792 1653 803 1245 794 1243 794 1241 794 1211 807 357 807 360 842"/>
                        </Shape>
                        <String CONTENT="light, ashen color, often over the whole body, including the face and the hair"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l5" HPOS="360" VPOS="857" WIDTH="1773" HEIGHT="58" BASELINE="362 900 2133 896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 900 362 913 2129 915 2133 896 2129 866 401 857 399 857 396 857 360 868 362 900"/>
                        </Shape>
                        <String CONTENT="of the head. It does not seem to affect the health. A man named Tuˊrkew,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l6" HPOS="362" VPOS="911" WIDTH="1771" HEIGHT="65" BASELINE="364 959 2133 954" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 959 364 976 2131 972 2133 954 2129 920 1557 911 1555 911 1553 911 1529 924 1358 924 1332 911 1330 911 1328 911 1326 911 1323 911 1306 922 1282 911 1280 911 1278 911 1276 911 1243 924 1217 913 1215 913 1213 913 1211 913 1187 926 992 926 955 913 953 913 951 913 949 913 910 924 856 913 853 913 851 913 804 924 730 913 728 913 659 924 613 913 611 913 609 913 607 913 581 926 435 926 409 913 407 913 405 913 403 913 362 926 364 959"/>
                        </Shape>
                        <String CONTENT="who was affected by this disease, received the name of Keliˊlɪ-Tuˊrkew (“Spotted"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l7" HPOS="364" VPOS="980" WIDTH="1769" HEIGHT="55" BASELINE="366 1019 2133 1013" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 1019 366 1035 2131 1028 2133 1013 2127 980 364 980 366 1019"/>
                        </Shape>
                        <String CONTENT="Tuˊrkew”). He was well known in the Anui country on account of his piebald"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l8" HPOS="364" VPOS="1032" WIDTH="1622" HEIGHT="61" BASELINE="364 1073 1986 1078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1073 364 1093 1984 1093 1986 1078 1986 1048 1954 1035 1951 1035 1949 1035 1837 1045 1750 1035 1748 1035 1746 1035 1711 1045 1676 1035 1674 1035 1672 1035 1614 1045 1570 1035 1568 1035 1566 1035 1564 1035 1533 1045 1468 1035 1466 1035 1464 1035 1421 1045 1328 1035 1326 1035 1176 1045 1126 1032 1124 1032 1122 1032 1120 1032 1094 1043 914 1032 912 1032 804 1043 364 1039 364 1073"/>
                        </Shape>
                        <String CONTENT="hair. At the age of fifty years he was still active for his time of life."/>
                    </TextLine>
<TextLine ID="mz_1-065_l9" HPOS="466" VPOS="1106" WIDTH="1669" HEIGHT="48" BASELINE="468 1138 2135 1134" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="468 1138 468 1154 2133 1149 2135 1134 2131 1106 466 1106 468 1138"/>
                        </Shape>
                        <String CONTENT="I came across five deaf-mutes. Three of them were full-grown, and took"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l10" HPOS="360" VPOS="1151" WIDTH="1773" HEIGHT="70" BASELINE="362 1199 2133 1193" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1199 362 1221 2131 1208 2133 1193 2129 1164 1744 1151 1741 1151 1739 1151 1715 1162 1087 1154 1085 1154 1031 1164 983 1154 981 1154 979 1154 864 1167 585 1156 583 1156 533 1167 494 1156 492 1156 490 1156 487 1156 485 1156 472 1167 448 1158 446 1158 444 1158 360 1169 362 1199"/>
                        </Shape>
                        <String CONTENT="part in all the daily pursuits of their camp. They communicated with other"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l11" HPOS="362" VPOS="1216" WIDTH="1769" HEIGHT="63" BASELINE="364 1260 2131 1253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1260 364 1279 2129 1277 2131 1253 2127 1225 996 1216 994 1216 362 1229 364 1260"/>
                        </Shape>
                        <String CONTENT="people by means of simple signs. Sleep, for instance, was expressed by leaning"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l12" HPOS="362" VPOS="1277" WIDTH="1771" HEIGHT="58" BASELINE="364 1318 2133 1312" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1318 364 1335 2131 1329 2133 1312 2129 1284 383 1277 381 1277 379 1277 377 1277 362 1284 364 1318"/>
                        </Shape>
                        <String CONTENT="the face on the palm; eating and drinking, by representative motions of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l13" HPOS="362" VPOS="1335" WIDTH="1773" HEIGHT="61" BASELINE="364 1379 2135 1372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1379 364 1396 2133 1390 2135 1372 2129 1335 362 1342 364 1379"/>
                        </Shape>
                        <String CONTENT="hand to the mouth; woman, by forming an imaginary braid on each side of"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l14" HPOS="360" VPOS="1405" WIDTH="1773" HEIGHT="50" BASELINE="362 1437 2133 1433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1437 362 1455 2131 1450 2133 1433 2127 1405 360 1407 362 1437"/>
                        </Shape>
                        <String CONTENT="the face; man, by pointing out the mustache; going, by a motion of two"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l15" HPOS="360" VPOS="1452" WIDTH="1773" HEIGHT="63" BASELINE="362 1500 2133 1494" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1500 362 1515 2131 1509 2133 1494 2131 1465 2094 1452 2092 1452 2090 1452 2088 1452 2064 1463 2040 1452 2038 1452 2036 1452 1867 1463 1793 1452 1791 1452 1624 1463 1598 1452 1596 1452 1594 1452 1510 1465 1451 1455 1449 1455 1248 1465 1152 1455 1150 1455 1148 1455 1115 1465 988 1455 986 1455 983 1455 947 1468 377 1457 375 1457 373 1457 370 1457 360 1463 362 1500"/>
                        </Shape>
                        <String CONTENT="fingers on the palm; etc. These signs are similar to those used by the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l16" HPOS="362" VPOS="1528" WIDTH="1771" HEIGHT="48" BASELINE="362 1556 2133 1556" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1556 362 1571 2131 1576 2133 1556 2133 1528 362 1528 362 1556"/>
                        </Shape>
                        <String CONTENT="chee for communicating with people who do not understand their language,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l17" HPOS="362" VPOS="1574" WIDTH="1139" HEIGHT="60" BASELINE="364 1619 1501 1615" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1619 364 1634 1499 1630 1501 1615 1497 1587 1263 1574 1261 1574 1258 1574 1213 1584 1176 1574 1174 1574 1172 1574 1170 1574 1167 1574 1150 1584 1098 1574 1096 1574 1005 1584 938 1574 936 1574 934 1574 931 1574 918 1587 897 1576 895 1576 892 1576 890 1576 853 1587 791 1576 788 1576 522 1587 492 1576 490 1576 487 1576 416 1587 386 1576 383 1576 381 1576 379 1576 377 1576 362 1584 364 1619"/>
                        </Shape>
                        <String CONTENT="though no conventional signs exist in either case."/>
                    </TextLine>
<TextLine ID="mz_1-065_l18" HPOS="470" VPOS="1641" WIDTH="1665" HEIGHT="58" BASELINE="472 1680 2135 1673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 1680 472 1695 2114 1699 2116 1699 2118 1699 2120 1699 2135 1688 2135 1673 2129 1641 470 1645 472 1680"/>
                        </Shape>
                        <String CONTENT="I met two dwarfs. One of them was married, and had three well-developed"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l19" HPOS="360" VPOS="1691" WIDTH="1773" HEIGHT="64" BASELINE="362 1740 2133 1732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1740 362 1755 2131 1747 2133 1732 2131 1701 2114 1691 2112 1691 2109 1691 2107 1691 2105 1691 2084 1701 2038 1691 2036 1691 2034 1691 2032 1691 2029 1691 2014 1704 1787 1704 1713 1691 1711 1691 1709 1691 1683 1704 1598 1693 1596 1693 1594 1693 1557 1704 1274 1693 1271 1693 1183 1706 1016 1695 1014 1695 769 1708 390 1697 388 1697 386 1697 360 1708 362 1740"/>
                        </Shape>
                        <String CONTENT="children. There were several weak-minded people. One of them was a deaf-"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l20" HPOS="362" VPOS="1758" WIDTH="1771" HEIGHT="58" BASELINE="364 1801 2133 1792" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1801 364 1816 2131 1807 2133 1792 2129 1764 806 1758 804 1758 362 1771 364 1801"/>
                        </Shape>
                        <String CONTENT="mute; another had been struck with the palsy, and could not walk or move"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l21" HPOS="362" VPOS="1820" WIDTH="1771" HEIGHT="55" BASELINE="364 1859 2133 1853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1859 364 1875 2131 1868 2133 1853 2127 1820 362 1823 364 1859"/>
                        </Shape>
                        <String CONTENT="his left hand. But the Chukchee had no notion of supernatural power possessed"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l22" HPOS="362" VPOS="1872" WIDTH="1771" HEIGHT="63" BASELINE="364 1918 2133 1914" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1918 364 1935 2131 1931 2133 1914 2129 1883 1248 1872 1245 1872 1243 1872 1241 1872 1226 1885 362 1885 364 1918"/>
                        </Shape>
                        <String CONTENT="by such people, as is held by the American Eskimo. Cases of violent madness"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l23" HPOS="362" VPOS="1937" WIDTH="1771" HEIGHT="54" BASELINE="364 1978 2133 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1978 364 1991 2131 1987 2133 1972 2129 1939 392 1937 390 1937 388 1937 362 1946 364 1978"/>
                        </Shape>
                        <String CONTENT="also occur. I was told by a woman shaman that she was out of her mind"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l24" HPOS="362" VPOS="1996" WIDTH="1771" HEIGHT="56" BASELINE="362 2037 2133 2037" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2037 362 2052 2133 2052 2133 2037 2133 2009 1728 1996 1726 1996 1640 2007 1581 1996 1579 1996 1577 1996 1575 1996 1559 2007 1486 1996 1484 1996 1388 2007 1334 1996 1332 1996 1200 2007 1154 1996 1152 1996 1150 1996 1031 2007 999 1996 996 1996 994 1996 992 1996 966 2009 821 2009 773 1996 771 1996 769 1996 767 1996 765 1996 749 2009 552 2009 481 1996 479 1996 477 1996 435 2007 381 1996 379 1996 377 1996 375 1996 362 2004 362 2037"/>
                        </Shape>
                        <String CONTENT="for three years, because of a spell wrought on her by a rival. When in a"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l25" HPOS="362" VPOS="2054" WIDTH="1769" HEIGHT="61" BASELINE="364 2098 2131 2091" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2098 364 2115 2129 2108 2131 2091 2127 2063 953 2054 951 2054 879 2065 375 2056 373 2056 370 2056 368 2056 368 2059 362 2063 364 2098"/>
                        </Shape>
                        <String CONTENT="fit, she would lose all feeling in her wrists, and sometimes in her whole body."/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l26" HPOS="362" VPOS="2115" WIDTH="1771" HEIGHT="58" BASELINE="364 2156 2133 2152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2156 364 2173 2131 2169 2133 2152 2129 2124 388 2115 386 2115 383 2115 362 2124 364 2156"/>
                        </Shape>
                        <String CONTENT="At such times she would snatch a stone and pound her fingers with it, without"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l27" HPOS="360" VPOS="2175" WIDTH="1771" HEIGHT="59" BASELINE="362 2219 2131 2214" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2219 362 2234 2129 2230 2131 2214 2127 2184 377 2175 375 2175 373 2175 370 2175 360 2182 362 2219"/>
                        </Shape>
                        <String CONTENT="feeling any pain. In fact, the upper joints of two of her fingers were missing."/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l28" HPOS="357" VPOS="2240" WIDTH="1774" HEIGHT="55" BASELINE="360 2277 2131 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="360 2277 360 2295 2129 2288 2131 2271 2125 2240 357 2243 360 2277"/>
                        </Shape>
                        <String CONTENT="Frequently she would want to harm other people, and then her housemates"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l29" HPOS="362" VPOS="2292" WIDTH="1399" HEIGHT="61" BASELINE="364 2338 1761 2334" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2338 364 2353 1759 2349 1761 2334 1756 2305 1683 2292 1681 2292 1679 2292 1676 2292 1657 2305 1523 2305 1499 2292 1497 2292 1494 2292 1442 2303 1425 2292 1423 2292 1421 2292 1419 2292 1416 2292 1414 2292 1397 2303 1371 2292 1369 2292 1367 2292 1365 2292 1336 2305 1098 2305 1072 2292 1070 2292 1068 2292 1066 2292 1063 2292 1063 2295 1061 2295 1055 2303 1046 2295 1044 2295 1042 2295 1040 2295 1038 2295 1016 2305 994 2295 992 2295 990 2295 745 2305 697 2295 695 2295 693 2295 630 2305 602 2295 600 2295 598 2295 596 2295 574 2305 539 2295 537 2295 535 2295 533 2295 509 2305 457 2295 455 2295 362 2308 364 2338"/>
                        </Shape>
                        <String CONTENT="would tie her hands and bind her to one of the house-poles."/>
                    </TextLine>
<TextLine ID="mz_1-065_l30" HPOS="468" VPOS="2364" WIDTH="1665" HEIGHT="50" BASELINE="470 2398 2133 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="470 2398 470 2414 2131 2411 2133 2394 2129 2364 468 2364 470 2398"/>
                        </Shape>
                        <String CONTENT="In another case I heard that a man of the Reindeer division of the tribe,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l31" HPOS="360" VPOS="2411" WIDTH="1773" HEIGHT="63" BASELINE="362 2459 2133 2453" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2459 362 2474 2131 2468 2133 2453 2129 2422 1564 2411 1562 2411 1559 2411 1536 2422 403 2416 401 2416 399 2416 360 2427 362 2459"/>
                        </Shape>
                        <String CONTENT="who for a long time was afflicted with similar fits, kept making attempts to"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l32" HPOS="360" VPOS="2472" WIDTH="1771" HEIGHT="63" BASELINE="362 2520 2131 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2520 362 2535 2129 2528 2131 2513 2127 2483 1650 2472 1648 2472 1533 2483 1070 2474 1068 2474 360 2485 362 2520"/>
                        </Shape>
                        <String CONTENT="injure his camp-companions, and ultimately was put out of the way by common"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l33" HPOS="364" VPOS="2548" WIDTH="193" HEIGHT="47" BASELINE="364 2576 557 2576" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2576 364 2595 557 2595 557 2576 557 2548 364 2548 364 2576"/>
                        </Shape>
                        <String CONTENT="consent."/>
                    </TextLine>
<TextLine ID="mz_1-065_l34" HPOS="470" VPOS="2602" WIDTH="1663" HEIGHT="52" BASELINE="472 2637 2133 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 2637 472 2654 2131 2647 2133 2630 2129 2602 470 2602 472 2637"/>
                        </Shape>
                        <String CONTENT="Blindness occurs often, especially among old people. The young herdsmen"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l35" HPOS="360" VPOS="2665" WIDTH="1775" HEIGHT="54" BASELINE="362 2697 2135 2693" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2697 362 2710 2112 2719 2114 2719 2116 2719 2118 2719 2135 2708 2135 2693 2129 2665 360 2667 362 2697"/>
                        </Shape>
                        <String CONTENT="often have sore eyes on account of loss of sleep in the seasons when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l36" HPOS="360" VPOS="2712" WIDTH="1773" HEIGHT="63" BASELINE="362 2758 2133 2751" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2758 362 2775 2131 2769 2133 2751 2129 2723 1542 2712 1540 2712 1538 2712 1497 2725 360 2725 362 2758"/>
                        </Shape>
                        <String CONTENT="herding of the reindeer requires extra exertion, and because of the corrosive"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l37" HPOS="360" VPOS="2775" WIDTH="1773" HEIGHT="65" BASELINE="362 2818 2133 2812" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2818 362 2834 1540 2840 1542 2840 1607 2829 2131 2829 2133 2812 2129 2784 953 2775 951 2775 871 2786 422 2777 420 2777 360 2788 362 2818"/>
                        </Shape>
                        <String CONTENT="action of sweat mixed with dirt. Snow-blindness in the spring is very common"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l38" HPOS="357" VPOS="2834" WIDTH="1774" HEIGHT="60" BASELINE="360 2877 2131 2873" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="360 2877 360 2892 2127 2894 2131 2873 2127 2844 1263 2834 1261 2834 1258 2834 1256 2834 1237 2844 572 2836 570 2836 357 2847 360 2877"/>
                        </Shape>
                        <String CONTENT="among all who make journeys across the tundra. In treating inflamed eyes,"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l39" HPOS="362" VPOS="2905" WIDTH="1771" HEIGHT="48" BASELINE="362 2935 2133 2935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2935 362 2953 2133 2953 2133 2935 2133 2905 362 2905 362 2935"/>
                        </Shape>
                        <String CONTENT="the lids are sometimes turned outward and bled by being rubbed with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-065_l40" HPOS="360" VPOS="2948" WIDTH="1771" HEIGHT="68" BASELINE="362 2998 2131 2990" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2998 362 3016 2129 3007 2131 2990 2129 2961 2103 2948 2101 2948 2099 2948 2097 2948 2073 2959 1938 2948 1936 2948 1873 2959 1821 2948 1819 2948 1817 2948 1815 2948 1800 2961 1709 2961 1694 2948 1692 2948 1689 2948 1687 2948 1594 2961 1553 2951 1551 2951 1549 2951 1546 2951 1520 2964 360 2964 362 2998"/>
                        </Shape>
                        <String CONTENT="large hard larva of the reindeer-fly, the segments of which act like the teeth"/>
                    </TextLine>

