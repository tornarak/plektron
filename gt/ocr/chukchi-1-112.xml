                        </Shape>
                        <String CONTENT="The Chukchee are supplied with meat and skins from their herds. No"/>
                    </TextLine>

                    <TextLine ID="mz_1-112_l9" HPOS="571" VPOS="1095" WIDTH="1778" HEIGHT="61" BASELINE="573 1143 2349 1138" TAGREFS="TYPE_4">
