                        <Shape>
                            <Polygon POINTS="576 1619 576 1634 2341 1636 2345 1615 2341 1586 664 1578 662 1578 573 1589 576 1619"/>
                        </Shape>
                        <String CONTENT="would be starved. When the herdsman is very hungry, he may also chop"/>
