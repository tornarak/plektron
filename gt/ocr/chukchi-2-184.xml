                        </Shape>
                        <String CONTENT="The human husband of Tiluˊwg̣i was an undersized fellow, shorter than"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l6" HPOS="330" VPOS="724" WIDTH="1767" HEIGHT="65" BASELINE="332 765 2097 771" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 765 330 777 2093 789 2097 771 2095 740 1729 728 1727 728 1725 728 1694 738 1660 728 1658 728 1656 728 1596 738 1560 728 1558 728 1557 728 1555 728 1553 728 1539 738 1510 726 1508 726 1506 726 1437 736 1180 726 1179 726 1126 736 1100 726 1098 726 1096 726 1039 736 1016 726 1014 726 1012 726 957 736 918 724 916 724 914 724 912 724 885 734 865 724 863 724 861 724 859 724 836 734 744 724 742 724 740 724 712 736 613 736 597 724 595 724 593 724 591 724 332 730 332 765"/>
                        </Shape>
                        <String CONTENT="his “wife” by at least half a head. He was nevertheless healthy and strong,"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l7" HPOS="330" VPOS="787" WIDTH="1767" HEIGHT="57" BASELINE="332 830 2097 824" TAGREFS="TYPE_5">
