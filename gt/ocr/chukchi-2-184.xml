                        </Shape>
                        <String CONTENT="a good wrestler and runner, and altogether a normal, well-balanced person."/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l8" HPOS="332" VPOS="846" WIDTH="1767" HEIGHT="66" BASELINE="334 891 2099 887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="334 891 334 902 916 902 1004 912 1006 912 1008 912 1010 912 1026 902 1133 912 1135 912 1294 910 1296 910 1298 910 1314 900 1882 910 1884 910 2097 898 2099 887 2095 857 1989 846 1987 846 1985 846 1950 857 1750 857 1735 846 1733 846 1731 846 1729 846 1727 846 1700 855 1672 846 1670 846 1668 846 1666 846 1641 855 1549 846 1547 846 1545 846 1504 855 1359 846 1357 846 1182 859 1012 859 996 847 994 847 992 847 991 847 332 853 334 891"/>
                        </Shape>
                        <String CONTENT="He was a cousin of Tiluˊwg̣i, as generally the transformed shamans prefer to"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l9" HPOS="330" VPOS="906" WIDTH="1223" HEIGHT="61" BASELINE="332 943 1553 947" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 943 330 957 344 967 346 967 348 967 350 967 1551 959 1553 947 1551 920 1470 908 1468 908 1355 918 1325 908 1323 908 1322 908 1208 918 1137 908 1135 908 1133 908 1102 918 1092 910 1092 908 1090 908 1088 908 1086 908 1085 908 1049 918 820 918 789 906 787 906 785 906 783 906 754 916 740 906 738 906 736 906 734 906 681 916 648 906 646 906 644 906 642 906 613 916 575 906 573 906 571 906 569 906 546 918 391 918 379 906 377 906 376 906 374 906 332 914 332 943"/>
                        </Shape>
                        <String CONTENT="choose a husband from among their nearest relatives."/>
                    </TextLine>
<TextLine ID="mz_2-184_l10" HPOS="442" VPOS="971" WIDTH="1659" HEIGHT="64" BASELINE="444 1008 2101 1004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 1008 444 1035 542 1020 836 1020 861 1030 863 1030 865 1030 1188 1020 1255 1030 1257 1030 1259 1030 1261 1030 1275 1018 1357 1028 1359 1028 1361 1028 1400 1018 1592 1032 1594 1032 1596 1032 1621 1018 1645 1028 1647 1028 1649 1028 1705 1018 1721 1030 1723 1030 1725 1030 1846 1032 1848 1032 1850 1032 1882 1020 2056 1030 2058 1030 2099 1020 2101 1004 2097 971 442 971 444 1008"/>
                        </Shape>
                        <String CONTENT="The division of labor between the two followed, of course, the usual"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l11" HPOS="332" VPOS="1028" WIDTH="1767" HEIGHT="54" BASELINE="332 1069 2099 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1069 332 1082 2099 1082 2099 1069 2099 1037 2070 1028 2068 1028 2066 1028 1976 1037 889 1028 887 1028 824 1037 785 1028 783 1028 781 1028 656 1037 605 1028 603 1028 601 1028 562 1037 522 1028 520 1028 519 1028 423 1037 387 1028 385 1028 383 1028 332 1037 332 1069"/>
                        </Shape>
                        <String CONTENT="rules. In the evening, Yaˊtirg̣ɪn would sit idly within the inner room, while"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l12" HPOS="334" VPOS="1082" WIDTH="1763" HEIGHT="61" BASELINE="336 1128 2097 1124" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 1128 336 1143 2095 1143 2097 1124 2095 1096 2060 1082 2058 1082 2056 1082 2054 1082 2052 1082 2034 1094 1999 1082 1997 1082 1995 1082 1993 1082 1952 1092 1907 1082 1905 1082 1903 1082 1901 1082 1882 1096 1647 1096 1629 1082 1627 1082 1625 1082 1623 1082 1621 1082 1594 1094 1564 1082 1562 1082 1560 1082 1558 1082 1513 1096 1459 1096 1441 1082 1439 1082 1437 1082 1435 1082 1433 1082 1394 1094 1325 1082 1323 1082 1322 1082 1273 1094 1247 1082 1245 1082 1243 1082 1241 1082 1212 1096 1175 1084 1173 1084 1171 1084 1100 1096 1038 1084 1036 1084 953 1096 883 1084 881 1084 879 1084 828 1096 767 1084 765 1084 708 1094 695 1084 693 1084 691 1084 689 1084 609 1094 569 1084 567 1084 566 1084 564 1084 538 1094 522 1084 520 1084 519 1084 517 1084 515 1084 483 1094 450 1084 448 1084 446 1084 334 1090 336 1128"/>
                        </Shape>
                        <String CONTENT="Tiluˊwg̣i busied himself outside with the hearth and the supper. Yaˊtirg̣ɪn,"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l13" HPOS="329" VPOS="1155" WIDTH="1770" HEIGHT="47" BASELINE="330 1190 2099 1186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 1190 330 1202 2097 1198 2099 1186 2093 1155 329 1157 330 1190"/>
                        </Shape>
                        <String CONTENT="received the best pieces of meat, and the transformed “wife,” according to"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l14" HPOS="332" VPOS="1220" WIDTH="1767" HEIGHT="43" BASELINE="332 1245 2099 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1245 332 1263 2099 1263 2099 1245 2099 1220 332 1220 332 1245"/>
                        </Shape>
                        <String CONTENT="custom, had to be content with scraps and bones. In the more serious affairs"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l15" HPOS="332" VPOS="1267" WIDTH="1281" HEIGHT="54" BASELINE="332 1308 1613 1308" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1308 332 1321 1611 1321 1613 1308 1611 1280 1527 1280 1502 1267 1500 1267 1498 1267 1496 1267 1449 1278 1423 1267 1421 1267 1419 1267 1417 1267 1392 1280 1206 1280 1179 1267 1177 1267 1175 1267 1173 1267 1171 1267 1171 1269 1159 1280 1049 1280 1036 1267 1034 1267 1032 1267 912 1267 910 1267 908 1267 873 1278 824 1267 822 1267 820 1267 818 1267 816 1267 802 1278 775 1267 773 1267 771 1267 714 1278 658 1267 656 1267 581 1278 530 1267 528 1267 526 1267 524 1267 477 1278 464 1267 462 1267 460 1267 372 1267 370 1267 368 1267 332 1278 332 1308"/>
                        </Shape>
                        <String CONTENT="of life, the voice of the “wife” was, however, dominant."/>
                    </TextLine>
<TextLine ID="mz_2-184_l16" HPOS="438" VPOS="1323" WIDTH="1661" HEIGHT="59" BASELINE="440 1368 2099 1363" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="440 1368 440 1382 2097 1380 2099 1363 2095 1337 2042 1337 2025 1323 2023 1323 2021 1323 2019 1323 2017 1323 1991 1337 1899 1337 1872 1323 1870 1323 1868 1323 1866 1323 1842 1335 1684 1335 1668 1323 1666 1323 1664 1323 1662 1323 1660 1323 1627 1337 1488 1339 1417 1339 1392 1325 1390 1325 1388 1325 1314 1337 1161 1325 1159 1325 1030 1337 918 1327 916 1327 914 1327 912 1327 897 1339 802 1327 801 1327 799 1327 759 1339 703 1327 701 1327 699 1327 654 1339 630 1327 628 1327 626 1327 438 1331 440 1368"/>
                        </Shape>
                        <String CONTENT="I heard also from their neighbors a curious story, that one time, when"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l17" HPOS="334" VPOS="1386" WIDTH="1765" HEIGHT="65" BASELINE="336 1423 2099 1427" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 1423 334 1435 450 1449 452 1449 542 1439 720 1449 722 1449 812 1439 1075 1449 1077 1449 1739 1441 1754 1451 1756 1451 1758 1451 1760 1451 2097 1439 2099 1427 2097 1398 336 1386 336 1423"/>
                        </Shape>
                        <String CONTENT="Yaˊtirg̣ɪn was angry at something and wanted to chastise his giant wife, the"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l18" HPOS="330" VPOS="1445" WIDTH="1771" HEIGHT="57" BASELINE="332 1488 2101 1484" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1488 332 1502 2099 1498 2101 1484 2097 1457 1950 1457 1935 1445 1933 1445 1931 1445 1929 1445 1927 1445 1901 1455 1882 1445 1880 1445 1878 1445 1876 1445 1852 1455 1792 1445 1790 1445 1788 1445 1766 1455 1711 1445 1709 1445 1656 1457 1543 1457 1527 1445 1525 1445 1523 1445 1521 1445 1519 1445 1488 1455 1429 1445 1427 1445 1425 1445 1394 1455 1361 1445 1359 1445 1357 1445 1265 1455 1157 1447 1155 1447 1153 1447 1130 1458 922 1458 889 1447 887 1447 885 1447 822 1457 330 1453 332 1488"/>
                        </Shape>
                        <String CONTENT="latter suddenly gave him so powerful a kick that it sent him head foremost"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l19" HPOS="332" VPOS="1505" WIDTH="1765" HEIGHT="57" BASELINE="332 1549 2097 1549" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1549 332 1560 2095 1562 2097 1549 2097 1509 1889 1505 1888 1505 1886 1505 1837 1517 1792 1505 1790 1505 1788 1505 1664 1515 1633 1505 1631 1505 1629 1505 1627 1505 1598 1517 1555 1505 1553 1505 1551 1505 1549 1505 1515 1517 1447 1505 1445 1505 1443 1505 1441 1505 1421 1519 1243 1519 1222 1505 1220 1505 1218 1505 1149 1505 1147 1505 1145 1505 1143 1505 1124 1519 928 1519 893 1505 891 1505 889 1505 887 1505 840 1517 804 1505 802 1505 801 1505 799 1505 797 1505 777 1519 567 1519 475 1505 473 1505 472 1505 470 1505 452 1519 399 1519 352 1505 350 1505 348 1505 346 1505 344 1505 332 1513 332 1549"/>
                        </Shape>
                        <String CONTENT="from their common sleeping-room. This proves that the femininity of Tiluˊwg̣i"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l20" HPOS="334" VPOS="1578" WIDTH="682" HEIGHT="43" BASELINE="334 1605 1016 1605" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="334 1605 334 1621 1016 1621 1016 1605 1016 1578 334 1578 334 1605"/>
                        </Shape>
                        <String CONTENT="was more apparent than real."/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l21" HPOS="442" VPOS="1623" WIDTH="1659" HEIGHT="72" BASELINE="444 1668 2101 1664" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 1668 444 1695 542 1680 1088 1680 1120 1693 1122 1693 1124 1693 1126 1693 1179 1680 1249 1693 1251 1693 1339 1678 1527 1678 1592 1692 1594 1692 1596 1692 1635 1678 1721 1692 1723 1692 2099 1678 2101 1664 2097 1637 1987 1623 1985 1623 1983 1623 1944 1635 1882 1623 1880 1623 1878 1623 1844 1637 1747 1637 1729 1623 1727 1623 1725 1623 1723 1623 1721 1623 1696 1637 1506 1637 1486 1623 1484 1623 1482 1623 1480 1623 1255 1637 1216 1625 1214 1625 1212 1625 1112 1635 1086 1625 1085 1625 1083 1625 1081 1625 1079 1625 1065 1635 991 1625 989 1625 987 1625 985 1625 969 1637 930 1625 928 1625 926 1625 924 1625 895 1637 828 1625 826 1625 771 1635 701 1625 699 1625 697 1625 654 1635 442 1631 444 1668"/>
                        </Shape>
                        <String CONTENT="The transformation in Tiluˊwg̣i began in his very early youth, after a"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l22" HPOS="329" VPOS="1684" WIDTH="1768" HEIGHT="64" BASELINE="330 1729 2097 1725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 1729 330 1748 2095 1740 2097 1725 2093 1695 1991 1684 1989 1684 1987 1684 1962 1693 1839 1684 1837 1684 1835 1684 1833 1684 1817 1695 1596 1695 1568 1684 1566 1684 1564 1684 1504 1693 1400 1684 1398 1684 1351 1693 1278 1684 1276 1684 1275 1684 1273 1684 1259 1693 1229 1684 1227 1684 1226 1684 1224 1684 1194 1695 1163 1686 1161 1686 1159 1686 1157 1686 1126 1695 926 1686 924 1686 810 1695 763 1686 761 1686 658 1695 542 1686 540 1686 329 1697 330 1729"/>
                        </Shape>
                        <String CONTENT="protracted illness from which he freed himself by the song and the drum."/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l23" HPOS="332" VPOS="1746" WIDTH="1765" HEIGHT="61" BASELINE="332 1787 2097 1787" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1787 332 1799 2095 1807 2097 1787 2097 1758 1936 1746 1935 1746 1933 1746 1899 1756 1848 1746 1846 1746 1774 1758 1649 1758 1633 1746 1631 1746 1629 1746 1627 1746 1531 1756 1517 1746 1515 1746 1513 1746 1511 1746 1404 1758 1075 1758 1053 1746 1051 1746 1049 1746 1047 1746 1018 1756 920 1746 918 1746 916 1746 879 1756 840 1746 838 1746 836 1746 722 1756 646 1746 644 1746 642 1746 613 1756 332 1754 332 1787"/>
                        </Shape>
                        <String CONTENT="He gave a shamanistic séance in my presence, which had no peculiar features,"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l24" HPOS="330" VPOS="1805" WIDTH="1769" HEIGHT="63" BASELINE="330 1846 2099 1846" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 1846 330 1860 2095 1868 2099 1846 2097 1817 2038 1805 2036 1805 1925 1815 1799 1805 1797 1805 1709 1815 1682 1805 1680 1805 1678 1805 1594 1815 1566 1805 1564 1805 1562 1805 1560 1805 1527 1815 1486 1805 1484 1805 1482 1805 1480 1805 1441 1815 1414 1805 1412 1805 1410 1805 1343 1815 1316 1805 1314 1805 1312 1805 1310 1805 1308 1805 1292 1817 1081 1817 1034 1805 1032 1805 1030 1805 998 1815 971 1805 969 1805 967 1805 965 1805 924 1815 877 1805 875 1805 873 1805 844 1815 746 1805 744 1805 742 1805 720 1815 695 1805 693 1805 691 1805 689 1805 652 1815 620 1805 618 1805 616 1805 550 1815 517 1805 515 1805 513 1805 511 1805 509 1805 491 1817 330 1817 330 1846"/>
                        </Shape>
                        <String CONTENT="except that the keˊlᴇ-husband often appeared and talked to the public, extolling"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l25" HPOS="330" VPOS="1864" WIDTH="1769" HEIGHT="57" BASELINE="332 1907 2099 1903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1907 332 1921 2097 1917 2099 1903 2095 1876 1982 1864 1980 1864 1656 1874 1480 1864 1478 1864 1427 1874 1414 1864 1412 1864 1410 1864 1233 1864 1231 1864 1229 1864 1227 1864 1210 1876 1139 1866 1137 1866 1135 1866 1098 1876 1077 1866 1075 1866 1073 1866 1071 1866 1034 1876 996 1866 994 1866 992 1866 824 1876 773 1866 771 1866 724 1876 677 1866 675 1866 601 1876 456 1866 454 1866 407 1876 350 1866 348 1866 346 1866 344 1866 330 1874 332 1907"/>
                        </Shape>
                        <String CONTENT="the shaman. In the very beginning, Tiluˊwg̣i called him and asked him to"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l26" HPOS="332" VPOS="1927" WIDTH="1767" HEIGHT="52" BASELINE="332 1966 2099 1966" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1966 332 1979 2099 1979 2099 1966 2099 1936 2076 1927 2074 1927 2072 1927 1995 1936 1964 1927 1962 1927 1960 1927 1907 1936 1882 1927 1880 1927 1878 1927 1876 1927 1846 1936 1351 1927 1349 1927 1347 1927 1322 1936 1239 1927 1237 1927 1055 1936 1006 1927 1004 1927 1002 1927 1000 1927 985 1938 883 1938 789 1927 787 1927 703 1936 609 1927 607 1927 556 1936 505 1927 503 1927 501 1927 477 1936 442 1927 440 1927 438 1927 332 1936 332 1966"/>
                        </Shape>
                        <String CONTENT="mend the drum, which, as he pretended, had not the proper ring.¹ We"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l27" HPOS="329" VPOS="1983" WIDTH="1768" HEIGHT="63" BASELINE="330 2026 2097 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 2026 330 2040 2093 2046 2097 2022 2093 1995 1991 1983 1989 1983 1987 1983 1962 1993 1899 1983 1897 1983 1895 1983 1870 1993 1856 1983 1854 1983 1852 1983 1850 1983 1848 1983 1813 1995 1619 1995 1604 1983 1602 1983 1600 1983 1598 1983 1596 1983 1568 1995 1363 1995 1347 1983 1345 1983 1343 1983 1341 1983 1190 1995 1137 1985 1135 1985 1055 1995 967 1985 965 1985 904 1995 891 1985 889 1985 887 1985 885 1985 883 1985 855 1995 797 1985 795 1985 329 1991 330 2026"/>
                        </Shape>
                        <String CONTENT="heard the keˊlᴇ-husband blow with great force over the cover of the drum,"/>
                    </TextLine>

                    <TextLine ID="mz_2-184_l28" HPOS="330" VPOS="2054" WIDTH="921" HEIGHT="53" BASELINE="332 2083 1251 2087" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 2083 330 2099 340 2107 342 2107 344 2107 346 2107 1249 2099 1251 2087 1249 2058 332 2054 332 2083"/>
                        </Shape>
                        <String CONTENT="after which its sound at once improved."/>
                    </TextLine>
