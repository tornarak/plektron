                        </Shape>
                        <String CONTENT="III. — TRADE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-075_r2" HPOS="394" VPOS="1016" WIDTH="1778" HEIGHT="542" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="394 1016 2172 1016 2172 1558 394 1558"/>
