                        </Shape>
                        <String CONTENT="and allowed it to escape to the shore. Afterwards, in the fishing-season, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l11" HPOS="360" VPOS="1190" WIDTH="1767" HEIGHT="59" BASELINE="362 1234 2127 1227" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1234 362 1249 2125 1247 2127 1227 2122 1199 949 1190 947 1190 944 1190 918 1201 377 1193 375 1193 373 1193 370 1193 360 1199 362 1234"/>
                        </Shape>
                        <String CONTENT="took out the eyes of a live salmon, and in the same manner let it go free."/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l12" HPOS="362" VPOS="1258" WIDTH="1771" HEIGHT="51" BASELINE="362 1292 2133 1292" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1292 362 1309 2133 1309 2133 1292 2133 1262 362 1258 362 1292"/>
                        </Shape>
                        <String CONTENT="The next year, in hunting-time, the flayed reindeer was seen on the herd’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l13" HPOS="357" VPOS="1312" WIDTH="1776" HEIGHT="56" BASELINE="360 1353 2133 1348" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="360 1353 360 1368 2131 1364 2133 1348 2129 1318 425 1312 422 1312 357 1322 360 1353"/>
                        </Shape>
                        <String CONTENT="trail, causing the herds to turn away from the river. Likewise the injured"/>
                    </TextLine>

