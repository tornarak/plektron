                        </Shape>
                        <String CONTENT="the hunters on the banks of the Kolyma within the forest border assert that"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l27" HPOS="374" VPOS="2167" WIDTH="1778" HEIGHT="56" BASELINE="376 2208 2152 2201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2208 376 2223 2150 2216 2152 2201 2148 2173 394 2167 391 2167 389 2167 387 2167 374 2173 376 2208"/>
                        </Shape>
                        <String CONTENT="the “resident” reindeer even increased in number, perhaps after their retreat"/>
                    </TextLine>

