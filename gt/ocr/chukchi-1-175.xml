                    </TextLine>

                    <TextLine ID="mz_1-175_l27" HPOS="353" VPOS="2152" WIDTH="1778" HEIGHT="56" BASELINE="355 2193 2131 2186" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2193 355 2208 2129 2201 2131 2186 2127 2158 373 2152 370 2152 368 2152 366 2152 353 2158 355 2193"/>
                        </Shape>
