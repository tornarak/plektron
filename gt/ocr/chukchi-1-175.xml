                        </Shape>
                        <String CONTENT="spring came from the south and followed the reindeer-herds to the very river’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l4" HPOS="378" VPOS="785" WIDTH="1774" HEIGHT="61" BASELINE="381 829 2152 824" TAGREFS="TYPE_4">
