                        </Shape>
                        <String CONTENT="the middle part of the river, between the mouth of the Maïn and the small"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l32" HPOS="376" VPOS="2461" WIDTH="1774" HEIGHT="59" BASELINE="376 2504 2150 2504" TAGREFS="TYPE_4">
