                    </TextLine>

                    <TextLine ID="mz_1-175_l10" HPOS="378" VPOS="1143" WIDTH="1774" HEIGHT="60" BASELINE="381 1188 2152 1184" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1188 381 1203 2150 1201 2152 1184 2148 1156 2074 1143 2072 1143 2070 1143 2044 1153 1732 1143 1730 1143 1680 1153 1650 1143 1648 1143 1645 1143 1643 1143 1609 1153 1576 1143 1574 1143 1572 1143 1570 1143 1537 1153 1524 1143 1522 1143 1520 1143 1314 1143 1312 1143 1310 1143 1260 1156 1154 1145 1152 1145 1149 1145 1117 1156 1046 1145 1043 1145 1041 1145 1039 1145 1022 1158 781 1158 749 1145 747 1145 744 1145 742 1145 721 1156 703 1145 701 1145 699 1145 517 1145 515 1145 513 1145 487 1156 454 1145 452 1145 450 1145 378 1158 381 1188"/>
                        </Shape>
                        <String CONTENT="and allowed it to escape to the shore. Afterwards, in the fishing-season, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l11" HPOS="381" VPOS="1205" WIDTH="1767" HEIGHT="59" BASELINE="383 1249 2148 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1249 383 1264 2146 1262 2148 1242 2143 1214 970 1205 968 1205 965 1205 939 1216 398 1208 396 1208 394 1208 391 1208 381 1214 383 1249"/>
                        </Shape>
                        <String CONTENT="took out the eyes of a live salmon, and in the same manner let it go free."/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l12" HPOS="383" VPOS="1273" WIDTH="1771" HEIGHT="51" BASELINE="383 1307 2154 1307" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1307 383 1324 2154 1324 2154 1307 2154 1277 383 1273 383 1307"/>
                        </Shape>
                        <String CONTENT="The next year, in hunting-time, the flayed reindeer was seen on the herd’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l13" HPOS="378" VPOS="1327" WIDTH="1776" HEIGHT="56" BASELINE="381 1368 2154 1363" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1368 381 1383 2152 1379 2154 1363 2150 1333 446 1327 443 1327 378 1337 381 1368"/>
                        </Shape>
                        <String CONTENT="trail, causing the herds to turn away from the river. Likewise the injured"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l14" HPOS="376" VPOS="1383" WIDTH="1778" HEIGHT="61" BASELINE="378 1428 2154 1424" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1428 378 1444 2152 1439 2154 1424 2150 1396 1810 1383 1808 1383 1741 1394 1715 1383 1713 1383 1710 1383 1515 1394 1461 1383 1459 1383 1347 1394 1316 1383 1314 1383 1312 1383 1223 1396 1007 1385 1004 1385 922 1396 870 1385 868 1385 796 1396 736 1385 734 1385 731 1385 690 1396 649 1385 647 1385 645 1385 487 1396 428 1385 426 1385 424 1385 376 1398 378 1428"/>
                        </Shape>
                        <String CONTENT="salmon made the salmon-shoals go back to the sea, and a frightful famine"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l15" HPOS="376" VPOS="1441" WIDTH="1776" HEIGHT="63" BASELINE="378 1489 2152 1483" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1489 378 1504 2150 1498 2152 1483 2148 1454 1912 1454 1888 1441 1886 1441 1884 1441 1881 1441 1836 1452 1808 1441 1806 1441 1803 1441 1717 1452 1669 1441 1667 1441 1665 1441 1663 1441 1641 1452 1271 1444 1269 1444 1201 1454 1123 1444 1121 1444 1119 1444 1071 1454 985 1444 983 1444 913 1457 597 1446 595 1446 593 1446 556 1457 519 1446 517 1446 515 1446 376 1459 378 1489"/>
                        </Shape>
                        <String CONTENT="ensued. Up to a late period, when reindeer-herds or salmon-shoals were not"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l16" HPOS="376" VPOS="1504" WIDTH="1776" HEIGHT="59" BASELINE="378 1545 2152 1541" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1545 378 1563 2150 1558 2152 1541 2148 1513 396 1504 394 1504 391 1504 389 1504 376 1511 378 1545"/>
                        </Shape>
                        <String CONTENT="forthcoming, it was considered by the old people as a just punishment for the"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l17" HPOS="376" VPOS="1565" WIDTH="1776" HEIGHT="58" BASELINE="378 1608 2152 1602" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1608 378 1623 2150 1617 2152 1602 2148 1573 970 1565 968 1565 894 1576 446 1567 443 1567 376 1578 378 1608"/>
                        </Shape>
                        <String CONTENT="reckless extermination of the game. It is true even at present, that the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l18" HPOS="376" VPOS="1621" WIDTH="1783" HEIGHT="61" BASELINE="378 1667 2159 1662" TAGREFS="TYPE_4">
                        <Shape>
