                        </Shape>
                        <String CONTENT="numbers till the end of June. The greater portion, especially the pregnant dams,"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l35" HPOS="374" VPOS="2649" WIDTH="1774" HEIGHT="52" BASELINE="376 2684 2148 2678" TAGREFS="TYPE_4">
