                        </Shape>
                        <String CONTENT="is an old Yukaghir legend which aims at branding the wanton extermination"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l8" HPOS="362" VPOS="1022" WIDTH="1767" HEIGHT="47" BASELINE="362 1052 2129 1052" TAGREFS="TYPE_4">
                        <Shape>
