                    <TextLine ID="mz_1-175_l24" HPOS="376" VPOS="1983" WIDTH="1776" HEIGHT="58" BASELINE="378 2024 2152 2019" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 2024 378 2041 2150 2037 2152 2019 2148 1991 396 1983 394 1983 391 1983 389 1983 376 1989 378 2024"/>
                        </Shape>
                        <String CONTENT="Omolon the Lamut hunters complain, too, that the “resident” wild reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l25" HPOS="376" VPOS="2043" WIDTH="1774" HEIGHT="61" BASELINE="376 2087 2150 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="376 2087 376 2100 2148 2104 2150 2087 2150 2056 1875 2043 1873 2043 1871 2043 1836 2054 1780 2043 1777 2043 1775 2043 1773 2043 1758 2056 1669 2056 1593 2043 1591 2043 1589 2043 1561 2054 1511 2043 1509 2043 1507 2043 1472 2054 1399 2043 1396 2043 1394 2043 1370 2054 1303 2043 1301 2043 1299 2043 1271 2054 1243 2043 1240 2043 1238 2043 1236 2043 1206 2054 1175 2043 1173 2043 1171 2043 1119 2054 1095 2043 1093 2043 1091 2043 1020 2054 996 2043 994 2043 991 2043 989 2043 987 2043 970 2054 866 2043 864 2043 861 2043 825 2054 783 2043 781 2043 779 2043 695 2054 664 2043 662 2043 660 2043 658 2043 634 2054 567 2043 565 2043 563 2043 560 2043 545 2056 376 2056 376 2087"/>
                        </Shape>
                        <String CONTENT="retreated before the Chukchee herds farther into the forest. On the contrary,"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l26" HPOS="376" VPOS="2106" WIDTH="1776" HEIGHT="56" BASELINE="378 2147 2152 2141" TAGREFS="TYPE_4">
                        <Shape>
