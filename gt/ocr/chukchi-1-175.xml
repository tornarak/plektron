                        <Shape>
                            <Polygon POINTS="378 1844 378 1861 2152 1861 2152 1844 2152 1816 378 1816 378 1844"/>
                        </Shape>
                        <String CONTENT="direction of Omolon and the two Anuis, however, probably lies in the fact"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l22" HPOS="376" VPOS="1870" WIDTH="1772" HEIGHT="54" BASELINE="378 1903 2148 1907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="378 1903 376 1918 2143 1924 2148 1907 2146 1874 378 1870 378 1903"/>
                        </Shape>
