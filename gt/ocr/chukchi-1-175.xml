                        </Shape>
                        <String CONTENT="tribes attributed this calamity to the increase of sinfulness in the world. There"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l7" HPOS="378" VPOS="963" WIDTH="1774" HEIGHT="61" BASELINE="381 1008 2152 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1008 381 1024 2150 1021 2152 1004 2148 976 2083 963 2081 963 2079 963 2055 974 2001 963 1998 963 1996 963 1994 963 1977 976 1624 976 1593 963 1591 963 1589 963 1522 974 1470 963 1468 963 1466 963 1429 974 1364 963 1362 963 1260 976 1212 965 1210 965 1208 965 1206 965 1171 976 1134 965 1132 965 1130 965 1022 976 1000 965 998 965 996 965 896 976 879 965 877 965 874 965 872 965 870 965 842 976 816 965 814 965 812 965 747 976 714 965 712 965 710 965 378 974 381 1008"/>
                        </Shape>
                        <String CONTENT="is an old Yukaghir legend which aims at branding the wanton extermination"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l8" HPOS="383" VPOS="1037" WIDTH="1767" HEIGHT="47" BASELINE="383 1067 2150 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1067 383 1084 2148 1084 2150 1067 2148 1037 383 1037 383 1067"/>
                        </Shape>
                        <String CONTENT="of game and fish. It relates how some men, in most versions some Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l9" HPOS="378" VPOS="1093" WIDTH="1772" HEIGHT="56" BASELINE="381 1125 2150 1130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1125 378 1140 391 1149 394 1149 396 1149 398 1149 2148 1147 2150 1130 2148 1097 381 1093 381 1125"/>
                        </Shape>
