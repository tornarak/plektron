                        </Shape>
                        <String CONTENT="forbidden on land, and allowed only on the river. The old men of both"/>
                    </TextLine>

                    <TextLine ID="mz_1-175_l6" HPOS="383" VPOS="904" WIDTH="1771" HEIGHT="61" BASELINE="383 948 2154 948" TAGREFS="TYPE_4">
                        <Shape>
