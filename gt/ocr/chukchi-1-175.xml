                        <Shape>
                            <Polygon POINTS="357 1530 357 1548 2129 1543 2131 1526 2127 1498 375 1489 373 1489 370 1489 368 1489 355 1496 357 1530"/>
                        </Shape>
                        <String CONTENT="forthcoming, it was considered by the old people as a just punishment for the"/>
                    </TextLine>

