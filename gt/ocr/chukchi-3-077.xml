                        </Shape>
                        <String CONTENT="them. Now I twitch all over, my mind is dull, no sleep. Thus we sit, I"/>
                    </TextLine>

                    <TextLine ID="mz_3-077_l29" HPOS="411" VPOS="2152" WIDTH="1767" HEIGHT="59" BASELINE="413 2199 2178 2193" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="413 2199 413 2211 2178 2207 2178 2193 2176 2162 2159 2152 2157 2152 2155 2152 2153 2152 2151 2152 2120 2166 1841 2166 1738 2152 1736 2152 1679 2164 1623 2152 1621 2152 1619 2152 1617 2152 1599 2164 1332 2154 1331 2154 1270 2166 1227 2154 1225 2154 1223 2154 1134 2166 1058 2154 1056 2154 962 2168 828 2156 826 2156 730 2168 662 2156 660 2156 658 2156 621 2170 524 2170 481 2156 479 2156 477 2156 411 2168 413 2199"/>
                        </Shape>
                        <String CONTENT="and my wife, and cry or play cards. Throughout the winter, as soon as it"/>
                    </TextLine>

                    <TextLine ID="mz_3-077_l30" HPOS="413" VPOS="2220" WIDTH="1763" HEIGHT="59" BASELINE="413 2256 2176 2256" TAGREFS="TYPE_4">
