                        </Shape>
                        <String CONTENT="becomes dark, we expect guests. The guests come, enter the sleeping-room,"/>
                    </TextLine>

                    <TextLine ID="mz_3-077_l31" HPOS="411" VPOS="2273" WIDTH="1763" HEIGHT="62" BASELINE="413 2316 2174 2312" TAGREFS="TYPE_4">
