                    </TextLine>

                    <TextLine ID="mz_3-133_l42" HPOS="356" VPOS="2801" WIDTH="1764" HEIGHT="45" BASELINE="358 2829 2120 2825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="358 2829 358 2846 2118 2842 2120 2825 2114 2801 356 2803 358 2829"/>
                        </Shape>
                        <String CONTENT="“Their method of carrying on such a feud is quite foreign to our fcelings. Strange as it may seem, a murderer"/>
                    </TextLine>

                    <TextLine ID="mz_3-133_l43" HPOS="358" VPOS="2842" WIDTH="1764" HEIGHT="45" BASELINE="358 2871 2122 2871" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="358 2871 358 2885 2120 2887 2122 2871 2120 2842 358 2844 358 2871"/>
                        </Shape>
                        <String CONTENT="will go to visit the relatives of his victim, though he knows that they are allowed to kill him in revenge, and"/>
                    </TextLine>

                    <TextLine ID="mz_3-133_l44" HPOS="354" VPOS="2887" WIDTH="1768" HEIGHT="43" BASELINE="356 2914 2122 2910" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2914 356 2930 2120 2926 2122 2910 2116 2887 354 2889 356 2914"/>
                        </Shape>
                        <String CONTENT="will settle with them. He is kindly welcomed, and sometimes lives quietly for weeks and months. Then he"/>
                    </TextLine>

                    <TextLine ID="mz_3-133_l45" HPOS="356" VPOS="2922" WIDTH="1768" HEIGHT="51" BASELINE="358 2957 2124 2953" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="358 2957 358 2973 2122 2971 2124 2953 2118 2922 356 2930 358 2957"/>
                        </Shape>
                        <String CONTENT="is suddenly challenged to a wrestling-match, and, if defeated, is killed: or, if victorious, be may kill one of"/>
                    </TextLine>

                    <TextLine ID="mz_3-133_l46" HPOS="356" VPOS="2967" WIDTH="1766" HEIGHT="49" BASELINE="358 3000 2122 2994" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2114 2967 356 2975 358 3000 358 3016 2122 3012 2122 2994 2118 2983 2114 2967"/>
                        </Shape>
                        <String CONTENT="the opposite party; or when hunting, he is suddenly attacked by his companions and slain.” (Boas, Central"/>
                    </TextLine>

