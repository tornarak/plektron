                    <TextLine ID="mz_1-169_l4" HPOS="359" VPOS="809" WIDTH="1776" HEIGHT="52" BASELINE="361 840 2135 844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="361 840 359 855 2130 861 2135 844 2133 814 361 809 361 840"/>
                        </Shape>
