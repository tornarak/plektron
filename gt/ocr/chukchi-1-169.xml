                <TextBlock ID="text_1-169" HPOS="338" VPOS="625" WIDTH="1778" HEIGHT="2629"><TextLine ID="mz_1-169_l1" HPOS="927" VPOS="625" WIDTH="613" HEIGHT="54" BASELINE="927 660 1540 660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1533 638 1512 634 1490 628 1479 625 947 625 929 643 927 660 927 679 1540 679 1540 660 1536 645 1533 638"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l2" HPOS="2021" VPOS="632" WIDTH="86" HEIGHT="50" BASELINE="2021 664 2107 664" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2086 636 2064 632 2021 632 2021 664 2021 682 2107 682 2107 664 2107 638 2086 636"/>
                        </Shape>
                        <String CONTENT="127"/>
                    </TextLine>
<TextLine ID="mz_1-169_l3" HPOS="340" VPOS="723" WIDTH="1774" HEIGHT="67" BASELINE="342 766 2114 770" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 731 427 731 405 734 383 734 362 736 342 736 342 766 340 781 351 790 353 790 355 790 357 790 2112 786 2114 770 2112 738 1882 738 1865 725 1863 725 1860 725 1858 725 1785 736 1733 725 1731 725 1728 725 1687 736 1648 725 1646 725 1644 725 1538 736 1306 725 1304 725 1245 736 1230 723 1228 723 1226 723 1224 723 1126 736 983 736 968 723 966 723 964 723 962 723 908 736 754 736 739 723 736 723 734 723 732 723 730 723 693 734 628 723 626 723 624 723 589 734 451 729 448 731"/>
                        </Shape>
                        <String CONTENT="but a couple of men, and are used for short trips within the village range;"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l4" HPOS="338" VPOS="794" WIDTH="1776" HEIGHT="52" BASELINE="340 825 2114 829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 825 338 840 2109 846 2114 829 2112 799 340 794 340 825"/>
                        </Shape>
                        <String CONTENT="for instance, to catch dead seals floating on the surface or sunk to the bottom,"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l5" HPOS="340" VPOS="853" WIDTH="1748" HEIGHT="52" BASELINE="342 883 2088 889" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 883 340 898 2084 905 2088 889 2086 859 342 853 342 883"/>
                        </Shape>
                        <String CONTENT="to go shooting water-fowl along the shore, to inspect the fish and seal nets, etc."/>
                    </TextLine>
<TextLine ID="mz_1-169_l6" HPOS="448" VPOS="911" WIDTH="1666" HEIGHT="52" BASELINE="451 944 2114 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 944 448 959 2109 963 2114 948 2112 915 451 911 451 944"/>
                        </Shape>
                        <String CONTENT="The frame of the large boat resembles that described by Nelson,¹ except"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l7" HPOS="338" VPOS="967" WIDTH="1776" HEIGHT="57" BASELINE="340 1009 2114 1004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1009 340 1024 2112 1019 2114 1004 2109 976 357 967 355 967 353 967 351 967 338 974 340 1009"/>
                        </Shape>
                        <String CONTENT="that the ribs and the cross-pieces of the bottom are set much closer together"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l8" HPOS="338" VPOS="1022" WIDTH="1771" HEIGHT="67" BASELINE="340 1073 2109 1065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1073 340 1086 2105 1089 2109 1065 2107 1035 2071 1022 2068 1022 2066 1022 2064 1022 2042 1032 1958 1022 1956 1022 1954 1022 1951 1022 1936 1035 1802 1035 1769 1022 1767 1022 1765 1022 1763 1022 1726 1032 1676 1022 1674 1022 1672 1022 1670 1022 1650 1035 1410 1024 1408 1024 1200 1037 1165 1026 1163 1026 1161 1026 1159 1026 1128 1037 1087 1026 1085 1026 1083 1026 986 1037 739 1028 736 1028 734 1028 732 1028 715 1039 529 1028 526 1028 451 1039 355 1028 353 1028 351 1028 349 1028 338 1035 340 1073"/>
                        </Shape>
                        <String CONTENT="(Fig. 44). The dimensions of the boat secured for our collection are, length,"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l9" HPOS="347" VPOS="1080" WIDTH="1769" HEIGHT="69" BASELINE="349 1132 2116 1123" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1132 349 1149 2116 1136 2116 1123 2109 1086 1897 1091 1876 1080 1873 1080 1871 1080 1782 1091 1756 1080 1754 1080 1752 1080 1750 1080 1726 1091 1702 1080 1700 1080 1698 1080 1696 1080 1668 1093 1570 1082 1568 1082 1566 1082 1542 1095 1403 1095 1356 1082 1354 1082 1352 1082 1349 1082 1347 1082 1328 1095 1167 1095 1139 1084 1137 1084 1135 1084 1133 1084 1089 1095 986 1084 983 1084 916 1095 858 1084 856 1084 745 1097 730 1086 728 1086 726 1086 572 1086 570 1086 568 1086 522 1097 442 1086 440 1086 347 1099 349 1132"/>
                        </Shape>
                        <String CONTENT="35 feet; breadth in the middle, between the gunwales, 4½ feet; breadth of"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l10" HPOS="342" VPOS="1145" WIDTH="1770" HEIGHT="63" BASELINE="342 1188 2112 1188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1188 342 1201 2109 1208 2112 1188 2112 1158 2001 1145 1999 1145 1997 1145 1958 1158 1724 1158 1687 1145 1685 1145 1683 1145 1598 1156 1497 1145 1494 1145 1492 1145 1462 1156 1434 1145 1432 1145 1429 1145 1362 1156 1293 1145 1291 1145 1289 1145 1256 1156 1154 1145 1053 1145 1050 1145 1048 1145 1046 1145 1031 1156 951 1145 949 1145 947 1145 914 1156 795 1145 793 1145 678 1156 617 1145 615 1145 613 1145 581 1156 542 1145 539 1145 537 1145 535 1145 509 1156 342 1151 342 1188"/>
                        </Shape>
                        <String CONTENT="bottom in the middle, 2½ feet; height, 2 feet 8 inches. It has 21 cross-pieces,"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l11" HPOS="340" VPOS="1208" WIDTH="1774" HEIGHT="58" BASELINE="342 1249 2114 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1249 342 1266 2112 1262 2114 1245 2109 1216 409 1208 407 1208 340 1219 342 1249"/>
                        </Shape>
                        <String CONTENT="and as many ribs on each side; 4 thwarts; 5 large oars and as many paddles."/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l12" HPOS="340" VPOS="1275" WIDTH="1774" HEIGHT="50" BASELINE="342 1309 2114 1303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1309 342 1325 2112 1318 2114 1303 2109 1275 340 1275 342 1309"/>
                        </Shape>
                        <String CONTENT="It requires a crew of from six to eight men, and can carry freight up to two"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l13" HPOS="340" VPOS="1327" WIDTH="1774" HEIGHT="56" BASELINE="342 1368 2114 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1368 342 1383 2112 1379 2114 1364 2109 1335 360 1327 357 1327 355 1327 353 1327 340 1333 342 1368"/>
                        </Shape>
                        <String CONTENT="tons. The central timber, strips and gunwales, according to the man who"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l14" HPOS="338" VPOS="1385" WIDTH="1776" HEIGHT="59" BASELINE="340 1429 2114 1424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1429 340 1444 2112 1439 2114 1424 2109 1396 1271 1385 1269 1385 1189 1396 390 1387 388 1387 338 1398 340 1429"/>
                        </Shape>
                        <String CONTENT="sold me the boat, were brought from America in a rude state. The frame"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l15" HPOS="340" VPOS="1444" WIDTH="1774" HEIGHT="62" BASELINE="342 1489 2114 1483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1489 342 1506 2112 1500 2114 1483 2109 1452 931 1444 929 1444 927 1444 895 1455 676 1446 674 1446 340 1457 342 1489"/>
                        </Shape>
                        <String CONTENT="was constructed on East Cape, and taken thence to Mečiˊwmɪn, and afterwards"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l16" HPOS="340" VPOS="1502" WIDTH="1774" HEIGHT="61" BASELINE="342 1548 2114 1543" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1548 342 1563 2112 1558 2114 1543 2109 1513 1819 1502 1817 1502 1815 1502 1772 1513 1718 1502 1715 1502 1713 1502 1674 1513 1640 1502 1637 1502 1635 1502 1360 1513 1330 1502 1328 1502 1326 1502 1254 1513 1230 1502 1228 1502 1226 1502 1224 1502 1191 1515 1165 1504 1163 1504 1161 1504 1159 1504 1113 1515 862 1504 860 1504 858 1504 819 1515 773 1504 771 1504 769 1504 697 1515 578 1504 576 1504 574 1504 552 1515 418 1504 416 1504 340 1517 342 1548"/>
                        </Shape>
                        <String CONTENT="to Indian Point. At the last-named place it was covered with skin and used"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l17" HPOS="340" VPOS="1574" WIDTH="1769" HEIGHT="52" BASELINE="342 1604 2109 1608" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1604 340 1619 2105 1626 2109 1608 2107 1578 342 1574 342 1604"/>
                        </Shape>
                        <String CONTENT="for several years; so that, from the very circumstances regarding its construction,"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l18" HPOS="340" VPOS="1621" WIDTH="1772" HEIGHT="72" BASELINE="342 1667 2112 1662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1667 342 1682 752 1682 823 1693 825 1693 1397 1680 1434 1691 1436 1691 1438 1691 1551 1680 1616 1691 1618 1691 1620 1691 1622 1691 1637 1680 1720 1691 1722 1691 1724 1691 1726 1691 1741 1680 1795 1691 1798 1691 1800 1691 1802 1691 1821 1680 2109 1680 2112 1662 2107 1634 1421 1621 1419 1621 1416 1621 1414 1621 1399 1634 1254 1634 1228 1621 1226 1621 1224 1621 1222 1621 1219 1621 1198 1634 1178 1623 1176 1623 1174 1623 1172 1623 1150 1634 1137 1623 1135 1623 1133 1623 1131 1623 1128 1623 1100 1634 1042 1623 1040 1623 1038 1623 1007 1634 947 1623 944 1623 942 1623 916 1634 901 1623 899 1623 897 1623 895 1623 892 1623 864 1634 843 1623 840 1623 838 1623 836 1623 799 1634 734 1623 732 1623 340 1632 342 1667"/>
                        </Shape>
                        <String CONTENT="it must be called typical for the Asiatic coast (Plate XI, Fig. 4). The home-"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l19" HPOS="340" VPOS="1684" WIDTH="1769" HEIGHT="63" BASELINE="342 1727 2109 1723" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1727 342 1745 2105 1747 2109 1723 2105 1693 425 1684 422 1684 340 1695 342 1727"/>
                        </Shape>
                        <String CONTENT="made boats of the Pacific villages between Indian Point and Anadyr, however,"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l20" HPOS="338" VPOS="1751" WIDTH="1007" HEIGHT="63" BASELINE="340 1781 1345 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1781 338 1801 349 1810 351 1810 353 1810 355 1810 650 1801 717 1812 719 1812 975 1803 1007 1814 1009 1814 1012 1814 1343 1803 1345 1788 1343 1758 340 1751 340 1781"/>
                        </Shape>
                        <String CONTENT="are clumsier, and their sea qualities poorer."/>
                    </TextLine>
<TextLine ID="mz_1-169_l21" HPOS="448" VPOS="1801" WIDTH="1666" HEIGHT="63" BASELINE="451 1846 2114 1842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 1846 451 1864 2112 1859 2114 1842 2112 1814 2062 1801 2060 1801 2058 1801 2055 1801 2032 1812 1644 1801 1642 1801 1588 1812 1555 1801 1553 1801 1551 1801 1445 1812 1371 1801 1369 1801 1241 1814 1176 1803 1174 1803 1172 1803 1146 1814 1133 1803 1131 1803 1128 1803 1126 1803 1124 1803 1100 1816 996 1816 981 1803 979 1803 977 1803 975 1803 973 1803 927 1814 858 1803 856 1803 853 1803 827 1816 665 1816 646 1803 643 1803 641 1803 639 1803 448 1812 451 1846"/>
                        </Shape>
                        <String CONTENT="The skin cover is unfastened for the winter and safely hidden from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l22" HPOS="340" VPOS="1877" WIDTH="1774" HEIGHT="45" BASELINE="340 1907 2114 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1907 340 1922 2114 1922 2114 1907 2114 1877 340 1877 340 1907"/>
                        </Shape>
                        <String CONTENT="dogs. Late in the spring it is taken out and soaked for several days in"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l23" HPOS="340" VPOS="1924" WIDTH="1774" HEIGHT="59" BASELINE="342 1968 2114 1963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1968 342 1983 2112 1978 2114 1963 2109 1935 1239 1924 1237 1924 1235 1924 1232 1924 1217 1935 581 1927 578 1927 340 1937 342 1968"/>
                        </Shape>
                        <String CONTENT="some pond or in the sea, though in the latter case the owner is obliged to"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l24" HPOS="340" VPOS="1983" WIDTH="1774" HEIGHT="60" BASELINE="342 2026 2114 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2026 342 2043 2112 2039 2114 2022 2109 1994 1280 1983 1278 1983 1219 1996 340 1996 342 2026"/>
                        </Shape>
                        <String CONTENT="keep a sharp lookout for drifting ice and for the force of the current, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l25" HPOS="340" VPOS="2046" WIDTH="1774" HEIGHT="58" BASELINE="342 2087 2114 2082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2087 342 2104 2112 2100 2114 2082 2109 2054 464 2046 461 2046 340 2056 342 2087"/>
                        </Shape>
                        <String CONTENT="may break the thongs by which it is secured and carry away the skin. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l26" HPOS="342" VPOS="2104" WIDTH="1772" HEIGHT="58" BASELINE="344 2150 2114 2143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2150 344 2162 2112 2156 2114 2143 2109 2115 1559 2104 1557 2104 1462 2115 425 2108 422 2108 342 2119 344 2150"/>
                        </Shape>
                        <String CONTENT="work of covering is done by several persons; the boat’s crew, in order to"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l27" HPOS="342" VPOS="2173" WIDTH="1772" HEIGHT="50" BASELINE="344 2208 2114 2204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2208 344 2223 2112 2219 2114 2204 2109 2173 342 2173 344 2208"/>
                        </Shape>
                        <String CONTENT="hasten matters, calling on their acquaintances and relatives to aid them. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l28" HPOS="342" VPOS="2223" WIDTH="1772" HEIGHT="61" BASELINE="344 2266 2114 2262" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2266 344 2284 2112 2279 2114 2262 2109 2234 1332 2223 1330 2223 1224 2234 609 2225 607 2225 342 2236 344 2266"/>
                        </Shape>
                        <String CONTENT="wet cover is pulled around the frame as tightly as possible, and its edge is"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l29" HPOS="342" VPOS="2292" WIDTH="1767" HEIGHT="52" BASELINE="344 2329 2109 2323" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2329 344 2344 2107 2340 2109 2323 2105 2292 342 2292 344 2329"/>
                        </Shape>
                        <String CONTENT="bent over the gunwale and laced to the middle strip with stout leather thongs."/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l30" HPOS="342" VPOS="2342" WIDTH="1772" HEIGHT="61" BASELINE="344 2388 2114 2381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2388 344 2403 2112 2398 2114 2381 2109 2353 1536 2342 1533 2342 1460 2353 966 2344 964 2344 912 2355 362 2347 360 2347 357 2347 355 2347 342 2353 344 2388"/>
                        </Shape>
                        <String CONTENT="After a while, when the lacings have dried a little, they are tightened by"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l31" HPOS="344" VPOS="2403" WIDTH="1768" HEIGHT="58" BASELINE="347 2446 2112 2442" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2446 347 2461 2109 2459 2112 2442 2107 2414 1352 2403 1349 2403 1224 2414 550 2405 548 2405 344 2416 347 2446"/>
                        </Shape>
                        <String CONTENT="means of walrus-tusks, which serve as marline-spike and hand-lever. Every"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l32" HPOS="344" VPOS="2470" WIDTH="1770" HEIGHT="52" BASELINE="344 2505 2114 2505" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2505 344 2522 2114 2522 2114 2505 2114 2474 344 2470 344 2505"/>
                        </Shape>
                        <String CONTENT="little hole in the skin is carefully patched and the boat turned bottom-side"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l33" HPOS="342" VPOS="2524" WIDTH="1772" HEIGHT="56" BASELINE="344 2567 2114 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2567 344 2580 2112 2574 2114 2561 2109 2533 938 2524 936 2524 934 2524 931 2524 918 2535 498 2526 496 2526 342 2537 344 2567"/>
                        </Shape>
                        <String CONTENT="up and allowed to dry for twenty-four hours. During this time it receives"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l34" HPOS="342" VPOS="2583" WIDTH="1774" HEIGHT="60" BASELINE="344 2626 2116 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2626 344 2643 2114 2637 2116 2619 2112 2591 936 2583 934 2583 931 2583 910 2593 531 2585 529 2585 342 2595 344 2626"/>
                        </Shape>
                        <String CONTENT="two or three coatings of oil, and the patches are smeared around with thick oil-"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l35" HPOS="342" VPOS="2645" WIDTH="1698" HEIGHT="59" BASELINE="344 2686 2040 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2686 344 2704 2038 2697 2040 2680 2036 2652 364 2645 362 2645 360 2645 357 2645 342 2652 344 2686"/>
                        </Shape>
                        <String CONTENT="drippings, at present more frequently with oil paints bought from whalers."/>
                    </TextLine>
<TextLine ID="mz_1-169_l36" HPOS="448" VPOS="2702" WIDTH="1668" HEIGHT="62" BASELINE="451 2747 2116 2743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 2747 451 2764 2114 2760 2116 2743 2112 2712 1293 2702 1291 2702 1178 2715 448 2715 451 2747"/>
                        </Shape>
                        <String CONTENT="In former times boats were propelled by paddles (Fig. 45, a), and a large"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l37" HPOS="342" VPOS="2773" WIDTH="1772" HEIGHT="52" BASELINE="344 2808 2114 2803" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2808 344 2825 2112 2825 2114 2803 2109 2773 342 2773 344 2808"/>
                        </Shape>
                        <String CONTENT="broad-bladed paddle was used for steering (Fig. 45, b). At present, along"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l38" HPOS="342" VPOS="2825" WIDTH="1772" HEIGHT="58" BASELINE="344 2868 2114 2860" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2868 344 2883 2112 2875 2114 2860 2109 2831 786 2825 784 2825 782 2825 780 2825 765 2836 383 2827 381 2827 379 2827 342 2838 344 2868"/>
                        </Shape>
                        <String CONTENT="with the paddles, long narrow oars are used (Plate XI, Fig. 1). These are"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l39" HPOS="342" VPOS="2881" WIDTH="1772" HEIGHT="63" BASELINE="344 2929 2114 2922" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2929 344 2944 2112 2938 2114 2922 2109 2892 1577 2881 1575 2881 1479 2894 342 2894 344 2929"/>
                        </Shape>
                        <String CONTENT="imitations of the American whale-boat oars, and are often simply bought from"/>
                    </TextLine>

                    <TextLine ID="mz_1-169_l40" HPOS="342" VPOS="2938" WIDTH="1772" HEIGHT="67" BASELINE="344 2990 2114 2981" TAGREFS="TYPE_5">
