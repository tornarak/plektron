                    <TextLine ID="mz_1-169_l5" HPOS="361" VPOS="868" WIDTH="1748" HEIGHT="52" BASELINE="363 898 2109 904" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="363 898 361 913 2105 920 2109 904 2107 874 363 868 363 898"/>
                        </Shape>
