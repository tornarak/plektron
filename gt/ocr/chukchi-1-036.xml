                        <Polygon POINTS="583 1117 2361 1117 2361 1894 583 1894"/>
                    </Shape>
                    <TextLine ID="mz_1-036_l9" HPOS="695" VPOS="1114" WIDTH="1659" HEIGHT="61" BASELINE="697 1160 2354 1156" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="697 1160 697 1175 2351 1171 2354 1156 2349 1127 2206 1114 2204 1114 2126 1125 2098 1114 2096 1114 2094 1114 2033 1125 2009 1114 2007 1114 2005 1114 1951 1125 1907 1114 1905 1114 1903 1114 1901 1114 1853 1125 1775 1114 1773 1114 1771 1114 1747 1127 1574 1127 1533 1114 1531 1114 1528 1114 1526 1114 1524 1114 1509 1130 1414 1130 1399 1117 1396 1117 1394 1117 1392 1117 1390 1117 1357 1127 1308 1117 1305 1117 1303 1117 1266 1127 1063 1117 1061 1117 1000 1127 755 1117 753 1117 695 1125 697 1160"/>
                        </Shape>
                        <String CONTENT="NEIGHBORING TRIBES. — In the early years of the Russian invasion —"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l10" HPOS="589" VPOS="1175" WIDTH="1773" HEIGHT="59" BASELINE="591 1221 2362 1216" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1221 591 1234 2360 1229 2362 1216 2358 1188 2306 1175 2304 1175 2302 1175 2273 1186 2061 1175 2059 1175 1964 1186 1936 1175 1933 1175 1931 1175 1929 1175 1927 1175 1912 1188 1626 1188 1596 1175 1593 1175 1591 1175 1442 1188 976 1177 974 1177 972 1177 946 1188 883 1177 881 1177 879 1177 840 1188 799 1177 796 1177 794 1177 792 1177 757 1188 718 1177 716 1177 714 1177 712 1177 710 1177 695 1188 608 1177 606 1177 604 1177 602 1177 589 1186 591 1221"/>
                        </Shape>
                        <String CONTENT="that is, in the first half of the seventeenth century — there lived on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l11" HPOS="591" VPOS="1242" WIDTH="1771" HEIGHT="54" BASELINE="591 1279 2362 1279" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1279 591 1296 2362 1296 2362 1279 2362 1249 591 1242 591 1279"/>
                        </Shape>
                        <String CONTENT="large tundra west of the Kolyma some Reindeer people whom the Cossacks"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l12" HPOS="589" VPOS="1296" WIDTH="1769" HEIGHT="59" BASELINE="589 1337 2358 1337" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 1337 589 1355 2358 1355 2358 1337 2358 1309 2230 1309 2213 1296 2211 1296 2208 1296 2206 1296 2204 1296 2172 1307 2122 1296 2120 1296 2066 1307 1918 1296 1916 1296 1914 1296 1884 1309 1604 1309 1522 1296 1520 1296 1440 1307 1388 1296 1386 1296 1329 1307 1271 1296 1269 1296 1266 1296 1227 1307 1197 1296 1195 1296 1193 1296 1063 1307 885 1296 883 1296 881 1296 859 1307 764 1296 762 1296 682 1307 623 1296 621 1296 619 1296 589 1307 589 1337"/>
                        </Shape>
                        <String CONTENT="also called Chukchee, and with whom they were engaged in continual petty"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l13" HPOS="589" VPOS="1359" WIDTH="1771" HEIGHT="54" BASELINE="591 1400 2360 1396" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1400 591 1413 2358 1411 2360 1396 2356 1366 675 1359 673 1359 589 1370 591 1400"/>
                        </Shape>
                        <String CONTENT="warfare. Two rivers of the tundra were named after them, — the Large and"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l14" HPOS="589" VPOS="1413" WIDTH="1771" HEIGHT="61" BASELINE="591 1457 2360 1461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1457 589 1470 2356 1474 2360 1461 2360 1431 2291 1415 2289 1415 2226 1426 2165 1415 2163 1415 2161 1415 2128 1426 1754 1415 1752 1415 1667 1426 1591 1415 1589 1415 1494 1426 1457 1413 1455 1413 1453 1413 1450 1413 1424 1424 1258 1413 1256 1413 1160 1424 1132 1413 1130 1413 1128 1413 1126 1413 1123 1413 1108 1426 1002 1426 983 1413 981 1413 978 1413 976 1413 974 1413 955 1424 933 1413 931 1413 929 1413 926 1413 903 1424 851 1413 848 1413 846 1413 825 1424 790 1413 788 1413 786 1413 783 1413 744 1424 703 1413 701 1413 699 1413 645 1424 619 1413 617 1413 615 1413 612 1413 591 1424 591 1457"/>
                        </Shape>
                        <String CONTENT="the Small Chukchee. According to the tradition of the inhabitants, the oldest"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l15" HPOS="591" VPOS="1489" WIDTH="1767" HEIGHT="45" BASELINE="591 1517 2358 1517" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1517 591 1534 2356 1534 2358 1517 2356 1489 591 1489 591 1517"/>
                        </Shape>
                        <String CONTENT="Cossack settlement on the western branch of the Lower Kolyma, the village"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l16" HPOS="589" VPOS="1539" WIDTH="1767" HEIGHT="63" BASELINE="591 1573 2356 1580" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1573 589 1593 599 1602 602 1602 604 1602 606 1602 2354 1597 2356 1580 2354 1550 591 1539 591 1573"/>
                        </Shape>
                        <String CONTENT="Pokhotsk, was destroyed by them; though the story is given in an epic way,"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l17" HPOS="586" VPOS="1593" WIDTH="1774" HEIGHT="61" BASELINE="589 1638 2360 1634" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 1638 589 1654 2358 1654 2360 1634 2354 1597 1988 1604 1951 1593 1949 1593 1946 1593 1888 1604 1862 1593 1860 1593 1858 1593 1855 1593 1829 1604 1803 1593 1801 1593 1799 1593 1713 1604 1678 1593 1676 1593 1674 1593 1578 1604 1550 1593 1548 1593 1546 1593 1544 1593 1513 1604 1485 1593 1483 1593 1481 1593 1479 1593 1476 1593 1463 1604 1249 1595 1247 1595 1171 1606 1156 1595 1154 1595 1152 1595 1046 1595 1043 1595 1041 1595 996 1606 942 1595 939 1595 937 1595 935 1595 922 1606 890 1595 887 1595 885 1595 883 1595 855 1608 697 1608 662 1595 660 1595 658 1595 586 1608 589 1638"/>
                        </Shape>
                        <String CONTENT="and some of the details call to mind the tales of the Central Eskimo of"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l18" HPOS="589" VPOS="1664" WIDTH="1767" HEIGHT="50" BASELINE="591 1695 2356 1699" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1695 589 1710 2351 1714 2356 1699 2354 1669 591 1664 591 1695"/>
                        </Shape>
                        <String CONTENT="America, and must date back to a time prior to the appearance of the Russians."/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l19" HPOS="591" VPOS="1727" WIDTH="1769" HEIGHT="48" BASELINE="591 1757 2360 1757" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1757 591 1775 2360 1775 2360 1757 2360 1727 591 1727 591 1757"/>
                        </Shape>
                        <String CONTENT="Other villages were pillaged and burned down by certain Chukchee who are"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l20" HPOS="589" VPOS="1788" WIDTH="1771" HEIGHT="47" BASELINE="589 1818 2360 1818" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 1818 589 1835 2360 1835 2360 1818 2360 1788 589 1788 589 1818"/>
                        </Shape>
                        <String CONTENT="reputed to have come by sea in skin boats, though at the present time there"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l21" HPOS="584" VPOS="1833" WIDTH="1772" HEIGHT="63" BASELINE="586 1879 2356 1874" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 1879 586 1896 2354 1892 2356 1874 2351 1846 2044 1833 2042 1833 2040 1833 2037 1833 2018 1846 1877 1846 1832 1833 1829 1833 1827 1833 1713 1844 1667 1833 1665 1833 1663 1833 1661 1833 1622 1844 1593 1833 1591 1833 1589 1833 1587 1833 1585 1833 1572 1844 1526 1833 1524 1833 1522 1833 1412 1846 1336 1835 1334 1835 1331 1835 1295 1846 1258 1835 1256 1835 1253 1835 1059 1846 996 1835 994 1835 991 1835 950 1846 840 1835 838 1835 584 1848 586 1879"/>
                        </Shape>
                        <String CONTENT="are no maritime villages within three hundred miles to the east off these places."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-036_r4" HPOS="583" VPOS="1894" WIDTH="1778" HEIGHT="902" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="583 1894 2361 1894 2361 2796 583 2796"/>
                    </Shape>
                    <TextLine ID="mz_1-036_l22" HPOS="697" VPOS="1892" WIDTH="1659" HEIGHT="69" BASELINE="699 1933 2356 1939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="699 1933 697 1948 712 1959 714 1959 716 1959 718 1961 2354 1961 2356 1939 2354 1909 2302 1896 2163 1896 2161 1896 2159 1896 2156 1896 2143 1907 2083 1896 2081 1896 2079 1896 2055 1907 1966 1896 1964 1896 1962 1896 1936 1907 1923 1896 1920 1896 1918 1896 1825 1896 1823 1896 1821 1896 1819 1896 1803 1907 1641 1894 1639 1894 1637 1894 1602 1907 1485 1907 1470 1894 1468 1894 1466 1894 1463 1894 1412 1905 1336 1894 1334 1894 1253 1905 1199 1892 1197 1892 1195 1892 1130 1903 699 1898 699 1933"/>
                        </Shape>
                        <String CONTENT="The Chukchee tradition calls this people, not Chukchee, but Čaˊačên,"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l23" HPOS="586" VPOS="1952" WIDTH="1774" HEIGHT="61" BASELINE="589 1998 2360 1993" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 1970 589 1998 589 2013 2358 2009 2360 1993 2356 1965 2202 1965 2185 1952 2182 1952 2180 1952 2178 1952 2120 1963 2107 1952 2105 1952 2102 1952 2100 1952 2001 1963 1983 1952 1981 1952 1979 1952 1977 1952 1907 1963 1886 1952 1884 1952 1881 1952 1879 1952 1877 1952 1862 1965 1728 1965 1700 1952 1697 1952 1695 1952 1693 1952 1691 1952 1676 1963 1650 1952 1648 1952 1645 1952 1643 1952 1604 1963 1574 1952 1572 1952 1570 1952 1515 1963 1476 1952 1474 1952 1472 1952 1377 1965 1295 1954 1292 1954 957 1965 827 1954 825 1954 822 1954 799 1965 744 1954 742 1954 740 1954 699 1965 599 1954 597 1954 595 1954 593 1954 593 1957 586 1961 586 1970"/>
                        </Shape>
                        <String CONTENT="from the Čaˊan or Čaˊwan River (“Chaun” of the maps), whose banks were"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l24" HPOS="589" VPOS="2028" WIDTH="1769" HEIGHT="48" BASELINE="589 2058 2358 2058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2058 589 2076 2358 2076 2358 2058 2358 2028 589 2028 589 2058"/>
                        </Shape>
                        <String CONTENT="their principal territory (Fig. 1). They were, however, closely connected with"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l25" HPOS="591" VPOS="2076" WIDTH="1769" HEIGHT="58" BASELINE="591 2119 2360 2119" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2119 591 2134 2360 2134 2360 2119 2360 2089 1645 2076 1643 2076 1641 2076 1613 2089 1433 2089 1396 2076 1394 2076 1392 2076 1325 2087 1271 2076 1269 2076 1180 2087 1156 2076 1154 2076 1011 2076 1009 2076 1007 2076 1004 2076 991 2087 942 2076 939 2076 937 2076 905 2087 892 2076 890 2076 887 2076 760 2076 757 2076 706 2087 612 2076 610 2076 608 2076 606 2076 591 2084 591 2119"/>
                        </Shape>
                        <String CONTENT="them, though the Čaˊačêt spoke a language of their own. I was shown some"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l26" HPOS="589" VPOS="2132" WIDTH="1767" HEIGHT="61" BASELINE="591 2173 2356 2177" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2173 589 2188 2351 2193 2356 2177 2356 2145 2336 2134 2334 2134 2332 2134 2330 2134 2254 2145 2239 2134 2237 2134 2234 2134 2143 2134 2141 2134 2139 2134 2137 2134 2122 2145 2011 2134 2009 2134 1914 2145 1871 2134 1868 2134 1866 2134 1784 2145 1745 2134 1743 2134 1741 2134 1739 2134 1700 2147 1578 2147 1561 2134 1559 2134 1557 2134 1554 2134 1418 2143 1401 2132 1399 2132 1396 2132 1394 2132 1336 2143 1297 2132 1295 2132 1292 2132 1193 2143 1089 2132 1087 2132 1022 2143 931 2132 929 2132 870 2143 825 2132 822 2132 820 2132 591 2141 591 2173"/>
                        </Shape>
                        <String CONTENT="very old burial-mounds on both sides of the mouth of the Kolyma, filled with"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l27" HPOS="586" VPOS="2199" WIDTH="1768" HEIGHT="54" BASELINE="589 2234 2354 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2234 586 2247 2349 2253 2354 2240 2351 2208 589 2199 589 2234"/>
                        </Shape>
                        <String CONTENT="large accumulations of reindeer-antlers which had been offered to the dead."/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l28" HPOS="589" VPOS="2251" WIDTH="1765" HEIGHT="69" BASELINE="591 2292 2354 2301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2292 589 2310 602 2318 604 2318 606 2318 608 2320 2351 2320 2354 2301 2351 2271 2293 2258 2291 2258 2156 2268 1951 2258 1949 2258 1946 2258 1914 2268 1879 2255 1877 2255 1875 2255 1873 2255 1838 2266 1767 2255 1630 2255 1628 2255 1626 2255 1624 2255 1611 2266 1561 2255 1559 2255 1440 2264 1424 2253 1422 2253 1420 2253 1418 2253 1347 2264 1299 2253 1297 2253 1295 2253 1210 2264 1106 2253 1104 2253 998 2262 983 2251 981 2251 978 2251 976 2251 913 2262 591 2258 591 2292"/>
                        </Shape>
                        <String CONTENT="These were said to have belonged to the Čaˊačêt; the Chukchee arguing"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l29" HPOS="584" VPOS="2323" WIDTH="1772" HEIGHT="58" BASELINE="586 2353 2356 2359" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 2353 584 2370 597 2379 599 2379 602 2379 604 2379 1089 2370 1186 2381 1188 2381 2354 2372 2356 2359 2354 2329 586 2323 586 2353"/>
                        </Shape>
                        <String CONTENT="that they could not have belonged to their own tribe, because among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l30" HPOS="584" VPOS="2381" WIDTH="1774" HEIGHT="52" BASELINE="586 2411 2358 2416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 2411 584 2429 2354 2433 2358 2416 2356 2385 586 2381 586 2411"/>
                        </Shape>
                        <String CONTENT="antlers of slaughtered reindeer were some which had been shed, and they offer"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l31" HPOS="586" VPOS="2446" WIDTH="1772" HEIGHT="45" BASELINE="586 2476 2358 2476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 2476 586 2491 2358 2491 2358 2476 2358 2446 586 2446 586 2476"/>
                        </Shape>
                        <String CONTENT="to the dead only the antlers of slaughtered reindeer. Some of the piles were"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l32" HPOS="586" VPOS="2502" WIDTH="1772" HEIGHT="50" BASELINE="586 2537 2358 2537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="586 2537 586 2552 2358 2552 2358 2537 2356 2502 586 2504 586 2537"/>
                        </Shape>
                        <String CONTENT="so old that the antlers crumbled away under one’s fingers, and were large"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l33" HPOS="584" VPOS="2561" WIDTH="1772" HEIGHT="60" BASELINE="586 2593 2356 2598" TAGREFS="TYPE_5">
                        <Shape>
