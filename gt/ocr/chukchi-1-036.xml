                        </Shape>
                        <String CONTENT="degree with the Koryak, though even in Kamchatka the older generation"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l5" HPOS="589" VPOS="874" WIDTH="1769" HEIGHT="61" BASELINE="591 920 2358 915" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 920 591 935 2356 933 2358 915 2356 887 2306 874 2304 874 2302 874 2299 874 2278 885 2254 874 2252 874 2250 874 2247 874 2226 885 1955 874 1953 874 1884 885 1855 874 1853 874 1851 874 1849 874 1847 874 1832 887 1661 887 1632 874 1630 874 1628 874 1565 885 1520 874 1518 874 1515 874 1418 887 1381 876 1379 876 1377 876 1375 876 1349 887 1292 876 1290 876 1288 876 1258 887 1171 876 1169 876 1069 887 892 876 890 876 887 876 853 887 799 876 796 876 693 887 606 876 604 876 602 876 599 876 589 883 591 920"/>
                        </Shape>
                        <String CONTENT="still speaks Chukchee. On the border-line between the Chukchee and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l6" HPOS="589" VPOS="941" WIDTH="1771" HEIGHT="52" BASELINE="591 974 2360 978" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 974 589 989 2356 993 2360 978 2358 948 591 941 591 974"/>
                        </Shape>
                        <String CONTENT="Koryak I came across some camps the inhabitants of which were themselves"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l7" HPOS="591" VPOS="998" WIDTH="1771" HEIGHT="56" BASELINE="593 1039 2362 1034" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="593 1039 593 1054 2360 1050 2362 1034 2358 1000 669 998 667 998 591 1008 593 1039"/>
                        </Shape>
                        <String CONTENT="unable to decide to which tribe they belonged, since the tribal names of"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l8" HPOS="591" VPOS="1063" WIDTH="1767" HEIGHT="51" BASELINE="593 1095 2358 1099" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="593 1095 591 1110 2354 1114 2358 1099 2356 1069 593 1063 593 1095"/>
                        </Shape>
                        <String CONTENT="Reindeer Chukchee and Koryak are identical and the languages very similar."/>
                    </TextLine>
</TextBlock>
