                        <String CONTENT="as southern Kamchatka. Most of these became assimilated to a considerable"/>
                    </TextLine>

                    <TextLine ID="mz_1-036_l4" HPOS="591" VPOS="829" WIDTH="1767" HEIGHT="58" BASELINE="591 857 2358 857" TAGREFS="TYPE_5">
                        <Shape>
