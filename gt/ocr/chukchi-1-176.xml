            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-176" HPOS="700" VPOS="608" WIDTH="1782" HEIGHT="2633"><TextLine ID="mz_1-176_l1" HPOS="1287" VPOS="608" WIDTH="619" HEIGHT="56" BASELINE="1289 643 1906 647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1895 623 1878 610 1308 608 1289 617 1289 643 1287 660 1902 664 1906 647 1904 638 1895 623"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l2" HPOS="715" VPOS="623" WIDTH="97" HEIGHT="56" BASELINE="715 656 812 656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="810 623 715 623 715 656 715 666 745 679 747 679 749 679 812 666 812 656 812 625 810 623"/>
                        </Shape>
                        <String CONTENT="134"/>
                    </TextLine>
<TextLine ID="mz_1-176_l3" HPOS="704" VPOS="725" WIDTH="1776" HEIGHT="45" BASELINE="704 755 2480 755" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 755 704 770 2480 770 2480 755 2480 725 704 725 704 755"/>
                        </Shape>
                        <String CONTENT="canoe, constructed of three very thin and flexible boards, or dug out of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l4" HPOS="702" VPOS="770" WIDTH="1780" HEIGHT="70" BASELINE="704 816 2482 812" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 816 704 829 1165 840 1167 840 2480 827 2482 812 2478 783 2322 770 2320 770 2317 770 2294 781 2231 770 2229 770 2226 770 2181 783 1982 783 1956 770 1954 770 1951 770 1893 781 1824 770 1821 770 1819 770 1787 781 1596 770 1594 770 1592 770 1562 781 1453 773 1451 773 1449 773 1447 773 1434 783 1373 773 1371 773 1369 773 1336 783 1293 773 1291 773 1289 773 1196 783 1141 773 1139 773 702 779 704 816"/>
                        </Shape>
                        <String CONTENT="hollow poplar-trunk, while the Chukchee use the skin canoe. The hunters"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l5" HPOS="702" VPOS="833" WIDTH="1776" HEIGHT="59" BASELINE="702 874 2478 874" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="702 874 702 892 2478 892 2478 874 2478 846 2406 833 2404 833 2335 844 2248 833 2246 833 2244 833 2213 844 1908 833 1906 833 1828 844 1782 833 1780 833 1778 833 1705 844 1648 833 1646 833 1644 833 1609 844 1520 833 1518 833 1516 833 1514 833 1499 846 1289 846 1254 833 1252 833 1250 833 1248 833 1217 844 1122 833 1120 833 1003 844 966 833 964 833 962 833 960 833 936 846 702 846 702 874"/>
                        </Shape>
                        <String CONTENT="occupy a place a little downstream from the trail, and keep very quiet. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l6" HPOS="702" VPOS="898" WIDTH="1776" HEIGHT="54" BASELINE="704 935 2478 931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 935 704 952 2475 948 2478 931 2471 898 702 902 704 935"/>
                        </Shape>
                        <String CONTENT="even refrain from making a fire, in order that the animals may not be frightened"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l7" HPOS="700" VPOS="950" WIDTH="1778" HEIGHT="61" BASELINE="702 998 2478 991" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="702 998 702 1011 2475 1009 2478 991 2475 963 2441 950 2439 950 2437 950 2434 950 2393 961 2081 950 2079 950 2077 950 2034 961 1988 950 1986 950 1984 950 1880 963 1451 952 1449 952 1388 963 1332 952 1330 952 1328 952 1306 963 1124 954 1122 954 1016 965 953 954 951 954 949 954 918 965 853 954 851 954 849 954 847 954 830 967 700 967 702 998"/>
                        </Shape>
                        <String CONTENT="away by the smell of smoke. The reindeer come to the river, one (usually"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l8" HPOS="702" VPOS="1011" WIDTH="1776" HEIGHT="65" BASELINE="704 1058 2478 1054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1058 704 1071 2473 1076 2478 1054 2473 1024 2413 1011 2411 1011 2408 1011 2380 1022 2367 1011 2365 1011 2363 1011 2361 1011 2359 1011 2330 1022 2114 1011 2112 1011 2109 1011 2107 1011 2092 1024 1973 1024 1954 1011 1951 1011 1949 1011 1817 1011 1815 1011 1724 1022 1590 1011 1588 1011 1585 1011 1544 1024 1507 1013 1505 1013 1503 1013 1174 1024 1083 1013 1081 1013 1079 1013 1048 1024 979 1013 977 1013 702 1026 704 1058"/>
                        </Shape>
                        <String CONTENT="a young active doe) running ahead as leader, and begin to swim across, being"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l9" HPOS="702" VPOS="1069" WIDTH="1776" HEIGHT="63" BASELINE="704 1117 2478 1110" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1117 704 1132 2475 1125 2478 1110 2473 1082 2276 1082 2248 1069 2246 1069 2244 1069 2242 1069 2203 1080 2170 1069 2168 1069 2166 1069 2068 1080 2042 1069 2040 1069 2038 1069 1949 1080 1886 1069 1884 1069 1882 1069 1845 1082 1566 1071 1564 1071 1562 1071 1536 1082 1477 1071 1475 1071 1473 1071 1471 1071 1455 1082 1105 1073 1102 1073 1005 1084 916 1073 914 1073 912 1073 866 1084 808 1073 806 1073 804 1073 801 1073 786 1084 736 1073 734 1073 732 1073 702 1084 704 1117"/>
                        </Shape>
                        <String CONTENT="all the while carried downstream by the current. When the animals are not"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l10" HPOS="704" VPOS="1145" WIDTH="1774" HEIGHT="48" BASELINE="704 1175 2478 1175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1175 704 1188 2475 1193 2478 1175 2478 1145 704 1145 704 1175"/>
                        </Shape>
                        <String CONTENT="far from the middle of the river, the hunters rush out in canoes and boats,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l11" HPOS="702" VPOS="1195" WIDTH="1776" HEIGHT="58" BASELINE="704 1238 2478 1232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1238 704 1253 2475 1247 2478 1232 2473 1197 771 1195 769 1195 702 1206 704 1238"/>
                        </Shape>
                        <String CONTENT="and try to impede their progress. The frightened animals turn upstream, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l12" HPOS="706" VPOS="1264" WIDTH="1772" HEIGHT="50" BASELINE="706 1294 2478 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1294 706 1309 2475 1314 2478 1294 2478 1264 706 1264 706 1294"/>
                        </Shape>
                        <String CONTENT="exhaust their strength in a vain struggle with the force of the running water;"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l13" HPOS="704" VPOS="1314" WIDTH="1776" HEIGHT="56" BASELINE="706 1355 2480 1351" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1355 706 1370 2478 1366 2480 1351 2475 1322 723 1314 721 1314 719 1314 717 1314 704 1320 706 1355"/>
                        </Shape>
                        <String CONTENT="then one or two canoes go around the herd in order to cut off their retreat"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l14" HPOS="706" VPOS="1383" WIDTH="1769" HEIGHT="50" BASELINE="706 1416 2475 1416" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1416 706 1429 2473 1433 2475 1416 2475 1383 706 1383 706 1416"/>
                        </Shape>
                        <String CONTENT="to the opposite bank, and slaughtering begins. The reindeer huddle together,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l15" HPOS="704" VPOS="1444" WIDTH="1774" HEIGHT="47" BASELINE="704 1474 2478 1474" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1474 704 1491 2478 1491 2478 1474 2478 1444 704 1444 704 1474"/>
                        </Shape>
                        <String CONTENT="and float quite helplessly in the middle of the stream. Men in canoes approach"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l16" HPOS="706" VPOS="1502" WIDTH="1772" HEIGHT="50" BASELINE="706 1532 2478 1532" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1532 706 1552 2478 1552 2478 1532 2478 1502 706 1502 706 1532"/>
                        </Shape>
                        <String CONTENT="the herd and stab the reindeer with spears, which have a very long and slender"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l17" HPOS="706" VPOS="1563" WIDTH="1767" HEIGHT="47" BASELINE="706 1593 2473 1593" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1593 706 1610 2471 1610 2473 1593 2471 1563 706 1563 706 1593"/>
                        </Shape>
                        <String CONTENT="shaft, a small iron point, and are not used for any other kind of hunting."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l18" HPOS="704" VPOS="1608" WIDTH="1769" HEIGHT="65" BASELINE="706 1652 2473 1656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1652 704 1665 2469 1673 2473 1656 2471 1623 1739 1610 1737 1610 1683 1621 1637 1610 1635 1610 1633 1610 1631 1610 1590 1621 1529 1608 1527 1608 1525 1608 1492 1619 1449 1608 1447 1608 1445 1608 1442 1608 1416 1619 1388 1608 1386 1608 1384 1608 1313 1619 1215 1608 1213 1608 1146 1619 1128 1608 1126 1608 1124 1608 1122 1608 1120 1608 1098 1619 1031 1608 1029 1608 1027 1608 1005 1619 983 1608 981 1608 979 1608 977 1608 955 1619 888 1608 886 1608 706 1617 706 1652"/>
                        </Shape>
                        <String CONTENT="One side of the double paddle is also often furnished with a small iron spear,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l19" HPOS="706" VPOS="1671" WIDTH="1481" HEIGHT="69" BASELINE="708 1712 2187 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 1712 706 1723 782 1738 784 1738 869 1727 1326 1738 1328 1738 1408 1727 1505 1738 1507 1738 1891 1729 1904 1740 1906 1740 1908 1740 1910 1740 1912 1740 1943 1729 1958 1740 1960 1740 1962 1740 1964 1740 1967 1740 2012 1729 2099 1740 2101 1740 2103 1740 2125 1729 2159 1740 2161 1740 2164 1740 2166 1740 2168 1740 2185 1727 2187 1717 2187 1684 2170 1673 2168 1673 2166 1673 2164 1673 2161 1673 2127 1684 1969 1673 1967 1673 1889 1684 1672 1673 1670 1673 1391 1682 1373 1671 1371 1671 1369 1671 1367 1671 1365 1671 1336 1682 1235 1671 1232 1671 1230 1671 1198 1684 1029 1684 1018 1673 1018 1671 1016 1671 1014 1671 1012 1671 1009 1671 970 1682 905 1671 903 1671 901 1671 871 1682 825 1671 823 1671 821 1671 708 1680 708 1712"/>
                        </Shape>
                        <String CONTENT="which, though not so long, is much handier to use (Fig. 47, a)."/>
                    </TextLine>
<TextLine ID="mz_1-176_l20" HPOS="817" VPOS="1729" WIDTH="1661" HEIGHT="61" BASELINE="817 1773 2478 1773" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="817 1773 817 1790 2478 1790 2478 1773 2478 1742 2393 1729 2391 1729 2311 1740 2209 1729 2207 1729 2142 1740 2062 1729 2060 1729 2058 1729 2032 1740 2016 1729 2014 1729 2012 1729 2010 1729 2008 1729 1982 1742 1778 1742 1750 1729 1748 1729 1746 1729 1672 1740 1577 1729 1575 1729 1497 1740 1410 1729 1408 1729 1406 1729 1384 1740 1360 1729 1358 1729 1356 1729 1295 1740 1180 1729 1178 1729 1176 1729 1150 1740 1109 1729 1107 1729 1105 1729 1102 1729 1081 1740 1016 1729 1014 1729 817 1734 817 1773"/>
                        </Shape>
                        <String CONTENT="The killing is done with incredible rapidity, a man being able to kill as"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l21" HPOS="702" VPOS="1790" WIDTH="1776" HEIGHT="61" BASELINE="704 1836 2478 1829" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 1836 704 1851 2475 1844 2478 1829 2473 1799 1295 1790 1293 1790 1291 1790 1289 1790 1269 1801 970 1792 968 1792 702 1803 704 1836"/>
                        </Shape>
                        <String CONTENT="many as a hundred animals in one hour. The wound is inflicted on the lower"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l22" HPOS="704" VPOS="1853" WIDTH="1771" HEIGHT="65" BASELINE="706 1896 2475 1890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1896 706 1918 2473 1909 2475 1890 2471 1857 791 1853 788 1853 704 1864 706 1896"/>
                        </Shape>
                        <String CONTENT="part of the body, and the wounded animals immediately turn on the side and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l23" HPOS="704" VPOS="1920" WIDTH="1767" HEIGHT="50" BASELINE="706 1952 2471 1948" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 1952 706 1970 2469 1970 2471 1948 2465 1920 704 1922 706 1952"/>
                        </Shape>
                        <String CONTENT="are carried away by the stream. Most of them do not attempt defence."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l24" HPOS="713" VPOS="1972" WIDTH="1765" HEIGHT="58" BASELINE="713 2013 2478 2013" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2013 713 2030 2478 2030 2478 2013 2478 1985 2426 1972 2424 1972 2421 1972 2391 1983 2365 1972 2363 1972 2361 1972 1564 1983 1488 1972 1486 1972 1416 1983 1232 1972 1230 1972 1228 1972 1187 1983 1135 1972 1133 1972 1131 1972 1128 1972 1115 1983 1061 1972 1059 1972 1057 1972 1055 1972 1040 1985 832 1985 713 1972 713 2013"/>
                        </Shape>
                        <String CONTENT="Young strong bucks, however, often try to kick at the canoe, though the"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l25" HPOS="706" VPOS="2028" WIDTH="1769" HEIGHT="61" BASELINE="708 2074 2475 2069" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 2074 708 2089 2473 2087 2475 2069 2473 2039 2454 2028 2452 2028 2450 2028 2447 2028 2395 2039 2343 2028 2341 2028 2222 2041 1975 2041 1938 2028 1936 2028 1934 2028 1932 2028 1884 2039 1718 2028 1715 2028 1713 2028 1687 2039 1546 2030 1544 2030 1542 2030 1540 2030 1525 2041 1455 2030 1453 2030 1451 2030 1425 2041 1284 2030 1282 2030 1206 2041 1159 2030 1157 2030 1154 2030 1038 2041 981 2030 979 2030 706 2035 708 2074"/>
                        </Shape>
                        <String CONTENT="hunter easily avoids their attack. Those hunters who are most skilful with"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l26" HPOS="706" VPOS="2104" WIDTH="1772" HEIGHT="46" BASELINE="706 2132 2478 2132" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2132 706 2150 2478 2150 2478 2132 2478 2104 706 2104 706 2132"/>
                        </Shape>
                        <String CONTENT="the paddle penetrate into the middle of the herd, and, placing their canoe"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l27" HPOS="704" VPOS="2150" WIDTH="1771" HEIGHT="67" BASELINE="706 2191 2475 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2191 704 2206 719 2217 721 2217 723 2217 726 2217 2473 2212 2475 2195 2473 2165 2413 2152 2250 2152 2248 2152 2246 2152 2244 2152 2231 2162 2205 2152 2203 2152 2200 2152 2198 2152 2161 2162 2049 2152 2047 2152 1941 2162 1904 2152 1902 2152 1899 2152 1897 2152 1860 2162 1826 2152 1824 2152 1821 2152 1819 2152 1778 2162 1696 2152 1694 2152 1692 2152 1657 2162 1644 2152 1642 2152 1640 2152 1637 2152 1408 2160 1373 2150 1371 2150 1369 2150 1367 2150 1341 2160 1304 2150 1302 2150 1300 2150 1297 2150 1267 2160 1167 2150 1165 2150 1163 2150 1131 2162 882 2162 866 2150 864 2150 862 2150 860 2150 858 2150 832 2160 752 2150 749 2150 706 2158 706 2191"/>
                        </Shape>
                        <String CONTENT="close between two large bucks, spear all the animals within reach, beginning"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l28" HPOS="704" VPOS="2219" WIDTH="1769" HEIGHT="54" BASELINE="706 2251 2473 2256" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2251 704 2264 2469 2273 2473 2256 2471 2223 706 2219 706 2251"/>
                        </Shape>
                        <String CONTENT="with those farthest away; while the nearest, not being disturbed, keep quiet,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l29" HPOS="702" VPOS="2279" WIDTH="1771" HEIGHT="55" BASELINE="704 2310 2473 2314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="704 2310 702 2325 2469 2334 2473 2314 2471 2284 704 2279 704 2310"/>
                        </Shape>
                        <String CONTENT="and their bodies shield the canoe from the surrounding commotion. Old men,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l30" HPOS="704" VPOS="2331" WIDTH="1774" HEIGHT="59" BASELINE="706 2375 2478 2368" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2375 706 2390 2475 2383 2478 2368 2473 2340 1339 2331 1336 2331 704 2344 706 2375"/>
                        </Shape>
                        <String CONTENT="women and children, row in boats farther down the river, and intercept the"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l31" HPOS="704" VPOS="2390" WIDTH="1774" HEIGHT="63" BASELINE="706 2435 2478 2431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2435 706 2453 2475 2444 2478 2431 2473 2403 2224 2390 2222 2390 2170 2401 2142 2390 2140 2390 2138 2390 2075 2401 2010 2390 2008 2390 2006 2390 2003 2390 1988 2403 1860 2403 1763 2390 1761 2390 1759 2390 1713 2401 1659 2390 1657 2390 1562 2403 1505 2392 1503 2392 1176 2403 1057 2392 1055 2392 996 2403 918 2392 916 2392 914 2392 912 2392 897 2405 704 2405 706 2435"/>
                        </Shape>
                        <String CONTENT="game. All animals, when brought to the shore, are skinned. The fattest"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l32" HPOS="706" VPOS="2459" WIDTH="1772" HEIGHT="59" BASELINE="708 2494 2478 2489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 2494 708 2507 1118 2518 1120 2518 1122 2518 1124 2518 1141 2507 1163 2518 1165 2518 1167 2518 1235 2507 1577 2515 1579 2515 1726 2505 1843 2515 1845 2515 1847 2515 1850 2515 1863 2505 1917 2515 1919 2515 2008 2505 2090 2515 2092 2515 2144 2505 2216 2515 2218 2515 2220 2515 2222 2515 2239 2505 2348 2515 2350 2515 2352 2515 2378 2505 2439 2515 2441 2515 2443 2515 2478 2502 2478 2489 2473 2461 706 2459 708 2494"/>
                        </Shape>
                        <String CONTENT="bucks are carved, and some of the meat is hung up to dry. All other car-"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l33" HPOS="706" VPOS="2520" WIDTH="1769" HEIGHT="50" BASELINE="706 2552 2475 2552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2552 706 2570 2475 2570 2475 2552 2473 2520 706 2520 706 2552"/>
                        </Shape>
                        <String CONTENT="casses are simply deposited in storehouses or in temporary hunting-huts, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l34" HPOS="706" VPOS="2570" WIDTH="1772" HEIGHT="58" BASELINE="706 2611 2478 2611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2611 706 2628 2478 2628 2478 2611 2478 2583 2421 2570 2419 2570 2346 2580 2330 2570 2328 2570 2326 2570 2324 2570 2322 2570 2291 2580 2036 2570 2034 2570 1841 2580 1815 2570 1813 2570 1811 2570 1733 2580 1635 2570 1633 2570 1553 2580 1523 2570 1520 2570 1518 2570 1516 2570 1473 2580 1436 2570 1434 2570 1432 2570 1429 2570 1427 2570 1414 2580 1386 2570 1384 2570 1382 2570 1380 2570 1345 2580 1315 2570 1313 2570 1310 2570 1308 2570 1263 2580 1230 2570 1228 2570 1226 2570 1159 2580 1126 2570 1124 2570 1122 2570 1120 2570 1087 2580 970 2570 968 2570 966 2570 931 2580 901 2570 899 2570 897 2570 706 2580 706 2611"/>
                        </Shape>
                        <String CONTENT="are used chiefly for dog-food in the winter. A score of Chukchee families"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l35" HPOS="706" VPOS="2630" WIDTH="1769" HEIGHT="56" BASELINE="706 2671 2475 2671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="706 2671 706 2684 2473 2686 2475 2671 2475 2643 2348 2643 2324 2630 2322 2630 2320 2630 2317 2630 2285 2641 2272 2630 2270 2630 2268 2630 2265 2630 2209 2641 2129 2630 2127 2630 2125 2630 2081 2641 2049 2630 2047 2630 2045 2630 2042 2630 2012 2641 1841 2630 1839 2630 1837 2630 1808 2641 1752 2630 1750 2630 1698 2641 1666 2630 1663 2630 1661 2630 1659 2630 1629 2641 1575 2630 1451 2630 1449 2630 1447 2630 1445 2630 1432 2641 1386 2630 1384 2630 1382 2630 1380 2630 1343 2641 1152 2630 1150 2630 1148 2630 1118 2641 1059 2630 1057 2630 1003 2641 706 2637 706 2671"/>
                        </Shape>
                        <String CONTENT="living in wooden huts on the Middle Anadyr have no herds, and do very"/>
                    </TextLine>

