                    <TextLine ID="mz_1-176_l1" HPOS="1308" VPOS="623" WIDTH="619" HEIGHT="56" BASELINE="1310 658 1927 662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1916 638 1899 625 1329 623 1310 632 1310 658 1308 675 1923 679 1927 662 1925 653 1916 638"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l2" HPOS="736" VPOS="638" WIDTH="97" HEIGHT="56" BASELINE="736 671 833 671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="831 638 736 638 736 671 736 681 766 694 768 694 770 694 833 681 833 671 833 640 831 638"/>
                        </Shape>
                        <String CONTENT="134"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-176_r2" HPOS="724" VPOS="736" WIDTH="1778" HEIGHT="1017" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="724 736 2502 736 2502 1753 724 1753"/>
                    </Shape>
                    <TextLine ID="mz_1-176_l3" HPOS="725" VPOS="740" WIDTH="1776" HEIGHT="45" BASELINE="725 770 2501 770" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 770 725 785 2501 785 2501 770 2501 740 725 740 725 770"/>
                        </Shape>
                        <String CONTENT="canoe, constructed of three very thin and flexible boards, or dug out of a"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l4" HPOS="723" VPOS="785" WIDTH="1780" HEIGHT="70" BASELINE="725 831 2503 827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 831 725 844 1186 855 1188 855 2501 842 2503 827 2499 798 2343 785 2341 785 2338 785 2315 796 2252 785 2250 785 2247 785 2202 798 2003 798 1977 785 1975 785 1972 785 1914 796 1845 785 1842 785 1840 785 1808 796 1617 785 1615 785 1613 785 1583 796 1474 788 1472 788 1470 788 1468 788 1455 798 1394 788 1392 788 1390 788 1357 798 1314 788 1312 788 1310 788 1217 798 1162 788 1160 788 723 794 725 831"/>
                        </Shape>
                        <String CONTENT="hollow poplar-trunk, while the Chukchee use the skin canoe. The hunters"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l5" HPOS="723" VPOS="848" WIDTH="1776" HEIGHT="59" BASELINE="723 889 2499 889" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 889 723 907 2499 907 2499 889 2499 861 2427 848 2425 848 2356 859 2269 848 2267 848 2265 848 2234 859 1929 848 1927 848 1849 859 1803 848 1801 848 1799 848 1726 859 1669 848 1667 848 1665 848 1630 859 1541 848 1539 848 1537 848 1535 848 1520 861 1310 861 1275 848 1273 848 1271 848 1269 848 1238 859 1143 848 1141 848 1024 859 987 848 985 848 983 848 981 848 957 861 723 861 723 889"/>
                        </Shape>
                        <String CONTENT="occupy a place a little downstream from the trail, and keep very quiet. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l6" HPOS="723" VPOS="913" WIDTH="1776" HEIGHT="54" BASELINE="725 950 2499 946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 950 725 967 2496 963 2499 946 2492 913 723 917 725 950"/>
                        </Shape>
                        <String CONTENT="even refrain from making a fire, in order that the animals may not be frightened"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l7" HPOS="721" VPOS="965" WIDTH="1778" HEIGHT="61" BASELINE="723 1013 2499 1006" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="723 1013 723 1026 2496 1024 2499 1006 2496 978 2462 965 2460 965 2458 965 2455 965 2414 976 2102 965 2100 965 2098 965 2055 976 2009 965 2007 965 2005 965 1901 978 1472 967 1470 967 1409 978 1353 967 1351 967 1349 967 1327 978 1145 969 1143 969 1037 980 974 969 972 969 970 969 939 980 874 969 872 969 870 969 868 969 851 982 721 982 723 1013"/>
                        </Shape>
                        <String CONTENT="away by the smell of smoke. The reindeer come to the river, one (usually"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l8" HPOS="723" VPOS="1026" WIDTH="1776" HEIGHT="65" BASELINE="725 1073 2499 1069" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1073 725 1086 2494 1091 2499 1069 2494 1039 2434 1026 2432 1026 2429 1026 2401 1037 2388 1026 2386 1026 2384 1026 2382 1026 2380 1026 2351 1037 2135 1026 2133 1026 2130 1026 2128 1026 2113 1039 1994 1039 1975 1026 1972 1026 1970 1026 1838 1026 1836 1026 1745 1037 1611 1026 1609 1026 1606 1026 1565 1039 1528 1028 1526 1028 1524 1028 1195 1039 1104 1028 1102 1028 1100 1028 1069 1039 1000 1028 998 1028 723 1041 725 1073"/>
                        </Shape>
                        <String CONTENT="a young active doe) running ahead as leader, and begin to swim across, being"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l9" HPOS="723" VPOS="1084" WIDTH="1776" HEIGHT="63" BASELINE="725 1132 2499 1125" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1132 725 1147 2496 1140 2499 1125 2494 1097 2297 1097 2269 1084 2267 1084 2265 1084 2263 1084 2224 1095 2191 1084 2189 1084 2187 1084 2089 1095 2063 1084 2061 1084 2059 1084 1970 1095 1907 1084 1905 1084 1903 1084 1866 1097 1587 1086 1585 1086 1583 1086 1557 1097 1498 1086 1496 1086 1494 1086 1492 1086 1476 1097 1126 1088 1123 1088 1026 1099 937 1088 935 1088 933 1088 887 1099 829 1088 827 1088 825 1088 822 1088 807 1099 757 1088 755 1088 753 1088 723 1099 725 1132"/>
                        </Shape>
                        <String CONTENT="all the while carried downstream by the current. When the animals are not"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l10" HPOS="725" VPOS="1160" WIDTH="1774" HEIGHT="48" BASELINE="725 1190 2499 1190" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1190 725 1203 2496 1208 2499 1190 2499 1160 725 1160 725 1190"/>
                        </Shape>
                        <String CONTENT="far from the middle of the river, the hunters rush out in canoes and boats,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l11" HPOS="723" VPOS="1210" WIDTH="1776" HEIGHT="58" BASELINE="725 1253 2499 1247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1253 725 1268 2496 1262 2499 1247 2494 1212 792 1210 790 1210 723 1221 725 1253"/>
                        </Shape>
                        <String CONTENT="and try to impede their progress. The frightened animals turn upstream, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l12" HPOS="727" VPOS="1279" WIDTH="1772" HEIGHT="50" BASELINE="727 1309 2499 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1309 727 1324 2496 1329 2499 1309 2499 1279 727 1279 727 1309"/>
                        </Shape>
                        <String CONTENT="exhaust their strength in a vain struggle with the force of the running water;"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l13" HPOS="725" VPOS="1329" WIDTH="1776" HEIGHT="56" BASELINE="727 1370 2501 1366" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1370 727 1385 2499 1381 2501 1366 2496 1337 744 1329 742 1329 740 1329 738 1329 725 1335 727 1370"/>
                        </Shape>
                        <String CONTENT="then one or two canoes go around the herd in order to cut off their retreat"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l14" HPOS="727" VPOS="1398" WIDTH="1769" HEIGHT="50" BASELINE="727 1431 2496 1431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1431 727 1444 2494 1448 2496 1431 2496 1398 727 1398 727 1431"/>
                        </Shape>
                        <String CONTENT="to the opposite bank, and slaughtering begins. The reindeer huddle together,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l15" HPOS="725" VPOS="1459" WIDTH="1774" HEIGHT="47" BASELINE="725 1489 2499 1489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1489 725 1506 2499 1506 2499 1489 2499 1459 725 1459 725 1489"/>
                        </Shape>
                        <String CONTENT="and float quite helplessly in the middle of the stream. Men in canoes approach"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l16" HPOS="727" VPOS="1517" WIDTH="1772" HEIGHT="50" BASELINE="727 1547 2499 1547" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1547 727 1567 2499 1567 2499 1547 2499 1517 727 1517 727 1547"/>
                        </Shape>
                        <String CONTENT="the herd and stab the reindeer with spears, which have a very long and slender"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l17" HPOS="727" VPOS="1578" WIDTH="1767" HEIGHT="47" BASELINE="727 1608 2494 1608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1608 727 1625 2492 1625 2494 1608 2492 1578 727 1578 727 1608"/>
                        </Shape>
                        <String CONTENT="shaft, a small iron point, and are not used for any other kind of hunting."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l18" HPOS="725" VPOS="1623" WIDTH="1769" HEIGHT="65" BASELINE="727 1667 2494 1671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1667 725 1680 2490 1688 2494 1671 2492 1638 1760 1625 1758 1625 1704 1636 1658 1625 1656 1625 1654 1625 1652 1625 1611 1636 1550 1623 1548 1623 1546 1623 1513 1634 1470 1623 1468 1623 1466 1623 1463 1623 1437 1634 1409 1623 1407 1623 1405 1623 1334 1634 1236 1623 1234 1623 1167 1634 1149 1623 1147 1623 1145 1623 1143 1623 1141 1623 1119 1634 1052 1623 1050 1623 1048 1623 1026 1634 1004 1623 1002 1623 1000 1623 998 1623 976 1634 909 1623 907 1623 727 1632 727 1667"/>
                        </Shape>
                        <String CONTENT="One side of the double paddle is also often furnished with a small iron spear,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l19" HPOS="727" VPOS="1686" WIDTH="1481" HEIGHT="69" BASELINE="729 1727 2208 1732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 1727 727 1738 803 1753 805 1753 890 1742 1347 1753 1349 1753 1429 1742 1526 1753 1528 1753 1912 1744 1925 1755 1927 1755 1929 1755 1931 1755 1933 1755 1964 1744 1979 1755 1981 1755 1983 1755 1985 1755 1988 1755 2033 1744 2120 1755 2122 1755 2124 1755 2146 1744 2180 1755 2182 1755 2185 1755 2187 1755 2189 1755 2206 1742 2208 1732 2208 1699 2191 1688 2189 1688 2187 1688 2185 1688 2182 1688 2148 1699 1990 1688 1988 1688 1910 1699 1693 1688 1691 1688 1412 1697 1394 1686 1392 1686 1390 1686 1388 1686 1386 1686 1357 1697 1256 1686 1253 1686 1251 1686 1219 1699 1050 1699 1039 1688 1039 1686 1037 1686 1035 1686 1033 1686 1030 1686 991 1697 926 1686 924 1686 922 1686 892 1697 846 1686 844 1686 842 1686 729 1695 729 1727"/>
                        </Shape>
                        <String CONTENT="which, though not so long, is much handier to use (Fig. 47, a)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-176_r3" HPOS="724" VPOS="1753" WIDTH="1778" HEIGHT="1311" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="724 1753 2502 1753 2502 3064 724 3064"/>
                    </Shape>
                    <TextLine ID="mz_1-176_l20" HPOS="838" VPOS="1744" WIDTH="1661" HEIGHT="61" BASELINE="838 1788 2499 1788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="838 1788 838 1805 2499 1805 2499 1788 2499 1757 2414 1744 2412 1744 2332 1755 2230 1744 2228 1744 2163 1755 2083 1744 2081 1744 2079 1744 2053 1755 2037 1744 2035 1744 2033 1744 2031 1744 2029 1744 2003 1757 1799 1757 1771 1744 1769 1744 1767 1744 1693 1755 1598 1744 1596 1744 1518 1755 1431 1744 1429 1744 1427 1744 1405 1755 1381 1744 1379 1744 1377 1744 1316 1755 1201 1744 1199 1744 1197 1744 1171 1755 1130 1744 1128 1744 1126 1744 1123 1744 1102 1755 1037 1744 1035 1744 838 1749 838 1788"/>
                        </Shape>
                        <String CONTENT="The killing is done with incredible rapidity, a man being able to kill as"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l21" HPOS="723" VPOS="1805" WIDTH="1776" HEIGHT="61" BASELINE="725 1851 2499 1844" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 1851 725 1866 2496 1859 2499 1844 2494 1814 1316 1805 1314 1805 1312 1805 1310 1805 1290 1816 991 1807 989 1807 723 1818 725 1851"/>
                        </Shape>
                        <String CONTENT="many as a hundred animals in one hour. The wound is inflicted on the lower"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l22" HPOS="725" VPOS="1868" WIDTH="1771" HEIGHT="65" BASELINE="727 1911 2496 1905" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1911 727 1933 2494 1924 2496 1905 2492 1872 812 1868 809 1868 725 1879 727 1911"/>
                        </Shape>
                        <String CONTENT="part of the body, and the wounded animals immediately turn on the side and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l23" HPOS="725" VPOS="1935" WIDTH="1767" HEIGHT="50" BASELINE="727 1967 2492 1963" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 1967 727 1985 2490 1985 2492 1963 2486 1935 725 1937 727 1967"/>
                        </Shape>
                        <String CONTENT="are carried away by the stream. Most of them do not attempt defence."/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l24" HPOS="734" VPOS="1987" WIDTH="1765" HEIGHT="58" BASELINE="734 2028 2499 2028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2028 734 2045 2499 2045 2499 2028 2499 2000 2447 1987 2445 1987 2442 1987 2412 1998 2386 1987 2384 1987 2382 1987 1585 1998 1509 1987 1507 1987 1437 1998 1253 1987 1251 1987 1249 1987 1208 1998 1156 1987 1154 1987 1152 1987 1149 1987 1136 1998 1082 1987 1080 1987 1078 1987 1076 1987 1061 2000 853 2000 734 1987 734 2028"/>
                        </Shape>
                        <String CONTENT="Young strong bucks, however, often try to kick at the canoe, though the"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l25" HPOS="727" VPOS="2043" WIDTH="1769" HEIGHT="61" BASELINE="729 2089 2496 2084" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 2089 729 2104 2494 2102 2496 2084 2494 2054 2475 2043 2473 2043 2471 2043 2468 2043 2416 2054 2364 2043 2362 2043 2243 2056 1996 2056 1959 2043 1957 2043 1955 2043 1953 2043 1905 2054 1739 2043 1736 2043 1734 2043 1708 2054 1567 2045 1565 2045 1563 2045 1561 2045 1546 2056 1476 2045 1474 2045 1472 2045 1446 2056 1305 2045 1303 2045 1227 2056 1180 2045 1178 2045 1175 2045 1059 2056 1002 2045 1000 2045 727 2050 729 2089"/>
                        </Shape>
                        <String CONTENT="hunter easily avoids their attack. Those hunters who are most skilful with"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l26" HPOS="727" VPOS="2119" WIDTH="1772" HEIGHT="46" BASELINE="727 2147 2499 2147" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2147 727 2165 2499 2165 2499 2147 2499 2119 727 2119 727 2147"/>
                        </Shape>
                        <String CONTENT="the paddle penetrate into the middle of the herd, and, placing their canoe"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l27" HPOS="725" VPOS="2165" WIDTH="1771" HEIGHT="67" BASELINE="727 2206 2496 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2206 725 2221 740 2232 742 2232 744 2232 747 2232 2494 2227 2496 2210 2494 2180 2434 2167 2271 2167 2269 2167 2267 2167 2265 2167 2252 2177 2226 2167 2224 2167 2221 2167 2219 2167 2182 2177 2070 2167 2068 2167 1962 2177 1925 2167 1923 2167 1920 2167 1918 2167 1881 2177 1847 2167 1845 2167 1842 2167 1840 2167 1799 2177 1717 2167 1715 2167 1713 2167 1678 2177 1665 2167 1663 2167 1661 2167 1658 2167 1429 2175 1394 2165 1392 2165 1390 2165 1388 2165 1362 2175 1325 2165 1323 2165 1321 2165 1318 2165 1288 2175 1188 2165 1186 2165 1184 2165 1152 2177 903 2177 887 2165 885 2165 883 2165 881 2165 879 2165 853 2175 773 2165 770 2165 727 2173 727 2206"/>
                        </Shape>
                        <String CONTENT="close between two large bucks, spear all the animals within reach, beginning"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l28" HPOS="725" VPOS="2234" WIDTH="1769" HEIGHT="54" BASELINE="727 2266 2494 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2266 725 2279 2490 2288 2494 2271 2492 2238 727 2234 727 2266"/>
                        </Shape>
                        <String CONTENT="with those farthest away; while the nearest, not being disturbed, keep quiet,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l29" HPOS="723" VPOS="2294" WIDTH="1771" HEIGHT="55" BASELINE="725 2325 2494 2329" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="725 2325 723 2340 2490 2349 2494 2329 2492 2299 725 2294 725 2325"/>
                        </Shape>
                        <String CONTENT="and their bodies shield the canoe from the surrounding commotion. Old men,"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l30" HPOS="725" VPOS="2346" WIDTH="1774" HEIGHT="59" BASELINE="727 2390 2499 2383" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2390 727 2405 2496 2398 2499 2383 2494 2355 1360 2346 1357 2346 725 2359 727 2390"/>
                        </Shape>
                        <String CONTENT="women and children, row in boats farther down the river, and intercept the"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l31" HPOS="725" VPOS="2405" WIDTH="1774" HEIGHT="63" BASELINE="727 2450 2499 2446" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2450 727 2468 2496 2459 2499 2446 2494 2418 2245 2405 2243 2405 2191 2416 2163 2405 2161 2405 2159 2405 2096 2416 2031 2405 2029 2405 2027 2405 2024 2405 2009 2418 1881 2418 1784 2405 1782 2405 1780 2405 1734 2416 1680 2405 1678 2405 1583 2418 1526 2407 1524 2407 1197 2418 1078 2407 1076 2407 1017 2418 939 2407 937 2407 935 2407 933 2407 918 2420 725 2420 727 2450"/>
                        </Shape>
                        <String CONTENT="game. All animals, when brought to the shore, are skinned. The fattest"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l32" HPOS="727" VPOS="2474" WIDTH="1772" HEIGHT="59" BASELINE="729 2509 2499 2504" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 2509 729 2522 1139 2533 1141 2533 1143 2533 1145 2533 1162 2522 1184 2533 1186 2533 1188 2533 1256 2522 1598 2530 1600 2530 1747 2520 1864 2530 1866 2530 1868 2530 1871 2530 1884 2520 1938 2530 1940 2530 2029 2520 2111 2530 2113 2530 2165 2520 2237 2530 2239 2530 2241 2530 2243 2530 2260 2520 2369 2530 2371 2530 2373 2530 2399 2520 2460 2530 2462 2530 2464 2530 2499 2517 2499 2504 2494 2476 727 2474 729 2509"/>
                        </Shape>
                        <String CONTENT="bucks are carved, and some of the meat is hung up to dry. All other car-"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l33" HPOS="727" VPOS="2535" WIDTH="1769" HEIGHT="50" BASELINE="727 2567 2496 2567" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2567 727 2585 2496 2585 2496 2567 2494 2535 727 2535 727 2567"/>
                        </Shape>
                        <String CONTENT="casses are simply deposited in storehouses or in temporary hunting-huts, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-176_l34" HPOS="727" VPOS="2585" WIDTH="1772" HEIGHT="58" BASELINE="727 2626 2499 2626" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="727 2626 727 2643 2499 2643 2499 2626 2499 2598 2442 2585 2440 2585 2367 2595 2351 2585 2349 2585 2347 2585 2345 2585 2343 2585 2312 2595 2057 2585 2055 2585 1862 2595 1836 2585 1834 2585 1832 2585 1754 2595 1656 2585 1654 2585 1574 2595 1544 2585 1541 2585 1539 2585 1537 2585 1494 2595 1457 2585 1455 2585 1453 2585 1450 2585 1448 2585 1435 2595 1407 2585 1405 2585 1403 2585 1401 2585 1366 2595 1336 2585 1334 2585 1331 2585 1329 2585 1284 2595 1251 2585 1249 2585 1247 2585 1180 2595 1147 2585 1145 2585 1143 2585 1141 2585 1108 2595 991 2585 989 2585 987 2585 952 2595 922 2585 920 2585 918 2585 727 2595 727 2626"/>
                        </Shape>
                        <String CONTENT="are used chiefly for dog-food in the winter. A score of Chukchee families"/>
                    </TextLine>

