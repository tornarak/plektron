                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-209_l3" HPOS="451" VPOS="777" WIDTH="1773" HEIGHT="61" BASELINE="453 820 2224 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 820 453 838 2222 833 2224 816 2220 786 492 777 490 777 487 777 451 788 453 820"/>
                        </Shape>
                        <String CONTENT="of Sciences at St. Petersburg (Fig. 90, b), has a neck-fender quite similar to"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l4" HPOS="453" VPOS="838" WIDTH="485" HEIGHT="62" BASELINE="453 881 938 881" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 855 453 881 453 900 938 900 938 881 938 851 565 838 563 838 505 848 483 838 481 838 479 838 477 838 457 844 453 855"/>
                        </Shape>
                        <String CONTENT="the Gilyak specimen."/>
                    </TextLine>
<TextLine ID="mz_1-209_l5" HPOS="559" VPOS="898" WIDTH="1665" HEIGHT="56" BASELINE="561 939 2224 935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 939 561 954 2222 954 2224 935 2220 907 576 898 574 898 572 898 570 898 559 905 561 939"/>
                        </Shape>
                        <String CONTENT="Greaves and arm-guards were also used. They were made of hide and"/>
                    </TextLine>
<TextLine ID="mz_1-209_l6" HPOS="446" VPOS="2812" WIDTH="1776" HEIGHT="80" BASELINE="448 2868 2222 2849" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2114 2814 2101 2812 2088 2812 2071 2812 2049 2812 2027 2812 2008 2812 1986 2821 1722 2812 1720 2812 1718 2812 1689 2823 1657 2812 1655 2812 1653 2812 1650 2812 1622 2827 1395 2827 1343 2816 1341 2816 1339 2816 1336 2816 1321 2827 1196 2818 1193 2818 1191 2818 1161 2829 1057 2818 1055 2818 1053 2818 1050 2818 1029 2831 674 2823 672 2823 669 2823 639 2836 490 2825 487 2825 485 2825 446 2838 448 2868 448 2883 838 2892 840 2892 1434 2875 2198 2877 2200 2877 2203 2877 2205 2877 2222 2866 2222 2849 2218 2821 2120 2814 2114 2814"/>
                        </Shape>
                        <String CONTENT="of iron. The expedition obtained two iron arm-guards (Fig. 91, a, b) bought"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l7" HPOS="448" VPOS="2877" WIDTH="1768" HEIGHT="69" BASELINE="451 2927 2216 2912" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2927 451 2942 1202 2946 1204 2946 1206 2946 1235 2935 1551 2942 1553 2942 1711 2931 1871 2940 1873 2940 1967 2929 2211 2938 2216 2912 2211 2883 1455 2877 1453 2877 1183 2890 492 2886 490 2886 487 2886 448 2896 451 2927"/>
                        </Shape>
                        <String CONTENT="with one of the suits of armor, and evidently used with it for protecting"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l8" HPOS="446" VPOS="2931" WIDTH="1774" HEIGHT="74" BASELINE="448 2990 2220 2970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="448 2990 448 3005 2218 2985 2220 2970 2216 2940 1832 2931 1830 2931 1828 2931 1780 2942 1629 2933 1627 2933 1624 2933 1592 2944 1038 2940 1035 2940 1033 2940 1031 2940 1012 2953 446 2955 448 2990"/>
                        </Shape>
                        <String CONTENT="both arms. They are quite Japanese in pattern, with special hand-protectors"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l9" HPOS="448" VPOS="2987" WIDTH="1772" HEIGHT="76" BASELINE="451 3048 2220 3028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3048 451 3063 2218 3044 2220 3028 2218 3000 2185 2987 2183 2987 2181 2987 1627 3005 1494 2994 1492 2994 1419 3007 1265 2996 1263 2996 1261 2996 1239 3007 1094 2998 1092 2998 1089 2998 1038 3011 992 3000 990 3000 988 3000 986 3000 947 3011 877 3000 875 3000 873 3000 871 3000 856 3011 752 3003 749 3003 747 3003 745 3003 730 3016 613 3016 492 3005 490 3005 487 3005 448 3018 451 3048"/>
                        </Shape>
                        <String CONTENT="which were held in place by small loops slung over the thumb and little"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l10" HPOS="448" VPOS="3050" WIDTH="1770" HEIGHT="76" BASELINE="451 3109 2218 3087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3109 451 3126 2216 3104 2218 3087 2213 3059 1891 3050 1889 3050 1886 3050 1858 3061 1343 3057 1341 3057 1339 3057 1336 3057 1323 3067 1170 3059 1167 3059 1089 3070 981 3061 979 3061 925 3072 659 3065 656 3065 654 3065 622 3076 466 3067 464 3067 461 3067 459 3067 448 3074 451 3109"/>
                        </Shape>
                        <String CONTENT="finger. A greave made of thick skin (Fig. 91, d) was obtained with another"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l11" HPOS="448" VPOS="3113" WIDTH="1772" HEIGHT="71" BASELINE="451 3169 2220 3150" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3169 451 3184 2218 3165 2220 3150 2216 3115 1629 3113 1627 3113 1395 3126 1261 3117 1258 3117 1020 3130 843 3122 840 3122 838 3122 836 3122 817 3135 641 3135 503 3126 500 3126 448 3137 451 3169"/>
                        </Shape>
                        <String CONTENT="suit of armor. My informants insisted that usually only the left hand and"/>
                    </TextLine>

                    <TextLine ID="mz_1-209_l12" HPOS="451" VPOS="3184" WIDTH="1020" HEIGHT="59" BASELINE="453 3228 1471 3217" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 3228 453 3243 1468 3234 1471 3217 1466 3189 654 3184 652 3184 650 3184 648 3184 630 3195 468 3187 466 3187 464 3187 461 3187 451 3193 453 3228"/>
                        </Shape>
                        <String CONTENT="the left leg were protected by these guards."/>
                    </TextLine>
<TextLine ID="mz_1-209_l13" HPOS="561" VPOS="3232" WIDTH="1661" HEIGHT="76" BASELINE="563 3284 2222 3271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 3284 563 3299 1111 3308 1113 3308 2222 3286 2222 3271 2218 3243 1997 3232 1995 3232 1891 3245 561 3247 563 3284"/>
                        </Shape>
                        <String CONTENT="The lance was used, together with the armor, as a weapon of defence."/>
                    </TextLine>
