                        </Shape>
                        <String CONTENT="resented by Nelson¹ have their counterparts in Asia."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r3" HPOS="370" VPOS="1217" WIDTH="1778" HEIGHT="358" TAGREFS="TYPE_2">
