                    <TextLine ID="mz_1-261_l5" HPOS="372" VPOS="803" WIDTH="1771" HEIGHT="47" BASELINE="372 833 2143 833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 833 372 850 2143 850 2143 833 2143 803 372 803 372 833"/>
                        </Shape>
