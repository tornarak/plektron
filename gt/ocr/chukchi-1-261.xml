                    <TextLine ID="mz_1-261_l18" HPOS="455" VPOS="1563" WIDTH="1670" HEIGHT="50" BASELINE="457 1595 2125 1591" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1595 457 1613 2122 1613 2125 1591 2120 1563 455 1563 457 1595"/>
                        </Shape>
                        <String CONTENT="INTOXICANTS. — Fly-agaric is the only means of intoxication discovered"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l19" HPOS="351" VPOS="1621" WIDTH="1771" HEIGHT="50" BASELINE="353 1656 2122 1652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1656 353 1671 2120 1669 2122 1652 2118 1623 351 1621 353 1656"/>
                        </Shape>
                        <String CONTENT="by the natives of northeastern Asia. Its use is more common in the Koryak"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l20" HPOS="351" VPOS="1673" WIDTH="1771" HEIGHT="59" BASELINE="353 1717 2122 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1717 353 1732 2120 1729 2122 1712 2118 1684 1237 1673 1235 1673 1120 1684 392 1675 390 1675 388 1675 351 1686 353 1717"/>
                        </Shape>
                        <String CONTENT="tribe, as agaric does not grow outside of the forest border. For the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l21" HPOS="349" VPOS="1732" WIDTH="1771" HEIGHT="62" BASELINE="351 1777 2120 1773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 1777 351 1792 2116 1794 2120 1773 2116 1745 2042 1732 2040 1732 1977 1742 1960 1732 1958 1732 1956 1732 1954 1732 1891 1742 1865 1732 1863 1732 1860 1732 1858 1732 1837 1742 1815 1732 1813 1732 1811 1732 1808 1732 1806 1732 1791 1745 1590 1745 1559 1732 1557 1732 1555 1732 1553 1732 1551 1732 1536 1745 1295 1745 1241 1732 1239 1732 1237 1732 1235 1732 1222 1742 734 1734 732 1734 730 1734 728 1734 715 1745 654 1734 652 1734 650 1734 622 1745 576 1734 574 1734 572 1734 349 1747 351 1777"/>
                        </Shape>
                        <String CONTENT="reason only the Southern Pacific Chukchee — e. g., those around the Anadyr,"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l22" HPOS="351" VPOS="1790" WIDTH="1771" HEIGHT="63" BASELINE="353 1838 2122 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1838 353 1853 2120 1849 2122 1833 2118 1803 1986 1803 1971 1790 1969 1790 1967 1790 1964 1790 1962 1790 1960 1790 1945 1803 1817 1803 1800 1790 1798 1790 1795 1790 1793 1790 1791 1790 1769 1801 1618 1790 1616 1790 1614 1790 1592 1801 1546 1790 1544 1790 1542 1790 1540 1790 1516 1801 1479 1790 1477 1790 1475 1790 1209 1805 973 1805 944 1792 942 1792 940 1792 877 1803 830 1792 827 1792 825 1792 351 1799 353 1838"/>
                        </Shape>
                        <String CONTENT="Big River, and Opuka River — are supplied with the intoxicating mushroom."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l23" HPOS="357" VPOS="1857" WIDTH="1729" HEIGHT="57" BASELINE="357 1894 2086 1894" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1894 357 1914 2086 1914 2086 1894 2086 1866 357 1857 357 1894"/>
                        </Shape>
                        <String CONTENT="They do not compare with the Koryak, however, in their passion for agaric."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r5" HPOS="349" VPOS="1912" WIDTH="1778" HEIGHT="541" TAGREFS="TYPE_2">
