                    <TextLine ID="mz_1-261_l7" HPOS="370" VPOS="917" WIDTH="1771" HEIGHT="50" BASELINE="372 950 2141 954" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 950 370 963 2137 967 2141 954 2139 922 372 917 372 950"/>
                        </Shape>
