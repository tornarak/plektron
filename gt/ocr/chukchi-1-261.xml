                    <TextLine ID="mz_1-261_l10" HPOS="347" VPOS="1073" WIDTH="1775" HEIGHT="70" BASELINE="349 1119 2122 1115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1119 349 1132 1226 1141 1228 1141 1542 1130 1663 1141 1666 1141 1668 1141 1692 1130 1731 1141 1733 1141 1735 1141 1737 1141 1739 1141 1756 1130 1826 1141 1828 1141 1830 1141 1832 1141 1845 1130 1858 1141 1860 1141 1863 1141 1865 1143 1997 1143 1997 1141 1999 1141 2001 1141 2016 1130 2094 1141 2097 1141 2099 1141 2122 1128 2122 1115 2118 1086 1321 1073 1319 1073 1198 1086 1180 1076 1178 1076 1176 1076 1174 1076 1113 1086 1057 1076 1055 1076 957 1089 830 1089 810 1076 808 1076 806 1076 804 1076 801 1076 769 1086 587 1076 585 1076 347 1084 349 1119"/>
