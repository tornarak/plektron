                        <Polygon POINTS="349 1912 2127 1912 2127 2453 349 2453"/>
                    </Shape>
                    <TextLine ID="mz_1-261_l24" HPOS="464" VPOS="1916" WIDTH="1658" HEIGHT="56" BASELINE="464 1952 2122 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 1952 464 1972 2122 1972 2122 1952 2122 1924 464 1916 464 1952"/>
                        </Shape>
                        <String CONTENT="The Russianized natives of the Anadyr until recently shared in the con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l25" HPOS="351" VPOS="1981" WIDTH="1771" HEIGHT="60" BASELINE="353 2013 2122 2017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2013 351 2026 433 2039 435 2039 1187 2030 1245 2041 1248 2041 2120 2030 2122 2017 2120 1985 353 1981 353 2013"/>
                        </Shape>
                        <String CONTENT="sumption of this intoxicant, but now they have almost wholly given up its use."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l26" HPOS="353" VPOS="2037" WIDTH="1767" HEIGHT="56" BASELINE="355 2074 2120 2072" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2074 355 2093 2118 2091 2120 2072 2114 2037 353 2039 355 2074"/>
                        </Shape>
                        <String CONTENT="The reason of this change is that they consider the strong intoxication produced"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l27" HPOS="355" VPOS="2093" WIDTH="1767" HEIGHT="59" BASELINE="355 2137 2122 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2137 355 2152 2120 2152 2122 2137 2122 2106 2073 2093 2071 2093 2068 2093 2066 2093 2040 2104 1962 2093 1960 2093 1958 2093 1928 2104 1863 2093 1860 2093 1858 2093 1811 2104 1694 2093 1692 2093 1689 2093 1657 2104 1559 2093 1557 2093 1494 2104 1382 2093 1256 2093 1254 2093 1252 2093 1250 2093 1232 2106 1131 2106 1115 2093 1113 2093 1111 2093 1109 2093 1107 2093 1081 2104 1055 2093 1053 2093 1050 2093 977 2104 899 2093 897 2093 895 2093 866 2104 355 2098 355 2137"/>
                        </Shape>
                        <String CONTENT="by this stimulant as shameful for a Christian. They also realize that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l28" HPOS="353" VPOS="2162" WIDTH="1769" HEIGHT="50" BASELINE="353 2195 2122 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2195 353 2212 2122 2212 2122 2195 2120 2162 353 2165 353 2195"/>
                        </Shape>
                        <String CONTENT="consumption of fly-agaric involves some danger. With a person unaccustomed"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l29" HPOS="353" VPOS="2221" WIDTH="1769" HEIGHT="52" BASELINE="353 2256 2122 2256" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2256 353 2273 2122 2273 2122 2256 2120 2221 353 2223 353 2256"/>
                        </Shape>
                        <String CONTENT="to its use it may even cause death. The abstinence from agaric is also noticed"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l30" HPOS="353" VPOS="2275" WIDTH="1769" HEIGHT="59" BASELINE="355 2316 2122 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2316 355 2334 2120 2329 2122 2312 2118 2284 550 2275 548 2275 353 2286 355 2316"/>
                        </Shape>
                        <String CONTENT="among the northern Kamchadal, and to some degree among the Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l31" HPOS="353" VPOS="2342" WIDTH="1769" HEIGHT="52" BASELINE="355 2375 2122 2370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2375 355 2394 2120 2390 2122 2370 2118 2342 353 2342 355 2375"/>
                        </Shape>
                        <String CONTENT="Koryak of northern Kamchatka, though all of these people gather it assiduously"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l32" HPOS="355" VPOS="2401" WIDTH="1592" HEIGHT="52" BASELINE="355 2435 1947 2435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2435 355 2453 1945 2453 1947 2435 1945 2405 355 2401 355 2435"/>
                        </Shape>
                        <String CONTENT="in order to trade it to their less civilized reindeer-breeding neighbors."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r6" HPOS="349" VPOS="2453" WIDTH="1778" HEIGHT="483" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="349 2453 2127 2453 2127 2936 349 2936"/>
                    </Shape>
                    <TextLine ID="mz_1-261_l33" HPOS="457" VPOS="2461" WIDTH="1665" HEIGHT="52" BASELINE="457 2496 2122 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 2496 457 2513 2122 2513 2122 2496 2122 2466 457 2461 457 2496"/>
                        </Shape>
                        <String CONTENT="Fortunately for the tribes consuming the fly-agaric, it grows only in cer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l34" HPOS="351" VPOS="2515" WIDTH="1771" HEIGHT="57" BASELINE="353 2557 2122 2550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2557 353 2572 2120 2570 2122 2550 2118 2522 370 2515 368 2515 366 2515 364 2515 351 2522 353 2557"/>
                        </Shape>
                        <String CONTENT="tain places, and the supply is often limited. The mushrooms are usually"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l35" HPOS="353" VPOS="2574" WIDTH="1767" HEIGHT="67" BASELINE="355 2615 2120 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2615 355 2630 823 2641 825 2641 827 2641 830 2641 845 2630 923 2641 925 2641 1031 2630 2118 2630 2120 2611 2116 2583 373 2574 370 2574 368 2574 366 2574 353 2580 355 2615"/>
                        </Shape>
                        <String CONTENT="dried up and strung together in threes, that number being an average dose."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l36" HPOS="355" VPOS="2643" WIDTH="1767" HEIGHT="48" BASELINE="357 2676 2122 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2676 357 2691 2120 2686 2122 2671 2118 2643 355 2643 357 2676"/>
                        </Shape>
                        <String CONTENT="Some of the natives of course require much more to produce any effect. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l37" HPOS="355" VPOS="2699" WIDTH="1767" HEIGHT="52" BASELINE="355 2734 2122 2734" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2734 355 2751 2120 2751 2122 2734 2120 2704 355 2699 355 2734"/>
                        </Shape>
                        <String CONTENT="intoxication may be followed by sickness, or the after-effect may be very slight."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l38" HPOS="357" VPOS="2751" WIDTH="1765" HEIGHT="59" BASELINE="360 2788 2122 2795" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2788 357 2803 2118 2810 2122 2795 2120 2758 360 2751 360 2788"/>
                        </Shape>
                        <String CONTENT="When eaten, the mushrooms are torn to small shreds, and these are chewed"/>
                    </TextLine>

