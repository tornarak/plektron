                    <TextLine ID="mz_1-261_l15" HPOS="351" VPOS="1377" WIDTH="1774" HEIGHT="54" BASELINE="353 1411 2125 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1411 351 1429 2120 1431 2125 1416 2120 1377 353 1377 353 1411"/>
                        </Shape>
                        <String CONTENT="is considered a cure for rheum, weakness of the eyes, and even dulness of"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l16" HPOS="353" VPOS="1435" WIDTH="1772" HEIGHT="59" BASELINE="353 1476 2125 1476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1476 353 1494 2125 1494 2125 1476 2125 1448 1988 1435 1986 1435 1908 1446 1817 1435 1815 1435 1813 1435 1769 1448 1620 1448 1596 1435 1594 1435 1592 1435 1477 1446 1453 1435 1451 1435 1449 1435 1371 1446 1293 1435 1291 1435 1226 1446 1070 1435 1068 1435 1066 1435 1027 1446 862 1435 860 1435 760 1446 708 1435 706 1435 704 1435 669 1446 624 1435 622 1435 620 1435 617 1435 574 1446 353 1442 353 1476"/>
                        </Shape>
                        <String CONTENT="hearing. In the Kolyma region, smoking and chewing are of equal impor-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l17" HPOS="351" VPOS="1494" WIDTH="1302" HEIGHT="64" BASELINE="353 1532 1653 1539" TAGREFS="TYPE_5">
