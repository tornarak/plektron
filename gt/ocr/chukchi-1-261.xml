                            <Polygon POINTS="457 1238 457 1253 2122 1253 2125 1238 2122 1208 457 1203 457 1238"/>
                        </Shape>
                        <String CONTENT="I have met men and women who used tobacco in all three ways at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l13" HPOS="349" VPOS="1255" WIDTH="1776" HEIGHT="59" BASELINE="349 1299 2125 1299" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1299 349 1314 2125 1314 2125 1299 2125 1268 2073 1255 2071 1255 2068 1255 2042 1266 1579 1255 1577 1255 1575 1255 1540 1266 1510 1255 1507 1255 1505 1255 1403 1266 1365 1255 1362 1255 1360 1255 1278 1266 1189 1255 1187 1255 1066 1266 882 1255 879 1255 877 1255 836 1266 669 1255 667 1255 572 1266 516 1255 513 1255 511 1255 509 1255 494 1268 349 1268 349 1299"/>
                        </Shape>
                        <String CONTENT="same time. Usually, however, snuff is only used when smoking cannot be"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l14" HPOS="349" VPOS="1316" WIDTH="1776" HEIGHT="56" BASELINE="351 1357 2125 1353" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 1357 351 1372 2122 1368 2125 1353 2118 1316 349 1316 351 1357"/>
                        </Shape>
                        <String CONTENT="continued because it causes a cough, or for some other reason. Taking snuff"/>
