                    </Shape>
                    <TextLine ID="mz_1-261_l12" HPOS="478" VPOS="1218" WIDTH="1668" HEIGHT="50" BASELINE="478 1253 2146 1253" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="478 1253 478 1268 2143 1268 2146 1253 2143 1223 478 1218 478 1253"/>
                        </Shape>
                        <String CONTENT="I have met men and women who used tobacco in all three ways at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l13" HPOS="370" VPOS="1270" WIDTH="1776" HEIGHT="59" BASELINE="370 1314 2146 1314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1314 370 1329 2146 1329 2146 1314 2146 1283 2094 1270 2092 1270 2089 1270 2063 1281 1600 1270 1598 1270 1596 1270 1561 1281 1531 1270 1528 1270 1526 1270 1424 1281 1386 1270 1383 1270 1381 1270 1299 1281 1210 1270 1208 1270 1087 1281 903 1270 900 1270 898 1270 857 1281 690 1270 688 1270 593 1281 537 1270 534 1270 532 1270 530 1270 515 1283 370 1283 370 1314"/>
                        </Shape>
                        <String CONTENT="same time. Usually, however, snuff is only used when smoking cannot be"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l14" HPOS="370" VPOS="1331" WIDTH="1776" HEIGHT="56" BASELINE="372 1372 2146 1368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1372 372 1387 2143 1383 2146 1368 2139 1331 370 1331 372 1372"/>
                        </Shape>
                        <String CONTENT="continued because it causes a cough, or for some other reason. Taking snuff"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l15" HPOS="372" VPOS="1392" WIDTH="1774" HEIGHT="54" BASELINE="374 1426 2146 1431" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1426 372 1444 2141 1446 2146 1431 2141 1392 374 1392 374 1426"/>
                        </Shape>
                        <String CONTENT="is considered a cure for rheum, weakness of the eyes, and even dulness of"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l16" HPOS="374" VPOS="1450" WIDTH="1772" HEIGHT="59" BASELINE="374 1491 2146 1491" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1491 374 1509 2146 1509 2146 1491 2146 1463 2009 1450 2007 1450 1929 1461 1838 1450 1836 1450 1834 1450 1790 1463 1641 1463 1617 1450 1615 1450 1613 1450 1498 1461 1474 1450 1472 1450 1470 1450 1392 1461 1314 1450 1312 1450 1247 1461 1091 1450 1089 1450 1087 1450 1048 1461 883 1450 881 1450 781 1461 729 1450 727 1450 725 1450 690 1461 645 1450 643 1450 641 1450 638 1450 595 1461 374 1457 374 1491"/>
                        </Shape>
                        <String CONTENT="hearing. In the Kolyma region, smoking and chewing are of equal impor-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l17" HPOS="372" VPOS="1509" WIDTH="1302" HEIGHT="64" BASELINE="374 1547 1674 1554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1547 372 1565 383 1573 385 1573 387 1573 389 1573 1671 1567 1674 1554 1671 1524 1182 1511 1180 1511 853 1519 809 1509 807 1509 805 1509 374 1515 374 1547"/>
                        </Shape>
                        <String CONTENT="tance, but on the Pacific chewing is much more general."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r4" HPOS="370" VPOS="1575" WIDTH="1778" HEIGHT="352" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 1575 2148 1575 2148 1927 370 1927"/>
                    </Shape>
                    <TextLine ID="mz_1-261_l18" HPOS="476" VPOS="1578" WIDTH="1670" HEIGHT="50" BASELINE="478 1610 2146 1606" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="478 1610 478 1628 2143 1628 2146 1606 2141 1578 476 1578 478 1610"/>
                        </Shape>
                        <String CONTENT="INTOXICANTS. — Fly-agaric is the only means of intoxication discovered"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l19" HPOS="372" VPOS="1636" WIDTH="1771" HEIGHT="50" BASELINE="374 1671 2143 1667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1671 374 1686 2141 1684 2143 1667 2139 1638 372 1636 374 1671"/>
                        </Shape>
                        <String CONTENT="by the natives of northeastern Asia. Its use is more common in the Koryak"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l20" HPOS="372" VPOS="1688" WIDTH="1771" HEIGHT="59" BASELINE="374 1732 2143 1727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1732 374 1747 2141 1744 2143 1727 2139 1699 1258 1688 1256 1688 1141 1699 413 1690 411 1690 409 1690 372 1701 374 1732"/>
                        </Shape>
                        <String CONTENT="tribe, as agaric does not grow outside of the forest border. For the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l21" HPOS="370" VPOS="1747" WIDTH="1771" HEIGHT="62" BASELINE="372 1792 2141 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1792 372 1807 2137 1809 2141 1788 2137 1760 2063 1747 2061 1747 1998 1757 1981 1747 1979 1747 1977 1747 1975 1747 1912 1757 1886 1747 1884 1747 1881 1747 1879 1747 1858 1757 1836 1747 1834 1747 1832 1747 1829 1747 1827 1747 1812 1760 1611 1760 1580 1747 1578 1747 1576 1747 1574 1747 1572 1747 1557 1760 1316 1760 1262 1747 1260 1747 1258 1747 1256 1747 1243 1757 755 1749 753 1749 751 1749 749 1749 736 1760 675 1749 673 1749 671 1749 643 1760 597 1749 595 1749 593 1749 370 1762 372 1792"/>
                        </Shape>
                        <String CONTENT="reason only the Southern Pacific Chukchee — e. g., those around the Anadyr,"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l22" HPOS="372" VPOS="1805" WIDTH="1771" HEIGHT="63" BASELINE="374 1853 2143 1848" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 1853 374 1868 2141 1864 2143 1848 2139 1818 2007 1818 1992 1805 1990 1805 1988 1805 1985 1805 1983 1805 1981 1805 1966 1818 1838 1818 1821 1805 1819 1805 1816 1805 1814 1805 1812 1805 1790 1816 1639 1805 1637 1805 1635 1805 1613 1816 1567 1805 1565 1805 1563 1805 1561 1805 1537 1816 1500 1805 1498 1805 1496 1805 1230 1820 994 1820 965 1807 963 1807 961 1807 898 1818 851 1807 848 1807 846 1807 372 1814 374 1853"/>
                        </Shape>
                        <String CONTENT="Big River, and Opuka River — are supplied with the intoxicating mushroom."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l23" HPOS="378" VPOS="1872" WIDTH="1729" HEIGHT="57" BASELINE="378 1909 2107 1909" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1909 378 1929 2107 1929 2107 1909 2107 1881 378 1872 378 1909"/>
                        </Shape>
                        <String CONTENT="They do not compare with the Koryak, however, in their passion for agaric."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r5" HPOS="370" VPOS="1927" WIDTH="1778" HEIGHT="541" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 1927 2148 1927 2148 2468 370 2468"/>
                    </Shape>
                    <TextLine ID="mz_1-261_l24" HPOS="485" VPOS="1931" WIDTH="1658" HEIGHT="56" BASELINE="485 1967 2143 1967" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="485 1967 485 1987 2143 1987 2143 1967 2143 1939 485 1931 485 1967"/>
                        </Shape>
                        <String CONTENT="The Russianized natives of the Anadyr until recently shared in the con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l25" HPOS="372" VPOS="1996" WIDTH="1771" HEIGHT="60" BASELINE="374 2028 2143 2032" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2028 372 2041 454 2054 456 2054 1208 2045 1266 2056 1269 2056 2141 2045 2143 2032 2141 2000 374 1996 374 2028"/>
                        </Shape>
                        <String CONTENT="sumption of this intoxicant, but now they have almost wholly given up its use."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l26" HPOS="374" VPOS="2052" WIDTH="1767" HEIGHT="56" BASELINE="376 2089 2141 2087" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2089 376 2108 2139 2106 2141 2087 2135 2052 374 2054 376 2089"/>
                        </Shape>
                        <String CONTENT="The reason of this change is that they consider the strong intoxication produced"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l27" HPOS="376" VPOS="2108" WIDTH="1767" HEIGHT="59" BASELINE="376 2152 2143 2152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2152 376 2167 2141 2167 2143 2152 2143 2121 2094 2108 2092 2108 2089 2108 2087 2108 2061 2119 1983 2108 1981 2108 1979 2108 1949 2119 1884 2108 1881 2108 1879 2108 1832 2119 1715 2108 1713 2108 1710 2108 1678 2119 1580 2108 1578 2108 1515 2119 1403 2108 1277 2108 1275 2108 1273 2108 1271 2108 1253 2121 1152 2121 1136 2108 1134 2108 1132 2108 1130 2108 1128 2108 1102 2119 1076 2108 1074 2108 1071 2108 998 2119 920 2108 918 2108 916 2108 887 2119 376 2113 376 2152"/>
                        </Shape>
                        <String CONTENT="by this stimulant as shameful for a Christian. They also realize that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l28" HPOS="374" VPOS="2177" WIDTH="1769" HEIGHT="50" BASELINE="374 2210 2143 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2210 374 2227 2143 2227 2143 2210 2141 2177 374 2180 374 2210"/>
                        </Shape>
                        <String CONTENT="consumption of fly-agaric involves some danger. With a person unaccustomed"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l29" HPOS="374" VPOS="2236" WIDTH="1769" HEIGHT="52" BASELINE="374 2271 2143 2271" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2271 374 2288 2143 2288 2143 2271 2141 2236 374 2238 374 2271"/>
                        </Shape>
                        <String CONTENT="to its use it may even cause death. The abstinence from agaric is also noticed"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l30" HPOS="374" VPOS="2290" WIDTH="1769" HEIGHT="59" BASELINE="376 2331 2143 2327" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2331 376 2349 2141 2344 2143 2327 2139 2299 571 2290 569 2290 374 2301 376 2331"/>
                        </Shape>
                        <String CONTENT="among the northern Kamchadal, and to some degree among the Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l31" HPOS="374" VPOS="2357" WIDTH="1769" HEIGHT="52" BASELINE="376 2390 2143 2385" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2390 376 2409 2141 2405 2143 2385 2139 2357 374 2357 376 2390"/>
                        </Shape>
                        <String CONTENT="Koryak of northern Kamchatka, though all of these people gather it assiduously"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l32" HPOS="376" VPOS="2416" WIDTH="1592" HEIGHT="52" BASELINE="376 2450 1968 2450" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2450 376 2468 1966 2468 1968 2450 1966 2420 376 2416 376 2450"/>
                        </Shape>
                        <String CONTENT="in order to trade it to their less civilized reindeer-breeding neighbors."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-261_r6" HPOS="370" VPOS="2468" WIDTH="1778" HEIGHT="483" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 2468 2148 2468 2148 2951 370 2951"/>
                    </Shape>
                    <TextLine ID="mz_1-261_l33" HPOS="478" VPOS="2476" WIDTH="1665" HEIGHT="52" BASELINE="478 2511 2143 2511" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="478 2511 478 2528 2143 2528 2143 2511 2143 2481 478 2476 478 2511"/>
                        </Shape>
                        <String CONTENT="Fortunately for the tribes consuming the fly-agaric, it grows only in cer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l34" HPOS="372" VPOS="2530" WIDTH="1771" HEIGHT="57" BASELINE="374 2572 2143 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2572 374 2587 2141 2585 2143 2565 2139 2537 391 2530 389 2530 387 2530 385 2530 372 2537 374 2572"/>
                        </Shape>
                        <String CONTENT="tain places, and the supply is often limited. The mushrooms are usually"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l35" HPOS="374" VPOS="2589" WIDTH="1767" HEIGHT="67" BASELINE="376 2630 2141 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2630 376 2645 844 2656 846 2656 848 2656 851 2656 866 2645 944 2656 946 2656 1052 2645 2139 2645 2141 2626 2137 2598 394 2589 391 2589 389 2589 387 2589 374 2595 376 2630"/>
                        </Shape>
                        <String CONTENT="dried up and strung together in threes, that number being an average dose."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l36" HPOS="376" VPOS="2658" WIDTH="1767" HEIGHT="48" BASELINE="378 2691 2143 2686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 2691 378 2706 2141 2701 2143 2686 2139 2658 376 2658 378 2691"/>
                        </Shape>
                        <String CONTENT="Some of the natives of course require much more to produce any effect. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l37" HPOS="376" VPOS="2714" WIDTH="1767" HEIGHT="52" BASELINE="376 2749 2143 2749" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2749 376 2766 2141 2766 2143 2749 2141 2719 376 2714 376 2749"/>
                        </Shape>
                        <String CONTENT="intoxication may be followed by sickness, or the after-effect may be very slight."/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l38" HPOS="378" VPOS="2766" WIDTH="1765" HEIGHT="59" BASELINE="381 2803 2143 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2803 378 2818 2139 2825 2143 2810 2141 2773 381 2766 381 2803"/>
                        </Shape>
                        <String CONTENT="When eaten, the mushrooms are torn to small shreds, and these are chewed"/>
                    </TextLine>

