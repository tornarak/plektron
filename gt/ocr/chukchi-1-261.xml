                    </TextLine>

                    <TextLine ID="mz_1-261_l9" HPOS="372" VPOS="1041" WIDTH="1774" HEIGHT="50" BASELINE="372 1073 2146 1073" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1073 372 1091 2146 1091 2146 1073 2143 1041 372 1041 372 1073"/>
                        </Shape>
                        <String CONTENT="of the Kolyma, make snuff-boxes of the same styles, using wood, antler, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l10" HPOS="368" VPOS="1088" WIDTH="1775" HEIGHT="70" BASELINE="370 1134 2143 1130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1134 370 1147 1247 1156 1249 1156 1563 1145 1684 1156 1687 1156 1689 1156 1713 1145 1752 1156 1754 1156 1756 1156 1758 1156 1760 1156 1777 1145 1847 1156 1849 1156 1851 1156 1853 1156 1866 1145 1879 1156 1881 1156 1884 1156 1886 1158 2018 1158 2018 1156 2020 1156 2022 1156 2037 1145 2115 1156 2118 1156 2120 1156 2143 1143 2143 1130 2139 1101 1342 1088 1340 1088 1219 1101 1201 1091 1199 1091 1197 1091 1195 1091 1134 1101 1078 1091 1076 1091 978 1104 851 1104 831 1091 829 1091 827 1091 825 1091 822 1091 790 1101 608 1091 606 1091 368 1099 370 1134"/>
                        </Shape>
                        <String CONTENT="ivory. The same is true of the Alaskan Eskimo. Many of the shapes rep-"/>
                    </TextLine>

                    <TextLine ID="mz_1-261_l11" HPOS="370" VPOS="1149" WIDTH="1223" HEIGHT="59" BASELINE="372 1192 1593 1188" TAGREFS="TYPE_5">
