                        </Shape>
                        <String CONTENT="The Chukchee are well built and healthy, though rather heavy; so that"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l9" HPOS="366" VPOS="1422" WIDTH="1774" HEIGHT="59" BASELINE="368 1465 2140 1461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1465 368 1481 2138 1476 2140 1461 2135 1433 1254 1422 1252 1422 1250 1422 1248 1422 1232 1433 388 1424 386 1424 383 1424 381 1424 366 1431 368 1465"/>
                        </Shape>
                        <String CONTENT="the saddle-reindeer bought from the Lamut frequently prove too weak for"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l10" HPOS="368" VPOS="1481" WIDTH="1774" HEIGHT="60" BASELINE="370 1526 2142 1522" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1526 370 1541 2140 1537 2142 1522 2138 1494 1988 1481 1986 1481 1984 1481 1947 1491 1919 1481 1917 1481 1915 1481 1912 1481 1910 1481 1893 1494 1681 1494 1609 1481 1607 1481 1555 1491 1442 1481 1440 1481 1304 1491 1258 1481 1256 1481 1254 1481 1252 1481 1250 1481 1235 1494 1222 1483 1219 1483 1217 1483 1126 1483 1124 1483 1122 1483 1120 1483 1105 1494 834 1483 832 1483 830 1483 827 1483 812 1496 479 1496 390 1483 388 1483 386 1483 383 1483 368 1491 370 1526"/>
                        </Shape>
                        <String CONTENT="their new masters. Nor are the Chukchee as nimble of foot as are the Lamut"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l11" HPOS="366" VPOS="1552" WIDTH="1774" HEIGHT="50" BASELINE="368 1587 2140 1580" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1587 368 1602 2138 1595 2140 1580 2135 1552 366 1552 368 1587"/>
                        </Shape>
                        <String CONTENT="hunters. Stout people, however, are rare. I met only one who was rather"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l12" HPOS="366" VPOS="1602" WIDTH="1772" HEIGHT="63" BASELINE="368 1643 2138 1647" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1643 366 1665 2135 1660 2138 1647 2135 1617 2049 1604 2047 1604 2045 1604 2008 1615 1993 1604 1990 1604 1988 1604 1692 1604 1689 1604 1633 1615 1481 1604 1479 1604 1423 1615 1367 1604 1365 1604 1362 1604 1339 1615 1245 1602 1243 1602 1144 1613 1074 1602 1072 1602 1070 1602 1038 1615 830 1615 810 1602 808 1602 806 1602 804 1602 745 1615 646 1615 630 1602 628 1602 626 1602 624 1602 622 1602 598 1615 496 1615 481 1602 479 1602 477 1602 474 1602 368 1610 368 1643"/>
                        </Shape>
                        <String CONTENT="portly, and on this account he received the nickname Um-Kutuˊwg̣i; i. e.,"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l13" HPOS="377" VPOS="1662" WIDTH="394" HEIGHT="70" BASELINE="379 1699 771 1704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1699 377 1717 407 1729 409 1729 412 1729 537 1719 723 1732 726 1732 728 1732 769 1719 771 1704 767 1662 379 1667 379 1699"/>
                        </Shape>
                        <String CONTENT="“Stout Kutuˊwg̣i.”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-055_r4" HPOS="370" VPOS="1736" WIDTH="1778" HEIGHT="942" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 1736 2148 1736 2148 2678 370 2678"/>
                    </Shape>
                    <TextLine ID="mz_1-055_l14" HPOS="477" VPOS="1717" WIDTH="1663" HEIGHT="67" BASELINE="479 1768 2140 1760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 1768 479 1784 2138 1775 2140 1760 2138 1732 2086 1717 2084 1717 2081 1717 2079 1717 2027 1729 1967 1717 1964 1717 1962 1717 1919 1732 1724 1732 1700 1719 1698 1719 1696 1719 1633 1732 1579 1719 1577 1719 1575 1719 1572 1719 1538 1732 1505 1719 1503 1719 1501 1719 1499 1719 1473 1732 1458 1719 1455 1719 1453 1719 1451 1719 1339 1732 1310 1719 1308 1719 1306 1719 1304 1719 1258 1734 1241 1721 1239 1721 1237 1721 1235 1721 1232 1721 1185 1734 1141 1721 1139 1721 1137 1721 1059 1734 921 1734 905 1721 903 1721 901 1721 899 1721 897 1721 869 1736 847 1723 845 1723 843 1723 840 1723 762 1736 708 1723 706 1723 607 1723 604 1723 602 1723 600 1723 585 1736 539 1723 537 1723 535 1723 477 1727 479 1768"/>
                        </Shape>
                        <String CONTENT="The hands and feet, as with all tribes of Arctic Asia, are small. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l15" HPOS="368" VPOS="1784" WIDTH="1767" HEIGHT="67" BASELINE="370 1827 2135 1823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1827 370 1851 2133 1838 2135 1823 2131 1794 1332 1784 1330 1784 1222 1794 689 1786 687 1786 368 1797 370 1827"/>
                        </Shape>
                        <String CONTENT="young men of the Reindeer division sweat copiously upon slight exertion, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l16" HPOS="368" VPOS="1840" WIDTH="1774" HEIGHT="65" BASELINE="370 1888 2142 1881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1888 370 1905 2140 1898 2142 1881 2138 1853 2055 1840 2053 1840 2051 1840 2029 1851 1941 1840 1938 1840 1936 1840 1899 1851 1878 1840 1876 1840 1873 1840 1871 1840 1869 1840 1852 1853 1657 1853 1598 1840 1596 1840 1536 1853 1492 1842 1490 1842 1488 1842 1323 1853 1297 1842 1295 1842 1293 1842 1291 1842 1256 1853 1211 1842 1209 1842 1206 1842 1204 1842 1202 1842 1189 1853 1137 1842 1135 1842 1133 1842 1102 1853 1003 1842 1001 1842 931 1855 908 1844 905 1844 903 1844 633 1855 386 1844 383 1844 381 1844 379 1844 368 1853 370 1888"/>
                        </Shape>
                        <String CONTENT="for instance, while running about the herd, — and on this account the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l17" HPOS="368" VPOS="1898" WIDTH="1767" HEIGHT="67" BASELINE="370 1948 2135 1942" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1948 370 1965 2133 1959 2135 1942 2131 1911 2038 1898 2036 1898 2034 1898 2032 1898 2016 1909 1990 1898 1988 1898 1986 1898 1984 1898 1982 1898 1967 1909 1880 1898 1878 1898 1876 1898 1873 1898 1854 1909 1514 1901 1512 1901 1510 1901 1507 1901 1490 1911 957 1901 955 1901 953 1901 951 1901 934 1914 856 1903 853 1903 851 1903 819 1914 652 1903 650 1903 589 1914 388 1903 386 1903 383 1903 381 1903 368 1911 370 1948"/>
                        </Shape>
                        <String CONTENT="Chukchee call themselves, half facetiously, “the sweating-people” (g̣ɪʟ̣oˊta-raˊmkɪn)."/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l18" HPOS="370" VPOS="1963" WIDTH="1772" HEIGHT="59" BASELINE="373 2007 2142 2000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2007 373 2022 2140 2015 2142 2000 2135 1963 370 1970 373 2007"/>
                        </Shape>
                        <String CONTENT="Many of the women are clumsily shaped, with short waists, and legs out of"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l19" HPOS="368" VPOS="2020" WIDTH="1774" HEIGHT="69" BASELINE="370 2069 2142 2061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2069 370 2089 1930 2076 2103 2085 2105 2085 2107 2085 2142 2072 2142 2061 2138 2030 1722 2020 1720 2020 1659 2030 1289 2022 1287 2022 1284 2022 1250 2033 923 2024 921 2024 368 2037 370 2069"/>
                        </Shape>
                        <String CONTENT="proportion to the rest of their bodies. Some of the Chukchee have consider-"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l20" HPOS="368" VPOS="2085" WIDTH="1772" HEIGHT="58" BASELINE="370 2126 2140 2121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2126 370 2143 2138 2139 2140 2121 2135 2093 399 2085 396 2085 394 2085 368 2093 370 2126"/>
                        </Shape>
                        <String CONTENT="able physical strength, especially the reindeer-breeders, who have a superior"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l21" HPOS="368" VPOS="2145" WIDTH="1770" HEIGHT="54" BASELINE="370 2184 2138 2180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2184 370 2199 2135 2195 2138 2180 2133 2154 388 2145 386 2145 383 2145 381 2145 368 2152 370 2184"/>
                        </Shape>
                        <String CONTENT="diet. I saw men who were able to carry a whole reindeer-carcass on their"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l22" HPOS="370" VPOS="2210" WIDTH="1770" HEIGHT="54" BASELINE="373 2247 2140 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2247 373 2264 2138 2258 2140 2240 2135 2212 370 2210 373 2247"/>
                        </Shape>
                        <String CONTENT="backs for a quarter of a mile, or lift a great stone about two hundred pounds"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l23" HPOS="368" VPOS="2273" WIDTH="1772" HEIGHT="50" BASELINE="370 2308 2140 2301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2308 370 2323 2138 2316 2140 2301 2135 2273 368 2273 370 2308"/>
                        </Shape>
                        <String CONTENT="in weight. The younger Chukchee are continually bent on increasing their"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l24" HPOS="368" VPOS="2325" WIDTH="1772" HEIGHT="65" BASELINE="370 2368 2140 2364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2368 370 2390 2138 2381 2140 2364 2135 2334 399 2325 396 2325 394 2325 368 2334 370 2368"/>
                        </Shape>
                        <String CONTENT="physical powers by lifting and carrying stones, by running foot-races for long"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l25" HPOS="366" VPOS="2383" WIDTH="1774" HEIGHT="59" BASELINE="368 2427 2140 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2427 368 2442 2138 2437 2140 2422 2135 2390 388 2383 386 2383 383 2383 381 2383 366 2390 368 2427"/>
                        </Shape>
                        <String CONTENT="distances, etc. The Maritime Chukchee and the Eskimo even have special"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l26" HPOS="366" VPOS="2453" WIDTH="1772" HEIGHT="52" BASELINE="368 2487 2138 2483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2487 368 2505 2135 2505 2138 2483 2133 2453 366 2453 368 2487"/>
                        </Shape>
                        <String CONTENT="lifting-stones for each man. These are picked up among the crumbling rocks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l27" HPOS="366" VPOS="2502" WIDTH="1774" HEIGHT="61" BASELINE="368 2548 2140 2541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2548 368 2563 2138 2557 2140 2541 2135 2511 962 2502 960 2502 903 2513 440 2505 438 2505 366 2515 368 2548"/>
                        </Shape>
                        <String CONTENT="and are usually cylindrical in shape, with smooth surfaces. One of my European"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l28" HPOS="368" VPOS="2561" WIDTH="1770" HEIGHT="60" BASELINE="370 2606 2138 2600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2606 370 2621 2135 2615 2138 2600 2133 2572 1549 2561 1546 2561 1492 2572 1122 2563 1120 2563 953 2574 381 2565 379 2565 377 2565 375 2565 375 2567 368 2572 370 2606"/>
                        </Shape>
                        <String CONTENT="fellow-travellers, however, was able to surpass all the men of the villages"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l29" HPOS="370" VPOS="2619" WIDTH="1542" HEIGHT="63" BASELINE="373 2667 1912 2663" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2667 373 2682 1910 2678 1912 2663 1908 2632 1683 2632 1659 2619 1657 2619 1655 2619 1653 2619 1607 2630 1553 2619 1551 2619 1549 2619 1527 2630 1464 2619 1462 2619 1460 2619 1434 2630 1347 2619 1345 2619 1343 2619 1319 2630 1265 2619 1263 2619 1180 2630 1096 2621 1094 2621 1092 2621 1089 2621 1079 2632 1059 2621 1057 2621 1055 2621 981 2632 843 2621 840 2621 838 2621 797 2632 754 2621 752 2621 749 2621 747 2621 715 2632 697 2621 695 2621 693 2621 691 2621 689 2621 646 2632 630 2621 628 2621 626 2621 624 2621 370 2628 373 2667"/>
                        </Shape>
                        <String CONTENT="between Mariinsky Post and Indian Point in a hand-pulling contest."/>
                    </TextLine>
</TextBlock>
