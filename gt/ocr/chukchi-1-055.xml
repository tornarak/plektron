                    <TextLine ID="mz_1-055_l8" HPOS="495" VPOS="1374" WIDTH="1668" HEIGHT="63" BASELINE="498 1422 2163 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="498 1422 498 1437 2161 1433 2163 1418 2159 1387 2079 1374 2076 1374 2074 1374 2072 1374 2055 1387 1847 1387 1823 1374 1821 1374 1819 1374 1754 1385 1726 1374 1723 1374 1721 1374 1641 1385 1615 1374 1613 1374 1611 1374 1533 1385 1507 1374 1505 1374 1502 1374 1435 1385 1368 1374 1366 1374 1364 1374 1325 1387 1310 1376 1308 1376 1305 1376 1303 1376 1236 1387 1147 1376 1145 1376 1143 1376 1104 1387 1082 1376 1080 1376 1078 1376 994 1389 796 1389 781 1376 779 1376 777 1376 775 1376 495 1385 498 1422"/>
                        </Shape>
                        <String CONTENT="The Chukchee are well built and healthy, though rather heavy; so that"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l9" HPOS="387" VPOS="1437" WIDTH="1774" HEIGHT="59" BASELINE="389 1480 2161 1476" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 1480 389 1496 2159 1491 2161 1476 2156 1448 1275 1437 1273 1437 1271 1437 1269 1437 1253 1448 409 1439 407 1439 404 1439 402 1439 387 1446 389 1480"/>
                        </Shape>
                        <String CONTENT="the saddle-reindeer bought from the Lamut frequently prove too weak for"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l10" HPOS="389" VPOS="1496" WIDTH="1774" HEIGHT="60" BASELINE="391 1541 2163 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 1541 391 1556 2161 1552 2163 1537 2159 1509 2009 1496 2007 1496 2005 1496 1968 1506 1940 1496 1938 1496 1936 1496 1933 1496 1931 1496 1914 1509 1702 1509 1630 1496 1628 1496 1576 1506 1463 1496 1461 1496 1325 1506 1279 1496 1277 1496 1275 1496 1273 1496 1271 1496 1256 1509 1243 1498 1240 1498 1238 1498 1147 1498 1145 1498 1143 1498 1141 1498 1126 1509 855 1498 853 1498 851 1498 848 1498 833 1511 500 1511 411 1498 409 1498 407 1498 404 1498 389 1506 391 1541"/>
                        </Shape>
                        <String CONTENT="their new masters. Nor are the Chukchee as nimble of foot as are the Lamut"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l11" HPOS="387" VPOS="1567" WIDTH="1774" HEIGHT="50" BASELINE="389 1602 2161 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 1602 389 1617 2159 1610 2161 1595 2156 1567 387 1567 389 1602"/>
                        </Shape>
                        <String CONTENT="hunters. Stout people, however, are rare. I met only one who was rather"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l12" HPOS="387" VPOS="1617" WIDTH="1772" HEIGHT="63" BASELINE="389 1658 2159 1662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 1658 387 1680 2156 1675 2159 1662 2156 1632 2070 1619 2068 1619 2066 1619 2029 1630 2014 1619 2011 1619 2009 1619 1713 1619 1710 1619 1654 1630 1502 1619 1500 1619 1444 1630 1388 1619 1386 1619 1383 1619 1360 1630 1266 1617 1264 1617 1165 1628 1095 1617 1093 1617 1091 1617 1059 1630 851 1630 831 1617 829 1617 827 1617 825 1617 766 1630 667 1630 651 1617 649 1617 647 1617 645 1617 643 1617 619 1630 517 1630 502 1617 500 1617 498 1617 495 1617 389 1625 389 1658"/>
                        </Shape>
                        <String CONTENT="portly, and on this account he received the nickname Um-Kutuˊwg̣i; i. e.,"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l13" HPOS="398" VPOS="1677" WIDTH="394" HEIGHT="70" BASELINE="400 1714 792 1719" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="400 1714 398 1732 428 1744 430 1744 433 1744 558 1734 744 1747 747 1747 749 1747 790 1734 792 1719 788 1677 400 1682 400 1714"/>
                        </Shape>
                        <String CONTENT="“Stout Kutuˊwg̣i.”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-055_r4" HPOS="391" VPOS="1751" WIDTH="1778" HEIGHT="942" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="391 1751 2169 1751 2169 2693 391 2693"/>
                    </Shape>
                    <TextLine ID="mz_1-055_l14" HPOS="498" VPOS="1732" WIDTH="1663" HEIGHT="67" BASELINE="500 1783 2161 1775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 1783 500 1799 2159 1790 2161 1775 2159 1747 2107 1732 2105 1732 2102 1732 2100 1732 2048 1744 1988 1732 1985 1732 1983 1732 1940 1747 1745 1747 1721 1734 1719 1734 1717 1734 1654 1747 1600 1734 1598 1734 1596 1734 1593 1734 1559 1747 1526 1734 1524 1734 1522 1734 1520 1734 1494 1747 1479 1734 1476 1734 1474 1734 1472 1734 1360 1747 1331 1734 1329 1734 1327 1734 1325 1734 1279 1749 1262 1736 1260 1736 1258 1736 1256 1736 1253 1736 1206 1749 1162 1736 1160 1736 1158 1736 1080 1749 942 1749 926 1736 924 1736 922 1736 920 1736 918 1736 890 1751 868 1738 866 1738 864 1738 861 1738 783 1751 729 1738 727 1738 628 1738 625 1738 623 1738 621 1738 606 1751 560 1738 558 1738 556 1738 498 1742 500 1783"/>
                        </Shape>
                        <String CONTENT="The hands and feet, as with all tribes of Arctic Asia, are small. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l15" HPOS="389" VPOS="1799" WIDTH="1767" HEIGHT="67" BASELINE="391 1842 2156 1838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 1842 391 1866 2154 1853 2156 1838 2152 1809 1353 1799 1351 1799 1243 1809 710 1801 708 1801 389 1812 391 1842"/>
                        </Shape>
                        <String CONTENT="young men of the Reindeer division sweat copiously upon slight exertion, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l16" HPOS="389" VPOS="1855" WIDTH="1774" HEIGHT="65" BASELINE="391 1903 2163 1896" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 1903 391 1920 2161 1913 2163 1896 2159 1868 2076 1855 2074 1855 2072 1855 2050 1866 1962 1855 1959 1855 1957 1855 1920 1866 1899 1855 1897 1855 1894 1855 1892 1855 1890 1855 1873 1868 1678 1868 1619 1855 1617 1855 1557 1868 1513 1857 1511 1857 1509 1857 1344 1868 1318 1857 1316 1857 1314 1857 1312 1857 1277 1868 1232 1857 1230 1857 1227 1857 1225 1857 1223 1857 1210 1868 1158 1857 1156 1857 1154 1857 1123 1868 1024 1857 1022 1857 952 1870 929 1859 926 1859 924 1859 654 1870 407 1859 404 1859 402 1859 400 1859 389 1868 391 1903"/>
                        </Shape>
                        <String CONTENT="for instance, while running about the herd, — and on this account the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l17" HPOS="389" VPOS="1913" WIDTH="1767" HEIGHT="67" BASELINE="391 1963 2156 1957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 1963 391 1980 2154 1974 2156 1957 2152 1926 2059 1913 2057 1913 2055 1913 2053 1913 2037 1924 2011 1913 2009 1913 2007 1913 2005 1913 2003 1913 1988 1924 1901 1913 1899 1913 1897 1913 1894 1913 1875 1924 1535 1916 1533 1916 1531 1916 1528 1916 1511 1926 978 1916 976 1916 974 1916 972 1916 955 1929 877 1918 874 1918 872 1918 840 1929 673 1918 671 1918 610 1929 409 1918 407 1918 404 1918 402 1918 389 1926 391 1963"/>
                        </Shape>
                        <String CONTENT="Chukchee call themselves, half facetiously, “the sweating-people” (g̣ɪʟ̣oˊta-raˊmkɪn)."/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l18" HPOS="391" VPOS="1978" WIDTH="1772" HEIGHT="59" BASELINE="394 2022 2163 2015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2022 394 2037 2161 2030 2163 2015 2156 1978 391 1985 394 2022"/>
                        </Shape>
                        <String CONTENT="Many of the women are clumsily shaped, with short waists, and legs out of"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l19" HPOS="389" VPOS="2035" WIDTH="1774" HEIGHT="69" BASELINE="391 2084 2163 2076" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2084 391 2104 1951 2091 2124 2100 2126 2100 2128 2100 2163 2087 2163 2076 2159 2045 1743 2035 1741 2035 1680 2045 1310 2037 1308 2037 1305 2037 1271 2048 944 2039 942 2039 389 2052 391 2084"/>
                        </Shape>
                        <String CONTENT="proportion to the rest of their bodies. Some of the Chukchee have consider-"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l20" HPOS="389" VPOS="2100" WIDTH="1772" HEIGHT="58" BASELINE="391 2141 2161 2136" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2141 391 2158 2159 2154 2161 2136 2156 2108 420 2100 417 2100 415 2100 389 2108 391 2141"/>
                        </Shape>
                        <String CONTENT="able physical strength, especially the reindeer-breeders, who have a superior"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l21" HPOS="389" VPOS="2160" WIDTH="1770" HEIGHT="54" BASELINE="391 2199 2159 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2199 391 2214 2156 2210 2159 2195 2154 2169 409 2160 407 2160 404 2160 402 2160 389 2167 391 2199"/>
                        </Shape>
                        <String CONTENT="diet. I saw men who were able to carry a whole reindeer-carcass on their"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l22" HPOS="391" VPOS="2225" WIDTH="1770" HEIGHT="54" BASELINE="394 2262 2161 2255" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2262 394 2279 2159 2273 2161 2255 2156 2227 391 2225 394 2262"/>
                        </Shape>
                        <String CONTENT="backs for a quarter of a mile, or lift a great stone about two hundred pounds"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l23" HPOS="389" VPOS="2288" WIDTH="1772" HEIGHT="50" BASELINE="391 2323 2161 2316" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2323 391 2338 2159 2331 2161 2316 2156 2288 389 2288 391 2323"/>
                        </Shape>
                        <String CONTENT="in weight. The younger Chukchee are continually bent on increasing their"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l24" HPOS="389" VPOS="2340" WIDTH="1772" HEIGHT="65" BASELINE="391 2383 2161 2379" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2383 391 2405 2159 2396 2161 2379 2156 2349 420 2340 417 2340 415 2340 389 2349 391 2383"/>
                        </Shape>
                        <String CONTENT="physical powers by lifting and carrying stones, by running foot-races for long"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l25" HPOS="387" VPOS="2398" WIDTH="1774" HEIGHT="59" BASELINE="389 2442 2161 2437" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 2442 389 2457 2159 2452 2161 2437 2156 2405 409 2398 407 2398 404 2398 402 2398 387 2405 389 2442"/>
                        </Shape>
                        <String CONTENT="distances, etc. The Maritime Chukchee and the Eskimo even have special"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l26" HPOS="387" VPOS="2468" WIDTH="1772" HEIGHT="52" BASELINE="389 2502 2159 2498" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 2502 389 2520 2156 2520 2159 2498 2154 2468 387 2468 389 2502"/>
                        </Shape>
                        <String CONTENT="lifting-stones for each man. These are picked up among the crumbling rocks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l27" HPOS="387" VPOS="2517" WIDTH="1774" HEIGHT="61" BASELINE="389 2563 2161 2556" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 2563 389 2578 2159 2572 2161 2556 2156 2526 983 2517 981 2517 924 2528 461 2520 459 2520 387 2530 389 2563"/>
                        </Shape>
                        <String CONTENT="and are usually cylindrical in shape, with smooth surfaces. One of my European"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l28" HPOS="389" VPOS="2576" WIDTH="1770" HEIGHT="60" BASELINE="391 2621 2159 2615" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2621 391 2636 2156 2630 2159 2615 2154 2587 1570 2576 1567 2576 1513 2587 1143 2578 1141 2578 974 2589 402 2580 400 2580 398 2580 396 2580 396 2582 389 2587 391 2621"/>
                        </Shape>
                        <String CONTENT="fellow-travellers, however, was able to surpass all the men of the villages"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l29" HPOS="391" VPOS="2634" WIDTH="1542" HEIGHT="63" BASELINE="394 2682 1933 2678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2682 394 2697 1931 2693 1933 2678 1929 2647 1704 2647 1680 2634 1678 2634 1676 2634 1674 2634 1628 2645 1574 2634 1572 2634 1570 2634 1548 2645 1485 2634 1483 2634 1481 2634 1455 2645 1368 2634 1366 2634 1364 2634 1340 2645 1286 2634 1284 2634 1201 2645 1117 2636 1115 2636 1113 2636 1110 2636 1100 2647 1080 2636 1078 2636 1076 2636 1002 2647 864 2636 861 2636 859 2636 818 2647 775 2636 773 2636 770 2636 768 2636 736 2647 718 2636 716 2636 714 2636 712 2636 710 2636 667 2647 651 2636 649 2636 647 2636 645 2636 391 2643 394 2682"/>
                        </Shape>
                        <String CONTENT="between Mariinsky Post and Indian Point in a hand-pulling contest."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-055_r5" HPOS="391" VPOS="2693" WIDTH="1778" HEIGHT="252" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="391 2693 2169 2693 2169 2945 391 2945"/>
                    </Shape>
                    <TextLine ID="mz_1-055_l30" HPOS="498" VPOS="2695" WIDTH="1665" HEIGHT="61" BASELINE="500 2740 2163 2736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 2740 500 2756 2161 2751 2163 2736 2159 2708 2066 2695 2063 2695 2061 2695 2031 2706 1944 2695 1942 2695 1940 2695 1912 2706 1797 2695 1795 2695 1793 2695 1767 2708 1611 2708 1593 2695 1591 2695 1589 2695 1587 2695 1585 2695 1554 2706 1533 2695 1531 2695 1528 2695 1327 2708 1247 2697 1245 2697 1243 2697 1217 2708 1206 2697 1204 2697 1201 2697 1106 2697 1104 2697 1102 2697 1100 2697 1087 2708 1026 2697 1024 2697 1022 2697 994 2708 970 2697 968 2697 965 2697 963 2697 918 2708 779 2697 777 2697 498 2704 500 2740"/>
                        </Shape>
                        <String CONTENT="The cheek-bones of the Chukchee are much less prominent than those"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l31" HPOS="387" VPOS="2760" WIDTH="1774" HEIGHT="63" BASELINE="389 2801 2161 2795" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="389 2801 389 2816 1567 2823 1570 2823 1652 2812 2159 2812 2161 2795 2156 2766 428 2760 426 2760 424 2760 387 2771 389 2801"/>
                        </Shape>
                        <String CONTENT="of the Tungus or Yakut; their noses are often large, well-shaped, and even"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l32" HPOS="389" VPOS="2816" WIDTH="1774" HEIGHT="61" BASELINE="391 2859 2163 2855" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2859 391 2877 2161 2872 2163 2855 2159 2827 1277 2816 1275 2816 1212 2827 474 2818 472 2818 389 2829 391 2859"/>
                        </Shape>
                        <String CONTENT="aquiline, though noses with the low Mongolian bridge are also frequently met"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l33" HPOS="391" VPOS="2890" WIDTH="795" HEIGHT="47" BASELINE="391 2918 1186 2918" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="391 2918 391 2935 1184 2937 1186 2918 1186 2890 391 2890 391 2918"/>
                        </Shape>
                        <String CONTENT="with, especially among the women."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-055_r6" HPOS="391" VPOS="2945" WIDTH="1778" HEIGHT="239" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="391 2945 2169 2945 2169 3184 391 3184"/>
                    </Shape>
                    <TextLine ID="mz_1-055_l34" HPOS="498" VPOS="2933" WIDTH="1665" HEIGHT="61" BASELINE="500 2979 2163 2974" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 2979 500 2994 2163 2989 2163 2974 2159 2944 1985 2933 1983 2933 1981 2933 1979 2933 1966 2944 1936 2933 1933 2933 1931 2933 1864 2944 1829 2933 1827 2933 1825 2933 1749 2944 1704 2933 1702 2933 1700 2933 1609 2944 1574 2933 1572 2933 1570 2933 1567 2933 1565 2933 1550 2946 1459 2946 1422 2933 1420 2933 1418 2933 1325 2946 1214 2935 1212 2935 1210 2935 1180 2948 1087 2948 1071 2935 1069 2935 1067 2935 1065 2935 1063 2935 1035 2946 920 2935 918 2935 916 2935 887 2946 812 2935 809 2935 498 2944 500 2979"/>
                        </Shape>
