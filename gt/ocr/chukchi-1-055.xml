                    </Shape>
                    <TextLine ID="mz_1-055_l30" HPOS="477" VPOS="2680" WIDTH="1665" HEIGHT="61" BASELINE="479 2725 2142 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2725 479 2741 2140 2736 2142 2721 2138 2693 2045 2680 2042 2680 2040 2680 2010 2691 1923 2680 1921 2680 1919 2680 1891 2691 1776 2680 1774 2680 1772 2680 1746 2693 1590 2693 1572 2680 1570 2680 1568 2680 1566 2680 1564 2680 1533 2691 1512 2680 1510 2680 1507 2680 1306 2693 1226 2682 1224 2682 1222 2682 1196 2693 1185 2682 1183 2682 1180 2682 1085 2682 1083 2682 1081 2682 1079 2682 1066 2693 1005 2682 1003 2682 1001 2682 973 2693 949 2682 947 2682 944 2682 942 2682 897 2693 758 2682 756 2682 477 2689 479 2725"/>
                        </Shape>
                        <String CONTENT="The cheek-bones of the Chukchee are much less prominent than those"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l31" HPOS="366" VPOS="2745" WIDTH="1774" HEIGHT="63" BASELINE="368 2786 2140 2780" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2786 368 2801 1546 2808 1549 2808 1631 2797 2138 2797 2140 2780 2135 2751 407 2745 405 2745 403 2745 366 2756 368 2786"/>
                        </Shape>
                        <String CONTENT="of the Tungus or Yakut; their noses are often large, well-shaped, and even"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l32" HPOS="368" VPOS="2801" WIDTH="1774" HEIGHT="61" BASELINE="370 2844 2142 2840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2844 370 2862 2140 2857 2142 2840 2138 2812 1256 2801 1254 2801 1191 2812 453 2803 451 2803 368 2814 370 2844"/>
                        </Shape>
                        <String CONTENT="aquiline, though noses with the low Mongolian bridge are also frequently met"/>
                    </TextLine>

                    <TextLine ID="mz_1-055_l33" HPOS="370" VPOS="2875" WIDTH="795" HEIGHT="47" BASELINE="370 2903 1165 2903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2903 370 2920 1163 2922 1165 2903 1165 2875 370 2875 370 2903"/>
                        </Shape>
                        <String CONTENT="with, especially among the women."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-055_r6" HPOS="370" VPOS="2930" WIDTH="1778" HEIGHT="239" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="370 2930 2148 2930 2148 3169 370 3169"/>
                    </Shape>
                    <TextLine ID="mz_1-055_l34" HPOS="477" VPOS="2918" WIDTH="1665" HEIGHT="61" BASELINE="479 2964 2142 2959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2964 479 2979 2142 2974 2142 2959 2138 2929 1964 2918 1962 2918 1960 2918 1958 2918 1945 2929 1915 2918 1912 2918 1910 2918 1843 2929 1808 2918 1806 2918 1804 2918 1728 2929 1683 2918 1681 2918 1679 2918 1588 2929 1553 2918 1551 2918 1549 2918 1546 2918 1544 2918 1529 2931 1438 2931 1401 2918 1399 2918 1397 2918 1304 2931 1193 2920 1191 2920 1189 2920 1159 2933 1066 2933 1050 2920 1048 2920 1046 2920 1044 2920 1042 2920 1014 2931 899 2920 897 2920 895 2920 866 2931 791 2920 788 2920 477 2929 479 2964"/>
                        </Shape>
