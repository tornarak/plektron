                        </Shape>
                        <String CONTENT="a while with others of similar circumstances, even though not related. “Poor"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l21" HPOS="378" VPOS="2006" WIDTH="1765" HEIGHT="66" BASELINE="379 2051 2143 2045" TAGREFS="TYPE_5">
