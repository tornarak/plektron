                        </Shape>
                        <String CONTENT="to divide the herd and to form two or more separate camps. Moreover, the"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l27" HPOS="378" VPOS="2367" WIDTH="1767" HEIGHT="56" BASELINE="379 2410 2145 2402" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 2410 379 2423 2143 2417 2145 2402 2141 2374 1274 2367 1272 2367 1270 2367 1268 2367 1253 2376 461 2371 459 2371 378 2380 379 2410"/>
                        </Shape>
                        <String CONTENT="wealthy reindeer-owners are often unable to keep their reindeer well under"/>
