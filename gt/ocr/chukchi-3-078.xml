                            <Polygon POINTS="379 2051 379 2072 2141 2061 2143 2045 2139 2016 1555 2006 1553 2006 1551 2006 1516 2016 1015 2008 1013 2008 962 2018 483 2010 481 2010 378 2020 379 2051"/>
                        </Shape>
                        <String CONTENT="people are careless of ties of relationship,” say the Chukchee. Five, and even"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l22" HPOS="378" VPOS="2065" WIDTH="1767" HEIGHT="66" BASELINE="379 2111 2145 2104" TAGREFS="TYPE_5">
