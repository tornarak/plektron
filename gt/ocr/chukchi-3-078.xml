                        </Shape>
                        <String CONTENT="THE CAMP OF THE REINDEER CHUKCHEE. — The camp among the Rein-"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l3" HPOS="376" VPOS="926" WIDTH="1765" HEIGHT="59" BASELINE="378 971 2141 967" TAGREFS="TYPE_5">
