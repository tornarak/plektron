                        </Shape>
                        <String CONTENT="etc., with their wives and children. Especially is this the case among people"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l13" HPOS="376" VPOS="1529" WIDTH="1765" HEIGHT="54" BASELINE="378 1570 2141 1566" TAGREFS="TYPE_5">
                        <Shape>
