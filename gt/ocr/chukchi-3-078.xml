                        <Shape>
                            <Polygon POINTS="378 1809 378 1823 2139 1829 2141 1809 2141 1780 378 1780 378 1809"/>
                        </Shape>
                        <String CONTENT="as before. Among the poorer people, who count their reindeer only by scores,"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l18" HPOS="376" VPOS="1827" WIDTH="1765" HEIGHT="56" BASELINE="378 1872 2141 1864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1872 378 1883 2139 1879 2141 1864 2137 1837 1701 1827 1699 1827 1697 1827 1672 1837 1280 1829 1278 1829 1276 1829 1243 1839 393 1833 391 1833 389 1833 387 1833 376 1839 378 1872"/>
                        </Shape>
                        <String CONTENT="the sons are inclined to separate, and to seek a new fortune, each on his"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l19" HPOS="378" VPOS="1889" WIDTH="1765" HEIGHT="55" BASELINE="379 1930 2143 1924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1930 379 1944 2141 1938 2143 1924 2139 1897 974 1889 972 1889 970 1889 937 1899 658 1891 656 1891 378 1901 379 1930"/>
                        </Shape>
                        <String CONTENT="own account. On the other hand, such small reindeer-owners often join for"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l20" HPOS="378" VPOS="1946" WIDTH="1765" HEIGHT="56" BASELINE="379 1989 2143 1983" TAGREFS="TYPE_5">
