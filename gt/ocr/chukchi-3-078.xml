                        </Shape>
                        <String CONTENT="the camp consists of related families, — for instance, of brothers, cousins,"/>
                    </TextLine>

                    <TextLine ID="mz_3-078_l12" HPOS="374" VPOS="1466" WIDTH="1767" HEIGHT="68" BASELINE="376 1513 2141 1507" TAGREFS="TYPE_5">
                        <Shape>
