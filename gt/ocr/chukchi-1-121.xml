                        </Shape>
                        <String CONTENT="is used (see Fig. 17, f¹), that is loosely tied to the right runner, and, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l12" HPOS="355" VPOS="2076" WIDTH="1276" HEIGHT="61" BASELINE="357 2121 1631 2117" TAGREFS="TYPE_4">
