                    <TextLine ID="mz_1-121_l13" HPOS="464" VPOS="2130" WIDTH="1661" HEIGHT="67" BASELINE="466 2182 2125 2171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="466 2182 466 2197 2122 2191 2125 2171 2120 2143 1878 2130 1876 2130 1787 2143 1679 2132 1676 2132 1674 2132 1650 2145 1455 2147 1291 2147 1263 2134 1261 2134 1258 2134 1113 2147 890 2137 888 2137 780 2150 747 2139 745 2139 743 2139 741 2139 710 2150 700 2139 697 2139 695 2139 693 2139 464 2143 466 2182"/>
                        </Shape>
                        <String CONTENT="The Chukchee driver, as a rule, does not carry anything on his sledge,"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l14" HPOS="353" VPOS="2197" WIDTH="1772" HEIGHT="67" BASELINE="355 2238 2125 2232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2238 355 2253 836 2264 838 2264 1442 2251 1531 2262 1533 2262 2122 2247 2125 2232 2120 2204 370 2197 368 2197 366 2197 364 2197 353 2204 355 2238"/>
                        </Shape>
                        <String CONTENT="for fear of fatiguing his reindeer. Even for a long journey he takes on his"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l15" HPOS="353" VPOS="2256" WIDTH="1772" HEIGHT="62" BASELINE="355 2301 2125 2290" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2301 355 2318 2122 2308 2125 2290 2118 2256 353 2271 355 2301"/>
                        </Shape>
                        <String CONTENT="sledge only a lasso, a spear, an outer coat for protection against storms, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l16" HPOS="353" VPOS="2316" WIDTH="1769" HEIGHT="61" BASELINE="355 2357 2122 2349" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2357 355 2377 2120 2368 2122 2349 2118 2316 812 2316 810 2316 808 2316 786 2327 370 2318 368 2318 366 2318 364 2318 353 2325 355 2357"/>
                        </Shape>
                        <String CONTENT="for provisions a cake of ground meat mixed with tallow, but no kettle and"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l17" HPOS="353" VPOS="2375" WIDTH="1769" HEIGHT="60" BASELINE="355 2420 2122 2411" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2420 355 2435 2120 2433 2122 2411 2118 2383 1267 2375 1265 2375 1263 2375 1224 2385 944 2377 942 2377 353 2390 355 2420"/>
                        </Shape>
                        <String CONTENT="no cup. For subsistence he depends solely on the villages and camps along"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l18" HPOS="353" VPOS="2429" WIDTH="1772" HEIGHT="80" BASELINE="355 2479 2125 2468" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2479 355 2509 427 2496 654 2507 656 2507 659 2507 715 2494 1215 2502 1217 2502 1300 2492 1410 2502 1412 2502 2122 2485 2125 2468 2120 2440 1988 2429 1986 2429 353 2444 355 2479"/>
                        </Shape>
                        <String CONTENT="his route, or, if he fails to find these, he sleeps patiently on the snow without"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l19" HPOS="353" VPOS="2494" WIDTH="1769" HEIGHT="63" BASELINE="355 2539 2122 2526" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2539 355 2557 2120 2544 2122 2526 2118 2500 1239 2494 1237 2494 1235 2494 1213 2505 674 2498 672 2498 669 2498 643 2509 444 2500 442 2500 353 2511 355 2539"/>
                        </Shape>
                        <String CONTENT="meals. For the most part, however, Chukchee journeys are undertaken with"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l20" HPOS="353" VPOS="2554" WIDTH="1769" HEIGHT="61" BASELINE="355 2600 2122 2589" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2600 355 2615 2120 2611 2122 2589 2118 2561 1094 2554 1092 2554 1089 2554 1057 2565 431 2559 429 2559 353 2570 355 2600"/>
                        </Shape>
                        <String CONTENT="a train of from eight to ten sledges, a woman goes along to attend to it,"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l21" HPOS="353" VPOS="2615" WIDTH="914" HEIGHT="58" BASELINE="355 2660 1267 2656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2660 355 2673 1265 2671 1267 2656 1263 2628 960 2615 957 2615 882 2626 843 2615 840 2615 838 2615 747 2628 522 2617 520 2617 455 2628 427 2617 425 2617 422 2617 353 2630 355 2660"/>
                        </Shape>
                        <String CONTENT="and a few score reindeer drag it along."/>
                    </TextLine>
