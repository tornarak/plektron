                        </Shape>
                        <String CONTENT="can lead from ten to fifteen sledges; and a well-to-do house with a large family"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l25" HPOS="376" VPOS="2872" WIDTH="1767" HEIGHT="61" BASELINE="378 2916 2143 2901" TAGREFS="TYPE_4">
