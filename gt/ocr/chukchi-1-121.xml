                        </Shape>
                        <String CONTENT="All pack-sledges have their definite place in the travelling-line, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l23" HPOS="351" VPOS="2725" WIDTH="1771" HEIGHT="72" BASELINE="353 2782 2122 2767" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2782 353 2797 2120 2782 2122 2767 2118 2738 1869 2725 1867 2725 1865 2725 1839 2738 1650 2728 1648 2728 1646 2728 1598 2741 1423 2730 1421 2730 1315 2743 1226 2732 1224 2732 1222 2732 1183 2743 1096 2734 1094 2734 1092 2734 1089 2734 1074 2745 914 2734 912 2734 910 2734 908 2734 890 2747 351 2747 353 2782"/>
                        </Shape>
                        <String CONTENT="begins with the woman leading it, and ends with the pole-sled. One woman"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l24" HPOS="353" VPOS="2790" WIDTH="1769" HEIGHT="65" BASELINE="355 2838 2122 2827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2838 355 2855 2120 2844 2122 2827 2118 2799 1414 2790 1412 2790 1410 2790 1380 2801 1066 2793 1063 2793 1061 2793 1059 2793 1046 2803 457 2797 455 2797 353 2808 355 2838"/>
                        </Shape>
                        <String CONTENT="can lead from ten to fifteen sledges; and a well-to-do house with a large family"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l25" HPOS="355" VPOS="2857" WIDTH="1767" HEIGHT="61" BASELINE="357 2901 2122 2886" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2901 357 2918 2120 2903 2122 2886 2118 2857 607 2857 604 2857 602 2857 600 2857 585 2868 472 2860 470 2860 355 2870 357 2901"/>
                        </Shape>
                        <String CONTENT="may have forty or even sixty sledges, which travel in from four to six separate"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l26" HPOS="353" VPOS="2912" WIDTH="1769" HEIGHT="62" BASELINE="355 2957 2122 2946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2957 355 2974 2120 2964 2122 2946 2116 2912 353 2922 355 2957"/>
                        </Shape>
                        <String CONTENT="lines. When starting, the sledges are packed early in the morning, and placed"/>
                    </TextLine>

