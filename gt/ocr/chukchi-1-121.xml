                        <Shape>
                            <Polygon POINTS="376 3152 376 3167 2141 3163 2143 3143 2139 3115 818 3108 816 3108 814 3108 792 3119 400 3111 398 3111 396 3111 374 3119 376 3152"/>
                        </Shape>
                        <String CONTENT="driven. Most of the sledges are stood up one against another in a slanting"/>
