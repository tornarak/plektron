                        </Shape>
                        <String CONTENT="to the reindeer driving-sledge of the Koryak and the Chukchee. When gliding"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l9" HPOS="353" VPOS="1898" WIDTH="1769" HEIGHT="57" BASELINE="355 1939 2122 1935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1939 355 1955 2120 1952 2122 1935 2118 1907 375 1898 373 1898 370 1898 368 1898 353 1905 355 1939"/>
                        </Shape>
                        <String CONTENT="down a slope, the driver generally uses his feet as a brake. In the spring,"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l10" HPOS="355" VPOS="1955" WIDTH="1767" HEIGHT="62" BASELINE="357 1998 2122 1989" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 1998 357 2017 2120 2009 2122 1989 2118 1963 1263 1955 1261 1955 1258 1955 1235 1965 392 1959 390 1959 388 1959 355 1970 357 1998"/>
                        </Shape>
                        <String CONTENT="when the upper snow-crust becomes hard and slippery, a brake made of antler"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l11" HPOS="353" VPOS="2011" WIDTH="1772" HEIGHT="69" BASELINE="355 2063 2125 2050" TAGREFS="TYPE_4">
