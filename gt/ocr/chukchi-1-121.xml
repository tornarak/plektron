                        <Shape>
                            <Polygon POINTS="355 3022 355 3037 2120 3022 2122 3007 2116 2970 353 2985 355 3022"/>
                        </Shape>
                        <String CONTENT="in the usual order. All the lines are joined together, forming a large corral"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l28" HPOS="351" VPOS="3022" WIDTH="1771" HEIGHT="76" BASELINE="353 3083 2122 3063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2112 3033 1938 3022 1936 3022 1934 3022 1932 3022 1919 3035 1899 3024 1897 3024 1895 3024 1798 3035 1774 3024 1772 3024 1769 3024 1767 3024 1726 3037 1711 3026 1709 3026 1707 3026 1705 3026 1598 3037 1499 3028 1497 3028 1494 3028 1492 3028 1477 3039 1382 3028 1380 3028 1378 3028 1321 3041 1154 3031 1152 3031 1150 3031 1148 3031 1126 3044 983 3033 981 3033 979 3033 938 3046 786 3035 784 3035 782 3035 762 3046 749 3035 747 3035 745 3035 743 3035 741 3035 710 3048 648 3037 646 3037 505 3050 368 3039 366 3039 364 3039 362 3039 351 3046 353 3083 353 3098 2120 3078 2122 3063 2120 3054 2112 3033"/>
                        </Shape>
                        <String CONTENT="(Plate IV, Fig. 2) in the shape of a horseshoe, into which the reindeer are"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l29" HPOS="353" VPOS="3093" WIDTH="1769" HEIGHT="59" BASELINE="355 3137 2122 3128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 3137 355 3152 2120 3148 2122 3128 2118 3100 797 3093 795 3093 793 3093 771 3104 379 3096 377 3096 375 3096 353 3104 355 3137"/>
                        </Shape>
                        <String CONTENT="driven. Most of the sledges are stood up one against another in a slanting"/>
                    </TextLine>

                    <TextLine ID="mz_1-121_l30" HPOS="353" VPOS="3156" WIDTH="1769" HEIGHT="67" BASELINE="355 3200 2122 3187" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 3200 355 3223 2122 3206 2122 3187 2118 3158 650 3156 648 3156 353 3169 355 3200"/>
                        </Shape>
                        <String CONTENT="position, and the corral is strengthened with sticks, shovels, large skins, etc.,"/>
