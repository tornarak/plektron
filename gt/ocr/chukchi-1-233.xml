                        </Shape>
                        <String CONTENT="than that below. The upper parts are not fastened to those below, but are"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l38" HPOS="443" VPOS="2823" WIDTH="1776" HEIGHT="58" BASELINE="446 2864 2219 2857" TAGREFS="TYPE_3">
                        <Shape>
