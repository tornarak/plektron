                    <TextLine ID="mz_1-233_l32" HPOS="446" VPOS="2465" WIDTH="1771" HEIGHT="57" BASELINE="448 2507 2217 2500" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="448 2507 448 2522 2215 2515 2217 2500 2213 2468 467 2465 465 2465 463 2465 461 2465 446 2472 448 2507"/>
                        </Shape>
