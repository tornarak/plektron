                        </Shape>
                        <String CONTENT="generations ago. At the time of Hooper’s visit in 1848, houses of the modern"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l15" HPOS="443" VPOS="1452" WIDTH="1774" HEIGHT="54" BASELINE="446 1489 2217 1483" TAGREFS="TYPE_3">
