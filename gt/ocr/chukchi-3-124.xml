                        </Shape>
                        <String CONTENT="fast, from fear of pursuit. Three years before, Eiˊheli and his people had"/>
                    </TextLine>

                    <TextLine ID="mz_3-124_l33" HPOS="567" VPOS="2267" WIDTH="1715" HEIGHT="59" BASELINE="569 2308 2282 2306" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="569 2308 569 2326 2280 2326 2282 2306 2278 2279 2184 2267 2182 2267 2126 2279 1917 2279 1904 2267 1902 2267 1900 2267 1898 2267 1896 2267 1867 2277 1767 2267 1765 2267 1617 2279 1479 2279 1463 2267 1461 2267 1459 2267 1457 2267 1401 2277 1313 2267 1311 2267 1309 2267 1274 2277 1245 2267 1243 2267 1241 2267 1173 2277 1062 2267 1060 2267 1058 2267 1023 2277 993 2267 991 2267 989 2267 908 2277 894 2267 892 2267 890 2267 888 2267 567 2273 569 2308"/>
                        </Shape>
                        <String CONTENT="had a quarrel with the people from Chaun, and had nearly come to blows."/>
                    </TextLine>
</TextBlock>
