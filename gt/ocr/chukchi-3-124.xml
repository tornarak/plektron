                        <Shape>
                            <Polygon POINTS="676 2369 676 2384 2340 2384 2340 2369 2340 2337 2297 2328 2295 2328 2293 2328 2291 2328 2260 2337 2122 2328 2120 2328 2054 2337 1976 2328 1974 2328 1972 2328 1944 2337 1929 2328 1927 2328 1925 2328 1923 2328 1857 2337 1777 2328 1775 2328 1699 2337 1627 2328 1625 2328 1578 2339 1428 2339 1407 2328 1405 2328 1403 2328 1401 2328 1371 2337 1331 2328 1329 2328 1327 2328 1325 2328 1294 2337 1165 2328 1163 2328 1114 2339 1009 2339 995 2328 993 2328 991 2328 989 2328 912 2337 676 2334 676 2369"/>
                        </Shape>
                        <String CONTENT="Minor quarrels sometimes arise in connection with conflicting claims to the"/>
                    </TextLine>

                    <TextLine ID="mz_3-124_l35" HPOS="567" VPOS="2388" WIDTH="1771" HEIGHT="64" BASELINE="567 2429 2338 2429" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="567 2429 567 2441 874 2452 876 2452 1079 2443 1557 2443 1623 2452 1625 2452 1726 2443 1964 2452 1966 2452 2338 2443 2338 2429 2338 2400 2260 2388 2258 2388 2184 2398 2057 2388 2056 2388 1976 2398 1894 2388 1892 2388 1890 2388 1855 2398 1820 2388 1818 2388 1816 2388 1732 2400 1633 2400 1615 2388 1613 2388 1611 2388 1609 2388 1549 2398 1492 2388 1490 2388 1407 2398 1393 2388 1391 2388 1389 2388 1387 2388 1385 2388 1342 2398 1284 2388 1282 2388 1221 2398 1157 2388 1155 2388 1087 2398 567 2392 567 2429"/>
                        </Shape>
                        <String CONTENT="best reindeer-pastures. The tale of “The Happy Suitor” contains a curious"/>
                    </TextLine>

                    <TextLine ID="mz_3-124_l36" HPOS="569" VPOS="2445" WIDTH="477" HEIGHT="58" BASELINE="569 2487 1046 2487" TAGREFS="TYPE_6">
                        <Shape>
