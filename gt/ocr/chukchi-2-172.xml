                        </Shape>
                        <String CONTENT="in the light, either in the sleeping-room or in the outer tent, and even in"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l4" HPOS="346" VPOS="622" WIDTH="1769" HEIGHT="57" BASELINE="348 665 2115 661" TAGREFS="TYPE_5">
                        <Shape>
