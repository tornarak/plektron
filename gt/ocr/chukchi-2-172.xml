                        </Shape>
                        <String CONTENT="the daytime. Some are done clumsily enough; others, on the contrary, display"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l5" HPOS="350" VPOS="681" WIDTH="1763" HEIGHT="59" BASELINE="352 724 2113 720" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 724 352 740 2111 740 2113 720 2111 691 2093 681 2091 681 2089 681 2087 681 2085 681 2052 691 1500 681 1498 681 1496 681 1463 693 1255 693 1233 681 1231 681 1229 681 1151 693 1081 683 1079 683 1077 683 1051 693 1026 683 1024 683 1022 683 869 693 771 683 769 683 710 693 622 683 620 683 618 683 593 693 579 683 577 683 575 683 458 683 456 683 350 695 352 724"/>
                        </Shape>
                        <String CONTENT="wonderful skill, which would do credit to a prestidigitateur of the first rank"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l6" HPOS="348" VPOS="744" WIDTH="1771" HEIGHT="60" BASELINE="350 785 2119 781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 785 350 799 2081 804 2083 804 2085 804 2119 793 2119 781 2113 744 348 752 350 785"/>
                        </Shape>
                        <String CONTENT="in civilized countries. I must mention, moreover, that I had no chance of"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l7" HPOS="346" VPOS="802" WIDTH="1769" HEIGHT="59" BASELINE="348 844 2115 838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 844 348 861 2113 855 2115 838 2111 812 1525 802 1523 802 1521 802 1519 802 1502 812 938 804 936 804 934 804 912 814 452 806 450 806 346 816 348 844"/>
                        </Shape>
                        <String CONTENT="meeting a shaman of the first rank, — a man of such ability that, in the words"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l8" HPOS="346" VPOS="859" WIDTH="1763" HEIGHT="69" BASELINE="348 906 2109 900" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 906 348 918 748 928 750 928 752 928 754 928 769 916 1216 916 1314 926 1316 926 1318 926 1341 916 1427 926 1429 926 1431 926 1470 916 1549 924 1551 924 1553 924 1582 914 1745 914 2087 924 2089 924 2091 924 2093 924 2109 912 2109 900 2101 861 2072 871 2040 859 2038 859 2036 859 2034 859 2009 873 1860 873 1835 859 1833 859 1831 859 1829 859 1827 859 1805 873 1711 873 1694 859 1692 859 1690 859 1688 859 1686 859 1660 869 1633 859 1631 859 1629 859 1551 871 1510 861 1508 861 1506 861 1504 861 1478 873 1451 861 1449 861 1447 861 1445 861 1443 861 1421 875 1322 875 1294 861 1292 861 1290 861 1216 871 1159 861 1157 861 1155 861 1130 873 889 875 850 863 848 863 846 863 740 875 536 863 534 863 532 863 501 875 389 863 387 863 385 863 346 877 348 906"/>
                        </Shape>
                        <String CONTENT="of the Chukchee, “his renown would fully equal that of the ancient people,”"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l9" HPOS="348" VPOS="932" WIDTH="1763" HEIGHT="47" BASELINE="348 963 2111 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 963 348 979 2111 979 2111 963 2111 936 348 932 348 963"/>
                        </Shape>
                        <String CONTENT="because shamans like that are not to be met with every day in modern times."/>
                    </TextLine>
<TextLine ID="mz_2-172_l10" HPOS="450" VPOS="981" WIDTH="1661" HEIGHT="66" BASELINE="452 1026 2111 1022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 1026 452 1037 1267 1045 1269 1045 1271 1045 1296 1035 1609 1035 1745 1045 1747 1045 1795 1035 1807 1045 1809 1045 1811 1045 1813 1047 1964 1047 1964 1045 1966 1045 1968 1045 1982 1035 2058 1045 2060 1045 2109 1034 2111 1022 2107 994 1799 994 1778 981 1776 981 1774 981 1772 981 1770 981 1768 981 1750 994 1701 994 1670 981 1668 981 1666 981 1592 992 1480 981 1478 981 1476 981 1449 992 1318 981 1316 981 1247 994 1200 983 1198 983 1196 983 914 994 797 983 795 983 793 983 748 994 587 983 585 983 583 983 552 994 473 983 472 983 470 983 468 983 450 992 452 1026"/>
                        </Shape>
                        <String CONTENT="One Eskimo shaman of Uñiˊsak at Indian Point enjoyed a great repu-"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l11" HPOS="342" VPOS="1041" WIDTH="1767" HEIGHT="63" BASELINE="344 1088 2109 1082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1088 344 1100 2105 1104 2109 1082 2105 1051 1962 1041 1960 1041 1880 1051 1852 1041 1850 1041 1848 1041 1741 1051 1684 1041 1682 1041 1680 1041 1678 1041 1664 1051 1633 1041 1631 1041 1629 1041 1627 1041 1625 1041 1609 1051 1245 1043 1243 1043 1179 1053 857 1045 855 1045 654 1055 599 1045 597 1045 595 1045 554 1055 513 1045 511 1045 509 1045 507 1045 475 1055 407 1045 405 1045 342 1055 344 1088"/>
                        </Shape>
                        <String CONTENT="tation in the surrounding country; and his neighbors, desirous of explaining"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l12" HPOS="344" VPOS="1104" WIDTH="1767" HEIGHT="55" BASELINE="346 1145 2111 1141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="346 1145 346 1159 2109 1157 2111 1141 2107 1114 1372 1104 1370 1104 344 1116 346 1145"/>
                        </Shape>
                        <String CONTENT="to me his great strength, said that he was like a keˊlᴇ, and that they were"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l13" HPOS="344" VPOS="1163" WIDTH="1765" HEIGHT="55" BASELINE="344 1204 2109 1204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1204 344 1216 2107 1218 2109 1204 2109 1175 2077 1163 2076 1163 2074 1163 2072 1163 2025 1175 1985 1163 1983 1163 1982 1163 1923 1175 1884 1163 1882 1163 1880 1163 1823 1175 1805 1163 1803 1163 1801 1163 1799 1163 1647 1175 1572 1163 1570 1163 1568 1163 1529 1175 1484 1163 1482 1163 1480 1163 1478 1163 1453 1175 1425 1163 1423 1163 1421 1163 1419 1163 1370 1175 1353 1163 1351 1163 1349 1163 1265 1163 1263 1163 1261 1163 1229 1176 1098 1176 916 1163 914 1163 912 1163 910 1163 893 1176 681 1176 552 1163 550 1163 493 1175 477 1163 475 1163 473 1163 472 1163 417 1173 389 1163 387 1163 385 1163 383 1163 344 1175 344 1204"/>
                        </Shape>
                        <String CONTENT="afraid of him, as we Russians are afraid of the Sun Chief (Czar).¹ To"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l14" HPOS="342" VPOS="1222" WIDTH="1767" HEIGHT="58" BASELINE="344 1269 2109 1263" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1269 344 1280 2107 1280 2109 1263 2103 1227 1970 1231 1931 1222 1929 1222 1927 1222 1872 1231 1815 1222 1813 1222 1745 1231 1633 1222 1631 1222 1568 1231 1521 1222 1519 1222 1517 1222 1515 1222 1502 1231 1351 1223 1349 1223 1247 1233 1210 1223 1208 1223 1206 1223 1204 1223 1175 1233 1041 1223 1039 1223 1038 1223 1036 1223 1020 1235 832 1235 726 1225 724 1225 677 1235 620 1225 618 1225 616 1225 614 1225 601 1235 579 1227 577 1227 575 1227 342 1237 344 1269"/>
                        </Shape>
                        <String CONTENT="my regret he died a year before I reached Indian Point. Mr. Gondatti"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l15" HPOS="344" VPOS="1284" WIDTH="1765" HEIGHT="55" BASELINE="344 1325 2109 1325" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1325 344 1337 2107 1339 2109 1325 2109 1296 2052 1284 2050 1284 1970 1294 1725 1284 1723 1284 1721 1284 1686 1294 1637 1284 1635 1284 1633 1284 1611 1294 1580 1284 1578 1284 1576 1284 1525 1294 1472 1284 1470 1284 1406 1294 1329 1284 1327 1284 1267 1294 1227 1284 1226 1284 1224 1284 1120 1294 1081 1284 1079 1284 1077 1284 1018 1294 957 1284 955 1284 667 1294 573 1284 571 1284 569 1284 536 1294 458 1284 456 1284 344 1294 344 1325"/>
                        </Shape>
                        <String CONTENT="certainly had an opportunity of meeting him, though he does not mention"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l16" HPOS="342" VPOS="1341" WIDTH="1769" HEIGHT="59" BASELINE="344 1386 2111 1382" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1386 344 1400 2109 1396 2111 1382 2107 1353 2060 1341 2058 1341 2056 1341 2034 1351 1893 1341 1891 1341 1841 1351 1819 1341 1817 1341 1815 1341 1813 1341 1790 1351 1766 1341 1764 1341 1762 1341 1674 1351 1647 1341 1645 1341 1643 1341 1557 1351 1529 1341 1527 1341 1525 1341 1449 1351 1412 1341 1410 1341 1408 1341 1406 1341 1370 1351 1298 1341 1296 1341 1294 1341 1261 1351 1229 1341 1227 1341 1226 1341 1171 1353 1124 1343 1122 1343 1069 1353 1036 1343 1034 1343 1032 1343 1030 1343 991 1355 853 1355 838 1343 836 1343 834 1343 832 1343 830 1343 799 1355 587 1355 569 1343 567 1343 566 1343 564 1343 342 1351 344 1386"/>
                        </Shape>
                        <String CONTENT="him in his papers. I met only his wife, Uˊpuñe, who acknowledged that she"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l17" HPOS="342" VPOS="1408" WIDTH="1767" HEIGHT="52" BASELINE="344 1447 2109 1441" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1447 344 1460 2107 1460 2109 1441 2103 1408 342 1410 344 1447"/>
                        </Shape>
                        <String CONTENT="had acquired only a small part of his great art. Some of the feats effected"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l18" HPOS="344" VPOS="1464" WIDTH="1763" HEIGHT="61" BASELINE="344 1505 2107 1505" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1505 344 1515 2105 1525 2107 1505 2107 1476 2044 1464 2042 1464 1966 1476 1729 1476 1711 1464 1709 1464 1707 1464 1705 1464 1611 1474 1421 1464 1419 1464 1417 1464 1384 1474 1339 1464 1337 1464 1284 1474 1237 1464 1235 1464 1022 1474 961 1464 959 1464 895 1474 344 1468 344 1505"/>
                        </Shape>
                        <String CONTENT="by her were, however, quite wonderful. For instance, while we were sitting"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l19" HPOS="340" VPOS="1525" WIDTH="1765" HEIGHT="61" BASELINE="340 1566 2105 1566" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1566 340 1578 2103 1586 2105 1566 2105 1537 2003 1525 2001 1525 1999 1525 1970 1535 1915 1525 1913 1525 1911 1525 1880 1535 1846 1525 1844 1525 1842 1525 1841 1525 1805 1535 1701 1525 1700 1525 1698 1525 1666 1535 1578 1525 1461 1525 1459 1525 1457 1525 1455 1525 1439 1535 1331 1525 1329 1525 1327 1525 1292 1535 1257 1525 1255 1525 1253 1525 1251 1525 1212 1535 1184 1525 1182 1525 1180 1525 1098 1535 959 1525 957 1525 955 1525 920 1535 863 1525 861 1525 779 1535 340 1531 340 1566"/>
                        </Shape>
                        <String CONTENT="in the inner room of her house, with the lamps burning, she took the drum,"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l20" HPOS="338" VPOS="1582" WIDTH="1773" HEIGHT="63" BASELINE="340 1627 2111 1623" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1627 340 1639 2091 1645 2093 1645 2095 1645 2097 1645 2111 1635 2111 1623 2109 1594 2077 1582 2076 1582 2074 1582 2072 1582 2048 1592 2027 1582 2025 1582 2023 1582 2021 1582 2019 1582 2003 1592 1844 1582 1842 1582 1774 1592 1747 1582 1745 1582 1743 1582 1741 1582 1739 1582 1721 1594 1529 1594 1496 1582 1494 1582 1492 1582 1331 1592 1253 1582 1251 1582 1249 1582 1218 1594 1169 1584 1167 1584 1077 1594 695 1584 693 1584 573 1594 497 1584 495 1584 444 1594 401 1584 399 1584 397 1584 338 1596 340 1627"/>
                        </Shape>
                        <String CONTENT="and, after practising on it for a little while, passed over to the characteristic"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l21" HPOS="340" VPOS="1645" WIDTH="1769" HEIGHT="54" BASELINE="340 1684 2109 1684" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1684 340 1695 2105 1699 2109 1684 2107 1656 2046 1645 2044 1645 2042 1645 2011 1654 1359 1645 1357 1645 1355 1645 1325 1654 1271 1645 1269 1645 1169 1654 1153 1645 1151 1645 1149 1645 1055 1645 1053 1645 942 1654 851 1645 850 1645 742 1654 622 1645 620 1645 618 1645 577 1654 548 1645 546 1645 544 1645 425 1654 391 1645 389 1645 387 1645 340 1654 340 1684"/>
                        </Shape>
                        <String CONTENT="cries and violent motions ascribed to the keˊlet, thus conveying to us that"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l22" HPOS="336" VPOS="1701" WIDTH="827" HEIGHT="67" BASELINE="338 1746 1163 1740" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="338 1746 338 1758 601 1766 603 1766 746 1756 757 1766 759 1766 761 1766 763 1768 873 1768 873 1766 875 1766 916 1754 1026 1754 1036 1762 1036 1764 1038 1764 1039 1764 1041 1766 1149 1766 1149 1764 1151 1764 1153 1764 1153 1762 1163 1752 1163 1740 1159 1711 1102 1701 1100 1701 1098 1701 1059 1711 1039 1701 1038 1701 1036 1701 1034 1701 1032 1701 1032 1703 1022 1713 961 1713 938 1701 936 1701 934 1701 932 1701 930 1701 920 1711 897 1701 895 1701 893 1701 891 1701 840 1713 710 1703 708 1703 707 1703 675 1713 650 1703 648 1703 646 1703 644 1703 642 1703 642 1705 632 1713 479 1705 477 1705 336 1715 338 1746"/>
                        </Shape>
                        <String CONTENT="one of them had entered her body."/>
                    </TextLine>
<TextLine ID="mz_2-172_l23" HPOS="477" VPOS="1764" WIDTH="1630" HEIGHT="59" BASELINE="477 1805 2107 1805" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 1805 477 1815 2105 1823 2107 1805 2107 1776 2052 1764 2050 1764 2048 1764 2013 1774 1983 1764 1982 1764 1980 1764 1978 1764 1936 1774 1372 1764 1370 1764 1318 1774 1284 1764 1282 1764 1280 1764 1149 1774 1041 1764 1039 1764 951 1774 918 1764 916 1764 914 1764 822 1774 767 1764 765 1764 716 1774 644 1764 642 1764 640 1764 599 1774 499 1764 497 1764 495 1764 477 1772 477 1805"/>
                        </Shape>
                        <String CONTENT="After that she took a large round pebble of the size of a man’s fist,"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l24" HPOS="334" VPOS="1831" WIDTH="1773" HEIGHT="49" BASELINE="336 1864 2107 1860" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 1864 336 1880 2105 1878 2107 1860 2101 1831 334 1833 336 1864"/>
                        </Shape>
                        <String CONTENT="set it upon the drum, and, blowing upon it from all sides, began to mumble"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l25" HPOS="334" VPOS="1881" WIDTH="1767" HEIGHT="59" BASELINE="336 1927 2101 1921" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 1927 336 1940 2099 1934 2101 1921 2097 1893 1844 1881 1842 1881 1762 1891 1729 1881 1727 1881 1725 1881 1045 1893 924 1883 922 1883 720 1895 405 1885 403 1885 334 1897 336 1927"/>
                        </Shape>
                        <String CONTENT="and snort in the same keˊlᴇ-like manner. She called our attention with signs, —"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l26" HPOS="336" VPOS="1940" WIDTH="1769" HEIGHT="67" BASELINE="338 1985 2105 1979" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="338 1985 338 1997 714 2007 716 2007 928 1997 2105 1997 2105 1979 2101 1952 1980 1952 1964 1940 1962 1940 1960 1940 1958 1940 1956 1940 1954 1940 1938 1950 1921 1940 1919 1940 1917 1940 1915 1940 1891 1950 1795 1940 1794 1940 1792 1940 1754 1950 1721 1940 1719 1940 1717 1940 1715 1940 1686 1950 1484 1942 1482 1942 1480 1942 1478 1942 1464 1952 1447 1942 1445 1942 1443 1942 1355 1952 1296 1942 1294 1942 1292 1942 1265 1952 1194 1942 1192 1942 1081 1952 1028 1942 1026 1942 1024 1942 1004 1952 967 1942 965 1942 963 1942 961 1942 922 1954 857 1944 855 1944 740 1954 618 1944 616 1944 614 1944 575 1954 520 1944 519 1944 517 1944 481 1954 336 1950 338 1985"/>
                        </Shape>
                        <String CONTENT="being in the possession of the keˊlᴇ, she had lost the faculty of human"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l27" HPOS="334" VPOS="2003" WIDTH="1769" HEIGHT="59" BASELINE="336 2044 2103 2040" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 2044 336 2056 2099 2062 2103 2040 2099 2015 1602 2003 1600 2003 1598 2003 1574 2013 1511 2003 1510 2003 1439 2013 1347 2003 1345 2003 1265 2013 1222 2003 1220 2003 1218 2003 1216 2003 1190 2015 1110 2005 1108 2005 844 2015 789 2005 787 2005 785 2005 752 2015 669 2005 667 2005 665 2005 640 2015 603 2005 601 2005 599 2005 495 2015 456 2005 454 2005 452 2005 334 2017 336 2044"/>
                        </Shape>
                        <String CONTENT="speech, and then began to wring the pebble with both hands. Then a"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l28" HPOS="334" VPOS="2062" WIDTH="1767" HEIGHT="64" BASELINE="336 2101 2101 2105" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 2101 334 2115 348 2124 350 2124 352 2124 354 2126 566 2126 566 2124 567 2124 569 2124 583 2115 609 2124 611 2124 613 2124 693 2115 885 2124 887 2124 889 2124 920 2115 959 2124 961 2124 963 2124 1259 2116 1306 2126 1308 2126 1406 2116 2097 2116 2101 2105 2101 2075 2077 2064 2076 2064 2074 2064 1982 2073 1915 2064 1913 2064 1645 2073 1500 2064 1498 2064 1496 2064 1494 2064 1478 2075 1296 2075 1269 2064 1267 2064 1265 2064 1263 2064 1231 2073 1192 2062 1190 2062 1188 2062 1102 2071 1038 2062 1036 2062 983 2073 787 2073 771 2062 769 2062 767 2062 765 2062 763 2062 724 2073 472 2073 446 2062 444 2062 442 2062 336 2069 336 2101"/>
                        </Shape>
                        <String CONTENT="continuous row of very small pebbles began to fall from her hands. This"/>
                    </TextLine>

                    <TextLine ID="mz_2-172_l29" HPOS="336" VPOS="2128" WIDTH="1767" HEIGHT="51" BASELINE="336 2163 2103 2163" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 2163 336 2177 2101 2179 2103 2163 2103 2128 336 2128 336 2163"/>
                        </Shape>
                        <String CONTENT="lasted for fully five minutes, till quite a heap of small pebbles was gathered"/>
                    </TextLine>

