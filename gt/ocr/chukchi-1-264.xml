                <TextBlock ID="text_1-264" HPOS="641" VPOS="573" WIDTH="1780" HEIGHT="2293"><TextLine ID="mz_1-264_l1" HPOS="1224" VPOS="578" WIDTH="619" HEIGHT="54" BASELINE="1224 610 1843 610" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1830 578 1224 578 1224 610 1224 632 1843 632 1843 610 1841 602 1830 578"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l2" HPOS="648" VPOS="573" WIDTH="104" HEIGHT="65" BASELINE="650 612 752 617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="734 573 732 573 730 573 650 580 650 612 648 634 650 636 652 636 652 638 654 638 656 638 659 638 749 628 752 617 752 582 736 573 734 573"/>
                        </Shape>
                        <String CONTENT="208"/>
                    </TextLine>
<TextLine ID="mz_1-264_l3" HPOS="641" VPOS="677" WIDTH="1776" HEIGHT="70" BASELINE="643 723 2417 718" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="643 723 643 744 1254 736 1352 747 1354 747 1414 736 1514 747 1516 747 1518 747 1520 747 1538 734 1731 744 1733 744 2120 734 2209 744 2211 744 2415 731 2417 718 2413 688 1585 677 1583 677 1525 688 752 679 749 679 641 690 643 723"/>
                        </Shape>
                        <String CONTENT="people the offering of a single drop when liquor is scarce is considered a"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l4" HPOS="646" VPOS="740" WIDTH="1771" HEIGHT="56" BASELINE="648 781 2417 777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 781 648 796 2415 792 2417 777 2413 749 706 740 704 740 646 751 648 781"/>
                        </Shape>
                        <String CONTENT="quite acceptable treat. They feel that it adds to the general enjoyment."/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l5" HPOS="646" VPOS="794" WIDTH="1771" HEIGHT="63" BASELINE="648 842 2417 835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 842 648 857 2415 851 2417 835 2413 807 2307 794 2304 794 2302 794 2300 794 2285 807 2049 807 2023 794 2021 794 2019 794 2016 794 2014 794 1999 807 1910 807 1854 794 1852 794 1850 794 1815 807 1791 796 1789 796 1787 796 1785 796 1756 807 1735 796 1733 796 1731 796 1728 796 1702 807 1679 796 1676 796 1674 796 1672 796 1640 807 1555 796 1553 796 1211 812 1066 812 1042 799 1040 799 1038 799 1035 799 1007 809 927 799 925 799 646 805 648 842"/>
                        </Shape>
                        <String CONTENT="The Chukchee do not approve of diluting alcohol with much water. I have"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l6" HPOS="643" VPOS="857" WIDTH="1774" HEIGHT="61" BASELINE="646 902 2417 898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 902 646 918 2415 913 2417 898 2413 870 2213 857 2211 857 2209 857 2174 868 2146 857 2144 857 2142 857 2036 868 2003 857 2001 857 1999 857 1997 857 1995 857 1977 870 1863 870 1776 857 1774 857 1772 857 1750 868 1715 857 1713 857 1711 857 1709 857 1666 868 1616 857 1614 857 1564 868 1533 857 1531 857 1529 857 1527 857 1499 870 687 859 685 859 682 859 643 872 646 902"/>
                        </Shape>
                        <String CONTENT="witnessed them drink large glasses of 95% alcohol, one drop of which was"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l7" HPOS="641" VPOS="922" WIDTH="1776" HEIGHT="56" BASELINE="643 963 2417 957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="643 963 643 978 2415 972 2417 957 2413 924 700 922 697 922 641 933 643 963"/>
                        </Shape>
                        <String CONTENT="sufficient to make my mouth burn for several minutes. Even the unrefined"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l8" HPOS="643" VPOS="978" WIDTH="1774" HEIGHT="59" BASELINE="646 1022 2417 1017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1022 646 1037 2415 1032 2417 1017 2413 985 678 978 676 978 674 978 643 987 646 1022"/>
                        </Shape>
                        <String CONTENT="alcohol of the Kolyma country is drunk undiluted when possible. The so-called"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l9" HPOS="652" VPOS="1037" WIDTH="1765" HEIGHT="60" BASELINE="654 1080 2417 1076" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1080 654 1097 2415 1093 2417 1076 2413 1045 665 1037 663 1037 661 1037 659 1037 659 1039 652 1043 654 1080"/>
                        </Shape>
                        <String CONTENT="“principal chief” of the Reindeer Chukchee, previously mentioned,¹ died sud-"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l10" HPOS="646" VPOS="1095" WIDTH="1771" HEIGHT="63" BASELINE="648 1141 2417 1136" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1141 648 1158 2415 1154 2417 1136 2413 1108 2352 1095 2350 1095 2348 1095 2324 1106 2084 1095 2081 1095 2079 1095 2040 1106 2010 1095 2008 1095 2006 1095 2003 1095 1973 1106 1889 1095 1886 1095 1884 1095 1858 1108 1689 1108 1661 1095 1659 1095 1657 1095 1572 1106 1546 1095 1544 1095 1542 1095 1445 1108 1375 1097 1373 1097 981 1108 892 1097 890 1097 834 1108 799 1097 797 1097 795 1097 793 1097 769 1108 665 1097 663 1097 661 1097 659 1097 646 1106 648 1141"/>
                        </Shape>
                        <String CONTENT="denly in 1898 on the day of his arrival at the town of Sredne-Kolymsk, after"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l11" HPOS="650" VPOS="1158" WIDTH="899" HEIGHT="58" BASELINE="650 1201 1549 1201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1201 650 1216 1549 1216 1549 1201 1549 1169 1527 1158 1525 1158 1523 1158 1520 1158 1490 1169 1477 1158 1475 1158 1473 1158 1471 1158 1468 1158 1438 1169 1416 1158 1414 1158 1412 1158 1360 1169 1336 1158 1334 1158 1332 1158 1330 1158 1328 1158 1328 1160 1317 1169 1258 1158 1256 1158 1122 1169 1094 1158 1092 1158 1089 1158 1038 1169 1025 1158 1022 1158 1020 1158 936 1158 934 1158 931 1158 929 1158 929 1160 918 1171 650 1171 650 1201"/>
                        </Shape>
                        <String CONTENT="a generous drink of unrectified alcohol."/>
                    </TextLine>
<TextLine ID="mz_1-264_l12" HPOS="756" VPOS="1216" WIDTH="1663" HEIGHT="61" BASELINE="756 1260 2419 1260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="756 1260 756 1277 2419 1277 2419 1260 2419 1227 2387 1216 2385 1216 2382 1216 2294 1227 2179 1216 2177 1216 2122 1227 2099 1216 2097 1216 2094 1216 2034 1227 1993 1216 1990 1216 1988 1216 1986 1216 1956 1227 1876 1216 1873 1216 1871 1216 1839 1227 1726 1216 1724 1216 1722 1216 1683 1227 1644 1216 1642 1216 1640 1216 1637 1216 1609 1227 756 1223 756 1260"/>
                        </Shape>
                        <String CONTENT="The Reindeer people are more eager for liquor than the Maritime. This"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l13" HPOS="646" VPOS="1277" WIDTH="1771" HEIGHT="61" BASELINE="648 1322 2417 1316" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1322 648 1338 2415 1333 2417 1316 2413 1288 1826 1277 1824 1277 1821 1277 1819 1277 1800 1288 1304 1279 1302 1279 1232 1290 773 1281 771 1281 646 1292 648 1322"/>
                        </Shape>
                        <String CONTENT="may be because they have less chance to satisfy their craving. When they"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l14" HPOS="648" VPOS="1346" WIDTH="1769" HEIGHT="50" BASELINE="648 1379 2417 1379" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1379 648 1396 2417 1396 2417 1379 2417 1351 648 1346 648 1379"/>
                        </Shape>
                        <String CONTENT="know that there is some strong liquor within their reach, most of them are"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l15" HPOS="648" VPOS="1409" WIDTH="1769" HEIGHT="48" BASELINE="648 1439 2417 1439" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1439 648 1457 2417 1457 2417 1439 2417 1409 648 1409 648 1439"/>
                        </Shape>
                        <String CONTENT="ready to pay an exorbitant price for it. I was assured by many that if necessary"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l16" HPOS="648" VPOS="1470" WIDTH="1702" HEIGHT="45" BASELINE="648 1500 2350 1500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1500 648 1515 2348 1515 2350 1500 2348 1470 648 1470 648 1500"/>
                        </Shape>
                        <String CONTENT="they would be quite ready to give a piece of their own flesh for a drink."/>
                    </TextLine>
<TextLine ID="mz_1-264_l17" HPOS="754" VPOS="1517" WIDTH="1663" HEIGHT="59" BASELINE="754 1561 2417 1561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="754 1561 754 1576 2417 1576 2417 1561 2417 1530 2354 1517 2352 1517 2077 1528 2029 1517 2027 1517 2025 1517 2023 1517 1986 1528 1945 1517 1943 1517 1941 1517 1938 1517 1895 1528 1817 1517 1815 1517 1813 1517 1785 1528 1756 1517 1754 1517 1752 1517 1672 1528 1592 1517 1590 1517 1533 1528 1510 1517 1507 1517 1505 1517 1503 1517 1458 1528 1371 1517 1369 1517 1300 1528 1265 1517 1263 1517 1261 1517 1165 1528 1120 1517 1118 1517 1115 1517 1113 1517 1074 1528 1016 1517 1014 1517 899 1528 860 1517 858 1517 856 1517 853 1517 827 1528 769 1517 767 1517 765 1517 762 1517 754 1524 754 1561"/>
                        </Shape>
                        <String CONTENT="Small wooden kegs, in which the liquor is brought from the Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l18" HPOS="641" VPOS="1578" WIDTH="1778" HEIGHT="56" BASELINE="643 1621 2419 1617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="643 1621 643 1634 2419 1632 2419 1617 2415 1587 726 1578 723 1578 641 1589 643 1621"/>
                        </Shape>
                        <String CONTENT="settlements, are carefully washed with hot water, and if possible boiled in large"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l19" HPOS="1588" VPOS="1647" WIDTH="829" HEIGHT="59" BASELINE="1588 1680 2417 1680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1588 1680 1588 1695 2088 1695 2099 1704 2099 1706 2101 1706 2103 1706 2105 1706 2417 1695 2417 1680 2417 1649 1588 1647 1588 1680"/>
                        </Shape>
                        <String CONTENT="kettles. I have seen people sitting"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l20" HPOS="1583" VPOS="1697" WIDTH="834" HEIGHT="67" BASELINE="1585 1740 2417 1736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1585 1740 1585 1753 1921 1764 1923 1764 1925 1764 1928 1764 1928 1762 1938 1753 2220 1762 2222 1762 2224 1762 2226 1762 2242 1753 2250 1760 2250 1762 2252 1762 2255 1762 2257 1764 2372 1764 2372 1762 2374 1762 2417 1749 2417 1736 2413 1706 1999 1697 1997 1697 1995 1697 1947 1708 1724 1699 1722 1699 1583 1710 1585 1740"/>
                        </Shape>
                        <String CONTENT="around a keg, which finally refused"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l21" HPOS="1585" VPOS="1771" WIDTH="834" HEIGHT="45" BASELINE="1585 1799 2419 1799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1585 1799 1585 1816 2419 1816 2419 1799 2419 1771 1585 1771 1585 1799"/>
                        </Shape>
                        <String CONTENT="to yield any more, weep bitter tears"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l22" HPOS="1588" VPOS="1829" WIDTH="703" HEIGHT="46" BASELINE="1588 1857 2291 1857" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1588 1857 1588 1875 2291 1875 2291 1857 2291 1829 1588 1829 1588 1857"/>
                        </Shape>
                        <String CONTENT="over the end of their festivity."/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l23" HPOS="1696" VPOS="1885" WIDTH="721" HEIGHT="50" BASELINE="1696 1918 2417 1918" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1696 1918 1696 1935 2417 1935 2417 1918 2417 1885 1696 1885 1696 1918"/>
                        </Shape>
                        <String CONTENT="Between the native villages and"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l24" HPOS="1583" VPOS="1948" WIDTH="836" HEIGHT="56" BASELINE="1583 1976 2419 1976" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1583 1976 1583 1989 1676 2004 1679 2004 1681 2004 1737 1991 1854 1991 1893 2004 1895 2004 1897 2004 1988 1991 2302 1991 2389 2004 2391 2004 2393 2004 2419 1989 2419 1976 2419 1948 1583 1948 1583 1976"/>
                        </Shape>
                        <String CONTENT="camps the liquor is carried in bags"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l25" HPOS="1583" VPOS="1996" WIDTH="836" HEIGHT="67" BASELINE="1585 2039 2419 2035" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1585 2039 1585 2052 1873 2063 1876 2063 1878 2063 1880 2063 1895 2052 1990 2061 1993 2061 2146 2050 2183 2061 2185 2061 2187 2061 2190 2061 2218 2050 2226 2059 2226 2061 2229 2061 2231 2061 2233 2063 2400 2063 2400 2061 2402 2061 2404 2061 2419 2048 2419 2035 2415 2007 2066 1996 2064 1996 1583 2009 1585 2039"/>
                        </Shape>
                        <String CONTENT="made of the stomachs or bladders"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l26" HPOS="1583" VPOS="2054" WIDTH="834" HEIGHT="70" BASELINE="1585 2100 2417 2095" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1585 2100 1585 2113 1804 2124 1806 2124 1808 2124 1811 2124 1824 2113 1995 2121 1997 2121 1999 2121 2001 2121 2014 2113 2025 2121 2025 2124 2027 2124 2029 2124 2032 2124 2034 2124 2068 2113 2112 2124 2114 2124 2116 2124 2118 2124 2155 2111 2252 2124 2255 2124 2257 2124 2259 2124 2274 2111 2330 2121 2333 2121 2415 2108 2417 2095 2415 2067 2367 2054 2365 2054 2363 2054 2120 2065 2034 2054 2032 2054 1943 2067 1728 2056 1726 2056 1657 2067 1627 2056 1624 2056 1622 2056 1620 2056 1583 2069 1585 2100"/>
                        </Shape>
                        <String CONTENT="of various animals (Fig. 125). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l27" HPOS="1585" VPOS="2128" WIDTH="834" HEIGHT="54" BASELINE="1588 2160 2419 2156" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1588 2160 1588 2171 1804 2182 1806 2182 1951 2171 1995 2182 1997 2182 1999 2182 2081 2169 2400 2180 2402 2180 2404 2180 2406 2180 2419 2167 2419 2156 2415 2128 1585 2128 1588 2160"/>
                        </Shape>
                        <String CONTENT="bags resemble those used by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l28" HPOS="1583" VPOS="2175" WIDTH="836" HEIGHT="68" BASELINE="1585 2219 2419 2214" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1585 2219 1585 2234 2261 2243 2263 2243 2265 2243 2268 2243 2268 2240 2278 2232 2417 2232 2419 2214 2415 2186 2008 2175 2006 2175 2003 2175 2001 2175 2001 2178 1999 2178 1993 2186 1605 2178 1603 2178 1601 2178 1598 2178 1583 2184 1585 2219"/>
                        </Shape>
                        <String CONTENT="Alaskan Eskimo for carrying water"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l29" HPOS="650" VPOS="2238" WIDTH="1769" HEIGHT="57" BASELINE="650 2279 2419 2275" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2279 650 2295 2417 2290 2419 2275 2415 2240 762 2238 760 2238 661 2249 650 2279"/>
                        </Shape>
                        <String CONTENT="or oil,² but they do not have an ivory nozzle, and are merely tied around"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l30" HPOS="648" VPOS="2297" WIDTH="537" HEIGHT="58" BASELINE="650 2338 1185 2342" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2338 648 2351 1180 2355 1185 2342 1183 2312 1070 2299 1068 2299 966 2310 918 2297 916 2297 914 2297 912 2297 873 2308 840 2297 838 2297 836 2297 834 2297 801 2310 702 2310 691 2299 691 2297 689 2297 687 2297 685 2297 682 2297 663 2301 650 2338"/>
                        </Shape>
                        <String CONTENT="the neck with a string."/>
                    </TextLine>
<TextLine ID="mz_1-264_l31" HPOS="754" VPOS="2357" WIDTH="1667" HEIGHT="59" BASELINE="756 2401 2421 2392" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="756 2401 756 2416 2419 2409 2421 2392 2415 2357 754 2364 756 2401"/>
                        </Shape>
                        <String CONTENT="The Maritime Koryak and the Kamchadal sometimes distil a kind of"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l32" HPOS="650" VPOS="2416" WIDTH="1767" HEIGHT="60" BASELINE="650 2461 2417 2455" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2461 650 2476 2415 2470 2417 2455 2413 2424 1239 2416 1237 2416 1183 2427 661 2418 659 2418 656 2418 650 2461"/>
                        </Shape>
                        <String CONTENT="brandy from berries of Vaccinium uliginosum. They use for this a large iron"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l33" HPOS="646" VPOS="2481" WIDTH="1773" HEIGHT="56" BASELINE="648 2520 2419 2511" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2520 648 2537 2417 2528 2419 2511 2413 2481 646 2483 648 2520"/>
                        </Shape>
                        <String CONTENT="kettle with a wooden cover pasted over with dough. An old gun-barrel serves"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l34" HPOS="646" VPOS="2539" WIDTH="1773" HEIGHT="56" BASELINE="648 2583 2419 2574" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2583 648 2595 2417 2589 2419 2574 2415 2546 1089 2539 1087 2539 1085 2539 1050 2550 667 2541 665 2541 663 2541 661 2541 646 2548 648 2583"/>
                        </Shape>
                        <String CONTENT="as a condenser. This art was learned from the cossacks, though at present"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l35" HPOS="646" VPOS="2593" WIDTH="1771" HEIGHT="61" BASELINE="648 2639 2417 2634" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2639 648 2654 2415 2650 2417 2634 2415 2606 2372 2593 2369 2593 2367 2593 2302 2604 1735 2593 1733 2593 1663 2604 1531 2593 1529 2593 1527 2593 1494 2606 1059 2595 1057 2595 877 2606 756 2595 754 2595 752 2595 726 2606 674 2595 672 2595 669 2595 646 2606 648 2639"/>
                        </Shape>
                        <String CONTENT="the latter are strictly forbidden to distil in private any strong liquor. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l36" HPOS="646" VPOS="2656" WIDTH="1773" HEIGHT="69" BASELINE="648 2697 2419 2693" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2697 648 2715 1527 2725 1529 2725 1588 2715 2144 2723 2146 2723 2419 2710 2419 2693 2415 2658 663 2656 661 2656 659 2656 656 2656 646 2663 648 2697"/>
                        </Shape>
                        <String CONTENT="Chukchee, however, do not have enough berries for this purpose, or the skill"/>
                    </TextLine>

                    <TextLine ID="mz_1-264_l37" HPOS="648" VPOS="2715" WIDTH="448" HEIGHT="60" BASELINE="650 2756 1096 2760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2756 648 2771 1092 2775 1096 2760 1094 2730 873 2715 871 2715 869 2715 838 2728 769 2728 758 2717 758 2715 756 2715 754 2715 752 2715 661 2723 650 2756"/>
                        </Shape>
                        <String CONTENT="to thus distil them."/>
                    </TextLine>
<TextLine ID="mz_1-264_l38" HPOS="754" VPOS="2808" WIDTH="216" HEIGHT="58" BASELINE="756 2836 970 2840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="756 2836 754 2851 862 2866 864 2866 968 2855 970 2840 970 2812 756 2808 756 2836"/>
                        </Shape>
                        <String CONTENT="¹ See p. 73."/>
                    </TextLine>

