                            <Polygon POINTS="358 2106 358 2121 2124 2117 2126 2102 2122 2065 1262 2065 1260 2065 1175 2074 461 2067 459 2067 356 2076 358 2106"/>
                        </Shape>
                        <String CONTENT="marriages, some were living in the husbands’ families, and some in those of"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l29" HPOS="354" VPOS="2123" WIDTH="1770" HEIGHT="64" BASELINE="356 2168 2124 2162" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2168 356 2180 989 2187 991 2187 993 2187 995 2187 1011 2178 1331 2178 1502 2187 1504 2187 1506 2187 1551 2176 1693 2185 1695 2185 1697 2185 1730 2176 1828 2176 1843 2185 1845 2185 1847 2185 1849 2185 2122 2176 2124 2162 2120 2137 2057 2137 2040 2123 2038 2123 2036 2123 2034 2123 2032 2123 2005 2133 1976 2123 1974 2123 1972 2123 1970 2123 1937 2137 1674 2137 1578 2123 1576 2123 1500 2137 1173 2125 1171 2125 1116 2137 1099 2125 1097 2125 1095 2125 1030 2125 1028 2125 1027 2125 1025 2125 1007 2137 828 2127 826 2127 824 2127 777 2139 761 2127 760 2127 758 2127 666 2127 664 2127 592 2139 504 2127 502 2127 436 2139 378 2127 376 2127 374 2127 372 2127 354 2137 356 2168"/>
                        </Shape>
                        <String CONTENT="the wives. Such children, left without a proper home, are regarded as"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l30" HPOS="354" VPOS="2183" WIDTH="1766" HEIGHT="59" BASELINE="356 2226 2120 2222" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2226 356 2242 2118 2242 2120 2222 2116 2195 2026 2183 2024 2183 1974 2193 1849 2183 1847 2183 1757 2193 1691 2183 1689 2183 1687 2183 1660 2193 1619 2183 1617 2183 1615 2183 1494 2193 1410 2183 1409 2183 1214 2195 1192 2185 1190 2185 1188 2185 1134 2195 1046 2185 1044 2185 980 2195 966 2185 964 2185 962 2185 960 2185 958 2185 925 2195 867 2185 865 2185 810 2195 721 2185 719 2185 717 2185 678 2195 524 2185 522 2185 354 2191 356 2226"/>
                        </Shape>
                        <String CONTENT="belonging to the entire family, and are much cared for by all its members."/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l31" HPOS="360" VPOS="2246" WIDTH="1501" HEIGHT="54" BASELINE="360 2285 1861 2285" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2285 360 2300 1859 2300 1861 2285 1859 2258 1687 2258 1674 2246 1672 2246 1670 2246 1668 2246 1564 2256 1389 2246 1387 2246 1385 2246 1352 2256 1243 2246 1241 2246 1239 2246 1206 2256 1132 2246 1130 2246 1032 2256 1009 2246 1007 2246 1005 2246 876 2256 360 2250 360 2285"/>
                        </Shape>
                        <String CONTENT="The same applies to natural children borne by unmarried women."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-064_r6" HPOS="357" VPOS="2313" WIDTH="1782" HEIGHT="119" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="357 2313 2139 2313 2139 2432 357 2432"/>
                    </Shape>
                    <TextLine ID="mz_3-064_l32" HPOS="463" VPOS="2300" WIDTH="1661" HEIGHT="69" BASELINE="465 2347 2124 2341" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="465 2347 465 2359 658 2369 660 2369 662 2369 687 2359 917 2359 999 2369 1001 2369 1110 2357 1286 2357 1303 2367 1305 2367 1307 2367 1309 2367 1598 2355 1724 2365 1726 2365 2122 2357 2124 2341 2120 2314 1981 2314 1956 2300 1954 2300 1952 2300 1950 2300 1948 2300 1929 2312 1831 2300 1829 2300 1828 2300 1785 2314 1549 2314 1436 2302 1434 2302 1352 2312 1297 2302 1295 2302 1294 2302 1262 2314 1208 2302 1206 2302 1204 2302 1202 2302 1190 2312 1157 2302 1155 2302 1153 2302 1151 2302 1104 2314 1046 2302 1044 2302 921 2316 855 2304 853 2304 676 2316 485 2304 483 2304 481 2304 479 2304 463 2314 465 2347"/>
                        </Shape>
                        <String CONTENT="Polygyny. — The majority of the Chukchee are monogamists; in some"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l33" HPOS="354" VPOS="2373" WIDTH="1741" HEIGHT="46" BASELINE="356 2404 2095 2400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2404 356 2419 2093 2417 2095 2400 2091 2373 354 2373 356 2404"/>
                        </Shape>
                        <String CONTENT="localities, however, one-third and more, of all the marriages, are polygynous."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-064_r7" HPOS="357" VPOS="2432" WIDTH="1782" HEIGHT="235" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="357 2432 2139 2432 2139 2667 357 2667"/>
                    </Shape>
                    <TextLine ID="mz_3-064_l34" HPOS="465" VPOS="2421" WIDTH="1657" HEIGHT="59" BASELINE="467 2464 2122 2460" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="467 2464 467 2480 2120 2476 2122 2460 2120 2431 2104 2421 2102 2421 2100 2421 2098 2421 2046 2433 1943 2433 1925 2421 1923 2421 1921 2421 1919 2421 1917 2421 1890 2433 1551 2433 1527 2421 1525 2421 1523 2421 1286 2433 1233 2423 1231 2423 1163 2435 988 2435 972 2423 970 2423 968 2423 966 2423 964 2423 941 2433 925 2423 923 2423 921 2423 828 2423 826 2423 824 2423 822 2423 808 2433 721 2423 719 2423 465 2429 467 2464"/>
                        </Shape>
                        <String CONTENT="The Reindeer Chukchee generally ascribe polygyny to economic consid-"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l35" HPOS="354" VPOS="2482" WIDTH="1768" HEIGHT="58" BASELINE="356 2526 2122 2521" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2526 356 2540 2120 2538 2122 2521 2120 2491 2102 2482 2100 2482 2098 2482 2096 2482 2095 2482 2065 2491 2038 2482 2036 2482 2034 2482 2032 2482 2003 2491 1915 2482 1913 2482 1859 2491 1510 2484 1508 2484 1506 2484 1504 2484 1488 2493 1013 2484 1011 2484 913 2495 444 2486 442 2486 354 2497 356 2526"/>
                        </Shape>
                        <String CONTENT="erations. “If I possess one herd, I need but one house and one wife to look"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l36" HPOS="354" VPOS="2540" WIDTH="1768" HEIGHT="61" BASELINE="356 2587 2122 2579" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="356 2587 356 2601 2120 2595 2122 2579 2120 2552 2095 2540 2093 2540 2091 2540 2034 2550 2013 2540 2011 2540 2009 2540 1909 2550 1882 2540 1880 2540 1878 2540 1876 2540 1874 2540 1859 2552 1677 2552 1442 2542 1440 2542 1438 2542 1436 2542 1420 2554 1309 2554 1274 2542 1272 2542 1270 2542 1268 2542 1235 2554 1219 2544 1218 2544 1216 2544 1214 2544 1169 2554 1132 2544 1130 2544 1128 2544 1126 2544 1097 2554 569 2546 567 2546 565 2546 563 2546 547 2556 391 2546 389 2546 387 2546 354 2558 356 2587"/>
                        </Shape>
                        <String CONTENT="after it; if, however, I own two herds, I must have two separate households"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l37" HPOS="356" VPOS="2602" WIDTH="1764" HEIGHT="55" BASELINE="358 2645 2120 2641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="358 2645 358 2657 2120 2657 2120 2641 2116 2614 2050 2602 2048 2602 2001 2612 1829 2602 1828 2602 1783 2612 1750 2602 1748 2602 1746 2602 1744 2602 1714 2612 1687 2602 1685 2602 1683 2602 1436 2612 1403 2602 1401 2602 1399 2602 1397 2602 1364 2612 1239 2602 1237 2602 1235 2602 1233 2602 1216 2614 1184 2604 1182 2604 1180 2604 802 2614 742 2604 740 2604 738 2604 736 2604 721 2616 463 2616 430 2604 428 2604 426 2604 356 2616 358 2645"/>
                        </Shape>
                        <String CONTENT="and a woman for each of them.” There is some truth in this assertion."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-064_r8" HPOS="357" VPOS="2698" WIDTH="1782" HEIGHT="406" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="357 2698 2139 2698 2139 3104 357 3104"/>
                    </Shape>
                    <TextLine ID="mz_3-064_l38" HPOS="465" VPOS="2702" WIDTH="1659" HEIGHT="45" BASELINE="467 2727 2124 2731" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="467 2727 465 2741 2120 2747 2124 2731 2122 2706 467 2702 467 2727"/>
                        </Shape>
                        <String CONTENT="¹ Easy divorce exists also among the American Eskimo. Murdoch (Point Barrow Eskimo, p. 418) says,"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l39" HPOS="360" VPOS="2745" WIDTH="1758" HEIGHT="45" BASELINE="362 2774 2118 2768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2774 362 2790 2116 2788 2118 2768 2112 2745 360 2749 362 2774"/>
                        </Shape>
                        <String CONTENT="“Easy and unceremonial divorce appears to be the usual custom among Eskimo generally. The same appears"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l40" HPOS="360" VPOS="2788" WIDTH="1762" HEIGHT="44" BASELINE="362 2819 2122 2811" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2819 362 2832 2120 2829 2122 2811 2116 2788 360 2793 362 2819"/>
                        </Shape>
                        <String CONTENT="to have been the case in Greenland. Cranz says, ‘Such quarrels and separations only happen between the"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l41" HPOS="358" VPOS="2830" WIDTH="1762" HEIGHT="47" BASELINE="360 2862 2120 2854" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2862 360 2877 2118 2873 2120 2854 2114 2830 358 2836 360 2862"/>
                        </Shape>
                        <String CONTENT="people in their young age. The older they grow, the more they love each other.’” In a similar way Lucien"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l42" HPOS="360" VPOS="2871" WIDTH="1760" HEIGHT="47" BASELINE="362 2903 2120 2895" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2903 362 2918 2118 2912 2120 2895 2114 2871 360 2877 362 2903"/>
                        </Shape>
                        <String CONTENT="M. Turner (Hudson Bay Eskimo, p. 189) says of the Hudson Bay Eskimo, “A man seldom keeps a wife for"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l43" HPOS="362" VPOS="2914" WIDTH="1760" HEIGHT="47" BASELINE="364 2947 2122 2938" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2947 364 2961 2120 2953 2122 2938 2116 2914 362 2922 364 2947"/>
                        </Shape>
                        <String CONTENT="a number of years.... In rare instances, where there is compatibility of temper, the pair remain together"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l44" HPOS="360" VPOS="2957" WIDTH="1762" HEIGHT="41" BASELINE="362 2986 2122 2981" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2118 2969 2116 2957 360 2961 362 2986 362 2998 2122 2994 2122 2981 2120 2975 2118 2969"/>
                        </Shape>
                        <String CONTENT="for life.” In the same way the Chukchee marriage is easily dissolved in its first period, but grows in force"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l45" HPOS="362" VPOS="2998" WIDTH="1758" HEIGHT="47" BASELINE="364 3029 2120 3021" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2116 3010 2106 2998 362 3004 364 3029 364 3045 2120 3037 2120 3021 2116 3006 2116 3010"/>
                        </Shape>
                        <String CONTENT="with the course of time. Franz Boas (Central Eskimo, p. 579) mentions also that among the Central Eskimo"/>
                    </TextLine>

                    <TextLine ID="mz_3-064_l46" HPOS="360" VPOS="3043" WIDTH="891" HEIGHT="47" BASELINE="362 3072 1251 3066" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 3072 362 3090 1251 3084 1251 3066 1245 3043 360 3047 362 3072"/>
                        </Shape>
                        <String CONTENT="divorce may be easily commanded by the wife’s mother."/>
                    </TextLine>
</TextBlock>
