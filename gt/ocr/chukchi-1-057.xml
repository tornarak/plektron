                    </Shape>
                    <TextLine ID="mz_1-057_l22" HPOS="493" VPOS="1874" WIDTH="1668" HEIGHT="61" BASELINE="495 1922 2161 1918" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="495 1922 495 1935 2159 1931 2161 1918 2159 1887 2115 1874 2113 1874 2111 1874 2109 1874 2085 1887 1981 1887 1964 1874 1962 1874 1959 1874 1957 1874 1884 1885 1853 1874 1851 1874 1849 1874 1760 1885 1739 1874 1736 1874 1734 1874 1732 1874 1708 1885 1682 1874 1680 1874 1678 1874 1578 1885 1483 1874 1481 1874 1479 1874 1442 1885 1414 1874 1412 1874 1409 1874 1407 1874 1373 1885 1329 1874 1327 1874 1325 1874 1323 1874 1321 1874 1299 1887 1110 1877 1108 1877 1106 1877 1078 1887 1065 1877 1063 1877 1061 1877 970 1877 968 1877 965 1877 963 1877 950 1887 892 1877 890 1877 820 1887 545 1877 543 1877 493 1885 495 1922"/>
                        </Shape>
                        <String CONTENT="FERTILITY. — The Chukchee are the healthiest of the tribes in north-"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l23" HPOS="389" VPOS="1937" WIDTH="1774" HEIGHT="59" BASELINE="389 1980 2163 1980" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2154 1946 2003 1948 1972 1937 1970 1937 1968 1937 1845 1948 1819 1937 1816 1937 1814 1937 1745 1948 1697 1937 1695 1937 1693 1937 1624 1948 1505 1937 1502 1937 1500 1937 1498 1937 1483 1950 1308 1950 1269 1937 1266 1937 1264 1937 1119 1948 965 1937 963 1937 961 1937 926 1948 807 1937 805 1937 727 1948 712 1937 710 1937 708 1937 589 1937 586 1937 584 1937 582 1937 567 1950 389 1950 389 1980 389 1996 2163 1996 2163 1980 2161 1961 2154 1946"/>
                        </Shape>
                        <String CONTENT="eastern Siberia. Their families contain more children than those of any of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l24" HPOS="389" VPOS="1996" WIDTH="1767" HEIGHT="60" BASELINE="389 2039 2156 2039" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2039 389 2056 2154 2056 2156 2039 2152 2004 1949 2006 1918 1996 1916 1996 1914 1996 1912 1996 1871 2006 1845 1996 1842 1996 1840 1996 1838 1996 1801 2006 1767 1996 1765 1996 1762 1996 1645 2006 1554 1996 1552 1996 1502 2006 1476 1996 1474 1996 1472 1996 1470 1996 1429 2006 1399 1996 1396 1996 1394 1996 1392 1996 1390 1996 1373 2009 1184 2009 1154 1996 1152 1996 1149 1996 1074 2006 1009 1996 1007 1996 935 2006 920 1996 918 1996 916 1996 807 1996 805 1996 803 1996 801 1996 783 2009 677 2009 582 1996 580 1996 500 2006 469 1996 467 1996 465 1996 463 1996 441 2006 420 1996 417 1996 415 1996 413 1996 389 2006 389 2039"/>
                        </Shape>
                        <String CONTENT="their neighbors. While taking the census in the Kolyma district in 1897, I"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l25" HPOS="387" VPOS="2056" WIDTH="1767" HEIGHT="63" BASELINE="389 2102 2154 2097" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2102 389 2119 2152 2119 2154 2097 2150 2067 1557 2056 1554 2056 387 2069 389 2102"/>
                        </Shape>
                        <String CONTENT="came across sèveral families having five, seven, and even nine children living."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l26" HPOS="394" VPOS="2117" WIDTH="1765" HEIGHT="58" BASELINE="394 2160 2159 2160" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="394 2160 394 2175 2159 2175 2159 2160 2159 2130 1975 2117 1972 2117 1970 2117 1938 2128 1825 2117 1823 2117 1745 2128 1669 2117 1667 2117 1576 2128 1498 2117 1496 2117 1494 2117 1461 2128 1388 2117 1386 2117 1383 2117 1349 2128 1275 2117 1273 2117 1195 2128 1143 2117 1141 2117 1046 2128 994 2117 883 2117 881 2117 879 2117 877 2117 864 2128 818 2117 816 2117 814 2117 721 2128 394 2123 394 2160"/>
                        </Shape>
                        <String CONTENT="Ten per cent of the families had not less than five children living. One man"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l27" HPOS="389" VPOS="2182" WIDTH="1774" HEIGHT="54" BASELINE="391 2221 2163 2216" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="391 2221 391 2236 2161 2232 2163 2216 2156 2182 389 2184 391 2221"/>
                        </Shape>
                        <String CONTENT="had by two wives twelve children living. Another, by seven wives (three of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l28" HPOS="387" VPOS="2234" WIDTH="934" HEIGHT="60" BASELINE="389 2277 1321 2281" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2277 387 2290 1316 2294 1321 2281 1318 2249 1011 2236 1009 2236 1007 2236 1004 2236 991 2249 857 2249 816 2234 814 2234 812 2234 809 2234 786 2245 768 2234 766 2234 764 2234 762 2234 760 2234 738 2245 699 2234 697 2234 695 2234 693 2234 690 2234 673 2245 641 2234 638 2234 636 2234 634 2234 606 2245 554 2234 552 2234 550 2234 547 2234 530 2245 389 2245 389 2277"/>
                        </Shape>
                        <String CONTENT="them dead), had fourteen children living."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r5" HPOS="386" VPOS="2304" WIDTH="1778" HEIGHT="777" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="386 2304 2164 2304 2164 3081 386 3081"/>
                    </Shape>
                    <TextLine ID="mz_1-057_l29" HPOS="493" VPOS="2305" WIDTH="1668" HEIGHT="50" BASELINE="495 2338 2161 2342" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="495 2338 493 2351 2156 2355 2161 2342 2159 2305 495 2305 495 2338"/>
                        </Shape>
                        <String CONTENT="On the Pacific coast, among the Maritime Chukchee, one woman had"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l30" HPOS="391" VPOS="2366" WIDTH="1770" HEIGHT="52" BASELINE="391 2400 2161 2400" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="391 2400 391 2418 2161 2418 2161 2400 2161 2370 391 2366 391 2400"/>
                        </Shape>
                        <String CONTENT="had thirteen children (seven living and six dead); another one, eleven (three"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l31" HPOS="391" VPOS="2418" WIDTH="1765" HEIGHT="58" BASELINE="391 2461 2156 2461" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="391 2461 391 2476 2156 2476 2156 2461 2156 2431 2040 2431 2024 2418 2022 2418 2020 2418 2018 2418 2016 2418 1979 2429 1940 2418 1938 2418 1936 2418 1933 2418 1905 2429 1823 2418 1821 2418 1819 2418 1790 2429 1777 2418 1775 2418 1773 2418 1771 2418 1717 2429 1617 2418 1615 2418 1535 2429 1470 2418 1468 2418 1466 2418 1418 2429 1344 2418 1342 2418 1340 2418 1303 2429 1199 2418 1197 2418 1091 2429 1061 2418 1059 2418 1056 2418 983 2429 920 2418 822 2418 820 2418 818 2418 816 2418 803 2429 747 2418 744 2418 671 2429 636 2418 634 2418 632 2418 391 2422 391 2461"/>
                        </Shape>
                        <String CONTENT="living and eight dead); still another, nine (five living and four dead); etc."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l32" HPOS="389" VPOS="2474" WIDTH="1772" HEIGHT="63" BASELINE="391 2520 2161 2515" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="391 2520 391 2537 2159 2533 2161 2515 2159 2487 2124 2474 2122 2474 2120 2474 2040 2485 1810 2474 1808 2474 1806 2474 1803 2474 1788 2487 1663 2487 1628 2474 1626 2474 1624 2474 1544 2485 1518 2474 1515 2474 1513 2474 1511 2474 1509 2474 1494 2485 1481 2474 1479 2474 1476 2474 1386 2474 1383 2474 1308 2485 1277 2474 1275 2474 1273 2474 1271 2474 1269 2474 1253 2485 1160 2476 1158 2476 1156 2476 1154 2476 1141 2487 1095 2476 1093 2476 1091 2476 1089 2476 1059 2487 753 2476 751 2476 695 2487 597 2476 595 2476 593 2476 591 2476 578 2487 563 2476 560 2476 558 2476 402 2476 400 2476 398 2476 396 2476 396 2478 389 2483 391 2520"/>
                        </Shape>
                        <String CONTENT="Several times, chiefly among the Reindeer Chukchee, I met with twins. This"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l33" HPOS="387" VPOS="2535" WIDTH="1774" HEIGHT="60" BASELINE="389 2580 2161 2576" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2580 389 2595 2159 2593 2161 2576 2159 2548 2122 2535 2120 2535 2118 2535 2046 2546 1570 2535 1567 2535 1565 2535 1541 2548 1383 2548 1349 2535 1347 2535 1344 2535 1342 2535 1321 2546 1279 2535 1277 2535 1275 2535 1184 2548 1115 2537 1113 2537 1110 2537 1078 2548 1024 2537 1022 2537 1020 2537 991 2548 924 2537 922 2537 809 2548 608 2537 606 2537 543 2548 409 2537 407 2537 404 2537 402 2537 387 2546 389 2580"/>
                        </Shape>
                        <String CONTENT="degree of fertility results in the steady increase of the Chukchee, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l34" HPOS="387" VPOS="2595" WIDTH="1776" HEIGHT="61" BASELINE="389 2641 2163 2636" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2641 389 2656 2161 2652 2163 2636 2159 2606 1305 2595 1303 2595 1301 2595 1271 2606 480 2598 478 2598 387 2608 389 2641"/>
                        </Shape>
                        <String CONTENT="among the Reindeer division, in spite of the contagious diseases which ravage"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l35" HPOS="389" VPOS="2671" WIDTH="1774" HEIGHT="43" BASELINE="389 2701 2163 2701" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 2701 389 2714 2163 2714 2163 2701 2163 2671 389 2671 389 2701"/>
                        </Shape>
                        <String CONTENT="the country once every ten or fifteen years. It is interesting to note that"/>
                    </TextLine>

