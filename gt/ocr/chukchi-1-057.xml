                    <TextLine ID="mz_1-057_l3" HPOS="491" VPOS="746" WIDTH="1665" HEIGHT="48" BASELINE="491 779 2156 779" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="491 779 491 794 2156 794 2156 779 2156 746 491 746 491 779"/>
                        </Shape>
                        <String CONTENT="MIXTURE WITH OTHER TRIBES. — Notwithstanding considerable diversity"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l4" HPOS="381" VPOS="794" WIDTH="1773" HEIGHT="61" BASELINE="383 840 2154 835" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 811 383 840 383 855 2152 853 2154 835 2150 805 1277 794 1275 794 1273 794 1249 805 398 796 381 811"/>
                        </Shape>
                        <String CONTENT="in the features of the Chukchee, I doubt whether their blood is much mixed."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l5" HPOS="383" VPOS="866" WIDTH="1773" HEIGHT="56" BASELINE="385 896 2156 900" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 896 383 913 394 922 396 922 398 922 400 922 2154 913 2156 900 2154 870 385 866 385 896"/>
                        </Shape>
                        <String CONTENT="At present the Reindeer men do not hesitate to take wives from among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l6" HPOS="381" VPOS="915" WIDTH="1778" HEIGHT="61" BASELINE="383 961 2159 956" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 961 383 976 2156 972 2159 956 2154 926 1310 915 1308 915 1305 915 1264 928 381 928 383 961"/>
                        </Shape>
                        <String CONTENT="Russians, the Lamut, or the Chuvantzy; but these intermarriages are of recent"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l7" HPOS="381" VPOS="978" WIDTH="1773" HEIGHT="59" BASELINE="383 1019 2154 1015" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 1019 383 1037 2152 1037 2154 1015 2150 987 402 978 400 978 398 978 396 978 381 985 383 1019"/>
                        </Shape>
                        <String CONTENT="date. All cases of such intermarriages are on record, and they are but very"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l8" HPOS="381" VPOS="1034" WIDTH="1775" HEIGHT="61" BASELINE="383 1082 2156 1078" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 1082 383 1095 2154 1091 2156 1078 2152 1047 2087 1034 2085 1034 2083 1034 2081 1034 2066 1045 1955 1034 1953 1034 1819 1045 1797 1034 1795 1034 1793 1034 1790 1034 1788 1034 1773 1047 1648 1047 1619 1034 1617 1034 1615 1034 1539 1045 1487 1034 1485 1034 1483 1034 1459 1045 1355 1034 1353 1034 1266 1047 1212 1037 1210 1037 1106 1047 1067 1037 1065 1037 1063 1037 1061 1037 1024 1047 783 1037 781 1037 721 1047 645 1037 643 1037 530 1047 493 1037 491 1037 489 1037 487 1037 465 1047 400 1037 398 1037 396 1037 394 1037 381 1045 383 1082"/>
                        </Shape>
                        <String CONTENT="few in number. Moreover, the births resulting from the marriages of Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l9" HPOS="383" VPOS="1095" WIDTH="1773" HEIGHT="69" BASELINE="385 1140 2156 1136" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1140 385 1153 1221 1164 1223 1164 1305 1151 1713 1162 1715 1162 2154 1151 2156 1136 2152 1106 1288 1095 1286 1095 1284 1095 1260 1106 413 1097 411 1097 409 1097 383 1106 385 1140"/>
                        </Shape>
                        <String CONTENT="women (or, more strictly speaking, of Russianized Yukaghir women) with"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l10" HPOS="383" VPOS="1158" WIDTH="1773" HEIGHT="56" BASELINE="385 1201 2156 1197" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1201 385 1214 2154 1212 2156 1197 2152 1166 400 1158 398 1158 396 1158 394 1158 383 1164 385 1201"/>
                        </Shape>
                        <String CONTENT="Chukchee men have not been numerous. The reason for this is probably"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l11" HPOS="383" VPOS="1218" WIDTH="1776" HEIGHT="57" BASELINE="385 1262 2159 1257" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1262 385 1275 2156 1270 2159 1257 2154 1227 409 1218 407 1218 404 1218 383 1227 385 1262"/>
                        </Shape>
                        <String CONTENT="that these women, who are not very prolific in their native environment, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l12" HPOS="383" VPOS="1275" WIDTH="1221" HEIGHT="58" BASELINE="385 1316 1604 1320" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1316 383 1329 1600 1333 1604 1320 1604 1290 1576 1277 1574 1277 1572 1277 1208 1288 1178 1277 1175 1277 1173 1277 1121 1288 994 1275 991 1275 929 1288 859 1288 848 1277 848 1275 846 1275 844 1275 842 1275 840 1275 807 1286 749 1275 747 1275 744 1275 716 1288 526 1288 508 1275 506 1275 504 1275 502 1275 500 1275 498 1275 482 1286 469 1275 467 1275 465 1275 463 1275 385 1283 385 1316"/>
                        </Shape>
                        <String CONTENT="still less so under the conditions of nomad arctic life."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r3" HPOS="386" VPOS="1347" WIDTH="1778" HEIGHT="534" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="386 1347 2164 1347 2164 1881 386 1881"/>
