                    <TextLine ID="mz_1-057_l3" HPOS="470" VPOS="731" WIDTH="1665" HEIGHT="48" BASELINE="470 764 2135 764" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="470 764 470 779 2135 779 2135 764 2135 731 470 731 470 764"/>
                        </Shape>
                        <String CONTENT="MIXTURE WITH OTHER TRIBES. — Notwithstanding considerable diversity"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l4" HPOS="360" VPOS="779" WIDTH="1773" HEIGHT="61" BASELINE="362 825 2133 820" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="360 796 362 825 362 840 2131 838 2133 820 2129 790 1256 779 1254 779 1252 779 1228 790 377 781 360 796"/>
                        </Shape>
                        <String CONTENT="in the features of the Chukchee, I doubt whether their blood is much mixed."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l5" HPOS="362" VPOS="851" WIDTH="1773" HEIGHT="56" BASELINE="364 881 2135 885" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 881 362 898 373 907 375 907 377 907 379 907 2133 898 2135 885 2133 855 364 851 364 881"/>
                        </Shape>
                        <String CONTENT="At present the Reindeer men do not hesitate to take wives from among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l6" HPOS="360" VPOS="900" WIDTH="1778" HEIGHT="61" BASELINE="362 946 2138 941" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="362 946 362 961 2135 957 2138 941 2133 911 1289 900 1287 900 1284 900 1243 913 360 913 362 946"/>
                        </Shape>
                        <String CONTENT="Russians, the Lamut, or the Chuvantzy; but these intermarriages are of recent"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l7" HPOS="360" VPOS="963" WIDTH="1773" HEIGHT="59" BASELINE="362 1004 2133 1000" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="362 1004 362 1022 2131 1022 2133 1000 2129 972 381 963 379 963 377 963 375 963 360 970 362 1004"/>
                        </Shape>
                        <String CONTENT="date. All cases of such intermarriages are on record, and they are but very"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l8" HPOS="360" VPOS="1019" WIDTH="1775" HEIGHT="61" BASELINE="362 1067 2135 1063" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="362 1067 362 1080 2133 1076 2135 1063 2131 1032 2066 1019 2064 1019 2062 1019 2060 1019 2045 1030 1934 1019 1932 1019 1798 1030 1776 1019 1774 1019 1772 1019 1769 1019 1767 1019 1752 1032 1627 1032 1598 1019 1596 1019 1594 1019 1518 1030 1466 1019 1464 1019 1462 1019 1438 1030 1334 1019 1332 1019 1245 1032 1191 1022 1189 1022 1085 1032 1046 1022 1044 1022 1042 1022 1040 1022 1003 1032 762 1022 760 1022 700 1032 624 1022 622 1022 509 1032 472 1022 470 1022 468 1022 466 1022 444 1032 379 1022 377 1022 375 1022 373 1022 360 1030 362 1067"/>
                        </Shape>
                        <String CONTENT="few in number. Moreover, the births resulting from the marriages of Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l9" HPOS="362" VPOS="1080" WIDTH="1773" HEIGHT="69" BASELINE="364 1125 2135 1121" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1125 364 1138 1200 1149 1202 1149 1284 1136 1692 1147 1694 1147 2133 1136 2135 1121 2131 1091 1267 1080 1265 1080 1263 1080 1239 1091 392 1082 390 1082 388 1082 362 1091 364 1125"/>
                        </Shape>
                        <String CONTENT="women (or, more strictly speaking, of Russianized Yukaghir women) with"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l10" HPOS="362" VPOS="1143" WIDTH="1773" HEIGHT="56" BASELINE="364 1186 2135 1182" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1186 364 1199 2133 1197 2135 1182 2131 1151 379 1143 377 1143 375 1143 373 1143 362 1149 364 1186"/>
                        </Shape>
                        <String CONTENT="Chukchee men have not been numerous. The reason for this is probably"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l11" HPOS="362" VPOS="1203" WIDTH="1776" HEIGHT="57" BASELINE="364 1247 2138 1242" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1247 364 1260 2135 1255 2138 1242 2133 1212 388 1203 386 1203 383 1203 362 1212 364 1247"/>
                        </Shape>
                        <String CONTENT="that these women, who are not very prolific in their native environment, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l12" HPOS="362" VPOS="1260" WIDTH="1221" HEIGHT="58" BASELINE="364 1301 1583 1305" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1301 362 1314 1579 1318 1583 1305 1583 1275 1555 1262 1553 1262 1551 1262 1187 1273 1157 1262 1154 1262 1152 1262 1100 1273 973 1260 970 1260 908 1273 838 1273 827 1262 827 1260 825 1260 823 1260 821 1260 819 1260 786 1271 728 1260 726 1260 723 1260 695 1273 505 1273 487 1260 485 1260 483 1260 481 1260 479 1260 477 1260 461 1271 448 1260 446 1260 444 1260 442 1260 364 1268 364 1301"/>
                        </Shape>
                        <String CONTENT="still less so under the conditions of nomad arctic life."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r3" HPOS="365" VPOS="1332" WIDTH="1778" HEIGHT="534" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="365 1332 2143 1332 2143 1866 365 1866"/>
                    </Shape>
                    <TextLine ID="mz_1-057_l13" HPOS="466" VPOS="1327" WIDTH="1669" HEIGHT="56" BASELINE="468 1361 2135 1368" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="468 1361 466 1374 2131 1383 2135 1368 2133 1333 468 1327 468 1361"/>
                        </Shape>
                        <String CONTENT="On the Koryak border considerable intermixing with this tribe is going"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l14" HPOS="362" VPOS="1390" WIDTH="1773" HEIGHT="49" BASELINE="364 1420 2135 1424" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1420 362 1435 2131 1439 2135 1424 2133 1390 364 1390 364 1420"/>
                        </Shape>
                        <String CONTENT="on at the present time. The Maritime Chukchee may have been intermixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l15" HPOS="366" VPOS="1442" WIDTH="1774" HEIGHT="58" BASELINE="366 1485 2140 1485" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1485 366 1500 2140 1500 2140 1485 2138 1446 1421 1452 1373 1442 1371 1442 1369 1442 1367 1442 1332 1452 1287 1442 1284 1442 1282 1442 1280 1442 1278 1442 1263 1455 1161 1455 1107 1442 1105 1442 1102 1442 1070 1452 986 1442 983 1442 981 1442 979 1442 964 1455 849 1455 801 1442 799 1442 797 1442 730 1452 602 1442 600 1442 546 1452 518 1442 516 1442 513 1442 511 1442 464 1452 409 1442 407 1442 405 1442 366 1452 366 1485"/>
                        </Shape>
                        <String CONTENT="with the Eskimo from ancient times. At the present date, in the village of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l16" HPOS="364" VPOS="1498" WIDTH="1774" HEIGHT="60" BASELINE="366 1541 2138 1545" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1541 364 1554 2133 1558 2138 1545 2135 1513 2081 1500 2079 1500 1919 1511 1839 1500 1837 1500 1834 1500 1800 1511 1700 1500 1698 1500 1696 1500 1694 1500 1679 1513 1553 1513 1501 1500 1499 1500 1497 1500 1471 1511 1425 1500 1423 1500 1421 1500 1419 1500 1375 1511 1347 1500 1345 1500 1343 1500 1254 1511 1200 1498 1198 1498 1059 1498 1057 1498 1055 1498 1031 1509 1003 1498 1001 1498 999 1498 947 1509 862 1498 860 1498 858 1498 817 1509 778 1498 775 1498 773 1498 771 1498 769 1498 752 1509 685 1498 682 1498 680 1498 654 1511 511 1511 496 1498 494 1498 492 1498 490 1498 366 1506 366 1541"/>
                        </Shape>
                        <String CONTENT="Uweˊlen on the Arctic, and of Čeˊčin on the Pacific, one half of the families"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l17" HPOS="364" VPOS="1574" WIDTH="1774" HEIGHT="47" BASELINE="364 1604 2138 1604" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="364 1604 364 1621 2138 1621 2138 1604 2138 1574 364 1574 364 1604"/>
                        </Shape>
                        <String CONTENT="are Chukchee, while the other half are Eskimo, and very extensive intermar-"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l18" HPOS="366" VPOS="1632" WIDTH="1774" HEIGHT="50" BASELINE="366 1665 2140 1665" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1665 366 1682 2140 1682 2140 1665 2138 1632 366 1632 366 1665"/>
                        </Shape>
                        <String CONTENT="rying is taking place. Other villages have an unmixed population, and mixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l19" HPOS="368" VPOS="1695" WIDTH="1770" HEIGHT="45" BASELINE="368 1725 2138 1725" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 1725 368 1740 2138 1740 2138 1725 2138 1695 368 1695 368 1725"/>
                        </Shape>
                        <String CONTENT="marriages are not so frequent as one might suppose. However, the question"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l20" HPOS="364" VPOS="1740" WIDTH="1774" HEIGHT="61" BASELINE="366 1786 2138 1781" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1786 366 1801 2135 1799 2138 1781 2133 1751 1252 1740 1250 1740 1248 1740 1202 1753 364 1753 366 1786"/>
                        </Shape>
                        <String CONTENT="is not yet settled as to whether the Chukchee and the Eskimo belong to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l21" HPOS="364" VPOS="1801" WIDTH="801" HEIGHT="61" BASELINE="366 1846 1165 1840" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="366 1846 366 1862 1163 1855 1165 1840 1161 1812 947 1801 944 1801 364 1816 366 1846"/>
                        </Shape>
                        <String CONTENT="same anthropological stock or not."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r4" HPOS="365" VPOS="1866" WIDTH="1778" HEIGHT="423" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="365 1866 2143 1866 2143 2289 365 2289"/>
                    </Shape>
                    <TextLine ID="mz_1-057_l22" HPOS="472" VPOS="1859" WIDTH="1668" HEIGHT="61" BASELINE="474 1907 2140 1903" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="474 1907 474 1920 2138 1916 2140 1903 2138 1872 2094 1859 2092 1859 2090 1859 2088 1859 2064 1872 1960 1872 1943 1859 1941 1859 1938 1859 1936 1859 1863 1870 1832 1859 1830 1859 1828 1859 1739 1870 1718 1859 1715 1859 1713 1859 1711 1859 1687 1870 1661 1859 1659 1859 1657 1859 1557 1870 1462 1859 1460 1859 1458 1859 1421 1870 1393 1859 1391 1859 1388 1859 1386 1859 1352 1870 1308 1859 1306 1859 1304 1859 1302 1859 1300 1859 1278 1872 1089 1862 1087 1862 1085 1862 1057 1872 1044 1862 1042 1862 1040 1862 949 1862 947 1862 944 1862 942 1862 929 1872 871 1862 869 1862 799 1872 524 1862 522 1862 472 1870 474 1907"/>
                        </Shape>
                        <String CONTENT="FERTILITY. — The Chukchee are the healthiest of the tribes in north-"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l23" HPOS="368" VPOS="1922" WIDTH="1774" HEIGHT="59" BASELINE="368 1965 2142 1965" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2133 1931 1982 1933 1951 1922 1949 1922 1947 1922 1824 1933 1798 1922 1795 1922 1793 1922 1724 1933 1676 1922 1674 1922 1672 1922 1603 1933 1484 1922 1481 1922 1479 1922 1477 1922 1462 1935 1287 1935 1248 1922 1245 1922 1243 1922 1098 1933 944 1922 942 1922 940 1922 905 1933 786 1922 784 1922 706 1933 691 1922 689 1922 687 1922 568 1922 565 1922 563 1922 561 1922 546 1935 368 1935 368 1965 368 1981 2142 1981 2142 1965 2140 1946 2133 1931"/>
                        </Shape>
                        <String CONTENT="eastern Siberia. Their families contain more children than those of any of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l24" HPOS="368" VPOS="1981" WIDTH="1767" HEIGHT="60" BASELINE="368 2024 2135 2024" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2024 368 2041 2133 2041 2135 2024 2131 1989 1928 1991 1897 1981 1895 1981 1893 1981 1891 1981 1850 1991 1824 1981 1821 1981 1819 1981 1817 1981 1780 1991 1746 1981 1744 1981 1741 1981 1624 1991 1533 1981 1531 1981 1481 1991 1455 1981 1453 1981 1451 1981 1449 1981 1408 1991 1378 1981 1375 1981 1373 1981 1371 1981 1369 1981 1352 1994 1163 1994 1133 1981 1131 1981 1128 1981 1053 1991 988 1981 986 1981 914 1991 899 1981 897 1981 895 1981 786 1981 784 1981 782 1981 780 1981 762 1994 656 1994 561 1981 559 1981 479 1991 448 1981 446 1981 444 1981 442 1981 420 1991 399 1981 396 1981 394 1981 392 1981 368 1991 368 2024"/>
                        </Shape>
                        <String CONTENT="their neighbors. While taking the census in the Kolyma district in 1897, I"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l25" HPOS="366" VPOS="2041" WIDTH="1767" HEIGHT="63" BASELINE="368 2087 2133 2082" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2087 368 2104 2131 2104 2133 2082 2129 2052 1536 2041 1533 2041 366 2054 368 2087"/>
                        </Shape>
                        <String CONTENT="came across several families having five, seven, and even nine children living."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l26" HPOS="373" VPOS="2102" WIDTH="1765" HEIGHT="58" BASELINE="373 2145 2138 2145" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="373 2145 373 2160 2138 2160 2138 2145 2138 2115 1954 2102 1951 2102 1949 2102 1917 2113 1804 2102 1802 2102 1724 2113 1648 2102 1646 2102 1555 2113 1477 2102 1475 2102 1473 2102 1440 2113 1367 2102 1365 2102 1362 2102 1328 2113 1254 2102 1252 2102 1174 2113 1122 2102 1120 2102 1025 2113 973 2102 862 2102 860 2102 858 2102 856 2102 843 2113 797 2102 795 2102 793 2102 700 2113 373 2108 373 2145"/>
                        </Shape>
                        <String CONTENT="Ten per cent of the families had not less than five children living. One man"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l27" HPOS="368" VPOS="2167" WIDTH="1774" HEIGHT="54" BASELINE="370 2206 2142 2201" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="370 2206 370 2221 2140 2217 2142 2201 2135 2167 368 2169 370 2206"/>
                        </Shape>
                        <String CONTENT="had by two wives twelve children living. Another, by seven wives (three of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l28" HPOS="366" VPOS="2219" WIDTH="934" HEIGHT="60" BASELINE="368 2262 1300 2266" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2262 366 2275 1295 2279 1300 2266 1297 2234 990 2221 988 2221 986 2221 983 2221 970 2234 836 2234 795 2219 793 2219 791 2219 788 2219 765 2230 747 2219 745 2219 743 2219 741 2219 739 2219 717 2230 678 2219 676 2219 674 2219 672 2219 669 2219 652 2230 620 2219 617 2219 615 2219 613 2219 585 2230 533 2219 531 2219 529 2219 526 2219 509 2230 368 2230 368 2262"/>
                        </Shape>
                        <String CONTENT="them dead), had fourteen children living."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r5" HPOS="365" VPOS="2289" WIDTH="1778" HEIGHT="777" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="365 2289 2143 2289 2143 3066 365 3066"/>
                    </Shape>
                    <TextLine ID="mz_1-057_l29" HPOS="472" VPOS="2290" WIDTH="1668" HEIGHT="50" BASELINE="474 2323 2140 2327" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="474 2323 472 2336 2135 2340 2140 2327 2138 2290 474 2290 474 2323"/>
                        </Shape>
                        <String CONTENT="On the Pacific coast, among the Maritime Chukchee, one woman had"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l30" HPOS="370" VPOS="2351" WIDTH="1770" HEIGHT="52" BASELINE="370 2385 2140 2385" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="370 2385 370 2403 2140 2403 2140 2385 2140 2355 370 2351 370 2385"/>
                        </Shape>
                        <String CONTENT="had thirteen children (seven living and six dead); another one, eleven (three"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l31" HPOS="370" VPOS="2403" WIDTH="1765" HEIGHT="58" BASELINE="370 2446 2135 2446" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="370 2446 370 2461 2135 2461 2135 2446 2135 2416 2019 2416 2003 2403 2001 2403 1999 2403 1997 2403 1995 2403 1958 2414 1919 2403 1917 2403 1915 2403 1912 2403 1884 2414 1802 2403 1800 2403 1798 2403 1769 2414 1756 2403 1754 2403 1752 2403 1750 2403 1696 2414 1596 2403 1594 2403 1514 2414 1449 2403 1447 2403 1445 2403 1397 2414 1323 2403 1321 2403 1319 2403 1282 2414 1178 2403 1176 2403 1070 2414 1040 2403 1038 2403 1035 2403 962 2414 899 2403 801 2403 799 2403 797 2403 795 2403 782 2414 726 2403 723 2403 650 2414 615 2403 613 2403 611 2403 370 2407 370 2446"/>
                        </Shape>
                        <String CONTENT="living and eight dead); still another, nine (five living and four dead); etc."/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l32" HPOS="368" VPOS="2459" WIDTH="1772" HEIGHT="63" BASELINE="370 2505 2140 2500" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="370 2505 370 2522 2138 2518 2140 2500 2138 2472 2103 2459 2101 2459 2099 2459 2019 2470 1789 2459 1787 2459 1785 2459 1782 2459 1767 2472 1642 2472 1607 2459 1605 2459 1603 2459 1523 2470 1497 2459 1494 2459 1492 2459 1490 2459 1488 2459 1473 2470 1460 2459 1458 2459 1455 2459 1365 2459 1362 2459 1287 2470 1256 2459 1254 2459 1252 2459 1250 2459 1248 2459 1232 2470 1139 2461 1137 2461 1135 2461 1133 2461 1120 2472 1074 2461 1072 2461 1070 2461 1068 2461 1038 2472 732 2461 730 2461 674 2472 576 2461 574 2461 572 2461 570 2461 557 2472 542 2461 539 2461 537 2461 381 2461 379 2461 377 2461 375 2461 375 2463 368 2468 370 2505"/>
                        </Shape>
                        <String CONTENT="Several times, chiefly among the Reindeer Chukchee, I met with twins. This"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l33" HPOS="366" VPOS="2520" WIDTH="1774" HEIGHT="60" BASELINE="368 2565 2140 2561" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2565 368 2580 2138 2578 2140 2561 2138 2533 2101 2520 2099 2520 2097 2520 2025 2531 1549 2520 1546 2520 1544 2520 1520 2533 1362 2533 1328 2520 1326 2520 1323 2520 1321 2520 1300 2531 1258 2520 1256 2520 1254 2520 1163 2533 1094 2522 1092 2522 1089 2522 1057 2533 1003 2522 1001 2522 999 2522 970 2533 903 2522 901 2522 788 2533 587 2522 585 2522 522 2533 388 2522 386 2522 383 2522 381 2522 366 2531 368 2565"/>
                        </Shape>
                        <String CONTENT="degree of fertility results in the steady increase of the Chukchee, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l34" HPOS="366" VPOS="2580" WIDTH="1776" HEIGHT="61" BASELINE="368 2626 2142 2621" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2626 368 2641 2140 2637 2142 2621 2138 2591 1284 2580 1282 2580 1280 2580 1250 2591 459 2583 457 2583 366 2593 368 2626"/>
                        </Shape>
                        <String CONTENT="among the Reindeer division, in spite of the contagious diseases which ravage"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l35" HPOS="368" VPOS="2656" WIDTH="1774" HEIGHT="43" BASELINE="368 2686 2142 2686" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="368 2686 368 2699 2142 2699 2142 2686 2142 2656 368 2656 368 2686"/>
                        </Shape>
                        <String CONTENT="the country once every ten or fifteen years. It is interesting to note that"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l36" HPOS="368" VPOS="2702" WIDTH="1774" HEIGHT="60" BASELINE="370 2745 2142 2741" TAGREFS="TYPE_3">
                        <Shape>
