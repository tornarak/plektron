                    <TextLine ID="mz_1-057_l13" HPOS="487" VPOS="1342" WIDTH="1669" HEIGHT="56" BASELINE="489 1376 2156 1383" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="489 1376 487 1389 2152 1398 2156 1383 2154 1348 489 1342 489 1376"/>
                        </Shape>
                        <String CONTENT="On the Koryak border considerable intermixing with this tribe is going"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l14" HPOS="383" VPOS="1405" WIDTH="1773" HEIGHT="49" BASELINE="385 1435 2156 1439" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1435 383 1450 2152 1454 2156 1439 2154 1405 385 1405 385 1435"/>
                        </Shape>
                        <String CONTENT="on at the present time. The Maritime Chukchee may have been intermixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l15" HPOS="387" VPOS="1457" WIDTH="1774" HEIGHT="58" BASELINE="387 1500 2161 1500" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="387 1500 387 1515 2161 1515 2161 1500 2159 1461 1442 1467 1394 1457 1392 1457 1390 1457 1388 1457 1353 1467 1308 1457 1305 1457 1303 1457 1301 1457 1299 1457 1284 1470 1182 1470 1128 1457 1126 1457 1123 1457 1091 1467 1007 1457 1004 1457 1002 1457 1000 1457 985 1470 870 1470 822 1457 820 1457 818 1457 751 1467 623 1457 621 1457 567 1467 539 1457 537 1457 534 1457 532 1457 485 1467 430 1457 428 1457 426 1457 387 1467 387 1500"/>
                        </Shape>
                        <String CONTENT="with the Eskimo from ancient times. At the present date, in the village of"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l16" HPOS="385" VPOS="1513" WIDTH="1774" HEIGHT="60" BASELINE="387 1556 2159 1560" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="387 1556 385 1569 2154 1573 2159 1560 2156 1528 2102 1515 2100 1515 1940 1526 1860 1515 1858 1515 1855 1515 1821 1526 1721 1515 1719 1515 1717 1515 1715 1515 1700 1528 1574 1528 1522 1515 1520 1515 1518 1515 1492 1526 1446 1515 1444 1515 1442 1515 1440 1515 1396 1526 1368 1515 1366 1515 1364 1515 1275 1526 1221 1513 1219 1513 1080 1513 1078 1513 1076 1513 1052 1524 1024 1513 1022 1513 1020 1513 968 1524 883 1513 881 1513 879 1513 838 1524 799 1513 796 1513 794 1513 792 1513 790 1513 773 1524 706 1513 703 1513 701 1513 675 1526 532 1526 517 1513 515 1513 513 1513 511 1513 387 1521 387 1556"/>
                        </Shape>
                        <String CONTENT="Uweˊlen on the Arctic, and of Čeˊčin on the Pacific, one half of the families"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l17" HPOS="385" VPOS="1589" WIDTH="1774" HEIGHT="47" BASELINE="385 1619 2159 1619" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1619 385 1636 2159 1636 2159 1619 2159 1589 385 1589 385 1619"/>
                        </Shape>
                        <String CONTENT="are Chukchee, while the other half are Eskimo, and very extensive intermar-"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l18" HPOS="387" VPOS="1647" WIDTH="1774" HEIGHT="50" BASELINE="387 1680 2161 1680" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="387 1680 387 1697 2161 1697 2161 1680 2159 1647 387 1647 387 1680"/>
                        </Shape>
                        <String CONTENT="rying is taking place. Other villages have an unmixed population, and mixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l19" HPOS="389" VPOS="1710" WIDTH="1770" HEIGHT="45" BASELINE="389 1740 2159 1740" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="389 1740 389 1755 2159 1755 2159 1740 2159 1710 389 1710 389 1740"/>
                        </Shape>
                        <String CONTENT="marriages are not so frequent as one might suppose. However, the question"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l20" HPOS="385" VPOS="1755" WIDTH="1774" HEIGHT="61" BASELINE="387 1801 2159 1796" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="387 1801 387 1816 2156 1814 2159 1796 2154 1766 1273 1755 1271 1755 1269 1755 1223 1768 385 1768 387 1801"/>
                        </Shape>
                        <String CONTENT="is not yet settled as to whether the Chukchee and the Eskimo belong to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-057_l21" HPOS="385" VPOS="1816" WIDTH="801" HEIGHT="61" BASELINE="387 1861 1186 1855" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="387 1861 387 1877 1184 1870 1186 1855 1182 1827 968 1816 965 1816 385 1831 387 1861"/>
                        </Shape>
                        <String CONTENT="same anthropological stock or not."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-057_r4" HPOS="386" VPOS="1881" WIDTH="1778" HEIGHT="423" TAGREFS="TYPE_1">
<Shape>
