                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l2" HPOS="2074" VPOS="632" WIDTH="44" HEIGHT="60" BASELINE="2081 675 2118 671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2098 636 2085 632 2074 636 2081 675 2081 690 2115 692 2118 671 2109 638 2098 636"/>
