                        <Polygon POINTS="348 699 2126 699 2126 1077 348 1077"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l3" HPOS="353" VPOS="712" WIDTH="1769" HEIGHT="58" BASELINE="353 755 2122 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 755 353 770 2122 770 2122 755 2122 725 1834 725 1819 712 1817 712 1815 712 1813 712 1748 723 1687 712 1685 712 1683 712 1657 723 1594 712 1592 712 1590 712 1557 723 1540 712 1538 712 1536 712 1533 712 1466 723 1451 712 1449 712 1447 712 1445 712 1442 712 1410 723 1388 712 1386 712 1384 712 1382 712 1349 723 1295 712 1293 712 1241 723 1183 712 1009 712 1007 712 1005 712 975 723 353 718 353 755"/>
                        </Shape>
                        <String CONTENT="I spoke with a man named Kaˊtɪk, who declared that he did not want to"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l4" HPOS="349" VPOS="777" WIDTH="1769" HEIGHT="61" BASELINE="351 814 2118 818" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 814 349 829 360 838 362 838 364 838 366 838 2116 835 2118 818 2116 786 351 777 351 814"/>
                        </Shape>
                        <String CONTENT="live any longer. He gave as his reason, that fortune was adverse to him,"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l5" HPOS="349" VPOS="829" WIDTH="1771" HEIGHT="63" BASELINE="351 876 2120 870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 876 351 892 2118 887 2120 870 2116 842 1917 842 1899 829 1897 829 1895 829 1893 829 1837 840 1815 829 1813 829 1811 829 1808 829 1776 840 1724 829 1722 829 1659 840 1633 829 1631 829 1629 829 1627 829 1598 840 1549 829 1546 829 1466 842 1128 831 1126 831 1048 842 953 831 951 831 949 831 947 831 931 842 921 833 918 833 916 833 914 833 613 844 490 833 487 833 485 833 453 844 370 833 368 833 366 833 364 833 349 842 351 876"/>
                        </Shape>
                        <String CONTENT="that all his relatives had died, and that he was afraid that his herd at some"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l6" HPOS="351" VPOS="905" WIDTH="1771" HEIGHT="56" BASELINE="351 935 2122 935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 935 351 948 531 961 533 961 617 950 687 961 689 961 771 950 1148 961 1150 961 1213 950 1354 961 1356 961 1425 950 1821 950 1841 961 1843 961 1845 961 1847 961 2122 948 2122 935 2122 905 351 905 351 935"/>
                        </Shape>
                        <String CONTENT="time might begin to dwindle away, although at the time of speaking his"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l7" HPOS="349" VPOS="954" WIDTH="1773" HEIGHT="57" BASELINE="351 996 2122 991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 996 351 1011 2120 1006 2122 991 2118 963 394 954 392 954 390 954 349 965 351 996"/>
                        </Shape>
                        <String CONTENT="reindeer were prospering. I did not pay much attention to his words, but the"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l8" HPOS="351" VPOS="1011" WIDTH="1642" HEIGHT="60" BASELINE="351 1054 1993 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 1054 351 1071 1993 1071 1993 1054 1993 1022 1967 1011 1964 1011 1962 1011 1960 1011 1938 1022 1921 1011 1919 1011 1917 1011 1915 1011 1912 1011 1880 1022 1319 1011 1317 1011 1250 1022 1226 1011 1224 1011 1222 1011 1219 1011 1185 1022 1159 1011 1157 1011 1154 1011 1152 1011 1150 1011 1133 1022 1079 1011 1076 1011 966 1022 938 1011 936 1011 934 1011 871 1022 845 1011 843 1011 840 1011 838 1011 812 1022 786 1011 784 1011 782 1011 708 1022 637 1011 635 1011 570 1022 511 1011 509 1011 351 1022 351 1054"/>
                        </Shape>
                        <String CONTENT="next winter I heard that he really had ordered himself to be strangled."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-069_r3" HPOS="348" VPOS="1077" WIDTH="1778" HEIGHT="239" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="348 1077 2126 1077 2126 1316 348 1316"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l9" HPOS="464" VPOS="1071" WIDTH="1658" HEIGHT="59" BASELINE="464 1115 2122 1115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 1115 464 1130 2122 1130 2122 1115 2122 1084 1806 1071 1804 1071 1802 1071 1776 1082 1726 1071 1724 1071 1722 1071 1685 1082 1657 1071 1655 1071 1653 1071 1650 1071 1648 1071 1633 1084 1479 1084 1447 1071 1445 1071 1442 1071 1388 1082 1352 1071 1349 1071 1347 1071 1345 1071 1323 1082 1256 1071 1254 1071 1252 1071 1224 1082 1139 1071 1137 1071 1072 1082 994 1071 992 1071 990 1071 964 1084 780 1084 752 1071 749 1071 747 1071 745 1071 713 1082 667 1071 665 1071 663 1071 661 1071 626 1082 576 1071 574 1071 572 1071 531 1082 487 1071 485 1071 483 1071 481 1071 479 1071 464 1080 464 1115"/>
                        </Shape>
                        <String CONTENT="At the head waters of the river Omolon I met a family four of whose"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l10" HPOS="347" VPOS="1138" WIDTH="1771" HEIGHT="50" BASELINE="349 1171 2118 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1171 347 1184 2114 1188 2118 1175 2116 1143 349 1138 349 1171"/>
                        </Shape>
                        <String CONTENT="members had taken their own lives within four years without any apparent"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l11" HPOS="349" VPOS="1190" WIDTH="1771" HEIGHT="61" BASELINE="349 1234 2120 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1234 349 1251 2120 1251 2120 1234 2120 1203 2066 1190 2064 1190 2062 1190 2034 1201 1960 1190 1958 1190 1956 1190 1932 1201 1860 1190 1858 1190 1780 1201 1622 1190 1620 1190 1423 1201 1393 1190 1391 1190 1388 1190 1302 1201 1198 1190 1196 1190 1146 1201 1118 1190 1115 1190 1113 1190 1111 1190 1109 1190 1094 1203 1003 1203 942 1190 940 1190 851 1201 756 1190 754 1190 685 1201 652 1190 650 1190 648 1190 646 1190 643 1190 626 1201 563 1190 561 1190 559 1190 557 1190 542 1203 349 1203 349 1234"/>
                        </Shape>
                        <String CONTENT="reason. Their neighbors felt much afraid, and expressed the opinion that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l12" HPOS="347" VPOS="1260" WIDTH="1767" HEIGHT="49" BASELINE="349 1290 2114 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1290 347 1305 2109 1309 2114 1294 2112 1264 349 1260 349 1290"/>
                        </Shape>
                        <String CONTENT="spirits who wanted more prey had treacherously led them on to self-destruction."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-069_r4" HPOS="348" VPOS="1316" WIDTH="1778" HEIGHT="360" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="348 1316 2126 1316 2126 1676 348 1676"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l13" HPOS="461" VPOS="1322" WIDTH="1657" HEIGHT="50" BASELINE="461 1353 2118 1353" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 1353 461 1372 2118 1372 2118 1353 2118 1322 461 1322 461 1353"/>
                        </Shape>
                        <String CONTENT="A rough kind of compassion for all suffering characterizes the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l14" HPOS="347" VPOS="1381" WIDTH="1773" HEIGHT="58" BASELINE="349 1413 2120 1409" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1413 349 1429 864 1439 866 1439 1609 1426 1843 1437 1845 1437 1910 1426 1997 1437 1999 1437 2001 1437 2003 1437 2021 1426 2099 1437 2101 1437 2103 1437 2105 1437 2120 1424 2120 1409 2114 1381 347 1383 349 1413"/>
                        </Shape>
                        <String CONTENT="mind. Once in my presence a Reindeer man rescued a ptarmigan that was"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l15" HPOS="347" VPOS="1437" WIDTH="1773" HEIGHT="59" BASELINE="349 1470 2120 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1470 347 1487 360 1496 362 1496 364 1496 366 1496 2118 1487 2120 1474 2118 1439 349 1437 349 1470"/>
                        </Shape>
                        <String CONTENT="being hunted down by a hawk and had come to the camp exhausted, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l16" HPOS="344" VPOS="1496" WIDTH="1774" HEIGHT="56" BASELINE="347 1535 2118 1528" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1535 347 1552 2116 1545 2118 1528 2112 1496 344 1500 347 1535"/>
                        </Shape>
                        <String CONTENT="angrily expostulated with some children who wanted to catch the bird. Another"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l17" HPOS="349" VPOS="1563" WIDTH="1769" HEIGHT="47" BASELINE="349 1593 2118 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1593 349 1610 2118 1610 2118 1593 2118 1563 349 1563 349 1593"/>
                        </Shape>
                        <String CONTENT="time a Reindeer woman paid a ransom to one of my dog-drivers to stop him"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l18" HPOS="347" VPOS="1623" WIDTH="857" HEIGHT="59" BASELINE="347 1652 1204 1652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 1652 347 1669 464 1669 474 1678 474 1680 477 1680 479 1680 481 1682 689 1682 689 1680 691 1680 693 1680 693 1678 704 1669 1163 1680 1165 1680 1167 1680 1204 1667 1204 1652 1204 1623 347 1623 347 1652"/>
                        </Shape>
                        <String CONTENT="from punishing one of his own dogs."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-069_r5" HPOS="348" VPOS="1676" WIDTH="1778" HEIGHT="357" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="348 1676 2126 1676 2126 2033 348 2033"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l19" HPOS="455" VPOS="1669" WIDTH="1667" HEIGHT="58" BASELINE="457 1714 2122 1710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1714 457 1727 2120 1723 2122 1710 2118 1680 1323 1669 1321 1669 1319 1669 1284 1682 455 1682 457 1714"/>
                        </Shape>
                        <String CONTENT="Still more remarkable is the generosity which the Reindeer Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l20" HPOS="349" VPOS="1740" WIDTH="1771" HEIGHT="50" BASELINE="349 1773 2120 1773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1773 349 1790 2120 1790 2120 1773 2118 1740 349 1740 349 1773"/>
                        </Shape>
                        <String CONTENT="display toward everybody who is in need, even if he be of strange tribe and"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l21" HPOS="349" VPOS="1799" WIDTH="1767" HEIGHT="54" BASELINE="349 1833 2116 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1833 349 1846 2112 1853 2116 1833 2114 1803 349 1799 349 1833"/>
                        </Shape>
                        <String CONTENT="language. On the Chaun tundra live a small number of Lamut families,"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l22" HPOS="347" VPOS="1849" WIDTH="1771" HEIGHT="60" BASELINE="349 1894 2118 1890" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1894 349 1909 2116 1905 2118 1890 2114 1859 1261 1849 1258 1849 1256 1849 1222 1859 457 1851 455 1851 347 1862 349 1894"/>
                        </Shape>
                        <String CONTENT="members of various clans who have wandered northward. They are a peculiar"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l23" HPOS="347" VPOS="1909" WIDTH="1767" HEIGHT="67" BASELINE="349 1955 2114 1950" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 1955 349 1976 2112 1974 2114 1950 2109 1920 1271 1909 1269 1909 1209 1920 457 1911 455 1911 347 1922 349 1955"/>
                        </Shape>
                        <String CONTENT="people, very poor and very indolent; and fully one-half of their food is drawn,"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l24" HPOS="347" VPOS="1968" WIDTH="1715" HEIGHT="60" BASELINE="349 2009 2062 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 2009 347 2024 2058 2028 2062 2013 2060 1983 1964 1970 1962 1970 1826 1981 1752 1970 1750 1970 1163 1978 1146 1968 1144 1968 1141 1968 1139 1968 1137 1968 1096 1978 1061 1968 1059 1968 1057 1968 1055 1968 1029 1978 983 1968 981 1968 979 1968 977 1968 949 1978 849 1968 847 1968 845 1968 817 1981 687 1981 663 1968 661 1968 659 1968 349 1976 349 2009"/>
                        </Shape>
                        <String CONTENT="with very little pay, from the herds of their well-to-do Chukchee neighbors."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-069_r6" HPOS="348" VPOS="2033" WIDTH="1778" HEIGHT="661" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="348 2033 2126 2033 2126 2694 348 2694"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l25" HPOS="453" VPOS="2030" WIDTH="1663" HEIGHT="57" BASELINE="455 2072 2116 2067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="455 2072 455 2087 2114 2085 2116 2067 2112 2039 466 2030 464 2030 461 2030 459 2030 459 2033 453 2037 455 2072"/>
                        </Shape>
                        <String CONTENT="Similar relations have existed of late between the Chukchee and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l26" HPOS="349" VPOS="2089" WIDTH="1767" HEIGHT="58" BASELINE="351 2134 2116 2130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="351 2134 351 2147 2114 2143 2116 2130 2114 2102 2079 2089 2077 2089 1986 2089 1984 2089 1982 2089 1980 2089 1964 2100 1865 2089 1863 2089 1772 2102 1477 2102 1440 2089 1438 2089 1436 2089 1230 2102 1178 2091 1176 2091 1174 2091 1144 2102 992 2091 990 2091 892 2104 697 2104 665 2091 663 2091 661 2091 659 2091 620 2102 349 2100 351 2134"/>
                        </Shape>
                        <String CONTENT="Tungus on the western Kolyma. At present, however, most of those Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l27" HPOS="344" VPOS="2154" WIDTH="1774" HEIGHT="56" BASELINE="347 2195 2118 2188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2195 347 2210 2116 2204 2118 2188 2114 2156 370 2154 368 2154 366 2154 344 2162 347 2195"/>
                        </Shape>
                        <String CONTENT="chee are poor; and the few rich breeders farther to the west have acquired"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l28" HPOS="347" VPOS="2212" WIDTH="1771" HEIGHT="57" BASELINE="349 2253 2118 2247" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 2253 349 2269 2116 2262 2118 2247 2114 2219 425 2212 422 2212 347 2223 349 2253"/>
                        </Shape>
                        <String CONTENT="a taste for trade, and have gradually adopted the ways of the Yakut or"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l29" HPOS="344" VPOS="2266" WIDTH="1774" HEIGHT="65" BASELINE="347 2314 2118 2308" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2314 347 2331 2116 2325 2118 2308 2114 2279 1943 2266 1941 2266 1817 2277 1787 2266 1785 2266 1782 2266 1780 2266 1744 2277 1681 2266 1679 2266 1676 2266 1631 2277 1598 2266 1596 2266 1594 2266 1488 2279 1427 2269 1425 2269 1423 2269 1397 2279 1375 2269 1373 2269 1371 2269 1274 2279 1245 2269 1243 2269 1241 2269 1141 2279 1087 2269 1085 2269 1083 2269 1081 2269 1068 2279 1053 2269 1050 2269 1048 2269 942 2269 940 2269 938 2269 936 2269 921 2282 784 2271 782 2271 780 2271 743 2282 639 2271 637 2271 344 2279 347 2314"/>
                        </Shape>
                        <String CONTENT="Russian dealers. In occasional times of need the starving Russian settlements"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l30" HPOS="344" VPOS="2331" WIDTH="1774" HEIGHT="65" BASELINE="347 2375 2118 2368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2375 347 2388 1510 2396 1512 2396 1514 2396 1516 2396 1536 2385 2116 2385 2118 2368 2114 2340 938 2331 936 2331 344 2344 347 2375"/>
                        </Shape>
                        <String CONTENT="on the Kolyma and Anadyr were relieved, up to a very recent time, by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l31" HPOS="344" VPOS="2390" WIDTH="1772" HEIGHT="63" BASELINE="347 2433 2116 2429" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2433 347 2453 2114 2453 2116 2429 2112 2398 403 2390 401 2390 344 2401 347 2433"/>
                        </Shape>
                        <String CONTENT="neighboring reindeer-breeders, who often slaughtered several hundred animals,"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l32" HPOS="344" VPOS="2450" WIDTH="1772" HEIGHT="65" BASELINE="347 2492 2116 2485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2492 347 2507 1022 2515 1025 2515 1027 2515 1029 2515 1044 2505 1152 2505 1245 2515 1248 2515 1326 2505 1384 2515 1386 2515 1442 2505 1523 2515 1525 2515 1685 2502 1817 2513 1819 2513 1876 2502 1891 2513 1893 2513 1895 2513 1897 2513 2114 2502 2116 2485 2112 2457 394 2450 392 2450 390 2450 344 2461 347 2492"/>
                        </Shape>
                        <String CONTENT="taking very little or no pay for them. This disposition to help the needy"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l33" HPOS="344" VPOS="2511" WIDTH="1772" HEIGHT="59" BASELINE="347 2554 2116 2548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2554 347 2570 2114 2563 2116 2548 2112 2518 386 2511 383 2511 381 2511 344 2522 347 2554"/>
                        </Shape>
                        <String CONTENT="of a strange tribe probably sprang from the peculiar relations of both branches"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l34" HPOS="344" VPOS="2570" WIDTH="1770" HEIGHT="58" BASELINE="347 2608 2114 2604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2608 347 2628 2112 2624 2114 2604 2109 2578 386 2570 383 2570 381 2570 344 2580 347 2608"/>
                        </Shape>
                        <String CONTENT="of the Chukchee, which in so many respects form a unit, although they differ"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l35" HPOS="344" VPOS="2626" WIDTH="462" HEIGHT="63" BASELINE="347 2667 806 2673" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2667 344 2682 801 2689 806 2673 806 2643 769 2630 767 2630 765 2630 500 2639 466 2626 464 2626 461 2626 347 2634 347 2667"/>
                        </Shape>
                        <String CONTENT="widely economically."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-069_r7" HPOS="348" VPOS="2694" WIDTH="1778" HEIGHT="475" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="348 2694 2126 2694 2126 3169 348 3169"/>
                    </Shape>
                    <TextLine ID="mz_1-069_l36" HPOS="453" VPOS="2697" WIDTH="1663" HEIGHT="50" BASELINE="455 2730 2116 2725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="455 2730 455 2747 2114 2743 2116 2725 2112 2699 453 2697 455 2730"/>
                        </Shape>
                        <String CONTENT="The woman, as is the case among all peoples, is more compassionate"/>
                    </TextLine>

                    <TextLine ID="mz_1-069_l37" HPOS="342" VPOS="2749" WIDTH="1774" HEIGHT="59" BASELINE="344 2793 2116 2788" TAGREFS="TYPE_5">
