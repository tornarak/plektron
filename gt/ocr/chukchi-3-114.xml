                        </Shape>
                        <String CONTENT="In another tale he drives his spear into the bottom of the river. The"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l28" HPOS="563" VPOS="2063" WIDTH="1767" HEIGHT="70" BASELINE="565 2109 2330 2102" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="565 2109 565 2123 1003 2133 1005 2133 1103 2121 2328 2121 2330 2102 2326 2074 2122 2063 2120 2063 2118 2063 2081 2072 1789 2065 1787 2065 1785 2065 1783 2065 1767 2076 1389 2076 1358 2067 1356 2067 1354 2067 1297 2076 1266 2067 1264 2067 1262 2067 1260 2067 1231 2076 1149 2067 1147 2067 1103 2076 1067 2067 1065 2067 1064 2067 917 2078 878 2068 876 2068 874 2068 824 2078 761 2068 760 2068 758 2068 756 2068 740 2078 658 2068 656 2068 563 2080 565 2109"/>
                        </Shape>
                        <String CONTENT="moving ice is stopped. The ice forms a temporary bridge, over which pass"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l29" HPOS="563" VPOS="2139" WIDTH="1769" HEIGHT="43" BASELINE="563 2166 2332 2166" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 2166 563 2182 2330 2182 2332 2166 2330 2139 563 2139 563 2166"/>
                        </Shape>
                        <String CONTENT="the Chukchee caravans. The latter version comes nearer to the usual style"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l30" HPOS="563" VPOS="2187" WIDTH="323" HEIGHT="63" BASELINE="565 2228 886 2224" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="565 2228 565 2240 697 2250 699 2250 701 2250 726 2240 886 2240 886 2224 882 2197 600 2187 598 2187 596 2187 563 2199 565 2228"/>
                        </Shape>
                        <String CONTENT="of the stories."/>
                    </TextLine>
