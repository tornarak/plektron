                    <TextLine ID="mz_3-114_l31" HPOS="672" VPOS="2242" WIDTH="1660" HEIGHT="58" BASELINE="674 2287 2332 2283" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="674 2287 674 2300 2330 2298 2332 2283 2330 2254 2315 2242 2313 2242 2311 2242 2309 2242 2200 2254 2163 2242 2161 2242 2159 2242 2089 2252 2030 2242 2028 2242 2026 2242 2024 2242 2007 2256 1923 2256 1898 2242 1896 2242 1752 2242 1750 2242 1748 2242 1746 2242 1728 2256 1434 2256 1397 2244 1395 2244 1393 2244 1391 2244 1360 2258 1147 2258 1128 2244 1126 2244 1124 2244 1122 2244 1058 2256 978 2244 976 2244 921 2258 859 2258 841 2244 839 2244 837 2244 836 2244 761 2256 703 2244 701 2244 672 2250 674 2287"/>
                        </Shape>
                        <String CONTENT="In still another tale appears the strong man Aᵋttɪmlu or Aᵋmluᵋ, which"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l32" HPOS="565" VPOS="2306" WIDTH="1767" HEIGHT="63" BASELINE="565 2345 2332 2345" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="565 2345 565 2357 623 2369 625 2369 717 2359 836 2369 837 2369 888 2359 939 2369 941 2369 1017 2359 1130 2369 1132 2369 1134 2369 1155 2359 1256 2369 1258 2369 1381 2359 1436 2369 1438 2369 1440 2369 1461 2359 1872 2359 1935 2369 1937 2369 2332 2359 2332 2345 2332 2316 2291 2306 2289 2306 2287 2306 2217 2316 2174 2306 2172 2306 2171 2306 1539 2316 1488 2306 1486 2306 1389 2316 1294 2306 1292 2306 1212 2316 1184 2306 1182 2306 1180 2306 1179 2306 1141 2316 1079 2306 1077 2306 1075 2306 1042 2316 1007 2306 1005 2306 1003 2306 951 2316 919 2306 917 2306 915 2306 820 2316 752 2306 750 2306 748 2306 746 2306 730 2318 565 2318 565 2345"/>
                        </Shape>
                        <String CONTENT="means “bony face.” He is called so because his face is quite hard. The"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l33" HPOS="563" VPOS="2363" WIDTH="1765" HEIGHT="60" BASELINE="565 2408 2328 2404" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="565 2408 565 2423 2326 2421 2328 2404 2325 2374 2270 2363 2268 2363 2266 2363 2233 2373 1812 2363 1810 2363 1734 2373 1662 2363 1660 2363 1568 2373 1449 2363 1447 2363 1446 2363 1444 2363 1428 2374 1362 2365 1360 2365 1358 2365 1332 2374 1243 2365 1241 2365 1239 2365 1237 2365 1221 2376 1062 2376 888 2365 886 2365 884 2365 865 2374 767 2365 765 2365 763 2365 738 2376 563 2376 565 2408"/>
                        </Shape>
                        <String CONTENT="arrows of the Taˊn˙ñɪt cannot hurt it. Eᵋleˊnnut lives with him as a companion"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l34" HPOS="567" VPOS="2435" WIDTH="426" HEIGHT="58" BASELINE="567 2468 993 2468" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2468 567 2482 637 2493 639 2493 685 2484 732 2493 734 2493 736 2493 771 2484 912 2493 913 2493 993 2482 993 2468 993 2439 567 2435 567 2468"/>
                        </Shape>
                        <String CONTENT="in group-marriage."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-114_r6" HPOS="562" VPOS="2519" WIDTH="1782" HEIGHT="531" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="562 2519 2344 2519 2344 3050 562 3050"/>
                    </Shape>
                    <TextLine ID="mz_3-114_l35" HPOS="674" VPOS="2523" WIDTH="1656" HEIGHT="44" BASELINE="674 2548 2330 2548" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="674 2548 674 2567 2328 2567 2330 2548 2328 2523 674 2523 674 2548"/>
                        </Shape>
                        <String CONTENT="“Bony-Face quarrelled with Head-Nodder, and slapped him on the head with his open hand."/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l36" HPOS="565" VPOS="2569" WIDTH="1765" HEIGHT="45" BASELINE="567 2599 2330 2595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2599 567 2614 2328 2610 2330 2595 2325 2569 565 2569 567 2599"/>
                        </Shape>
                        <String CONTENT="From this slap the other suffered throughout the summer. After that the offended one wanted to"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l37" HPOS="565" VPOS="2616" WIDTH="1765" HEIGHT="45" BASELINE="567 2645 2330 2641" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2645 567 2661 2328 2659 2330 2641 2326 2616 565 2616 567 2645"/>
                        </Shape>
                        <String CONTENT="have revenge. He exercised for two consecutive years, in order to equal Bony-Face in strength."/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l38" HPOS="567" VPOS="2663" WIDTH="1763" HEIGHT="45" BASELINE="567 2690 2330 2690" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2690 567 2706 2328 2708 2330 2690 2330 2663 567 2663 567 2690"/>
                        </Shape>
                        <String CONTENT="Then he called his brother and went to visit the offender. His brother’s name was Yɪrkɪtowaˊʟaᵋn;"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l39" HPOS="567" VPOS="2704" WIDTH="1763" HEIGHT="50" BASELINE="567 2737 2330 2737" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2737 567 2754 2330 2754 2330 2737 2328 2704 567 2706 567 2737"/>
                        </Shape>
                        <String CONTENT="i.e., ‘having soft buttocks.’ Bony-Face proposed to pay them for the offence; first two thong-seal"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l40" HPOS="567" VPOS="2756" WIDTH="1765" HEIGHT="43" BASELINE="567 2784 2332 2784" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2784 567 2799 2330 2799 2332 2784 2328 2756 567 2756 567 2784"/>
                        </Shape>
                        <String CONTENT="skins, then two beaver-skins; but they refused. Then all four went out of the house. Eᵋleˊnnut"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l41" HPOS="565" VPOS="2801" WIDTH="1767" HEIGHT="45" BASELINE="567 2832 2332 2827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2832 567 2846 2332 2840 2332 2827 2326 2801 565 2805 567 2832"/>
                        </Shape>
                        <String CONTENT="sat down upon a sledge as an onlooker. Bony-Face turned up his sleeves. The two adversaries"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l42" HPOS="565" VPOS="2838" WIDTH="1765" HEIGHT="55" BASELINE="567 2877 2330 2873" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="567 2877 567 2893 2328 2893 2330 2873 2326 2848 1504 2838 1502 2838 1444 2848 652 2840 650 2840 565 2850 567 2877"/>
                        </Shape>
                        <String CONTENT="caught him from both sides. ‘What! both of you?’ — ‘Yes, both of us.’ — ‘Ah, all right!’ He"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l43" HPOS="567" VPOS="2895" WIDTH="1763" HEIGHT="45" BASELINE="569 2924 2330 2920" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="569 2924 569 2940 2328 2936 2330 2920 2325 2895 567 2897 569 2924"/>
                        </Shape>
                        <String CONTENT="caught them both by the nape of the neck and pushed them together face to face, then threw"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l44" HPOS="567" VPOS="2942" WIDTH="1761" HEIGHT="48" BASELINE="569 2969 2328 2965" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="569 2969 569 2988 2325 2990 2328 2965 2323 2942 567 2944 569 2969"/>
                        </Shape>
                        <String CONTENT="them upon the ground. The snow was covered with blood, as from a reindeer newly slaughtered."/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l45" HPOS="567" VPOS="2983" WIDTH="925" HEIGHT="50" BASELINE="569 3016 1492 3014" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="569 3016 569 3033 1492 3031 1492 3014 1486 2983 567 2990 569 3016"/>
                        </Shape>
                        <String CONTENT="Then he turned away and entered his house again.”"/>
                    </TextLine>
</TextBlock>
