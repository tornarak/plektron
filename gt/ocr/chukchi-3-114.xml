                        </Shape>
                        <String CONTENT="forms a bridge, and the caravans of reindeer-sledges pass over him as on"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l25" HPOS="561" VPOS="1883" WIDTH="1769" HEIGHT="61" BASELINE="563 1928 2330 1922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="563 1928 563 1944 2328 1942 2330 1922 2326 1895 2083 1883 2081 1883 2026 1893 1991 1883 1989 1883 1987 1883 1923 1893 1890 1883 1888 1883 1886 1883 1884 1883 1882 1883 1865 1893 1373 1885 1371 1885 1370 1885 1350 1895 1325 1885 1323 1885 1321 1885 1319 1885 1297 1897 1149 1897 816 1887 814 1887 656 1897 574 1887 572 1887 570 1887 569 1887 561 1893 563 1928"/>
                        </Shape>
                        <String CONTENT="firm ground.” These exaggerated details surpass the usual style of Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_3-114_l26" HPOS="561" VPOS="1946" WIDTH="263" HEIGHT="58" BASELINE="563 1985 824 1989" TAGREFS="TYPE_4">
