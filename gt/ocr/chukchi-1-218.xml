                        </Shape>
                        <String CONTENT="two sleeping-rooms in the same tent, but this is not very often the case."/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l39" HPOS="612" VPOS="2898" WIDTH="1772" HEIGHT="55" BASELINE="615 2933 2384 2937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2933 612 2948 2380 2953 2384 2937 2382 2907 615 2898 615 2933"/>
                        </Shape>
                        <String CONTENT="Usually the sleeping-room is in the rear of the tent, facing the entrance, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l40" HPOS="610" VPOS="2963" WIDTH="1774" HEIGHT="52" BASELINE="610 2996 2384 2996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="610 2996 610 3015 2384 3015 2384 2996 2384 2968 610 2963 610 2996"/>
                        </Shape>
                        <String CONTENT="is generally toward the northeast (Morning Dawn¹), occasionally toward the"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l41" HPOS="608" VPOS="3022" WIDTH="1776" HEIGHT="60" BASELINE="610 3054 2384 3059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="610 3054 608 3069 619 3078 621 3078 623 3078 625 3078 1249 3069 1314 3080 1316 3080 1433 3069 1795 3082 1797 3082 2382 3069 2384 3059 2380 3022 610 3022 610 3054"/>
                        </Shape>
                        <String CONTENT="north or east. Thus the square walls of the sleeping-room have a fixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l42" HPOS="610" VPOS="3072" WIDTH="1776" HEIGHT="65" BASELINE="610 3113 2386 3117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2384 3087 1554 3087 1496 3074 1494 3074 641 3082 612 3072 610 3113 610 3137 2384 3132 2386 3117 2384 3087"/>
                        </Shape>
                        <String CONTENT="position with respect to the compass. The left side faces the northwest, and is"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l43" HPOS="610" VPOS="3141" WIDTH="1770" HEIGHT="58" BASELINE="612 3173 2380 3180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="612 3173 610 3189 2375 3199 2380 3180 2377 3147 612 3141 612 3173"/>
                        </Shape>
                        <String CONTENT="called “leeward room” (aig̣ɪˊs˙qa-ron). The right side is toward the southeast,"/>
                    </TextLine>
</TextBlock>
