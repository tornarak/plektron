                    <TextLine ID="mz_1-218_l38" HPOS="589" VPOS="2827" WIDTH="1774" HEIGHT="59" BASELINE="591 2857 2363 2864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2834 591 2857 589 2875 602 2883 604 2883 607 2883 609 2883 1131 2875 1189 2886 1191 2886 2361 2877 2363 2864 2361 2834 596 2827 591 2834"/>
                        </Shape>
                        <String CONTENT="two sleeping-rooms in the same tent, but this is not very often the case."/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l39" HPOS="591" VPOS="2883" WIDTH="1772" HEIGHT="55" BASELINE="594 2918 2363 2922" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2918 591 2933 2359 2938 2363 2922 2361 2892 594 2883 594 2918"/>
                        </Shape>
                        <String CONTENT="Usually the sleeping-room is in the rear of the tent, facing the entrance, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l40" HPOS="589" VPOS="2948" WIDTH="1774" HEIGHT="52" BASELINE="589 2981 2363 2981" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 2981 589 3000 2363 3000 2363 2981 2363 2953 589 2948 589 2981"/>
                        </Shape>
                        <String CONTENT="is generally toward the northeast (Morning Dawn¹), occasionally toward the"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l41" HPOS="587" VPOS="3007" WIDTH="1776" HEIGHT="60" BASELINE="589 3039 2363 3044" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="589 3039 587 3054 598 3063 600 3063 602 3063 604 3063 1228 3054 1293 3065 1295 3065 1412 3054 1774 3067 1776 3067 2361 3054 2363 3044 2359 3007 589 3007 589 3039"/>
                        </Shape>
                        <String CONTENT="north or east. Thus the square walls of the sleeping-room have a fixed"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l42" HPOS="589" VPOS="3057" WIDTH="1776" HEIGHT="65" BASELINE="589 3098 2365 3102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2363 3072 1533 3072 1475 3059 1473 3059 620 3067 591 3057 589 3098 589 3122 2363 3117 2365 3102 2363 3072"/>
                        </Shape>
                        <String CONTENT="position with respect to the compass. The left side faces the northwest, and is"/>
                    </TextLine>

                    <TextLine ID="mz_1-218_l43" HPOS="589" VPOS="3126" WIDTH="1770" HEIGHT="58" BASELINE="591 3158 2359 3165" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 3158 589 3174 2354 3184 2359 3165 2356 3132 591 3126 591 3158"/>
                        </Shape>
                        <String CONTENT="called “leeward room” (aig̣ɪˊs˙qa-ron). The right side is toward the southeast,"/>
                    </TextLine>
