                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l2" HPOS="2064" VPOS="628" WIDTH="82" HEIGHT="56" BASELINE="2064 669 2146 669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2129 636 2107 632 2086 630 2075 628 2064 628 2064 669 2064 684 2146 684 2146 669 2146 638 2129 636"/>
                        </Shape>
                        <String CONTENT="175"/>
                    </TextLine>
<TextLine ID="mz_1-223_l3" HPOS="379" VPOS="721" WIDTH="1774" HEIGHT="65" BASELINE="381 770 2153 764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 770 381 786 2151 779 2153 764 2148 734 1988 734 1962 721 1960 721 1958 721 1858 731 1804 721 1802 721 1800 721 1761 731 1731 721 1728 721 1726 721 1724 721 1722 721 1705 734 1588 734 1564 721 1562 721 1559 721 1497 734 1451 723 1449 723 1447 723 1445 723 1414 734 1317 723 1315 723 1217 734 1139 723 1137 723 1135 723 1102 736 379 736 381 770"/>
                        </Shape>
                        <String CONTENT="inside of the outer room, even while cooking is going on, is almost the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l4" HPOS="377" VPOS="781" WIDTH="1774" HEIGHT="65" BASELINE="379 831 2151 825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 831 379 846 2148 840 2151 825 2148 794 2122 781 2120 781 2118 781 2116 781 2086 792 2014 781 2012 781 1951 792 1520 783 1518 783 1516 783 1514 783 1499 794 1178 783 1176 783 1044 794 968 783 966 783 869 796 830 786 827 786 825 786 548 796 470 786 468 786 377 799 379 831"/>
                        </Shape>
                        <String CONTENT="as that outside. The herdsmen or hunters, when sleeping in the open, although"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l5" HPOS="379" VPOS="848" WIDTH="1769" HEIGHT="57" BASELINE="381 889 2148 881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 889 381 905 2146 900 2148 881 2144 848 399 848 396 848 394 848 392 848 379 855 381 889"/>
                        </Shape>
                        <String CONTENT="they may have an abundance of fuel, are often content to make a small"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l6" HPOS="379" VPOS="902" WIDTH="1772" HEIGHT="65" BASELINE="381 950 2151 944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 950 381 965 2146 967 2151 944 2146 915 2071 902 2068 902 2066 902 2038 915 1893 915 1869 902 1867 902 1865 902 1681 913 1642 902 1640 902 1637 902 1555 915 1154 905 1152 905 1050 915 970 905 968 905 966 905 916 918 498 907 496 907 379 920 381 950"/>
                        </Shape>
                        <String CONTENT="smouldering fire from which to light their pipes, or do not make any fire;"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l7" HPOS="379" VPOS="961" WIDTH="1774" HEIGHT="63" BASELINE="381 1009 2153 1002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1009 381 1024 2151 1017 2153 1002 2148 974 2097 961 2094 961 2092 961 2071 972 2053 961 2051 961 2049 961 2047 961 2045 961 2008 972 1932 961 1930 961 1928 961 1925 961 1908 974 1782 974 1748 961 1746 961 1744 961 1657 972 1594 961 1592 961 1590 961 1551 974 1089 963 1087 963 1085 963 1055 974 1003 963 1001 963 899 976 425 965 422 965 420 965 379 978 381 1009"/>
                        </Shape>
                        <String CONTENT="whereas the Lamut and the Yukaghir send up a blaze that wards off the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l8" HPOS="379" VPOS="1026" WIDTH="1772" HEIGHT="60" BASELINE="381 1069 2151 1061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1069 381 1086 2148 1078 2151 1061 2146 1032 866 1026 864 1026 862 1026 819 1037 431 1028 429 1028 379 1039 381 1069"/>
                        </Shape>
                        <String CONTENT="cold from a space of several yards around, and often keep it up during the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l9" HPOS="379" VPOS="1086" WIDTH="1365" HEIGHT="68" BASELINE="381 1128 1744 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1128 381 1143 609 1154 611 1154 613 1154 659 1143 827 1151 830 1151 931 1141 977 1151 979 1151 981 1151 983 1151 1027 1141 1741 1141 1744 1121 1739 1093 420 1086 418 1086 416 1086 379 1097 381 1128"/>
                        </Shape>
                        <String CONTENT="whole night in order to get a chance to sleep comfortably."/>
                    </TextLine>
<TextLine ID="mz_1-223_l10" HPOS="485" VPOS="1141" WIDTH="1668" HEIGHT="71" BASELINE="487 1188 2153 1182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="487 1188 487 1201 1038 1212 1040 1212 1042 1212 1044 1212 1044 1210 1055 1201 1594 1210 1596 1210 2151 1197 2153 1182 2148 1151 1819 1141 1817 1141 1815 1141 1813 1141 1798 1154 1674 1154 1605 1141 1603 1141 1601 1141 1575 1154 1455 1143 1453 1143 1271 1154 1239 1143 1237 1143 1235 1143 1232 1143 1206 1154 962 1145 960 1145 957 1145 955 1145 940 1158 806 1158 717 1145 715 1145 713 1145 680 1156 669 1145 667 1145 665 1145 511 1145 509 1145 507 1145 505 1145 485 1154 487 1188"/>
                        </Shape>
                        <String CONTENT="Movable House. — The type of tent and sleeping-room here described"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l11" HPOS="377" VPOS="1203" WIDTH="1771" HEIGHT="61" BASELINE="379 1249 2148 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1249 379 1264 2146 1260 2148 1242 2144 1212 977 1203 975 1203 973 1203 970 1203 957 1214 390 1206 388 1206 386 1206 383 1206 383 1208 377 1212 379 1249"/>
                        </Shape>
                        <String CONTENT="is especially used in moving about with the herd. That used by the family"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l12" HPOS="379" VPOS="1264" WIDTH="1769" HEIGHT="61" BASELINE="381 1309 2148 1303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1309 381 1325 2146 1318 2148 1303 2144 1275 1566 1264 1564 1264 1503 1277 379 1277 381 1309"/>
                        </Shape>
                        <String CONTENT="is very heavy, and requires — with poles, cover, and bedding — six or seven"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l13" HPOS="377" VPOS="1325" WIDTH="1771" HEIGHT="58" BASELINE="379 1368 2148 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1368 379 1383 2146 1379 2148 1364 2144 1333 407 1325 405 1325 403 1325 377 1333 379 1368"/>
                        </Shape>
                        <String CONTENT="sledges. Whenever the herdsmen leave their principal camp, they carry with"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l14" HPOS="377" VPOS="1383" WIDTH="1771" HEIGHT="61" BASELINE="379 1429 2148 1422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1429 379 1444 2146 1439 2148 1422 2144 1394 1557 1383 1555 1383 1553 1383 1520 1394 399 1387 396 1387 394 1387 392 1387 377 1394 379 1429"/>
                        </Shape>
                        <String CONTENT="them a small sleeping-room, with a light tent, which is often not properly"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l15" HPOS="377" VPOS="1439" WIDTH="1771" HEIGHT="72" BASELINE="379 1491 2148 1481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1491 379 1511 2146 1498 2148 1481 2144 1452 2019 1439 2016 1439 2014 1439 2012 1439 1997 1452 1873 1452 1847 1439 1845 1439 1843 1439 1782 1452 1540 1442 1538 1442 1536 1442 1490 1452 1453 1442 1451 1442 1449 1442 1447 1442 1445 1442 1429 1455 1345 1444 1343 1444 1341 1444 1339 1444 1321 1455 836 1446 834 1446 832 1446 801 1457 756 1446 754 1446 752 1446 749 1446 706 1459 414 1448 412 1448 409 1448 377 1459 379 1491"/>
                        </Shape>
                        <String CONTENT="pitched, but only loosely thrown over the sleeping-room to keep off the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l16" HPOS="379" VPOS="1502" WIDTH="1767" HEIGHT="65" BASELINE="381 1550 2146 1545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1550 381 1563 2142 1567 2146 1545 2142 1515 2081 1502 2079 1502 1538 1513 1501 1502 1499 1502 1497 1502 1494 1502 1471 1513 1410 1502 1408 1502 1310 1513 1278 1502 1276 1502 1274 1502 1148 1515 1113 1504 1111 1504 1109 1504 1107 1504 1081 1515 1066 1504 1063 1504 1061 1504 1059 1504 1057 1504 1029 1515 873 1504 871 1504 708 1515 643 1504 641 1504 639 1504 602 1515 565 1504 563 1504 561 1504 559 1504 557 1504 542 1517 379 1517 381 1550"/>
                        </Shape>
                        <String CONTENT="snow. In this type of house it is difficult to dry damp clothing. Fur clothing"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l17" HPOS="379" VPOS="1567" WIDTH="1767" HEIGHT="63" BASELINE="381 1613 2146 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1613 381 1630 2144 1621 2146 1604 2142 1574 843 1567 840 1567 838 1567 817 1578 529 1569 526 1569 379 1580 381 1613"/>
                        </Shape>
                        <String CONTENT="generally becomes damp quickly, even in dry, cold weather, especially when"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l18" HPOS="379" VPOS="1621" WIDTH="1769" HEIGHT="74" BASELINE="381 1671 2148 1662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1671 381 1684 808 1695 810 1695 812 1695 814 1695 830 1682 1120 1693 1122 1693 1124 1693 1126 1693 1141 1682 1702 1691 1705 1691 1707 1691 1746 1678 1934 1678 1949 1688 1951 1688 1954 1688 1956 1688 2146 1678 2148 1662 2144 1632 1791 1621 1789 1621 1698 1632 1501 1623 1499 1623 379 1634 381 1671"/>
                        </Shape>
                        <String CONTENT="it is worn directly on the skin, without any underclothing. When damp, it"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l19" HPOS="379" VPOS="1686" WIDTH="1769" HEIGHT="59" BASELINE="381 1729 2148 1723" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1729 381 1745 2146 1740 2148 1723 2144 1695 973 1686 970 1686 890 1697 399 1688 396 1688 394 1688 392 1688 379 1695 381 1729"/>
                        </Shape>
                        <String CONTENT="does not protect the body from the cold: therefore it must be dried every"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l20" HPOS="379" VPOS="1738" WIDTH="1769" HEIGHT="69" BASELINE="381 1792 2148 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1792 381 1807 2146 1799 2148 1781 2144 1751 1938 1738 1936 1738 1865 1749 1841 1738 1839 1738 1837 1738 1767 1751 1752 1740 1750 1740 1748 1740 1746 1740 1744 1740 1707 1751 1627 1740 1624 1740 1432 1753 1401 1742 1399 1742 1397 1742 1395 1742 1362 1753 1209 1742 1206 1742 1204 1742 1167 1753 1128 1742 1126 1742 1124 1742 1122 1742 1083 1755 970 1745 968 1745 908 1755 875 1745 873 1745 871 1745 723 1758 552 1747 550 1747 548 1747 505 1758 416 1747 414 1747 412 1747 379 1758 381 1792"/>
                        </Shape>
                        <String CONTENT="night while its owner is asleep. In the sleeping-room of the Reindeer Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l21" HPOS="379" VPOS="1801" WIDTH="1769" HEIGHT="67" BASELINE="381 1851 2148 1844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1851 381 1868 2146 1868 2148 1844 2144 1814 2081 1801 2079 1801 1824 1812 1726 1801 1724 1801 1722 1801 1720 1801 1705 1814 1585 1814 1562 1801 1559 1801 1557 1801 1555 1801 1527 1814 1490 1803 1488 1803 1486 1803 1484 1803 1453 1814 1178 1803 1176 1803 1174 1803 1144 1814 1113 1803 1111 1803 1109 1803 1040 1814 977 1803 975 1803 973 1803 970 1803 951 1816 817 1805 814 1805 760 1816 734 1805 732 1805 730 1805 654 1816 620 1805 617 1805 615 1805 613 1805 572 1816 533 1805 531 1805 529 1805 457 1816 405 1805 403 1805 401 1805 399 1805 379 1816 381 1851"/>
                        </Shape>
                        <String CONTENT="the only place for drying things is directly over the lamp. Only small articles,"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l22" HPOS="379" VPOS="1866" WIDTH="1774" HEIGHT="58" BASELINE="381 1909 2153 1903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1909 381 1924 2151 1918 2153 1903 2148 1866 1025 1866 1022 1866 964 1877 453 1868 451 1868 379 1879 381 1909"/>
                        </Shape>
                        <String CONTENT="such as mittens, socks, and boots, can be placed there. Large pieces of"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l23" HPOS="379" VPOS="1929" WIDTH="1769" HEIGHT="56" BASELINE="381 1970 2148 1959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 1970 381 1985 2146 1978 2148 1959 2144 1929 405 1929 403 1929 401 1929 379 1937 381 1970"/>
                        </Shape>
                        <String CONTENT="clothing, such as shirt or trousers, are dried in a way similar to that used"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l24" HPOS="379" VPOS="1983" WIDTH="1772" HEIGHT="63" BASELINE="381 2030 2151 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2030 381 2046 2148 2039 2151 2022 2146 1994 1711 1983 1709 1983 1707 1983 1705 1983 1692 1994 1336 1985 1334 1985 1261 1998 379 1998 381 2030"/>
                        </Shape>
                        <String CONTENT="in drying the sleeping-room cover; i. e., by freezing the dampness out, then"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l25" HPOS="379" VPOS="2041" WIDTH="1772" HEIGHT="63" BASELINE="381 2089 2151 2082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2089 381 2104 2148 2098 2151 2082 2148 2054 2114 2041 2112 2041 2109 2041 2107 2041 2084 2052 1997 2041 1995 2041 1897 2052 1863 2041 1860 2041 1858 2041 1785 2052 1726 2041 1724 2041 1655 2052 1566 2041 1564 2041 1562 2041 1559 2041 1544 2054 1490 2043 1488 2043 1230 2054 1089 2043 1087 2043 968 2056 897 2046 895 2046 892 2046 866 2056 687 2046 685 2046 626 2056 594 2046 591 2046 589 2046 524 2056 409 2046 407 2046 405 2046 379 2056 381 2089"/>
                        </Shape>
                        <String CONTENT="shaking it off with the snow-beater, and finally drying for a long time in"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l26" HPOS="379" VPOS="2100" WIDTH="1772" HEIGHT="65" BASELINE="381 2150 2151 2141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2150 381 2165 2148 2156 2151 2141 2148 2113 2105 2100 2103 2100 2101 2100 1865 2111 1834 2100 1832 2100 1830 2100 1828 2100 1804 2111 1741 2100 1739 2100 1679 2113 1564 2102 1562 2102 1559 2102 1557 2102 1538 2115 1321 2115 1291 2102 1289 2102 1287 2102 1284 2102 1254 2115 1222 2104 1219 2104 1217 2104 1215 2104 1187 2115 977 2104 975 2104 973 2104 942 2115 856 2104 853 2104 851 2104 819 2117 793 2106 791 2106 788 2106 457 2117 405 2106 403 2106 401 2106 399 2106 379 2115 381 2150"/>
                        </Shape>
                        <String CONTENT="the cold dry wind. The Chukchee herdsman sometimes walks for a fortnight"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l27" HPOS="379" VPOS="2162" WIDTH="1774" HEIGHT="63" BASELINE="381 2210 2153 2204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2210 381 2225 2151 2219 2153 2204 2148 2173 1577 2162 1575 2162 1572 2162 1536 2173 1050 2165 1048 2165 966 2178 379 2178 381 2210"/>
                        </Shape>
                        <String CONTENT="in damp clothes without a chance to dry them, and takes off his undershirt"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l28" HPOS="379" VPOS="2225" WIDTH="1772" HEIGHT="59" BASELINE="381 2269 2151 2260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2269 381 2284 2148 2277 2151 2260 2146 2232 823 2225 821 2225 819 2225 771 2236 438 2227 435 2227 379 2238 381 2269"/>
                        </Shape>
                        <String CONTENT="only when it is quite spoiled and unfit for further use. On this account the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l29" HPOS="379" VPOS="2286" WIDTH="1772" HEIGHT="58" BASELINE="381 2329 2151 2325" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2329 381 2342 2146 2344 2151 2325 2146 2295 392 2286 390 2286 388 2286 386 2286 386 2288 379 2292 381 2329"/>
                        </Shape>
                        <String CONTENT="Reindeer Chukchee are always anxious to avoid the damp. For instance,"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l30" HPOS="377" VPOS="2340" WIDTH="1774" HEIGHT="65" BASELINE="379 2392 2151 2381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 2392 379 2405 2148 2396 2151 2381 2148 2353 2099 2340 2097 2340 2094 2340 2092 2340 2068 2353 1876 2353 1821 2340 1819 2340 1817 2340 1791 2353 1540 2342 1538 2342 1536 2342 1492 2353 1455 2342 1453 2342 1451 2342 1449 2342 1447 2342 1432 2355 1419 2344 1416 2344 1414 2344 1412 2344 1313 2355 1284 2344 1282 2344 1280 2344 1278 2344 1276 2344 1256 2357 377 2357 379 2392"/>
                        </Shape>
                        <String CONTENT="before coming into the inner room, the whole dress, from the cap to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l31" HPOS="379" VPOS="2403" WIDTH="1774" HEIGHT="60" BASELINE="381 2450 2153 2442" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2450 381 2463 2151 2455 2153 2442 2148 2411 1267 2403 1265 2403 1263 2403 1215 2414 836 2405 834 2405 832 2405 830 2405 817 2416 405 2407 403 2407 401 2407 379 2416 381 2450"/>
                        </Shape>
                        <String CONTENT="shaggy boot-soles, is well beaten with the beater to remove the slightest"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l32" HPOS="379" VPOS="2466" WIDTH="1774" HEIGHT="58" BASELINE="381 2511 2153 2502" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2511 381 2524 2151 2515 2153 2502 2148 2472 823 2466 821 2466 379 2479 381 2511"/>
                        </Shape>
                        <String CONTENT="trace of snow, which otherwise would melt in the warm interior and cause"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l33" HPOS="379" VPOS="2522" WIDTH="1774" HEIGHT="61" BASELINE="381 2565 2153 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2565 381 2583 2151 2578 2153 2561 2148 2533 1267 2522 1265 2522 1263 2522 1261 2522 1245 2533 429 2524 427 2524 425 2524 379 2535 381 2565"/>
                        </Shape>
                        <String CONTENT="additional trouble. In the evening, when the sleeping-tents are put in place"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l34" HPOS="379" VPOS="2580" WIDTH="1774" HEIGHT="65" BASELINE="381 2630 2153 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2630 381 2645 2151 2634 2153 2619 2148 2591 1798 2580 1795 2580 1793 2580 1754 2591 464 2589 461 2589 379 2600 381 2630"/>
                        </Shape>
                        <String CONTENT="ready for occupancy, the entire camp begins to resound on all sides with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l35" HPOS="379" VPOS="2643" WIDTH="1774" HEIGHT="61" BASELINE="381 2686 2153 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2686 381 2704 2151 2697 2153 2680 2148 2652 992 2643 990 2643 988 2643 942 2654 407 2645 405 2645 403 2645 379 2654 381 2686"/>
                        </Shape>
                        <String CONTENT="short rapping of the snow-beaters, which lasts for half an hour before all the"/>
                    </TextLine>

                    <TextLine ID="mz_1-223_l36" HPOS="379" VPOS="2704" WIDTH="1776" HEIGHT="67" BASELINE="381 2751 2155 2741" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2751 381 2771 1640 2758 1798 2767 1800 2767 1902 2756 2135 2764 2138 2764 2140 2764 2142 2764 2155 2754 2155 2741 2151 2704 1089 2704 1087 2704 1085 2704 1061 2715 741 2706 739 2706 665 2717 487 2708 485 2708 379 2719 381 2751"/>
                        </Shape>
