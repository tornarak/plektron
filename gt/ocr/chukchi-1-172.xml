                        <Shape>
                            <Polygon POINTS="675 2173 675 2188 2445 2182 2447 2167 2442 2139 2364 2126 2362 2126 2360 2126 2358 2126 2341 2136 1968 2126 1966 2126 1964 2126 1962 2126 1946 2139 1836 2139 1344 2128 1342 2128 1208 2141 796 2130 794 2130 673 2143 675 2173"/>
                        </Shape>
                        <String CONTENT="especially in the fall; and sudden squalls are frequent. The skin boat, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l27" HPOS="673" VPOS="2188" WIDTH="1774" HEIGHT="61" BASELINE="675 2232 2447 2227" TAGREFS="TYPE_4">
                        <Shape>
