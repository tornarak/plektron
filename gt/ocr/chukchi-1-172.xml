                        <Shape>
                            <Polygon POINTS="673 2649 673 2667 2442 2662 2445 2645 2440 2617 671 2617 673 2649"/>
                        </Shape>
                        <String CONTENT="is thrown from the stern, or another man jumps out with it. By pulling the"/>
                    </TextLine>

