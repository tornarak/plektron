                    <TextLine ID="mz_1-172_l30" HPOS="677" VPOS="2372" WIDTH="1772" HEIGHT="57" BASELINE="677 2409 2449 2409" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="677 2409 677 2429 2449 2429 2449 2409 2449 2372 677 2372 677 2409"/>
                        </Shape>
                        <String CONTENT="by oars, boldly makes for the shore, and in a favorable moment the end of"/>
                    </TextLine>

