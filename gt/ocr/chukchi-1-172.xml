                        </Shape>
                        <String CONTENT="caught in a storm, does not seek the harbor, but makes for the first sandy"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l28" HPOS="673" VPOS="2249" WIDTH="1772" HEIGHT="61" BASELINE="675 2292 2445 2288" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="675 2292 675 2310 2442 2310 2445 2288 2440 2260 1559 2249 1557 2249 1470 2260 764 2251 762 2251 673 2262 675 2292"/>
