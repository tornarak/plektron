                        <Shape>
                            <Polygon POINTS="675 2470 675 2487 2440 2485 2442 2468 2436 2439 673 2439 675 2470"/>
                        </Shape>
                        <String CONTENT="a rope is thrown to the shore, or, when there is nobody to catch it, a man"/>
