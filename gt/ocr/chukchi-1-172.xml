                    <TextLine ID="mz_1-172_l22" HPOS="677" VPOS="1900" WIDTH="1772" HEIGHT="48" BASELINE="677 1931 2449 1931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="677 1931 677 1948 2449 1948 2449 1931 2449 1900 677 1900 677 1931"/>
                        </Shape>
