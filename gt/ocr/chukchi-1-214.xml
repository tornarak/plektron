                    <TextLine ID="mz_1-214_l5" HPOS="734" VPOS="846" WIDTH="1663" HEIGHT="67" BASELINE="736 883 2397 887" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 883 734 898 799 911 801 911 1565 902 1619 913 1622 913 2395 902 2397 887 2395 857 736 846 736 883"/>
                        </Shape>
                        <String CONTENT="When the skin cover is on, three large stretchers are used to tighten"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l6" HPOS="621" VPOS="915" WIDTH="1774" HEIGHT="59" BASELINE="623 948 2395 943" TAGREFS="TYPE_4">
                        <Shape>
