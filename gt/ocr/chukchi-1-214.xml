<Shape>
                        <Polygon POINTS="623 1873 2401 1873 2401 2772 623 2772"/>
                    </Shape>
                    <TextLine ID="mz_1-214_l22" HPOS="729" VPOS="1864" WIDTH="1661" HEIGHT="69" BASELINE="731 1905 2390 1909" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1905 729 1920 747 1931 749 1931 751 1931 753 1931 1498 1922 1565 1933 1567 1933 2388 1922 2390 1909 2390 1879 2358 1866 2356 1866 2354 1866 2351 1866 2323 1877 2306 1866 2304 1866 2302 1866 2299 1866 2297 1866 2269 1877 2245 1866 2243 1866 2241 1866 2239 1866 2206 1879 2094 1879 2079 1866 2076 1866 2074 1866 2072 1866 1964 1877 1912 1866 1910 1866 1907 1866 1881 1877 1849 1866 1847 1866 1845 1866 1842 1866 1803 1879 1669 1879 1650 1866 1648 1866 1645 1866 1643 1866 1474 1874 1457 1864 1455 1864 1453 1864 1450 1864 1448 1864 1420 1874 1386 1864 1383 1864 1381 1864 1379 1864 1351 1874 1236 1864 1234 1864 1232 1864 1208 1874 1186 1864 1184 1864 1182 1864 1104 1874 1026 1864 1024 1864 1022 1864 1020 1864 1000 1874 731 1868 731 1905"/>
                        </Shape>
                        <String CONTENT="The cover (retteˊm) is made in two pieces: only in small tents is it in"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l23" HPOS="619" VPOS="1924" WIDTH="1771" HEIGHT="67" BASELINE="621 1965 2390 1970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1965 619 1978 634 1989 636 1989 638 1989 641 1989 1427 1980 1515 1991 1518 1991 2388 1980 2390 1970 2388 1939 2319 1926 2317 1926 2315 1926 2280 1937 2243 1926 2241 1926 2239 1926 1992 1937 1927 1926 1925 1926 1923 1926 1879 1937 1797 1926 1795 1926 1793 1926 1767 1937 1717 1926 1715 1926 1713 1926 1680 1937 1619 1926 1617 1926 1537 1937 1463 1924 1461 1924 1459 1924 1424 1935 1383 1924 1381 1924 1379 1924 1377 1924 1338 1935 1087 1924 1084 1924 1082 1924 1048 1935 1002 1924 1000 1924 998 1924 996 1924 968 1935 937 1924 935 1924 933 1924 931 1924 898 1935 781 1924 779 1924 621 1933 621 1965"/>
                        </Shape>
                        <String CONTENT="one piece. It is thrown over the frame with the hair side out, and is then"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l24" HPOS="619" VPOS="1983" WIDTH="1769" HEIGHT="67" BASELINE="621 2024 2388 2030" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2024 619 2037 2384 2050 2388 2030 2384 1987 2211 1998 2146 1987 2143 1987 1775 1996 1741 1985 1739 1985 1736 1985 1734 1985 1702 1996 1609 1985 1606 1985 1407 1996 1379 1985 1377 1985 1375 1985 1297 1996 1249 1985 1247 1985 1245 1985 1243 1985 1240 1985 1227 1996 1212 1983 1210 1983 1208 1983 1206 1983 1097 1993 1054 1983 1052 1983 1050 1983 1048 1983 1007 1993 911 1983 909 1983 621 1991 621 2024"/>
                        </Shape>
                        <String CONTENT="fastened with cords which have been sewed to its ends. A circular opening"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l25" HPOS="621" VPOS="2054" WIDTH="1769" HEIGHT="50" BASELINE="621 2089 2390 2089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2089 621 2104 2390 2104 2390 2089 2390 2058 621 2054 621 2089"/>
                        </Shape>
                        <String CONTENT="is left at the top for purposes of ventilation. The strongest of these cords"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l26" HPOS="619" VPOS="2110" WIDTH="1771" HEIGHT="55" BASELINE="621 2147 2390 2141" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2147 621 2165 2388 2158 2390 2141 2384 2110 619 2117 621 2147"/>
                        </Shape>
                        <String CONTENT="are drawn across the tent inside, and fastened to the bottoms of the central"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l27" HPOS="621" VPOS="2162" WIDTH="1772" HEIGHT="72" BASELINE="623 2210 2393 2201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 2210 623 2234 742 2223 1050 2232 1052 2232 1054 2232 1056 2232 1056 2229 1067 2221 1502 2229 1505 2229 1600 2219 1946 2227 1949 2227 1951 2227 1953 2227 1953 2225 1964 2216 2390 2216 2393 2201 2386 2162 621 2177 623 2210"/>
                        </Shape>
                        <String CONTENT="poles or to heavy sledges. An entrance is left between the two halves of"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l28" HPOS="619" VPOS="2227" WIDTH="1771" HEIGHT="57" BASELINE="621 2268 2390 2260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2268 621 2284 2388 2277 2390 2260 2386 2227 638 2227 636 2227 634 2227 632 2227 619 2234 621 2268"/>
                        </Shape>
                        <String CONTENT="the cover, so that one end of the flap may be turned aside and then fall"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l29" HPOS="619" VPOS="2279" WIDTH="1771" HEIGHT="67" BASELINE="621 2329 2390 2320" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2329 621 2346 2388 2346 2390 2320 2386 2292 1959 2279 1957 2279 1892 2292 1576 2281 1574 2281 1572 2281 1526 2292 1509 2281 1507 2281 1505 2281 1502 2281 1500 2281 1472 2297 1308 2297 1292 2284 1290 2284 1288 2284 1286 2284 1217 2294 1145 2284 1143 2284 1026 2297 859 2286 857 2286 855 2286 825 2297 786 2286 783 2286 781 2286 779 2286 747 2297 721 2286 718 2286 716 2286 619 2292 621 2329"/>
                        </Shape>
                        <String CONTENT="back by its own weight. The cover is made of skins of full-grown reindeer,"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l30" HPOS="619" VPOS="2340" WIDTH="1771" HEIGHT="65" BASELINE="621 2390 2390 2381" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2390 621 2405 2388 2396 2390 2381 2388 2351 2369 2340 2367 2340 2364 2340 2362 2340 2271 2351 2206 2340 2204 2340 1940 2353 1721 2342 1719 2342 1717 2342 1691 2355 1481 2355 1171 2344 1169 2344 1167 2344 1141 2355 1095 2344 1093 2344 1091 2344 913 2357 662 2346 660 2346 658 2346 619 2359 621 2390"/>
                        </Shape>
                        <String CONTENT="which have previously done service as covers of the inner room. The thick"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l31" HPOS="619" VPOS="2400" WIDTH="1771" HEIGHT="65" BASELINE="621 2450 2390 2444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2450 621 2465 2388 2465 2390 2444 2386 2411 1799 2400 1797 2400 1795 2400 1767 2411 1249 2403 1247 2403 1245 2403 1206 2416 619 2416 621 2450"/>
                        </Shape>
                        <String CONTENT="hair of these, however, is closely clipped off to make them lighter. In front,"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l32" HPOS="619" VPOS="2468" WIDTH="1774" HEIGHT="58" BASELINE="621 2511 2393 2500" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2511 621 2526 2390 2515 2393 2500 2388 2468 701 2468 699 2468 619 2478 621 2511"/>
                        </Shape>
                        <String CONTENT="a piece of walrus-gut or of well-scraped thin reindeer-skin is sometimes inserted"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l33" HPOS="619" VPOS="2520" WIDTH="1774" HEIGHT="62" BASELINE="621 2567 2393 2561" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 2567 621 2582 2390 2576 2393 2561 2390 2533 2341 2520 2338 2520 2336 2520 2334 2520 2308 2533 2118 2533 2085 2520 2083 2520 2081 2520 2079 2520 2076 2520 2061 2533 1799 2533 1221 2522 1219 2522 1123 2535 1071 2524 1069 2524 985 2535 855 2524 853 2524 851 2524 848 2524 831 2535 742 2524 740 2524 619 2537 621 2567"/>
                        </Shape>
