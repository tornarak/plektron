                        </Shape>
                        <String CONTENT="its sides (Fig. 92, e). The stretcher consists of a thin, slightly curved cross-"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l7" HPOS="621" VPOS="963" WIDTH="1774" HEIGHT="67" BASELINE="623 1011 2395 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1011 623 1030 2393 1021 2395 1004 2393 976 2360 963 2358 963 2356 963 2354 963 2351 963 2336 974 1990 963 1988 963 1918 974 1886 963 1884 963 1881 963 1777 976 1723 965 1721 965 1719 965 1689 976 1407 965 1405 965 1305 976 1212 965 1210 965 1208 965 1156 978 1089 967 1087 967 1024 978 1002 967 1000 967 768 967 766 967 764 967 762 967 744 978 656 967 654 967 651 967 621 978 623 1011"/>
                        </Shape>
                        <String CONTENT="piece fastened in the middle to the end of a long pole. The cross-piece is"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l8" HPOS="619" VPOS="1026" WIDTH="1774" HEIGHT="58" BASELINE="621 1067 2393 1065" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1067 621 1082 2388 1084 2393 1065 2388 1037 801 1026 799 1026 619 1037 621 1067"/>
                        </Shape>
                        <String CONTENT="set against one of the roof-poles (d), and the butt-end of the pole is firmly"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l9" HPOS="621" VPOS="1086" WIDTH="1772" HEIGHT="63" BASELINE="623 1132 2393 1125" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1132 623 1149 2390 1145 2393 1125 2388 1095 1238 1086 1236 1086 621 1099 623 1132"/>
                        </Shape>
                        <String CONTENT="propped against the ground; then it is pushed outward as far as possible by"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l10" HPOS="621" VPOS="1143" WIDTH="1774" HEIGHT="60" BASELINE="623 1184 2395 1188" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1184 621 1199 2390 1203 2395 1188 2395 1158 2345 1145 2343 1145 2341 1145 2286 1156 2252 1145 2250 1145 2247 1145 2115 1156 2055 1145 2053 1145 2050 1145 2029 1156 1985 1145 1983 1145 1981 1145 1979 1145 1955 1158 1827 1158 1775 1145 1773 1145 1771 1145 1769 1145 1754 1158 1619 1158 1593 1145 1591 1145 1589 1145 1587 1145 1552 1156 1509 1143 1507 1143 1505 1143 1502 1143 1461 1153 1444 1143 1442 1143 1440 1143 1437 1143 1435 1143 1390 1156 1121 1156 1084 1143 1082 1143 1080 1143 1017 1153 942 1143 939 1143 623 1151 623 1184"/>
                        </Shape>
                        <String CONTENT="successive jerks. The tent, propped with the stretchers on all sides, looks like"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l11" HPOS="619" VPOS="1203" WIDTH="1774" HEIGHT="67" BASELINE="621 1244 2393 1249" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1244 619 1262 632 1270 634 1270 636 1270 638 1270 2390 1262 2393 1249 2393 1216 2373 1205 2371 1205 2369 1205 2367 1205 2364 1205 2334 1216 2291 1205 2289 1205 2286 1205 2076 1216 1990 1205 1988 1205 1985 1205 1949 1218 1721 1218 1667 1205 1665 1205 1518 1216 1496 1203 1494 1203 1492 1203 1489 1203 1427 1214 1381 1203 1379 1203 1377 1203 1375 1203 1349 1214 1336 1203 1334 1203 1331 1203 1329 1203 1275 1214 1167 1203 1165 1203 621 1212 621 1244"/>
                        </Shape>
                        <String CONTENT="a highly inflated bladder, and is able to resist a strong wind. To make it"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l12" HPOS="621" VPOS="1268" WIDTH="1776" HEIGHT="56" BASELINE="623 1303 2397 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1303 621 1318 2393 1324 2397 1309 2393 1268 623 1270 623 1303"/>
                        </Shape>
                        <String CONTENT="still more solid, the central poles and some of the most important joints of"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l13" HPOS="621" VPOS="1331" WIDTH="1767" HEIGHT="63" BASELINE="623 1363 2388 1372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1363 621 1381 634 1389 636 1389 638 1389 641 1389 957 1381 1065 1392 1067 1394 2386 1394 2388 1372 2386 1340 623 1331 623 1363"/>
                        </Shape>
                        <String CONTENT="the frame are strengthened by means of heavy stones tied to them with ropes,"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l14" HPOS="619" VPOS="1394" WIDTH="1771" HEIGHT="56" BASELINE="621 1426 2390 1431" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1426 619 1439 2386 1450 2390 1431 2388 1398 621 1394 621 1426"/>
                        </Shape>
                        <String CONTENT="or by loaded sledges, which are pushed from inside against the skin cover,"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l15" HPOS="619" VPOS="1446" WIDTH="1774" HEIGHT="67" BASELINE="621 1489 2393 1485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1489 621 1502 1502 1511 1505 1511 1583 1500 1645 1511 1648 1511 1650 1511 1674 1500 1832 1511 1834 1511 1903 1500 1988 1511 1990 1511 1992 1511 1994 1511 2007 1502 2018 1511 2020 1511 2022 1511 2024 1513 2169 1513 2169 1511 2172 1511 2174 1511 2189 1500 2263 1511 2265 1511 2267 1511 2269 1511 2282 1500 2347 1511 2349 1511 2351 1511 2393 1498 2393 1485 2388 1457 1507 1446 1505 1446 1440 1457 638 1448 636 1448 634 1448 632 1448 619 1454 621 1489"/>
                        </Shape>
                        <String CONTENT="the lower end of which is secured under the runners. The sledges are con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l16" HPOS="621" VPOS="1506" WIDTH="1774" HEIGHT="59" BASELINE="621 1550 2395 1550" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1550 621 1565 2395 1565 2395 1550 2395 1519 2163 1506 2161 1506 2159 1506 2122 1517 2094 1506 2092 1506 2089 1506 1968 1517 1912 1506 1910 1506 1845 1517 1810 1506 1808 1506 1806 1506 1803 1506 1773 1519 1593 1519 1552 1506 1550 1506 1548 1506 1466 1517 1418 1506 1416 1506 1414 1506 1412 1506 1386 1517 1290 1506 1288 1506 1286 1506 1260 1519 981 1519 924 1506 922 1506 920 1506 887 1517 827 1506 825 1506 822 1506 788 1517 755 1506 753 1506 751 1506 621 1517 621 1550"/>
                        </Shape>
                        <String CONTENT="nected with the upper part of the frame by taut cords. Fastened with thongs"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l17" HPOS="621" VPOS="1578" WIDTH="1774" HEIGHT="47" BASELINE="621 1608 2395 1608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="621 1608 621 1625 2395 1625 2395 1608 2395 1578 621 1578 621 1608"/>
                        </Shape>
                        <String CONTENT="and secured with stones and sledges, the Chukchee tent is able to withstand"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l18" HPOS="621" VPOS="1634" WIDTH="1772" HEIGHT="56" BASELINE="623 1664 2393 1669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1664 621 1677 686 1690 688 1690 2390 1682 2393 1669 2390 1638 623 1634 623 1664"/>
                        </Shape>
                        <String CONTENT="the fiercest wind-storms of the open tundra. I had occasion, however, to"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l19" HPOS="623" VPOS="1697" WIDTH="1772" HEIGHT="50" BASELINE="623 1729 2395 1729" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1729 623 1747 2395 1747 2395 1729 2393 1697 623 1697 623 1729"/>
                        </Shape>
                        <String CONTENT="witness a snowstorm which very quickly battered the frame, and almost caused"/>
                    </TextLine>

                    <TextLine ID="mz_1-214_l20" HPOS="623" VPOS="1747" WIDTH="1774" HEIGHT="69" BASELINE="623 1788 2397 1788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="623 1788 623 1801 818 1814 820 1814 907 1803 1375 1803 1444 1814 1446 1814 1498 1803 2195 1814 2198 1814 2200 1814 2202 1814 2217 1803 2230 1814 2232 1814 2234 1814 2237 1816 2375 1816 2375 1814 2377 1814 2380 1814 2397 1803 2397 1788 2397 1760 2319 1747 2317 1747 2256 1757 2200 1747 2198 1747 1433 1757 1396 1747 1394 1747 1392 1747 1390 1747 1347 1757 1260 1747 1258 1747 1256 1747 1253 1747 1238 1760 1078 1760 1024 1747 1022 1747 1020 1747 1017 1747 1002 1757 963 1747 961 1747 959 1747 898 1757 773 1747 770 1747 701 1757 643 1747 641 1747 638 1747 636 1747 623 1755 623 1788"/>
                        </Shape>
                        <String CONTENT="the collapse of the tent. The deep masses of snow which drifted against"/>
                    </TextLine>

