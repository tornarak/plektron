                        </Shape>
                        <String CONTENT="feet warm chiefly by motion. Indeed, a herdsman can use only thin leg-skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-308_l10" HPOS="584" VPOS="1145" WIDTH="1776" HEIGHT="60" BASELINE="586 1192 2360 1186" TAGREFS="TYPE_4">
