                    <TextLine ID="mz_1-149_l3" HPOS="355" VPOS="714" WIDTH="1774" HEIGHT="67" BASELINE="357 764 2129 760" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="420 725 399 727 377 727 360 727 355 727 357 764 357 777 2125 781 2129 760 2125 727 1839 714 1837 714 1765 725 1750 714 1748 714 1746 714 1744 714 1741 714 1739 714 1724 725 1711 714 1709 714 1707 714 1705 714 1616 725 1520 714 1518 714 1323 725 1269 714 1267 714 1206 727 1189 716 1187 716 1185 716 1183 716 433 727 422 725 420 725"/>
                        </Shape>
                        <String CONTENT="than an ordinary run. Well-rested dogs become excited at sight of the harness,"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l4" HPOS="355" VPOS="775" WIDTH="1330" HEIGHT="60" BASELINE="357 820 1685 816" TAGREFS="TYPE_6">
