                    <TextLine ID="mz_1-149_l3" HPOS="376" VPOS="729" WIDTH="1774" HEIGHT="67" BASELINE="378 779 2150 775" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="441 740 420 742 398 742 381 742 376 742 378 779 378 792 2146 796 2150 775 2146 742 1860 729 1858 729 1786 740 1771 729 1769 729 1767 729 1765 729 1762 729 1760 729 1745 740 1732 729 1730 729 1728 729 1726 729 1637 740 1541 729 1539 729 1344 740 1290 729 1288 729 1227 742 1210 731 1208 731 1206 731 1204 731 454 742 443 740 441 740"/>
                        </Shape>
                        <String CONTENT="than an ordinary run. Well-rested dogs become excited at sight of the harness,"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l4" HPOS="376" VPOS="790" WIDTH="1330" HEIGHT="60" BASELINE="378 835 1706 831" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="378 835 378 850 1704 848 1706 831 1702 801 1110 790 1108 790 1024 801 450 792 448 792 376 803 378 835"/>
                        </Shape>
                        <String CONTENT="and it is difficult to hold them in till everything is ready."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r3" HPOS="385" VPOS="856" WIDTH="1778" HEIGHT="475" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="385 856 2163 856 2163 1331 385 1331"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l5" HPOS="487" VPOS="861" WIDTH="1663" HEIGHT="50" BASELINE="487 896 2150 896" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="487 896 487 911 2150 911 2150 896 2150 866 487 861 487 896"/>
                        </Shape>
                        <String CONTENT="From the start, they go very fast, and want to go at a faster pace than"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l6" HPOS="381" VPOS="924" WIDTH="1771" HEIGHT="48" BASELINE="381 954 2152 954" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="381 954 381 972 2152 972 2152 954 2152 924 381 924 381 954"/>
                        </Shape>
                        <String CONTENT="they can keep up afterward. Down hill their pace is quite dangerous, since"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l7" HPOS="381" VPOS="967" WIDTH="1769" HEIGHT="72" BASELINE="383 1015 2150 1011" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 1015 383 1028 604 1039 606 1039 608 1039 634 1028 2148 1028 2150 1011 2146 978 1925 967 1923 967 1920 967 1918 967 1901 982 1806 982 1777 967 1775 967 1773 967 1771 967 1769 967 1752 982 1667 982 1552 967 1550 967 1548 967 1496 980 1409 967 1407 967 1405 967 1403 967 1386 980 1243 969 1240 969 1238 969 1197 982 1139 969 1136 969 1134 969 1132 969 1115 985 1026 985 1002 969 1000 969 998 969 909 969 907 969 905 969 874 982 846 969 844 969 842 969 840 969 838 969 822 982 807 969 805 969 803 969 662 969 660 969 658 969 628 982 513 969 511 969 508 969 459 982 411 969 409 969 407 969 404 969 402 969 381 980 383 1015"/>
                        </Shape>
                        <String CONTENT="the sledge behind is liable to hit them. The sledge — long, high, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l8" HPOS="385" VPOS="1045" WIDTH="1765" HEIGHT="52" BASELINE="385 1076 2150 1076" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1076 385 1088 2148 1097 2150 1076 2150 1045 385 1045 385 1076"/>
                        </Shape>
                        <String CONTENT="narrow — overturns easily; and the driver, at any unevenness in the road,"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l9" HPOS="381" VPOS="1099" WIDTH="1771" HEIGHT="50" BASELINE="383 1136 2152 1130" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 1136 383 1149 2150 1143 2152 1130 2146 1099 381 1099 383 1136"/>
                        </Shape>
                        <String CONTENT="has to exert the utmost care to swing the sledge, now to the right and now"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l10" HPOS="381" VPOS="1158" WIDTH="1771" HEIGHT="58" BASELINE="383 1190 2152 1195" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 1190 381 1208 394 1216 396 1216 398 1216 400 1216 2150 1210 2152 1195 2150 1162 383 1158 383 1190"/>
                        </Shape>
                        <String CONTENT="to the left, and to support it by hanging down from one side or by standing"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l11" HPOS="383" VPOS="1223" WIDTH="1767" HEIGHT="56" BASELINE="383 1253 2150 1253" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 1253 383 1268 398 1279 400 1279 402 1279 404 1279 454 1268 489 1279 491 1279 493 1279 565 1268 1253 1268 1282 1279 1284 1279 1286 1279 1368 1268 1463 1279 1466 1279 1940 1268 2083 1279 2085 1279 2148 1266 2150 1253 2148 1223 383 1223 383 1253"/>
                        </Shape>
                        <String CONTENT="on one of the runners. Of course a light sledge, although it goes faster, is"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l12" HPOS="383" VPOS="1270" WIDTH="812" HEIGHT="59" BASELINE="385 1314 1195 1309" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1314 385 1329 1193 1327 1195 1309 1191 1281 788 1270 786 1270 783 1270 781 1270 766 1281 454 1273 452 1273 383 1283 385 1314"/>
                        </Shape>
                        <String CONTENT="easier to handle than a heavy one."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r4" HPOS="385" VPOS="1331" WIDTH="1778" HEIGHT="244" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="385 1331 2163 1331 2163 1575 385 1575"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l13" HPOS="489" VPOS="1329" WIDTH="1665" HEIGHT="58" BASELINE="491 1374 2154 1370" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="491 1374 491 1387 2152 1383 2154 1370 2150 1342 1414 1329 1412 1329 1409 1329 1368 1340 1325 1329 1323 1329 1321 1329 1245 1342 1139 1331 1136 1331 1134 1331 1102 1344 918 1344 900 1331 898 1331 896 1331 894 1331 892 1331 851 1344 697 1344 684 1331 682 1331 680 1331 677 1331 489 1340 491 1374"/>
                        </Shape>
                        <String CONTENT="In short runs, dogs may be a little slower than the best reindeer or"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l14" HPOS="383" VPOS="1398" WIDTH="1769" HEIGHT="50" BASELINE="385 1435 2152 1431" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1435 385 1448 2150 1444 2152 1431 2148 1400 383 1398 385 1435"/>
                        </Shape>
                        <String CONTENT="horses; but for long distances they excel any animal used for conveyance."/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l15" HPOS="387" VPOS="1457" WIDTH="1765" HEIGHT="52" BASELINE="387 1491 2152 1491" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1491 387 1509 2152 1509 2152 1491 2152 1457 387 1457 387 1491"/>
                        </Shape>
                        <String CONTENT="I once had occasion to make, with a light sledge and good dogs, a hundred"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l16" HPOS="383" VPOS="1509" WIDTH="1693" HEIGHT="58" BASELINE="385 1552 2076 1547" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1552 385 1567 2074 1565 2076 1547 2072 1517 454 1509 452 1509 383 1519 385 1552"/>
                        </Shape>
                        <String CONTENT="and fifty miles in twenty-three hours, and two hundred miles in two days."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r5" HPOS="385" VPOS="1575" WIDTH="1778" HEIGHT="413" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="385 1575 2163 1575 2163 1988 385 1988"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l17" HPOS="493" VPOS="1578" WIDTH="1661" HEIGHT="50" BASELINE="493 1610 2154 1610" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="493 1610 493 1628 2154 1628 2154 1610 2154 1580 493 1578 493 1610"/>
                        </Shape>
                        <String CONTENT="Maydell mentions that in 1869, in a race between the merchant Baramigin"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l18" HPOS="381" VPOS="1623" WIDTH="1773" HEIGHT="65" BASELINE="383 1671 2154 1664" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 1671 383 1688 2152 1682 2154 1664 2150 1636 2011 1623 2009 1623 1951 1634 1933 1623 1931 1623 1929 1623 1927 1623 1925 1623 1901 1634 1884 1623 1881 1623 1879 1623 1877 1623 1875 1623 1873 1623 1858 1636 1765 1636 1734 1623 1732 1623 1730 1623 1667 1634 1643 1623 1641 1623 1639 1623 1559 1636 1416 1625 1414 1625 1412 1625 1409 1625 1394 1638 1286 1638 1253 1625 1251 1625 1249 1625 1247 1625 1225 1636 1173 1625 1171 1625 1169 1625 1167 1625 1149 1638 1043 1638 987 1625 985 1625 983 1625 939 1638 459 1628 456 1628 381 1641 383 1671"/>
                        </Shape>
                        <String CONTENT="and Chief Officer Anatovsky, on the Lower Kolyma, the dogs of the former"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l19" HPOS="385" VPOS="1688" WIDTH="1771" HEIGHT="59" BASELINE="385 1732 2156 1732" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1732 385 1747 2156 1747 2156 1732 2156 1699 2120 1688 2118 1688 2115 1688 2113 1688 2089 1699 2061 1688 2059 1688 2057 1688 2055 1688 2027 1699 1964 1688 1962 1688 1849 1699 1810 1688 1808 1688 1806 1688 1290 1699 1275 1688 1273 1688 1271 1688 1178 1688 1175 1688 1173 1688 1126 1699 1076 1688 1074 1688 948 1699 851 1688 848 1688 744 1699 662 1688 660 1688 610 1699 567 1688 565 1688 563 1688 508 1699 474 1688 472 1688 469 1688 385 1699 385 1732"/>
                        </Shape>
                        <String CONTENT="made the distance between the Anui market-place and Nishne-Kolymsk (a"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l20" HPOS="383" VPOS="1744" WIDTH="1773" HEIGHT="63" BASELINE="385 1790 2156 1786" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1790 385 1807 2154 1803 2156 1786 2152 1755 1271 1744 1269 1744 1266 1744 1227 1757 383 1757 385 1790"/>
                        </Shape>
                        <String CONTENT="hundred and fifty English miles) in fifteen hours, and the dogs of the latter"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l21" HPOS="383" VPOS="1803" WIDTH="1771" HEIGHT="65" BASELINE="385 1853 2154 1846" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1853 385 1868 2152 1861 2154 1846 2150 1816 1648 1803 1645 1803 1643 1803 1606 1814 1580 1803 1578 1803 1576 1803 1574 1803 1548 1816 1485 1805 1483 1805 1481 1805 1453 1816 1325 1805 1323 1805 1321 1805 1273 1816 1136 1805 1134 1805 1132 1805 1110 1816 1052 1805 1050 1805 972 1818 924 1807 922 1807 920 1807 682 1818 634 1807 632 1807 630 1807 628 1807 604 1818 478 1807 476 1807 474 1807 435 1818 398 1807 396 1807 394 1807 391 1807 389 1807 389 1809 383 1814 385 1853"/>
                        </Shape>
                        <String CONTENT="in sixteen hours. While on the Kolyma I also heard of this race; and, in my"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l22" HPOS="383" VPOS="1864" WIDTH="1771" HEIGHT="62" BASELINE="385 1913 2154 1907" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 1913 385 1926 2152 1922 2154 1907 2150 1877 2089 1864 2087 1864 2085 1864 2063 1874 1979 1864 1977 1864 1899 1874 1884 1864 1881 1864 1879 1864 1877 1864 1767 1874 1674 1864 1671 1864 1669 1864 1637 1874 1593 1864 1591 1864 1589 1864 1587 1864 1559 1877 1522 1866 1520 1866 1518 1866 1515 1866 1487 1877 1420 1866 1418 1866 1416 1866 1386 1877 868 1868 866 1868 864 1868 861 1868 848 1879 822 1868 820 1868 818 1868 550 1879 446 1868 443 1868 383 1881 385 1913"/>
                        </Shape>
                        <String CONTENT="opinion, the speed displayed on that occasion is the highest that Siberian"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l23" HPOS="385" VPOS="1929" WIDTH="1247" HEIGHT="56" BASELINE="387 1970 1632 1965" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 1970 387 1985 1630 1980 1632 1965 1628 1937 407 1929 404 1929 402 1929 400 1929 385 1935 387 1970"/>
                        </Shape>
                        <String CONTENT="dogs have been known to exhibit over long distances."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r6" HPOS="385" VPOS="1988" WIDTH="1778" HEIGHT="954" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="385 1988 2163 1988 2163 2942 385 2942"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l24" HPOS="491" VPOS="1983" WIDTH="1665" HEIGHT="62" BASELINE="493 2032 2156 2026" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="493 2032 493 2045 2154 2039 2156 2026 2152 1996 2029 1996 2005 1983 2003 1983 2001 1983 1998 1983 1996 1983 1983 1996 1888 1996 1847 1983 1845 1983 1842 1983 1840 1983 1838 1983 1821 1996 1554 1996 1515 1985 1513 1985 1511 1985 1444 1996 1416 1985 1414 1985 1412 1985 1409 1985 1407 1985 1392 1998 1182 1998 1149 1985 1147 1985 1145 1985 1065 1996 1052 1985 1050 1985 1048 1985 1046 1985 1043 1985 991 1998 976 1987 974 1987 972 1987 970 1987 491 1996 493 2032"/>
                        </Shape>
                        <String CONTENT="In the month of March and on a good trail, a strong well-rested team"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l25" HPOS="383" VPOS="2045" WIDTH="1773" HEIGHT="63" BASELINE="385 2091 2156 2084" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2091 385 2108 2154 2102 2156 2084 2152 2054 974 2045 972 2045 913 2056 550 2048 547 2048 383 2058 385 2091"/>
                        </Shape>
                        <String CONTENT="can make five hundred miles in ten days, and, after two days’ rest, will continue"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l26" HPOS="385" VPOS="2108" WIDTH="1774" HEIGHT="57" BASELINE="387 2149 2159 2145" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2149 387 2165 2156 2160 2159 2145 2148 2113 428 2108 426 2108 424 2108 385 2119 387 2149"/>
                        </Shape>
                        <String CONTENT="with the same speed. In the winter of 1900-01 I made from four thousand"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l27" HPOS="383" VPOS="2162" WIDTH="1773" HEIGHT="63" BASELINE="385 2210 2156 2203" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2210 385 2225 2154 2219 2156 2203 2152 2171 2070 2162 2068 2162 2003 2173 1981 2162 1979 2162 1977 2162 1873 2173 1845 2162 1842 2162 1840 2162 1775 2173 1728 2162 1726 2162 1723 2162 1721 2162 1719 2162 1702 2173 1539 2165 1537 2165 1453 2175 1409 2165 1407 2165 1405 2165 1344 2175 1308 2165 1305 2165 1303 2165 1301 2165 1275 2175 1197 2165 1195 2165 1091 2175 1052 2165 1050 2165 1048 2165 1046 2165 1015 2175 983 2165 981 2165 978 2165 918 2177 580 2167 578 2167 576 2167 541 2177 469 2167 467 2167 383 2180 385 2210"/>
                        </Shape>
                        <String CONTENT="to five thousand miles with dogs, changing from time to time those that had"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l28" HPOS="385" VPOS="2225" WIDTH="1774" HEIGHT="61" BASELINE="387 2268 2159 2264" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2268 387 2286 2156 2281 2159 2264 2148 2234 1282 2225 1279 2225 1277 2225 1275 2225 1260 2236 511 2227 508 2227 385 2238 387 2268"/>
                        </Shape>
                        <String CONTENT="sore feet or were over-tired. In the spring, after a continuous drive of fourteen"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l29" HPOS="385" VPOS="2286" WIDTH="1771" HEIGHT="69" BASELINE="387 2329 2156 2323" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2329 387 2344 712 2355 714 2355 716 2355 718 2355 736 2344 803 2353 805 2353 1180 2342 1262 2353 1264 2353 1266 2353 1269 2353 1284 2342 1537 2351 1539 2351 1799 2340 1845 2351 1847 2351 1849 2353 2120 2353 2120 2351 2122 2351 2156 2338 2156 2323 2152 2294 976 2286 974 2286 972 2286 948 2297 407 2288 404 2288 402 2288 400 2288 385 2294 387 2329"/>
                        </Shape>
                        <String CONTENT="days, our dogs were so tired that they would lie down on the slightest provo-"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l30" HPOS="385" VPOS="2346" WIDTH="1771" HEIGHT="59" BASELINE="387 2390 2156 2383" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2390 387 2405 2154 2398 2156 2383 2152 2355 976 2346 974 2346 885 2357 452 2349 450 2349 385 2359 387 2390"/>
                        </Shape>
                        <String CONTENT="cation, and we had much trouble in rousing them from sleep after even a"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l31" HPOS="385" VPOS="2405" WIDTH="1774" HEIGHT="58" BASELINE="387 2450 2159 2444" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2450 387 2463 2156 2457 2159 2444 2148 2411 1039 2405 1037 2405 385 2418 387 2450"/>
                        </Shape>
                        <String CONTENT="moment’s stop. However, three dogs of mine were able to make the entire"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l32" HPOS="383" VPOS="2459" WIDTH="1773" HEIGHT="76" BASELINE="385 2511 2156 2502" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2511 385 2535 2154 2522 2156 2502 2152 2472 1784 2459 1782 2459 1780 2459 1756 2470 1630 2461 1628 2461 1541 2472 1520 2461 1518 2461 1515 2461 1513 2461 1511 2461 1494 2474 1375 2474 1295 2461 1292 2461 1197 2474 989 2463 987 2463 985 2463 939 2474 907 2463 905 2463 903 2463 796 2476 586 2465 584 2465 506 2476 400 2465 398 2465 396 2465 394 2465 383 2472 385 2511"/>
                        </Shape>
                        <String CONTENT="journey from the mouth of the Anadyr River to the middle of Kamchatka, up"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l33" HPOS="385" VPOS="2524" WIDTH="1774" HEIGHT="61" BASELINE="387 2569 2159 2561" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2569 387 2585 2156 2576 2159 2561 2148 2528 827 2524 825 2524 822 2524 786 2535 459 2526 456 2526 385 2537 387 2569"/>
                        </Shape>
                        <String CONTENT="and down, and farther on to Indian Point, and still looked sleek and fat in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l34" HPOS="385" VPOS="2580" WIDTH="1774" HEIGHT="63" BASELINE="387 2630 2159 2621" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="387 2630 387 2643 2156 2636 2159 2621 2148 2589 1741 2580 1739 2580 1736 2580 1697 2591 931 2585 929 2585 385 2598 387 2630"/>
                        </Shape>
                        <String CONTENT="summer, after two weeks’ rest. Progress with a few weak and half-starved"/>
                    </TextLine>

