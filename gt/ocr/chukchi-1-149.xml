                    <TextLine ID="mz_1-149_l5" HPOS="466" VPOS="846" WIDTH="1663" HEIGHT="50" BASELINE="466 881 2129 881" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="466 881 466 896 2129 896 2129 881 2129 851 466 846 466 881"/>
                        </Shape>
                        <String CONTENT="From the start, they go very fast, and want to go at a faster pace than"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l6" HPOS="360" VPOS="909" WIDTH="1771" HEIGHT="48" BASELINE="360 939 2131 939" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="360 939 360 957 2131 957 2131 939 2131 909 360 909 360 939"/>
                        </Shape>
                        <String CONTENT="they can keep up afterward. Down hill their pace is quite dangerous, since"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l7" HPOS="360" VPOS="952" WIDTH="1769" HEIGHT="72" BASELINE="362 1000 2129 996" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1000 362 1013 583 1024 585 1024 587 1024 613 1013 2127 1013 2129 996 2125 963 1904 952 1902 952 1899 952 1897 952 1880 967 1785 967 1756 952 1754 952 1752 952 1750 952 1748 952 1731 967 1646 967 1531 952 1529 952 1527 952 1475 965 1388 952 1386 952 1384 952 1382 952 1365 965 1222 954 1219 954 1217 954 1176 967 1118 954 1115 954 1113 954 1111 954 1094 970 1005 970 981 954 979 954 977 954 888 954 886 954 884 954 853 967 825 954 823 954 821 954 819 954 817 954 801 967 786 954 784 954 782 954 641 954 639 954 637 954 607 967 492 954 490 954 487 954 438 967 390 954 388 954 386 954 383 954 381 954 360 965 362 1000"/>
                        </Shape>
                        <String CONTENT="the sledge behind is liable to hit them. The sledge — long, high, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l8" HPOS="364" VPOS="1030" WIDTH="1765" HEIGHT="52" BASELINE="364 1061 2129 1061" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1061 364 1073 2127 1082 2129 1061 2129 1030 364 1030 364 1061"/>
                        </Shape>
                        <String CONTENT="narrow — overturns easily; and the driver, at any unevenness in the road,"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l9" HPOS="360" VPOS="1084" WIDTH="1771" HEIGHT="50" BASELINE="362 1121 2131 1115" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1121 362 1134 2129 1128 2131 1115 2125 1084 360 1084 362 1121"/>
                        </Shape>
                        <String CONTENT="has to exert the utmost care to swing the sledge, now to the right and now"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l10" HPOS="360" VPOS="1143" WIDTH="1771" HEIGHT="58" BASELINE="362 1175 2131 1180" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1175 360 1193 373 1201 375 1201 377 1201 379 1201 2129 1195 2131 1180 2129 1147 362 1143 362 1175"/>
                        </Shape>
                        <String CONTENT="to the left, and to support it by hanging down from one side or by standing"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l11" HPOS="362" VPOS="1208" WIDTH="1767" HEIGHT="56" BASELINE="362 1238 2129 1238" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1238 362 1253 377 1264 379 1264 381 1264 383 1264 433 1253 468 1264 470 1264 472 1264 544 1253 1232 1253 1261 1264 1263 1264 1265 1264 1347 1253 1442 1264 1445 1264 1919 1253 2062 1264 2064 1264 2127 1251 2129 1238 2127 1208 362 1208 362 1238"/>
                        </Shape>
                        <String CONTENT="on one of the runners. Of course a light sledge, although it goes faster, is"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l12" HPOS="362" VPOS="1255" WIDTH="812" HEIGHT="59" BASELINE="364 1299 1174 1294" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1299 364 1314 1172 1312 1174 1294 1170 1266 767 1255 765 1255 762 1255 760 1255 745 1266 433 1258 431 1258 362 1268 364 1299"/>
                        </Shape>
                        <String CONTENT="easier to handle than a heavy one."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r4" HPOS="364" VPOS="1316" WIDTH="1778" HEIGHT="244" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="364 1316 2142 1316 2142 1560 364 1560"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l13" HPOS="468" VPOS="1314" WIDTH="1665" HEIGHT="58" BASELINE="470 1359 2133 1355" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="470 1359 470 1372 2131 1368 2133 1355 2129 1327 1393 1314 1391 1314 1388 1314 1347 1325 1304 1314 1302 1314 1300 1314 1224 1327 1118 1316 1115 1316 1113 1316 1081 1329 897 1329 879 1316 877 1316 875 1316 873 1316 871 1316 830 1329 676 1329 663 1316 661 1316 659 1316 656 1316 468 1325 470 1359"/>
                        </Shape>
                        <String CONTENT="In short runs, dogs may be a little slower than the best reindeer or"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l14" HPOS="362" VPOS="1383" WIDTH="1769" HEIGHT="50" BASELINE="364 1420 2131 1416" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1420 364 1433 2129 1429 2131 1416 2127 1385 362 1383 364 1420"/>
                        </Shape>
                        <String CONTENT="horses; but for long distances they excel any animal used for conveyance."/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l15" HPOS="366" VPOS="1442" WIDTH="1765" HEIGHT="52" BASELINE="366 1476 2131 1476" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1476 366 1494 2131 1494 2131 1476 2131 1442 366 1442 366 1476"/>
                        </Shape>
                        <String CONTENT="I once had occasion to make, with a light sledge and good dogs, a hundred"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l16" HPOS="362" VPOS="1494" WIDTH="1693" HEIGHT="58" BASELINE="364 1537 2055 1532" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1537 364 1552 2053 1550 2055 1532 2051 1502 433 1494 431 1494 362 1504 364 1537"/>
                        </Shape>
                        <String CONTENT="and fifty miles in twenty-three hours, and two hundred miles in two days."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r5" HPOS="364" VPOS="1560" WIDTH="1778" HEIGHT="413" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="364 1560 2142 1560 2142 1973 364 1973"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l17" HPOS="472" VPOS="1563" WIDTH="1661" HEIGHT="50" BASELINE="472 1595 2133 1595" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="472 1595 472 1613 2133 1613 2133 1595 2133 1565 472 1563 472 1595"/>
                        </Shape>
                        <String CONTENT="Maydell mentions that in 1869, in a race between the merchant Baramigin"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l18" HPOS="360" VPOS="1608" WIDTH="1773" HEIGHT="65" BASELINE="362 1656 2133 1649" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="362 1656 362 1673 2131 1667 2133 1649 2129 1621 1990 1608 1988 1608 1930 1619 1912 1608 1910 1608 1908 1608 1906 1608 1904 1608 1880 1619 1863 1608 1860 1608 1858 1608 1856 1608 1854 1608 1852 1608 1837 1621 1744 1621 1713 1608 1711 1608 1709 1608 1646 1619 1622 1608 1620 1608 1618 1608 1538 1621 1395 1610 1393 1610 1391 1610 1388 1610 1373 1623 1265 1623 1232 1610 1230 1610 1228 1610 1226 1610 1204 1621 1152 1610 1150 1610 1148 1610 1146 1610 1128 1623 1022 1623 966 1610 964 1610 962 1610 918 1623 438 1613 435 1613 360 1626 362 1656"/>
                        </Shape>
                        <String CONTENT="and Chief Officer Anatovsky, on the Lower Kolyma, the dogs of the former"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l19" HPOS="364" VPOS="1673" WIDTH="1771" HEIGHT="59" BASELINE="364 1717 2135 1717" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1717 364 1732 2135 1732 2135 1717 2135 1684 2099 1673 2097 1673 2094 1673 2092 1673 2068 1684 2040 1673 2038 1673 2036 1673 2034 1673 2006 1684 1943 1673 1941 1673 1828 1684 1789 1673 1787 1673 1785 1673 1269 1684 1254 1673 1252 1673 1250 1673 1157 1673 1154 1673 1152 1673 1105 1684 1055 1673 1053 1673 927 1684 830 1673 827 1673 723 1684 641 1673 639 1673 589 1684 546 1673 544 1673 542 1673 487 1684 453 1673 451 1673 448 1673 364 1684 364 1717"/>
                        </Shape>
                        <String CONTENT="made the distance between the Anui market-place and Nishne-Kolymsk (a"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l20" HPOS="362" VPOS="1729" WIDTH="1773" HEIGHT="63" BASELINE="364 1775 2135 1771" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1775 364 1792 2133 1788 2135 1771 2131 1740 1250 1729 1248 1729 1245 1729 1206 1742 362 1742 364 1775"/>
                        </Shape>
                        <String CONTENT="hundred and fifty English miles) in fifteen hours, and the dogs of the latter"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l21" HPOS="362" VPOS="1788" WIDTH="1771" HEIGHT="65" BASELINE="364 1838 2133 1831" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1838 364 1853 2131 1846 2133 1831 2129 1801 1627 1788 1624 1788 1622 1788 1585 1799 1559 1788 1557 1788 1555 1788 1553 1788 1527 1801 1464 1790 1462 1790 1460 1790 1432 1801 1304 1790 1302 1790 1300 1790 1252 1801 1115 1790 1113 1790 1111 1790 1089 1801 1031 1790 1029 1790 951 1803 903 1792 901 1792 899 1792 661 1803 613 1792 611 1792 609 1792 607 1792 583 1803 457 1792 455 1792 453 1792 414 1803 377 1792 375 1792 373 1792 370 1792 368 1792 368 1794 362 1799 364 1838"/>
                        </Shape>
                        <String CONTENT="in sixteen hours. While on the Kolyma I also heard of this race; and, in my"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l22" HPOS="362" VPOS="1849" WIDTH="1771" HEIGHT="62" BASELINE="364 1898 2133 1892" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 1898 364 1911 2131 1907 2133 1892 2129 1862 2068 1849 2066 1849 2064 1849 2042 1859 1958 1849 1956 1849 1878 1859 1863 1849 1860 1849 1858 1849 1856 1849 1746 1859 1653 1849 1650 1849 1648 1849 1616 1859 1572 1849 1570 1849 1568 1849 1566 1849 1538 1862 1501 1851 1499 1851 1497 1851 1494 1851 1466 1862 1399 1851 1397 1851 1395 1851 1365 1862 847 1853 845 1853 843 1853 840 1853 827 1864 801 1853 799 1853 797 1853 529 1864 425 1853 422 1853 362 1866 364 1898"/>
                        </Shape>
                        <String CONTENT="opinion, the speed displayed on that occasion is the highest that Siberian"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l23" HPOS="364" VPOS="1914" WIDTH="1247" HEIGHT="56" BASELINE="366 1955 1611 1950" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 1955 366 1970 1609 1965 1611 1950 1607 1922 386 1914 383 1914 381 1914 379 1914 364 1920 366 1955"/>
                        </Shape>
                        <String CONTENT="dogs have been known to exhibit over long distances."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-149_r6" HPOS="364" VPOS="1973" WIDTH="1778" HEIGHT="954" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="364 1973 2142 1973 2142 2927 364 2927"/>
                    </Shape>
                    <TextLine ID="mz_1-149_l24" HPOS="470" VPOS="1968" WIDTH="1665" HEIGHT="62" BASELINE="472 2017 2135 2011" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="472 2017 472 2030 2133 2024 2135 2011 2131 1981 2008 1981 1984 1968 1982 1968 1980 1968 1977 1968 1975 1968 1962 1981 1867 1981 1826 1968 1824 1968 1821 1968 1819 1968 1817 1968 1800 1981 1533 1981 1494 1970 1492 1970 1490 1970 1423 1981 1395 1970 1393 1970 1391 1970 1388 1970 1386 1970 1371 1983 1161 1983 1128 1970 1126 1970 1124 1970 1044 1981 1031 1970 1029 1970 1027 1970 1025 1970 1022 1970 970 1983 955 1972 953 1972 951 1972 949 1972 470 1981 472 2017"/>
                        </Shape>
                        <String CONTENT="In the month of March and on a good trail, a strong well-rested team"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l25" HPOS="362" VPOS="2030" WIDTH="1773" HEIGHT="63" BASELINE="364 2076 2135 2069" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2076 364 2093 2133 2087 2135 2069 2131 2039 953 2030 951 2030 892 2041 529 2033 526 2033 362 2043 364 2076"/>
                        </Shape>
                        <String CONTENT="can make five hundred miles in ten days, and, after two days’ rest, will continue"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l26" HPOS="364" VPOS="2093" WIDTH="1774" HEIGHT="57" BASELINE="366 2134 2138 2130" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2134 366 2150 2135 2145 2138 2130 2127 2098 407 2093 405 2093 403 2093 364 2104 366 2134"/>
                        </Shape>
                        <String CONTENT="with the same speed. In the winter of 1900-01 I made from four thousand"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l27" HPOS="362" VPOS="2147" WIDTH="1773" HEIGHT="63" BASELINE="364 2195 2135 2188" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2195 364 2210 2133 2204 2135 2188 2131 2156 2049 2147 2047 2147 1982 2158 1960 2147 1958 2147 1956 2147 1852 2158 1824 2147 1821 2147 1819 2147 1754 2158 1707 2147 1705 2147 1702 2147 1700 2147 1698 2147 1681 2158 1518 2150 1516 2150 1432 2160 1388 2150 1386 2150 1384 2150 1323 2160 1287 2150 1284 2150 1282 2150 1280 2150 1254 2160 1176 2150 1174 2150 1070 2160 1031 2150 1029 2150 1027 2150 1025 2150 994 2160 962 2150 960 2150 957 2150 897 2162 559 2152 557 2152 555 2152 520 2162 448 2152 446 2152 362 2165 364 2195"/>
                        </Shape>
                        <String CONTENT="to five thousand miles with dogs, changing from time to time those that had"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l28" HPOS="364" VPOS="2210" WIDTH="1774" HEIGHT="61" BASELINE="366 2253 2138 2249" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2253 366 2271 2135 2266 2138 2249 2127 2219 1261 2210 1258 2210 1256 2210 1254 2210 1239 2221 490 2212 487 2212 364 2223 366 2253"/>
                        </Shape>
                        <String CONTENT="sore feet or were over-tired. In the spring, after a continuous drive of fourteen"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l29" HPOS="364" VPOS="2271" WIDTH="1771" HEIGHT="69" BASELINE="366 2314 2135 2308" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2314 366 2329 691 2340 693 2340 695 2340 697 2340 715 2329 782 2338 784 2338 1159 2327 1241 2338 1243 2338 1245 2338 1248 2338 1263 2327 1516 2336 1518 2336 1778 2325 1824 2336 1826 2336 1828 2338 2099 2338 2099 2336 2101 2336 2135 2323 2135 2308 2131 2279 955 2271 953 2271 951 2271 927 2282 386 2273 383 2273 381 2273 379 2273 364 2279 366 2314"/>
                        </Shape>
                        <String CONTENT="days, our dogs were so tired that they would lie down on the slightest provo-"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l30" HPOS="364" VPOS="2331" WIDTH="1771" HEIGHT="59" BASELINE="366 2375 2135 2368" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2375 366 2390 2133 2383 2135 2368 2131 2340 955 2331 953 2331 864 2342 431 2334 429 2334 364 2344 366 2375"/>
                        </Shape>
                        <String CONTENT="cation, and we had much trouble in rousing them from sleep after even a"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l31" HPOS="364" VPOS="2390" WIDTH="1774" HEIGHT="58" BASELINE="366 2435 2138 2429" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2435 366 2448 2135 2442 2138 2429 2127 2396 1018 2390 1016 2390 364 2403 366 2435"/>
                        </Shape>
                        <String CONTENT="moment’s stop. However, three dogs of mine were able to make the entire"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l32" HPOS="362" VPOS="2444" WIDTH="1773" HEIGHT="76" BASELINE="364 2496 2135 2487" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="364 2496 364 2520 2133 2507 2135 2487 2131 2457 1763 2444 1761 2444 1759 2444 1735 2455 1609 2446 1607 2446 1520 2457 1499 2446 1497 2446 1494 2446 1492 2446 1490 2446 1473 2459 1354 2459 1274 2446 1271 2446 1176 2459 968 2448 966 2448 964 2448 918 2459 886 2448 884 2448 882 2448 775 2461 565 2450 563 2450 485 2461 379 2450 377 2450 375 2450 373 2450 362 2457 364 2496"/>
                        </Shape>
                        <String CONTENT="journey from the mouth of the Anadyr River to the middle of Kamchatka, up"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l33" HPOS="364" VPOS="2509" WIDTH="1774" HEIGHT="61" BASELINE="366 2554 2138 2546" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2554 366 2570 2135 2561 2138 2546 2127 2513 806 2509 804 2509 801 2509 765 2520 438 2511 435 2511 364 2522 366 2554"/>
                        </Shape>
                        <String CONTENT="and down, and farther on to Indian Point, and still looked sleek and fat in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-149_l34" HPOS="364" VPOS="2565" WIDTH="1774" HEIGHT="63" BASELINE="366 2615 2138 2606" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="366 2615 366 2628 2135 2621 2138 2606 2127 2574 1720 2565 1718 2565 1715 2565 1676 2576 910 2570 908 2570 364 2583 366 2615"/>
                        </Shape>
                        <String CONTENT="summer, after two weeks’ rest. Progress with a few weak and half-starved"/>
                    </TextLine>

