                        </Shape>
                        <String CONTENT="‘I do not want it!’ My husband takes to despising you.”"/>
                    </TextLine>
<TextLine ID="mz_2-237_l35" HPOS="571" VPOS="2784" WIDTH="1657" HEIGHT="57" BASELINE="573 2827 2228 2820" TAGREFS="TYPE_6">
