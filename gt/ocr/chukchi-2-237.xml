                        </Shape>
                        <String CONTENT="He sees the carrion; seeing it, he eats of it. After a while he vomits it"/>
                    </TextLine>

                    <TextLine ID="mz_2-237_l33" HPOS="466" VPOS="2665" WIDTH="1758" HEIGHT="59" BASELINE="468 2706 2224 2702" TAGREFS="TYPE_6">
