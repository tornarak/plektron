                        </Shape>
                        <String CONTENT="At the same time I make this body of mine into a young beaver that"/>
                    </TextLine>

                    <TextLine ID="mz_2-237_l36" HPOS="466" VPOS="2847" WIDTH="1762" HEIGHT="59" BASELINE="468 2888 2228 2880" TAGREFS="TYPE_6">
