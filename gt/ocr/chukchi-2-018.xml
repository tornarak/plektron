                    <TextLine ID="mz_2-018_l35" HPOS="426" VPOS="2559" WIDTH="1655" HEIGHT="45" BASELINE="428 2586 2081 2588" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="428 2586 426 2596 2077 2604 2081 2588 2079 2561 428 2559 428 2586"/>
                        </Shape>
                        <String CONTENT="³ The ideas of the Chukchee about the country of the Sun Chief present many peculiarities. Among"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l36" HPOS="315" VPOS="2600" WIDTH="1764" HEIGHT="45" BASELINE="317 2630 2079 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="317 2630 317 2645 2077 2643 2079 2626 2074 2600 315 2602 317 2630"/>
                        </Shape>
                        <String CONTENT="others I will mention the belief, current among the Reindeer and the Maritime people, as to the use to which"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l37" HPOS="317" VPOS="2639" WIDTH="1766" HEIGHT="47" BASELINE="319 2673 2083 2669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 2673 319 2686 2081 2682 2083 2669 2077 2639 317 2645 319 2673"/>
                        </Shape>
                        <String CONTENT="are put the tributes in peltry coming to the Sun Chief from arctic Siberia. In the country of the Sun Chief"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l38" HPOS="321" VPOS="2686" WIDTH="1760" HEIGHT="43" BASELINE="321 2712 2081 2712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="321 2712 321 2729 2081 2729 2081 2712 2079 2686 321 2686 321 2712"/>
                        </Shape>
                        <String CONTENT="there is supposed to exist a great hole, from which boiling water continually flows, forming a whirlpool, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l39" HPOS="317" VPOS="2724" WIDTH="1766" HEIGHT="47" BASELINE="319 2757 2083 2751" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 2757 319 2771 2081 2767 2083 2751 2077 2724 317 2731 319 2757"/>
                        </Shape>
                        <String CONTENT="threatening to submerge the whole world. The “spirit” of the whirlpool has to be propitiated with sacrifice of"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l40" HPOS="319" VPOS="2771" WIDTH="1762" HEIGHT="47" BASELINE="321 2800 2081 2794" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="321 2800 321 2818 2079 2810 2081 2794 2076 2771 319 2774 321 2800"/>
                        </Shape>
                        <String CONTENT="peltries thrown into the water. The best combination is white and red foxes in equal numbers. When the"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l41" HPOS="317" VPOS="2812" WIDTH="1762" HEIGHT="45" BASELINE="319 2841 2079 2835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 2841 319 2857 2077 2853 2079 2835 2074 2812 317 2816 319 2841"/>
                        </Shape>
                        <String CONTENT="latter are deficient, the whirlpool turns angrily, refusing to accept the sacrifice. Therefore, when peltries are"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l42" HPOS="319" VPOS="2857" WIDTH="1762" HEIGHT="41" BASELINE="319 2882 2081 2882" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 2882 319 2898 2081 2898 2081 2882 2081 2857 319 2857 319 2882"/>
                        </Shape>
                        <String CONTENT="scarce, the Sun Chief has to give, for those lacking, an equal number of cossack children. Besides this, every"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l43" HPOS="317" VPOS="2898" WIDTH="1108" HEIGHT="43" BASELINE="319 2923 1425 2921" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 2923 319 2941 1423 2941 1425 2921 1419 2898 317 2898 319 2923"/>
                        </Shape>
                        <String CONTENT="tenth year he must throw in either two black foxes or his eldest son."/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l44" HPOS="425" VPOS="2937" WIDTH="1658" HEIGHT="43" BASELINE="426 2966 2083 2961" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="426 2966 426 2980 2083 2974 2083 2961 2077 2937 425 2941 426 2966"/>
                        </Shape>
                        <String CONTENT="This is the only explanation that the mind of the Chukchee was able to work out in accounting for the"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l45" HPOS="317" VPOS="2980" WIDTH="1762" HEIGHT="43" BASELINE="319 3008 2079 3004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 3008 319 3023 2077 3021 2079 3004 2074 2980 317 2982 319 3008"/>
                        </Shape>
                        <String CONTENT="exceeding greed of the Russians in acquiring the smaller peltries, which, from the Arctic point of view, are"/>
                    </TextLine>

                    <TextLine ID="mz_2-018_l46" HPOS="317" VPOS="3021" WIDTH="1762" HEIGHT="47" BASELINE="319 3053 2079 3045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="319 3053 319 3068 2079 3064 2079 3045 2074 3021 317 3027 319 3053"/>
                        </Shape>
                        <String CONTENT="much inferior to the common fawn-skins. The legend probably originated in certain Russian folk-stories heard"/>
                    </TextLine>

