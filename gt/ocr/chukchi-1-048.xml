                <TextBlock ID="mz_1-048_r1" HPOS="705" VPOS="611" WIDTH="1778" HEIGHT="90" TAGREFS="TYPE_5">
<Shape>
                        <Polygon POINTS="705 611 2483 611 2483 701 705 701"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l1" HPOS="1284" VPOS="625" WIDTH="615" HEIGHT="52" BASELINE="1287 658 1899 653" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1891 638 1869 625 1847 625 1826 625 1804 625 1782 625 1761 625 1739 625 1718 625 1696 625 1674 625 1653 625 1631 625 1609 625 1588 625 1566 625 1544 625 1523 625 1501 625 1479 625 1458 625 1436 625 1414 625 1393 625 1371 625 1349 625 1328 625 1306 625 1284 632 1287 658 1287 677 1897 673 1899 653 1891 638 1891 638"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l2" HPOS="706" VPOS="617" WIDTH="72" HEIGHT="58" BASELINE="710 660 778 656" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="749 617 734 617 706 625 710 660 710 675 778 673 778 656 773 621 762 617 749 617"/>
                        </Shape>
                        <String CONTENT="28"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-048_r2" HPOS="705" VPOS="726" WIDTH="1778" HEIGHT="297" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="705 726 2483 726 2483 1023 705 1023"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l3" HPOS="706" VPOS="723" WIDTH="1767" HEIGHT="60" BASELINE="708 766 2473 770" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2460 736 2441 727 2437 727 2417 727 2395 727 2374 727 2352 727 2330 727 2309 727 2291 727 1752 736 1676 725 1674 725 1672 725 1627 736 1594 723 1592 723 1590 723 1527 734 1429 723 1427 723 1425 723 1391 734 1352 723 1349 723 1347 723 1345 723 1306 734 1200 723 1198 723 1196 723 1163 734 1109 723 979 723 977 723 975 723 973 723 957 734 708 725 708 766 706 779 2469 783 2473 770 2471 757 2460 736"/>
                        </Shape>
                        <String CONTENT="Hooper, and Hilder, have also been taken into consideration as far as possible."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l4" HPOS="710" VPOS="788" WIDTH="1761" HEIGHT="58" BASELINE="710 827 2471 827" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="710 803 710 827 710 846 2471 846 2471 827 2471 796 719 788 710 803"/>
                        </Shape>
                        <String CONTENT="I have enclosed in parentheses the statistics obtained from these authorities."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l5" HPOS="708" VPOS="846" WIDTH="1765" HEIGHT="67" BASELINE="708 885 2473 889" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 885 708 902 1590 902 1748 913 1750 913 2471 902 2473 889 2471 859 708 846 708 885"/>
                        </Shape>
                        <String CONTENT="Krause’s geographical information, and his maps of the coast, seem to me to"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l6" HPOS="706" VPOS="909" WIDTH="1767" HEIGHT="56" BASELINE="706 946 2473 946" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 946 706 965 2471 965 2473 946 2471 915 706 909 706 946"/>
                        </Shape>
                        <String CONTENT="be quite correct; his list of villages from Holy Cross Bay to Kuluˊči Bay is"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l7" HPOS="704" VPOS="967" WIDTH="321" HEIGHT="57" BASELINE="704 1006 1025 1006" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 1006 704 1024 1025 1024 1025 1006 1022 967 704 974 704 1006"/>
                        </Shape>
                        <String CONTENT="also accurate.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-048_r3" HPOS="705" VPOS="1023" WIDTH="1778" HEIGHT="547" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="705 1023 2483 1023 2483 1570 705 1570"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l8" HPOS="812" VPOS="1037" WIDTH="1666" HEIGHT="56" BASELINE="812 1067 2478 1067" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="812 1067 812 1080 892 1093 895 1093 897 1093 934 1082 1382 1082 1395 1093 1397 1093 1399 1093 1401 1093 2478 1080 2478 1067 2478 1037 812 1037 812 1067"/>
                        </Shape>
                        <String CONTENT="Only the names of the principal villages are here given, because the"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l9" HPOS="702" VPOS="1093" WIDTH="1771" HEIGHT="52" BASELINE="704 1128 2473 1123" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 1128 704 1145 2471 1145 2473 1123 2467 1093 702 1095 704 1128"/>
                        </Shape>
                        <String CONTENT="smaller ones mentioned by many travellers are not fixed dwelling-places. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l10" HPOS="702" VPOS="1145" WIDTH="1771" HEIGHT="61" BASELINE="704 1188 2473 1184" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 1188 704 1206 2471 1201 2473 1184 2469 1156 1603 1145 1601 1145 1598 1145 1568 1156 817 1147 814 1147 702 1158 704 1188"/>
                        </Shape>
                        <String CONTENT="are simply hunting-stations, that are used for a few years, and afterwards aban-"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l11" HPOS="704" VPOS="1216" WIDTH="1767" HEIGHT="52" BASELINE="704 1247 2471 1247" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 1247 704 1262 2467 1268 2471 1247 2469 1216 704 1216 704 1247"/>
                        </Shape>
                        <String CONTENT="doned for other places a few miles away. The name belongs to the locality,"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l12" HPOS="702" VPOS="1268" WIDTH="1773" HEIGHT="65" BASELINE="704 1309 2475 1303" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="702 1284 704 1309 704 1322 1115 1333 1118 1333 1330 1320 1503 1331 1505 1331 1585 1320 1672 1331 1674 1331 1780 1320 1869 1329 1871 1329 1873 1329 1876 1329 1889 1318 2038 1329 2040 1329 2109 1318 2125 1329 2127 1329 2129 1329 2131 1329 2473 1318 2475 1303 2471 1275 730 1268 728 1268 726 1268 704 1277 702 1284"/>
                        </Shape>
                        <String CONTENT="not to the village. Even the larger villages are not very stable; and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l13" HPOS="702" VPOS="1327" WIDTH="1771" HEIGHT="63" BASELINE="704 1370 2473 1366" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 1370 704 1390 2471 1387 2473 1366 2469 1335 810 1327 808 1327 702 1338 704 1370"/>
                        </Shape>
                        <String CONTENT="population often desert one and move to another, according to the changing"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l14" HPOS="706" VPOS="1396" WIDTH="1767" HEIGHT="48" BASELINE="706 1424 2473 1424" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 1424 706 1444 2471 1444 2473 1424 2471 1396 706 1396 706 1424"/>
                        </Shape>
                        <String CONTENT="conditions of seal-hunting. However, those among the smaller settlements"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l15" HPOS="706" VPOS="1452" WIDTH="1769" HEIGHT="59" BASELINE="708 1483 2475 1487" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 1483 706 1498 778 1511 780 1511 2473 1502 2475 1487 2473 1457 708 1452 708 1483"/>
                        </Shape>
                        <String CONTENT="which were mentioned by several older travellers, and which happen to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l16" HPOS="704" VPOS="1511" WIDTH="1462" HEIGHT="52" BASELINE="706 1543 2166 1548" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 1543 704 1558 2161 1563 2166 1548 2164 1515 706 1511 706 1543"/>
                        </Shape>
                        <String CONTENT="inhabited at the present time, are included in the following list."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-048_r4" HPOS="705" VPOS="1570" WIDTH="1778" HEIGHT="65" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="705 1570 2483 1570 2483 1635 705 1635"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l17" HPOS="814" VPOS="1563" WIDTH="1179" HEIGHT="67" BASELINE="817 1602 1993 1606" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="817 1602 814 1621 827 1630 830 1630 832 1630 834 1630 1990 1621 1993 1606 1990 1578 1819 1565 1817 1565 1737 1578 1432 1578 1408 1563 1406 1563 1403 1563 1401 1563 1347 1574 1323 1563 1321 1563 1319 1563 1317 1563 1274 1574 1230 1563 1228 1563 1226 1563 1224 1563 1191 1574 817 1567 817 1602"/>
                        </Shape>
                        <String CONTENT="The villages on the Pacific coast are as follows: —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-048_r5" HPOS="705" VPOS="1676" WIDTH="1778" HEIGHT="737" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="705 1676 2483 1676 2483 2413 705 2413"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l18" HPOS="1484" VPOS="1693" WIDTH="218" HEIGHT="47" BASELINE="1486 1725 1702 1721" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1679 1695 1657 1695 1644 1693 1484 1695 1486 1725 1486 1740 1702 1736 1702 1721 1700 1714 1679 1695"/>
                        </Shape>
                        <String CONTENT="CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l19" HPOS="706" VPOS="1786" WIDTH="1767" HEIGHT="47" BASELINE="708 1816 2473 1812" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2467 1786 706 1786 708 1816 708 1833 2471 1829 2473 1812 2469 1788 2467 1786"/>
                        </Shape>
                        <String CONTENT="Veᵋñ, in Anadyr Bay, near the mouth of the Anadyr River.² The Russians subsequently founded"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l20" HPOS="784" VPOS="1831" WIDTH="1687" HEIGHT="50" BASELINE="786 1859 2471 1864" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="786 1859 784 1877 2467 1881 2471 1864 2469 1836 786 1831 786 1859"/>
                        </Shape>
                        <String CONTENT="a settlement near by, and called it Mariinsky Post. In former times the Chukchee village lay"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l21" HPOS="788" VPOS="1883" WIDTH="1685" HEIGHT="46" BASELINE="788 1909 2473 1909" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="788 1909 788 1929 2473 1929 2473 1909 2473 1883 788 1883 788 1909"/>
                        </Shape>
                        <String CONTENT="nearer the open sea, on the low sandy shore of Geëk Land. Veᵋñ has at present 7 native"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l22" HPOS="784" VPOS="1924" WIDTH="594" HEIGHT="52" BASELINE="786 1952 1378 1959" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="786 1952 784 1970 1373 1976 1378 1959 1375 1931 786 1924 786 1952"/>
                        </Shape>
                        <String CONTENT="houses and about 40 inhabitants."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l23" HPOS="702" VPOS="2000" WIDTH="1771" HEIGHT="50" BASELINE="704 2030 2473 2026" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="702 2024 704 2030 704 2050 2471 2046 2473 2026 2467 2000 715 2000 702 2024"/>
                        </Shape>
                        <String CONTENT="Mɪˊs˙qᴀn (“hill”), on the west point of the long, narrow island Mɪˊs˙qᴀn,³ in Holy Cross Bay; and"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l24" HPOS="786" VPOS="2048" WIDTH="1685" HEIGHT="47" BASELINE="788 2078 2471 2074" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="788 2078 788 2095 2469 2091 2471 2074 2465 2048 786 2048 788 2078"/>
                        </Shape>
                        <String CONTENT="Rêˊtkên (“clayish”), on the east point of the same island. During my visit in 1901 the former"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l25" HPOS="786" VPOS="2091" WIDTH="1685" HEIGHT="50" BASELINE="788 2121 2471 2126" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="788 2121 786 2137 2467 2141 2471 2126 2469 2095 788 2091 788 2121"/>
                        </Shape>
                        <String CONTENT="village had 3 houses, and, besides, 1 family was living a few miles off; while in two places"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l26" HPOS="788" VPOS="2143" WIDTH="1683" HEIGHT="45" BASELINE="788 2171 2471 2171" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="788 2171 788 2188 2471 2188 2471 2171 2471 2143 788 2143 788 2171"/>
                        </Shape>
                        <String CONTENT="there were 6 tents of some very poor half Maritime, half Reindeer people. The total population"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l27" HPOS="788" VPOS="2191" WIDTH="1681" HEIGHT="47" BASELINE="788 2219 2469 2219" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="788 2219 788 2234 2465 2238 2469 2219 2467 2191 788 2191 788 2219"/>
                        </Shape>
                        <String CONTENT="was 41 (according to the Register, 7 houses, 30 inhabitants). Rêˊtkên had 6 houses with 35"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l28" HPOS="782" VPOS="2230" WIDTH="851" HEIGHT="52" BASELINE="784 2260 1633 2266" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="784 2260 782 2275 1629 2282 1633 2266 1633 2236 784 2230 784 2260"/>
                        </Shape>
                        <String CONTENT="inhabitants (Register, 6 houses, 22 inhabitants)."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l29" HPOS="704" VPOS="2305" WIDTH="1771" HEIGHT="50" BASELINE="706 2338 2475 2334" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 2338 706 2355 2473 2351 2475 2334 2469 2305 704 2308 706 2338"/>
                        </Shape>
                        <String CONTENT="Farther along the shore, on Cape Wuˊkwên (“stony”), there used to be a small settlement whose"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l30" HPOS="780" VPOS="2351" WIDTH="1206" HEIGHT="50" BASELINE="782 2381 1986 2385" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="782 2381 780 2396 1982 2401 1986 2385 1984 2355 782 2351 782 2381"/>
                        </Shape>
                        <String CONTENT="inhabitants afterwards turned to reindeer-breeding and went inland."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-048_r6" HPOS="705" VPOS="2437" WIDTH="1778" HEIGHT="829" TAGREFS="TYPE_4">
<Shape>
                        <Polygon POINTS="705 2437 2483 2437 2483 3266 705 3266"/>
                    </Shape>
                    <TextLine ID="mz_1-048_l31" HPOS="801" VPOS="2440" WIDTH="1672" HEIGHT="49" BASELINE="804 2470 2473 2466" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="804 2470 804 2489 2471 2485 2473 2466 2467 2440 801 2442 804 2470"/>
                        </Shape>
                        <String CONTENT="¹ In his statistics, Krause gives for the large village Uñiˊsak (Indian Point) only 13 houses “from personal"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l32" HPOS="704" VPOS="2483" WIDTH="1767" HEIGHT="48" BASELINE="706 2511 2471 2515" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 2511 704 2526 2467 2531 2471 2515 2469 2487 706 2483 706 2511"/>
                        </Shape>
                        <String CONTENT="observation.” He evidently confounds the small village Kuˊkun with the larger Luˊᵋren, since he states that there"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l33" HPOS="702" VPOS="2526" WIDTH="1544" HEIGHT="46" BASELINE="704 2554 2246 2559" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 2554 702 2567 2242 2572 2246 2559 2244 2531 704 2526 704 2554"/>
                        </Shape>
                        <String CONTENT="are 20 houses in Kuˊkun, and only 2 in Luˊᵋren, whereas in reality the numbers are the reverse."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l34" HPOS="812" VPOS="2565" WIDTH="1659" HEIGHT="50" BASELINE="814 2593 2471 2598" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="814 2593 812 2608 2467 2615 2471 2598 2469 2570 814 2565 814 2593"/>
                        </Shape>
                        <String CONTENT="² On the Middle Anadyr live about ten Chukchee families scattered in five or six places. Of these,"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l35" HPOS="704" VPOS="2611" WIDTH="1767" HEIGHT="47" BASELINE="706 2639 2471 2637" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 2639 706 2658 2469 2656 2471 2637 2465 2611 704 2611 706 2639"/>
                        </Shape>
                        <String CONTENT="Chikayeva has two families, and Under-the-Cliffs three. The first name has been borrowed by the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l36" HPOS="706" VPOS="2656" WIDTH="1765" HEIGHT="46" BASELINE="706 2682 2471 2682" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 2682 706 2702 2471 2702 2471 2682 2471 2656 706 2656 706 2682"/>
                        </Shape>
                        <String CONTENT="from the Russianized natives; the second name has the same meaning, both in the Chukchee and in the Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l37" HPOS="702" VPOS="2697" WIDTH="753" HEIGHT="48" BASELINE="704 2728 1455 2723" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="704 2728 704 2745 1453 2745 1455 2723 1449 2697 702 2699 704 2728"/>
                        </Shape>
                        <String CONTENT="languages. The other settlements are unstable."/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l38" HPOS="812" VPOS="2736" WIDTH="1661" HEIGHT="48" BASELINE="814 2767 2473 2762" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="814 2767 814 2784 2471 2780 2473 2762 2467 2736 812 2738 814 2767"/>
                        </Shape>
                        <String CONTENT="³ Long, narrow islands or spits, consisting of sand cast up by the waves, are met with everywhere on"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l39" HPOS="706" VPOS="2777" WIDTH="1765" HEIGHT="50" BASELINE="708 2805 2471 2810" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 2805 706 2823 2467 2827 2471 2810 2469 2782 708 2777 708 2805"/>
                        </Shape>
                        <String CONTENT="the shores of Bering Sea and the Arctic Ocean, especially at the mouths of rivers or of narrow, deeply indented"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l40" HPOS="704" VPOS="2821" WIDTH="1765" HEIGHT="49" BASELINE="706 2851 2469 2847" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="706 2851 706 2870 2467 2870 2469 2847 2462 2821 704 2823 706 2851"/>
                        </Shape>
                        <String CONTENT="bays. These islands are called by the Chukchee Teˊpän in the Pacific dialect, and Teˊpqän in the Arctic dialect. With"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l41" HPOS="708" VPOS="2866" WIDTH="1761" HEIGHT="48" BASELINE="708 2892 2469 2892" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 2892 708 2912 2467 2914 2469 2892 2469 2866 708 2866 708 2892"/>
                        </Shape>
                        <String CONTENT="the Kamchadal and Koryak, where salmon is abundant, the villages near such spits lie on the mainland shore,"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l42" HPOS="706" VPOS="2905" WIDTH="1765" HEIGHT="48" BASELINE="708 2935 2471 2931" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 2935 708 2953 2469 2948 2471 2931 2465 2905 706 2907 708 2935"/>
                        </Shape>
                        <String CONTENT="which is less exposed to the wind. Mouths of rivers and entrances to bays are very convenient places for"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l43" HPOS="706" VPOS="2946" WIDTH="1763" HEIGHT="50" BASELINE="708 2979 2469 2972" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="708 2979 708 2996 2467 2992 2469 2972 2462 2946 706 2951 708 2979"/>
                        </Shape>
                        <String CONTENT="catching salmon, which enter there in masses for the purpose of spawning. The Maritime Chukchee and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-048_l44" HPOS="706" VPOS="2987" WIDTH="1765" HEIGHT="52" BASELINE="708 3020 2471 3016" TAGREFS="TYPE_6">
                        <Shape>
