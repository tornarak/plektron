                <TextBlock ID="text_1-280" HPOS="622" VPOS="599" WIDTH="1782" HEIGHT="2627"><TextLine ID="mz_1-280_l1" HPOS="1211" VPOS="599" WIDTH="617" HEIGHT="54" BASELINE="1213 634 1828 630" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1817 602 1795 599 1774 599 1752 599 1731 599 1709 599 1687 599 1666 599 1644 599 1622 599 1601 599 1579 599 1557 599 1536 599 1514 599 1211 599 1213 634 1213 653 1826 649 1828 630 1826 628 1817 602"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l2" HPOS="635" VPOS="608" WIDTH="110" HEIGHT="43" BASELINE="635 638 745 638" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 638 635 651 745 651 745 638 745 608 635 608 635 638"/>
                        </Shape>
                        <String CONTENT="220"/>
                    </TextLine>
<TextLine ID="mz_1-280_l3" HPOS="630" VPOS="699" WIDTH="1774" HEIGHT="61" BASELINE="630 742 2404 742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2365 701 2346 712 2109 712 2086 699 2084 699 2081 699 2079 699 2034 710 2006 699 2003 699 2001 699 1999 699 1960 710 1932 699 1930 699 1928 699 1832 710 1795 699 1793 699 1791 699 1789 699 1787 699 1772 712 1622 712 1546 699 1544 699 1542 699 1501 710 1471 699 1468 699 1466 699 1464 699 1423 710 1382 699 1380 699 1378 699 1375 699 1341 710 1315 699 1313 699 1310 699 1308 699 1306 699 1289 710 1245 699 1243 699 1241 699 1239 699 1209 710 1146 699 1144 699 1141 699 1094 710 1038 699 1035 699 981 710 882 699 879 699 877 699 875 699 858 712 754 712 674 699 672 699 669 699 630 710 630 742 630 760 2404 760 2404 742 2404 710 2380 701 2365 701"/>
                        </Shape>
                        <String CONTENT="white or dyed with alder-bark dissolved in water instead of urine, are much"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l4" HPOS="628" VPOS="760" WIDTH="1064" HEIGHT="62" BASELINE="630 805 1692 801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 805 630 822 1689 816 1692 801 1687 770 1174 760 1172 760 1170 760 1167 760 1152 770 801 762 799 762 628 773 630 805"/>
                        </Shape>
                        <String CONTENT="poorer in quality than those of the Chukchee."/>
                    </TextLine>
<TextLine ID="mz_1-280_l5" HPOS="739" VPOS="818" WIDTH="1663" HEIGHT="61" BASELINE="741 863 2402 859" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 863 741 879 2400 874 2402 859 2398 831 2235 831 2218 818 2216 818 2213 818 2211 818 2209 818 2172 829 2045 818 2042 818 2040 818 2014 829 1873 818 1871 818 1869 818 1841 829 1737 818 1735 818 1676 829 1618 818 1616 818 1614 818 1566 831 1481 820 1479 820 1477 820 1447 831 1421 820 1419 820 1416 820 1367 831 1321 820 1319 820 1317 820 1256 831 1191 820 1189 820 1187 820 1157 831 1124 820 1122 820 1120 820 739 825 741 863"/>
                        </Shape>
                        <String CONTENT="The chief drawback with all these skins is their complete unfitness to"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l6" HPOS="628" VPOS="887" WIDTH="1776" HEIGHT="52" BASELINE="630 920 2404 924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 920 628 935 2400 939 2404 924 2402 887 630 887 630 920"/>
                        </Shape>
                        <String CONTENT="stand moisture. Even slightly damp skins, when drying, will become crumpled"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l7" HPOS="630" VPOS="952" WIDTH="1772" HEIGHT="48" BASELINE="630 983 2402 983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 983 630 1000 2402 1000 2402 983 2402 952 630 952 630 983"/>
                        </Shape>
                        <String CONTENT="and as hard as wood. Faults of this kind can be partially corrected by fresh"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l8" HPOS="630" VPOS="1000" WIDTH="1772" HEIGHT="61" BASELINE="630 1041 2402 1041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1041 630 1061 2402 1061 2402 1041 2402 1013 2324 1000 2322 1000 2320 1000 2289 1011 2220 1000 2218 1000 2125 1013 1915 1013 1886 1000 1884 1000 1882 1000 1880 1000 1878 1000 1863 1013 1769 1013 1735 1000 1733 1000 1731 1000 1728 1000 1705 1011 1676 1000 1674 1000 1672 1000 1670 1000 1642 1011 1577 1000 1575 1000 1572 1000 1531 1011 1479 1000 1477 1000 1475 1000 1438 1011 1362 1000 1360 1000 1358 1000 1356 1000 1336 1013 1202 1013 1126 1000 1124 1000 1059 1011 895 1000 892 1000 821 1011 747 1000 745 1000 630 1011 630 1041"/>
                        </Shape>
                        <String CONTENT="scraping and dyeing, but even then the skin is in much worse condition than"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l9" HPOS="630" VPOS="1069" WIDTH="321" HEIGHT="48" BASELINE="630 1102 951 1102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1102 630 1115 949 1117 951 1102 951 1071 630 1069 630 1102"/>
                        </Shape>
                        <String CONTENT="it was before."/>
                    </TextLine>
<TextLine ID="mz_1-280_l10" HPOS="736" VPOS="1128" WIDTH="1668" HEIGHT="49" BASELINE="736 1162 2404 1162" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1162 736 1177 2402 1177 2404 1162 2402 1132 736 1128 736 1162"/>
                        </Shape>
                        <String CONTENT="In currying reindeer-skins the Chukchee women do not manifest much"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l11" HPOS="628" VPOS="1177" WIDTH="1774" HEIGHT="70" BASELINE="630 1219 2402 1223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1219 628 1236 641 1245 643 1245 646 1245 648 1245 1369 1236 1529 1247 1531 1247 2400 1236 2402 1223 2402 1193 2369 1180 2367 1180 2365 1180 2226 1190 1763 1180 1761 1180 1620 1190 1594 1180 1592 1180 1590 1180 1516 1190 1408 1190 1393 1177 1391 1177 1388 1177 1386 1177 1254 1188 1237 1177 1235 1177 1232 1177 1230 1177 1228 1177 1187 1188 1087 1177 1085 1177 1083 1177 1053 1188 1020 1177 1018 1177 1016 1177 1014 1177 988 1188 875 1177 873 1177 630 1186 630 1219"/>
                        </Shape>
                        <String CONTENT="skill. This work is neglected because the curried leather is comparatively"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l12" HPOS="628" VPOS="1240" WIDTH="1776" HEIGHT="59" BASELINE="628 1284 2404 1284" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1284 628 1299 2404 1299 2404 1284 2404 1251 2382 1240 2380 1240 2378 1240 2244 1251 2187 1240 2185 1240 2183 1240 2161 1251 2127 1240 2125 1240 2122 1240 2120 1240 2088 1251 1997 1240 1995 1240 1993 1240 1967 1251 1934 1240 1932 1240 1930 1240 1871 1251 1804 1240 1802 1240 1800 1240 1769 1251 1683 1240 1681 1240 1679 1240 1653 1253 1520 1253 1497 1240 1494 1240 1492 1240 1436 1251 1334 1240 1189 1240 1187 1240 1185 1240 1183 1240 1170 1251 1109 1240 1107 1240 1105 1240 1072 1251 628 1247 628 1284"/>
                        </Shape>
                        <String CONTENT="little used among the Chukchee. For currying, the skin is soaked and left"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l13" HPOS="626" VPOS="1307" WIDTH="1776" HEIGHT="50" BASELINE="628 1340 2402 1344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1340 626 1353 2398 1357 2402 1344 2400 1312 628 1307 628 1340"/>
                        </Shape>
                        <String CONTENT="for twenty-four hours folded together. Then the hair is scraped off and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l14" HPOS="628" VPOS="1357" WIDTH="1772" HEIGHT="65" BASELINE="630 1400 2400 1405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1400 628 1413 2395 1422 2400 1405 2400 1372 2359 1359 2356 1359 2354 1359 2294 1372 2058 1372 2023 1359 2021 1359 2019 1359 1384 1368 1360 1357 1358 1357 1356 1357 1300 1368 1274 1357 1271 1357 1269 1357 1267 1357 1219 1370 1089 1370 1072 1357 1070 1357 1068 1357 1066 1357 1063 1357 1040 1368 1012 1357 1009 1357 1007 1357 1005 1357 968 1368 916 1357 914 1357 630 1366 630 1400"/>
                        </Shape>
                        <String CONTENT="skin is dried. Such scraped skins are brought by the Chukchee to every fair,"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l15" HPOS="628" VPOS="1424" WIDTH="1774" HEIGHT="61" BASELINE="630 1457 2402 1463" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1457 628 1474 641 1483 643 1483 646 1483 648 1483 1209 1474 1226 1485 1228 1485 1230 1485 1232 1485 2400 1476 2402 1463 2400 1433 630 1424 630 1457"/>
                        </Shape>
                        <String CONTENT="because they are much lighter than those with the hair on. In the further"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l16" HPOS="630" VPOS="1481" WIDTH="1772" HEIGHT="62" BASELINE="630 1524 2402 1524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1524 630 1543 2402 1537 2402 1524 2402 1491 2372 1481 2369 1481 2367 1481 2298 1491 2071 1481 2068 1481 2066 1481 2038 1494 1811 1494 1748 1481 1746 1481 1744 1481 1707 1491 1676 1481 1674 1481 1672 1481 1484 1491 1447 1481 1445 1481 1442 1481 1440 1481 1416 1491 1384 1481 1382 1481 1380 1481 1378 1481 1332 1491 1265 1481 1263 1481 1261 1481 1215 1491 1159 1481 1157 1481 1154 1481 1113 1491 1042 1481 1040 1481 901 1491 862 1481 860 1481 858 1481 856 1481 827 1494 630 1494 630 1524"/>
                        </Shape>
                        <String CONTENT="process of preparing the skin, it is smeared with any one of the materials"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l17" HPOS="628" VPOS="1545" WIDTH="1774" HEIGHT="50" BASELINE="630 1578 2402 1582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1578 628 1591 2398 1595 2402 1582 2400 1550 630 1545 630 1578"/>
                        </Shape>
                        <String CONTENT="mentioned above, then scraped again, and bleached in the wind or dyed with"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l18" HPOS="630" VPOS="1610" WIDTH="1770" HEIGHT="52" BASELINE="630 1641 2400 1641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1641 630 1662 2400 1656 2400 1641 2400 1610 630 1610 630 1641"/>
                        </Shape>
                        <String CONTENT="yellow ochre. The Russianized natives even wash the finest curried skins with"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l19" HPOS="626" VPOS="1665" WIDTH="1726" HEIGHT="60" BASELINE="628 1695 2352 1704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1695 626 1714 639 1723 641 1723 643 1723 646 1723 996 1714 1059 1725 1061 1725 2350 1719 2352 1704 2350 1673 628 1665 628 1695"/>
                        </Shape>
                        <String CONTENT="soap, and then dry them in the air, giving them a snow-white appearance."/>
                    </TextLine>
<TextLine ID="mz_1-280_l20" HPOS="734" VPOS="1723" WIDTH="1668" HEIGHT="65" BASELINE="736 1758 2402 1762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1758 734 1768 804 1784 806 1784 862 1773 895 1784 897 1784 899 1784 901 1784 940 1773 970 1784 973 1784 975 1784 1040 1773 1074 1784 1076 1784 1079 1784 1481 1773 1611 1786 1614 1786 1616 1786 1661 1775 1692 1786 1694 1786 1696 1786 1750 1775 1785 1786 1787 1786 1789 1786 1791 1786 1819 1775 1852 1786 1854 1786 1856 1788 1977 1788 1977 1786 1980 1786 1982 1786 1997 1775 2378 1786 2380 1786 2382 1786 2385 1786 2400 1773 2402 1762 2400 1732 736 1723 736 1758"/>
                        </Shape>
                        <String CONTENT="Most of the curried skins are smoked for a couple of days over the"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l21" HPOS="626" VPOS="1779" WIDTH="1776" HEIGHT="67" BASELINE="628 1818 2402 1823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1818 626 1831 999 1844 1001 1844 1484 1836 1540 1846 1542 1846 2400 1836 2402 1823 2398 1779 628 1781 628 1818"/>
                        </Shape>
                        <String CONTENT="hearth or in a special shed which is employed for extra cooking, scraping of"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l22" HPOS="626" VPOS="1851" WIDTH="1774" HEIGHT="47" BASELINE="626 1881 2400 1881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 1881 626 1898 2400 1898 2400 1881 2400 1851 626 1851 626 1881"/>
                        </Shape>
                        <String CONTENT="skins, etc. The women among the Russianized natives often make a temporary"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l23" HPOS="626" VPOS="1905" WIDTH="1774" HEIGHT="52" BASELINE="628 1935 2400 1942" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1935 626 1950 2395 1957 2400 1942 2398 1907 628 1905 628 1935"/>
                        </Shape>
                        <String CONTENT="tent of a few sticks, covering them with skins they are going to smoke, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l24" HPOS="626" VPOS="1959" WIDTH="1765" HEIGHT="56" BASELINE="628 1998 2391 2002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 1998 626 2011 2387 2015 2391 2002 2387 1959 628 1959 628 1998"/>
                        </Shape>
                        <String CONTENT="build a smouldering fire inside. A structure of this kind is called a “bath,”"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l25" HPOS="626" VPOS="2022" WIDTH="1772" HEIGHT="63" BASELINE="628 2059 2398 2063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2059 626 2074 637 2082 639 2082 641 2082 643 2082 1440 2074 1518 2085 1520 2085 2395 2074 2398 2063 2395 2030 628 2022 628 2059"/>
                        </Shape>
                        <String CONTENT="in reference to the fact that the Russians in that country still take sweat-"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l26" HPOS="626" VPOS="2082" WIDTH="1774" HEIGHT="55" BASELINE="628 2117 2400 2124" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2117 626 2130 2395 2137 2400 2124 2398 2093 628 2082 628 2117"/>
                        </Shape>
                        <String CONTENT="baths inside of the tent sometimes, much in the same way as the American"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l27" HPOS="626" VPOS="2132" WIDTH="264" HEIGHT="63" BASELINE="628 2173 890 2178" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2173 626 2191 886 2195 890 2178 890 2147 847 2134 845 2134 843 2134 741 2143 723 2132 721 2132 719 2132 717 2132 628 2141 628 2173"/>
                        </Shape>
                        <String CONTENT="Indians do."/>
                    </TextLine>
<TextLine ID="mz_1-280_l28" HPOS="734" VPOS="2199" WIDTH="1668" HEIGHT="57" BASELINE="736 2236 2402 2243" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2236 734 2249 2398 2256 2402 2243 2402 2210 736 2199 736 2236"/>
                        </Shape>
                        <String CONTENT="The best curried leather of Chukchee make is the retteˊm,¹ i. e., the"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l29" HPOS="624" VPOS="2266" WIDTH="1778" HEIGHT="61" BASELINE="626 2297 2402 2301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2297 624 2312 784 2325 786 2325 1486 2316 1598 2327 1601 2327 2400 2316 2402 2301 2400 2271 626 2266 626 2297"/>
                        </Shape>
                        <String CONTENT="covering of the outer tent, especially the upper parts, which get a continuous"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l30" HPOS="624" VPOS="2325" WIDTH="1776" HEIGHT="50" BASELINE="626 2357 2400 2362" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2357 624 2370 2395 2375 2400 2362 2398 2327 626 2325 626 2357"/>
                        </Shape>
                        <String CONTENT="smoking from the hearth inside. This leather does not shrink after rain, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l31" HPOS="622" VPOS="2383" WIDTH="1778" HEIGHT="52" BASELINE="624 2416 2400 2420" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2416 622 2431 2395 2435 2400 2420 2398 2390 624 2383 624 2416"/>
                        </Shape>
                        <String CONTENT="is waterproof to a considerable degree. The tent-covering has the hair closely"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l32" HPOS="622" VPOS="2446" WIDTH="1776" HEIGHT="59" BASELINE="624 2476 2398 2481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2476 622 2489 689 2502 691 2502 1453 2494 1540 2505 1542 2505 2395 2494 2398 2481 2395 2450 624 2446 624 2476"/>
                        </Shape>
                        <String CONTENT="cropped. In making clothes, this hair, if necessary, is scraped off with an"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l33" HPOS="624" VPOS="2500" WIDTH="1774" HEIGHT="63" BASELINE="626 2535 2398 2541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2535 624 2552 635 2561 637 2561 639 2561 641 2563 2395 2563 2398 2541 2395 2511 626 2500 626 2535"/>
                        </Shape>
                        <String CONTENT="iron scraper. Because of the previous smoking, it comes off easily. Often,"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l34" HPOS="624" VPOS="2567" WIDTH="513" HEIGHT="48" BASELINE="624 2598 1137 2598" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2598 624 2615 1137 2615 1137 2598 1137 2567 624 2567 624 2598"/>
                        </Shape>
                        <String CONTENT="however, it is left on."/>
                    </TextLine>
<TextLine ID="mz_1-280_l35" HPOS="734" VPOS="2619" WIDTH="1668" HEIGHT="54" BASELINE="736 2656 2402 2660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2656 734 2669 2398 2673 2402 2660 2400 2628 736 2619 736 2656"/>
                        </Shape>
                        <String CONTENT="The dressing of seal-skins has not developed to the same degree as that"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l36" HPOS="622" VPOS="2684" WIDTH="1778" HEIGHT="61" BASELINE="624 2717 2400 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2717 622 2730 1824 2745 1826 2745 2398 2734 2400 2721 2398 2686 624 2684 624 2717"/>
                        </Shape>
                        <String CONTENT="of reindeer-skins, because the former are utilized only for boots, bags, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l37" HPOS="622" VPOS="2736" WIDTH="1778" HEIGHT="65" BASELINE="624 2782 2400 2777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2782 624 2801 2398 2793 2400 2777 2395 2747 2203 2736 2200 2736 2198 2736 2196 2736 2181 2749 2038 2749 2012 2736 2010 2736 2008 2736 1936 2747 1899 2736 1897 2736 1895 2736 1893 2736 1891 2736 1873 2749 1735 2749 1698 2736 1696 2736 1694 2736 1692 2736 1689 2736 1674 2749 1559 2749 1527 2736 1525 2736 1523 2736 1436 2749 879 2738 877 2738 875 2738 845 2751 622 2751 624 2782"/>
                        </Shape>
                        <String CONTENT="purposes which do not require so much care in preparing the material as is"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l38" HPOS="622" VPOS="2805" WIDTH="1778" HEIGHT="59" BASELINE="624 2838 2400 2842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2838 622 2853 635 2862 637 2862 639 2862 641 2862 1462 2853 1523 2864 1525 2864 2398 2853 2400 2842 2398 2810 624 2805 624 2838"/>
                        </Shape>
                        <String CONTENT="necessary for clothing. Walrus and thong-seal skins, after they are dried, do"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l39" HPOS="622" VPOS="2864" WIDTH="1776" HEIGHT="61" BASELINE="624 2894 2398 2899" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2894 622 2909 1640 2925 1642 2925 2395 2914 2398 2899 2395 2868 624 2864 624 2894"/>
                        </Shape>
                        <String CONTENT="not undergo any further process. The thong-seal skin is used with the hair"/>
                    </TextLine>

                    <TextLine ID="mz_1-280_l40" HPOS="624" VPOS="2925" WIDTH="1774" HEIGHT="47" BASELINE="626 2955 2398 2959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2955 624 2968 2393 2972 2398 2959 2395 2929 626 2925 626 2955"/>
                        </Shape>
