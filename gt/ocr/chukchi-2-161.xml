                        <Shape>
                            <Polygon POINTS="421 1885 421 1901 1778 1901 1780 1881 1776 1854 1584 1854 1560 1842 1558 1842 1557 1842 1464 1852 1441 1842 1439 1842 1437 1842 1378 1852 1327 1842 1325 1842 1323 1842 1322 1842 1306 1854 1151 1854 1126 1842 1124 1842 1122 1842 1120 1842 1085 1854 522 1844 520 1844 519 1844 497 1854 442 1844 440 1844 438 1844 436 1844 419 1852 421 1885"/>
                        </Shape>
                        <String CONTENT="the listeners will withdraw, perhaps, earlier than the actors."/>
                    </TextLine>
<TextLine ID="mz_2-161_l25" HPOS="528" VPOS="1911" WIDTH="1659" HEIGHT="47" BASELINE="530 1942 2187 1946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="530 1942 528 1954 2183 1958 2187 1946 2185 1915 530 1911 530 1942"/>
                        </Shape>
                        <String CONTENT="SHAMANISTIC PERFORMANCE IN THE INNER ROOM. — The typical shamanistic"/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l26" HPOS="421" VPOS="1968" WIDTH="1766" HEIGHT="54" BASELINE="421 2003 2187 2007" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="421 2003 421 2022 2185 2019 2187 2007 2183 1968 421 1972 421 2003"/>
                        </Shape>
                        <String CONTENT="performance is carried out in the following manner. After the evening meal"/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l27" HPOS="417" VPOS="2022" WIDTH="1770" HEIGHT="59" BASELINE="419 2068 2187 2064" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="419 2068 419 2081 2185 2081 2187 2064 2183 2034 2064 2022 2062 2022 2060 2022 2038 2034 1727 2034 1698 2022 1696 2022 1694 2022 1604 2032 1572 2022 1570 2022 1568 2022 1566 2022 1537 2034 417 2034 419 2068"/>
                        </Shape>
                        <String CONTENT="is finished and the kettles and trays are removed to the outer tent, all the"/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l28" HPOS="421" VPOS="2097" WIDTH="1766" HEIGHT="51" BASELINE="421 2126 2187 2126" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="421 2126 421 2148 2187 2140 2187 2126 2187 2097 421 2097 421 2126"/>
                        </Shape>
                        <String CONTENT="people who wish to be present at the seance enter the inner room, which is"/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l29" HPOS="419" VPOS="2144" WIDTH="1768" HEIGHT="57" BASELINE="419 2185 2187 2185" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="419 2185 419 2199 2183 2201 2187 2185 2185 2156 1400 2144 1398 2144 1396 2144 1370 2154 1323 2144 1322 2144 1320 2144 1318 2144 1302 2156 1204 2156 1137 2144 1135 2144 1059 2154 975 2144 973 2144 906 2154 877 2144 875 2144 873 2144 820 2154 746 2144 744 2144 689 2154 652 2144 650 2144 648 2144 646 2144 607 2154 524 2144 522 2144 419 2154 419 2185"/>
                        </Shape>
                        <String CONTENT="carefully closed for the night. Among the Reindeer Chukchee, the inner room"/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l30" HPOS="419" VPOS="2212" WIDTH="1768" HEIGHT="47" BASELINE="419 2246 2187 2246" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="419 2246 419 2259 2185 2259 2187 2246 2185 2216 419 2212 419 2246"/>
                        </Shape>
                        <String CONTENT="is especially small, and its narrow space causes much inconvenience to the"/>
                    </TextLine>

