                        <Shape>
                            <Polygon POINTS="419 2301 417 2314 2181 2318 2185 2304 2183 2275 419 2271 419 2301"/>
                        </Shape>
                        <String CONTENT="audience, which is packed together in a tight and most uncomfortable manner."/>
                    </TextLine>

                    <TextLine ID="mz_2-161_l32" HPOS="421" VPOS="2322" WIDTH="1768" HEIGHT="55" BASELINE="423 2365 2189 2361" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="423 2365 423 2377 2189 2375 2189 2361 2181 2322 2154 2334 2064 2334 2048 2322 2046 2322 2044 2322 2042 2322 2040 2322 2001 2332 1915 2322 1913 2322 1911 2322 1884 2332 1709 2322 1707 2322 1660 2334 1560 2334 1545 2322 1543 2322 1541 2322 1539 2322 1300 2334 1041 2324 1039 2324 1038 2324 1004 2334 930 2324 785 2324 783 2324 781 2324 779 2324 765 2334 685 2324 683 2324 421 2328 423 2365"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee have more room, and may listen to the voices of"/>
                    </TextLine>

