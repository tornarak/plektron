</TextBlock>
                <TextBlock ID="mz_1-173_r2" HPOS="371" VPOS="721" WIDTH="1778" HEIGHT="413" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="371 721 2149 721 2149 1134 371 1134"/>
                    </Shape>
                    <TextLine ID="mz_1-173_l3" HPOS="370" VPOS="723" WIDTH="1776" HEIGHT="52" BASELINE="370 757 2146 757" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 757 370 775 2146 775 2146 757 2144 723 370 723 370 757"/>
                        </Shape>
                        <String CONTENT="instance, on a village shore, — they simply seize the boat by the lashings and"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l4" HPOS="373" VPOS="775" WIDTH="1773" HEIGHT="69" BASELINE="373 818 2146 818" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 818 373 831 457 844 459 844 461 844 498 833 654 844 656 844 721 833 786 844 788 844 851 833 1514 833 1646 844 1648 844 1709 833 1722 844 1724 844 1726 844 1728 844 2146 831 2146 818 2146 786 2112 775 2109 775 2107 775 2045 786 2029 775 2027 775 2025 775 2023 775 2021 775 1975 786 1776 775 1774 775 1653 786 1601 775 1598 775 1596 775 1557 786 1488 775 1486 775 1432 786 1332 775 1330 775 1204 786 1098 775 1096 775 1094 775 1048 786 1007 775 1005 775 1003 775 1001 775 968 786 942 775 940 775 938 775 936 775 895 788 635 788 596 775 594 775 591 775 589 775 548 786 518 775 516 775 513 775 511 775 509 775 494 788 373 788 373 818"/>
                        </Shape>
                        <String CONTENT="carry it along, cargo and all. These methods of landing, quite impracticable"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l5" HPOS="373" VPOS="842" WIDTH="1771" HEIGHT="54" BASELINE="375 874 2144 879" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 874 373 889 2140 896 2144 879 2142 846 375 842 375 874"/>
                        </Shape>
                        <String CONTENT="with the ordinary wooden whale-boat, look strange to a civilized eye; but when,"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l6" HPOS="370" VPOS="905" WIDTH="1776" HEIGHT="49" BASELINE="373 937 2146 933" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 937 373 954 2144 950 2146 933 2142 905 370 905 373 937"/>
                        </Shape>
                        <String CONTENT="in the first heavy surf encountered on our journey, we tried to land with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l7" HPOS="370" VPOS="965" WIDTH="1774" HEIGHT="48" BASELINE="373 998 2144 993" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 998 373 1013 2142 1011 2144 993 2140 965 370 965 373 998"/>
                        </Shape>
                        <String CONTENT="bow forward, in the ordinary way, the boat filled with water and nearly"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l8" HPOS="370" VPOS="1026" WIDTH="1776" HEIGHT="47" BASELINE="370 1056 2146 1056" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1056 370 1073 2146 1073 2146 1056 2146 1026 370 1026 370 1056"/>
                        </Shape>
                        <String CONTENT="capsized; and it would have been completely wrecked had it not been for the"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l9" HPOS="373" VPOS="1086" WIDTH="1041" HEIGHT="48" BASELINE="373 1117 1414 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1117 373 1134 1414 1134 1414 1117 1414 1086 373 1086 373 1117"/>
                        </Shape>
                        <String CONTENT="extreme toughness and elasticity of its frame."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-173_r3" HPOS="371" VPOS="1134" WIDTH="1778" HEIGHT="249" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="371 1134 2149 1134 2149 1383 371 1383"/>
                    </Shape>
                    <TextLine ID="mz_1-173_l10" HPOS="479" VPOS="1147" WIDTH="1667" HEIGHT="46" BASELINE="479 1177 2146 1177" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 1177 479 1193 2144 1193 2146 1177 2144 1147 479 1147 479 1177"/>
                        </Shape>
                        <String CONTENT="Of the wooden boats I had occasion to see, the “sampan” of northern"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l11" HPOS="370" VPOS="1193" WIDTH="1776" HEIGHT="67" BASELINE="373 1240 2146 1234" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1240 373 1260 2144 1249 2146 1234 2142 1203 1555 1193 1553 1193 1551 1193 1507 1206 370 1206 373 1240"/>
                        </Shape>
                        <String CONTENT="Japanese fishermen with flat bottom and smooth sides, more nearly resembles"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l12" HPOS="373" VPOS="1251" WIDTH="1771" HEIGHT="63" BASELINE="375 1299 2144 1292" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1299 375 1314 2142 1312 2144 1292 2140 1264 2016 1251 2014 1251 2012 1251 2010 1251 1995 1264 1884 1264 1860 1251 1858 1251 1856 1251 1804 1262 1778 1251 1776 1251 1774 1251 1672 1262 1648 1251 1646 1251 1644 1251 1551 1264 1536 1253 1533 1253 1531 1253 1529 1253 1527 1253 1499 1264 1468 1253 1466 1253 1464 1253 1462 1253 1436 1264 1378 1253 1375 1253 1373 1253 1371 1253 1356 1266 1263 1266 1198 1253 1196 1253 1141 1264 1109 1253 1107 1253 1105 1253 1102 1253 1074 1264 1044 1253 1042 1253 1040 1253 1038 1253 1035 1253 1018 1264 604 1255 602 1255 600 1255 572 1266 500 1255 498 1255 496 1255 453 1266 392 1255 390 1255 388 1255 386 1255 373 1264 375 1299"/>
                        </Shape>
                        <String CONTENT="the skin boat. Like that, it is able to land through surf, when ordinary"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l13" HPOS="373" VPOS="1320" WIDTH="1459" HEIGHT="61" BASELINE="375 1353 1832 1357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1353 373 1372 383 1381 386 1381 388 1381 390 1381 1830 1372 1832 1357 1830 1327 375 1320 375 1353"/>
                        </Shape>
                        <String CONTENT="European boats are threatened at every attempt with capsizing."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-173_r4" HPOS="371" VPOS="1383" WIDTH="1778" HEIGHT="299" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="371 1383 2149 1383 2149 1682 371 1682"/>
                    </Shape>
                    <TextLine ID="mz_1-173_l14" HPOS="479" VPOS="1383" WIDTH="1667" HEIGHT="50" BASELINE="481 1413 2146 1418" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="481 1413 479 1429 2142 1433 2146 1418 2144 1387 481 1383 481 1413"/>
                        </Shape>
                        <String CONTENT="For setting out from shore, the skin boat is put close to the water, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l15" HPOS="373" VPOS="1442" WIDTH="1773" HEIGHT="49" BASELINE="373 1476 2146 1476" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1476 373 1491 2146 1491 2146 1476 2146 1442 373 1442 373 1476"/>
                        </Shape>
                        <String CONTENT="bow foremost but out of reach of the larger waves. Two or three inflated"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l16" HPOS="370" VPOS="1491" WIDTH="1776" HEIGHT="72" BASELINE="373 1537 2146 1532" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1537 373 1552 858 1552 905 1563 908 1563 910 1563 912 1563 914 1563 929 1552 1040 1552 1146 1563 1148 1563 1258 1561 1261 1561 1263 1561 1278 1550 1581 1550 1618 1561 1620 1561 1622 1561 2144 1550 2146 1532 2142 1504 2045 1491 2042 1491 2040 1491 2038 1491 2023 1502 1977 1491 1975 1491 1973 1491 1971 1491 1949 1502 1817 1491 1815 1491 1813 1491 1811 1491 1795 1504 1655 1504 1598 1491 1596 1491 1594 1491 1568 1502 1540 1491 1538 1491 1536 1491 1533 1491 1512 1502 1488 1491 1486 1491 1484 1491 1386 1502 1310 1491 1308 1491 1250 1504 1198 1494 1196 1494 1193 1494 1154 1504 611 1494 609 1494 607 1494 604 1494 589 1506 500 1506 388 1494 386 1494 383 1494 381 1494 370 1502 373 1537"/>
                        </Shape>
                        <String CONTENT="floats are laid under it, with long lines tied to their flippers. Then the boat"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l17" HPOS="370" VPOS="1561" WIDTH="1774" HEIGHT="58" BASELINE="373 1593 2144 1597" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1593 370 1606 396 1619 399 1619 401 1619 2142 1610 2144 1597 2142 1567 373 1561 373 1593"/>
                        </Shape>
                        <String CONTENT="is loaded, and with one effort pushed into the water; while the crew, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l18" HPOS="373" VPOS="1626" WIDTH="1457" HEIGHT="47" BASELINE="373 1656 1830 1656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1656 373 1673 1830 1673 1830 1656 1830 1626 373 1626 373 1656"/>
                        </Shape>
                        <String CONTENT="oars and poles, prevent it from being hurled against the shore."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-173_r5" HPOS="371" VPOS="1682" WIDTH="1778" HEIGHT="302" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="371 1682 2149 1682 2149 1984 371 1984"/>
                    </Shape>
                    <TextLine ID="mz_1-173_l19" HPOS="477" VPOS="1682" WIDTH="1671" HEIGHT="50" BASELINE="479 1712 2148 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 1712 477 1727 2144 1732 2148 1717 2146 1682 479 1682 479 1712"/>
                        </Shape>
                        <String CONTENT="On narrow strips of land between two shores the boats are unloaded and"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l20" HPOS="368" VPOS="1745" WIDTH="1776" HEIGHT="54" BASELINE="370 1775 2144 1779" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1775 368 1788 388 1799 390 1799 392 1799 2142 1794 2144 1779 2142 1749 370 1745 370 1775"/>
                        </Shape>
                        <String CONTENT="taken across. Six men can easily carry on their shoulders an empty boat,"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l21" HPOS="370" VPOS="1792" WIDTH="1776" HEIGHT="70" BASELINE="373 1833 2146 1838" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1833 370 1849 386 1859 388 1859 390 1859 392 1859 1139 1851 1274 1862 1276 1862 2144 1851 2146 1838 2144 1807 2071 1794 2068 1794 2006 1805 1973 1794 1971 1794 1969 1794 1967 1794 1934 1805 1904 1794 1902 1794 1795 1794 1793 1794 1791 1794 1789 1794 1776 1805 1733 1794 1731 1794 1728 1794 1631 1807 1497 1807 1479 1794 1477 1794 1475 1794 1473 1794 1200 1803 1174 1792 1172 1792 1170 1792 1167 1792 1133 1805 944 1805 929 1792 927 1792 925 1792 923 1792 845 1803 814 1792 812 1792 810 1792 808 1792 780 1803 745 1792 743 1792 741 1792 739 1792 708 1805 583 1805 568 1792 565 1792 563 1792 561 1792 373 1801 373 1833"/>
                        </Shape>
                        <String CONTENT="even when soaked with water. Sometimes only part of the freight is taken"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l22" HPOS="373" VPOS="1855" WIDTH="1775" HEIGHT="59" BASELINE="373 1896 2148 1896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1896 373 1914 2148 1914 2148 1896 2148 1866 1941 1855 1938 1855 1847 1866 1793 1855 1791 1855 1683 1866 1592 1855 1590 1855 1512 1866 1414 1855 1412 1855 1410 1855 1375 1866 1330 1855 1328 1855 1326 1855 1323 1855 1321 1855 1302 1868 1068 1868 973 1855 970 1855 877 1866 845 1855 843 1855 840 1855 838 1855 814 1866 715 1855 713 1855 710 1855 680 1866 626 1855 624 1855 622 1855 598 1866 563 1855 561 1855 559 1855 373 1866 373 1896"/>
                        </Shape>
                        <String CONTENT="out, and the boat is pushed across on the floats, which act like rollers and"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l23" HPOS="370" VPOS="1922" WIDTH="843" HEIGHT="52" BASELINE="373 1959 1213 1952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1959 373 1974 1211 1968 1213 1952 1206 1922 370 1927 373 1959"/>
                        </Shape>
                        <String CONTENT="prevent its contact with the ground."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-173_r6" HPOS="371" VPOS="1984" WIDTH="1778" HEIGHT="838" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="371 1984 2149 1984 2149 2822 371 2822"/>
                    </Shape>
                    <TextLine ID="mz_1-173_l24" HPOS="479" VPOS="1985" WIDTH="1667" HEIGHT="48" BASELINE="479 2015 2146 2015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="479 2015 479 2033 2144 2033 2146 2015 2144 1985 479 1985 479 2015"/>
                        </Shape>
                        <String CONTENT="One of the drawbacks of the skin boat is the fragility of its cover. Every"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l25" HPOS="373" VPOS="2035" WIDTH="1771" HEIGHT="58" BASELINE="373 2078 2144 2078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2078 373 2093 2144 2093 2144 2078 2144 2048 2075 2035 2073 2035 2016 2046 1949 2035 1947 2035 1945 2035 1921 2046 1897 2035 1895 2035 1893 2035 1891 2035 1863 2046 1633 2035 1631 2035 1629 2035 1627 2035 1609 2048 1481 2048 1451 2035 1449 2035 1447 2035 1445 2035 1423 2046 1395 2035 1393 2035 1391 2035 1339 2046 1269 2035 1267 2035 1265 2035 1226 2046 1139 2035 1137 2035 1135 2035 1133 2035 1118 2048 864 2048 749 2035 747 2035 745 2035 715 2046 685 2035 682 2035 680 2035 678 2035 676 2035 659 2048 498 2048 401 2035 399 2035 396 2035 373 2046 373 2078"/>
                        </Shape>
                        <String CONTENT="sharp stone is liable to cut a hole through it, especially when it has been"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l26" HPOS="373" VPOS="2095" WIDTH="1773" HEIGHT="59" BASELINE="373 2139 2146 2139" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2139 373 2154 2146 2154 2146 2139 2146 2106 2120 2095 2118 2095 2116 2095 2114 2095 2084 2106 2055 2095 2053 2095 2051 2095 2049 2095 2023 2108 1720 2108 1689 2095 1687 2095 1685 2095 1683 2095 1661 2106 1635 2095 1633 2095 1631 2095 1575 2106 1520 2095 1518 2095 1516 2095 1479 2106 1447 2095 1445 2095 1442 2095 1440 2095 1438 2095 1423 2108 1274 2108 1226 2095 1224 2095 1222 2095 1219 2095 1217 2095 1200 2108 990 2108 925 2095 923 2095 921 2095 877 2106 864 2095 862 2095 860 2095 730 2095 728 2095 665 2106 630 2095 628 2095 626 2095 546 2106 451 2095 448 2095 373 2106 373 2139"/>
                        </Shape>
                        <String CONTENT="soaked and softened with water. At every landing it is necessary to look"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l27" HPOS="370" VPOS="2162" WIDTH="1778" HEIGHT="59" BASELINE="373 2193 2148 2197" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2193 370 2208 386 2219 388 2219 390 2219 392 2219 1089 2210 1263 2221 1265 2221 2146 2210 2148 2197 2146 2162 373 2162 373 2193"/>
                        </Shape>
                        <String CONTENT="carefully over the whole skin surface, to clean away from under the central"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l28" HPOS="370" VPOS="2223" WIDTH="1778" HEIGHT="50" BASELINE="373 2253 2148 2258" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2253 370 2269 2144 2273 2148 2258 2146 2227 373 2223 373 2253"/>
                        </Shape>
                        <String CONTENT="timber every small pebble, and to patch even the minutest hole; otherwise"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l29" HPOS="370" VPOS="2284" WIDTH="1774" HEIGHT="56" BASELINE="373 2314 2144 2318" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2314 370 2327 403 2340 405 2340 407 2340 2142 2331 2144 2318 2142 2288 373 2284 373 2314"/>
                        </Shape>
                        <String CONTENT="the boat may suddenly spring a leak while on the water, and necessitate an"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l30" HPOS="373" VPOS="2347" WIDTH="1773" HEIGHT="47" BASELINE="373 2375 2146 2375" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2375 373 2394 2146 2394 2146 2375 2146 2347 373 2347 373 2375"/>
                        </Shape>
                        <String CONTENT="extra landing. When in good repair, the boat is water-tight, and requires no"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l31" HPOS="375" VPOS="2401" WIDTH="1773" HEIGHT="52" BASELINE="375 2435 2148 2435" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2435 375 2453 2148 2453 2148 2435 2148 2407 375 2401 375 2435"/>
                        </Shape>
                        <String CONTENT="bailer; on the other hand, I know of cases where, on account of an over-"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l32" HPOS="373" VPOS="2461" WIDTH="1773" HEIGHT="52" BASELINE="373 2496 2146 2496" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2496 373 2513 2146 2513 2146 2496 2146 2466 373 2461 373 2496"/>
                        </Shape>
                        <String CONTENT="looked gap, boats were almost sunk before a landing could be effected. While"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l33" HPOS="370" VPOS="2522" WIDTH="1776" HEIGHT="50" BASELINE="373 2552 2146 2557" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2552 370 2567 2142 2572 2146 2557 2144 2526 373 2522 373 2552"/>
                        </Shape>
                        <String CONTENT="on shore, the boat is turned upside down, pebbles and sand are shaken off by"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l34" HPOS="370" VPOS="2574" WIDTH="1776" HEIGHT="58" BASELINE="370 2617 2146 2617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 2617 370 2632 2146 2632 2146 2617 2144 2583 1930 2585 1873 2574 1871 2574 1808 2585 1748 2574 1746 2574 1657 2585 1629 2574 1627 2574 1624 2574 1553 2585 1505 2574 1503 2574 1501 2574 1499 2574 1453 2585 1423 2574 1421 2574 1419 2574 1416 2574 1414 2574 1397 2587 1252 2587 1204 2574 1202 2574 1200 2574 1198 2574 1172 2585 1144 2574 1141 2574 1139 2574 947 2585 892 2574 890 2574 888 2574 849 2585 791 2574 788 2574 723 2585 600 2574 598 2574 596 2574 594 2574 581 2585 552 2574 550 2574 548 2574 370 2585 370 2617"/>
                        </Shape>
                        <String CONTENT="repeated blows with the oar, and the cover is allowed to dry. If not dried"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l35" HPOS="370" VPOS="2641" WIDTH="1772" HEIGHT="58" BASELINE="373 2673 2142 2678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2673 370 2686 407 2699 409 2699 412 2699 2140 2697 2142 2678 2140 2645 373 2641 373 2673"/>
                        </Shape>
                        <String CONTENT="for a long time, the boat will warp and get out of shape. To prevent warping,"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l36" HPOS="370" VPOS="2702" WIDTH="1778" HEIGHT="60" BASELINE="373 2734 2148 2738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2734 370 2747 791 2760 793 2760 1217 2751 1343 2762 1345 2762 2146 2751 2148 2738 2146 2706 373 2702 373 2734"/>
                        </Shape>
                        <String CONTENT="the boat has several sets of special lashings (see Fig. 44, c¹), which connect"/>
                    </TextLine>

                    <TextLine ID="mz_1-173_l37" HPOS="370" VPOS="2760" WIDTH="1729" HEIGHT="58" BASELINE="373 2790 2099 2797" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2790 370 2808 388 2818 390 2818 392 2818 394 2818 2097 2812 2099 2797 2097 2767 373 2760 373 2790"/>
                        </Shape>
