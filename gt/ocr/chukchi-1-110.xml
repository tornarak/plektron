                <TextBlock ID="text_1-110" HPOS="620" VPOS="610" WIDTH="1782" HEIGHT="2633"><TextLine ID="mz_1-110_l1" HPOS="1200" VPOS="615" WIDTH="615" HEIGHT="54" BASELINE="1200 649 1815 649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1806 628 1791 615 1217 615 1202 638 1200 649 1200 669 1815 669 1815 649 1811 634 1806 628"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l2" HPOS="624" VPOS="610" WIDTH="80" HEIGHT="65" BASELINE="624 651 704 651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 651 624 664 639 675 641 675 643 675 646 675 704 662 704 651 704 623 643 610 624 651"/>
                        </Shape>
                        <String CONTENT="82"/>
                    </TextLine>
<TextLine ID="mz_1-110_l3" HPOS="620" VPOS="712" WIDTH="1775" HEIGHT="63" BASELINE="622 755 2395 760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2265 716 2244 714 2222 714 2200 714 2179 714 1973 714 1971 714 1969 714 1945 725 1546 714 1544 714 1542 714 1510 725 1434 712 1432 712 1341 723 1323 712 1321 712 1319 712 1317 712 1315 712 1287 723 1274 712 1271 712 1269 712 1267 712 1265 712 1217 723 1159 712 1157 712 1154 712 1128 723 1102 712 1100 712 1098 712 1096 712 1072 723 1050 712 1048 712 1046 712 1044 712 1018 723 622 721 622 755 620 768 2391 775 2395 760 2395 727 2287 716 2265 716"/>
                        </Shape>
                        <String CONTENT="he makes an attack in broad daylight and in the presence of several herdsmen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l4" HPOS="624" VPOS="770" WIDTH="1776" HEIGHT="65" BASELINE="624 820 2400 812" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 820 624 835 2398 827 2400 812 2395 783 2320 770 2317 770 2257 781 2242 770 2239 770 2237 770 2235 770 2233 770 2231 770 2211 783 2086 783 2062 770 2060 770 2058 770 1995 781 1973 770 1971 770 1969 770 1967 770 1964 770 1947 783 1644 773 1642 773 1640 773 1605 783 1551 773 1549 773 1546 773 1505 786 1163 775 1161 775 1050 788 873 777 871 777 754 788 710 777 708 777 706 777 633 788 624 820"/>
                        </Shape>
                        <String CONTENT="as I myself had occasion to witness. Possibly this may be due to the fact"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l5" HPOS="624" VPOS="838" WIDTH="1774" HEIGHT="58" BASELINE="624 879 2398 872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 879 624 896 2395 889 2398 872 2393 842 643 838 641 838 639 838 637 838 624 879"/>
                        </Shape>
                        <String CONTENT="that the Chukchee have a taboo against the use of fire-arms on the wolf, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l6" HPOS="622" VPOS="894" WIDTH="1033" HEIGHT="69" BASELINE="624 933 1655 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 933 622 950 635 959 637 959 639 959 641 959 934 950 1310 963 1313 963 1653 952 1655 939 1655 911 1631 898 1629 898 1627 898 1624 898 1585 909 1529 898 1442 898 1440 898 1438 898 1436 898 1436 900 1425 909 1386 898 1384 898 1382 898 1380 898 1347 909 1258 898 1256 898 1031 907 1014 896 1012 896 1009 896 1007 896 1005 896 966 907 892 894 890 894 888 894 849 907 719 907 708 896 708 894 706 894 704 894 702 894 635 902 624 933"/>
                        </Shape>
                        <String CONTENT="will use only a lasso or a trap for killing it."/>
                    </TextLine>
<TextLine ID="mz_1-110_l7" HPOS="730" VPOS="952" WIDTH="1670" HEIGHT="74" BASELINE="732 996 2400 991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 996 732 1026 838 1011 1562 1019 1564 1019 1566 1019 1594 1009 1614 1022 1616 1022 1618 1022 1620 1024 1718 1024 1718 1022 1720 1022 1722 1022 1735 1011 1878 1022 1880 1022 1882 1022 1908 1009 2001 1022 2003 1022 2064 1009 2081 1019 2084 1019 2086 1019 2088 1019 2157 1009 2185 1019 2187 1019 2190 1022 2378 1022 2378 1019 2380 1019 2382 1019 2400 1006 2400 991 2395 963 1774 952 1772 952 730 963 732 996"/>
                        </Shape>
                        <String CONTENT="THE HERDSMAN’S WORK. — On the open, stormy tundra the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l8" HPOS="620" VPOS="1013" WIDTH="1778" HEIGHT="60" BASELINE="622 1058 2398 1054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1058 622 1073 2395 1069 2398 1054 2395 1024 2376 1013 2374 1013 2372 1013 2369 1013 2313 1024 2205 1013 2203 1013 2116 1024 2088 1013 2086 1013 2084 1013 2081 1013 2055 1026 1843 1026 1824 1013 1821 1013 1819 1013 1670 1013 1668 1013 1666 1013 1663 1013 1646 1026 1505 1026 1440 1015 1438 1015 1436 1015 1406 1026 1334 1015 1332 1015 1330 1015 1302 1026 1287 1015 1284 1015 1282 1015 1280 1015 1215 1026 1009 1015 1007 1015 1005 1015 970 1026 934 1015 931 1015 929 1015 873 1026 728 1015 726 1015 620 1024 622 1058"/>
                        </Shape>
                        <String CONTENT="herdsman, who has no watch-dog, has a considerable amount of trouble with"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l9" HPOS="620" VPOS="1069" WIDTH="1778" HEIGHT="65" BASELINE="622 1119 2398 1112" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1119 622 1134 2395 1128 2398 1112 2393 1082 2283 1069 2281 1069 2183 1080 2168 1069 2166 1069 2164 1069 2161 1069 2068 1080 2045 1069 2042 1069 2040 1069 1960 1080 1934 1069 1932 1069 1930 1069 1928 1069 1895 1080 1793 1071 1791 1071 1789 1071 1787 1071 1774 1082 1754 1071 1752 1071 1750 1071 1696 1082 1594 1071 1592 1071 1590 1071 1588 1071 1568 1084 1362 1084 1276 1071 1274 1071 1211 1084 1157 1073 1154 1073 970 1084 942 1073 940 1073 938 1073 936 1073 934 1073 921 1084 908 1073 905 1073 903 1073 726 1073 723 1073 721 1073 691 1084 633 1073 630 1073 628 1073 626 1073 626 1076 620 1080 622 1119"/>
                        </Shape>
                        <String CONTENT="his half-wild herd. The reindeer are only half domesticated, and ready to"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l10" HPOS="620" VPOS="1134" WIDTH="1775" HEIGHT="61" BASELINE="622 1180 2395 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1180 622 1193 2391 1195 2395 1175 2391 1145 1520 1134 1518 1134 1516 1134 1514 1134 1501 1145 641 1136 639 1136 637 1136 635 1136 620 1143 622 1180"/>
                        </Shape>
                        <String CONTENT="disperse on the first occasion. When left to themselves in the open tundra,"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l11" HPOS="620" VPOS="1197" WIDTH="1778" HEIGHT="61" BASELINE="622 1240 2398 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1240 622 1258 2395 1258 2398 1236 2393 1206 646 1197 643 1197 641 1197 620 1206 622 1240"/>
                        </Shape>
                        <String CONTENT="they soon become quite wild, and even more wary than the wild reindeer,"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l12" HPOS="620" VPOS="1253" WIDTH="1775" HEIGHT="72" BASELINE="622 1301 2395 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1301 622 1314 851 1325 853 1325 856 1325 858 1325 873 1314 1141 1314 1209 1325 1211 1325 1213 1325 1254 1312 1594 1322 1596 1322 1598 1322 1640 1312 2393 1312 2395 1294 2391 1266 2038 1253 2036 1253 1962 1264 1884 1253 1882 1253 1880 1253 1878 1253 1860 1264 1832 1253 1830 1253 1828 1253 1763 1266 1302 1255 1300 1255 1297 1255 1274 1266 892 1258 890 1258 888 1258 886 1258 871 1268 778 1258 775 1258 773 1258 736 1268 648 1258 646 1258 643 1258 620 1268 622 1301"/>
                        </Shape>
                        <String CONTENT="since they know the ways of man. Every now and then, when going to a"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l13" HPOS="620" VPOS="1318" WIDTH="1778" HEIGHT="56" BASELINE="622 1361 2398 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1361 622 1374 2395 1368 2398 1355 2393 1325 637 1318 635 1318 633 1318 630 1318 620 1325 622 1361"/>
                        </Shape>
                        <String CONTENT="fresh pasture or wandering over the tundra, some wayward animals will start"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l14" HPOS="624" VPOS="1377" WIDTH="1771" HEIGHT="60" BASELINE="624 1420 2395 1413" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1420 624 1435 2391 1437 2395 1413 2391 1383 639 1377 637 1377 624 1420"/>
                        </Shape>
                        <String CONTENT="in the wrong direction, and the herdsman has to head them off. The herd,"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l15" HPOS="624" VPOS="1433" WIDTH="1776" HEIGHT="63" BASELINE="624 1481 2400 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1481 624 1496 2398 1489 2400 1474 2395 1444 1806 1433 1804 1433 1802 1433 1800 1433 1800 1435 1789 1444 1224 1435 1222 1435 1219 1435 1217 1435 1204 1446 648 1437 646 1437 643 1437 635 1439 624 1481"/>
                        </Shape>
                        <String CONTENT="therefore, progresses but slowly; and the more slowly, the larger the number"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l16" HPOS="624" VPOS="1491" WIDTH="1776" HEIGHT="63" BASELINE="624 1539 2400 1532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1539 624 1554 2398 1548 2400 1532 2395 1504 2244 1504 2229 1491 2226 1491 2224 1491 2222 1491 2220 1491 2183 1502 1962 1491 1960 1491 1958 1491 1934 1504 1785 1504 1750 1494 1748 1494 1746 1494 1744 1494 1715 1504 1588 1494 1585 1494 1536 1504 1505 1494 1503 1494 1501 1494 1432 1504 1375 1494 1373 1494 1371 1494 1341 1504 1287 1494 1284 1494 1211 1506 663 1496 661 1496 659 1496 635 1502 624 1539"/>
                        </Shape>
                        <String CONTENT="of animals. The highest praise for a herdsman is to say that his herd moves"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l17" HPOS="624" VPOS="1556" WIDTH="1776" HEIGHT="65" BASELINE="624 1597 2400 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1597 624 1613 1490 1621 1492 1621 1594 1610 1676 1621 1679 1621 1774 1610 1884 1621 1886 1621 1889 1621 1891 1621 1906 1610 1995 1610 2148 1621 2151 1621 2153 1621 2177 1610 2239 1621 2242 1621 2244 1621 2268 1610 2352 1621 2354 1621 2356 1621 2400 1608 2400 1593 2395 1561 652 1556 650 1556 648 1556 635 1561 624 1597"/>
                        </Shape>
                        <String CONTENT="along swiftly; like “the small cluster of a poor man,” to employ the usual"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l18" HPOS="624" VPOS="1628" WIDTH="693" HEIGHT="45" BASELINE="624 1656 1317 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1656 624 1673 1317 1673 1317 1656 1317 1628 633 1628 624 1656"/>
                        </Shape>
                        <String CONTENT="expression of the heroic tales."/>
                    </TextLine>
<TextLine ID="mz_1-110_l19" HPOS="728" VPOS="1673" WIDTH="1674" HEIGHT="61" BASELINE="730 1719 2402 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="730 1719 730 1734 2400 1729 2402 1714 2398 1684 1577 1673 1575 1673 1572 1673 1544 1686 728 1686 730 1719"/>
                        </Shape>
                        <String CONTENT="During certain seasons, especially with the coming of insects, the herd"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l20" HPOS="622" VPOS="1742" WIDTH="1778" HEIGHT="50" BASELINE="622 1777 2400 1777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1777 622 1792 2400 1792 2400 1777 2398 1742 622 1745 622 1777"/>
                        </Shape>
                        <String CONTENT="requires the utmost exertion of everybody in the camp, including girls and"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l21" HPOS="620" VPOS="1797" WIDTH="1780" HEIGHT="56" BASELINE="622 1838 2400 1831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1838 622 1853 2398 1846 2400 1831 2395 1803 730 1797 728 1797 620 1807 622 1838"/>
                        </Shape>
                        <String CONTENT="married women. The latter, though not very active, are able to relieve the"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l22" HPOS="620" VPOS="1855" WIDTH="1778" HEIGHT="59" BASELINE="622 1896 2398 1892" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 1896 622 1914 2395 1909 2398 1892 2393 1859 754 1855 752 1855 620 1866 622 1896"/>
                        </Shape>
                        <String CONTENT="men for a little while, so as to give them their much-needed rest. The herd"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l23" HPOS="624" VPOS="1922" WIDTH="1776" HEIGHT="59" BASELINE="624 1959 2400 1950" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 1959 624 1981 2398 1965 2400 1950 2393 1922 633 1929 624 1959"/>
                        </Shape>
                        <String CONTENT="will not stay on the same spot, even for a short time, but wants to move"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l24" HPOS="620" VPOS="1972" WIDTH="1778" HEIGHT="61" BASELINE="622 2017 2398 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 2017 622 2033 2395 2028 2398 2013 2395 1985 2361 1972 2359 1972 2356 1972 2354 1972 2322 1983 2235 1972 2233 1972 2164 1983 2027 1972 2025 1972 1969 1983 1932 1972 1930 1972 1928 1972 1785 1983 1663 1972 1661 1972 1659 1972 1657 1972 1642 1983 1568 1974 1566 1974 1494 1985 1473 1974 1471 1974 1468 1974 1466 1974 1438 1985 936 1974 934 1974 879 1985 823 1974 821 1974 749 1985 713 1974 710 1974 708 1974 620 1987 622 2017"/>
                        </Shape>
                        <String CONTENT="against the wind to find relief from insects. When stopping for a while, only"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l25" HPOS="620" VPOS="2030" WIDTH="1778" HEIGHT="65" BASELINE="622 2080 2398 2072" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="622 2080 622 2095 2395 2091 2398 2072 2393 2039 2138 2030 2135 2030 1923 2043 1893 2033 1891 2033 1889 2033 1886 2033 1858 2043 1817 2033 1815 2033 1813 2033 1811 2033 1785 2046 1607 2046 1520 2033 1518 2033 1516 2033 1514 2033 1499 2046 1365 2035 1362 2035 1291 2046 1256 2035 1254 2035 1252 2035 1154 2046 1120 2035 1118 2035 1115 2035 1016 2048 806 2037 804 2037 704 2048 641 2037 639 2037 637 2037 635 2037 620 2046 622 2080"/>
                        </Shape>
                        <String CONTENT="the centre of the herd stands quietly. The outer animals move swiftly around"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l26" HPOS="624" VPOS="2093" WIDTH="1771" HEIGHT="69" BASELINE="624 2139 2395 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2139 624 2152 879 2152 934 2162 936 2162 999 2152 2393 2152 2395 2132 2391 2104 1804 2093 1802 2093 1800 2093 1798 2093 1780 2104 1219 2095 1217 2095 1215 2095 1213 2095 1200 2106 637 2098 624 2139"/>
                        </Shape>
                        <String CONTENT="it — now from left to right, then from right to left — as if performing a"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l27" HPOS="624" VPOS="2154" WIDTH="1776" HEIGHT="60" BASELINE="624 2199 2400 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2199 624 2214 2398 2210 2400 2195 2395 2165 1512 2154 1510 2154 1507 2154 1471 2165 643 2156 641 2156 639 2156 637 2156 624 2199"/>
                        </Shape>
                        <String CONTENT="dance, and then suddenly dash forward against the breeze, carrying along the"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l28" HPOS="624" VPOS="2210" WIDTH="1771" HEIGHT="65" BASELINE="624 2260 2395 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2260 624 2275 2393 2271 2395 2251 2391 2223 2229 2223 2213 2210 2211 2210 2209 2210 2207 2210 2205 2210 2177 2221 2077 2210 2075 2210 1932 2223 1906 2212 1904 2212 1902 2212 1748 2223 1722 2212 1720 2212 1718 2212 1715 2212 1687 2223 1622 2212 1620 2212 1503 2225 665 2217 663 2217 661 2217 635 2225 624 2260"/>
                        </Shape>
                        <String CONTENT="whole herd. When the herdsmen are too few for regular watches, they may"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l29" HPOS="624" VPOS="2277" WIDTH="1774" HEIGHT="59" BASELINE="624 2321 2398 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2321 624 2336 2395 2327 2398 2312 2393 2284 1068 2277 1066 2277 1063 2277 1035 2288 689 2279 687 2279 633 2288 624 2321"/>
                        </Shape>
                        <String CONTENT="not get time to sleep for two or three days in succession, and often are so"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l30" HPOS="624" VPOS="2331" WIDTH="1771" HEIGHT="70" BASELINE="624 2379 2395 2372" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2379 624 2394 1802 2401 1804 2401 1806 2401 1841 2390 2393 2390 2395 2372 2393 2344 2348 2331 2346 2331 2343 2331 1971 2342 1934 2331 1932 2331 1930 2331 1802 2344 1759 2334 1756 2334 1754 2334 1752 2334 1720 2344 1566 2334 1564 2334 1494 2344 1464 2334 1462 2334 1460 2334 1293 2344 1241 2334 1239 2334 1237 2334 1209 2347 648 2336 646 2336 643 2336 641 2336 637 2336 624 2379"/>
                        </Shape>
                        <String CONTENT="tired that they drop to the ground and fall asleep against their will. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l31" HPOS="624" VPOS="2394" WIDTH="1776" HEIGHT="59" BASELINE="624 2437 2400 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2437 624 2453 2398 2448 2400 2433 2395 2405 1551 2394 1549 2394 1546 2394 1505 2405 739 2396 736 2396 633 2407 624 2437"/>
                        </Shape>
                        <String CONTENT="worst weather is a heavy warm fog without wind, because then the insects"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l32" HPOS="624" VPOS="2455" WIDTH="1774" HEIGHT="60" BASELINE="624 2498 2398 2492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2498 624 2515 2395 2509 2398 2492 2393 2463 1215 2455 1213 2455 1211 2455 1174 2466 819 2457 817 2457 633 2468 624 2498"/>
                        </Shape>
                        <String CONTENT="are most troublesome, and the herdsmen cannot watch the movements of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l33" HPOS="624" VPOS="2526" WIDTH="1774" HEIGHT="48" BASELINE="624 2557 2398 2557" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2557 624 2574 2398 2574 2398 2557 2398 2526 635 2526 624 2557"/>
                        </Shape>
                        <String CONTENT="distant animals. At such times a herd may easily be lost, if the herdsman"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l34" HPOS="624" VPOS="2572" WIDTH="1774" HEIGHT="58" BASELINE="624 2615 2398 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2615 624 2630 2395 2626 2398 2611 2393 2585 2285 2572 2283 2572 2281 2572 2257 2583 1687 2572 1685 2572 1683 2572 1653 2583 1594 2572 1592 2572 1481 2585 650 2574 648 2574 646 2574 635 2578 624 2615"/>
                        </Shape>
                        <String CONTENT="should fall asleep even for a moment. To find its tracks in summer is no"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l35" HPOS="624" VPOS="2645" WIDTH="1771" HEIGHT="50" BASELINE="624 2676 2395 2676" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2676 624 2695 2395 2695 2395 2676 2395 2645 635 2645 624 2676"/>
                        </Shape>
                        <String CONTENT="easy matter; and the reindeer may either disperse, small bands joining neigh-"/>
                    </TextLine>

                    <TextLine ID="mz_1-110_l36" HPOS="624" VPOS="2695" WIDTH="1776" HEIGHT="59" BASELINE="624 2736 2400 2736" TAGREFS="TYPE_5">
