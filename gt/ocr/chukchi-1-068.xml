                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l2" HPOS="713" VPOS="628" WIDTH="80" HEIGHT="71" BASELINE="715 677 793 673" TAGREFS="TYPE_4">
