                <TextBlock ID="mz_1-068_r2" HPOS="713" VPOS="734" WIDTH="1778" HEIGHT="964" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="713 734 2491 734 2491 1698 713 1698"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l3" HPOS="814" VPOS="740" WIDTH="1670" HEIGHT="61" BASELINE="817 779 2484 773" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2460 744 2439 742 2417 742 2395 742 2376 740 814 744 817 779 817 794 1925 801 1928 801 1930 801 1977 790 2482 790 2484 773 2478 744 2460 744"/>
                        </Shape>
                        <String CONTENT="Not all the Chukchee are of this irascible type. Some are quiet and"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l4" HPOS="708" VPOS="803" WIDTH="1776" HEIGHT="58" BASELINE="710 842 2484 833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 822 710 842 710 861 2482 848 2484 833 2478 803 708 809 708 822"/>
                        </Shape>
                        <String CONTENT="good-natured, often prone to loquaciousness and to giving reasons even for"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l5" HPOS="710" VPOS="855" WIDTH="1770" HEIGHT="60" BASELINE="713 900 2480 896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 874 713 900 713 915 2478 911 2480 896 2475 866 1605 855 1603 855 1601 855 1598 855 1585 866 741 857 739 857 736 857 715 866 710 874"/>
                        </Shape>
                        <String CONTENT="obvious things; but these also are not free from occasional outbursts of anger."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l6" HPOS="713" VPOS="918" WIDTH="1771" HEIGHT="58" BASELINE="715 961 2484 954" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 961 715 976 2482 970 2484 954 2480 924 732 918 730 918 728 918 726 918 713 924 715 961"/>
                        </Shape>
                        <String CONTENT="An old man named Aiñanwaˊt, who had lived with me for two years in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l7" HPOS="715" VPOS="983" WIDTH="1769" HEIGHT="52" BASELINE="715 1017 2484 1017" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1017 715 1035 2484 1035 2484 1017 2484 987 715 983 715 1017"/>
                        </Shape>
                        <String CONTENT="Kolyma country, and had patiently helped me the whole time even in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l8" HPOS="713" VPOS="1035" WIDTH="1765" HEIGHT="60" BASELINE="715 1080 2478 1073" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1080 715 1095 2475 1093 2478 1073 2473 1043 1302 1035 1300 1035 1232 1045 905 1037 903 1037 713 1048 715 1080"/>
                        </Shape>
                        <String CONTENT="most tedious ethnographical work, told me an incident of his former life."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l9" HPOS="713" VPOS="1104" WIDTH="1771" HEIGHT="50" BASELINE="715 1136 2484 1132" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1136 715 1154 2482 1149 2484 1132 2480 1104 713 1104 715 1136"/>
                        </Shape>
                        <String CONTENT="When vexed by the unruliness of his reindeer-herd, he so lost his patience"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l10" HPOS="710" VPOS="1167" WIDTH="1774" HEIGHT="49" BASELINE="710 1197 2484 1197" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1197 710 1214 2482 1216 2484 1197 2484 1167 710 1167 710 1197"/>
                        </Shape>
                        <String CONTENT="that he suddenly stopped running after the reindeer, and, turning to the setting"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l11" HPOS="710" VPOS="1214" WIDTH="1774" HEIGHT="59" BASELINE="713 1260 2484 1255" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1260 713 1273 2482 1268 2484 1255 2482 1227 2437 1214 2434 1214 2432 1214 2430 1214 2400 1225 1919 1214 1917 1214 1915 1214 1884 1225 1832 1214 1830 1214 1828 1214 1787 1225 1648 1214 1646 1214 1644 1214 1618 1225 1603 1214 1601 1214 1598 1214 1596 1214 1518 1227 838 1216 836 1216 834 1216 832 1216 817 1229 710 1229 713 1260"/>
                        </Shape>
                        <String CONTENT="sun, invited the wolves to come and devour the herd. According to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l12" HPOS="710" VPOS="1281" WIDTH="1772" HEIGHT="59" BASELINE="713 1314 2482 1318" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1314 710 1331 723 1340 726 1340 728 1340 730 1340 2480 1335 2482 1318 2480 1288 713 1281 713 1314"/>
                        </Shape>
                        <String CONTENT="belief of the Reindeer Chukchee, such words amount almost to a sacrilege;"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l13" HPOS="713" VPOS="1348" WIDTH="1769" HEIGHT="48" BASELINE="713 1379 2482 1379" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1379 713 1394 2480 1396 2482 1379 2482 1348 713 1348 713 1379"/>
                        </Shape>
                        <String CONTENT="since the wolves are classed with evil spirits, and the curse, once uttered aloud,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l14" HPOS="710" VPOS="1396" WIDTH="1774" HEIGHT="59" BASELINE="710 1437 2484 1437" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1437 710 1455 2484 1455 2484 1437 2484 1409 2395 1396 2393 1396 1594 1407 1520 1396 1518 1396 1516 1396 1514 1396 1497 1407 1468 1396 1466 1396 1464 1396 1462 1396 1460 1396 1445 1409 1328 1409 1274 1396 1271 1396 1269 1396 1267 1396 1252 1407 1159 1396 1157 1396 1035 1407 981 1396 979 1396 977 1396 975 1396 960 1409 710 1409 710 1437"/>
                        </Shape>
                        <String CONTENT="can never be revoked, because it becomes a promise of sacrifice. Within a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l15" HPOS="708" VPOS="1457" WIDTH="1776" HEIGHT="58" BASELINE="710 1498 2484 1491" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1498 710 1515 2482 1509 2484 1491 2480 1461 726 1457 723 1457 721 1457 719 1457 708 1463 710 1498"/>
                        </Shape>
                        <String CONTENT="few moments the exasperated herdsman realized what he had done, and tried"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l16" HPOS="710" VPOS="1517" WIDTH="1774" HEIGHT="57" BASELINE="713 1558 2484 1554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1558 713 1574 2482 1569 2484 1554 2480 1526 730 1517 728 1517 726 1517 723 1517 710 1524 713 1558"/>
                        </Shape>
                        <String CONTENT="to avoid the disastrous consequences by the sacrifice of his best team, but it"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l17" HPOS="713" VPOS="1574" WIDTH="1771" HEIGHT="60" BASELINE="715 1619 2484 1613" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1619 715 1634 2482 1628 2484 1613 2480 1582 1304 1574 1302 1574 1300 1574 1269 1584 864 1576 862 1576 713 1587 715 1619"/>
                        </Shape>
                        <String CONTENT="was of no avail. His luck had turned, and his herd suffered misfortune"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l18" HPOS="715" VPOS="1645" WIDTH="290" HEIGHT="48" BASELINE="715 1675 1005 1675" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1675 715 1693 1005 1693 1005 1675 1005 1645 715 1645 715 1675"/>
                        </Shape>
                        <String CONTENT="without end."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-068_r3" HPOS="713" VPOS="1698" WIDTH="1778" HEIGHT="836" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="713 1698 2491 1698 2491 2534 713 2534"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l19" HPOS="821" VPOS="1693" WIDTH="1663" HEIGHT="60" BASELINE="821 1736 2484 1736" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="821 1736 821 1753 2484 1753 2484 1736 2484 1706 2372 1693 2369 1693 2367 1693 2337 1704 2313 1693 2311 1693 2309 1693 2307 1693 2276 1704 2203 1693 2200 1693 2198 1693 2151 1706 1925 1706 1910 1693 1908 1693 1906 1693 1904 1693 1902 1693 1873 1704 1787 1693 1785 1693 1782 1693 1759 1704 1741 1693 1739 1693 1737 1693 1735 1693 1733 1693 1711 1704 1689 1693 1687 1693 1685 1693 1631 1704 1577 1693 1575 1693 1572 1693 1542 1704 1466 1693 1464 1693 821 1701 821 1736"/>
                        </Shape>
                        <String CONTENT="In addition to this irritability, the Chukchee shows a peculiar obstinacy"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l20" HPOS="708" VPOS="1760" WIDTH="1772" HEIGHT="58" BASELINE="710 1792 2480 1801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1792 708 1810 719 1818 721 1818 723 1818 726 1818 2478 1816 2480 1801 2478 1768 710 1760 710 1792"/>
                        </Shape>
                        <String CONTENT="in accomplishing whatever seems of momentary interest to him. In trading,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l21" HPOS="710" VPOS="1816" WIDTH="1772" HEIGHT="56" BASELINE="713 1855 2482 1851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1855 713 1872 2480 1870 2482 1851 2478 1825 752 1816 749 1816 747 1816 710 1827 713 1855"/>
                        </Shape>
                        <String CONTENT="when a Chukchee has set his heart on any trifling object, he is often ready"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l22" HPOS="713" VPOS="1875" WIDTH="1767" HEIGHT="62" BASELINE="713 1918 2480 1918" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1918 713 1931 2475 1937 2480 1918 2480 1885 2462 1875 2460 1875 2458 1875 2456 1875 2341 1885 1878 1875 1876 1875 1813 1885 1748 1875 1746 1875 1694 1885 1640 1875 1637 1875 1572 1885 1518 1875 1516 1875 1427 1885 1371 1875 1369 1875 1367 1875 1365 1875 1349 1888 1033 1888 929 1875 927 1875 925 1875 888 1885 823 1875 821 1875 713 1885 713 1918"/>
                        </Shape>
                        <String CONTENT="to offer thrice, or even ten times, the price of it. If his offer is not accepted,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l23" HPOS="713" VPOS="1933" WIDTH="1767" HEIGHT="61" BASELINE="713 1974 2480 1974" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1974 713 1994 2478 1994 2480 1974 2480 1944 2462 1933 2460 1933 2458 1933 2456 1933 2380 1944 2304 1933 2302 1933 2300 1933 2270 1946 2157 1946 2138 1933 2135 1933 2133 1933 2131 1933 2036 1946 1821 1946 1802 1933 1800 1933 1798 1933 1795 1933 1739 1944 1655 1933 1653 1933 1650 1933 1622 1944 1572 1933 1570 1933 1568 1933 1540 1944 1518 1933 1516 1933 1514 1933 1512 1933 1484 1944 1397 1933 1395 1933 1393 1933 1360 1944 1287 1933 1284 1933 1215 1944 1191 1933 1189 1933 1187 1933 1135 1944 1083 1933 1081 1933 1079 1933 1050 1944 713 1942 713 1974"/>
                        </Shape>
                        <String CONTENT="he will start a brawl rather than desist from his purpose of his own free will."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l24" HPOS="713" VPOS="1989" WIDTH="1771" HEIGHT="67" BASELINE="715 2037 2484 2030" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 2037 715 2056 2482 2050 2484 2030 2480 2002 2157 1989 2155 1989 2153 1989 2151 1989 2135 2002 2045 2002 2021 1989 2019 1989 2016 1989 1912 2000 1897 1989 1895 1989 1893 1989 1891 1989 1889 1989 1865 2002 1843 1991 1841 1991 1839 1991 1837 1991 1798 2002 1692 1991 1579 1991 1577 1991 1575 1991 1572 1991 1555 2002 1455 1991 1453 1991 1302 2004 1237 1994 1235 1994 1141 2004 1076 1994 1074 1994 1072 1994 1042 2004 996 1994 994 1994 992 1994 713 2000 715 2037"/>
                        </Shape>
                        <String CONTENT="The small Russian traders sometimes skilfully avail themselves of this weakness"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l25" HPOS="708" VPOS="2052" WIDTH="1776" HEIGHT="63" BASELINE="710 2095 2484 2091" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2095 710 2115 2482 2111 2484 2091 2480 2063 1627 2052 1624 2052 1622 2052 1585 2065 708 2065 710 2095"/>
                        </Shape>
                        <String CONTENT="by goading their wild customers on, and then withholding the article, in order"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l26" HPOS="710" VPOS="2128" WIDTH="1774" HEIGHT="54" BASELINE="710 2156 2484 2156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2156 710 2169 795 2182 797 2182 877 2171 1014 2182 1016 2182 1094 2171 1115 2182 1118 2182 1120 2182 1235 2171 1739 2182 1741 2182 2484 2169 2484 2156 2484 2128 710 2128 710 2156"/>
                        </Shape>
                        <String CONTENT="to get a larger price for it. In a wrestling-match the defeated competitor"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l27" HPOS="710" VPOS="2175" WIDTH="1772" HEIGHT="59" BASELINE="713 2217 2482 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2217 713 2234 2480 2230 2482 2212 2478 2184 752 2175 749 2175 747 2175 710 2186 713 2217"/>
                        </Shape>
                        <String CONTENT="will again and again try his luck, though repeatedly thrown, until at last a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l28" HPOS="708" VPOS="2232" WIDTH="1774" HEIGHT="60" BASELINE="710 2277 2482 2273" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2277 710 2292 2480 2288 2482 2273 2478 2245 1917 2232 1915 2232 1863 2243 1834 2232 1832 2232 1830 2232 1828 2232 1826 2232 1806 2243 1518 2234 1516 2234 1514 2234 1481 2245 1447 2234 1445 2234 1442 2234 1440 2234 1438 2234 1423 2245 1395 2234 1393 2234 1391 2234 1319 2245 1239 2234 1237 2234 1235 2234 1187 2245 1055 2234 1053 2234 1050 2234 1048 2234 1033 2247 827 2247 726 2234 723 2234 721 2234 719 2234 708 2240 710 2277"/>
                        </Shape>
                        <String CONTENT="fight ensues. When thwarted in his purpose, the Chukchee is ready to go"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l29" HPOS="713" VPOS="2305" WIDTH="1769" HEIGHT="48" BASELINE="713 2336 2482 2336" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2336 713 2353 2482 2353 2482 2336 2482 2305 713 2305 713 2336"/>
                        </Shape>
                        <String CONTENT="to any extreme, even to committing suicide, from uncontrollable rage. I know"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l30" HPOS="710" VPOS="2362" WIDTH="1772" HEIGHT="56" BASELINE="713 2392 2482 2396" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2392 710 2409 721 2418 723 2418 726 2418 728 2418 2480 2409 2482 2396 2480 2366 713 2362 713 2392"/>
                        </Shape>
                        <String CONTENT="an instance of a young girl who went out to the herd and hung herself to a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l31" HPOS="713" VPOS="2424" WIDTH="1771" HEIGHT="48" BASELINE="713 2455 2484 2455" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2455 713 2472 2484 2472 2484 2455 2484 2424 713 2424 713 2455"/>
                        </Shape>
                        <String CONTENT="tree, out of anger because her mother refused to take her along to the feast"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l32" HPOS="713" VPOS="2485" WIDTH="539" HEIGHT="56" BASELINE="713 2513 1252 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2513 713 2528 899 2541 901 2541 1252 2533 1252 2513 1252 2485 713 2485 713 2513"/>
                        </Shape>
                        <String CONTENT="in a neighboring camp."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-068_r4" HPOS="713" VPOS="2534" WIDTH="1778" HEIGHT="732" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="713 2534 2491 2534 2491 3266 713 3266"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l33" HPOS="821" VPOS="2539" WIDTH="1663" HEIGHT="52" BASELINE="823 2574 2484 2570" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="823 2574 823 2591 2482 2587 2484 2570 2480 2541 821 2539 823 2574"/>
                        </Shape>
                        <String CONTENT="This motive frequently plays a part even in cases of voluntary death"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l34" HPOS="710" VPOS="2604" WIDTH="1774" HEIGHT="46" BASELINE="710 2632 2484 2632" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2632 710 2650 2484 2650 2484 2632 2484 2604 710 2604 710 2632"/>
                        </Shape>
                        <String CONTENT="among old men, of which I shall speak later on. Thus in one of the texts"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l35" HPOS="710" VPOS="2650" WIDTH="1772" HEIGHT="65" BASELINE="713 2693 2482 2697" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2693 710 2712 2478 2715 2482 2697 2480 2665 2417 2652 2415 2652 2207 2663 2159 2652 2157 2652 2155 2652 2153 2652 2151 2652 2135 2663 2027 2652 2025 2652 2023 2652 2021 2652 2006 2665 1811 2665 1787 2652 1785 2652 1782 2652 1687 2663 1585 2650 1583 2650 1516 2660 1455 2650 1453 2650 1388 2660 1310 2650 1308 2650 1306 2650 1280 2660 1267 2650 1265 2650 1263 2650 1261 2650 713 2658 713 2693"/>
                        </Shape>
                        <String CONTENT="published in my “Chukchee Materials” (p. 52), a man, Little-Spoon, having"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l36" HPOS="710" VPOS="2721" WIDTH="1772" HEIGHT="52" BASELINE="713 2756 2482 2751" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2756 713 2773 2480 2771 2482 2751 2478 2721 710 2721 713 2756"/>
                        </Shape>
                        <String CONTENT="been angered by his sons, requested that he be killed. The Chukchee frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l37" HPOS="710" VPOS="2777" WIDTH="1774" HEIGHT="52" BASELINE="713 2812 2484 2816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2812 710 2825 2480 2829 2484 2816 2482 2784 713 2777 713 2812"/>
                        </Shape>
                        <String CONTENT="have a lurking inclination towards suicide, which is mentioned in the words"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l38" HPOS="713" VPOS="2844" WIDTH="1771" HEIGHT="48" BASELINE="713 2875 2484 2875" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2875 713 2892 2484 2892 2484 2875 2484 2844 713 2844 713 2875"/>
                        </Shape>
                        <String CONTENT="of Lotteri previously quoted, and is well known even to the Chukchee them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l39" HPOS="710" VPOS="2894" WIDTH="1772" HEIGHT="57" BASELINE="713 2935 2482 2931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 2935 713 2948 2478 2951 2482 2931 2478 2903 756 2894 754 2894 752 2894 710 2905 713 2935"/>
                        </Shape>
                        <String CONTENT="selves. “You know our people,” I was told on several occasions. “For any"/>
                    </TextLine>

