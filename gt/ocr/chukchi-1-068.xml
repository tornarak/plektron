                    </Shape>
                    <TextLine ID="mz_1-068_l1" HPOS="1308" VPOS="649" WIDTH="619" HEIGHT="54" BASELINE="1310 684 1927 679" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1914 649 1308 651 1310 684 1310 703 1925 699 1927 679 1925 677 1914 649"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l2" HPOS="734" VPOS="643" WIDTH="80" HEIGHT="71" BASELINE="736 692 814 688" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 692 736 703 766 714 768 714 770 714 773 714 814 699 814 688 809 651 796 643 794 643 792 643 790 643 788 643 734 658 736 692"/>
                        </Shape>
                        <String CONTENT="46"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-068_r2" HPOS="734" VPOS="749" WIDTH="1778" HEIGHT="964" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="734 749 2512 749 2512 1713 734 1713"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l3" HPOS="835" VPOS="755" WIDTH="1670" HEIGHT="61" BASELINE="838 794 2505 788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2481 759 2460 757 2438 757 2416 757 2397 755 835 759 838 794 838 809 1946 816 1949 816 1951 816 1998 805 2503 805 2505 788 2499 759 2481 759"/>
                        </Shape>
                        <String CONTENT="Not all the Chukchee are of this irascible type. Some are quiet and"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l4" HPOS="729" VPOS="818" WIDTH="1776" HEIGHT="58" BASELINE="731 857 2505 848" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 837 731 857 731 876 2503 863 2505 848 2499 818 729 824 729 837"/>
                        </Shape>
                        <String CONTENT="good-natured, often prone to loquaciousness and to giving reasons even for"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l5" HPOS="731" VPOS="870" WIDTH="1770" HEIGHT="60" BASELINE="734 915 2501 911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 889 734 915 734 930 2499 926 2501 911 2496 881 1626 870 1624 870 1622 870 1619 870 1606 881 762 872 760 872 757 872 736 881 731 889"/>
                        </Shape>
                        <String CONTENT="obvious things; but these also are not free from occasional outbursts of anger."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l6" HPOS="734" VPOS="933" WIDTH="1771" HEIGHT="58" BASELINE="736 976 2505 969" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 976 736 991 2503 985 2505 969 2501 939 753 933 751 933 749 933 747 933 734 939 736 976"/>
                        </Shape>
                        <String CONTENT="An old man named Aiñanwaˊt, who had lived with me for two years in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l7" HPOS="736" VPOS="998" WIDTH="1769" HEIGHT="52" BASELINE="736 1032 2505 1032" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1032 736 1050 2505 1050 2505 1032 2505 1002 736 998 736 1032"/>
                        </Shape>
                        <String CONTENT="Kolyma country, and had patiently helped me the whole time even in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l8" HPOS="734" VPOS="1050" WIDTH="1765" HEIGHT="60" BASELINE="736 1095 2499 1088" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1095 736 1110 2496 1108 2499 1088 2494 1058 1323 1050 1321 1050 1253 1060 926 1052 924 1052 734 1063 736 1095"/>
                        </Shape>
                        <String CONTENT="most tedious ethnographical work, told me an incident of his former life."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l9" HPOS="734" VPOS="1119" WIDTH="1771" HEIGHT="50" BASELINE="736 1151 2505 1147" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1151 736 1169 2503 1164 2505 1147 2501 1119 734 1119 736 1151"/>
                        </Shape>
                        <String CONTENT="When vexed by the unruliness of his reindeer-herd, he so lost his patience"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l10" HPOS="731" VPOS="1182" WIDTH="1774" HEIGHT="49" BASELINE="731 1212 2505 1212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1212 731 1229 2503 1231 2505 1212 2505 1182 731 1182 731 1212"/>
                        </Shape>
                        <String CONTENT="that he suddenly stopped running after the reindeer, and, turning to the setting"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l11" HPOS="731" VPOS="1229" WIDTH="1774" HEIGHT="59" BASELINE="734 1275 2505 1270" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1275 734 1288 2503 1283 2505 1270 2503 1242 2458 1229 2455 1229 2453 1229 2451 1229 2421 1240 1940 1229 1938 1229 1936 1229 1905 1240 1853 1229 1851 1229 1849 1229 1808 1240 1669 1229 1667 1229 1665 1229 1639 1240 1624 1229 1622 1229 1619 1229 1617 1229 1539 1242 859 1231 857 1231 855 1231 853 1231 838 1244 731 1244 734 1275"/>
                        </Shape>
                        <String CONTENT="sun, invited the wolves to come and devour the herd. According to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l12" HPOS="731" VPOS="1296" WIDTH="1772" HEIGHT="59" BASELINE="734 1329 2503 1333" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1329 731 1346 744 1355 747 1355 749 1355 751 1355 2501 1350 2503 1333 2501 1303 734 1296 734 1329"/>
                        </Shape>
                        <String CONTENT="belief of the Reindeer Chukchee, such words amount almost to a sacrilege;"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l13" HPOS="734" VPOS="1363" WIDTH="1769" HEIGHT="48" BASELINE="734 1394 2503 1394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1394 734 1409 2501 1411 2503 1394 2503 1363 734 1363 734 1394"/>
                        </Shape>
                        <String CONTENT="since the wolves are classed with evil spirits, and the curse, once uttered aloud,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l14" HPOS="731" VPOS="1411" WIDTH="1774" HEIGHT="59" BASELINE="731 1452 2505 1452" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1452 731 1470 2505 1470 2505 1452 2505 1424 2416 1411 2414 1411 1615 1422 1541 1411 1539 1411 1537 1411 1535 1411 1518 1422 1489 1411 1487 1411 1485 1411 1483 1411 1481 1411 1466 1424 1349 1424 1295 1411 1292 1411 1290 1411 1288 1411 1273 1422 1180 1411 1178 1411 1056 1422 1002 1411 1000 1411 998 1411 996 1411 981 1424 731 1424 731 1452"/>
                        </Shape>
                        <String CONTENT="can never be revoked, because it becomes a promise of sacrifice. Within a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l15" HPOS="729" VPOS="1472" WIDTH="1776" HEIGHT="58" BASELINE="731 1513 2505 1506" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1513 731 1530 2503 1524 2505 1506 2501 1476 747 1472 744 1472 742 1472 740 1472 729 1478 731 1513"/>
                        </Shape>
                        <String CONTENT="few moments the exasperated herdsman realized what he had done, and tried"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l16" HPOS="731" VPOS="1532" WIDTH="1774" HEIGHT="57" BASELINE="734 1573 2505 1569" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1573 734 1589 2503 1584 2505 1569 2501 1541 751 1532 749 1532 747 1532 744 1532 731 1539 734 1573"/>
                        </Shape>
                        <String CONTENT="to avoid the disastrous consequences by the sacrifice of his best team, but it"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l17" HPOS="734" VPOS="1589" WIDTH="1771" HEIGHT="60" BASELINE="736 1634 2505 1628" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1634 736 1649 2503 1643 2505 1628 2501 1597 1325 1589 1323 1589 1321 1589 1290 1599 885 1591 883 1591 734 1602 736 1634"/>
                        </Shape>
                        <String CONTENT="was of no avail. His luck had turned, and his herd suffered misfortune"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l18" HPOS="736" VPOS="1660" WIDTH="290" HEIGHT="48" BASELINE="736 1690 1026 1690" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1690 736 1708 1026 1708 1026 1690 1026 1660 736 1660 736 1690"/>
                        </Shape>
                        <String CONTENT="without end."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-068_r3" HPOS="734" VPOS="1713" WIDTH="1778" HEIGHT="836" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="734 1713 2512 1713 2512 2549 734 2549"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l19" HPOS="842" VPOS="1708" WIDTH="1663" HEIGHT="60" BASELINE="842 1751 2505 1751" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="842 1751 842 1768 2505 1768 2505 1751 2505 1721 2393 1708 2390 1708 2388 1708 2358 1719 2334 1708 2332 1708 2330 1708 2328 1708 2297 1719 2224 1708 2221 1708 2219 1708 2172 1721 1946 1721 1931 1708 1929 1708 1927 1708 1925 1708 1923 1708 1894 1719 1808 1708 1806 1708 1803 1708 1780 1719 1762 1708 1760 1708 1758 1708 1756 1708 1754 1708 1732 1719 1710 1708 1708 1708 1706 1708 1652 1719 1598 1708 1596 1708 1593 1708 1563 1719 1487 1708 1485 1708 842 1716 842 1751"/>
                        </Shape>
                        <String CONTENT="In addition to this irritability, the Chukchee shows a peculiar obstinacy"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l20" HPOS="729" VPOS="1775" WIDTH="1772" HEIGHT="58" BASELINE="731 1807 2501 1816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1807 729 1825 740 1833 742 1833 744 1833 747 1833 2499 1831 2501 1816 2499 1783 731 1775 731 1807"/>
                        </Shape>
                        <String CONTENT="in accomplishing whatever seems of momentary interest to him. In trading,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l21" HPOS="731" VPOS="1831" WIDTH="1772" HEIGHT="56" BASELINE="734 1870 2503 1866" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1870 734 1887 2501 1885 2503 1866 2499 1840 773 1831 770 1831 768 1831 731 1842 734 1870"/>
                        </Shape>
                        <String CONTENT="when a Chukchee has set his heart on any trifling object, he is often ready"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l22" HPOS="734" VPOS="1890" WIDTH="1767" HEIGHT="62" BASELINE="734 1933 2501 1933" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1933 734 1946 2496 1952 2501 1933 2501 1900 2483 1890 2481 1890 2479 1890 2477 1890 2362 1900 1899 1890 1897 1890 1834 1900 1769 1890 1767 1890 1715 1900 1661 1890 1658 1890 1593 1900 1539 1890 1537 1890 1448 1900 1392 1890 1390 1890 1388 1890 1386 1890 1370 1903 1054 1903 950 1890 948 1890 946 1890 909 1900 844 1890 842 1890 734 1900 734 1933"/>
                        </Shape>
                        <String CONTENT="to offer thrice, or even ten times, the price of it. If his offer is not accepted,"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l23" HPOS="734" VPOS="1948" WIDTH="1767" HEIGHT="61" BASELINE="734 1989 2501 1989" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1989 734 2009 2499 2009 2501 1989 2501 1959 2483 1948 2481 1948 2479 1948 2477 1948 2401 1959 2325 1948 2323 1948 2321 1948 2291 1961 2178 1961 2159 1948 2156 1948 2154 1948 2152 1948 2057 1961 1842 1961 1823 1948 1821 1948 1819 1948 1816 1948 1760 1959 1676 1948 1674 1948 1671 1948 1643 1959 1593 1948 1591 1948 1589 1948 1561 1959 1539 1948 1537 1948 1535 1948 1533 1948 1505 1959 1418 1948 1416 1948 1414 1948 1381 1959 1308 1948 1305 1948 1236 1959 1212 1948 1210 1948 1208 1948 1156 1959 1104 1948 1102 1948 1100 1948 1071 1959 734 1957 734 1989"/>
                        </Shape>
                        <String CONTENT="he will start a brawl rather than desist from his purpose of his own free will."/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l24" HPOS="734" VPOS="2004" WIDTH="1771" HEIGHT="67" BASELINE="736 2052 2505 2045" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 2052 736 2071 2503 2065 2505 2045 2501 2017 2178 2004 2176 2004 2174 2004 2172 2004 2156 2017 2066 2017 2042 2004 2040 2004 2037 2004 1933 2015 1918 2004 1916 2004 1914 2004 1912 2004 1910 2004 1886 2017 1864 2006 1862 2006 1860 2006 1858 2006 1819 2017 1713 2006 1600 2006 1598 2006 1596 2006 1593 2006 1576 2017 1476 2006 1474 2006 1323 2019 1258 2009 1256 2009 1162 2019 1097 2009 1095 2009 1093 2009 1063 2019 1017 2009 1015 2009 1013 2009 734 2015 736 2052"/>
                        </Shape>
                        <String CONTENT="The small Russian traders sometimes skilfully avail themselves of this weakness"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l25" HPOS="729" VPOS="2067" WIDTH="1776" HEIGHT="63" BASELINE="731 2110 2505 2106" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2110 731 2130 2503 2126 2505 2106 2501 2078 1648 2067 1645 2067 1643 2067 1606 2080 729 2080 731 2110"/>
                        </Shape>
                        <String CONTENT="by goading their wild customers on, and then withholding the article, in order"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l26" HPOS="731" VPOS="2143" WIDTH="1774" HEIGHT="54" BASELINE="731 2171 2505 2171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2171 731 2184 816 2197 818 2197 898 2186 1035 2197 1037 2197 1115 2186 1136 2197 1139 2197 1141 2197 1256 2186 1760 2197 1762 2197 2505 2184 2505 2171 2505 2143 731 2143 731 2171"/>
                        </Shape>
                        <String CONTENT="to get a larger price for it. In a wrestling-match the defeated competitor"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l27" HPOS="731" VPOS="2190" WIDTH="1772" HEIGHT="59" BASELINE="734 2232 2503 2227" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2232 734 2249 2501 2245 2503 2227 2499 2199 773 2190 770 2190 768 2190 731 2201 734 2232"/>
                        </Shape>
                        <String CONTENT="will again and again try his luck, though repeatedly thrown, until at last a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l28" HPOS="729" VPOS="2247" WIDTH="1774" HEIGHT="60" BASELINE="731 2292 2503 2288" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2292 731 2307 2501 2303 2503 2288 2499 2260 1938 2247 1936 2247 1884 2258 1855 2247 1853 2247 1851 2247 1849 2247 1847 2247 1827 2258 1539 2249 1537 2249 1535 2249 1502 2260 1468 2249 1466 2249 1463 2249 1461 2249 1459 2249 1444 2260 1416 2249 1414 2249 1412 2249 1340 2260 1260 2249 1258 2249 1256 2249 1208 2260 1076 2249 1074 2249 1071 2249 1069 2249 1054 2262 848 2262 747 2249 744 2249 742 2249 740 2249 729 2255 731 2292"/>
                        </Shape>
                        <String CONTENT="fight ensues. When thwarted in his purpose, the Chukchee is ready to go"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l29" HPOS="734" VPOS="2320" WIDTH="1769" HEIGHT="48" BASELINE="734 2351 2503 2351" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2351 734 2368 2503 2368 2503 2351 2503 2320 734 2320 734 2351"/>
                        </Shape>
                        <String CONTENT="to any extreme, even to committing suicide, from uncontrollable rage. I know"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l30" HPOS="731" VPOS="2377" WIDTH="1772" HEIGHT="56" BASELINE="734 2407 2503 2411" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2407 731 2424 742 2433 744 2433 747 2433 749 2433 2501 2424 2503 2411 2501 2381 734 2377 734 2407"/>
                        </Shape>
                        <String CONTENT="an instance of a young girl who went out to the herd and hung herself to a"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l31" HPOS="734" VPOS="2439" WIDTH="1771" HEIGHT="48" BASELINE="734 2470 2505 2470" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2470 734 2487 2505 2487 2505 2470 2505 2439 734 2439 734 2470"/>
                        </Shape>
                        <String CONTENT="tree, out of anger because her mother refused to take her along to the feast"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l32" HPOS="734" VPOS="2500" WIDTH="539" HEIGHT="56" BASELINE="734 2528 1273 2528" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2528 734 2543 920 2556 922 2556 1273 2548 1273 2528 1273 2500 734 2500 734 2528"/>
                        </Shape>
                        <String CONTENT="in a neighboring camp."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-068_r4" HPOS="734" VPOS="2549" WIDTH="1778" HEIGHT="732" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="734 2549 2512 2549 2512 3281 734 3281"/>
                    </Shape>
                    <TextLine ID="mz_1-068_l33" HPOS="842" VPOS="2554" WIDTH="1663" HEIGHT="52" BASELINE="844 2589 2505 2585" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="844 2589 844 2606 2503 2602 2505 2585 2501 2556 842 2554 844 2589"/>
                        </Shape>
                        <String CONTENT="This motive frequently plays a part even in cases of voluntary death"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l34" HPOS="731" VPOS="2619" WIDTH="1774" HEIGHT="46" BASELINE="731 2647 2505 2647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2647 731 2665 2505 2665 2505 2647 2505 2619 731 2619 731 2647"/>
                        </Shape>
                        <String CONTENT="among old men, of which I shall speak later on. Thus in one of the texts"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l35" HPOS="731" VPOS="2665" WIDTH="1772" HEIGHT="65" BASELINE="734 2708 2503 2712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2708 731 2727 2499 2730 2503 2712 2501 2680 2438 2667 2436 2667 2228 2678 2180 2667 2178 2667 2176 2667 2174 2667 2172 2667 2156 2678 2048 2667 2046 2667 2044 2667 2042 2667 2027 2680 1832 2680 1808 2667 1806 2667 1803 2667 1708 2678 1606 2665 1604 2665 1537 2675 1476 2665 1474 2665 1409 2675 1331 2665 1329 2665 1327 2665 1301 2675 1288 2665 1286 2665 1284 2665 1282 2665 734 2673 734 2708"/>
                        </Shape>
                        <String CONTENT="published in my “Chukchee Materials” (p. 52), a man, Little-Spoon, having"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l36" HPOS="731" VPOS="2736" WIDTH="1772" HEIGHT="52" BASELINE="734 2771 2503 2766" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2771 734 2788 2501 2786 2503 2766 2499 2736 731 2736 734 2771"/>
                        </Shape>
                        <String CONTENT="been angered by his sons, requested that he be killed. The Chukchee frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l37" HPOS="731" VPOS="2792" WIDTH="1774" HEIGHT="52" BASELINE="734 2827 2505 2831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2827 731 2840 2501 2844 2505 2831 2503 2799 734 2792 734 2827"/>
                        </Shape>
                        <String CONTENT="have a lurking inclination towards suicide, which is mentioned in the words"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l38" HPOS="734" VPOS="2859" WIDTH="1771" HEIGHT="48" BASELINE="734 2890 2505 2890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2890 734 2907 2505 2907 2505 2890 2505 2859 734 2859 734 2890"/>
                        </Shape>
                        <String CONTENT="of Lotteri previously quoted, and is well known even to the Chukchee them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-068_l39" HPOS="731" VPOS="2909" WIDTH="1772" HEIGHT="57" BASELINE="734 2950 2503 2946" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 2950 734 2963 2499 2966 2503 2946 2499 2918 777 2909 775 2909 773 2909 731 2920 734 2950"/>
                        </Shape>
                        <String CONTENT="selves. “You know our people,” I was told on several occasions. “For any"/>
                    </TextLine>

