                        <Shape>
                            <Polygon POINTS="479 1584 479 1602 2142 1602 2142 1584 2135 1545 2129 1541 2127 1541 2125 1541 2122 1541 2120 1541 2094 1552 2060 1541 2058 1541 2055 1541 2053 1541 2008 1554 1912 1554 1899 1541 1897 1541 1895 1541 1893 1541 1891 1541 1865 1552 1850 1541 1847 1541 1845 1541 1843 1541 1841 1541 1808 1552 1795 1541 1793 1541 1791 1541 1789 1541 1739 1552 1694 1541 1692 1541 1689 1541 1687 1541 1657 1552 1564 1541 1562 1541 1468 1554 1315 1554 1295 1541 1293 1541 1291 1541 1289 1541 1187 1554 1057 1554 1042 1541 1040 1541 1038 1541 1035 1541 964 1554 810 1554 795 1541 793 1541 791 1541 788 1541 786 1541 749 1552 479 1550 479 1584"/>
                        </Shape>
                        <String CONTENT="SEASONS. — It may not be out of place to add here the Chukchee method"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l18" HPOS="373" VPOS="1606" WIDTH="1760" HEIGHT="54" BASELINE="373 1643 2133 1643" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 1643 373 1660 2133 1660 2133 1643 2131 1606 373 1610 373 1643"/>
                        </Shape>
                        <String CONTENT="of dividing the year. The year is divided into twelve lunar months or “moons”"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l19" HPOS="370" VPOS="1669" WIDTH="1770" HEIGHT="60" BASELINE="373 1701 2140 1706" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 1701 370 1719 1451 1719 1629 1729 1631 1729 1633 1729 1655 1719 1676 1729 1679 1729 1681 1729 1737 1719 2138 1719 2140 1706 2140 1673 373 1669 373 1701"/>
                        </Shape>
                        <String CONTENT="(yiˊᵋlhɪn). The series begins with the winter solstice, the time of which is"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l20" HPOS="373" VPOS="1729" WIDTH="1767" HEIGHT="59" BASELINE="375 1760 2140 1764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1760 373 1779 381 1786 383 1786 386 1786 388 1786 1235 1777 1254 1788 1256 1788 1258 1788 1261 1788 2138 1777 2140 1764 2140 1729 375 1729 375 1760"/>
                        </Shape>
                        <String CONTENT="marked pretty accurately. The dark interval between two “moons” is called"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l21" HPOS="386" VPOS="1786" WIDTH="1347" HEIGHT="63" BASELINE="386 1820 1733 1820" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="386 1820 386 1838 741 1838 754 1849 756 1849 758 1849 760 1849 832 1838 886 1849 888 1849 890 1849 929 1838 1191 1849 1193 1849 1196 1849 1228 1838 1258 1849 1261 1849 1263 1849 1265 1849 1295 1838 1321 1849 1323 1849 1326 1849 1391 1838 1455 1849 1458 1849 1733 1836 1733 1820 1733 1792 386 1786 386 1820"/>
                        </Shape>
                        <String CONTENT="“moon interval” (yuˊᵋtir). The names of the months are —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-073_r5" HPOS="370" VPOS="1866" WIDTH="1778" HEIGHT="775" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="370 1866 2148 1866 2148 2641 370 2641"/>
                    </Shape>
                    <TextLine ID="mz_1-073_l22" HPOS="390" VPOS="1875" WIDTH="1745" HEIGHT="54" BASELINE="392 1905 2135 1911" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="392 1905 390 1922 2131 1929 2135 1911 2133 1881 392 1875 392 1905"/>
                        </Shape>
                        <String CONTENT="1. ɪnp-luˊwleñ-yiˊᵋlhɪn (“old-buck month”), from about the 20th of December to the 20th of January."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l23" HPOS="494" VPOS="1927" WIDTH="665" HEIGHT="43" BASELINE="496 1955 1159 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="496 1955 496 1970 1157 1968 1159 1952 1152 1927 494 1927 496 1955"/>
                        </Shape>
                        <String CONTENT="The origin of the name is uncertain."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l24" HPOS="392" VPOS="1959" WIDTH="734" HEIGHT="67" BASELINE="394 2002 1126 1998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2002 394 2015 1098 2026 1100 2026 1102 2026 1105 2026 1126 2013 1126 1998 1122 1970 771 1959 769 1959 767 1959 765 1959 752 1970 459 1961 457 1961 392 1972 394 2002"/>
                        </Shape>
                        <String CONTENT="2. Čačanloˊrg̣ɪn (“cold udder [month]”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l25" HPOS="405" VPOS="2015" WIDTH="760" HEIGHT="52" BASELINE="407 2048 1165 2050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 2048 405 2067 1163 2063 1165 2050 1163 2017 407 2015 407 2048"/>
                        </Shape>
                        <String CONTENT="3. Lêˊê-loˊrg̣ɪn (“genuine udder [month]”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l26" HPOS="396" VPOS="2054" WIDTH="616" HEIGHT="57" BASELINE="399 2098 1012 2093" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="399 2098 399 2111 1009 2106 1012 2093 1007 2065 702 2054 700 2054 697 2054 669 2065 466 2056 464 2056 396 2067 399 2098"/>
                        </Shape>
                        <String CONTENT="4. G̣roˊ-êˊᵋlhɪn (“calving month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l27" HPOS="448" VPOS="2108" WIDTH="518" HEIGHT="50" BASELINE="451 2141 966 2137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 2141 451 2158 964 2156 966 2137 960 2108 448 2111 451 2141"/>
                        </Shape>
                        <String CONTENT="5. Imlɪˊrɪlɪn (“water [month]”)."/>
