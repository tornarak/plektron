                        </Shape>
                        <String CONTENT="(yiˊᵋlhɪn). The series begins with the winter solstice, the time of which is"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l20" HPOS="394" VPOS="1744" WIDTH="1767" HEIGHT="59" BASELINE="396 1775 2161 1779" TAGREFS="TYPE_5">
                        <Shape>
