                            <Polygon POINTS="415 2017 415 2030 1119 2041 1121 2041 1123 2041 1126 2041 1147 2028 1147 2013 1143 1985 792 1974 790 1974 788 1974 786 1974 773 1985 480 1976 478 1976 413 1987 415 2017"/>
                        </Shape>
                        <String CONTENT="2. Čačanloˊrg̣ɪn (“cold udder [month]”)."/>
                    </TextLine>

