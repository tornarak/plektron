                    <TextLine ID="mz_1-073_l9" HPOS="479" VPOS="1067" WIDTH="1659" HEIGHT="56" BASELINE="479 1104 2138 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 1104 479 1123 2138 1123 2138 1104 2133 1071 479 1067 479 1104"/>
                        </Shape>
                        <String CONTENT="The Rev. Argentoff relates that one Maiˊñɪ-qlaˊul, a rich reindeer-breeder"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l10" HPOS="370" VPOS="1134" WIDTH="1765" HEIGHT="52" BASELINE="370 1164 2135 1164" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1164 370 1180 2133 1186 2135 1164 2135 1134 370 1134 370 1164"/>
                        </Shape>
                        <String CONTENT="from the Dry Anui, tried to ascertain the number of his animals by counting"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l11" HPOS="370" VPOS="1195" WIDTH="1768" HEIGHT="47" BASELINE="370 1225 2138 1225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1225 370 1242 2135 1242 2138 1225 2129 1195 370 1195 370 1225"/>
                        </Shape>
                        <String CONTENT="them by corrals. Each corralful was represented by a chip of wood, and these"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l12" HPOS="373" VPOS="1251" WIDTH="1765" HEIGHT="61" BASELINE="373 1286 2138 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 1286 373 1301 485 1301 500 1312 503 1312 505 1312 507 1312 654 1301 719 1312 721 1312 866 1301 1003 1301 1018 1312 1020 1312 1022 1312 1025 1312 1163 1301 1263 1312 1265 1312 2138 1299 2138 1286 2131 1251 373 1253 373 1286"/>
                        </Shape>
                        <String CONTENT="were placed together in a glove.² Operations of this kind were performed"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l13" HPOS="370" VPOS="1309" WIDTH="1768" HEIGHT="52" BASELINE="370 1344 2138 1344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1344 370 1361 2135 1361 2138 1344 2129 1314 370 1309 370 1344"/>
                        </Shape>
                        <String CONTENT="by the rich Tungus for the same purpose; but among the Chukchee they can"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l14" HPOS="368" VPOS="1372" WIDTH="1770" HEIGHT="59" BASELINE="370 1405 2138 1400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1405 370 1420 947 1431 949 1431 951 1431 953 1431 970 1420 2135 1420 2138 1400 2129 1372 368 1374 370 1405"/>
                        </Shape>
                        <String CONTENT="occur only exceptionally, because every new experiment with the herd is"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l15" HPOS="368" VPOS="1420" WIDTH="1770" HEIGHT="71" BASELINE="370 1465 2138 1461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1465 370 1481 938 1481 983 1491 986 1491 988 1491 1053 1481 1180 1491 1183 1491 1185 1491 1226 1481 1248 1491 1250 1491 1252 1491 1432 1489 1434 1489 1436 1489 1451 1478 1672 1478 1709 1489 1711 1489 1713 1489 2135 1478 2138 1461 2129 1431 2086 1420 2084 1420 2081 1420 2079 1420 2058 1431 1912 1420 1910 1420 1908 1420 1906 1420 1891 1433 1754 1433 1735 1420 1733 1420 1731 1420 1728 1420 1611 1431 1529 1420 1527 1420 1525 1420 1503 1431 1468 1420 1466 1420 1464 1420 1462 1420 1421 1431 1252 1420 1250 1420 1248 1420 1245 1420 1230 1433 1122 1422 1120 1422 916 1433 877 1422 875 1422 873 1422 871 1422 836 1433 706 1422 704 1422 702 1422 669 1433 468 1422 466 1422 368 1435 370 1465"/>
                        </Shape>
                        <String CONTENT="considered to thwart the qaˊa-vaˊɪrg̣ɪn (literally, “reindeer substance;” i. e., the"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l16" HPOS="368" VPOS="1478" WIDTH="485" HEIGHT="70" BASELINE="370 1524 853 1519" TAGREFS="TYPE_5">
                        <Shape>
