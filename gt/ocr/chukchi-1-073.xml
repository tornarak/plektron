                        <String CONTENT="7. Om-yêˊᵋlhɪn (“warm month”) or Aˊno-yêˊᵋlhɪn (“summer month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l30" HPOS="413" VPOS="2262" WIDTH="1609" HEIGHT="52" BASELINE="415 2292 2022 2297" TAGREFS="TYPE_5">
