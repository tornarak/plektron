                            <Polygon POINTS="500 1119 500 1138 2159 1138 2159 1119 2154 1086 500 1082 500 1119"/>
                        </Shape>
                        <String CONTENT="The Rev. Argentoff relates that one Maiˊñɪ-qlaˊul, a rich reindeer-breeder"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l10" HPOS="391" VPOS="1149" WIDTH="1765" HEIGHT="52" BASELINE="391 1179 2156 1179" TAGREFS="TYPE_5">
