                    <TextLine ID="mz_1-073_l28" HPOS="396" VPOS="2158" WIDTH="808" HEIGHT="46" BASELINE="396 2186 1204 2186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2186 396 2204 1204 2204 1204 2186 1204 2158 396 2158 396 2186"/>
                        </Shape>
                        <String CONTENT="6. Taˊwtɪñ-yêˊᵋlhɪn (“making-leaves month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l29" HPOS="407" VPOS="2201" WIDTH="1215" HEIGHT="57" BASELINE="409 2236 1622 2234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2236 409 2258 1620 2251 1622 2234 1618 2206 407 2201 409 2236"/>
                        </Shape>
                        <String CONTENT="7. Om-yêˊᵋlhɪn (“warm month”) or Aˊno-yêˊᵋlhɪn (“summer month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l30" HPOS="392" VPOS="2247" WIDTH="1609" HEIGHT="52" BASELINE="394 2277 2001 2282" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1997 2262 1988 2249 394 2247 394 2277 392 2295 1997 2299 2001 2282 1999 2269 1997 2262"/>
                        </Shape>
                        <String CONTENT="8. Neǰ-iˊᵋlhɪn (“rubbing-off-velvet [antlers] month”) or Eleˊ-yiˊᵋlhɪn (“midsummer month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l31" HPOS="403" VPOS="2286" WIDTH="680" HEIGHT="69" BASELINE="405 2331 1083 2327" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 2331 407 2355 433 2344 1079 2349 1083 2327 1079 2297 749 2286 747 2286 745 2286 710 2297 459 2288 457 2288 403 2299 405 2331"/>
                        </Shape>
                        <String CONTENT="9. Ñeˊrg̣eǰ-iˊᵋlhɪn (“light-frost month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l32" HPOS="379" VPOS="2344" WIDTH="1715" HEIGHT="48" BASELINE="379 2375 2094 2375" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 2375 379 2390 2092 2392 2094 2375 2094 2344 379 2344 379 2375"/>
                        </Shape>
                        <String CONTENT="10. G̣ɪthaˊ-êˊᵋlhɪn (“autumn month”), called also ɪlv-eiˊñe-yiˊᵋlhɪn (“wild-reindeer rutting month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l33" HPOS="375" VPOS="2388" WIDTH="1763" HEIGHT="49" BASELINE="377 2416 2138 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 2416 375 2431 2133 2437 2138 2422 2138 2392 377 2388 377 2416"/>
                        </Shape>
                        <String CONTENT="11. Yaraˊučɪn, probably from Yaˊraw (“muscles of the back”), because it is supposed that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l34" HPOS="490" VPOS="2433" WIDTH="1650" HEIGHT="50" BASELINE="492 2463 2140 2468" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="492 2463 490 2479 2135 2483 2140 2468 2138 2440 492 2433 492 2463"/>
                        </Shape>
                        <String CONTENT="muscles of a reindeer’s back strengthen in mid-winter. The same name, with the same expla-"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l35" HPOS="490" VPOS="2481" WIDTH="1650" HEIGHT="47" BASELINE="492 2511 2140 2515" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="492 2511 490 2524 2135 2528 2140 2515 2138 2485 492 2481 492 2511"/>
                        </Shape>
                        <String CONTENT="nation, was found among the Koryak of the western shore of Kamchatka in the form"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l36" HPOS="490" VPOS="2526" WIDTH="1555" HEIGHT="52" BASELINE="490 2557 2045 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="490 2557 490 2578 2042 2578 2045 2561 2042 2531 490 2526 490 2557"/>
                        </Shape>
                        <String CONTENT="yaraˊwučɪn. This month is also called by the Chukchee Tuˊr-eᵋče (“new-snow cover”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l37" HPOS="373" VPOS="2572" WIDTH="836" HEIGHT="54" BASELINE="375 2606 1209 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2606 375 2626 1206 2626 1209 2602 1202 2572 373 2574 375 2606"/>
                        </Shape>
                        <String CONTENT="12. Quˊuleǰ-iˊᵋlhɪn (“shrinking [days] month”)."/>
                    </TextLine>
</TextBlock>
