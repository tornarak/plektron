                    </TextLine>

                    <TextLine ID="mz_1-073_l37" HPOS="394" VPOS="2587" WIDTH="836" HEIGHT="54" BASELINE="396 2621 1230 2617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="396 2621 396 2641 1227 2641 1230 2617 1223 2587 394 2589 396 2621"/>
