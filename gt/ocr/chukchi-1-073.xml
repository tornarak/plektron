                    <TextLine ID="mz_1-073_l22" HPOS="411" VPOS="1890" WIDTH="1745" HEIGHT="54" BASELINE="413 1920 2156 1926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1920 411 1937 2152 1944 2156 1926 2154 1896 413 1890 413 1920"/>
                        </Shape>
                        <String CONTENT="1. ɪnp-luˊwleñ-yiˊᵋlhɪn (“old-buck month”), from about the 20th of December to the 20th of January."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l23" HPOS="515" VPOS="1942" WIDTH="665" HEIGHT="43" BASELINE="517 1970 1180 1967" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="517 1970 517 1985 1178 1983 1180 1967 1173 1942 515 1942 517 1970"/>
                        </Shape>
                        <String CONTENT="The origin of the name is uncertain."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l24" HPOS="413" VPOS="1974" WIDTH="734" HEIGHT="67" BASELINE="415 2017 1147 2013" TAGREFS="TYPE_5">
