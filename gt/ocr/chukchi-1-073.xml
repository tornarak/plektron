                        </Shape>
                        <String CONTENT="marked pretty accurately. The dark interval between two “moons” is called"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l21" HPOS="407" VPOS="1801" WIDTH="1347" HEIGHT="63" BASELINE="407 1835 1754 1835" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1835 407 1853 762 1853 775 1864 777 1864 779 1864 781 1864 853 1853 907 1864 909 1864 911 1864 950 1853 1212 1864 1214 1864 1217 1864 1249 1853 1279 1864 1282 1864 1284 1864 1286 1864 1316 1853 1342 1864 1344 1864 1347 1864 1412 1853 1476 1864 1479 1864 1754 1851 1754 1835 1754 1807 407 1801 407 1835"/>
                        </Shape>
                        <String CONTENT="“moon interval” (yuˊᵋtir). The names of the months are —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-073_r5" HPOS="391" VPOS="1881" WIDTH="1778" HEIGHT="775" TAGREFS="TYPE_1">
