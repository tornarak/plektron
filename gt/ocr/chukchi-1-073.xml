                        </Shape>
                        <String CONTENT="SEASONS. — It may not be out of place to add here the Chukchee method"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l18" HPOS="394" VPOS="1621" WIDTH="1760" HEIGHT="54" BASELINE="394 1658 2154 1658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 1658 394 1675 2154 1675 2154 1658 2152 1621 394 1625 394 1658"/>
                        </Shape>
                        <String CONTENT="of dividing the year. The year is divided into twelve lunar months or “moons”"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l19" HPOS="391" VPOS="1684" WIDTH="1770" HEIGHT="60" BASELINE="394 1716 2161 1721" TAGREFS="TYPE_5">
