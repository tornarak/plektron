                    <TextLine ID="mz_1-073_l32" HPOS="400" VPOS="2359" WIDTH="1715" HEIGHT="48" BASELINE="400 2390 2115 2390" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="400 2390 400 2405 2113 2407 2115 2390 2115 2359 400 2359 400 2390"/>
                        </Shape>
                        <String CONTENT="10. G̣ɪthaˊ-êˊᵋlhɪn (“autumn month”), called also ɪlv-eiˊñe-yiˊᵋlhɪn (“wild-reindeer rutting month”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l33" HPOS="396" VPOS="2403" WIDTH="1763" HEIGHT="49" BASELINE="398 2431 2159 2437" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="398 2431 396 2446 2154 2452 2159 2437 2159 2407 398 2403 398 2431"/>
                        </Shape>
                        <String CONTENT="11. Yaraˊučɪn, probably from Yaˊraw (“muscles of the back”), because it is supposed that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l34" HPOS="511" VPOS="2448" WIDTH="1650" HEIGHT="50" BASELINE="513 2478 2161 2483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="513 2478 511 2494 2156 2498 2161 2483 2159 2455 513 2448 513 2478"/>
                        </Shape>
                        <String CONTENT="muscles of a reindeer’s back strengthen in mid-winter. The same name, with the same expla-"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l35" HPOS="511" VPOS="2496" WIDTH="1650" HEIGHT="47" BASELINE="513 2526 2161 2530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="513 2526 511 2539 2156 2543 2161 2530 2159 2500 513 2496 513 2526"/>
                        </Shape>
                        <String CONTENT="nation, was found among the Koryak of the western shore of Kamchatka in the form"/>
                    </TextLine>

                    <TextLine ID="mz_1-073_l36" HPOS="511" VPOS="2541" WIDTH="1555" HEIGHT="52" BASELINE="511 2572 2066 2576" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="511 2572 511 2593 2063 2593 2066 2576 2063 2546 511 2541 511 2572"/>
                        </Shape>
