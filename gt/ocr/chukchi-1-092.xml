                        </Shape>
                        <String CONTENT="able distance from it. With the advance of the season, he will proceed east-"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l4" HPOS="843" VPOS="801" WIDTH="1769" HEIGHT="45" BASELINE="843 831 2612 831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 831 843 846 2612 846 2612 831 2612 801 843 801 843 831"/>
                        </Shape>
                        <String CONTENT="ward as far as possible, and turn to the shore only when travelling with"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l5" HPOS="840" VPOS="859" WIDTH="1772" HEIGHT="48" BASELINE="840 889 2612 889" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 889 840 907 2612 907 2612 889 2612 859 840 859 840 889"/>
                        </Shape>
                        <String CONTENT="reindeer becomes impossible. Sometimes he will reach East Cape; more often"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l6" HPOS="843" VPOS="907" WIDTH="1767" HEIGHT="58" BASELINE="843 948 2610 948" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 948 843 965 2608 965 2610 948 2610 920 2575 907 2573 907 2571 907 2569 907 2521 920 2419 920 2402 907 2400 907 2398 907 2395 907 2393 907 2354 918 2270 907 2268 907 2179 918 2051 907 1852 907 1850 907 1847 907 1845 907 1830 920 1681 920 1666 907 1663 907 1661 907 1659 907 1657 907 1631 918 1549 907 1546 907 1479 918 1401 907 1399 907 1345 918 843 913 843 948"/>
                        </Shape>
                        <String CONTENT="he will stop in some other village between Kuluˊči Bay and East Cape. To"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l7" HPOS="838" VPOS="974" WIDTH="1774" HEIGHT="56" BASELINE="840 1004 2612 1011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1004 838 1022 849 1030 851 1030 853 1030 856 1030 2610 1024 2612 1011 2610 980 840 974 840 1004"/>
                        </Shape>
                        <String CONTENT="stay west of Kuluˊči is inconvenient, because in the western villages the"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l8" HPOS="840" VPOS="1037" WIDTH="1770" HEIGHT="54" BASELINE="840 1069 2610 1073" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1069 840 1091 2608 1091 2610 1073 2608 1041 840 1037 840 1069"/>
                        </Shape>
                        <String CONTENT="population is scanty, and the sea-journey to East Cape presents more trouble,"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l9" HPOS="838" VPOS="1095" WIDTH="414" HEIGHT="56" BASELINE="840 1125 1252 1130" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1125 838 1143 849 1151 851 1151 853 1151 856 1151 1250 1143 1252 1130 1250 1099 840 1095 840 1125"/>
                        </Shape>
                        <String CONTENT="and even danger."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-092_r3" HPOS="839" VPOS="1150" WIDTH="1778" HEIGHT="905" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="839 1150 2617 1150 2617 2055 839 2055"/>
                    </Shape>
                    <TextLine ID="mz_1-092_l10" HPOS="947" VPOS="1149" WIDTH="1667" HEIGHT="63" BASELINE="949 1184 2614 1188" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="949 1184 947 1201 962 1212 964 1212 966 1212 968 1212 2612 1203 2614 1188 2612 1158 949 1149 949 1184"/>
                        </Shape>
                        <String CONTENT="He will spend the whole summer on the seashore; he will take part in"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l11" HPOS="838" VPOS="1216" WIDTH="1774" HEIGHT="57" BASELINE="840 1247 2612 1251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1247 838 1262 853 1273 856 1273 858 1273 860 1273 2610 1268 2612 1251 2610 1221 840 1216 840 1247"/>
                        </Shape>
                        <String CONTENT="the seal-hunting, so as to have a share in the spoils without paying for it;"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l12" HPOS="838" VPOS="1273" WIDTH="1774" HEIGHT="62" BASELINE="840 1305 2612 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1305 838 1320 1115 1333 1118 1333 1689 1325 1735 1335 1737 1335 1739 1335 2610 1325 2612 1309 2608 1273 840 1273 840 1305"/>
                        </Shape>
                        <String CONTENT="and he will journey by boat to East Cape. In exchange for his skins, he will"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l13" HPOS="840" VPOS="1327" WIDTH="1772" HEIGHT="60" BASELINE="840 1370 2612 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1370 840 1387 2612 1387 2612 1370 2612 1340 2525 1327 2523 1327 2521 1327 2497 1338 2421 1327 2419 1327 2417 1327 2393 1338 2367 1327 2365 1327 2363 1327 2361 1327 2337 1338 1850 1327 1847 1327 1845 1327 1817 1338 1789 1327 1787 1327 1785 1327 1663 1338 1527 1327 1525 1327 1523 1327 1481 1338 1436 1327 1434 1327 1432 1327 1087 1338 966 1327 964 1327 962 1327 960 1327 944 1340 840 1340 840 1370"/>
                        </Shape>
                        <String CONTENT="try chiefly to get ground-seal hides and all kinds of thongs, and American"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l14" HPOS="840" VPOS="1385" WIDTH="1774" HEIGHT="63" BASELINE="840 1429 2614 1429" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1429 840 1448 2614 1446 2614 1429 2614 1396 2274 1385 2272 1385 2190 1396 2168 1385 2166 1385 2164 1385 2161 1385 2129 1396 2094 1385 2092 1385 2090 1385 2088 1385 2086 1385 2071 1398 1971 1398 1919 1385 1917 1385 1817 1396 1793 1385 1791 1385 1789 1385 1787 1385 1785 1385 1769 1398 1672 1398 1616 1385 1614 1385 1611 1385 1609 1385 1592 1398 1475 1398 1447 1385 1445 1385 1442 1385 1440 1385 1416 1396 1330 1385 1328 1385 1326 1385 1323 1385 1310 1396 1282 1385 1280 1385 1278 1385 1276 1385 1274 1385 1256 1396 1232 1385 1230 1385 1228 1385 1226 1385 1200 1396 1170 1385 1167 1385 1165 1385 1163 1385 1139 1398 979 1398 940 1385 938 1385 936 1385 840 1396 840 1429"/>
                        </Shape>
                        <String CONTENT="products, — alcohol, Winchester rifles, and cartridges. In the middle fall he will"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l15" HPOS="843" VPOS="1459" WIDTH="1769" HEIGHT="45" BASELINE="843 1489 2612 1489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 1489 843 1504 2612 1504 2612 1489 2612 1459 843 1459 843 1489"/>
                        </Shape>
                        <String CONTENT="start on his return journey as slowly as before, and will finally go back to"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l16" HPOS="843" VPOS="1513" WIDTH="1771" HEIGHT="52" BASELINE="843 1548 2614 1548" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 1548 843 1565 2614 1565 2614 1548 2614 1519 843 1513 843 1548"/>
                        </Shape>
                        <String CONTENT="his own country in the spring. He will return the borrowed reindeer, for the"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l17" HPOS="843" VPOS="1580" WIDTH="1771" HEIGHT="46" BASELINE="843 1608 2614 1608" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 1608 843 1626 2614 1626 2614 1608 2614 1580 843 1580 843 1608"/>
                        </Shape>
                        <String CONTENT="most part without any particular pay, and will distribute some of the wares"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l18" HPOS="840" VPOS="1632" WIDTH="1774" HEIGHT="54" BASELINE="840 1667 2614 1667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1667 840 1686 2614 1686 2614 1667 2614 1639 840 1632 840 1667"/>
                        </Shape>
                        <String CONTENT="he has bought among those whose agent he has been, retaining a considerable"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l19" HPOS="840" VPOS="1693" WIDTH="1772" HEIGHT="52" BASELINE="843 1723 2612 1727" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 1723 840 1740 2608 1745 2612 1727 2610 1697 843 1693 843 1723"/>
                        </Shape>
                        <String CONTENT="share of profit for himself out of every transaction of this kind. Such a journey"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l20" HPOS="840" VPOS="1755" WIDTH="1770" HEIGHT="59" BASELINE="843 1786 2610 1792" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 1786 840 1799 1503 1814 1505 1814 2608 1810 2610 1792 2608 1762 843 1755 843 1786"/>
                        </Shape>
                        <String CONTENT="will last a whole year, and perhaps even longer; so that a caravan leaving"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l21" HPOS="838" VPOS="1803" WIDTH="1774" HEIGHT="61" BASELINE="840 1844 2612 1851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1844 838 1857 2608 1864 2612 1851 2610 1820 2337 1807 2335 1807 2283 1818 2235 1807 2233 1807 2231 1807 2229 1807 2185 1818 2153 1807 2151 1807 2148 1807 2086 1818 2049 1807 2047 1807 2045 1807 2042 1807 2023 1818 2008 1805 2006 1805 2003 1805 2001 1805 1999 1805 1971 1816 1934 1805 1932 1805 1930 1805 1928 1805 1899 1816 1778 1805 1776 1805 1724 1816 1700 1805 1698 1805 1696 1805 1694 1805 1663 1816 1624 1805 1622 1805 1620 1805 1618 1805 1616 1805 1598 1818 1471 1818 1432 1803 1429 1803 1427 1803 1425 1803 1399 1814 1375 1803 1373 1803 1371 1803 1308 1814 1226 1803 1224 1803 840 1812 840 1844"/>
                        </Shape>
                        <String CONTENT="two months before fair-time at Anui will be back just in time for the next"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l22" HPOS="840" VPOS="1877" WIDTH="1772" HEIGHT="47" BASELINE="840 1907 2612 1907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1907 840 1924 2612 1924 2612 1907 2612 1877 840 1877 840 1907"/>
                        </Shape>
                        <String CONTENT="fair. Travelling between Indian Point and the Anadyr is much shorter, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l23" HPOS="838" VPOS="1931" WIDTH="1774" HEIGHT="63" BASELINE="840 1965 2612 1970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 1965 838 1978 1728 1994 1731 1994 2610 1983 2612 1970 2610 1933 840 1931 840 1965"/>
                        </Shape>
                        <String CONTENT="is usually accomplished in one winter, so that a caravan starting in the fall"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l24" HPOS="840" VPOS="1991" WIDTH="1207" HEIGHT="55" BASELINE="843 2024 2047 2033" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 2024 840 2037 2042 2046 2047 2033 2045 2000 843 1991 843 2024"/>
                        </Shape>
                        <String CONTENT="will come back about the middle of the next spring."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-092_r4" HPOS="839" VPOS="2055" WIDTH="1778" HEIGHT="954" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="839 2055 2617 2055 2617 3009 839 3009"/>
                    </Shape>
                    <TextLine ID="mz_1-092_l25" HPOS="951" VPOS="2046" WIDTH="1661" HEIGHT="58" BASELINE="953 2082 2612 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="953 2082 951 2100 2608 2104 2612 2087 2610 2059 953 2046 953 2082"/>
                        </Shape>
                        <String CONTENT="When a man finds zest and profit in such journeys, he makes them his"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l26" HPOS="838" VPOS="2115" WIDTH="1774" HEIGHT="58" BASELINE="840 2145 2612 2150" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2145 838 2158 1027 2171 1029 2171 1722 2162 1739 2173 1741 2173 1744 2173 1746 2173 2610 2162 2612 2150 2610 2119 840 2115 840 2145"/>
                        </Shape>
                        <String CONTENT="vocation, and becomes a Kavraˊlɪn. As mentioned before, the greater part"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l27" HPOS="838" VPOS="2173" WIDTH="1774" HEIGHT="52" BASELINE="840 2204 2612 2208" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2204 838 2221 2608 2225 2612 2208 2610 2175 840 2173 840 2204"/>
                        </Shape>
                        <String CONTENT="of the Kavraˊlɪt are maritime people who first turned to reindeer-breeding and"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l28" HPOS="838" VPOS="2234" WIDTH="1774" HEIGHT="52" BASELINE="840 2264 2612 2271" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2264 838 2279 2608 2286 2612 2271 2610 2240 840 2234 840 2264"/>
                        </Shape>
                        <String CONTENT="then to trade, and thus are experienced in both pursuits and in the customs"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l29" HPOS="838" VPOS="2292" WIDTH="1774" HEIGHT="52" BASELINE="840 2323 2612 2329" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2323 838 2338 2608 2344 2612 2329 2610 2299 840 2292 840 2323"/>
                        </Shape>
                        <String CONTENT="of both parts of the tribe. The Kavraˊlɪt are continually en route. In former"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l30" HPOS="843" VPOS="2353" WIDTH="1767" HEIGHT="54" BASELINE="843 2383 2610 2390" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="843 2383 843 2407 2608 2403 2610 2390 2608 2360 843 2353 843 2383"/>
                        </Shape>
                        <String CONTENT="years they were anxious to visit the Russian fairs. They went down to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l31" HPOS="838" VPOS="2411" WIDTH="1772" HEIGHT="55" BASELINE="840 2442 2610 2450" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2442 838 2457 2605 2466 2610 2450 2608 2420 840 2411 840 2442"/>
                        </Shape>
                        <String CONTENT="seashore to meet the boats coming from the Diomede Islands and America,"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l32" HPOS="838" VPOS="2472" WIDTH="1772" HEIGHT="52" BASELINE="840 2500 2610 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2500 838 2518 2605 2524 2610 2507 2608 2479 840 2472 840 2500"/>
                        </Shape>
                        <String CONTENT="and often associated with them and made a trip across the sea to secure an"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l33" HPOS="838" VPOS="2531" WIDTH="1772" HEIGHT="54" BASELINE="840 2563 2610 2570" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2563 838 2578 2605 2585 2610 2570 2608 2535 840 2531 840 2563"/>
                        </Shape>
                        <String CONTENT="additional supply of valuable peltries. Sometimes the father of a family would"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l34" HPOS="840" VPOS="2598" WIDTH="1772" HEIGHT="45" BASELINE="840 2626 2612 2626" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2626 840 2643 2612 2643 2612 2626 2612 2598 840 2598 840 2626"/>
                        </Shape>
                        <String CONTENT="start westward with a reindeer-caravan. Meanwhile one of his sons would"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l35" HPOS="838" VPOS="2652" WIDTH="1772" HEIGHT="52" BASELINE="840 2682 2610 2689" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2682 838 2697 2605 2704 2610 2689 2608 2658 840 2652 840 2682"/>
                        </Shape>
                        <String CONTENT="wait till summer and cross Bering Strait in his boat. The next spring father"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l36" HPOS="838" VPOS="2715" WIDTH="1772" HEIGHT="47" BASELINE="840 2745 2610 2749" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2745 838 2758 2605 2762 2610 2749 2608 2719 840 2715 840 2745"/>
                        </Shape>
                        <String CONTENT="and son would meet, and arrange for the distribution of their wares for new"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l37" HPOS="838" VPOS="2771" WIDTH="1774" HEIGHT="58" BASELINE="838 2808 2612 2808" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="838 2808 838 2829 2612 2823 2612 2808 2610 2771 838 2771 838 2808"/>
                        </Shape>
                        <String CONTENT="journeys. Even now a few Kavraˊlɪt traders have not restricted the range of"/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l38" HPOS="838" VPOS="2818" WIDTH="1767" HEIGHT="68" BASELINE="840 2860 2605 2870" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2860 838 2875 2601 2886 2605 2870 2603 2840 2437 2827 2434 2827 2432 2827 2430 2827 2413 2838 2382 2827 2380 2827 2378 2827 2304 2838 2252 2825 2250 2825 2248 2825 2246 2825 2209 2836 2170 2825 2168 2825 2166 2825 2164 2825 2133 2836 2120 2825 2118 2825 2116 2825 2114 2825 1886 2834 1850 2823 1847 2823 1845 2823 1843 2823 1817 2834 1689 2823 1687 2823 1685 2823 1646 2834 1624 2823 1622 2823 1620 2823 1618 2823 1596 2834 1546 2821 1544 2821 1542 2821 1540 2821 1538 2821 1518 2834 1371 2834 1347 2821 1345 2821 1343 2821 1341 2821 1317 2831 1222 2821 1219 2821 1111 2829 1096 2818 1094 2818 1092 2818 1089 2818 1087 2818 1057 2831 944 2831 929 2818 927 2818 925 2818 923 2818 840 2827 840 2860"/>
                        </Shape>
                        <String CONTENT="their travels, and continue to visit both the Anui fair and the Diomede Islands."/>
                    </TextLine>

                    <TextLine ID="mz_1-092_l39" HPOS="838" VPOS="2890" WIDTH="1770" HEIGHT="65" BASELINE="840 2920 2608 2929" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="840 2920 838 2935 912 2948 914 2948 1263 2940 1347 2951 1349 2951 2120 2944 2216 2955 2218 2955 2605 2944 2608 2929 2605 2899 840 2890 840 2920"/>
                        </Shape>
                        <String CONTENT="Others, however, trade chiefly in fawn-skins, and do not go as far as the"/>
                    </TextLine>

