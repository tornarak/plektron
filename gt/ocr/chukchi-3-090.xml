                        </Shape>
                        <String CONTENT="where the Chukchee live intermixed with the Tungus or the Chuvantzy, both"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l4" HPOS="348" VPOS="632" WIDTH="1774" HEIGHT="61" BASELINE="350 679 2122 673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 679 350 693 2120 689 2122 673 2118 644 1956 632 1954 632 1888 642 1867 632 1865 632 1863 632 1818 642 1792 632 1790 632 1789 632 1787 632 1748 642 1718 632 1716 632 1714 632 1646 642 1576 632 1574 632 1572 632 1527 644 1492 634 1490 634 1488 634 1486 634 1461 644 1175 634 1173 634 1171 634 1134 644 1097 634 1095 634 1093 634 1091 634 1060 644 1009 634 1007 634 919 646 859 636 857 636 855 636 826 646 724 636 722 636 721 636 719 636 703 648 586 648 522 636 520 636 467 646 372 636 370 636 368 636 366 636 348 644 350 679"/>
                        </Shape>
                        <String CONTENT="these tribes supply assistants for the Chukchee herds. Thus Araˊro has Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l5" HPOS="348" VPOS="695" WIDTH="1770" HEIGHT="62" BASELINE="350 737 2118 733" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 737 350 753 2114 757 2118 733 2114 706 1794 695 1792 695 1790 695 1789 695 1773 706 1566 706 1518 695 1516 695 1514 695 1494 704 1403 695 1401 695 1332 704 1255 695 1253 695 1251 695 1212 706 668 696 666 696 621 706 584 696 582 696 580 696 494 706 420 696 418 696 348 708 350 737"/>
                        </Shape>
                        <String CONTENT="assistants in all four herds belonging to him. This became possible, of course,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l6" HPOS="350" VPOS="757" WIDTH="1770" HEIGHT="56" BASELINE="350 796 2120 796" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 796 350 813 2118 813 2120 796 2118 769 1718 757 1716 757 1638 767 1607 757 1605 757 1603 757 1551 769 1202 769 1122 757 1120 757 1118 757 1087 769 921 769 841 757 839 757 771 767 734 757 732 757 730 757 728 757 705 767 658 757 656 757 584 767 491 757 489 757 487 757 454 767 413 757 411 757 409 757 350 767 350 796"/>
                        </Shape>
                        <String CONTENT="only during the last fifty years, when peace was assured, and the tribes began"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l7" HPOS="348" VPOS="813" WIDTH="1772" HEIGHT="59" BASELINE="350 858 2120 852" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 858 350 872 2118 868 2120 852 2116 825 1695 813 1693 813 1635 823 1553 813 1551 813 1549 813 1525 825 989 815 988 815 900 827 426 817 424 817 422 817 401 827 370 817 368 817 366 817 364 817 362 817 348 825 350 858"/>
                        </Shape>
                        <String CONTENT="to intermingle, at least on their common frontiers. The admission of Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l8" HPOS="348" VPOS="874" WIDTH="1772" HEIGHT="58" BASELINE="350 917 2120 911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 917 350 932 2118 928 2120 911 2116 874 1572 874 1570 874 1568 874 1525 884 941 876 939 876 937 876 894 886 418 878 416 878 348 887 350 917"/>
                        </Shape>
                        <String CONTENT="assistants is quite natural, as the Chukchee herds of those localities are full"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l9" HPOS="348" VPOS="934" WIDTH="1776" HEIGHT="65" BASELINE="350 977 2124 973" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 977 350 989 1188 999 1190 999 2122 987 2124 973 2118 934 2071 944 1820 934 1818 934 1613 944 1559 934 1557 934 1555 934 1553 934 1537 944 1504 934 1502 934 1500 934 1403 944 1389 934 1387 934 1385 934 1272 934 1270 934 1268 934 1231 946 389 936 387 936 385 936 348 948 350 977"/>
                        </Shape>
                        <String CONTENT="of Tungus reindeer, which are more valuable, and the care and breaking of"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l10" HPOS="348" VPOS="995" WIDTH="1772" HEIGHT="64" BASELINE="350 1038 2120 1034" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1038 350 1049 769 1049 845 1059 847 1059 1132 1049 1231 1059 1233 1059 1317 1047 1403 1057 1405 1057 2118 1047 2120 1034 2118 1006 2081 995 2079 995 2077 995 2075 995 2038 1004 1997 995 1995 995 1993 995 1991 995 1962 1004 1683 995 1681 995 1679 995 1644 1004 1611 995 1609 995 1607 995 1605 995 1576 1004 1486 995 1485 995 1483 995 1440 1004 1360 995 1358 995 1223 1006 1173 997 1171 997 1114 1006 1064 997 1062 997 832 1006 775 997 773 997 771 997 750 1006 615 997 613 997 611 997 609 997 594 1008 489 1008 389 997 387 997 385 997 348 1008 350 1038"/>
                        </Shape>
                        <String CONTENT="which are better known to the Tungus. Especially is this the case in the"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l11" HPOS="346" VPOS="1053" WIDTH="1776" HEIGHT="61" BASELINE="348 1098 2122 1092" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1098 348 1114 2120 1108 2122 1092 2118 1065 2009 1053 2007 1053 2005 1053 2003 1053 1985 1065 1732 1065 1685 1053 1683 1053 1635 1063 1584 1053 1582 1053 1580 1053 1578 1053 1564 1063 1539 1053 1537 1053 1535 1053 1533 1053 1531 1053 1518 1063 1054 1055 1052 1055 976 1065 941 1055 939 1055 937 1055 876 1067 841 1057 839 1057 837 1057 607 1067 549 1057 547 1057 346 1069 348 1098"/>
                        </Shape>
                        <String CONTENT="summer-time and with riding-reindeer, since the Chukchee have no experience"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l12" HPOS="348" VPOS="1114" WIDTH="1774" HEIGHT="58" BASELINE="350 1158 2122 1152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1158 350 1172 2122 1166 2122 1152 2118 1125 2001 1114 1999 1114 1997 1114 1976 1125 1814 1125 1753 1114 1752 1114 1668 1123 1640 1114 1638 1114 1637 1114 1469 1125 1410 1115 1409 1115 1407 1115 1375 1125 1319 1115 1171 1115 1169 1115 1167 1115 1165 1115 1149 1125 348 1125 350 1158"/>
                        </Shape>
                        <String CONTENT="in dealing with these. Some young Chukchee breeders take a Tungus assistant,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l13" HPOS="348" VPOS="1178" WIDTH="1770" HEIGHT="62" BASELINE="350 1219 2118 1215" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1219 350 1240 1260 1230 2114 1238 2118 1215 2114 1184 518 1178 516 1178 348 1188 350 1219"/>
                        </Shape>
                        <String CONTENT="purposely for the summer-time, in order to learn from him the ways of riding"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l14" HPOS="346" VPOS="1234" WIDTH="1772" HEIGHT="65" BASELINE="348 1279 2118 1273" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1279 348 1291 976 1299 978 1299 980 1299 982 1299 997 1289 1399 1289 1522 1299 1523 1299 1525 1299 1527 1299 1543 1287 1666 1297 1668 1297 1670 1297 1707 1287 1824 1297 1826 1297 2116 1287 2118 1273 2114 1246 1987 1234 1985 1234 1931 1244 1720 1234 1718 1234 1716 1234 1714 1234 1699 1246 1375 1246 1332 1236 1331 1236 1329 1236 1327 1236 1325 1236 1309 1248 1054 1248 1013 1236 1011 1236 1009 1236 1007 1236 1005 1236 989 1246 849 1238 847 1238 752 1248 736 1238 734 1238 732 1238 730 1238 539 1248 395 1238 393 1238 391 1238 346 1250 348 1279"/>
                        </Shape>
                        <String CONTENT="reindeer and of wandering in summer. In many cases, however, Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l15" HPOS="348" VPOS="1295" WIDTH="1772" HEIGHT="56" BASELINE="350 1338 2120 1334" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1338 350 1351 2118 1347 2120 1334 2116 1305 1247 1295 1245 1295 1243 1295 1241 1295 1227 1306 1190 1297 1188 1297 1186 1297 1184 1297 1147 1306 976 1297 974 1297 637 1306 594 1297 592 1297 590 1297 588 1297 557 1306 418 1297 416 1297 348 1308 350 1338"/>
                        </Shape>
                        <String CONTENT="assistants do not stay very long in the Chukchee camps, the character of both"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l16" HPOS="350" VPOS="1355" WIDTH="1770" HEIGHT="55" BASELINE="350 1396 2120 1396" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1396 350 1410 2118 1410 2120 1396 2118 1367 2057 1355 2056 1355 2054 1355 2020 1365 1948 1355 1946 1355 1370 1365 1336 1355 1334 1355 1332 1355 1253 1365 1221 1355 1219 1355 1218 1355 1216 1355 1214 1355 1202 1365 1188 1355 1186 1355 1184 1355 1093 1355 1091 1355 1032 1365 972 1355 970 1355 968 1355 966 1355 951 1367 822 1367 742 1355 740 1355 738 1355 736 1355 721 1367 598 1367 563 1355 561 1355 559 1355 557 1355 555 1355 539 1365 514 1355 512 1355 510 1355 438 1365 395 1355 393 1355 391 1355 389 1355 350 1365 350 1396"/>
                        </Shape>
                        <String CONTENT="tribes being so different. The Chukchee does not like much wandering, but"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l17" HPOS="346" VPOS="1412" WIDTH="1774" HEIGHT="58" BASELINE="348 1458 2120 1451" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1458 348 1470 2118 1468 2120 1451 2116 1423 1929 1423 1905 1412 1904 1412 1902 1412 1900 1412 1870 1423 1674 1423 1644 1414 1642 1414 1640 1414 1317 1423 1233 1414 1231 1414 1229 1414 1190 1427 1032 1427 1011 1416 1009 1416 1007 1416 1005 1416 970 1425 935 1416 933 1416 931 1416 836 1425 802 1416 800 1416 798 1416 639 1427 346 1425 348 1458"/>
                        </Shape>
                        <String CONTENT="he is ever mindful of the increasc of his animals. This care requires great"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l18" HPOS="348" VPOS="1476" WIDTH="1772" HEIGHT="57" BASELINE="350 1519 2120 1513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1519 350 1533 2118 1527 2120 1513 2116 1484 958 1476 956 1476 884 1486 378 1478 376 1478 374 1478 348 1488 350 1519"/>
                        </Shape>
                        <String CONTENT="alertness and uninterrupted attention to the herd and pasture. The Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l19" HPOS="348" VPOS="1536" WIDTH="1768" HEIGHT="59" BASELINE="348 1577 2116 1577" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1577 348 1589 2114 1595 2116 1577 2116 1548 2048 1536 2046 1536 1831 1546 1808 1536 1806 1536 1804 1536 1676 1546 1599 1536 1598 1536 1537 1546 1514 1536 1512 1536 1510 1536 1444 1546 1358 1536 1356 1536 1264 1548 1136 1548 1120 1536 1118 1536 1116 1536 1114 1536 1067 1546 999 1536 997 1536 995 1536 960 1546 348 1542 348 1577"/>
                        </Shape>
                        <String CONTENT="is indolent, and soon wearies of camp duties. He likes travel and hunting,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l20" HPOS="346" VPOS="1593" WIDTH="1772" HEIGHT="58" BASELINE="348 1638 2118 1632" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1638 348 1651 2116 1649 2118 1632 2114 1605 2054 1593 2052 1593 2050 1593 2011 1603 1935 1593 1933 1593 1878 1603 1855 1593 1853 1593 1851 1593 1722 1603 1654 1593 1652 1593 1650 1593 1648 1593 1633 1603 1502 1595 1500 1595 1428 1605 1381 1595 1379 1595 1280 1605 1212 1595 1210 1595 1208 1595 1169 1605 1095 1595 1093 1595 1030 1605 989 1595 988 1595 986 1595 925 1607 539 1597 537 1597 535 1597 496 1607 418 1597 416 1597 346 1609 348 1638"/>
                        </Shape>
                        <String CONTENT="and is altogether of a roaming disposition. So, after a few months, he often"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l21" HPOS="346" VPOS="1653" WIDTH="1770" HEIGHT="63" BASELINE="348 1698 2116 1692" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1698 348 1712 2112 1716 2116 1692 2112 1665 1956 1665 1935 1653 1933 1653 1931 1653 1878 1663 1829 1653 1828 1653 1826 1653 1796 1663 1648 1653 1646 1653 1523 1665 1455 1655 1453 1655 1399 1665 1239 1655 1237 1655 1143 1665 1130 1655 1128 1655 1126 1655 1124 1655 908 1667 781 1657 779 1657 346 1661 348 1698"/>
                        </Shape>
                        <String CONTENT="leaves the Chukchee camp, which is heavy and too stationary for his tastes,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l22" HPOS="348" VPOS="1716" WIDTH="1458" HEIGHT="56" BASELINE="350 1757 1806 1753" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1757 350 1772 1804 1772 1806 1753 1802 1725 1106 1716 1104 1716 1103 1716 1071 1725 418 1718 416 1718 348 1727 350 1757"/>
                        </Shape>
                        <String CONTENT="and wanders far away to hunt wild reindeer or mountain-sheep."/>
                    </TextLine>
<TextLine ID="mz_3-090_l23" HPOS="455" VPOS="1772" WIDTH="1665" HEIGHT="68" BASELINE="457 1817 2120 1811" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 1817 457 1829 541 1840 543 1840 615 1829 1093 1829 1545 1839 1547 1839 1549 1839 1551 1839 1566 1827 1613 1837 1615 1837 1617 1837 1660 1827 1841 1837 1843 1837 2120 1825 2120 1811 2116 1784 2059 1772 2057 1772 2001 1782 1876 1772 1874 1772 1872 1772 1870 1772 1855 1784 1744 1784 1714 1772 1713 1772 1711 1772 1562 1784 1529 1774 1527 1774 1525 1774 1467 1784 1255 1774 1253 1774 1251 1774 1249 1774 1235 1786 1091 1786 1015 1774 1013 1774 1011 1774 1009 1774 997 1784 886 1776 884 1776 882 1776 880 1776 869 1786 818 1776 816 1776 652 1786 473 1776 471 1776 469 1776 467 1776 455 1784 457 1817"/>
                        </Shape>
                        <String CONTENT="Paupers. — The Chukchee camp knows hardly any other social position"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l24" HPOS="344" VPOS="1831" WIDTH="1770" HEIGHT="60" BASELINE="346 1877 2114 1872" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="346 1877 346 1889 2110 1891 2114 1872 2106 1831 2073 1842 1746 1833 1744 1833 1656 1842 1598 1833 1596 1833 1594 1833 1574 1842 1547 1833 1545 1833 1543 1833 1541 1833 1504 1844 1295 1835 1294 1835 1231 1844 1218 1835 1216 1835 1214 1835 1212 1835 1036 1844 972 1835 970 1835 968 1835 966 1835 951 1844 697 1837 695 1837 693 1837 674 1846 639 1837 637 1837 635 1837 576 1846 496 1837 494 1837 493 1837 450 1846 366 1837 364 1837 362 1837 344 1844 346 1877"/>
                        </Shape>
                        <String CONTENT="than that of the master, his nearest relatives, and his assistants. Later I"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l25" HPOS="346" VPOS="1891" WIDTH="1770" HEIGHT="64" BASELINE="348 1940 2116 1934" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 1940 348 1952 2112 1955 2116 1934 2114 1905 2077 1891 2075 1891 2073 1891 2005 1903 1974 1891 1972 1891 1970 1891 1968 1891 1943 1905 1851 1905 1826 1891 1824 1891 1822 1891 1820 1891 1781 1905 1640 1905 1623 1891 1621 1891 1619 1891 1617 1891 1615 1891 1590 1901 1561 1891 1559 1891 1557 1891 1492 1903 1463 1893 1461 1893 1459 1893 1457 1893 1455 1893 1440 1905 1409 1893 1407 1893 1405 1893 1403 1893 1377 1905 1360 1893 1358 1893 1356 1893 1354 1893 1147 1905 1085 1893 1083 1893 997 1905 943 1893 941 1893 939 1893 896 1907 880 1895 878 1895 876 1895 874 1895 808 1907 740 1895 738 1895 736 1895 734 1895 715 1907 685 1895 683 1895 682 1895 623 1907 586 1895 584 1895 582 1895 479 1907 461 1895 459 1895 457 1895 376 1895 374 1895 372 1895 346 1907 348 1940"/>
                        </Shape>
                        <String CONTENT="shall speak of the Maritime village, which is founded on another principle,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l26" HPOS="348" VPOS="1953" WIDTH="1770" HEIGHT="59" BASELINE="350 1996 2118 1992" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 1996 350 2012 2116 2012 2118 1992 2114 1953 1249 1953 1247 1953 1106 1963 372 1955 370 1955 368 1955 348 1963 350 1996"/>
                        </Shape>
                        <String CONTENT="that of territorial contiguity, and which is much larger than the camp. I shall"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l27" HPOS="346" VPOS="2014" WIDTH="1770" HEIGHT="62" BASELINE="348 2059 2116 2055" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 2059 348 2070 2112 2076 2116 2055 2112 2026 1954 2014 1952 2014 1907 2024 1865 2014 1863 2014 1861 2014 1859 2014 1828 2024 1631 2014 1629 2014 1627 2014 1592 2024 1471 2014 1469 2014 1106 2026 1058 2016 1056 2016 1009 2028 847 2028 830 2016 828 2016 826 2016 824 2016 822 2016 785 2026 717 2016 715 2016 713 2016 676 2026 590 2016 588 2016 586 2016 549 2026 346 2024 348 2059"/>
                        </Shape>
                        <String CONTENT="indicate then the elements of population of different character; for instance,"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l28" HPOS="346" VPOS="2074" WIDTH="1770" HEIGHT="57" BASELINE="348 2117 2116 2113" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 2117 348 2131 2114 2127 2116 2113 2112 2086 1927 2074 1925 2074 1923 2074 1886 2084 1849 2074 1847 2074 1845 2074 1714 2084 1676 2074 1674 2074 1672 2074 1599 2084 1566 2074 1564 2074 1562 2074 1475 2084 1352 2074 1350 2074 1348 2074 1313 2084 1276 2074 1274 2074 1272 2074 1270 2074 1227 2086 1192 2076 1190 2076 1188 2076 785 2086 623 2076 621 2076 619 2076 617 2076 602 2088 346 2088 348 2117"/>
                        </Shape>
                        <String CONTENT="very poor families, consisting mostly of widows and orphans, who have no"/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l29" HPOS="346" VPOS="2133" WIDTH="1770" HEIGHT="58" BASELINE="348 2178 2116 2174" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="348 2178 348 2191 2114 2191 2116 2174 2112 2144 1557 2133 1555 2133 1553 2133 1520 2144 1315 2144 1231 2133 1229 2133 1227 2133 1204 2144 1149 2135 1147 2135 643 2144 526 2135 524 2135 346 2146 348 2178"/>
                        </Shape>
                        <String CONTENT="near relatives, and who depend for their support wholly on their neighbors."/>
                    </TextLine>

                    <TextLine ID="mz_3-090_l30" HPOS="348" VPOS="2193" WIDTH="1772" HEIGHT="63" BASELINE="350 2236 2120 2232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="350 2236 350 2248 2085 2256 2087 2256 2089 2256 2120 2244 2120 2232 2112 2193 2071 2203 1999 2193 1997 2193 1923 2203 1909 2193 1907 2193 1905 2193 1804 2193 1802 2193 1800 2193 1798 2193 1785 2203 1701 2193 1699 2193 1637 2203 1568 2193 1566 2193 1520 2203 1449 2193 1447 2193 1446 2193 1412 2205 1258 2205 1237 2193 1235 2193 1233 2193 1153 2205 1011 2195 1009 2195 1007 2195 976 2205 945 2195 943 2195 941 2195 939 2195 906 2205 348 2201 350 2236"/>
                        </Shape>
                        <String CONTENT="The Chukchee camp rarely knows such categories of people. All families of"/>
                    </TextLine>

