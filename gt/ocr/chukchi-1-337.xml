                    <TextLine ID="mz_1-337_l34" HPOS="543" VPOS="2600" WIDTH="1663" HEIGHT="62" BASELINE="543 2636 2206 2636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="543 2636 543 2649 636 2662 638 2662 641 2662 682 2652 1178 2662 1180 2662 2206 2652 2206 2636 2200 2604 543 2600 543 2636"/>
                        </Shape>
                        <String CONTENT="Many men also wear ear-rings, generally by order of a shaman. These,"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l35" HPOS="430" VPOS="2665" WIDTH="1666" HEIGHT="49" BASELINE="433 2697 2096 2693" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2697 433 2714 2094 2710 2096 2693 2092 2665 430 2665 433 2697"/>
                        </Shape>
                        <String CONTENT="however, are sometimes fastened simply with a loop slung over the ear."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-337_r5" HPOS="388" VPOS="2722" WIDTH="1778" HEIGHT="239" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="388 2722 2166 2722 2166 2961 388 2961"/>
                    </Shape>
                    <TextLine ID="mz_1-337_l36" HPOS="539" VPOS="2712" WIDTH="1667" HEIGHT="63" BASELINE="541 2760 2206 2753" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="541 2760 541 2775 2204 2769 2206 2753 2200 2721 1721 2712 1719 2712 1632 2723 1128 2714 1126 2714 1123 2714 1089 2727 539 2727 541 2760"/>
                        </Shape>
                        <String CONTENT="Single beads on long leather strings are sewed to the clothes at various"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l37" HPOS="430" VPOS="2782" WIDTH="1774" HEIGHT="60" BASELINE="433 2818 2204 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2818 433 2842 2202 2827 2204 2810 2198 2782 430 2788 433 2818"/>
                        </Shape>
                        <String CONTENT="places, serving at the same time both as a charm and as an ornament. Women"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l38" HPOS="430" VPOS="2842" WIDTH="1776" HEIGHT="52" BASELINE="433 2877 2206 2872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 2877 433 2894 2204 2890 2206 2872 2195 2842 430 2844 433 2877"/>
                        </Shape>
                        <String CONTENT="frequently have a long pendant dangling from the front of their bodice down"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l39" HPOS="428" VPOS="2903" WIDTH="488" HEIGHT="47" BASELINE="430 2931 916 2935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="430 2931 428 2946 911 2950 916 2935 913 2907 430 2903 430 2931"/>
                        </Shape>
                        <String CONTENT="as low as the knees."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-337_r6" HPOS="388" VPOS="2961" WIDTH="1778" HEIGHT="243" TAGREFS="TYPE_2">
