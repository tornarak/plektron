                        <Polygon POINTS="388 2961 2166 2961 2166 3204 388 3204"/>
                    </Shape>
                    <TextLine ID="mz_1-337_l40" HPOS="537" VPOS="2957" WIDTH="1669" HEIGHT="56" BASELINE="539 2996 2206 2989" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="539 2996 539 3013 2204 3007 2206 2989 2200 2957 537 2961 539 2996"/>
                        </Shape>
                        <String CONTENT="In earlier times ivory beads and pendants were used for ear-rings and"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l41" HPOS="428" VPOS="3013" WIDTH="1776" HEIGHT="59" BASELINE="430 3056 2204 3050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="430 3056 430 3072 2202 3065 2204 3050 2200 3022 1022 3013 1020 3013 933 3024 474 3015 472 3015 469 3015 428 3026 430 3056"/>
                        </Shape>
                        <String CONTENT="other ornaments. I could find but a few of these, all of which are very care-"/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l42" HPOS="433" VPOS="3074" WIDTH="1771" HEIGHT="58" BASELINE="433 3115 2204 3115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="433 3115 433 3132 2204 3132 2204 3115 2204 3085 2176 3074 2174 3074 2172 3074 2169 3074 2130 3085 1275 3074 1273 3074 1271 3074 1245 3085 1204 3074 1201 3074 1199 3074 1117 3085 1069 3074 1067 3074 1065 3074 1063 3074 1061 3074 1043 3087 827 3087 801 3074 799 3074 796 3074 682 3085 647 3074 645 3074 643 3074 539 3085 450 3074 448 3074 446 3074 443 3074 433 3080 433 3115"/>
                        </Shape>
                        <String CONTENT="fully made, and seem to be only imitations of glass beads (Fig. 191, d)."/>
                    </TextLine>

                    <TextLine ID="mz_1-337_l43" HPOS="430" VPOS="3137" WIDTH="1772" HEIGHT="60" BASELINE="433 3178 2202 3169" TAGREFS="TYPE_5">
