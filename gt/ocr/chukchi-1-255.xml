                <TextBlock ID="text_1-255" HPOS="360" VPOS="625" WIDTH="1775" HEIGHT="2626"><TextLine ID="mz_1-255_l1" HPOS="942" VPOS="625" WIDTH="617" HEIGHT="54" BASELINE="942 660 1559 660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1527 625 1505 625 1484 625 1462 625 1440 625 1419 625 1397 625 1375 625 1354 625 1332 625 1310 625 1289 625 1267 625 1245 625 1224 625 1202 625 1180 625 1159 625 1137 625 1115 625 1094 625 1072 625 1050 625 1029 625 1007 625 986 625 964 625 942 625 942 660 942 679 1559 679 1559 660 1559 625 1549 625 1527 625"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l2" HPOS="2042" VPOS="634" WIDTH="83" HEIGHT="54" BASELINE="2042 671 2125 671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2107 638 2092 634 2051 634 2042 638 2042 671 2042 688 2125 688 2125 671 2125 643 2107 638"/>
                        </Shape>
                        <String CONTENT="199"/>
                    </TextLine>
<TextLine ID="mz_1-255_l3" HPOS="468" VPOS="734" WIDTH="1667" HEIGHT="49" BASELINE="470 766 2135 770" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 766 468 779 2131 783 2135 770 2133 738 470 734 470 766"/>
                        </Shape>
                        <String CONTENT="On the whole, vegetable food is much more used by women and children"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l4" HPOS="362" VPOS="788" WIDTH="1769" HEIGHT="63" BASELINE="364 831 2131 827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 831 364 846 2127 851 2131 827 2127 796 383 788 381 788 379 788 377 788 362 796 364 831"/>
                        </Shape>
                        <String CONTENT="than by men. In tales, men living in solitude are always described as hunting"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l5" HPOS="362" VPOS="848" WIDTH="1769" HEIGHT="61" BASELINE="364 892 2131 885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 892 364 909 2129 909 2131 885 2127 857 964 848 962 848 960 848 916 859 416 851 414 851 362 861 364 892"/>
                        </Shape>
                        <String CONTENT="animals and procuring animal food. A solitary woman is more frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l6" HPOS="362" VPOS="902" WIDTH="1769" HEIGHT="76" BASELINE="364 944 2131 952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 944 362 961 377 972 379 972 381 972 383 974 563 974 563 972 565 972 568 972 585 961 851 974 853 974 910 963 1295 976 1297 976 1300 976 1321 965 1373 976 1375 976 1488 965 1804 965 1824 978 1826 978 1828 978 1830 978 2129 970 2131 952 2131 920 2114 909 2112 909 2109 909 2019 909 2016 909 2014 909 2012 909 1999 920 1971 909 1969 909 1967 909 1174 915 1159 905 1157 905 1154 905 1152 905 858 915 827 905 825 905 823 905 821 905 819 905 806 915 765 902 762 902 760 902 758 902 732 915 583 915 568 902 565 902 563 902 561 902 559 902 557 902 539 913 490 902 487 902 485 902 483 902 468 913 394 902 392 902 390 902 364 911 364 944"/>
                        </Shape>
                        <String CONTENT="described as gathering herbs and roots, laying in stores of vegetable food,"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l7" HPOS="362" VPOS="967" WIDTH="1559" HEIGHT="57" BASELINE="364 1009 1921 1004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1009 364 1024 1919 1019 1921 1004 1917 967 433 967 431 967 362 978 364 1009"/>
                        </Shape>
                        <String CONTENT="and often it is told how she brings up on it several small children.¹"/>
                    </TextLine>
<TextLine ID="mz_1-255_l8" HPOS="468" VPOS="1032" WIDTH="1665" HEIGHT="61" BASELINE="470 1065 2133 1071" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 1065 468 1078 1040 1091 1042 1091 1536 1082 1594 1093 1596 1093 2131 1082 2133 1071 2131 1039 470 1032 470 1065"/>
                        </Shape>
                        <String CONTENT="DISHES. — The Chukchee bill of fare is not very varied. Boiled meat"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l9" HPOS="360" VPOS="1093" WIDTH="1771" HEIGHT="52" BASELINE="362 1125 2131 1130" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1125 360 1141 2127 1145 2131 1130 2129 1097 362 1093 362 1125"/>
                        </Shape>
                        <String CONTENT="forms the staple food, and the brisket is considered the best part of the animal."/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l10" HPOS="366" VPOS="1151" WIDTH="1765" HEIGHT="55" BASELINE="366 1186 2131 1186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1186 366 1206 2131 1206 2131 1186 2131 1158 366 1151 366 1186"/>
                        </Shape>
                        <String CONTENT="The head of the animal is generally eaten first; and the other parts are pre-"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l11" HPOS="362" VPOS="1203" WIDTH="1769" HEIGHT="70" BASELINE="364 1251 2131 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1251 364 1273 2129 1262 2131 1245 2127 1216 1951 1216 1928 1203 1925 1203 1923 1203 1921 1203 1919 1203 1902 1216 1655 1216 1590 1203 1588 1203 1585 1203 1538 1216 1497 1206 1494 1206 1492 1206 1250 1216 1180 1206 1178 1206 1176 1206 1144 1216 1131 1206 1128 1206 1126 1206 992 1206 990 1206 899 1219 834 1208 832 1208 570 1219 477 1208 474 1208 362 1221 364 1251"/>
                        </Shape>
                        <String CONTENT="pared in order, going backward along the body. There are a few more"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l12" HPOS="364" VPOS="1266" WIDTH="1771" HEIGHT="59" BASELINE="364 1307 2135 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1307 364 1325 2135 1325 2135 1307 2133 1273 1910 1277 1882 1266 1880 1266 1878 1266 1876 1266 1852 1277 1763 1266 1761 1266 1609 1277 1555 1266 1553 1266 1551 1266 1507 1277 1494 1266 1492 1266 1490 1266 1397 1266 1395 1266 1300 1277 1165 1266 1163 1266 1161 1266 1128 1277 1100 1266 1098 1266 1096 1266 1094 1266 1092 1266 1079 1277 1035 1266 1033 1266 1031 1266 1029 1266 999 1277 968 1266 966 1266 964 1266 901 1277 799 1266 797 1266 795 1266 793 1266 778 1279 691 1279 617 1266 615 1266 613 1266 611 1266 596 1279 464 1279 394 1266 392 1266 390 1266 364 1277 364 1307"/>
                        </Shape>
                        <String CONTENT="elaborate dishes. First of all is kiˊvlet, a kind of soup, which is made of"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l13" HPOS="362" VPOS="1322" WIDTH="1767" HEIGHT="65" BASELINE="364 1370 2129 1366" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1370 364 1385 2125 1387 2129 1366 2125 1335 1993 1335 1977 1322 1975 1322 1973 1322 1971 1322 1893 1333 1832 1322 1830 1322 1828 1322 1826 1322 1808 1333 1744 1322 1741 1322 1739 1322 1718 1333 1635 1322 1633 1322 1631 1322 1583 1335 1442 1335 1419 1322 1416 1322 1414 1322 1308 1333 1280 1322 1278 1322 1276 1322 1274 1322 1235 1338 1074 1338 1059 1325 1057 1325 1055 1325 1053 1325 1050 1325 1009 1335 914 1325 912 1325 910 1325 882 1335 808 1325 806 1325 804 1325 773 1335 745 1325 743 1325 741 1325 667 1335 646 1325 643 1325 641 1325 362 1331 364 1370"/>
                        </Shape>
                        <String CONTENT="blood mixed with fat, chopped guts, and edible roots if on hand. This soup"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l14" HPOS="360" VPOS="1383" WIDTH="1771" HEIGHT="63" BASELINE="362 1431 2131 1424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1431 362 1446 2129 1439 2131 1424 2127 1394 1683 1383 1681 1383 1527 1396 360 1396 362 1431"/>
                        </Shape>
                        <String CONTENT="is cooked in large quantities at all the principal ceremonials. It is used for"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l15" HPOS="360" VPOS="1446" WIDTH="1773" HEIGHT="58" BASELINE="362 1489 2133 1485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1489 362 1504 2131 1500 2133 1485 2129 1457 1254 1446 1252 1446 1250 1446 1248 1446 1230 1457 451 1448 448 1448 360 1459 362 1489"/>
                        </Shape>
                        <String CONTENT="sacrifices, and eaten by the guests as the chief course of the feast. Another"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l16" HPOS="362" VPOS="1502" WIDTH="1769" HEIGHT="61" BASELINE="364 1545 2131 1550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1545 362 1558 2127 1563 2131 1550 2129 1517 1780 1504 1778 1504 1577 1515 1546 1504 1544 1504 1542 1504 1458 1515 1406 1504 1403 1504 1401 1504 1373 1515 1317 1504 1315 1504 1313 1504 1274 1515 1248 1502 1245 1502 1243 1502 1131 1513 1079 1502 1076 1502 1074 1502 1048 1513 1025 1502 1022 1502 1020 1502 1018 1502 990 1513 964 1502 962 1502 960 1502 882 1515 771 1515 756 1502 754 1502 752 1502 749 1502 747 1502 715 1513 646 1502 643 1502 641 1502 620 1513 498 1502 496 1502 494 1502 492 1502 479 1513 438 1502 435 1502 433 1502 364 1511 364 1545"/>
                        </Shape>
                        <String CONTENT="dish is made of pounded flesh mixed with fat and roots and boiled with a"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l17" HPOS="362" VPOS="1578" WIDTH="864" HEIGHT="45" BASELINE="362 1608 1226 1608" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1608 362 1623 1226 1623 1226 1608 1226 1578 362 1578 362 1608"/>
                        </Shape>
                        <String CONTENT="small quantity of water into porridge."/>
                    </TextLine>
<TextLine ID="mz_1-255_l18" HPOS="466" VPOS="1621" WIDTH="1665" HEIGHT="61" BASELINE="468 1662 2131 1667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1662 466 1678 2127 1682 2131 1667 2131 1636 2101 1623 2099 1623 2097 1623 2094 1623 2066 1634 1707 1623 1705 1623 1620 1634 1590 1623 1588 1623 1585 1623 1490 1634 1442 1623 1440 1623 1438 1623 1308 1634 1295 1623 1295 1621 1293 1621 1291 1621 1289 1621 1235 1632 1139 1621 1137 1621 1135 1621 1105 1632 1079 1621 1076 1621 1074 1621 996 1632 968 1621 966 1621 964 1621 468 1630 468 1662"/>
                        </Shape>
                        <String CONTENT="Pounded meat mixed with fat, and sometimes also with edible roots, is"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l19" HPOS="360" VPOS="1691" WIDTH="1769" HEIGHT="56" BASELINE="362 1723 2129 1729" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1723 360 1736 2125 1747 2129 1729 2127 1697 362 1691 362 1723"/>
                        </Shape>
                        <String CONTENT="boiled in water, and then well kneaded and formed into large round balls,"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l20" HPOS="362" VPOS="1745" WIDTH="1771" HEIGHT="58" BASELINE="362 1788 2133 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1788 362 1803 2133 1803 2133 1788 2131 1749 1795 1755 1774 1745 1772 1745 1520 1745 1518 1745 1453 1755 1423 1745 1421 1745 1419 1745 1323 1755 1241 1745 1239 1745 1146 1755 1115 1745 1113 1745 1111 1745 1109 1745 1079 1755 1035 1745 1033 1745 1031 1745 1029 1745 1027 1745 1012 1758 925 1758 879 1745 877 1745 875 1745 873 1745 871 1745 856 1758 736 1758 639 1745 637 1745 565 1755 531 1745 529 1745 526 1745 524 1745 492 1755 405 1745 403 1745 401 1745 362 1755 362 1788"/>
                        </Shape>
                        <String CONTENT="which in winter are frozen hard, and form the chief travelling-provisions of"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l21" HPOS="360" VPOS="1803" WIDTH="1773" HEIGHT="61" BASELINE="362 1849 2133 1844" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1849 362 1864 2131 1859 2133 1844 2129 1816 2077 1803 2075 1803 2073 1803 2045 1814 2001 1803 1999 1803 1997 1803 1705 1814 1672 1803 1670 1803 1668 1803 1611 1814 1503 1803 1501 1803 1499 1803 1468 1816 1241 1816 1141 1805 1139 1805 1137 1805 1098 1816 1005 1805 1003 1805 801 1816 765 1805 762 1805 760 1805 685 1816 479 1805 477 1805 474 1805 440 1816 381 1805 379 1805 377 1805 375 1805 360 1814 362 1849"/>
                        </Shape>
                        <String CONTENT="the Chukchee. A man going alone on an expedition of any kind will take"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l22" HPOS="362" VPOS="1877" WIDTH="1771" HEIGHT="47" BASELINE="362 1907 2133 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1907 362 1924 2133 1924 2133 1907 2133 1877 362 1877 362 1907"/>
                        </Shape>
                        <String CONTENT="along a ball of frozen meat-pudding and a few sticks of frozen marrow. Meat-"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l23" HPOS="362" VPOS="1937" WIDTH="1771" HEIGHT="54" BASELINE="362 1968 2133 1968" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1968 362 1991 2133 1981 2133 1968 2133 1937 362 1937 362 1968"/>
                        </Shape>
                        <String CONTENT="pudding is prepared in quantity for ceremonials of a social character; for"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l24" HPOS="362" VPOS="1991" WIDTH="1771" HEIGHT="52" BASELINE="362 2028 2133 2028" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2028 362 2043 2133 2043 2133 2028 2133 1994 362 1991 362 2028"/>
                        </Shape>
                        <String CONTENT="instance, for weddings. It is the customary present which is interchanged"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l25" HPOS="360" VPOS="2043" WIDTH="1208" HEIGHT="61" BASELINE="362 2087 1568 2082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2087 362 2104 1566 2100 1568 2082 1564 2054 1237 2043 1235 2043 360 2054 362 2087"/>
                        </Shape>
                        <String CONTENT="between the families of the groom and of the bride."/>
                    </TextLine>
<TextLine ID="mz_1-255_l26" HPOS="468" VPOS="2113" WIDTH="1665" HEIGHT="49" BASELINE="470 2147 2133 2143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 2147 470 2162 2131 2158 2133 2143 2129 2115 468 2113 470 2147"/>
                        </Shape>
                        <String CONTENT="The Chukchee women do not care to prepare these dishes for every-day"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l27" HPOS="360" VPOS="2162" WIDTH="1771" HEIGHT="61" BASELINE="362 2208 2131 2204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2208 362 2223 2129 2219 2131 2204 2127 2173 1245 2162 1243 2162 1241 2162 1239 2162 1224 2173 568 2165 565 2165 360 2175 362 2208"/>
                        </Shape>
                        <String CONTENT="consumption, especially because boiled reindeer-meat is, after all, the dish"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l28" HPOS="362" VPOS="2223" WIDTH="1771" HEIGHT="61" BASELINE="362 2269 2133 2269" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2269 362 2284 2133 2284 2133 2269 2133 2236 1977 2236 1954 2223 1951 2223 1949 2223 1871 2234 1793 2223 1791 2223 1724 2234 1692 2223 1689 2223 1687 2223 1685 2223 1657 2234 1590 2223 1588 2223 1536 2234 1488 2223 1486 2223 1484 2223 1481 2223 1453 2234 1432 2223 1429 2223 1427 2223 1425 2223 1401 2234 1310 2223 1308 2223 1235 2234 1211 2223 1209 2223 1206 2223 1150 2234 1105 2223 1102 2223 1100 2223 1098 2223 1068 2236 929 2236 914 2223 912 2223 910 2223 908 2223 905 2223 882 2234 762 2223 760 2223 682 2234 646 2223 643 2223 641 2223 639 2223 615 2234 602 2223 600 2223 598 2223 596 2223 594 2223 565 2234 362 2232 362 2269"/>
                        </Shape>
                        <String CONTENT="best to their liking. Among the Koryak and the Kamchadal, puddings are"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l29" HPOS="360" VPOS="2279" WIDTH="1769" HEIGHT="72" BASELINE="362 2331 2129 2323" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2331 362 2351 2127 2342 2129 2323 2125 2292 1876 2292 1856 2279 1854 2279 1852 2279 1850 2279 1772 2290 1750 2279 1748 2279 1746 2279 1744 2279 1741 2279 1728 2290 1700 2279 1698 2279 1696 2279 1694 2279 1692 2279 1676 2292 1378 2282 1375 2282 1280 2292 1248 2282 1245 2282 1243 2282 1241 2282 1213 2295 1180 2284 1178 2284 1176 2284 1107 2295 1048 2284 1046 2284 957 2295 780 2286 778 2286 775 2286 747 2297 537 2286 535 2286 360 2299 362 2331"/>
                        </Shape>
                        <String CONTENT="prepared chiefly of roots, stalks of herbs, and berries pounded and mixed with"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l30" HPOS="364" VPOS="2355" WIDTH="1769" HEIGHT="48" BASELINE="364 2385 2133 2385" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2385 364 2403 2133 2403 2133 2385 2133 2355 364 2355 364 2385"/>
                        </Shape>
                        <String CONTENT="oil; but the country of the Chukchee is too poor to yield vegetable food in"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l31" HPOS="360" VPOS="2405" WIDTH="1775" HEIGHT="58" BASELINE="362 2446 2135 2440" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2446 362 2463 2133 2457 2135 2440 2131 2405 418 2405 416 2405 360 2416 362 2446"/>
                        </Shape>
                        <String CONTENT="sufficient quantities. For sacrificial purposes, however, puddings are made of"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l32" HPOS="362" VPOS="2461" WIDTH="1773" HEIGHT="70" BASELINE="364 2507 2135 2500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2507 364 2531 2133 2518 2135 2500 2131 2472 1544 2461 1542 2461 1540 2461 1518 2472 1009 2463 1007 2463 362 2476 364 2507"/>
                        </Shape>
                        <String CONTENT="pounded leaves and herbs of the plants named, and on these occasions some"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l33" HPOS="360" VPOS="2531" WIDTH="859" HEIGHT="58" BASELINE="362 2561 1219 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2561 360 2576 396 2589 399 2589 401 2589 1217 2580 1219 2565 1217 2535 362 2531 362 2561"/>
                        </Shape>
                        <String CONTENT="such pudding is eaten by the people."/>
                    </TextLine>
<TextLine ID="mz_1-255_l34" HPOS="470" VPOS="2578" WIDTH="1665" HEIGHT="61" BASELINE="472 2626 2135 2621" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="472 2626 472 2639 2133 2634 2135 2621 2133 2591 2084 2578 2081 2578 2079 2578 2008 2589 1928 2578 1925 2578 1923 2578 1897 2589 1830 2578 1828 2578 1826 2578 1824 2578 1806 2589 1763 2578 1761 2578 1759 2578 1756 2578 1735 2589 1718 2578 1715 2578 1713 2578 1711 2578 1642 2589 1603 2578 1601 2578 1598 2578 1596 2578 1553 2589 1494 2578 1492 2578 1432 2589 1287 2580 1284 2580 1282 2580 1280 2580 1267 2591 1254 2580 1252 2580 1250 2580 1248 2580 1245 2580 1222 2591 1198 2580 1196 2580 1193 2580 1191 2580 1144 2593 1033 2593 1020 2580 1018 2580 1016 2580 1014 2580 1012 2580 975 2591 910 2580 908 2580 905 2580 875 2593 708 2593 685 2580 682 2580 680 2580 470 2587 472 2626"/>
                        </Shape>
                        <String CONTENT="The ordinary meals of the Chukchee consist of solid food only. Like"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l35" HPOS="360" VPOS="2641" WIDTH="1773" HEIGHT="58" BASELINE="362 2686 2133 2682" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2686 362 2699 2131 2695 2133 2682 2131 2652 2114 2641 2112 2641 2109 2641 2107 2641 2045 2652 1795 2641 1793 2641 1791 2641 1789 2641 1774 2654 1670 2654 1564 2641 1562 2641 1559 2641 1523 2652 1438 2641 1436 2641 1375 2652 1248 2641 1245 2641 1243 2641 1215 2654 736 2643 734 2643 672 2654 596 2643 594 2643 526 2654 468 2643 466 2643 464 2643 442 2654 390 2643 388 2643 386 2643 360 2654 362 2686"/>
                        </Shape>
                        <String CONTENT="all the other tribes of northeastern Siberia, they drink tea after the meal."/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l36" HPOS="360" VPOS="2699" WIDTH="1775" HEIGHT="72" BASELINE="362 2747 2135 2741" TAGREFS="TYPE_5">
                        <Shape>
