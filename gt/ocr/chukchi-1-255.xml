                        </Shape>
                        <String CONTENT="Broth is taken afterwards as a cold drink, for which purpose it is often"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l37" HPOS="360" VPOS="2760" WIDTH="1773" HEIGHT="61" BASELINE="362 2808 2133 2801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2808 362 2821 2131 2816 2133 2801 2129 2773 2060 2760 2058 2760 2055 2760 2025 2771 1902 2760 1899 2760 1897 2760 1895 2760 1878 2773 1726 2773 1592 2760 1590 2760 1588 2760 1538 2773 1079 2762 1076 2762 1074 2762 1072 2762 1057 2773 682 2764 680 2764 678 2764 637 2775 572 2764 570 2764 568 2764 524 2775 438 2764 435 2764 360 2777 362 2808"/>
                        </Shape>
                        <String CONTENT="cooled with slabs of snow. According to reports of former travellers, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l38" HPOS="360" VPOS="2823" WIDTH="1773" HEIGHT="60" BASELINE="360 2866 2133 2862" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2866 360 2883 2131 2883 2133 2862 2129 2834 1269 2823 1267 2823 1265 2823 1241 2834 403 2825 401 2825 399 2825 370 2831 360 2866"/>
                        </Shape>
                        <String CONTENT="ate much snow to quench the thirst; but, owing to the introduction of tea,"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l39" HPOS="360" VPOS="2883" WIDTH="1018" HEIGHT="57" BASELINE="362 2925 1378 2920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2925 362 2940 1375 2938 1378 2920 1373 2892 377 2883 375 2883 373 2883 370 2883 360 2890 362 2925"/>
                        </Shape>
                        <String CONTENT="this custom has fallen off to a great extent."/>
                    </TextLine>
<TextLine ID="mz_1-255_l40" HPOS="472" VPOS="2948" WIDTH="1663" HEIGHT="59" BASELINE="474 2987 2135 2979" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="474 2987 474 3000 1707 3007 1709 3007 1960 2996 2116 3005 2118 3005 2120 3005 2122 3005 2135 2994 2135 2979 2131 2948 472 2948 474 2987"/>
                        </Shape>
                        <String CONTENT="TEA, TOBACCO, AND OTHER FOODS. — The people of northeastern Siberia"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l41" HPOS="360" VPOS="3005" WIDTH="1773" HEIGHT="56" BASELINE="362 3044 2133 3037" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 3044 362 3061 2131 3054 2133 3037 2127 3005 360 3013 362 3044"/>
                        </Shape>
                        <String CONTENT="use compressed “brick tea” almost exclusively, and drink it very strong and"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l42" HPOS="364" VPOS="3061" WIDTH="1769" HEIGHT="58" BASELINE="364 3102 2133 3102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 3102 364 3119 2133 3119 2133 3102 2133 3074 2025 3061 2023 3061 1899 3072 1808 3061 1806 3061 1728 3072 1681 3061 1679 3061 1676 3061 1596 3072 1403 3061 1401 3061 1399 3061 1373 3072 1306 3061 1304 3061 1239 3072 1124 3061 1122 3061 1009 3072 964 3061 962 3061 960 3061 957 3061 929 3072 899 3061 897 3061 895 3061 892 3061 856 3072 736 3061 734 3061 732 3061 708 3072 695 3061 693 3061 691 3061 689 3061 687 3061 656 3072 570 3061 568 3061 565 3061 544 3072 470 3061 468 3061 364 3067 364 3102"/>
                        </Shape>
                        <String CONTENT="black, when their supply is sufficient. They have no milk, and practically no"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l43" HPOS="362" VPOS="3119" WIDTH="1769" HEIGHT="63" BASELINE="364 3165 2131 3161" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 3165 364 3182 2131 3178 2131 3161 2127 3130 1291 3119 1289 3119 1287 3119 1241 3130 635 3122 633 3122 362 3132 364 3165"/>
                        </Shape>
                        <String CONTENT="sugar; nor do they add tallow or rye-meal, as do the people of southern Siberia."/>
                    </TextLine>
