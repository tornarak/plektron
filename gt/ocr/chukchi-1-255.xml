                        </Shape>
                        <String CONTENT="TEA, TOBACCO, AND OTHER FOODS. — The people of northeastern Siberia"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l41" HPOS="381" VPOS="3020" WIDTH="1773" HEIGHT="56" BASELINE="383 3059 2154 3052" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 3059 383 3076 2152 3069 2154 3052 2148 3020 381 3028 383 3059"/>
                        </Shape>
                        <String CONTENT="use compressed “brick tea” almost exclusively, and drink it very strong and"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l42" HPOS="385" VPOS="3076" WIDTH="1769" HEIGHT="58" BASELINE="385 3117 2154 3117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="385 3117 385 3134 2154 3134 2154 3117 2154 3089 2046 3076 2044 3076 1920 3087 1829 3076 1827 3076 1749 3087 1702 3076 1700 3076 1697 3076 1617 3087 1424 3076 1422 3076 1420 3076 1394 3087 1327 3076 1325 3076 1260 3087 1145 3076 1143 3076 1030 3087 985 3076 983 3076 981 3076 978 3076 950 3087 920 3076 918 3076 916 3076 913 3076 877 3087 757 3076 755 3076 753 3076 729 3087 716 3076 714 3076 712 3076 710 3076 708 3076 677 3087 591 3076 589 3076 586 3076 565 3087 491 3076 489 3076 385 3082 385 3117"/>
                        </Shape>
                        <String CONTENT="black, when their supply is sufficient. They have no milk, and practically no"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l43" HPOS="383" VPOS="3134" WIDTH="1769" HEIGHT="63" BASELINE="385 3180 2152 3176" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="385 3180 385 3197 2152 3193 2152 3176 2148 3145 1312 3134 1310 3134 1308 3134 1262 3145 656 3137 654 3137 383 3147 385 3180"/>
                        </Shape>
                        <String CONTENT="sugar; nor do they add tallow or rye-meal, as do the people of southern Siberia."/>
                    </TextLine>
