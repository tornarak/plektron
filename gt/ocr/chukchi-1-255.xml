                        </Shape>
                        <String CONTENT="The ordinary meals of the Chukchee consist of solid food only. Like"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l35" HPOS="381" VPOS="2656" WIDTH="1773" HEIGHT="58" BASELINE="383 2701 2154 2697" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 2701 383 2714 2152 2710 2154 2697 2152 2667 2135 2656 2133 2656 2130 2656 2128 2656 2066 2667 1816 2656 1814 2656 1812 2656 1810 2656 1795 2669 1691 2669 1585 2656 1583 2656 1580 2656 1544 2667 1459 2656 1457 2656 1396 2667 1269 2656 1266 2656 1264 2656 1236 2669 757 2658 755 2658 693 2669 617 2658 615 2658 547 2669 489 2658 487 2658 485 2658 463 2669 411 2658 409 2658 407 2658 381 2669 383 2701"/>
                        </Shape>
                        <String CONTENT="all the other tribes of northeastern Siberia, they drink tea after the meal."/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l36" HPOS="381" VPOS="2714" WIDTH="1775" HEIGHT="72" BASELINE="383 2762 2156 2756" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 2762 383 2775 968 2784 970 2784 972 2784 1002 2773 1282 2773 1297 2784 1299 2784 1301 2784 1303 2786 1418 2786 1418 2784 1420 2784 1442 2773 1496 2784 1498 2784 1500 2784 1502 2784 1518 2773 2154 2773 2156 2756 2152 2727 2085 2714 2083 2714 2081 2714 2042 2725 1907 2714 1905 2714 1903 2714 1901 2714 1886 2727 1669 2727 1576 2714 1574 2714 1572 2714 1539 2727 1474 2717 1472 2717 1470 2717 1440 2727 1388 2717 1386 2717 1290 2727 1262 2717 1260 2717 1258 2717 1169 2730 996 2730 981 2717 978 2717 976 2717 974 2717 972 2717 926 2727 381 2727 383 2762"/>
                        </Shape>
                        <String CONTENT="Broth is taken afterwards as a cold drink, for which purpose it is often"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l37" HPOS="381" VPOS="2775" WIDTH="1773" HEIGHT="61" BASELINE="383 2823 2154 2816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 2823 383 2836 2152 2831 2154 2816 2150 2788 2081 2775 2079 2775 2076 2775 2046 2786 1923 2775 1920 2775 1918 2775 1916 2775 1899 2788 1747 2788 1613 2775 1611 2775 1609 2775 1559 2788 1100 2777 1097 2777 1095 2777 1093 2777 1078 2788 703 2779 701 2779 699 2779 658 2790 593 2779 591 2779 589 2779 545 2790 459 2779 456 2779 381 2792 383 2823"/>
                        </Shape>
                        <String CONTENT="cooled with slabs of snow. According to reports of former travellers, they"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l38" HPOS="381" VPOS="2838" WIDTH="1773" HEIGHT="60" BASELINE="381 2881 2154 2877" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2881 381 2898 2152 2898 2154 2877 2150 2849 1290 2838 1288 2838 1286 2838 1262 2849 424 2840 422 2840 420 2840 391 2846 381 2881"/>
                        </Shape>
                        <String CONTENT="ate much snow to quench the thirst; but, owing to the introduction of tea,"/>
                    </TextLine>

                    <TextLine ID="mz_1-255_l39" HPOS="381" VPOS="2898" WIDTH="1018" HEIGHT="57" BASELINE="383 2940 1399 2935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 2940 383 2955 1396 2953 1399 2935 1394 2907 398 2898 396 2898 394 2898 391 2898 381 2905 383 2940"/>
                        </Shape>
                        <String CONTENT="this custom has fallen off to a great extent."/>
                    </TextLine>
