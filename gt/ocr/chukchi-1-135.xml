                        </Shape>
                        <String CONTENT="be carefully tied up and kept for a day or two with very little food, or even"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l15" HPOS="359" VPOS="1463" WIDTH="1774" HEIGHT="58" BASELINE="361 1506 2133 1502" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1506 361 1521 2130 1517 2133 1502 2128 1474 1249 1463 1247 1463 1245 1463 1204 1474 402 1465 400 1465 398 1465 359 1476 361 1506"/>
                        </Shape>
                        <String CONTENT="without any, according to the amount of fat they have accumulated. Dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l16" HPOS="359" VPOS="1530" WIDTH="1776" HEIGHT="52" BASELINE="361 1567 2135 1560" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1567 361 1582 2133 1578 2135 1560 2128 1530 359 1532 361 1567"/>
                        </Shape>
                        <String CONTENT="harnessed too soon will be spoiled for the whole winter, being unable to endure"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l17" HPOS="359" VPOS="1593" WIDTH="1771" HEIGHT="50" BASELINE="361 1628 2130 1621" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 1628 361 1643 2128 1636 2130 1621 2126 1593 359 1593 361 1628"/>
                        </Shape>
                        <String CONTENT="long, fast runs. Dogs are harnessed in the first autumn of their lives, often"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l18" HPOS="357" VPOS="1638" WIDTH="1776" HEIGHT="74" BASELINE="359 1688 2133 1680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1688 359 1701 597 1712 599 1712 602 1712 604 1712 621 1701 788 1710 790 1710 1076 1699 1193 1710 1195 1710 1321 1697 1472 1708 1474 1708 2130 1695 2133 1680 2128 1651 1949 1638 1946 1638 1944 1638 1914 1649 1886 1638 1884 1638 1881 1638 1879 1638 1877 1638 1862 1651 1754 1651 1726 1638 1723 1638 1721 1638 1719 1638 1671 1651 1643 1641 1641 1641 1639 1641 1637 1641 1611 1651 1364 1641 1362 1641 1360 1641 1357 1641 1340 1651 1217 1643 1214 1643 1212 1643 1182 1654 965 1643 963 1643 911 1654 859 1643 857 1643 794 1656 400 1645 398 1645 396 1645 357 1656 359 1688"/>
                        </Shape>
                        <String CONTENT="when only two months old. Sometimes the female dog is attached in the"/>
                    </TextLine>

