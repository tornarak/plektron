                        <Shape>
                            <Polygon POINTS="361 1266 361 1283 2130 1279 2133 1262 2128 1234 1264 1223 1262 1223 1145 1234 385 1225 383 1225 381 1225 359 1234 361 1266"/>
                        </Shape>
                        <String CONTENT="the Kolyma country, for instance, they live on mice and spermophiles; on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l12" HPOS="359" VPOS="1296" WIDTH="1213" HEIGHT="46" BASELINE="359 1324 1572 1324" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1324 359 1342 1572 1342 1572 1324 1572 1296 359 1296 359 1324"/>
