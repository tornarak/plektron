                    <TextLine ID="mz_1-135_l13" HPOS="472" VPOS="1355" WIDTH="1661" HEIGHT="47" BASELINE="472 1385 2133 1385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 1385 472 1402 2133 1402 2133 1385 2133 1355 472 1355 472 1385"/>
                        </Shape>
                        <String CONTENT="After the summer rest, the dogs, before being put into harness, have to"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l14" HPOS="357" VPOS="1402" WIDTH="1776" HEIGHT="59" BASELINE="359 1446 2133 1441" TAGREFS="TYPE_4">
                        <Shape>
