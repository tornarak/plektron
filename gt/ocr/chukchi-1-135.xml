<Shape>
                        <Polygon POINTS="359 1886 2137 1886 2137 2910 359 2910"/>
                    </Shape>
                    <TextLine ID="mz_1-135_l22" HPOS="469" VPOS="1877" WIDTH="1664" HEIGHT="69" BASELINE="472 1929 2133 1918" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 1929 472 1942 1790 1946 1793 1946 1795 1946 1840 1935 2111 1944 2113 1944 2115 1944 2118 1944 2133 1933 2133 1918 2128 1890 2055 1877 2053 1877 1953 1887 1929 1877 1927 1877 1925 1877 1923 1877 1920 1877 1905 1890 1799 1890 1780 1879 1777 1879 1775 1879 1773 1879 1771 1879 1743 1892 1518 1892 1492 1879 1489 1879 1487 1879 1485 1879 1483 1879 1463 1892 1373 1881 1370 1881 1368 1881 1344 1892 1249 1881 1247 1881 1245 1881 1214 1892 469 1892 472 1929"/>
                        </Shape>
                        <String CONTENT="The females are good leaders; but, since they are weaker and smaller"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l23" HPOS="357" VPOS="1939" WIDTH="1773" HEIGHT="63" BASELINE="359 1987 2130 1978" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1987 359 2002 2128 1996 2130 1978 2126 1950 1693 1939 1691 1939 1689 1939 1687 1939 1674 1950 378 1946 376 1946 374 1946 372 1946 357 1952 359 1987"/>
                        </Shape>
                        <String CONTENT="than the males, they are not good for drawing heavy loads. The males are"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l24" HPOS="355" VPOS="2000" WIDTH="1773" HEIGHT="67" BASELINE="357 2050 2128 2043" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2050 357 2067 2126 2067 2128 2043 2124 2011 1977 2000 1975 2000 1888 2011 1864 2000 1862 2000 1860 2000 1858 2000 1855 2000 1836 2013 1702 2013 1624 2000 1622 2000 1528 2015 1284 2015 1251 2002 1249 2002 1247 2002 1095 2013 1007 2002 1004 2002 1002 2002 1000 2002 985 2013 734 2004 731 2004 630 2015 571 2004 569 2004 567 2004 530 2015 517 2004 515 2004 513 2004 420 2004 417 2004 355 2015 357 2050"/>
                        </Shape>
                        <String CONTENT="gelded with an iron knife. The operation, contrary to that upon the reindeer,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l25" HPOS="329" VPOS="2063" WIDTH="1801" HEIGHT="58" BASELINE="329 2104 2130 2104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="329 2104 329 2121 2130 2121 2130 2104 2130 2076 1994 2063 1864 2063 1862 2063 1860 2063 1858 2063 1842 2074 1767 2063 1765 2063 1762 2063 1728 2074 1695 2063 1693 2063 1691 2063 1689 2063 1645 2074 1606 2063 1604 2063 1602 2063 1600 2063 1554 2074 1487 2063 1485 2063 1405 2074 1331 2063 1329 2063 1327 2063 1295 2074 1258 2063 1256 2063 1253 2063 1251 2063 1214 2074 1117 2063 1115 2063 1113 2063 1080 2074 1022 2063 1020 2063 1017 2063 987 2074 883 2063 881 2063 879 2063 855 2074 805 2063 803 2063 718 2074 329 2067 329 2104"/>
                        </Shape>
                        <String CONTENT="requires some skill, since the fat male dog will easily die from bleeding or"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l26" HPOS="350" VPOS="2128" WIDTH="1783" HEIGHT="52" BASELINE="353 2167 2133 2160" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2167 353 2180 2130 2175 2133 2160 2128 2132 350 2128 353 2167"/>
                        </Shape>
                        <String CONTENT="inflammation. On the Kolyma, the operators assert that they can cause the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l27" HPOS="359" VPOS="2184" WIDTH="1771" HEIGHT="61" BASELINE="361 2227 2130 2223" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2227 361 2242 2126 2245 2130 2223 2126 2195 1245 2184 1243 2184 1240 2184 1206 2195 420 2186 417 2186 359 2197 361 2227"/>
                        </Shape>
                        <String CONTENT="animal operated on to assume afterward whatever pace they like, — trot, canter,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l28" HPOS="359" VPOS="2240" WIDTH="1774" HEIGHT="65" BASELINE="361 2288 2133 2279" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2288 361 2305 2130 2297 2133 2279 2128 2251 1689 2240 1687 2240 1684 2240 1682 2240 1665 2251 818 2245 816 2245 814 2245 812 2245 796 2255 491 2247 489 2247 359 2258 361 2288"/>
                        </Shape>
                        <String CONTENT="or gallop. On the Pacific side there is no occasion for such assertion, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l29" HPOS="361" VPOS="2305" WIDTH="1774" HEIGHT="65" BASELINE="363 2349 2135 2340" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2349 363 2362 1243 2370 1245 2370 1247 2370 1284 2359 1676 2368 1678 2368 1680 2368 1682 2368 1682 2366 1693 2357 2115 2366 2118 2366 2120 2366 2122 2366 2135 2355 2135 2340 2130 2312 814 2305 812 2305 809 2305 807 2305 790 2316 381 2307 378 2307 376 2307 374 2307 361 2314 363 2349"/>
                        </Shape>
                        <String CONTENT="the dogs are not allowed to go at any swifter pace than a brisk trot. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l30" HPOS="361" VPOS="2357" WIDTH="1772" HEIGHT="67" BASELINE="363 2407 2133 2398" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2407 363 2424 2130 2416 2133 2398 2130 2370 2096 2357 2094 2357 2092 2357 1875 2368 1845 2357 1842 2357 1840 2357 1838 2357 1808 2368 1769 2357 1767 2357 1765 2357 1762 2357 1743 2368 1721 2357 1719 2357 1717 2357 1715 2357 1684 2370 1522 2359 1520 2359 1450 2370 1420 2359 1418 2359 1416 2359 1360 2370 1321 2359 1318 2359 1316 2359 1230 2372 1214 2362 1212 2362 1210 2362 1208 2362 1206 2362 1178 2372 1000 2362 998 2362 933 2372 868 2362 866 2362 757 2375 727 2364 725 2364 723 2364 437 2375 374 2364 372 2364 370 2364 368 2364 368 2366 361 2370 363 2407"/>
                        </Shape>
                        <String CONTENT="Kamchadal and the Koryak crop the tails of their dogs, believing that this"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l31" HPOS="361" VPOS="2418" WIDTH="1767" HEIGHT="65" BASELINE="363 2468 2128 2459" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2468 363 2483 2126 2478 2128 2459 2124 2431 2033 2418 2031 2418 2029 2418 2027 2418 2011 2431 1849 2431 1806 2418 1803 2418 1801 2418 1741 2429 1710 2418 1708 2418 1706 2418 1704 2418 1702 2418 1684 2431 1671 2420 1669 2420 1667 2420 1665 2420 1663 2420 1635 2431 1515 2420 1513 2420 1511 2420 1479 2431 1409 2420 1407 2420 1301 2431 1269 2420 1266 2420 1264 2420 1262 2420 1260 2420 1240 2433 1160 2422 1158 2422 929 2433 894 2422 892 2422 890 2422 790 2435 747 2424 744 2424 742 2424 511 2435 404 2424 402 2424 400 2424 361 2437 363 2468"/>
                        </Shape>
                        <String CONTENT="will increase their speed. Disobedient dogs often have their tails cropped on"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l32" HPOS="359" VPOS="2485" WIDTH="1774" HEIGHT="58" BASELINE="361 2528 2133 2520" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2528 361 2543 2130 2535 2133 2520 2128 2489 385 2485 383 2485 381 2485 359 2494 361 2528"/>
                        </Shape>
                        <String CONTENT="the road, and have to go till evening, the blood trickling all the while. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l33" HPOS="359" VPOS="2543" WIDTH="1774" HEIGHT="61" BASELINE="361 2589 2133 2578" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="361 2589 361 2604 2130 2593 2133 2578 2128 2550 1069 2543 1067 2543 987 2554 378 2548 376 2548 374 2548 372 2548 359 2554 361 2589"/>
                        </Shape>
                        <String CONTENT="team-dogs serve till ten or twelve years old. After the sixth or seventh year"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l34" HPOS="361" VPOS="2602" WIDTH="1769" HEIGHT="60" BASELINE="363 2647 1953 2641 2130 2647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2647 363 2660 2126 2662 2130 2647 2128 2610 965 2602 963 2602 961 2602 924 2613 387 2604 385 2604 383 2604 361 2613 363 2647"/>
                        </Shape>
                        <String CONTENT="they begin to decline. Contrary to what has been said of the Eskimo dog,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l35" HPOS="361" VPOS="2660" WIDTH="1765" HEIGHT="63" BASELINE="363 2708 2126 2699" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="363 2708 363 2723 2124 2719 2126 2699 2120 2660 1334 2671 1303 2660 1301 2660 1299 2660 1234 2673 1108 2662 1106 2662 881 2673 844 2662 842 2662 840 2662 751 2675 487 2665 485 2665 482 2665 439 2675 383 2665 381 2665 378 2665 376 2665 361 2673 363 2708"/>
                        </Shape>
                        <String CONTENT="the Asiatic harness-dogs are sullen, and care little about their masters. I"/>
                    </TextLine>

