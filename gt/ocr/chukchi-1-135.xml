                        </Shape>
                        <String CONTENT="released for the summer, and are not fed at all, because the seal-catch is not"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l9" HPOS="357" VPOS="1106" WIDTH="1773" HEIGHT="56" BASELINE="359 1149 2130 1143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="359 1149 359 1162 2128 1158 2130 1143 2126 1112 391 1106 389 1106 387 1106 357 1117 359 1149"/>
                        </Shape>
                        <String CONTENT="abundant; then they live on such scraps as they can secure. During the"/>
                    </TextLine>

