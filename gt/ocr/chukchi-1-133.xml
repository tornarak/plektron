                <TextBlock ID="text_1-133" HPOS="355" VPOS="599" WIDTH="1780" HEIGHT="2642"><TextLine ID="mz_1-133_l1" HPOS="931" VPOS="599" WIDTH="624" HEIGHT="54" BASELINE="934 632 1555 636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1542 599 1243 599 1237 599 1215 599 1193 599 1172 599 1150 599 1128 599 1107 599 1085 599 1063 599 1042 599 1020 599 999 599 977 599 955 599 934 599 934 632 931 649 1551 653 1555 636 1553 610 1542 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l2" HPOS="2036" VPOS="610" WIDTH="93" HEIGHT="46" BASELINE="2036 640 2129 640" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2122 615 2101 612 2079 610 2058 610 2036 610 2036 640 2036 656 2129 656 2129 640 2129 638 2122 615"/>
                        </Shape>
                        <String CONTENT="101"/>
                    </TextLine>
<TextLine ID="mz_1-133_l3" HPOS="357" VPOS="714" WIDTH="1776" HEIGHT="48" BASELINE="357 747 2133 747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="466 714 444 716 422 716 401 716 379 718 357 718 357 747 357 762 2133 762 2133 747 2133 714 487 714 466 714"/>
                        </Shape>
                        <String CONTENT="are told of experiences in harnessing young wolves. One Russianized Yukaghir"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l4" HPOS="360" VPOS="775" WIDTH="1773" HEIGHT="47" BASELINE="360 805 2133 805" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 805 360 822 2133 822 2133 805 2133 775 360 775 360 805"/>
                        </Shape>
                        <String CONTENT="told me that his own grandfather tried to harness tame wolves, but that they"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l5" HPOS="357" VPOS="820" WIDTH="1776" HEIGHT="69" BASELINE="360 868 2133 861" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 868 360 889 2131 879 2133 861 2129 831 1958 820 1956 820 1858 831 1826 820 1824 820 1821 820 1819 820 1778 831 1737 820 1735 820 1733 820 1731 820 1709 831 1672 820 1670 820 1668 820 1666 820 1624 831 1429 822 1427 822 1334 833 1304 822 1302 822 1300 822 1209 833 1146 822 1144 822 1141 822 1139 822 1120 833 760 825 758 825 697 835 613 825 611 825 539 835 500 825 498 825 496 825 357 838 360 868"/>
                        </Shape>
                        <String CONTENT="proved useless. They were too shy, and would frequently lie down flat and"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l6" HPOS="357" VPOS="885" WIDTH="1776" HEIGHT="56" BASELINE="360 926 2133 922" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 926 360 941 2131 939 2133 922 2129 892 386 885 383 885 381 885 357 894 360 926"/>
                        </Shape>
                        <String CONTENT="allow themselves to be dragged by the team. Moreover, the amount of food"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l7" HPOS="357" VPOS="941" WIDTH="1772" HEIGHT="61" BASELINE="360 987 2129 983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 987 360 1002 2127 1002 2129 983 2125 954 2049 941 2047 941 2045 941 2023 952 1960 941 1958 941 1956 941 1930 952 1867 941 1865 941 1798 952 1782 941 1780 941 1778 941 1776 941 1774 941 1728 952 1635 941 1633 941 1631 941 1605 952 1219 944 1217 944 1215 944 1213 944 1196 954 1092 944 1089 944 1087 944 1050 954 819 944 817 944 814 944 773 954 678 944 676 944 674 944 637 954 459 944 457 944 357 957 360 987"/>
                        </Shape>
                        <String CONTENT="required by them daily was three times as much as is needed by the dog."/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l8" HPOS="360" VPOS="1002" WIDTH="1771" HEIGHT="61" BASELINE="362 1048 2131 1041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1048 362 1063 2129 1056 2131 1041 2127 1011 951 1002 949 1002 947 1002 921 1013 379 1004 377 1004 375 1004 373 1004 360 1011 362 1048"/>
                        </Shape>
                        <String CONTENT="According to the belief of the Russianized natives of the Kolyma, the “forest-"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l9" HPOS="362" VPOS="1073" WIDTH="1767" HEIGHT="57" BASELINE="362 1104 2129 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1104 362 1117 494 1130 496 1130 498 1130 529 1119 667 1130 669 1130 903 1119 1009 1130 1012 1130 1079 1119 1245 1130 1248 1130 1250 1130 1282 1119 1551 1119 1598 1130 1601 1130 1603 1130 1689 1119 2127 1119 2129 1104 2127 1073 362 1073 362 1104"/>
                        </Shape>
                        <String CONTENT="owner,” a supernatural being,¹ drives, instead of dogs, foxes and wolves."/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l10" HPOS="360" VPOS="1125" WIDTH="1570" HEIGHT="55" BASELINE="362 1160 1930 1164" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1160 360 1175 1925 1180 1930 1164 1928 1134 362 1125 362 1160"/>
                        </Shape>
                        <String CONTENT="Perhaps this belief accounts for the amplification of the above story."/>
                    </TextLine>
<TextLine ID="mz_1-133_l11" HPOS="468" VPOS="1180" WIDTH="1661" HEIGHT="65" BASELINE="470 1223 2129 1227" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="470 1223 468 1236 2125 1245 2129 1227 2127 1195 1817 1182 1815 1182 1694 1193 1659 1182 1657 1182 1655 1182 1653 1182 1614 1193 1585 1182 1583 1182 1581 1182 1525 1193 1488 1182 1486 1182 1484 1182 1481 1182 1445 1193 1399 1182 1397 1182 1395 1182 1393 1182 1356 1193 1345 1182 1343 1182 1341 1182 1339 1182 1256 1190 1239 1180 1237 1180 1235 1180 1232 1180 1178 1190 1126 1180 1124 1180 1122 1180 1094 1190 1076 1180 1074 1180 1072 1180 1070 1180 1068 1180 1020 1190 931 1180 929 1180 875 1190 860 1180 858 1180 856 1180 853 1180 851 1180 849 1180 832 1190 806 1180 804 1180 801 1180 799 1180 752 1190 691 1180 689 1180 687 1180 661 1190 470 1190 470 1223"/>
                        </Shape>
                        <String CONTENT="Among the Chukchee and the Koryak the dog is also used for sacrifice,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l12" HPOS="355" VPOS="1240" WIDTH="1778" HEIGHT="61" BASELINE="357 1286 2133 1281" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1286 357 1301 2131 1296 2133 1281 2129 1253 1958 1240 1956 1240 1850 1251 1819 1240 1817 1240 1815 1240 1813 1240 1811 1240 1793 1253 1538 1253 1475 1240 1473 1240 1371 1251 1356 1240 1354 1240 1352 1240 1245 1240 1243 1240 1241 1240 1185 1253 1115 1242 1113 1242 821 1253 715 1242 713 1242 710 1242 685 1253 624 1242 622 1242 620 1242 617 1242 602 1255 470 1255 431 1242 429 1242 427 1242 355 1255 357 1286"/>
                        </Shape>
                        <String CONTENT="and even for food. The Maritime Koryak sacrifice so many dogs, that not"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l13" HPOS="360" VPOS="1299" WIDTH="1773" HEIGHT="60" BASELINE="362 1344 2133 1340" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1344 362 1359 2131 1355 2133 1340 2129 1312 2051 1299 2049 1299 2047 1299 2025 1309 1999 1299 1997 1299 1995 1299 1993 1299 1971 1309 1897 1299 1895 1299 1893 1299 1850 1309 1832 1299 1830 1299 1828 1299 1826 1299 1769 1309 1722 1299 1720 1299 1718 1299 1715 1299 1713 1299 1698 1312 1559 1312 1533 1299 1531 1299 1529 1299 1527 1299 1525 1299 1507 1309 1403 1299 1401 1299 1323 1309 1293 1299 1291 1299 1289 1299 1287 1299 1284 1299 1271 1309 1250 1299 1248 1299 1245 1299 1161 1312 1113 1301 1111 1301 1109 1301 966 1312 864 1301 862 1301 860 1301 823 1312 769 1301 767 1301 765 1301 741 1312 663 1301 661 1301 659 1301 656 1301 641 1314 533 1314 500 1301 498 1301 496 1301 360 1314 362 1344"/>
                        </Shape>
                        <String CONTENT="enough are left for driving. The Reindeer Chukchee sacrifice both reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l14" HPOS="360" VPOS="1370" WIDTH="1771" HEIGHT="52" BASELINE="362 1400 2131 1405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1400 360 1418 2127 1422 2131 1405 2129 1374 362 1370 362 1400"/>
                        </Shape>
                        <String CONTENT="and dogs frequently, but the poorer people sacrifice principally dogs and puppies."/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l15" HPOS="362" VPOS="1422" WIDTH="1769" HEIGHT="59" BASELINE="362 1465 2131 1465" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1465 362 1481 2131 1481 2131 1465 2131 1433 2097 1422 2094 1422 2092 1422 2003 1433 1986 1422 1984 1422 1982 1422 1980 1422 1977 1422 1951 1433 1897 1422 1895 1422 1893 1422 1863 1433 1774 1422 1772 1422 1769 1422 1741 1433 1562 1422 1468 1422 1466 1422 1464 1422 1462 1422 1449 1433 1403 1422 1401 1422 1399 1422 1397 1422 1371 1433 1343 1422 1341 1422 1339 1422 1284 1435 1183 1435 1167 1422 1165 1422 1163 1422 1161 1422 1159 1422 1137 1433 1120 1422 1118 1422 1115 1422 1113 1422 1009 1433 918 1422 916 1422 860 1433 838 1422 836 1422 834 1422 773 1433 715 1422 713 1422 710 1422 680 1433 617 1422 615 1422 557 1433 485 1422 483 1422 362 1429 362 1465"/>
                        </Shape>
                        <String CONTENT="Besides this, the Maritime Chukchee and the Eskimo use dogs for food in"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l16" HPOS="357" VPOS="1478" WIDTH="1776" HEIGHT="63" BASELINE="360 1526 2133 1519" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1526 360 1541 2131 1535 2133 1519 2129 1491 2075 1478 2073 1478 2071 1478 2027 1489 1982 1478 1980 1478 1977 1478 1837 1489 1731 1478 1728 1478 1674 1489 1648 1478 1646 1478 1644 1478 1516 1491 994 1481 992 1481 990 1481 944 1494 892 1483 890 1483 687 1494 665 1483 663 1483 522 1483 520 1483 357 1496 360 1526"/>
                        </Shape>
                        <String CONTENT="case of famine. In the winter of 1901, for instance, the Chukchee families"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l17" HPOS="360" VPOS="1539" WIDTH="1771" HEIGHT="65" BASELINE="362 1584 2131 1580" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1584 362 1602 2127 1604 2131 1580 2127 1552 2053 1539 2051 1539 2049 1539 2047 1539 2029 1550 1986 1539 1984 1539 1982 1539 1980 1539 1958 1550 1542 1539 1540 1539 1455 1550 1391 1539 1388 1539 1386 1539 1349 1550 1304 1539 1302 1539 1300 1539 1241 1552 1226 1541 1224 1541 1222 1541 1219 1541 773 1552 672 1541 669 1541 667 1541 665 1541 650 1552 524 1541 522 1541 520 1541 518 1541 503 1552 401 1541 399 1541 396 1541 360 1554 362 1584"/>
                        </Shape>
                        <String CONTENT="of Mariinsky Post, at the mouth of the Anadyr, suffered greatly from famine,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l18" HPOS="360" VPOS="1600" WIDTH="1773" HEIGHT="60" BASELINE="362 1645 2133 1641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1645 362 1660 2131 1656 2133 1641 2131 1613 2097 1600 2094 1600 2092 1600 2090 1600 2066 1610 2012 1600 2010 1600 2008 1600 1986 1610 1860 1600 1858 1600 1776 1610 1648 1600 1646 1600 1551 1610 1525 1600 1523 1600 1520 1600 1352 1610 1321 1600 1319 1600 1317 1600 1224 1613 1159 1602 1157 1602 986 1613 944 1602 942 1602 940 1602 938 1602 908 1613 877 1602 875 1602 873 1602 871 1602 869 1602 853 1613 752 1602 749 1602 747 1602 708 1613 665 1602 663 1602 661 1602 468 1613 431 1602 429 1602 427 1602 360 1615 362 1645"/>
                        </Shape>
                        <String CONTENT="and ate nearly all their dogs. I know of cases where families of the Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l19" HPOS="360" VPOS="1660" WIDTH="1769" HEIGHT="65" BASELINE="362 1706 2129 1701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1706 362 1721 2125 1725 2129 1701 2125 1671 1248 1660 1245 1660 1243 1660 1241 1660 1224 1671 386 1662 383 1662 381 1662 360 1671 362 1706"/>
                        </Shape>
                        <String CONTENT="shore have, in times of famine, eaten all their dogs. Even in times of plenty,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l20" HPOS="362" VPOS="1734" WIDTH="1767" HEIGHT="50" BASELINE="362 1766 2129 1766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1766 362 1779 2125 1784 2129 1766 2127 1734 362 1734 362 1766"/>
                        </Shape>
                        <String CONTENT="some families occasionally kill a fat dog to feast on its head and intestines,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l21" HPOS="360" VPOS="1790" WIDTH="1769" HEIGHT="52" BASELINE="362 1823 2129 1827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1823 360 1836 2125 1842 2129 1827 2127 1794 362 1790 362 1823"/>
                        </Shape>
                        <String CONTENT="although, on account of the jeers of Russian cossacks and American whalers,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l22" HPOS="360" VPOS="1849" WIDTH="1769" HEIGHT="52" BASELINE="362 1881 2129 1885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1881 360 1896 2125 1901 2129 1885 2127 1853 362 1849 362 1881"/>
                        </Shape>
                        <String CONTENT="that taste has decreased rapidly, or at least its gratification is concealed from"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l23" HPOS="362" VPOS="1914" WIDTH="1769" HEIGHT="47" BASELINE="362 1944 2131 1944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1944 362 1961 2131 1961 2131 1944 2131 1914 362 1914 362 1944"/>
                        </Shape>
                        <String CONTENT="other people. However, when I wanted specimens of dog-skin, the natives"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l24" HPOS="362" VPOS="1974" WIDTH="1771" HEIGHT="50" BASELINE="362 2002 2133 2002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2002 362 2020 2131 2024 2133 2002 2133 1974 362 1974 362 2002"/>
                        </Shape>
                        <String CONTENT="who killed the animals for me were careful to take the meat home for their"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l25" HPOS="362" VPOS="2024" WIDTH="1771" HEIGHT="56" BASELINE="364 2063 2133 2059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2063 364 2080 2131 2076 2133 2059 2129 2024 531 2024 529 2024 362 2035 364 2063"/>
                        </Shape>
                        <String CONTENT="own private use. Sacrificed dogs are not generally eaten. The assertion of"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l26" HPOS="362" VPOS="2087" WIDTH="1767" HEIGHT="60" BASELINE="364 2121 2129 2126" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2121 362 2139 373 2147 375 2147 377 2147 379 2147 2127 2143 2129 2126 2127 2093 364 2087 364 2121"/>
                        </Shape>
                        <String CONTENT="Nordenskiöld,² that the Chukchee do not eat dog-flesh even in times of need,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l27" HPOS="362" VPOS="2150" WIDTH="899" HEIGHT="60" BASELINE="364 2180 1261 2184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2180 362 2193 422 2208 425 2208 728 2197 812 2210 814 2210 817 2210 819 2210 819 2208 830 2199 1137 2199 1185 2210 1187 2210 1189 2210 1258 2197 1261 2184 1258 2154 364 2150 364 2180"/>
                        </Shape>
                        <String CONTENT="evidently refers only to sacrificed dogs."/>
                    </TextLine>
<TextLine ID="mz_1-133_l28" HPOS="466" VPOS="2201" WIDTH="1665" HEIGHT="65" BASELINE="468 2243 2131 2249" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 2243 466 2258 477 2266 479 2266 481 2266 483 2266 2129 2262 2131 2249 2129 2217 2058 2204 2055 2204 2053 2204 2014 2214 1919 2204 1917 2204 1915 2204 1912 2204 1895 2214 1839 2204 1837 2204 1566 2212 1533 2201 1531 2201 1529 2201 1429 2214 1252 2214 1239 2201 1237 2201 1235 2201 1232 2201 1144 2212 1100 2201 1098 2201 1096 2201 1094 2201 1057 2212 468 2208 468 2243"/>
                        </Shape>
                        <String CONTENT="It is not necessary to speak of the races of the East Siberian team-dog,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l29" HPOS="362" VPOS="2264" WIDTH="1771" HEIGHT="57" BASELINE="362 2305 2133 2305" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2305 362 2321 2133 2321 2133 2305 2133 2277 1943 2264 1941 2264 1938 2264 1936 2264 1921 2277 1624 2277 1562 2264 1559 2264 1494 2275 1427 2264 1425 2264 1375 2275 1343 2264 1341 2264 1339 2264 1258 2275 1196 2264 1193 2264 1191 2264 1152 2275 1113 2264 1111 2264 1109 2264 1107 2264 1083 2275 1001 2264 999 2264 996 2264 951 2275 918 2264 916 2264 914 2264 700 2275 607 2264 604 2264 602 2264 581 2275 529 2264 526 2264 474 2275 388 2264 386 2264 383 2264 362 2275 362 2305"/>
                        </Shape>
                        <String CONTENT="since all dogs are much alike in size and color. On an average, they are"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l30" HPOS="360" VPOS="2325" WIDTH="1773" HEIGHT="56" BASELINE="362 2366 2133 2360" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2366 362 2381 2131 2377 2133 2360 2129 2331 396 2325 394 2325 392 2325 360 2336 362 2366"/>
                        </Shape>
                        <String CONTENT="of the size of an ordinary shepherd-dog; rather smaller, however, than the"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l31" HPOS="360" VPOS="2390" WIDTH="1771" HEIGHT="56" BASELINE="362 2420 2131 2424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2420 360 2435 375 2446 377 2446 379 2446 381 2446 2129 2437 2131 2424 2129 2390 362 2390 362 2420"/>
                        </Shape>
                        <String CONTENT="dogs of the American Eskimo. Their appearance calls to mind the wolf; and"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l32" HPOS="362" VPOS="2442" WIDTH="1769" HEIGHT="60" BASELINE="362 2485 2131 2485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2485 362 2498 2129 2502 2131 2485 2131 2453 2094 2442 2092 2442 2090 2442 1995 2453 1711 2442 1709 2442 1529 2453 1475 2442 1473 2442 1471 2442 1468 2442 1453 2455 1343 2455 1230 2442 1228 2442 1226 2442 1178 2453 1096 2442 1094 2442 1092 2442 1089 2442 1072 2453 1042 2442 1040 2442 1038 2442 1035 2442 1007 2453 957 2442 955 2442 903 2453 871 2442 869 2442 866 2442 808 2453 782 2442 780 2442 778 2442 775 2442 773 2442 758 2453 620 2442 617 2442 559 2453 470 2442 468 2442 466 2442 438 2453 383 2442 381 2442 379 2442 377 2442 362 2450 362 2485"/>
                        </Shape>
                        <String CONTENT="the form of their heads, the jackal. They are shaggy, and have very thick,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l33" HPOS="362" VPOS="2507" WIDTH="1767" HEIGHT="54" BASELINE="364 2539 2129 2546" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2539 362 2554 2125 2561 2129 2546 2127 2513 364 2507 364 2539"/>
                        </Shape>
                        <String CONTENT="woolly tails, especially in the more exposed regions along the seacoast. Among"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l34" HPOS="362" VPOS="2567" WIDTH="1769" HEIGHT="52" BASELINE="364 2598 2131 2604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2598 362 2613 2127 2619 2131 2604 2129 2574 364 2567 364 2598"/>
                        </Shape>
                        <String CONTENT="the Yakut on the Upper Kolyma I have often met dogs of curious appearance,"/>
                    </TextLine>

                    <TextLine ID="mz_1-133_l35" HPOS="360" VPOS="2617" WIDTH="1773" HEIGHT="69" BASELINE="362 2665 2133 2658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 2665 362 2680 1540 2686 1542 2686 1544 2686 1585 2676 2131 2676 2133 2658 2129 2630 2077 2617 2075 2617 2073 2617 2036 2628 1867 2617 1865 2617 1800 2628 1772 2617 1769 2617 1767 2617 1687 2628 1631 2617 1629 2617 1568 2628 1544 2617 1542 2617 1540 2617 1538 2617 1536 2617 1523 2630 1486 2619 1484 2619 1481 2619 1479 2619 1436 2630 1403 2619 1401 2619 1399 2619 1397 2619 1395 2619 1380 2632 1133 2632 1068 2619 1066 2619 1003 2630 951 2619 949 2619 947 2619 944 2619 923 2632 864 2621 862 2621 860 2621 827 2632 806 2621 804 2621 801 2621 726 2632 648 2621 646 2621 643 2621 607 2632 492 2621 490 2621 360 2634 362 2665"/>
                        </Shape>
                        <String CONTENT="resembling that of the fox. They were undersized, with rather long bodies"/>
