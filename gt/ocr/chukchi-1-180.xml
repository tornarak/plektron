                <TextBlock ID="mz_1-180_r2" HPOS="573" VPOS="721" WIDTH="1778" HEIGHT="963" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="573 721 2351 721 2351 1684 573 1684"/>
                    </Shape>
                    <TextLine ID="mz_1-180_l3" HPOS="578" VPOS="721" WIDTH="1772" HEIGHT="58" BASELINE="578 764 2350 764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2159 723 2138 723 2116 721 2094 721 2073 721 2001 721 1999 721 1997 721 1995 721 1980 731 1917 721 1915 721 1863 731 1793 721 1791 721 1733 731 1646 721 1505 721 1503 721 1501 721 1499 721 1484 731 1395 721 1271 721 1269 721 1267 721 1265 721 1252 731 1198 721 1196 721 1193 721 1163 731 578 727 578 764 578 779 2350 779 2350 764 2350 734 2166 723 2159 723"/>
                        </Shape>
                        <String CONTENT="In the Kolyma country the Reindeer Chukchee, like other inhabitants, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l4" HPOS="578" VPOS="781" WIDTH="1772" HEIGHT="59" BASELINE="578 822 2350 822" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 822 578 840 2350 840 2350 822 2350 792 2313 781 2311 781 2309 781 2252 792 2207 781 2205 781 2203 781 2122 792 2092 781 2090 781 2088 781 2086 781 2045 792 1982 781 1980 781 1977 781 1943 792 1737 781 1735 781 1676 792 1575 781 1572 781 1570 781 1544 794 1362 794 1310 781 1308 781 1306 781 1304 781 1287 794 1148 794 1027 781 1025 781 1022 781 988 792 951 781 949 781 947 781 843 792 778 781 775 781 578 792 578 822"/>
                        </Shape>
                        <String CONTENT="very assiduous in digging out the young of the white fox, though their skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l5" HPOS="576" VPOS="848" WIDTH="1774" HEIGHT="50" BASELINE="578 883 2350 879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 883 578 898 2350 894 2350 879 2343 848 576 848 578 883"/>
                        </Shape>
                        <String CONTENT="has hardly any value; and this imprudent extermination has already decreased"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l6" HPOS="574" VPOS="902" WIDTH="1774" HEIGHT="63" BASELINE="576 946 2348 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 946 576 965 2346 965 2348 939 2343 909 600 902 598 902 596 902 574 911 576 946"/>
                        </Shape>
                        <String CONTENT="the number of foxes. In trade, seven qualities of white-fox skin are distinguished,"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l7" HPOS="574" VPOS="972" WIDTH="1774" HEIGHT="47" BASELINE="576 1004 2348 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 1004 576 1019 2346 1015 2348 1000 2341 972 574 974 576 1004"/>
                        </Shape>
                        <String CONTENT="according to age; and the first three are valued at not more than from ten"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l8" HPOS="576" VPOS="1022" WIDTH="1772" HEIGHT="58" BASELINE="578 1065 2348 1061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1065 578 1080 2346 1076 2348 1061 2343 1026 661 1022 659 1022 576 1032 578 1065"/>
                        </Shape>
                        <String CONTENT="to fifteen cents apiece. In the Kolyma country the Russianized Yukaghir and"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l9" HPOS="576" VPOS="1080" WIDTH="1772" HEIGHT="61" BASELINE="578 1125 2348 1117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1125 578 1141 2346 1132 2348 1117 2343 1089 1462 1080 1460 1080 1458 1080 1416 1091 594 1084 591 1084 589 1084 587 1084 576 1091 578 1125"/>
                        </Shape>
                        <String CONTENT="the Yakut often capture the young of the red fox, and raise them in willow"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l10" HPOS="578" VPOS="1138" WIDTH="1770" HEIGHT="61" BASELINE="581 1180 2348 1184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1180 578 1195 2343 1199 2348 1184 2348 1151 2330 1141 2328 1141 2326 1141 2103 1141 2101 1141 2099 1141 2097 1141 2079 1151 1915 1141 1912 1141 1910 1141 1878 1151 1863 1141 1860 1141 1858 1141 1856 1141 1759 1151 1598 1141 1596 1141 1594 1141 1592 1141 1577 1154 1479 1154 1462 1138 1460 1138 1458 1138 1455 1138 1453 1138 1419 1149 1382 1138 1380 1138 1378 1138 1375 1138 1341 1149 1254 1138 1252 1138 1187 1149 581 1145 581 1180"/>
                        </Shape>
                        <String CONTENT="baskets or wooden cases. The animals are half starved, because, if well fed,"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l11" HPOS="581" VPOS="1212" WIDTH="1767" HEIGHT="48" BASELINE="581 1242 2348 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1242 581 1260 2346 1260 2348 1242 2346 1212 581 1212 581 1242"/>
                        </Shape>
                        <String CONTENT="they would have thin and uneven fur. They are generally killed early in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l12" HPOS="576" VPOS="1268" WIDTH="1770" HEIGHT="61" BASELINE="578 1301 2346 1305" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1301 576 1318 587 1327 589 1327 591 1327 594 1327 674 1316 741 1327 743 1327 823 1316 886 1327 888 1327 1068 1316 1475 1316 1542 1329 1544 1329 1609 1318 2341 1322 2346 1305 2343 1273 578 1268 578 1301"/>
                        </Shape>
                        <String CONTENT="fall. The Chukchee are too indolent to go to the trouble of raising young"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l13" HPOS="578" VPOS="1322" WIDTH="1768" HEIGHT="57" BASELINE="578 1364 2346 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1364 578 1379 2343 1379 2346 1364 2346 1335 2302 1322 2300 1322 2298 1322 2296 1322 2263 1333 2207 1322 2205 1322 2203 1322 2164 1333 2112 1322 2109 1322 2058 1333 1995 1322 1993 1322 1932 1333 1808 1322 1806 1322 1804 1322 1772 1333 1711 1322 1709 1322 1579 1333 1479 1322 1477 1322 1475 1322 1440 1335 1163 1335 1148 1322 1146 1322 1144 1322 1141 1322 1061 1335 895 1335 877 1322 875 1322 873 1322 871 1322 578 1331 578 1364"/>
                        </Shape>
                        <String CONTENT="foxes in this way, and, moreover, they consider it as tabooed. In the"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l14" HPOS="576" VPOS="1390" WIDTH="1770" HEIGHT="49" BASELINE="578 1422 2346 1418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1422 578 1439 2343 1435 2346 1418 2339 1390 576 1392 578 1422"/>
                        </Shape>
                        <String CONTENT="eastern part of their territory, the Chukchee consider it unfair “to break into"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l15" HPOS="578" VPOS="1442" WIDTH="1768" HEIGHT="58" BASELINE="581 1483 2346 1478" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1483 581 1500 2343 1498 2346 1478 2341 1450 598 1442 596 1442 594 1442 591 1442 578 1448 581 1483"/>
                        </Shape>
                        <String CONTENT="the house of any resident, even if it be a fox,” because every resident, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l16" HPOS="581" VPOS="1504" WIDTH="1767" HEIGHT="57" BASELINE="581 1543 2348 1543" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1543 581 1561 2346 1561 2348 1543 2346 1513 581 1504 581 1543"/>
                        </Shape>
                        <String CONTENT="but a fox, is supposed to have a drum and charms in his house, and vengeance"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l17" HPOS="576" VPOS="1561" WIDTH="1774" HEIGHT="69" BASELINE="578 1604 2350 1600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1604 578 1617 882 1628 884 1628 1109 1617 1204 1628 1206 1628 1271 1617 1284 1628 1287 1628 1289 1628 1291 1630 1386 1630 1386 1628 1466 1615 1668 1626 1670 1626 1672 1626 1713 1615 2170 1626 2172 1626 2174 1626 2177 1626 2190 1615 2235 1626 2237 1626 2239 1626 2242 1626 2244 1626 2259 1615 2326 1626 2328 1626 2330 1626 2333 1626 2350 1613 2350 1600 2346 1571 1466 1561 1464 1561 1462 1561 1460 1561 1447 1571 594 1563 591 1563 589 1563 587 1563 576 1569 578 1604"/>
                        </Shape>
                        <String CONTENT="through magic means might ensue. Thus only a fox hunted down in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l18" HPOS="578" VPOS="1626" WIDTH="1729" HEIGHT="54" BASELINE="578 1662 2307 1662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1662 578 1680 2307 1680 2307 1662 2307 1632 578 1626 578 1662"/>
                        </Shape>
                        <String CONTENT="burrow is dug after, especially since often it does not hide in its own hole."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-180_r3" HPOS="573" VPOS="1684" WIDTH="1778" HEIGHT="130" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="573 1684 2351 1684 2351 1814 573 1814"/>
                    </Shape>
                    <TextLine ID="mz_1-180_l19" HPOS="687" VPOS="1680" WIDTH="1663" HEIGHT="69" BASELINE="689 1721 2350 1725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="689 1721 687 1736 702 1747 704 1747 706 1747 708 1747 843 1736 1403 1747 1406 1747 1488 1736 1531 1747 1533 1747 1536 1747 2207 1738 2302 1749 2304 1749 2307 1749 2348 1736 2350 1725 2348 1695 2248 1682 2246 1682 2244 1682 2211 1693 2153 1682 2151 1682 2055 1693 2010 1682 2008 1682 2006 1682 1947 1693 1876 1682 1873 1682 1802 1693 1705 1682 1702 1682 1700 1682 1668 1693 1479 1680 1477 1680 1475 1680 1429 1691 1349 1680 1347 1680 1345 1680 1317 1693 1193 1693 1178 1680 1176 1680 1174 1680 1172 1680 1098 1691 689 1684 689 1721"/>
                        </Shape>
                        <String CONTENT="TRAPS. — Traps with a spring of twisted sinew (Fig. 48), of the shape"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l20" HPOS="576" VPOS="1753" WIDTH="1774" HEIGHT="50" BASELINE="576 1781 2350 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 1781 576 1803 2350 1803 2350 1781 2350 1753 576 1753 576 1781"/>
                        </Shape>
                        <String CONTENT="common throughout the northern part of the Old World and possibly brought"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-180_r4" HPOS="573" VPOS="2686" WIDTH="1778" HEIGHT="491" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="573 2686 2351 2686 2351 3177 573 3177"/>
                    </Shape>
                    <TextLine ID="mz_1-180_l21" HPOS="572" VPOS="2697" WIDTH="1776" HEIGHT="52" BASELINE="574 2730 2348 2734" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 2730 572 2745 2343 2749 2348 2734 2346 2702 574 2697 574 2730"/>
                        </Shape>
                        <String CONTENT="thither by the Russians, were much used in northeastern Asia, and even came"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l22" HPOS="572" VPOS="2758" WIDTH="1774" HEIGHT="52" BASELINE="574 2788 2346 2795" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 2773 574 2788 572 2803 2341 2810 2346 2795 2343 2764 581 2758 574 2773"/>
                        </Shape>
                        <String CONTENT="to America;¹ but on the Pacific they are at present superseded by steel traps"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l23" HPOS="576" VPOS="2814" WIDTH="1772" HEIGHT="54" BASELINE="576 2853 2348 2853" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 2853 576 2868 2348 2868 2348 2853 2348 2823 576 2814 576 2853"/>
                        </Shape>
                        <String CONTENT="bought from the whalers, while on the Kolyma and along the Arctic shore"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l24" HPOS="572" VPOS="2877" WIDTH="1774" HEIGHT="54" BASELINE="574 2909 2346 2914" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 2909 572 2925 2341 2931 2346 2914 2343 2881 574 2877 574 2909"/>
                        </Shape>
                        <String CONTENT="the sinew-twisted trap still prevails. This trap strikes the animal from above;"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l25" HPOS="572" VPOS="2931" WIDTH="1776" HEIGHT="65" BASELINE="574 2972 2348 2968" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 2972 574 2987 2174 2996 2177 2996 2348 2983 2348 2968 2343 2940 641 2931 639 2931 572 2942 574 2972"/>
                        </Shape>
                        <String CONTENT="and the blow, though prompt and strong, is not quite sure, since the fox is"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l26" HPOS="574" VPOS="2990" WIDTH="1769" HEIGHT="69" BASELINE="574 3031 2343 3031" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 3031 574 3048 710 3048 726 3059 728 3059 730 3059 732 3059 845 3048 966 3059 968 3059 1035 3048 1211 3059 1213 3059 1280 3048 1380 3059 1382 3059 1384 3059 1427 3048 2341 3052 2343 3031 2343 3000 2322 2990 2320 2990 2207 2990 2205 2990 2203 2990 2200 2990 2185 3000 2027 2990 2025 2990 2023 2990 1986 3000 1958 2990 1956 2990 1954 2990 1856 3000 1821 2990 1819 2990 1817 2990 1733 3000 1668 2990 1666 2990 1572 3000 1527 2990 1525 2990 1523 2990 1520 2990 1479 3000 1445 2990 1442 2990 1440 2990 1438 2990 1436 2990 1421 3003 1271 3003 1206 2990 1204 2990 1202 2990 1200 2990 1187 3000 1157 2990 1154 2990 1152 2990 1150 2990 1148 2990 1133 3003 1033 3003 1003 2990 1001 2990 999 2990 840 3000 775 2990 773 2990 689 3000 611 2990 609 2990 607 2990 574 3000 574 3031"/>
                        </Shape>
                        <String CONTENT="often quick enough to dodge away in time. Then, instead of being killed,"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l27" HPOS="572" VPOS="3052" WIDTH="1774" HEIGHT="57" BASELINE="574 3089 2346 3093" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 3089 572 3104 2341 3109 2346 3093 2343 3063 574 3052 574 3089"/>
                        </Shape>
                        <String CONTENT="it is only hurt, and may be able to escape, breaking the trap, or biting through"/>
                    </TextLine>

                    <TextLine ID="mz_1-180_l28" HPOS="572" VPOS="3117" WIDTH="1774" HEIGHT="61" BASELINE="574 3148 2346 3152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 3148 572 3167 585 3176 587 3176 589 3176 591 3176 1334 3167 1462 3178 1464 3178 2343 3167 2346 3152 2343 3122 574 3117 574 3148"/>
                        </Shape>
                        <String CONTENT="the sinew cords. On the other hand, this kind of trap is not very safe for"/>
                    </TextLine>
</TextBlock>
