                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-246_l3" HPOS="354" VPOS="548" WIDTH="1769" HEIGHT="68" BASELINE="356 595 2123 587" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2117 569 2097 569 2077 567 2058 567 2038 565 2019 565 1999 564 1980 564 1960 562 1940 562 1921 560 1464 560 1447 548 1445 548 1443 548 1441 548 1439 548 1408 558 1357 548 1355 548 1302 560 1253 548 1251 548 1249 548 1247 548 1245 548 1227 560 1208 550 1206 550 1204 550 1133 562 1116 550 1114 550 1112 550 1004 550 1002 550 1000 550 951 562 797 550 795 550 793 550 791 550 767 564 566 552 564 552 562 552 560 552 540 565 468 565 426 552 425 552 423 552 354 565 356 595 356 607 744 616 746 616 748 616 769 607 793 616 795 616 797 616 959 614 961 614 963 614 977 605 996 614 998 614 1000 614 1292 603 1521 612 1523 612 1633 603 1719 611 1721 611 1723 611 1725 611 1739 601 1768 611 1770 611 1772 612 1866 612 1866 611 1868 611 1870 611 1884 601 1909 611 1911 611 1913 611 2121 605 2123 587 2119 569 2117 569"/>
                        </Shape>
                        <String CONTENT="such as Čeˊqum, Qaˊpleq, Qaˊtɪk, Periˊ. Such names are more numerous"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l4" HPOS="354" VPOS="609" WIDTH="1769" HEIGHT="58" BASELINE="356 652 2123 648" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 652 356 667 2121 667 2123 648 2119 620 1999 609 1997 609 1995 609 1974 620 1707 620 1676 609 1674 609 1672 609 1670 609 1668 609 1652 620 1508 620 1480 609 1478 609 1476 609 1474 609 1449 618 1417 609 1416 609 1414 609 1412 609 1388 618 644 611 642 611 640 611 607 620 554 611 552 611 550 611 548 611 532 622 354 622 356 652"/>
                        </Shape>
                        <String CONTENT="among the Maritime Chukchee, and some of them at least were probably"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l5" HPOS="354" VPOS="665" WIDTH="1765" HEIGHT="69" BASELINE="356 708 2119 712" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 708 354 722 370 732 372 732 374 732 376 732 1059 724 1239 734 1241 734 2117 724 2119 712 2119 681 2089 667 2087 667 2085 667 2083 667 2081 667 2062 679 2019 667 2017 667 1921 667 1919 667 1917 667 1915 667 1897 679 1870 667 1868 667 1721 667 1719 667 1717 667 1715 667 1698 679 1670 669 1668 669 1666 669 1621 679 1604 667 1602 667 1600 667 1598 667 1596 667 1594 667 1574 679 1553 667 1551 667 1549 667 1547 667 1545 667 1527 679 1500 667 1498 667 1496 667 1433 679 1390 667 1388 667 1386 667 1100 677 1077 665 1075 665 1073 665 1071 665 1069 665 1049 677 989 665 987 665 985 665 961 677 842 665 759 665 757 665 755 665 754 665 738 677 671 667 669 667 667 667 665 667 650 679 556 679 538 665 536 665 534 665 532 665 530 665 528 665 511 677 413 667 411 667 356 675 356 708"/>
                        </Shape>
                        <String CONTENT="taken from the Eskimo; for instance, Čeˊple (Chukchee), Čaˊplak (Eskimo)."/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l6" HPOS="358" VPOS="730" WIDTH="1761" HEIGHT="57" BASELINE="360 773 2119 769" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="360 773 360 787 2117 785 2119 769 2117 742 2085 730 2083 730 2081 730 2079 730 2050 740 1978 730 1976 730 1923 740 1872 730 1870 730 1868 730 1841 740 1604 730 1602 730 1600 730 1562 740 1345 730 1343 730 1220 742 358 736 360 773"/>
                        </Shape>
                        <String CONTENT="The identical form of this name appears, however, also among the Koryak."/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l7" HPOS="356" VPOS="802" WIDTH="1767" HEIGHT="42" BASELINE="356 830 2123 830" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 830 356 842 2121 844 2123 830 2123 802 356 802 356 830"/>
                        </Shape>
                        <String CONTENT="On the other hand, many of the Chukchee names are assumed by the"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l8" HPOS="354" VPOS="849" WIDTH="1769" HEIGHT="55" BASELINE="356 893 2123 889" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 893 356 904 2121 902 2123 889 2119 861 1688 861 1637 849 1635 849 1633 849 1596 861 1369 861 1316 849 1314 849 1312 849 1310 849 1294 859 542 851 540 851 538 851 515 861 499 851 497 851 495 851 374 851 372 851 370 851 368 851 354 859 356 893"/>
                        </Shape>
                        <String CONTENT="Asiatic Eskimo. I have also said that shamans sometimes assume a name"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l9" HPOS="356" VPOS="910" WIDTH="1765" HEIGHT="55" BASELINE="356 949 2121 949" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 949 356 965 2121 965 2121 949 2121 922 2064 910 2062 910 1989 920 1935 910 1933 910 1858 920 1788 910 1786 910 1727 922 1578 922 1555 910 1553 910 1551 910 1549 910 1517 920 1478 910 1476 910 1474 910 1472 910 1439 920 1370 910 1369 910 1294 920 1190 910 1188 910 1137 922 998 922 977 910 975 910 973 910 891 920 871 910 869 910 867 910 822 920 787 910 785 910 783 910 781 910 746 920 722 910 720 910 718 910 716 910 687 920 660 910 658 910 656 910 654 910 624 920 528 910 526 910 356 918 356 949"/>
                        </Shape>
                        <String CONTENT="from the principal of their protecting spirits; for instance, Ñaw-rɪˊrkᴀ (“she-"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l10" HPOS="358" VPOS="969" WIDTH="1091" HEIGHT="57" BASELINE="358 1010 1449 1010" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="358 1010 358 1026 1449 1026 1449 1010 1449 983 1337 983 1302 969 1300 969 1298 969 1200 981 1188 971 1188 969 1186 969 1184 969 1143 969 1141 969 1139 969 1137 969 1118 983 1016 983 953 969 951 969 949 969 918 981 822 969 820 969 818 969 793 983 679 983 573 969 571 969 569 969 538 981 528 971 528 969 526 969 524 969 522 969 460 979 426 969 425 969 423 969 358 981 358 1010"/>
                        </Shape>
                        <String CONTENT="walrus”), Valv-ɪnpɪnaˊčhɪn (“raven old man”), etc."/>
                    </TextLine>
<TextLine ID="mz_2-246_l11" HPOS="460" VPOS="1030" WIDTH="1661" HEIGHT="56" BASELINE="462 1071 2121 1067" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="462 1071 462 1086 2119 1086 2121 1067 2117 1039 1290 1030 1288 1030 1286 1030 1259 1041 460 1041 462 1071"/>
                        </Shape>
                        <String CONTENT="Pet names and nicknames are used freely among the Chukchee, some"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l12" HPOS="354" VPOS="1086" WIDTH="1765" HEIGHT="65" BASELINE="356 1128 2119 1131" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1128 354 1141 368 1151 370 1151 372 1151 374 1151 2117 1143 2119 1131 2117 1102 2056 1088 2054 1088 1956 1098 1876 1088 1874 1088 1872 1088 1837 1100 1764 1088 1762 1088 1652 1100 1633 1088 1631 1088 1629 1088 1539 1088 1537 1088 1535 1088 1510 1100 1484 1088 1482 1088 1480 1088 1478 1088 1457 1100 1437 1088 1435 1088 1433 1088 1431 1088 1357 1098 1325 1088 1323 1088 1322 1088 1320 1088 1318 1088 1300 1102 1251 1102 1177 1086 1175 1086 1173 1086 1143 1100 947 1100 914 1086 912 1086 910 1086 908 1086 879 1098 801 1086 799 1086 797 1086 771 1100 669 1100 642 1086 640 1086 638 1086 636 1086 634 1086 614 1098 591 1086 589 1086 587 1086 585 1086 583 1086 562 1100 489 1100 470 1086 468 1086 466 1086 464 1086 462 1086 438 1098 409 1086 407 1086 405 1086 356 1096 356 1128"/>
                        </Shape>
                        <String CONTENT="of them being quite obscene; such as, Loloˊqai (“little penis”), Rɪh-ñoˊiñɪn"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l13" HPOS="354" VPOS="1149" WIDTH="1765" HEIGHT="57" BASELINE="356 1192 2119 1188" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1192 356 1206 2117 1204 2119 1188 2117 1159 2099 1149 2097 1149 2095 1149 2093 1149 2091 1149 2066 1159 1574 1149 1572 1149 1433 1159 1345 1149 1343 1149 1231 1161 738 1151 736 1151 673 1161 622 1151 620 1151 503 1161 368 1151 366 1151 364 1151 362 1151 354 1157 356 1192"/>
                        </Shape>
                        <String CONTENT="(“hairy anus”). Others refer to some notorious act of the person designated."/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l14" HPOS="354" VPOS="1210" WIDTH="1761" HEIGHT="57" BASELINE="356 1253 2115 1247" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1253 356 1267 2113 1261 2115 1247 2109 1210 354 1216 356 1253"/>
                        </Shape>
                        <String CONTENT="I have already mentioned the names of Knee-Walker and Necklaced Latuˊwg̣ê.¹"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l15" HPOS="356" VPOS="1270" WIDTH="1767" HEIGHT="53" BASELINE="356 1310 2123 1310" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1310 356 1323 2123 1323 2123 1310 2121 1270 2072 1280 1966 1270 1964 1270 1911 1280 1762 1270 1760 1270 356 1278 356 1310"/>
                        </Shape>
                        <String CONTENT="One man had the very suggestive name of Complete-Liar; another, of"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l16" HPOS="356" VPOS="1329" WIDTH="1765" HEIGHT="55" BASELINE="356 1368 2121 1368" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1368 356 1384 2121 1384 2121 1368 2121 1341 2007 1341 1985 1329 1983 1329 1982 1329 1878 1339 1772 1329 1770 1329 1694 1339 1437 1329 1435 1329 1433 1329 1398 1341 1216 1341 1200 1329 1198 1329 1196 1329 1194 1329 1147 1341 1012 1341 996 1329 994 1329 992 1329 991 1329 989 1329 959 1339 716 1329 714 1329 640 1339 591 1329 589 1329 356 1335 356 1368"/>
                        </Shape>
                        <String CONTENT="Separate-Soup-Eater, etc. A man of my acquaintance was nicknamed Frozen-"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l17" HPOS="352" VPOS="1386" WIDTH="1773" HEIGHT="59" BASELINE="354 1431 2125 1425" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1431 354 1445 2125 1437 2125 1425 2117 1386 2089 1396 1549 1388 1547 1388 1545 1388 1543 1388 1527 1400 352 1400 354 1431"/>
                        </Shape>
                        <String CONTENT="Carcass; because, several years before, he had stolen the frozen carcass of"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l18" HPOS="354" VPOS="1451" WIDTH="1765" HEIGHT="58" BASELINE="354 1490 2119 1490" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1490 354 1502 2117 1509 2119 1490 2119 1462 2017 1451 2015 1451 1960 1460 1899 1451 1897 1451 1850 1460 1582 1451 1580 1451 1578 1451 1543 1462 1292 1462 1255 1451 1253 1451 1251 1451 1085 1460 1043 1451 1041 1451 1039 1451 949 1460 891 1451 889 1451 818 1460 738 1451 736 1451 601 1460 462 1451 460 1451 354 1460 354 1490"/>
                        </Shape>
                        <String CONTENT="a reindeer; another, who stole a steel trap, was called Trap. Sometimes,"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l19" HPOS="354" VPOS="1509" WIDTH="1767" HEIGHT="55" BASELINE="354 1549 2121 1549" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1549 354 1564 2121 1564 2121 1549 2121 1519 2101 1509 2099 1509 2097 1509 2095 1509 2064 1519 1466 1509 1464 1509 1463 1509 1461 1509 1445 1521 1331 1521 1257 1509 1255 1509 1202 1519 1147 1509 1145 1509 916 1519 883 1509 881 1509 879 1509 804 1519 695 1509 693 1509 636 1519 583 1509 581 1509 522 1519 444 1509 442 1509 354 1519 354 1549"/>
                        </Shape>
                        <String CONTENT="at first, the nicknamed persons take offence at being thus named; but such"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l20" HPOS="354" VPOS="1566" WIDTH="1765" HEIGHT="59" BASELINE="356 1611 2119 1605" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 1611 356 1625 2117 1625 2119 1605 2115 1578 1833 1566 1831 1566 1750 1576 1698 1566 1696 1566 1627 1576 1592 1566 1590 1566 1588 1566 1513 1578 1263 1568 1261 1568 1259 1568 1257 1568 1241 1578 1204 1568 1202 1568 1200 1568 1100 1578 975 1568 973 1568 895 1580 497 1570 495 1570 354 1582 356 1611"/>
                        </Shape>
                        <String CONTENT="an epithet takes root gradually, and finally supersedes the original name."/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l21" HPOS="358" VPOS="1631" WIDTH="1763" HEIGHT="55" BASELINE="360 1668 2121 1664" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="360 1668 360 1686 2119 1686 2121 1664 2115 1631 358 1631 360 1668"/>
                        </Shape>
                        <String CONTENT="Thus the majority of the persons mentioned had discarded their name received"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l22" HPOS="352" VPOS="1686" WIDTH="1443" HEIGHT="66" BASELINE="354 1731 1795 1725" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1731 354 1742 654 1742 705 1752 707 1752 873 1740 1073 1740 1096 1750 1098 1750 1100 1750 1323 1739 1531 1739 1553 1748 1555 1748 1557 1748 1794 1740 1795 1725 1792 1697 1617 1697 1592 1686 1590 1686 1588 1686 1515 1695 1482 1686 1480 1686 1478 1686 1476 1686 1455 1695 1429 1686 1427 1686 1425 1686 1423 1686 1421 1686 1406 1695 906 1688 904 1688 902 1688 869 1697 836 1688 834 1688 832 1688 830 1688 797 1699 428 1690 426 1690 352 1701 354 1731"/>
                        </Shape>
                        <String CONTENT="at birth, and gave the derisive appellation as their only name."/>
                    </TextLine>
<TextLine ID="mz_2-246_l23" HPOS="462" VPOS="1752" WIDTH="1657" HEIGHT="59" BASELINE="464 1784 2119 1789" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="464 1784 462 1797 2115 1811 2119 1789 2117 1760 464 1752 464 1784"/>
                        </Shape>
                        <String CONTENT="Pet names given in infancy cling with especial tenacity to their possessors."/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l24" HPOS="354" VPOS="1807" WIDTH="1767" HEIGHT="55" BASELINE="354 1846 2121 1846" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1846 354 1860 2119 1862 2121 1846 2121 1819 1980 1819 1964 1807 1962 1807 1960 1807 1958 1807 1956 1807 1933 1817 1837 1807 1835 1807 1752 1817 1651 1807 1557 1807 1555 1807 1553 1807 1551 1807 1539 1817 1525 1807 1523 1807 1521 1807 1404 1807 1402 1807 1400 1807 1398 1807 1384 1817 1370 1807 1369 1807 1367 1807 1365 1807 1363 1807 1327 1817 1300 1807 1298 1807 1296 1807 1218 1817 1171 1807 1169 1807 1167 1807 1130 1817 1090 1807 1088 1807 1086 1807 987 1817 893 1807 891 1807 889 1807 857 1819 656 1819 622 1807 620 1807 618 1807 616 1807 585 1817 569 1807 567 1807 566 1807 564 1807 562 1807 528 1817 391 1807 389 1807 387 1807 354 1815 354 1846"/>
                        </Shape>
                        <String CONTENT="Some of them — such as Loˊlo (“penis”), Loloˊqai (“little penis”) — become"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l25" HPOS="352" VPOS="1868" WIDTH="1300" HEIGHT="57" BASELINE="354 1907 1652 1903" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 1907 354 1925 1651 1925 1652 1903 1649 1878 1051 1868 1049 1868 998 1878 425 1870 423 1870 352 1880 354 1907"/>
                        </Shape>
                        <String CONTENT="real names, which are given after the divinatory process."/>
                    </TextLine>
<TextLine ID="mz_2-246_l26" HPOS="466" VPOS="1927" WIDTH="1653" HEIGHT="58" BASELINE="468 1966 2119 1970" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="468 1966 466 1975 2115 1985 2119 1970 2117 1940 1966 1928 1964 1928 1551 1938 1535 1928 1533 1928 1531 1928 1437 1928 1435 1928 1367 1938 1286 1927 1284 1927 1229 1938 1118 1938 1100 1927 1098 1927 1096 1927 1094 1927 1092 1927 1059 1936 992 1927 991 1927 910 1936 850 1927 848 1927 846 1927 816 1936 793 1927 791 1927 789 1927 787 1927 746 1936 468 1928 468 1966"/>
                        </Shape>
                        <String CONTENT="The name of the father is sometimes added to the name of the son,"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l27" HPOS="354" VPOS="1987" WIDTH="1767" HEIGHT="55" BASELINE="354 2028 2121 2028" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 2028 354 2040 2119 2042 2121 2028 2119 1991 1300 1997 1284 1987 1282 1987 1280 1987 1177 1987 1175 1987 1173 1987 1143 1997 1041 1987 1039 1987 959 1997 920 1987 918 1987 916 1987 914 1987 891 1997 853 1987 851 1987 850 1987 848 1987 826 1997 773 1987 771 1987 769 1987 748 1997 697 1987 695 1987 624 1997 495 1987 493 1987 426 1997 379 1987 377 1987 376 1987 354 1997 354 2028"/>
                        </Shape>
                        <String CONTENT="thus forming the beginning of the family name. Instances of this are found"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l28" HPOS="354" VPOS="2042" WIDTH="1765" HEIGHT="61" BASELINE="356 2089 2119 2085" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 2089 356 2103 2117 2103 2119 2085 2115 2056 2048 2044 2046 2044 2044 2044 2025 2054 1974 2044 1972 2044 1919 2054 1901 2042 1899 2042 1897 2042 1895 2042 1893 2042 1891 2042 1874 2054 1739 2044 1737 2044 1735 2044 1711 2054 1668 2042 1666 2042 1664 2042 1662 2042 1627 2054 1611 2042 1609 2042 1607 2042 1605 2042 1549 2052 1535 2042 1533 2042 1531 2042 1419 2042 1417 2042 1416 2042 1388 2054 1055 2044 1053 2044 1051 2044 1049 2044 1032 2056 975 2046 973 2046 920 2056 875 2044 873 2044 871 2044 802 2056 562 2044 560 2044 558 2044 530 2054 440 2044 438 2044 436 2044 403 2056 370 2044 368 2044 366 2044 364 2044 362 2044 354 2050 356 2089"/>
                        </Shape>
                        <String CONTENT="in Kokoˊlê-Yaˊtirg̣ɪn, that is, Yaˊtirg̣ɪ̂n, son of Kukuˊli; Tatk-omruˊwg̣ê, that"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l29" HPOS="354" VPOS="2105" WIDTH="1765" HEIGHT="57" BASELINE="356 2148 2119 2144" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="356 2148 356 2162 2117 2160 2119 2144 2115 2116 1952 2116 1936 2105 1935 2105 1933 2105 1931 2105 1929 2105 1888 2116 1698 2116 1682 2105 1680 2105 1678 2105 1676 2105 1604 2115 1549 2105 1547 2105 1545 2105 1511 2115 1474 2105 1472 2105 1470 2105 1337 2115 1284 2105 1282 2105 1220 2116 1182 2107 1180 2107 1179 2107 1177 2107 1143 2116 957 2107 955 2107 354 2113 356 2148"/>
                        </Shape>
                        <String CONTENT="is, Omruˊwg̣ê, son of Taˊtko; etc. Less frequently the wife assumes the name"/>
                    </TextLine>

                    <TextLine ID="mz_2-246_l30" HPOS="352" VPOS="2163" WIDTH="1765" HEIGHT="65" BASELINE="354 2209 2117 2205" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="354 2209 354 2222 2113 2228 2117 2205 2113 2175 2048 2163 2046 2163 2044 2163 2011 2173 1889 2163 1888 2163 1886 2163 1884 2163 1868 2175 1747 2175 1707 2163 1705 2163 1703 2163 1701 2163 1680 2173 1570 2163 1568 2163 1521 2173 1472 2163 1470 2163 1396 2173 1369 2163 1367 2163 1365 2163 1278 2173 1239 2163 1237 2163 1235 2163 1233 2163 1231 2163 1220 2173 1030 2165 1028 2165 1026 2165 1024 2165 1010 2175 969 2165 967 2165 965 2165 963 2165 928 2175 738 2165 736 2165 734 2165 710 2175 679 2165 677 2165 675 2165 673 2165 638 2175 605 2165 603 2165 395 2165 393 2165 391 2165 352 2177 354 2209"/>
                        </Shape>
                        <String CONTENT="of her husband; for example, Notaiˊmê-ñaw, the wife of Notaiˊmen. Regarding"/>
                    </TextLine>

