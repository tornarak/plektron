            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-099" HPOS="403" VPOS="582" WIDTH="1782" HEIGHT="2698"><TextLine ID="mz_1-099_l1" HPOS="986" VPOS="582" WIDTH="617" HEIGHT="54" BASELINE="988 615 1603 619" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1594 595 1575 582 1295 582 1291 582 1269 582 1248 582 1226 582 1204 582 1183 582 1161 582 1139 582 1118 582 1096 582 1074 582 1053 582 1031 582 1009 582 988 589 988 615 986 632 1598 636 1603 619 1603 584 1594 582 1594 595"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l2" HPOS="2105" VPOS="589" WIDTH="67" HEIGHT="56" BASELINE="2109 632 2172 628" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2148 593 2140 589 2112 591 2105 597 2109 632 2109 645 2172 645 2172 628 2166 597 2148 593"/>
                        </Shape>
                        <String CONTENT="73"/>
                    </TextLine>
<TextLine ID="mz_1-099_l3" HPOS="407" VPOS="682" WIDTH="1776" HEIGHT="60" BASELINE="409 727 2183 723" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 686 559 686 537 688 516 688 494 690 487 690 407 697 409 727 409 742 2181 738 2183 723 2179 695 2071 682 2068 682 2066 682 2025 692 1689 682 1687 682 1685 682 1683 682 1668 695 1488 695 1310 682 1308 682 1213 695 1180 684 1178 684 1176 684 793 695 732 684 730 684 728 684 691 695 581 684 581 686"/>
                        </Shape>
                        <String CONTENT="was visiting the country on both Anui Rivers, twenty-five years after Baron"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l4" HPOS="412" VPOS="755" WIDTH="1771" HEIGHT="48" BASELINE="412 786 2183 786" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="412 786 412 803 2183 803 2183 786 2183 755 412 755 412 786"/>
                        </Shape>
                        <String CONTENT="von Maydell, the natives pointed out to me that at present the families who"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l5" HPOS="407" VPOS="801" WIDTH="1774" HEIGHT="69" BASELINE="409 848 2181 842" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 848 409 863 1588 870 1590 870 1674 859 2179 859 2181 842 2179 814 2151 801 2148 801 2146 801 2144 801 2122 812 2101 801 2099 801 2097 801 2094 801 2068 812 1932 801 1930 801 1928 801 1895 812 1869 801 1867 801 1865 801 1815 812 1787 801 1785 801 1782 801 1728 812 1707 801 1705 801 1702 801 1700 801 1661 812 1598 801 1596 801 1594 801 1592 801 1577 816 1421 816 1406 803 1403 803 1401 803 1399 803 1397 803 1367 814 1159 803 1157 803 1083 814 1020 803 1018 803 1016 803 1014 803 992 816 773 805 771 805 769 805 734 816 691 805 689 805 687 805 407 812 409 848"/>
                        </Shape>
                        <String CONTENT="in Maydell’s time were dependent on other people’s herds, had for their"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l6" HPOS="407" VPOS="866" WIDTH="1774" HEIGHT="58" BASELINE="409 909 2181 905" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 909 409 924 2179 920 2181 905 2177 874 459 866 457 866 407 876 409 909"/>
                        </Shape>
                        <String CONTENT="subsistence, as a rule, herds of their own. On the Omolon, Eiˊheli, the son"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l7" HPOS="409" VPOS="926" WIDTH="1772" HEIGHT="57" BASELINE="412 967 2181 963" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="412 967 412 983 2179 978 2181 963 2177 935 446 926 444 926 442 926 409 937 412 967"/>
                        </Shape>
                        <String CONTENT="of Amraˊkwurg̣ɪn, — the rich herdsman (now deceased) who was selected by"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l8" HPOS="412" VPOS="991" WIDTH="1771" HEIGHT="52" BASELINE="412 1026 2183 1026" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="412 1026 412 1041 2181 1043 2183 1026 2183 993 412 991 412 1026"/>
                        </Shape>
                        <String CONTENT="Maydell for the position of “principal chief,” — had five large herds instead"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l9" HPOS="405" VPOS="1041" WIDTH="1778" HEIGHT="61" BASELINE="407 1086 2183 1082" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1086 407 1102 2181 1097 2183 1082 2179 1052 1306 1041 1304 1041 1302 1041 1300 1041 1287 1052 448 1043 446 1043 444 1043 405 1054 407 1086"/>
                        </Shape>
                        <String CONTENT="of the two of his father.¹ His brother-in-law and one of his cousins had three"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l10" HPOS="407" VPOS="1115" WIDTH="1776" HEIGHT="47" BASELINE="407 1145 2183 1145" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1145 407 1162 2183 1162 2183 1145 2183 1115 407 1115 407 1145"/>
                        </Shape>
                        <String CONTENT="each, etc. In 1901, however, I heard in Anadyr that the reindeer-herds in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l11" HPOS="409" VPOS="1164" WIDTH="1332" HEIGHT="68" BASELINE="409 1206 1741 1206" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1206 409 1221 741 1232 743 1232 1741 1221 1741 1206 1741 1175 427 1164 425 1164 422 1164 420 1164 409 1171 409 1206"/>
                        </Shape>
                        <String CONTENT="Omolon country were greatly reduced by the hoof-disease."/>
                    </TextLine>
<TextLine ID="mz_1-099_l12" HPOS="516" VPOS="1219" WIDTH="1669" HEIGHT="62" BASELINE="518 1266 2185 1260" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="518 1266 518 1281 2183 1277 2185 1260 2181 1232 1919 1219 1917 1219 1821 1229 1763 1219 1761 1219 1668 1229 1644 1219 1642 1219 1640 1219 1637 1219 1635 1219 1616 1234 1503 1234 1488 1221 1486 1221 1484 1221 1481 1221 1479 1221 1442 1232 1308 1221 1306 1221 1135 1232 1107 1221 1105 1221 1102 1221 1100 1221 1068 1234 1007 1223 1005 1223 1003 1223 970 1234 892 1223 890 1223 888 1223 847 1234 836 1223 834 1223 832 1223 830 1223 516 1229 518 1266"/>
                        </Shape>
                        <String CONTENT="I mentioned before that the inhabitants of several maritime villages have"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l13" HPOS="405" VPOS="1284" WIDTH="1778" HEIGHT="60" BASELINE="407 1327 2183 1322" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1327 407 1344 2181 1340 2183 1322 2179 1290 537 1284 535 1284 405 1294 407 1327"/>
                        </Shape>
                        <String CONTENT="turned reindeer-breeders, and that even some of the Asiatic Eskimo have acquired"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l14" HPOS="405" VPOS="1342" WIDTH="1778" HEIGHT="65" BASELINE="407 1387 2183 1381" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1387 407 1400 2166 1407 2168 1407 2170 1407 2172 1407 2183 1396 2183 1381 2179 1351 1038 1342 1035 1342 1033 1342 994 1353 457 1344 455 1344 405 1355 407 1387"/>
                        </Shape>
                        <String CONTENT="reindeer-herds. Thus Kuvaˊr of Indian Point had two large herds that he had"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l15" HPOS="405" VPOS="1398" WIDTH="1776" HEIGHT="72" BASELINE="407 1448 2181 1442" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1448 407 1470 2179 1457 2181 1442 2179 1411 2151 1398 2148 1398 2146 1398 2144 1398 2101 1409 2055 1398 2053 1398 2051 1398 2049 1398 2047 1398 2032 1409 2006 1398 2003 1398 2001 1398 1999 1398 1969 1409 1575 1400 1572 1400 1570 1400 1568 1400 1555 1411 1494 1400 1492 1400 1490 1400 1468 1411 1388 1400 1386 1400 1308 1411 1282 1400 1280 1400 1278 1400 1276 1400 1274 1400 1261 1411 1248 1400 1245 1400 1243 1400 1152 1400 1150 1400 1083 1411 1053 1400 1050 1400 1048 1400 1046 1400 1044 1400 1031 1411 1003 1400 1001 1400 999 1400 921 1413 862 1403 860 1403 620 1413 539 1403 537 1403 483 1413 448 1403 446 1403 444 1403 442 1403 405 1416 407 1448"/>
                        </Shape>
                        <String CONTENT="placed in charge of a Reindeer-Chukchee friend, whom he kept supplied with"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l16" HPOS="407" VPOS="1463" WIDTH="1728" HEIGHT="59" BASELINE="409 1506 2135 1502" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1506 409 1522 2133 1517 2135 1502 2131 1472 570 1463 568 1463 407 1474 409 1506"/>
                        </Shape>
                        <String CONTENT="every American, Russian, or Eskimo ware required for the use of his family."/>
                    </TextLine>
<TextLine ID="mz_1-099_l17" HPOS="513" VPOS="1522" WIDTH="1668" HEIGHT="60" BASELINE="516 1567 2181 1561" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="516 1567 516 1582 2179 1576 2181 1561 2177 1532 1748 1522 1746 1522 1588 1535 513 1535 516 1567"/>
                        </Shape>
                        <String CONTENT="DOMESTICATED REINDEER. — There are several races of domesticated rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l18" HPOS="405" VPOS="1582" WIDTH="1776" HEIGHT="59" BASELINE="407 1626 2181 1621" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1626 407 1641 2179 1636 2181 1621 2177 1591 431 1582 429 1582 427 1582 405 1591 407 1626"/>
                        </Shape>
                        <String CONTENT="deer. The Chukchee reindeer (tɪmñêˊ-qor, “ordinary reindeer”) is distinctively"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l19" HPOS="409" VPOS="1643" WIDTH="1770" HEIGHT="63" BASELINE="409 1686 2179 1686" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1686 409 1699 2177 1706 2179 1686 2179 1654 2157 1643 2155 1643 2153 1643 1388 1654 1252 1643 1250 1643 1170 1654 1083 1643 1081 1643 921 1654 862 1643 860 1643 858 1643 827 1654 778 1643 775 1643 685 1654 637 1643 635 1643 633 1643 548 1654 431 1643 429 1643 427 1643 425 1643 409 1652 409 1686"/>
                        </Shape>
                        <String CONTENT="different from the Lamut reindeer (waˊwa-qor or waˊwaq). It is undersized,"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l20" HPOS="405" VPOS="1708" WIDTH="1776" HEIGHT="56" BASELINE="407 1749 2181 1740" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1749 407 1764 2179 1758 2181 1740 2174 1708 405 1714 407 1749"/>
                        </Shape>
                        <String CONTENT="its legs are shorter, body heavier, head not so long, the antlers thicker and"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l21" HPOS="407" VPOS="1773" WIDTH="1772" HEIGHT="52" BASELINE="409 1807 2179 1803" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1807 409 1823 2174 1825 2179 1803 2174 1773 407 1773 409 1807"/>
                        </Shape>
                        <String CONTENT="heavier and the difference between buck and doe in this respect less marked,"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l22" HPOS="405" VPOS="1823" WIDTH="1778" HEIGHT="60" BASELINE="407 1868 2183 1862" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 1868 407 1883 2181 1877 2183 1862 2179 1831 1016 1823 1014 1823 940 1833 479 1825 477 1825 405 1836 407 1868"/>
                        </Shape>
                        <String CONTENT="and the general color of the animal of darker hue. The Koryak reindeer is"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l23" HPOS="407" VPOS="1881" WIDTH="1774" HEIGHT="61" BASELINE="409 1927 2181 1922" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1927 409 1942 2179 1937 2181 1922 2177 1894 1371 1881 1369 1881 1367 1881 1334 1892 1297 1881 1295 1881 1293 1881 1204 1894 986 1883 983 1883 905 1894 877 1883 875 1883 873 1883 871 1883 869 1883 853 1894 819 1883 817 1883 814 1883 812 1883 810 1883 793 1894 765 1883 762 1883 760 1883 680 1894 600 1883 598 1883 513 1894 453 1883 451 1883 448 1883 407 1896 409 1927"/>
                        </Shape>
                        <String CONTENT="still smaller and darker than that of the Chukchee. The Lamut reindeer on"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l24" HPOS="407" VPOS="1937" WIDTH="1776" HEIGHT="65" BASELINE="409 1987 2183 1978" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 1987 409 2002 2181 1994 2183 1978 2179 1950 2094 1937 2092 1937 2090 1937 2064 1948 2049 1937 2047 1937 2045 1937 2042 1937 2040 1937 2038 1937 2023 1950 1928 1950 1904 1937 1902 1937 1899 1937 1897 1937 1878 1948 1863 1937 1860 1937 1858 1937 1856 1937 1854 1937 1826 1948 1780 1937 1778 1937 1776 1937 1774 1937 1724 1950 1702 1939 1700 1939 1698 1939 1393 1950 1369 1939 1367 1939 1365 1939 1362 1939 1341 1950 1313 1939 1310 1939 1308 1939 1306 1939 1304 1939 1289 1952 1163 1942 1161 1942 986 1952 953 1942 951 1942 949 1942 947 1942 925 1952 892 1942 890 1942 888 1942 886 1942 884 1942 869 1952 513 1944 511 1944 509 1944 487 1955 433 1944 431 1944 429 1944 427 1944 407 1952 409 1987"/>
                        </Shape>
                        <String CONTENT="the Sea of Okhotsk is large, and the darkest of all. The Chukchee reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l25" HPOS="405" VPOS="2002" WIDTH="1776" HEIGHT="61" BASELINE="407 2046 2181 2039" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2046 407 2063 2179 2059 2181 2039 2177 2011 1001 2002 999 2002 996 2002 994 2002 981 2013 418 2004 416 2004 414 2004 412 2004 412 2007 405 2011 407 2046"/>
                        </Shape>
                        <String CONTENT="is quite unfit for the saddle, and is not so strong in the harness, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l26" HPOS="407" VPOS="2074" WIDTH="1774" HEIGHT="50" BASELINE="407 2106 2181 2106" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2106 407 2119 2179 2124 2181 2106 2181 2076 407 2074 407 2106"/>
                        </Shape>
                        <String CONTENT="in heavy snow, as the Lamut reindeer; but it is much better for slaughter,"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l27" HPOS="407" VPOS="2134" WIDTH="1778" HEIGHT="48" BASELINE="407 2165 2185 2165" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2165 407 2182 2185 2182 2185 2165 2185 2134 407 2134 407 2165"/>
                        </Shape>
                        <String CONTENT="since it fattens quickly, and does not lose its fat as easily. In good pasture"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l28" HPOS="405" VPOS="2184" WIDTH="1778" HEIGHT="59" BASELINE="407 2227 2183 2223" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2227 407 2243 2181 2238 2183 2223 2179 2191 431 2184 429 2184 427 2184 405 2193 407 2227"/>
                        </Shape>
                        <String CONTENT="the Chukchee reindeer accumulates so much fat that its whole body is covered"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l29" HPOS="405" VPOS="2240" WIDTH="1722" HEIGHT="63" BASELINE="407 2288 2127 2282" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2288 407 2303 2125 2297 2127 2282 2122 2251 1553 2240 1551 2240 1549 2240 1546 2240 1546 2243 1536 2251 451 2245 448 2245 446 2245 405 2256 407 2288"/>
                        </Shape>
                        <String CONTENT="with it. On the hind part, near the tail, the fat is about two inches thick."/>
                    </TextLine>
<TextLine ID="mz_1-099_l30" HPOS="511" VPOS="2305" WIDTH="1672" HEIGHT="59" BASELINE="513 2349 2183 2340" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="513 2349 513 2364 2181 2355 2183 2340 2179 2312 938 2305 936 2305 845 2316 533 2308 531 2308 529 2308 526 2308 511 2314 513 2349"/>
                        </Shape>
                        <String CONTENT="At present a brisk trade in reindeer is carried on between the Lamut"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l31" HPOS="405" VPOS="2357" WIDTH="1778" HEIGHT="80" BASELINE="407 2409 2183 2398" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2409 407 2437 500 2422 529 2433 531 2433 533 2433 600 2422 1105 2429 1107 2429 1167 2418 1339 2429 1341 2429 1343 2429 1373 2418 1445 2429 1447 2429 1594 2427 1596 2427 1618 2416 1689 2429 1692 2429 1761 2416 1774 2427 1776 2427 1778 2427 1780 2427 1891 2414 1988 2427 1990 2427 2181 2416 2183 2398 2177 2364 1951 2368 1928 2357 1925 2357 1923 2357 1854 2368 1830 2357 1828 2357 1826 2357 1824 2357 1821 2357 1800 2372 1681 2372 1655 2360 1653 2360 1650 2360 1648 2360 1605 2370 1572 2360 1570 2360 1568 2360 1306 2372 1217 2362 1215 2362 1070 2375 1012 2364 1009 2364 1007 2364 986 2375 895 2364 892 2364 834 2375 762 2364 760 2364 624 2366 622 2366 620 2366 604 2377 474 2366 472 2366 405 2379 407 2409"/>
                        </Shape>
                        <String CONTENT="and the Chukchee. The Lamut reindeer commands about twice the price of"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l32" HPOS="405" VPOS="2420" WIDTH="1776" HEIGHT="61" BASELINE="407 2468 2181 2461" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="407 2468 407 2481 2179 2476 2181 2461 2177 2433 1711 2420 1709 2420 1609 2431 1594 2420 1592 2420 1590 2420 1588 2420 1585 2420 1557 2433 1005 2422 1003 2422 1001 2422 999 2422 981 2435 524 2424 522 2424 520 2424 487 2435 431 2424 429 2424 427 2424 425 2424 405 2433 407 2468"/>
                        </Shape>
                        <String CONTENT="the Chukchee reindeer. Usually a Lamut fawn is exchanged for a grown"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l33" HPOS="407" VPOS="2485" WIDTH="1774" HEIGHT="59" BASELINE="409 2526 2181 2518" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2526 409 2544 2179 2535 2181 2518 2177 2489 425 2485 422 2485 420 2485 418 2485 407 2492 409 2526"/>
                        </Shape>
                        <String CONTENT="Chukchee reindeer. A broken Lamut reindeer is worth three Chukchee rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l34" HPOS="407" VPOS="2544" WIDTH="1774" HEIGHT="56" BASELINE="409 2585 2181 2580" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2585 409 2600 2179 2595 2181 2580 2177 2552 429 2544 427 2544 425 2544 422 2544 407 2550 409 2585"/>
                        </Shape>
                        <String CONTENT="deer; and the Lamut and the Tungus often break all the young bucks in"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l35" HPOS="407" VPOS="2600" WIDTH="1776" HEIGHT="60" BASELINE="409 2645 2183 2641" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2645 409 2660 2181 2656 2183 2641 2181 2613 2131 2600 2129 2600 2127 2600 2125 2600 2099 2611 1598 2600 1596 2600 1594 2600 1564 2611 1512 2600 1510 2600 1507 2600 1505 2600 1486 2613 1293 2613 1189 2602 1187 2602 1185 2602 1154 2613 1003 2602 1001 2602 999 2602 996 2602 981 2615 871 2615 832 2602 830 2602 827 2602 741 2613 704 2602 702 2602 700 2602 697 2602 667 2613 550 2602 548 2602 546 2602 520 2613 433 2602 431 2602 429 2602 427 2602 407 2611 409 2645"/>
                        </Shape>
                        <String CONTENT="their herds in order to barter them away to the Chukchee. Therefore the"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l36" HPOS="407" VPOS="2671" WIDTH="1776" HEIGHT="50" BASELINE="409 2706 2183 2702" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2706 409 2721 2181 2717 2183 2702 2179 2671 407 2671 409 2706"/>
                        </Shape>
                        <String CONTENT="larger portion of Chukchee harness-reindeer are at the present time of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l37" HPOS="407" VPOS="2721" WIDTH="1774" HEIGHT="61" BASELINE="409 2764 2181 2760" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2764 409 2782 2179 2777 2181 2760 2177 2732 1336 2721 1334 2721 1332 2721 1289 2734 407 2734 409 2764"/>
                        </Shape>
                        <String CONTENT="Lamut race. The Lamut, on the other hand, have stopped slaughtering their"/>
                    </TextLine>

                    <TextLine ID="mz_1-099_l38" HPOS="409" VPOS="2784" WIDTH="1774" HEIGHT="58" BASELINE="409 2825 2183 2825" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="409 2825 409 2842 2183 2842 2183 2825 2183 2797 1488 2784 1486 2784 1484 2784 1481 2784 1466 2797 1345 2797 1222 2784 1219 2784 1217 2784 1215 2784 1196 2797 1061 2797 979 2784 977 2784 975 2784 973 2784 957 2797 860 2797 767 2784 765 2784 676 2795 585 2784 583 2784 409 2795 409 2825"/>
                        </Shape>
                        <String CONTENT="own reindeer, because they can always get Chukchee reindeer, which are"/>
