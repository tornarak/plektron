                        </Shape>
                        <String CONTENT="X. — CLOTHING."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-298_r2" HPOS="612" VPOS="1022" WIDTH="1778" HEIGHT="1030" TAGREFS="TYPE_2">
