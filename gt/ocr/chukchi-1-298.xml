                        <Polygon POINTS="612 1022 2390 1022 2390 2052 612 2052"/>
                    </Shape>
                    <TextLine ID="mz_1-298_l2" HPOS="723" VPOS="1026" WIDTH="1665" HEIGHT="50" BASELINE="725 1063 2388 1058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="725 1063 725 1076 2386 1071 2388 1058 2384 1026 723 1026 725 1063"/>
                        </Shape>
                        <String CONTENT="There is no particular difference between the clothes of Reindeer and"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l3" HPOS="615" VPOS="1084" WIDTH="1773" HEIGHT="52" BASELINE="617 1117 2388 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1117 615 1132 2384 1136 2388 1121 2386 1088 617 1084 617 1117"/>
                        </Shape>
                        <String CONTENT="those of Maritime Chukchee, except that the former use better reindeer-skins,"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l4" HPOS="617" VPOS="1145" WIDTH="1771" HEIGHT="56" BASELINE="619 1175 2388 1179" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="619 1175 617 1192 630 1201 632 1201 634 1201 636 1201 2386 1192 2388 1179 2386 1149 619 1145 619 1175"/>
                        </Shape>
                        <String CONTENT="while the latter use seal-skins more frequently. Skins of reindeer-fawns are"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l5" HPOS="615" VPOS="1205" WIDTH="1773" HEIGHT="52" BASELINE="617 1240 2388 1236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1240 617 1257 2386 1253 2388 1236 2384 1208 615 1205 617 1240"/>
                        </Shape>
                        <String CONTENT="highly prized as material for clothing, because they are very warm and at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l6" HPOS="617" VPOS="1270" WIDTH="1771" HEIGHT="46" BASELINE="617 1301 2388 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1301 617 1316 2388 1316 2388 1301 2388 1270 617 1270 617 1301"/>
                        </Shape>
                        <String CONTENT="same time so light that a man clad in double garments is able to bustle"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l7" HPOS="615" VPOS="1329" WIDTH="1773" HEIGHT="47" BASELINE="615 1359 2388 1359" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1359 615 1376 2388 1376 2388 1359 2388 1329 615 1329 615 1359"/>
                        </Shape>
                        <String CONTENT="around in the open quite freely. When Middendorff¹ says that in his opinion"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l8" HPOS="612" VPOS="1376" WIDTH="1774" HEIGHT="70" BASELINE="615 1420 2386 1415" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1420 615 1435 935 1446 937 1446 939 1446 942 1446 959 1435 1334 1435 1440 1446 1442 1446 1624 1433 1842 1444 1845 1444 1847 1444 1877 1433 2024 1444 2027 1444 2029 1444 2031 1444 2048 1433 2100 1444 2102 1444 2105 1444 2107 1444 2120 1433 2133 1444 2135 1444 2137 1444 2139 1446 2302 1446 2302 1444 2304 1444 2325 1433 2360 1444 2362 1444 2364 1444 2367 1444 2369 1444 2386 1431 2386 1415 2382 1387 1500 1376 1498 1376 1496 1376 1448 1387 770 1379 768 1379 612 1389 615 1420"/>
                        </Shape>
                        <String CONTENT="a good sheep-skin coat is to be preferred for travel, it may be ascribed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l9" HPOS="615" VPOS="1435" WIDTH="1769" HEIGHT="65" BASELINE="617 1478 2384 1483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1478 615 1491 2380 1500 2384 1483 2382 1450 2323 1437 2321 1437 1886 1448 1855 1437 1853 1437 1851 1437 1849 1437 1806 1448 1747 1437 1745 1437 1743 1437 1741 1437 1726 1450 1578 1450 1520 1437 1518 1437 1515 1437 1513 1437 1500 1448 1459 1435 1457 1435 1455 1435 1453 1435 1422 1446 1392 1435 1390 1435 1388 1435 1314 1446 1271 1435 1269 1435 1266 1435 1264 1435 1230 1446 1184 1435 1182 1435 1180 1435 1082 1448 952 1448 937 1435 935 1435 933 1435 931 1435 929 1435 907 1446 846 1435 844 1435 842 1435 814 1446 740 1435 738 1435 617 1444 617 1478"/>
                        </Shape>
                        <String CONTENT="the fact that he travelled only with the Tungus. The latter select for clothing"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l10" HPOS="612" VPOS="1506" WIDTH="1774" HEIGHT="57" BASELINE="615 1537 2386 1541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1537 612 1550 634 1563 636 1563 638 1563 2384 1554 2386 1541 2384 1511 615 1506 615 1537"/>
                        </Shape>
                        <String CONTENT="either the thinnest summer skins for making their holiday garments, or the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l11" HPOS="612" VPOS="1556" WIDTH="1776" HEIGHT="61" BASELINE="615 1602 2388 1597" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1602 615 1617 2386 1612 2388 1597 2386 1569 2336 1556 2334 1556 2332 1556 2330 1556 2304 1569 1899 1569 1884 1556 1881 1556 1879 1556 1877 1556 1769 1567 612 1565 615 1602"/>
                        </Shape>
                        <String CONTENT="heaviest winter skins for making short overcoats, which are put on over the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l12" HPOS="615" VPOS="1615" WIDTH="1773" HEIGHT="60" BASELINE="617 1660 2388 1656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1660 617 1675 2386 1671 2388 1656 2384 1628 2219 1615 2217 1615 2163 1625 2148 1615 2146 1615 2143 1615 2141 1615 2139 1615 2137 1615 2118 1628 1944 1628 1877 1615 1875 1615 1873 1615 1871 1615 1855 1628 1769 1628 1713 1615 1710 1615 1708 1615 1674 1625 1645 1615 1643 1615 1641 1615 1580 1625 1505 1615 1502 1615 1442 1628 1379 1617 1377 1617 1375 1617 1340 1628 1197 1617 1195 1617 1119 1628 1041 1617 1039 1617 1037 1617 1004 1628 944 1617 942 1617 939 1617 937 1617 920 1628 788 1617 786 1617 783 1617 753 1628 718 1617 716 1617 714 1617 615 1630 617 1660"/>
                        </Shape>
                        <String CONTENT="usual clothes for riding-trips in the middle of winter. Moreover, the Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l13" HPOS="617" VPOS="1690" WIDTH="1771" HEIGHT="48" BASELINE="617 1721 2388 1721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1721 617 1738 2388 1738 2388 1721 2388 1690 617 1690 617 1721"/>
                        </Shape>
                        <String CONTENT="usually have only small herds of reindeer, and cannot very well choose their"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l14" HPOS="617" VPOS="1738" WIDTH="1771" HEIGHT="58" BASELINE="617 1781 2388 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 1781 617 1796 2388 1796 2388 1781 2388 1751 2336 1738 2334 1738 2332 1738 2308 1749 2295 1738 2293 1738 2291 1738 2189 1738 2187 1738 2185 1738 2182 1738 2167 1749 1864 1738 1862 1738 1775 1749 1719 1738 1717 1738 1652 1749 1622 1738 1619 1738 1617 1738 1615 1738 1593 1749 1544 1738 1541 1738 1414 1749 1360 1738 1357 1738 1355 1738 1314 1749 1251 1738 1249 1738 1080 1749 1059 1738 1056 1738 864 1738 861 1738 859 1738 814 1749 757 1738 755 1738 753 1738 716 1749 638 1738 636 1738 634 1738 632 1738 617 1747 617 1781"/>
                        </Shape>
                        <String CONTENT="time for slaughtering or pick those animals whose skins are best fitted for"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l15" HPOS="615" VPOS="1809" WIDTH="1771" HEIGHT="48" BASELINE="615 1840 2386 1840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1840 615 1857 2386 1857 2386 1840 2386 1809 615 1809 615 1840"/>
                        </Shape>
                        <String CONTENT="clothing, as the wealthy reindeer-breeders of the extreme northeast do. Skins"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l16" HPOS="612" VPOS="1864" WIDTH="1776" HEIGHT="58" BASELINE="615 1894 2388 1900" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 1894 612 1911 625 1920 628 1920 630 1920 632 1920 1024 1911 1208 1922 1210 1922 2386 1913 2388 1900 2386 1870 615 1864 615 1894"/>
                        </Shape>
                        <String CONTENT="of the wolf, and perhaps also those of the wild sheep, surpass those of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l17" HPOS="610" VPOS="1924" WIDTH="1778" HEIGHT="52" BASELINE="612 1954 2388 1961" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="612 1954 610 1970 2384 1976 2388 1961 2386 1931 612 1924 612 1954"/>
                        </Shape>
                        <String CONTENT="reindeer in their wearing and protecting qualities, but both are too rare to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l18" HPOS="615" VPOS="1974" WIDTH="892" HEIGHT="71" BASELINE="617 2015 1507 2019" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2015 615 2032 625 2041 628 2041 630 2041 632 2041 736 2032 777 2043 779 2043 781 2045 926 2045 926 2043 929 2043 931 2043 931 2041 942 2032 1457 2045 1459 2045 1505 2035 1507 2019 1505 1989 1437 1976 1338 1976 1336 1976 1334 1976 1331 1976 1318 1987 1258 1976 1256 1976 1253 1976 1227 1987 1212 1976 1210 1976 1208 1976 1206 1976 926 1985 916 1976 916 1974 913 1974 911 1974 909 1974 907 1974 879 1985 861 1974 859 1974 857 1974 855 1974 853 1974 816 1987 731 1987 718 1974 716 1974 714 1974 712 1974 617 1983 617 2015"/>
                        </Shape>
                        <String CONTENT="used regularly as material for clothing."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-298_r3" HPOS="612" VPOS="2052" WIDTH="1778" HEIGHT="837" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="612 2052 2390 2052 2390 2889 612 2889"/>
                    </Shape>
                    <TextLine ID="mz_1-298_l19" HPOS="723" VPOS="2035" WIDTH="1665" HEIGHT="60" BASELINE="725 2076 2388 2080" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="725 2076 723 2091 2384 2095 2388 2080 2386 2050 2202 2037 2105 2037 2102 2037 2100 2037 2098 2037 2083 2048 2009 2037 2007 2037 1953 2048 1897 2037 1894 2037 1892 2037 1866 2048 1806 2037 1803 2037 1801 2037 1769 2048 1671 2037 1669 2037 1563 2048 1515 2035 1513 2035 1511 2035 1509 2035 1472 2048 1342 2048 1327 2035 1325 2035 1323 2035 1321 2035 1318 2035 1288 2045 1245 2035 1243 2035 1240 2035 1238 2035 1212 2045 1184 2035 1182 2035 1180 2035 1178 2035 1136 2045 725 2039 725 2076"/>
                        </Shape>
                        <String CONTENT="The Maritime people in these regions, unlike the American Eskimo, use"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l20" HPOS="610" VPOS="2104" WIDTH="1776" HEIGHT="58" BASELINE="612 2136 2386 2141" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="612 2136 610 2149 651 2162 654 2162 656 2162 2384 2154 2386 2141 2384 2108 612 2104 612 2136"/>
                        </Shape>
                        <String CONTENT="seal-skin but little for coats. This is because seal gives but slight protection"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l21" HPOS="612" VPOS="2165" WIDTH="1772" HEIGHT="49" BASELINE="615 2197 2384 2201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2197 612 2210 2380 2214 2384 2201 2382 2169 615 2165 615 2197"/>
                        </Shape>
                        <String CONTENT="against the cold, while, on the other hand, it brings a much better price in"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l22" HPOS="612" VPOS="2214" WIDTH="1772" HEIGHT="61" BASELINE="615 2260 2384 2255" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2260 615 2275 2382 2273 2384 2255 2382 2227 2345 2214 2343 2214 2341 2214 2338 2214 2293 2227 2169 2227 2154 2214 2152 2214 2150 2214 2148 2214 2066 2225 2042 2214 2040 2214 2037 2214 1938 2225 1892 2214 1890 2214 1888 2214 1886 2214 1862 2225 1838 2214 1836 2214 1834 2214 1832 2214 1829 2214 1814 2225 1777 2214 1775 2214 1773 2214 1771 2214 1769 2214 1754 2227 1498 2227 1479 2216 1476 2216 1474 2216 1472 2216 1412 2227 991 2216 989 2216 924 2227 861 2216 859 2216 857 2216 825 2227 690 2216 688 2216 612 2229 615 2260"/>
                        </Shape>
                        <String CONTENT="exchange for reindeer-skins. For this reason we find that only reindeer-skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l23" HPOS="615" VPOS="2286" WIDTH="1771" HEIGHT="50" BASELINE="615 2320 2386 2320" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2320 615 2336 2386 2336 2386 2320 2386 2290 615 2286 615 2320"/>
                        </Shape>
                        <String CONTENT="is used for winter coats. Seal-skin is more useful for trousers, because it"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l24" HPOS="617" VPOS="2349" WIDTH="1769" HEIGHT="47" BASELINE="617 2379 2386 2379" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2379 617 2396 2386 2396 2386 2379 2386 2349 617 2349 617 2379"/>
                        </Shape>
                        <String CONTENT="wears better, especially in the damp weather of spring. For spring and summer"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l25" HPOS="615" VPOS="2400" WIDTH="1771" HEIGHT="61" BASELINE="617 2437 2386 2442" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2437 615 2448 736 2461 738 2461 2384 2452 2386 2442 2384 2405 617 2400 617 2437"/>
                        </Shape>
                        <String CONTENT="boots, seal-skin is most serviceable. It is tough, wears extremely well, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l26" HPOS="612" VPOS="2459" WIDTH="1774" HEIGHT="58" BASELINE="615 2500 2386 2496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2500 615 2517 2384 2513 2386 2496 2382 2468 649 2459 647 2459 645 2459 612 2470 615 2500"/>
                        </Shape>
                        <String CONTENT="affords better protection against dampness and water than any other hide known"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l27" HPOS="615" VPOS="2524" WIDTH="387" HEIGHT="48" BASELINE="617 2554 1002 2559" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2554 615 2567 998 2572 1002 2559 1000 2528 617 2524 617 2554"/>
                        </Shape>
                        <String CONTENT="to these natives."/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l28" HPOS="723" VPOS="2578" WIDTH="1665" HEIGHT="56" BASELINE="725 2613 2388 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="725 2613 723 2628 2384 2634 2388 2619 2388 2587 725 2578 725 2613"/>
                        </Shape>
                        <String CONTENT="While the Maritime Chukchee depend on reindeer-breeders for their winter"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l29" HPOS="612" VPOS="2643" WIDTH="1774" HEIGHT="52" BASELINE="615 2675 2386 2682" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2675 612 2688 2382 2695 2386 2682 2384 2649 615 2643 615 2675"/>
                        </Shape>
                        <String CONTENT="clothes, the latter obtain boots and sole leather from the coast tribes. Late"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l30" HPOS="612" VPOS="2699" WIDTH="1774" HEIGHT="63" BASELINE="615 2734 2386 2740" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 2734 612 2747 697 2760 699 2760 1082 2751 1236 2762 1238 2762 2384 2753 2386 2740 2386 2710 2362 2699 2360 2699 2358 2699 615 2699 615 2734"/>
                        </Shape>
                        <String CONTENT="in the spring, when short of seal-skin, the herdsmen will use it only to patch"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l31" HPOS="615" VPOS="2764" WIDTH="1769" HEIGHT="50" BASELINE="617 2795 2384 2799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2795 615 2810 2380 2814 2384 2799 2382 2769 617 2764 617 2795"/>
                        </Shape>
                        <String CONTENT="out the uppers of a pair of ordinary reindeer-skin boots, so that they will wear"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l32" HPOS="617" VPOS="2823" WIDTH="589" HEIGHT="49" BASELINE="617 2857 1206 2857" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 2857 617 2872 1206 2872 1206 2857 1206 2827 617 2823 617 2857"/>
                        </Shape>
                        <String CONTENT="better in the damp snow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-298_r4" HPOS="612" VPOS="2889" WIDTH="1778" HEIGHT="298" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="612 2889 2390 2889 2390 3187 612 3187"/>
                    </Shape>
                    <TextLine ID="mz_1-298_l33" HPOS="725" VPOS="2870" WIDTH="1661" HEIGHT="70" BASELINE="727 2914 2386 2920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="727 2914 725 2924 747 2937 749 2937 751 2937 1262 2929 1277 2940 1279 2940 1282 2940 1284 2940 2384 2931 2386 2920 2384 2888 2312 2875 2310 2875 2308 2875 2282 2885 2267 2875 2265 2875 2263 2875 2260 2875 2139 2885 2087 2875 2085 2875 2083 2875 2081 2875 2068 2885 2048 2875 2046 2875 2044 2875 2042 2875 2040 2875 2024 2888 1897 2888 1871 2875 1868 2875 1866 2875 1864 2875 1862 2875 1849 2885 1832 2872 1829 2872 1827 2872 1825 2872 1823 2872 1793 2883 1775 2872 1773 2872 1771 2872 1769 2872 1767 2872 1728 2883 1674 2872 1671 2872 1602 2883 1535 2872 1533 2872 1474 2883 1282 2870 1279 2870 1277 2870 1256 2881 727 2875 727 2914"/>
                        </Shape>
                        <String CONTENT="WINTER CLOTHING FOR MEN. — The style of clothes used by Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l34" HPOS="612" VPOS="2935" WIDTH="1774" HEIGHT="59" BASELINE="612 2979 2386 2979" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="612 2979 612 2994 2386 2994 2386 2979 2386 2948 2310 2935 2308 2935 2306 2935 2273 2946 2211 2935 2208 2935 2206 2935 2178 2946 2146 2935 2143 2935 2141 2935 2139 2935 2109 2948 1864 2948 1823 2935 1821 2935 1819 2935 1739 2946 1713 2935 1710 2935 1708 2935 1626 2946 1591 2935 1589 2935 1587 2935 1531 2946 1507 2935 1505 2935 1353 2935 1351 2935 1290 2946 1260 2935 1258 2935 1256 2935 1253 2935 1251 2935 1236 2946 1132 2935 1130 2935 1071 2946 1037 2935 1035 2935 1033 2935 1030 2935 1028 2935 1013 2948 900 2948 885 2935 883 2935 881 2935 686 2935 684 2935 612 2946 612 2979"/>
                        </Shape>
                        <String CONTENT="and Koryak men in winter is admirably adapted to its purpose. It therefore"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l35" HPOS="615" VPOS="3007" WIDTH="1769" HEIGHT="49" BASELINE="615 3039 2384 3039" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="615 3039 615 3056 2384 3054 2384 3039 2384 3007 615 3007 615 3039"/>
                        </Shape>
                        <String CONTENT="prevails among most of the tribes of northeastern Asia, including the Russians."/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l36" HPOS="617" VPOS="3059" WIDTH="1769" HEIGHT="56" BASELINE="617 3098 2386 3098" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="617 3098 617 3115 2386 3115 2386 3098 2386 3067 617 3059 617 3098"/>
                        </Shape>
                        <String CONTENT="Even the northern Lamut, who in ordinary life wear narrow coats, and aprons"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l37" HPOS="615" VPOS="3117" WIDTH="1765" HEIGHT="65" BASELINE="617 3152 2380 3160" TAGREFS="TYPE_5">
                        <Shape>
