                <TextBlock ID="mz_1-138_r2" HPOS="543" VPOS="718" WIDTH="1778" HEIGHT="1505" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="543 718 2321 718 2321 2223 543 2223"/>
                    </Shape>
                    <TextLine ID="mz_1-138_l3" HPOS="537" VPOS="718" WIDTH="1778" HEIGHT="65" BASELINE="537 764 2315 764" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2291 727 2270 727 2263 727 2259 729 2220 725 2205 725 2183 725 2161 723 2140 723 2133 723 2088 729 2075 721 2075 721 2055 721 2025 729 1884 718 1882 718 1804 729 1774 718 1772 718 1769 718 1767 718 1765 718 1750 731 1650 731 1618 718 1616 718 1614 718 1611 718 1609 718 1590 731 1425 731 1397 718 1395 718 1393 718 1391 718 1388 718 1373 729 1271 718 1269 718 1267 718 1232 729 1202 718 1200 718 1198 718 1196 718 1163 729 1120 718 1118 718 1115 718 1053 729 1027 718 1025 718 1022 718 951 729 918 718 916 718 914 718 912 718 871 729 847 718 845 718 843 718 840 718 838 718 823 731 732 731 706 718 704 718 702 718 700 718 697 718 682 729 583 718 581 718 578 718 537 729 537 764 537 777 2313 783 2315 764 2315 729 2307 727 2291 727"/>
                        </Shape>
                        <String CONTENT="of birch-wood; but the Arctic Chukchee use also various kinds of driftwood,"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l4" HPOS="537" VPOS="779" WIDTH="1780" HEIGHT="61" BASELINE="539 825 2317 820" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="539 825 539 840 2315 835 2317 820 2313 792 2118 779 2116 779 2114 779 2112 779 2097 792 1967 792 1941 779 1938 779 1936 779 1934 779 1932 779 1917 792 1772 792 1718 779 1715 779 1624 790 1609 779 1607 779 1605 779 1490 779 1488 779 1486 779 1447 790 1432 779 1429 779 1427 779 1425 779 1423 779 1388 792 791 781 788 781 786 781 756 792 661 781 659 781 537 794 539 825"/>
                        </Shape>
                        <String CONTENT="especially American pine, and even oak picked out from wreckage. On some"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l5" HPOS="537" VPOS="838" WIDTH="1776" HEIGHT="69" BASELINE="539 885 2313 881" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="539 885 539 907 2311 905 2313 881 2309 851 1936 838 1934 838 1932 838 1930 838 1915 851 1681 851 1592 838 1590 838 1512 848 1425 838 1423 838 1421 838 1395 851 1354 840 1352 840 1349 840 1029 851 1005 840 1003 840 1001 840 999 840 960 851 840 840 838 840 836 840 806 851 710 840 708 840 537 853 539 885"/>
                        </Shape>
                        <String CONTENT="parts of the Arctic shore driftwood is piled up in large masses (Plate VII, Fig. 2),"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l6" HPOS="539" VPOS="911" WIDTH="1776" HEIGHT="48" BASELINE="542 944 2315 939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 944 542 959 2313 954 2315 939 2309 911 539 913 542 944"/>
                        </Shape>
                        <String CONTENT="sometimes covering an entire acre, and wreckage may be found everywhere"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l7" HPOS="539" VPOS="959" WIDTH="1774" HEIGHT="65" BASELINE="542 1004 2313 1000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1004 542 1019 2309 1024 2313 1000 2309 970 1427 959 1425 959 1423 959 1401 970 732 961 730 961 539 972 542 1004"/>
                        </Shape>
                        <String CONTENT="among the wood. The Pacific people buy lumber from whalers, or even bring"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l8" HPOS="539" VPOS="1030" WIDTH="1776" HEIGHT="50" BASELINE="542 1065 2315 1061" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1065 542 1080 2313 1076 2315 1061 2311 1030 539 1030 542 1065"/>
                        </Shape>
                        <String CONTENT="it themselves from St. Lawrence Island or the Alaskan shore in their boats."/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l9" HPOS="542" VPOS="1078" WIDTH="1773" HEIGHT="58" BASELINE="544 1123 2315 1119" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1123 544 1136 2313 1134 2315 1119 2313 1089 2294 1078 2291 1078 2289 1078 2287 1078 2285 1078 2257 1089 2211 1078 2209 1078 2207 1078 2103 1089 2073 1078 2071 1078 2068 1078 2066 1078 2040 1091 1951 1091 1936 1078 1934 1078 1932 1078 1930 1078 1928 1078 1897 1089 1826 1078 1824 1078 1821 1078 1778 1089 1752 1078 1750 1078 1748 1078 1486 1089 1429 1078 1427 1078 1425 1078 1423 1078 1401 1091 1317 1080 1315 1080 1313 1080 1280 1091 1217 1080 1215 1080 1213 1080 1178 1091 1137 1080 1135 1080 1133 1080 1131 1080 1089 1091 1018 1080 1016 1080 1014 1080 979 1091 542 1086 544 1123"/>
                        </Shape>
                        <String CONTENT="Birch runners are fit only for the cold season, and after the end of March"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l10" HPOS="544" VPOS="1149" WIDTH="1773" HEIGHT="50" BASELINE="544 1180 2317 1180" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1180 544 1199 2317 1199 2317 1180 2315 1149 544 1149 544 1180"/>
                        </Shape>
                        <String CONTENT="will not run easily in the daytime, when the snow is damp and loose and all"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l11" HPOS="539" VPOS="1201" WIDTH="1776" HEIGHT="57" BASELINE="542 1242 2315 1238" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1242 542 1258 2313 1253 2315 1238 2311 1210 561 1201 559 1201 557 1201 555 1201 539 1208 542 1242"/>
                        </Shape>
                        <String CONTENT="the sharp points of the ground protrude. The friction of birch-wood is so"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l12" HPOS="539" VPOS="1268" WIDTH="1776" HEIGHT="52" BASELINE="542 1303 2315 1296" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1303 542 1320 2313 1314 2315 1296 2309 1268 539 1273 542 1303"/>
                        </Shape>
                        <String CONTENT="strong as to tire out the best dogs, and, besides, wear out the precious run-"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l13" HPOS="539" VPOS="1320" WIDTH="1776" HEIGHT="59" BASELINE="542 1364 2315 1357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1364 542 1379 2313 1372 2315 1357 2311 1329 1206 1320 1204 1320 539 1333 542 1364"/>
                        </Shape>
                        <String CONTENT="ners in a couple of weeks. In the Kolyma district and in the eastern Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l14" HPOS="542" VPOS="1387" WIDTH="1773" HEIGHT="59" BASELINE="544 1418 2315 1422" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1418 542 1433 557 1444 559 1444 561 1444 563 1444 1334 1435 1434 1446 1436 1446 2313 1435 2315 1422 2313 1392 544 1387 544 1418"/>
                        </Shape>
                        <String CONTENT="villages, runners made from the outer layer of the larch, with twisted fibre"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l15" HPOS="542" VPOS="1437" WIDTH="1773" HEIGHT="63" BASELINE="544 1483 2315 1478" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1483 544 1500 2313 1494 2315 1478 2313 1450 2268 1437 2265 1437 2263 1437 2200 1448 2075 1437 2073 1437 2071 1437 2025 1448 1995 1437 1993 1437 1990 1437 1893 1448 1863 1437 1860 1437 1858 1437 1856 1437 1854 1437 1839 1450 1713 1450 1683 1437 1681 1437 1679 1437 1676 1437 1653 1448 1627 1437 1624 1437 1622 1437 1553 1448 1453 1437 1451 1437 1449 1437 1406 1450 559 1439 557 1439 555 1439 552 1439 542 1446 544 1483"/>
                        </Shape>
                        <String CONTENT="(called in local Russian крень), are substituted for use in springtime. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l16" HPOS="539" VPOS="1500" WIDTH="1776" HEIGHT="58" BASELINE="542 1543 2315 1537" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1543 542 1558 2313 1552 2315 1537 2311 1509 1159 1500 1157 1500 1154 1500 1126 1511 624 1502 622 1502 539 1513 542 1543"/>
                        </Shape>
                        <String CONTENT="material is obtained from the trees that grow on the mountain-slopes, and is"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l17" HPOS="539" VPOS="1556" WIDTH="1774" HEIGHT="65" BASELINE="542 1604 2313 1597" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1604 542 1619 2309 1621 2313 1597 2309 1569 2244 1556 2242 1556 2239 1556 2237 1556 2220 1567 2138 1556 2135 1556 2036 1567 2010 1556 2008 1556 2006 1556 1811 1567 1780 1556 1778 1556 1776 1556 1715 1569 1702 1558 1700 1558 1698 1558 1696 1558 1694 1558 1663 1569 1518 1558 1516 1558 1453 1569 1313 1558 1310 1558 1308 1558 1287 1569 1159 1558 1157 1558 1154 1558 1107 1571 697 1561 695 1561 693 1561 672 1571 637 1561 635 1561 633 1561 539 1574 542 1604"/>
                        </Shape>
                        <String CONTENT="much harder than the ordinary larchwood. In the damp weather of spring"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l18" HPOS="539" VPOS="1615" WIDTH="1774" HEIGHT="65" BASELINE="542 1665 2313 1656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1665 542 1680 2311 1675 2313 1656 2307 1623 2088 1626 2062 1615 2060 1615 2058 1615 2055 1615 2034 1626 2010 1615 2008 1615 2006 1615 1925 1626 1902 1615 1899 1615 1897 1615 1895 1615 1865 1628 1722 1617 1720 1617 1718 1617 1715 1617 1700 1630 1488 1630 1458 1617 1455 1617 1453 1617 1126 1630 1022 1619 1020 1619 788 1632 650 1621 648 1621 646 1621 622 1632 561 1621 559 1621 557 1621 555 1621 539 1630 542 1665"/>
                        </Shape>
                        <String CONTENT="the drivers will sometimes smear the birch runners with oil, though it may spoil"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l19" HPOS="539" VPOS="1682" WIDTH="1774" HEIGHT="56" BASELINE="542 1723 2313 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1723 542 1738 2311 1738 2313 1717 2309 1684 561 1682 559 1682 557 1682 555 1682 539 1688 542 1723"/>
                        </Shape>
                        <String CONTENT="them for the winter; or they will tie a piece of blubber to the quirt, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l20" HPOS="539" VPOS="1745" WIDTH="1776" HEIGHT="56" BASELINE="542 1784 2315 1777" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="542 1784 542 1801 2313 1794 2315 1777 2311 1745 539 1745 542 1784"/>
                        </Shape>
                        <String CONTENT="every now and then, while going ahead, whip it across the track, to be passed"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l21" HPOS="544" VPOS="1812" WIDTH="1771" HEIGHT="45" BASELINE="544 1842 2315 1842" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1842 544 1857 2315 1857 2315 1842 2315 1812 544 1812 544 1842"/>
                        </Shape>
                        <String CONTENT="over alternately by both runners, to make them more slippery. Much more"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l22" HPOS="544" VPOS="1870" WIDTH="1771" HEIGHT="48" BASELINE="544 1901 2315 1901" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1901 544 1918 2315 1918 2315 1901 2315 1870 544 1870 544 1901"/>
                        </Shape>
                        <String CONTENT="frequently the runners are shod with whalebone, or with pieces of bone taken"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l23" HPOS="542" VPOS="1929" WIDTH="1769" HEIGHT="52" BASELINE="544 1961 1852 1959 2311 1968" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 1961 542 1974 2307 1981 2311 1968 2309 1929 544 1929 544 1961"/>
                        </Shape>
                        <String CONTENT="from the whale’s jaw, sewed to the runner with sunken stitches (see Fig. 17, g)"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l24" HPOS="542" VPOS="1987" WIDTH="1773" HEIGHT="56" BASELINE="544 2017 2315 2022" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2017 542 2033 557 2043 559 2043 561 2043 563 2043 2313 2035 2315 2022 2313 1991 544 1987 544 2017"/>
                        </Shape>
                        <String CONTENT="or fastened with wooden pegs. On the Chukchee Peninsula, drivers protect"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l25" HPOS="542" VPOS="2048" WIDTH="1773" HEIGHT="50" BASELINE="544 2080 2315 2076" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2080 544 2098 2313 2093 2315 2076 2309 2048 542 2050 544 2080"/>
                        </Shape>
                        <String CONTENT="their wooden runners with bone shoeing throughout the winter, though it makes"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l26" HPOS="542" VPOS="2106" WIDTH="1771" HEIGHT="59" BASELINE="544 2137 2313 2141" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2137 542 2154 557 2165 559 2165 561 2165 563 2165 2311 2160 2313 2141 2311 2111 544 2106 544 2137"/>
                        </Shape>
                        <String CONTENT="the sledge twice as heavy, and the bone does not run smoothly on the cold,"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l27" HPOS="544" VPOS="2173" WIDTH="264" HEIGHT="44" BASELINE="544 2201 808 2201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2201 544 2217 808 2217 808 2201 808 2173 544 2173 544 2201"/>
                        </Shape>
                        <String CONTENT="crisp snow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-138_r3" HPOS="543" VPOS="2223" WIDTH="1778" HEIGHT="900" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="543 2223 2321 2223 2321 3123 543 3123"/>
                    </Shape>
                    <TextLine ID="mz_1-138_l28" HPOS="648" VPOS="2217" WIDTH="1669" HEIGHT="58" BASELINE="650 2262 2317 2258" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="650 2262 650 2275 2317 2271 2317 2258 2313 2227 1741 2217 1739 2217 648 2227 650 2262"/>
                        </Shape>
                        <String CONTENT="In the winter-time the birch runners are covered with a thin sheet of ice"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l29" HPOS="542" VPOS="2282" WIDTH="1773" HEIGHT="56" BASELINE="544 2323 2315 2316" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2323 544 2338 2313 2334 2315 2316 2311 2286 561 2282 559 2282 557 2282 555 2282 542 2288 544 2323"/>
                        </Shape>
                        <String CONTENT="to make them run more smoothly. For this purpose they are well saturated"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l30" HPOS="546" VPOS="2349" WIDTH="1769" HEIGHT="47" BASELINE="546 2381 2315 2381" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2381 546 2396 2315 2396 2315 2381 2313 2349 546 2349 546 2381"/>
                        </Shape>
                        <String CONTENT="with water in the early fall, usually by immersing them in a pool or small"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l31" HPOS="544" VPOS="2405" WIDTH="1769" HEIGHT="56" BASELINE="546 2442 2313 2437" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2442 546 2457 2309 2461 2313 2437 2309 2409 544 2405 546 2442"/>
                        </Shape>
                        <String CONTENT="lake for a couple of weeks; or in winter, when the pools are frozen, by steaming"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l32" HPOS="546" VPOS="2470" WIDTH="1769" HEIGHT="48" BASELINE="546 2500 2315 2500" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2500 546 2518 2315 2518 2315 2500 2315 2470 546 2470 546 2500"/>
                        </Shape>
                        <String CONTENT="them in long troughs filled with hot water or by frequently wetting the bottoms"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l33" HPOS="544" VPOS="2522" WIDTH="1767" HEIGHT="61" BASELINE="546 2557 2311 2561" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2557 544 2572 559 2583 561 2583 563 2583 565 2583 2309 2574 2311 2561 2307 2522 546 2524 546 2557"/>
                        </Shape>
                        <String CONTENT="with boiling water. Only damp wood, well soaked with water, will hold"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l34" HPOS="544" VPOS="2580" WIDTH="1769" HEIGHT="54" BASELINE="546 2617 2313 2621" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2617 544 2630 2309 2634 2313 2621 2309 2580 546 2585 546 2617"/>
                        </Shape>
                        <String CONTENT="the ice-sheet, which is formed by wetting the bottoms of the runners several"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l35" HPOS="546" VPOS="2650" WIDTH="1769" HEIGHT="47" BASELINE="546 2680 2315 2680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2680 546 2697 2315 2697 2315 2680 2315 2650 546 2650 546 2680"/>
                        </Shape>
                        <String CONTENT="times over by means of a small piece of skin. The colder the day, the hotter"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l36" HPOS="542" VPOS="2699" WIDTH="1773" HEIGHT="57" BASELINE="544 2741 2315 2736" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2741 544 2756 2313 2754 2315 2736 2311 2708 563 2699 561 2699 559 2699 557 2699 542 2706 544 2741"/>
                        </Shape>
                        <String CONTENT="the water that is used for the process. Larch-wood holds the ice-sheet only"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l37" HPOS="544" VPOS="2771" WIDTH="1771" HEIGHT="45" BASELINE="544 2799 2315 2799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="544 2799 544 2816 2315 2816 2315 2799 2315 2771 544 2771 544 2799"/>
                        </Shape>
                        <String CONTENT="for a short time, and bone hardly at all: therefore it is not subjected to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l38" HPOS="544" VPOS="2818" WIDTH="1771" HEIGHT="65" BASELINE="546 2862 2315 2857" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2862 546 2883 2313 2873 2315 2857 2311 2827 773 2818 771 2818 544 2829 546 2862"/>
                        </Shape>
                        <String CONTENT="process. This method of covering the runners with ice is adopted by all the"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l39" HPOS="548" VPOS="2875" WIDTH="1767" HEIGHT="60" BASELINE="550 2920 2315 2916" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="550 2920 550 2935 2313 2933 2315 2916 2311 2888 1876 2888 1860 2875 1858 2875 1856 2875 1854 2875 1852 2875 1828 2886 1761 2875 1759 2875 1756 2875 1728 2886 1696 2875 1694 2875 1692 2875 1689 2875 1663 2886 1503 2875 1501 2875 1499 2875 1460 2886 1434 2875 1432 2875 1429 2875 1427 2875 1393 2888 1352 2877 1349 2877 1347 2877 1345 2877 1321 2888 1291 2877 1289 2877 1287 2877 1284 2877 1248 2890 1126 2890 1111 2877 1109 2877 1107 2877 1105 2877 1040 2888 938 2877 936 2877 866 2888 791 2877 788 2877 548 2881 550 2920"/>
                        </Shape>
                        <String CONTENT="West Bering tribes. The people in South Kamchatka, however, on account"/>
                    </TextLine>

                    <TextLine ID="mz_1-138_l40" HPOS="546" VPOS="2951" WIDTH="1769" HEIGHT="54" BASELINE="546 2981 2315 2981" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="546 2981 546 2992 834 3005 836 3005 838 3005 884 2994 1206 2994 1258 3005 1261 3005 1401 2994 1475 3005 1477 3005 1579 2994 1841 3005 1843 3005 2216 2994 2294 3005 2296 3005 2298 3005 2300 3005 2315 2994 2315 2981 2315 2951 546 2951 546 2981"/>
                        </Shape>
