                            <Polygon POINTS="438 899 438 913 2106 909 2108 895 2104 866 1531 854 1529 854 1467 864 1436 854 1434 854 1432 854 1373 864 1336 854 1334 854 1332 854 1268 866 1204 856 1202 856 1200 856 1165 866 941 856 939 856 878 866 802 856 800 856 798 856 797 856 781 866 713 856 711 856 709 856 689 866 635 856 633 856 631 856 629 856 611 868 512 868 459 856 457 856 455 856 454 856 436 864 438 899"/>
                        </Shape>
                        <String CONTENT="As to the Maritime Chukchee, I mentioned a feud between the villages"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l9" HPOS="333" VPOS="923" WIDTH="1775" HEIGHT="50" BASELINE="333 958 2108 958" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="333 958 333 973 2108 973 2108 958 2106 923 333 923 333 958"/>
                        </Shape>
                        <String CONTENT="Luᵋˊren and Yaˊnřa-ñai, which lasted through more than ten generations, and"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l10" HPOS="333" VPOS="977" WIDTH="1276" HEIGHT="57" BASELINE="335 1020 1609 1014" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 1020 335 1034 1607 1028 1609 1014 1603 977 333 985 335 1020"/>
                        </Shape>
