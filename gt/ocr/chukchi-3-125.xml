                        </Shape>
                        <String CONTENT="ñaˊučhɪn. The latter is simply a variation of the word ñeˊus˙qät (“woman”)."/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l13" HPOS="331" VPOS="1154" WIDTH="1775" HEIGHT="61" BASELINE="333 1199 2106 1195" TAGREFS="TYPE_5">
