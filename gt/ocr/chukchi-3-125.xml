                        </Shape>
                        <String CONTENT="tive, especially with the superlative prefix čiq (čiq-äᵋmuˊlɪn, “a very weak one”)."/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l18" HPOS="337" VPOS="1455" WIDTH="1773" HEIGHT="58" BASELINE="339 1497 2110 1494" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="339 1497 339 1511 2106 1513 2110 1494 2106 1466 2034 1455 2032 1455 2030 1455 2001 1466 1900 1466 1884 1455 1882 1455 1880 1455 1878 1455 1876 1455 1851 1464 1802 1455 1800 1455 1798 1455 1773 1464 1752 1455 1750 1455 1748 1455 1746 1455 1709 1464 1502 1455 1500 1455 1498 1455 1465 1464 1292 1455 1290 1455 1210 1466 1157 1457 1155 1457 1153 1457 1128 1466 1112 1457 1110 1457 1108 1457 1106 1457 1054 1466 993 1457 991 1457 919 1466 861 1457 859 1457 857 1457 826 1466 779 1457 777 1457 775 1457 744 1466 682 1457 569 1457 567 1457 565 1457 563 1457 547 1466 337 1460 339 1497"/>
                        </Shape>
                        <String CONTENT="Vɪˊyolɪn signifies “assistant,” and is used even for some of the benevolent"/>
