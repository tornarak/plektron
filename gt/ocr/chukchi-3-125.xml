                        </Shape>
                        <String CONTENT="SLAVES. — The term for a male slave was puˊrel, and for a female slave"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l12" HPOS="333" VPOS="1096" WIDTH="1771" HEIGHT="58" BASELINE="333 1139 2104 1139" TAGREFS="TYPE_5">
                        <Shape>
