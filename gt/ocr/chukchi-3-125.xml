                        </Shape>
                        <String CONTENT="following one behind another in a long file. The old man took his bow and five arrows and killed"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l5" HPOS="331" VPOS="661" WIDTH="1773" HEIGHT="47" BASELINE="333 691 2104 687" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="333 691 333 708 2102 708 2104 687 2098 661 331 663 333 691"/>
                        </Shape>
                        <String CONTENT="five reindeer one after another, so that five sledges were left without driving-animals. The people"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l6" HPOS="333" VPOS="712" WIDTH="1771" HEIGHT="43" BASELINE="333 739 2104 739" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="333 739 333 753 2102 755 2104 739 2104 712 333 712 333 739"/>
                        </Shape>
                        <String CONTENT="of the offender had to attach their own driving-reindeer to the sledges, and to walk slowly afoot."/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l7" HPOS="335" VPOS="749" WIDTH="974" HEIGHT="51" BASELINE="335 784 1309 784" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 784 335 800 1309 800 1309 784 1307 749 335 755 335 784"/>
                        </Shape>
                        <String CONTENT="So the old man had his revenge for the burnt arrow.”"/>
                    </TextLine>
</TextBlock>
