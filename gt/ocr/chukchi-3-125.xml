                        </Shape>
                        <String CONTENT="male or female, even those belonging to one’s own family. Nevertheless all"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l21" HPOS="335" VPOS="1649" WIDTH="1773" HEIGHT="45" BASELINE="335 1677 2108 1677" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 1677 335 1694 2108 1694 2108 1677 2108 1649 335 1649 335 1677"/>
                        </Shape>
                        <String CONTENT="these terms are used in a contemptuous sense, and may be used as invectives."/>
                    </TextLine>

