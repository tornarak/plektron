                        </Shape>
                        <String CONTENT="speaking, puˊrel was a captive of another tribe, or perhaps a man of the same"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l15" HPOS="333" VPOS="1275" WIDTH="1775" HEIGHT="57" BASELINE="335 1318 2108 1314" TAGREFS="TYPE_5">
                        <Shape>
