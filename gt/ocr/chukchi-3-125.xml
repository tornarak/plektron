                        </Shape>
                        <String CONTENT="place. Then they saw the other man passing by with a caravan of sledges. The pack-sledges were"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l4" HPOS="331" VPOS="611" WIDTH="1773" HEIGHT="52" BASELINE="333 646 2104 640" TAGREFS="TYPE_5">
                        <Shape>
