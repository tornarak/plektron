                        </Shape>
                        <String CONTENT="In modern life slaves hardly exist. The remembrance of them, however,"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l24" HPOS="333" VPOS="1825" WIDTH="1773" HEIGHT="47" BASELINE="335 1858 2106 1854" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="335 1858 335 1870 2102 1872 2106 1854 2102 1827 333 1825 335 1858"/>
                        </Shape>
                        <String CONTENT="is fresh. For instance, two of my acquaintaces — one Araˊro, a very rich"/>
                    </TextLine>

