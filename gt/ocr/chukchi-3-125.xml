                        </Shape>
                        <String CONTENT="spirits. G̣ŭpɪˊlɪn signifies “a working-man,” and is applied to all workers,"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l20" HPOS="335" VPOS="1575" WIDTH="1773" HEIGHT="61" BASELINE="337 1620 2108 1612" TAGREFS="TYPE_5">
                        <Shape>
