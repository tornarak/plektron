                        </Shape>
                        <String CONTENT="Other synonymes of the word puˊrel are äᵋmuˊlɪn, vɪˊyolɪn, g̣ŭpɪˊlɪn. Properly"/>
                    </TextLine>

                    <TextLine ID="mz_3-125_l14" HPOS="333" VPOS="1217" WIDTH="1775" HEIGHT="58" BASELINE="335 1260 2108 1256" TAGREFS="TYPE_5">
                        <Shape>
