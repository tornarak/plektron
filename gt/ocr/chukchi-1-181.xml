                        </Shape>
                        <String CONTENT="On the Pacific shore some native blacksmiths, Chukchee and Eskimo,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l7" HPOS="400" VPOS="969" WIDTH="1767" HEIGHT="50" BASELINE="402 1004 2167 1000" TAGREFS="TYPE_4">
