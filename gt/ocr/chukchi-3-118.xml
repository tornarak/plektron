                        </Shape>
                        <String CONTENT="form a thanksgiving ceremonial. They darkened the vent-hole, and began to sing. Still they were"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l5" HPOS="559" VPOS="665" WIDTH="1769" HEIGHT="47" BASELINE="561 696 2328 693" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 696 561 708 2325 712 2328 693 2323 665 559 667 561 696"/>
                        </Shape>
                        <String CONTENT="not men, but dogs. Some sang, ‘Koo, koo, koo!’ Others howled, ‘Koon, koon, koon!’¹ Then"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l6" HPOS="561" VPOS="714" WIDTH="1769" HEIGHT="43" BASELINE="561 741 2330 741" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 741 561 757 2328 757 2330 741 2328 714 561 714 561 741"/>
                        </Shape>
                        <String CONTENT="the house mistress said to the girl, ‘Look there! Who are those singers? Why have they closed the"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l7" HPOS="559" VPOS="759" WIDTH="1769" HEIGHT="45" BASELINE="561 788 2328 784" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 788 561 804 2326 804 2328 784 2323 759 559 761 561 788"/>
                        </Shape>
                        <String CONTENT="entrance and darkened the vent-hole?’ The girl found a crevice, and peeped through it. They"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l8" HPOS="559" VPOS="796" WIDTH="1771" HEIGHT="58" BASELINE="561 835 2330 831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 835 561 848 2326 854 2330 831 2326 806 1461 796 1459 796 1457 796 1432 806 687 798 685 798 559 808 561 835"/>
                        </Shape>
                        <String CONTENT="were all dogs. The Chukchee people came hastily and gave them blows. The dogs fled to the"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l9" HPOS="557" VPOS="852" WIDTH="1773" HEIGHT="45" BASELINE="559 882 2330 878" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 882 559 897 2328 893 2330 878 2325 852 557 854 559 882"/>
                        </Shape>
                        <String CONTENT="west and became Russian people. Some of them, however, remained dogs, and were used by the"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l10" HPOS="557" VPOS="895" WIDTH="1771" HEIGHT="47" BASELINE="559 928 2328 924" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="559 928 559 942 2326 940 2328 924 2323 895 557 901 559 928"/>
                        </Shape>
                        <String CONTENT="others for driving. Those that were beaten got angry at the blows and began a war. O dear!"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l11" HPOS="559" VPOS="936" WIDTH="1436" HEIGHT="53" BASELINE="561 973 1995 969" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 973 561 989 1993 985 1995 969 1989 936 559 946 561 973"/>
                        </Shape>
                        <String CONTENT="we did not know. Our people chastized the dogs, and they became a people.”²"/>
                    </TextLine>
