                        </Shape>
                        <String CONTENT="“There was a small girl Yɪˊnkɪ-ñeˊut by name. Some people had gathered in a tent to per-"/>
                    </TextLine>

                    <TextLine ID="mz_3-118_l4" HPOS="557" VPOS="617" WIDTH="1773" HEIGHT="44" BASELINE="559 644 2330 648" TAGREFS="TYPE_5">
                        <Shape>
