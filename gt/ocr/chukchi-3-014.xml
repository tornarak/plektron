                        </Shape>
                        <String CONTENT="of the men. “Being women, eat crumbs,” is a saying of the Chukchee."/>
                    </TextLine>

                    <TextLine ID="mz_3-014_l5" HPOS="342" VPOS="685" WIDTH="1774" HEIGHT="58" BASELINE="344 730 2116 726" TAGREFS="TYPE_5">
                        <Shape>
