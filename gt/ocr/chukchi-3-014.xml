                        </Shape>
                        <String CONTENT="Women eat only after the men have finished.¹ Only an elderly woman, the"/>
                    </TextLine>

                    <TextLine ID="mz_3-014_l6" HPOS="339" VPOS="751" WIDTH="1777" HEIGHT="66" BASELINE="340 790 2116 784" TAGREFS="TYPE_5">
