                    <TextLine ID="mz_1-251_l3" HPOS="391" VPOS="740" WIDTH="1770" HEIGHT="61" BASELINE="391 785 2161 785" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 764 391 785 391 796 2159 801 2161 785 2161 753 2068 740 1975 740 1972 740 1970 740 1968 740 1955 751 1914 740 1912 740 1910 740 1907 740 1877 751 1855 740 1853 740 1851 740 1706 751 1678 740 1676 740 1674 740 1671 740 1669 740 1658 751 1645 740 1643 740 1641 740 1550 740 1548 740 1487 751 1407 740 1405 740 1403 740 1401 740 1388 751 1323 740 1321 740 1318 740 1290 751 1240 740 1238 740 1236 740 1234 740 1217 753 1071 753 972 740 970 740 968 740 965 740 950 753 859 753 818 740 816 740 814 740 812 740 809 740 792 753 677 753 643 740 641 740 638 740 636 740 615 751 586 740 584 740 582 740 580 740 554 753 398 753 391 764"/>
                        </Shape>
                        <String CONTENT="water of dams. In a similar way the Maritime Chukchee and the Eskimo,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l4" HPOS="394" VPOS="814" WIDTH="1767" HEIGHT="47" BASELINE="394 844 2161 844" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 844 394 861 2159 861 2161 844 2159 814 394 814 394 844"/>
                        </Shape>
                        <String CONTENT="while killing a walrus in the summer-time, far away on the open sea, open"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l5" HPOS="394" VPOS="861" WIDTH="1299" HEIGHT="59" BASELINE="394 904 1693 904" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 904 394 917 1691 920 1693 904 1693 874 1609 861 1606 861 1604 861 1557 872 1496 861 1494 861 1492 861 1466 872 1422 861 1420 861 1418 861 1416 861 1383 872 1342 861 1340 861 1338 861 1336 861 1312 872 1303 863 1303 861 1301 861 1299 861 1297 861 1295 861 1249 872 1227 861 1225 861 1223 861 1119 872 1071 861 1069 861 1067 861 1011 872 981 861 978 861 976 861 974 861 935 872 892 861 890 861 887 861 885 861 853 874 563 874 552 863 552 861 550 861 547 861 545 861 543 861 519 872 417 861 415 861 413 861 394 870 394 904"/>
                        </Shape>
