                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r3" HPOS="379" VPOS="927" WIDTH="1778" HEIGHT="894" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="379 927 2157 927 2157 1821 379 1821"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l6" HPOS="502" VPOS="926" WIDTH="1659" HEIGHT="56" BASELINE="502 963 2161 963" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="502 963 502 978 2159 982 2161 963 2161 933 502 926 502 963"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee eat more raw meat than the reindeer-breeders,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l7" HPOS="389" VPOS="978" WIDTH="1772" HEIGHT="72" BASELINE="391 1024 2161 1019" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 1024 391 1039 1230 1050 1232 1050 1353 1037 1446 1047 1448 1050 1604 1050 1604 1047 1606 1047 1609 1047 1626 1037 2055 1047 2057 1047 2059 1047 2061 1047 2074 1037 2139 1047 2141 1047 2143 1047 2146 1047 2161 1034 2161 1019 2159 991 2109 978 2107 978 2105 978 2102 978 2079 989 1992 978 1990 978 1988 978 1985 978 1968 989 1853 978 1851 978 1849 978 1847 978 1832 991 1739 991 1715 978 1713 978 1710 978 1708 978 1674 989 1641 978 1639 978 1637 978 1635 978 1632 978 1615 989 1526 978 1524 978 1522 978 1476 989 1401 978 1399 978 1396 978 1353 989 1323 978 1321 978 1318 978 1316 978 1314 978 1297 989 1277 978 1275 978 1273 978 1271 978 1245 991 1182 980 1180 980 1178 980 1130 993 1028 993 1011 980 1009 980 1007 980 1004 980 1002 980 961 991 896 980 894 980 389 989 391 1024"/>
                        </Shape>
                        <String CONTENT="because of the difficulty of procuring fuel. Especially in the spring, when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l8" HPOS="389" VPOS="1041" WIDTH="1772" HEIGHT="58" BASELINE="391 1084 2161 1078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 1084 391 1099 2159 1093 2161 1078 2156 1050 1059 1041 1056 1041 976 1052 493 1043 491 1043 389 1054 391 1084"/>
                        </Shape>
                        <String CONTENT="supply of fuel runs short and the snow is very deep, they live almost exclu-"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l9" HPOS="391" VPOS="1112" WIDTH="1772" HEIGHT="48" BASELINE="391 1143 2163 1143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 1143 391 1160 2163 1160 2163 1143 2163 1112 391 1112 391 1143"/>
                        </Shape>
                        <String CONTENT="sively on raw meat or blubber, frozen or not frozen, with the addition of some"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l10" HPOS="394" VPOS="1171" WIDTH="1769" HEIGHT="50" BASELINE="394 1201 2163 1201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1201 394 1221 2163 1221 2163 1201 2163 1171 394 1171 394 1201"/>
                        </Shape>
                        <String CONTENT="dried meat which is half putrid and tastes bitter. The meat of animals that"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l11" HPOS="391" VPOS="1218" WIDTH="1772" HEIGHT="61" BASELINE="394 1264 2163 1257" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1264 394 1279 2161 1273 2163 1257 2159 1229 1572 1218 1570 1218 1567 1218 1535 1231 391 1231 394 1264"/>
                        </Shape>
                        <String CONTENT="have died of disease is eaten without aversion. For instance, the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l12" HPOS="391" VPOS="1292" WIDTH="1774" HEIGHT="48" BASELINE="391 1322 2165 1322" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 1322 391 1340 2165 1340 2165 1322 2165 1292 391 1292 391 1322"/>
                        </Shape>
                        <String CONTENT="Chukchee consume reindeer that die of the hoof-disease, fawns that perish"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l13" HPOS="391" VPOS="1353" WIDTH="1772" HEIGHT="47" BASELINE="391 1383 2163 1383" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 1383 391 1400 2163 1400 2163 1383 2163 1353 391 1353 391 1383"/>
                        </Shape>
                        <String CONTENT="from starvation in an unfavorable spring, etc. Late in the spring and early"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l14" HPOS="391" VPOS="1398" WIDTH="1774" HEIGHT="63" BASELINE="394 1446 2165 1439" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1446 394 1461 2163 1454 2165 1439 2161 1409 1704 1398 1702 1398 1528 1411 391 1411 394 1446"/>
                        </Shape>
                        <String CONTENT="in summer, well-to-do families live almost exclusively on the meat of reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l15" HPOS="391" VPOS="1461" WIDTH="1772" HEIGHT="58" BASELINE="394 1504 2163 1500" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1504 394 1519 2161 1515 2163 1500 2159 1470 417 1461 415 1461 413 1461 391 1470 394 1504"/>
                        </Shape>
                        <String CONTENT="that have died of disease, because there is always plenty of it, and it is con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l16" HPOS="394" VPOS="1517" WIDTH="1769" HEIGHT="63" BASELINE="396 1565 2163 1560" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1565 396 1580 2161 1576 2163 1560 2159 1530 2068 1517 2066 1517 2063 1517 2044 1528 2027 1517 2024 1517 2022 1517 2020 1517 2018 1517 1979 1528 1175 1519 1173 1519 1171 1519 1169 1519 1154 1530 424 1519 422 1519 420 1519 394 1530 396 1565"/>
                        </Shape>
                        <String CONTENT="sidered sinful to throw away any kind of food unless absolutely compelled to."/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l17" HPOS="394" VPOS="1578" WIDTH="1771" HEIGHT="63" BASELINE="396 1625 2165 1619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1625 396 1641 2163 1634 2165 1619 2161 1591 2005 1578 2003 1578 2001 1578 1964 1589 1933 1578 1931 1578 1929 1578 1927 1578 1901 1591 394 1591 396 1625"/>
                        </Shape>
                        <String CONTENT="During this period, the poor people, who do not lose so many animals, live"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l18" HPOS="394" VPOS="1636" WIDTH="1771" HEIGHT="74" BASELINE="396 1686 2165 1677" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1686 396 1699 602 1710 604 1710 749 1699 1275 1706 1277 1706 1381 1695 1433 1706 1435 1706 1437 1706 1474 1695 1611 1706 1613 1706 1615 1706 1641 1695 1713 1706 1715 1706 1717 1706 1719 1706 1734 1693 1762 1703 1765 1703 1767 1703 2163 1693 2165 1677 2161 1649 1949 1649 1923 1636 1920 1636 1918 1636 1916 1636 1914 1636 1899 1649 1719 1649 1390 1638 1388 1638 1386 1638 1383 1638 1368 1649 1279 1638 1277 1638 1275 1638 1221 1651 1184 1641 1182 1641 1180 1641 1178 1641 1143 1651 1035 1641 1033 1641 957 1651 864 1641 861 1641 770 1654 744 1643 742 1643 504 1643 502 1643 394 1656 396 1686"/>
                        </Shape>
                        <String CONTENT="on slaughtered reindeer. Animals killed by wolves are eaten, but not as"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l19" HPOS="391" VPOS="1697" WIDTH="1774" HEIGHT="63" BASELINE="394 1744 2165 1738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1744 394 1760 2163 1755 2165 1738 2161 1710 1851 1697 1849 1697 1847 1697 1845 1697 1829 1708 1803 1697 1801 1697 1799 1697 1797 1697 1795 1697 1780 1710 1648 1710 1574 1697 1572 1697 1513 1710 1483 1699 1481 1699 1479 1699 1476 1699 1450 1710 900 1701 898 1701 896 1701 894 1701 881 1712 816 1701 814 1701 812 1701 775 1712 645 1701 643 1701 641 1701 638 1701 623 1714 526 1714 411 1701 409 1701 407 1701 404 1701 391 1710 394 1744"/>
                        </Shape>
                        <String CONTENT="freely as those that have died of disease, and children are forbidden to eat"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l20" HPOS="394" VPOS="1762" WIDTH="613" HEIGHT="56" BASELINE="396 1803 1007 1799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 1803 396 1818 1004 1816 1007 1799 1002 1770 435 1762 433 1762 430 1762 394 1773 396 1803"/>
                        </Shape>
                        <String CONTENT="of their hearts or marrow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r4" HPOS="379" VPOS="1821" WIDTH="1778" HEIGHT="244" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="379 1821 2157 1821 2157 2065 379 2065"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l21" HPOS="502" VPOS="1829" WIDTH="1663" HEIGHT="54" BASELINE="502 1861 2165 1861" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="502 1861 502 1874 2163 1883 2165 1861 2165 1831 502 1829 502 1861"/>
                        </Shape>
                        <String CONTENT="In former times the meat of reindeer killed by wolves was tabooed,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l22" HPOS="394" VPOS="1890" WIDTH="1773" HEIGHT="49" BASELINE="394 1922 2167 1922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1922 394 1939 2167 1939 2167 1922 2156 1890 394 1890 394 1922"/>
                        </Shape>
                        <String CONTENT="because it was believed that a man who had eaten of such meat would become"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l23" HPOS="394" VPOS="1952" WIDTH="1771" HEIGHT="48" BASELINE="394 1983 2165 1983" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1983 394 2000 2165 2000 2165 1983 2165 1952 394 1952 394 1983"/>
                        </Shape>
                        <String CONTENT="an easy mark for his foes; but at the present time this custom has lost much"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l24" HPOS="394" VPOS="2009" WIDTH="281" HEIGHT="56" BASELINE="396 2039 675 2043" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2039 394 2056 407 2065 409 2065 411 2065 413 2065 673 2056 675 2043 673 2013 396 2009 396 2039"/>
                        </Shape>
                        <String CONTENT="of its force."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r5" HPOS="379" VPOS="2065" WIDTH="1778" HEIGHT="127" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="379 2065 2157 2065 2157 2192 379 2192"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l25" HPOS="504" VPOS="2063" WIDTH="1665" HEIGHT="54" BASELINE="506 2100 2169 2104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="506 2100 504 2113 2165 2117 2169 2104 2167 2071 506 2063 506 2100"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee consume the carcasses of all sea-animals that"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l26" HPOS="391" VPOS="2121" WIDTH="1633" HEIGHT="59" BASELINE="394 2165 2024 2158" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 2165 394 2180 2022 2173 2024 2158 2020 2130 937 2121 935 2121 933 2121 898 2132 506 2123 504 2123 391 2134 394 2165"/>
                        </Shape>
                        <String CONTENT="are drifted ashore by the currents, so long as they are not too putrid."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r6" HPOS="379" VPOS="2192" WIDTH="1778" HEIGHT="298" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="379 2192 2157 2192 2157 2490 379 2490"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l27" HPOS="502" VPOS="2182" WIDTH="1665" HEIGHT="60" BASELINE="504 2225 2167 2221" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="504 2225 504 2242 2165 2242 2167 2221 2161 2188 526 2182 524 2182 521 2182 502 2190 504 2225"/>
                        </Shape>
                        <String CONTENT="Although it would be easy to construct storerooms in the frozen ground,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l28" HPOS="394" VPOS="2236" WIDTH="1775" HEIGHT="65" BASELINE="396 2286 2169 2279" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="396 2286 396 2301 2167 2294 2169 2279 2165 2247 1687 2236 1684 2236 1635 2247 1606 2236 1604 2236 1602 2236 1600 2236 1572 2249 1134 2238 1132 2238 946 2251 883 2240 881 2240 593 2251 500 2240 498 2240 446 2251 409 2240 407 2240 404 2240 402 2240 400 2240 400 2242 394 2247 396 2286"/>
                        </Shape>
                        <String CONTENT="in which meat could be preserved in good condition, the Chukchee are satisfied"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l29" HPOS="396" VPOS="2299" WIDTH="1773" HEIGHT="63" BASELINE="398 2346 2169 2338" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 2346 398 2362 2167 2353 2169 2338 2165 2307 1284 2299 1282 2299 829 2312 439 2303 437 2303 435 2303 396 2314 398 2346"/>
                        </Shape>
                        <String CONTENT="with their ill-protected cellars, in which the provisions soon begin to become"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l30" HPOS="396" VPOS="2355" WIDTH="1771" HEIGHT="71" BASELINE="398 2407 2167 2400" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="398 2407 398 2426 2165 2416 2167 2400 2159 2370 2042 2370 2009 2355 2007 2355 2005 2355 2003 2355 2001 2355 1981 2370 1923 2370 1901 2355 1899 2355 1897 2355 1894 2355 1829 2368 1773 2355 1771 2355 1769 2355 1697 2368 1624 2355 1622 2355 1619 2355 1596 2368 1580 2355 1578 2355 1576 2355 1574 2355 1572 2355 1511 2370 1457 2357 1455 2357 1453 2357 1450 2357 1422 2370 1386 2357 1383 2357 1381 2357 1282 2370 1089 2357 1087 2357 1084 2357 1050 2370 1004 2357 1002 2357 1000 2357 998 2357 996 2357 976 2372 937 2359 935 2359 933 2359 820 2372 610 2359 608 2359 606 2359 552 2372 498 2359 495 2359 493 2359 396 2375 398 2407"/>
                        </Shape>
                        <String CONTENT="putrid. Therefore both the Reindeer and the Maritime Chukchee live on"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l31" HPOS="398" VPOS="2418" WIDTH="1375" HEIGHT="67" BASELINE="400 2465 1773 2459" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 2465 400 2485 1771 2472 1773 2459 1769 2429 1314 2418 1312 2418 1310 2418 1308 2418 1290 2429 467 2422 465 2422 398 2433 400 2465"/>
                        </Shape>
                        <String CONTENT="putrid meat throughout the summer and part of the winter."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r7" HPOS="379" VPOS="2490" WIDTH="1778" HEIGHT="420" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="379 2490 2157 2490 2157 2910 379 2910"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l32" HPOS="511" VPOS="2483" WIDTH="1658" HEIGHT="56" BASELINE="511 2522 2169 2522" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="511 2522 511 2539 2169 2539 2169 2522 2169 2491 511 2483 511 2522"/>
                        </Shape>
                        <String CONTENT="When the Reindeer people drive their herds to the summer pastures, ten"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l33" HPOS="400" VPOS="2550" WIDTH="1769" HEIGHT="48" BASELINE="400 2580 2169 2580" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 2580 400 2598 2169 2598 2169 2580 2169 2550 400 2550 400 2580"/>
                        </Shape>
                        <String CONTENT="or fifteen animals are slaughtered for summer provisions. The meat is simply"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l34" HPOS="400" VPOS="2608" WIDTH="1769" HEIGHT="50" BASELINE="402 2643 2169 2639" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="402 2643 402 2658 2167 2654 2169 2639 2165 2608 400 2608 402 2643"/>
                        </Shape>
                        <String CONTENT="hung in the tent, where it is easily accessible to carrion-flies and other insects."/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l35" HPOS="402" VPOS="2669" WIDTH="1770" HEIGHT="48" BASELINE="402 2699 2172 2699" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="402 2699 402 2717 2172 2717 2172 2699 2163 2669 402 2669 402 2699"/>
                        </Shape>
                        <String CONTENT="After several days it is placed in a pit dug in the centre of the tent, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l36" HPOS="398" VPOS="2719" WIDTH="1771" HEIGHT="63" BASELINE="400 2762 2169 2758" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 2762 400 2777 2165 2782 2169 2758 2165 2730 1344 2719 1342 2719 1221 2730 556 2721 554 2721 398 2732 400 2762"/>
                        </Shape>
                        <String CONTENT="covered with sod. Later on, when the pit is opened, the stench is so strong"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l37" HPOS="398" VPOS="2779" WIDTH="1774" HEIGHT="61" BASELINE="400 2820 2172 2816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="400 2820 400 2840 2169 2836 2172 2816 2161 2786 424 2779 422 2779 420 2779 398 2788 400 2820"/>
                        </Shape>
                        <String CONTENT="that it is disagreeable to the natives themselves, who avoid staying in the tent"/>
                    </TextLine>

