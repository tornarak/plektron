                    <TextLine ID="mz_1-251_l6" HPOS="481" VPOS="911" WIDTH="1659" HEIGHT="56" BASELINE="481 948 2140 948" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="481 948 481 963 2138 967 2140 948 2140 918 481 911 481 948"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee eat more raw meat than the reindeer-breeders,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l7" HPOS="368" VPOS="963" WIDTH="1772" HEIGHT="72" BASELINE="370 1009 2140 1004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1009 370 1024 1209 1035 1211 1035 1332 1022 1425 1032 1427 1035 1583 1035 1583 1032 1585 1032 1588 1032 1605 1022 2034 1032 2036 1032 2038 1032 2040 1032 2053 1022 2118 1032 2120 1032 2122 1032 2125 1032 2140 1019 2140 1004 2138 976 2088 963 2086 963 2084 963 2081 963 2058 974 1971 963 1969 963 1967 963 1964 963 1947 974 1832 963 1830 963 1828 963 1826 963 1811 976 1718 976 1694 963 1692 963 1689 963 1687 963 1653 974 1620 963 1618 963 1616 963 1614 963 1611 963 1594 974 1505 963 1503 963 1501 963 1455 974 1380 963 1378 963 1375 963 1332 974 1302 963 1300 963 1297 963 1295 963 1293 963 1276 974 1256 963 1254 963 1252 963 1250 963 1224 976 1161 965 1159 965 1157 965 1109 978 1007 978 990 965 988 965 986 965 983 965 981 965 940 976 875 965 873 965 368 974 370 1009"/>
                        </Shape>
                        <String CONTENT="because of the difficulty of procuring fuel. Especially in the spring, when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l8" HPOS="368" VPOS="1026" WIDTH="1772" HEIGHT="58" BASELINE="370 1069 2140 1063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1069 370 1084 2138 1078 2140 1063 2135 1035 1038 1026 1035 1026 955 1037 472 1028 470 1028 368 1039 370 1069"/>
                        </Shape>
                        <String CONTENT="supply of fuel runs short and the snow is very deep, they live almost exclu-"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l9" HPOS="370" VPOS="1097" WIDTH="1772" HEIGHT="48" BASELINE="370 1128 2142 1128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1128 370 1145 2142 1145 2142 1128 2142 1097 370 1097 370 1128"/>
                        </Shape>
                        <String CONTENT="sively on raw meat or blubber, frozen or not frozen, with the addition of some"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l10" HPOS="373" VPOS="1156" WIDTH="1769" HEIGHT="50" BASELINE="373 1186 2142 1186" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1186 373 1206 2142 1206 2142 1186 2142 1156 373 1156 373 1186"/>
                        </Shape>
                        <String CONTENT="dried meat which is half putrid and tastes bitter. The meat of animals that"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l11" HPOS="370" VPOS="1203" WIDTH="1772" HEIGHT="61" BASELINE="373 1249 2142 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1249 373 1264 2140 1258 2142 1242 2138 1214 1551 1203 1549 1203 1546 1203 1514 1216 370 1216 373 1249"/>
                        </Shape>
                        <String CONTENT="have died of disease is eaten without aversion. For instance, the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l12" HPOS="370" VPOS="1277" WIDTH="1774" HEIGHT="48" BASELINE="370 1307 2144 1307" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1307 370 1325 2144 1325 2144 1307 2144 1277 370 1277 370 1307"/>
                        </Shape>
                        <String CONTENT="Chukchee consume reindeer that die of the hoof-disease, fawns that perish"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l13" HPOS="370" VPOS="1338" WIDTH="1772" HEIGHT="47" BASELINE="370 1368 2142 1368" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1368 370 1385 2142 1385 2142 1368 2142 1338 370 1338 370 1368"/>
                        </Shape>
                        <String CONTENT="from starvation in an unfavorable spring, etc. Late in the spring and early"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l14" HPOS="370" VPOS="1383" WIDTH="1774" HEIGHT="63" BASELINE="373 1431 2144 1424" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1431 373 1446 2142 1439 2144 1424 2140 1394 1683 1383 1681 1383 1507 1396 370 1396 373 1431"/>
                        </Shape>
                        <String CONTENT="in summer, well-to-do families live almost exclusively on the meat of reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l15" HPOS="370" VPOS="1446" WIDTH="1772" HEIGHT="58" BASELINE="373 1489 2142 1485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1489 373 1504 2140 1500 2142 1485 2138 1455 396 1446 394 1446 392 1446 370 1455 373 1489"/>
                        </Shape>
                        <String CONTENT="that have died of disease, because there is always plenty of it, and it is con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l16" HPOS="373" VPOS="1502" WIDTH="1769" HEIGHT="63" BASELINE="375 1550 2142 1545" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1550 375 1565 2140 1561 2142 1545 2138 1515 2047 1502 2045 1502 2042 1502 2023 1513 2006 1502 2003 1502 2001 1502 1999 1502 1997 1502 1958 1513 1154 1504 1152 1504 1150 1504 1148 1504 1133 1515 403 1504 401 1504 399 1504 373 1515 375 1550"/>
                        </Shape>
                        <String CONTENT="sidered sinful to throw away any kind of food unless absolutely compelled to."/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l17" HPOS="373" VPOS="1563" WIDTH="1771" HEIGHT="63" BASELINE="375 1610 2144 1604" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1610 375 1626 2142 1619 2144 1604 2140 1576 1984 1563 1982 1563 1980 1563 1943 1574 1912 1563 1910 1563 1908 1563 1906 1563 1880 1576 373 1576 375 1610"/>
                        </Shape>
                        <String CONTENT="During this period, the poor people, who do not lose so many animals, live"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l18" HPOS="373" VPOS="1621" WIDTH="1771" HEIGHT="74" BASELINE="375 1671 2144 1662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1671 375 1684 581 1695 583 1695 728 1684 1254 1691 1256 1691 1360 1680 1412 1691 1414 1691 1416 1691 1453 1680 1590 1691 1592 1691 1594 1691 1620 1680 1692 1691 1694 1691 1696 1691 1698 1691 1713 1678 1741 1688 1744 1688 1746 1688 2142 1678 2144 1662 2140 1634 1928 1634 1902 1621 1899 1621 1897 1621 1895 1621 1893 1621 1878 1634 1698 1634 1369 1623 1367 1623 1365 1623 1362 1623 1347 1634 1258 1623 1256 1623 1254 1623 1200 1636 1163 1626 1161 1626 1159 1626 1157 1626 1122 1636 1014 1626 1012 1626 936 1636 843 1626 840 1626 749 1639 723 1628 721 1628 483 1628 481 1628 373 1641 375 1671"/>
                        </Shape>
                        <String CONTENT="on slaughtered reindeer. Animals killed by wolves are eaten, but not as"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l19" HPOS="370" VPOS="1682" WIDTH="1774" HEIGHT="63" BASELINE="373 1729 2144 1723" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1729 373 1745 2142 1740 2144 1723 2140 1695 1830 1682 1828 1682 1826 1682 1824 1682 1808 1693 1782 1682 1780 1682 1778 1682 1776 1682 1774 1682 1759 1695 1627 1695 1553 1682 1551 1682 1492 1695 1462 1684 1460 1684 1458 1684 1455 1684 1429 1695 879 1686 877 1686 875 1686 873 1686 860 1697 795 1686 793 1686 791 1686 754 1697 624 1686 622 1686 620 1686 617 1686 602 1699 505 1699 390 1686 388 1686 386 1686 383 1686 370 1695 373 1729"/>
                        </Shape>
                        <String CONTENT="freely as those that have died of disease, and children are forbidden to eat"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l20" HPOS="373" VPOS="1747" WIDTH="613" HEIGHT="56" BASELINE="375 1788 986 1784" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1788 375 1803 983 1801 986 1784 981 1755 414 1747 412 1747 409 1747 373 1758 375 1788"/>
                        </Shape>
                        <String CONTENT="of their hearts or marrow."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r4" HPOS="358" VPOS="1806" WIDTH="1778" HEIGHT="244" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="358 1806 2136 1806 2136 2050 358 2050"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l21" HPOS="481" VPOS="1814" WIDTH="1663" HEIGHT="54" BASELINE="481 1846 2144 1846" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="481 1846 481 1859 2142 1868 2144 1846 2144 1816 481 1814 481 1846"/>
                        </Shape>
                        <String CONTENT="In former times the meat of reindeer killed by wolves was tabooed,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l22" HPOS="373" VPOS="1875" WIDTH="1773" HEIGHT="49" BASELINE="373 1907 2146 1907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1907 373 1924 2146 1924 2146 1907 2135 1875 373 1875 373 1907"/>
                        </Shape>
                        <String CONTENT="because it was believed that a man who had eaten of such meat would become"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l23" HPOS="373" VPOS="1937" WIDTH="1771" HEIGHT="48" BASELINE="373 1968 2144 1968" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 1968 373 1985 2144 1985 2144 1968 2144 1937 373 1937 373 1968"/>
                        </Shape>
                        <String CONTENT="an easy mark for his foes; but at the present time this custom has lost much"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l24" HPOS="373" VPOS="1994" WIDTH="281" HEIGHT="56" BASELINE="375 2024 654 2028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2024 373 2041 386 2050 388 2050 390 2050 392 2050 652 2041 654 2028 652 1998 375 1994 375 2024"/>
                        </Shape>
                        <String CONTENT="of its force."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r5" HPOS="358" VPOS="2050" WIDTH="1778" HEIGHT="127" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="358 2050 2136 2050 2136 2177 358 2177"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l25" HPOS="483" VPOS="2048" WIDTH="1665" HEIGHT="54" BASELINE="485 2085 2148 2089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="485 2085 483 2098 2144 2102 2148 2089 2146 2056 485 2048 485 2085"/>
                        </Shape>
                        <String CONTENT="The Maritime Chukchee consume the carcasses of all sea-animals that"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l26" HPOS="370" VPOS="2106" WIDTH="1633" HEIGHT="59" BASELINE="373 2150 2003 2143" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2150 373 2165 2001 2158 2003 2143 1999 2115 916 2106 914 2106 912 2106 877 2117 485 2108 483 2108 370 2119 373 2150"/>
                        </Shape>
                        <String CONTENT="are drifted ashore by the currents, so long as they are not too putrid."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r6" HPOS="358" VPOS="2177" WIDTH="1778" HEIGHT="298" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="358 2177 2136 2177 2136 2475 358 2475"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l27" HPOS="481" VPOS="2167" WIDTH="1665" HEIGHT="60" BASELINE="483 2210 2146 2206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="483 2210 483 2227 2144 2227 2146 2206 2140 2173 505 2167 503 2167 500 2167 481 2175 483 2210"/>
                        </Shape>
                        <String CONTENT="Although it would be easy to construct storerooms in the frozen ground,"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l28" HPOS="373" VPOS="2221" WIDTH="1775" HEIGHT="65" BASELINE="375 2271 2148 2264" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2271 375 2286 2146 2279 2148 2264 2144 2232 1666 2221 1663 2221 1614 2232 1585 2221 1583 2221 1581 2221 1579 2221 1551 2234 1113 2223 1111 2223 925 2236 862 2225 860 2225 572 2236 479 2225 477 2225 425 2236 388 2225 386 2225 383 2225 381 2225 379 2225 379 2227 373 2232 375 2271"/>
                        </Shape>
                        <String CONTENT="in which meat could be preserved in good condition, the Chukchee are satisfied"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l29" HPOS="375" VPOS="2284" WIDTH="1773" HEIGHT="63" BASELINE="377 2331 2148 2323" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2331 377 2347 2146 2338 2148 2323 2144 2292 1263 2284 1261 2284 808 2297 418 2288 416 2288 414 2288 375 2299 377 2331"/>
                        </Shape>
                        <String CONTENT="with their ill-protected cellars, in which the provisions soon begin to become"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l30" HPOS="375" VPOS="2340" WIDTH="1771" HEIGHT="71" BASELINE="377 2392 2146 2385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2392 377 2411 2144 2401 2146 2385 2138 2355 2021 2355 1988 2340 1986 2340 1984 2340 1982 2340 1980 2340 1960 2355 1902 2355 1880 2340 1878 2340 1876 2340 1873 2340 1808 2353 1752 2340 1750 2340 1748 2340 1676 2353 1603 2340 1601 2340 1598 2340 1575 2353 1559 2340 1557 2340 1555 2340 1553 2340 1551 2340 1490 2355 1436 2342 1434 2342 1432 2342 1429 2342 1401 2355 1365 2342 1362 2342 1360 2342 1261 2355 1068 2342 1066 2342 1063 2342 1029 2355 983 2342 981 2342 979 2342 977 2342 975 2342 955 2357 916 2344 914 2344 912 2344 799 2357 589 2344 587 2344 585 2344 531 2357 477 2344 474 2344 472 2344 375 2360 377 2392"/>
                        </Shape>
                        <String CONTENT="putrid. Therefore both the Reindeer and the Maritime Chukchee live on"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l31" HPOS="377" VPOS="2403" WIDTH="1375" HEIGHT="67" BASELINE="379 2450 1752 2444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 2450 379 2470 1750 2457 1752 2444 1748 2414 1293 2403 1291 2403 1289 2403 1287 2403 1269 2414 446 2407 444 2407 377 2418 379 2450"/>
                        </Shape>
                        <String CONTENT="putrid meat throughout the summer and part of the winter."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-251_r7" HPOS="358" VPOS="2475" WIDTH="1778" HEIGHT="420" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="358 2475 2136 2475 2136 2895 358 2895"/>
                    </Shape>
                    <TextLine ID="mz_1-251_l32" HPOS="490" VPOS="2468" WIDTH="1658" HEIGHT="56" BASELINE="490 2507 2148 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="490 2507 490 2524 2148 2524 2148 2507 2148 2476 490 2468 490 2507"/>
                        </Shape>
                        <String CONTENT="When the Reindeer people drive their herds to the summer pastures, ten"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l33" HPOS="379" VPOS="2535" WIDTH="1769" HEIGHT="48" BASELINE="379 2565 2148 2565" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 2565 379 2583 2148 2583 2148 2565 2148 2535 379 2535 379 2565"/>
                        </Shape>
                        <String CONTENT="or fifteen animals are slaughtered for summer provisions. The meat is simply"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l34" HPOS="379" VPOS="2593" WIDTH="1769" HEIGHT="50" BASELINE="381 2628 2148 2624" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2628 381 2643 2146 2639 2148 2624 2144 2593 379 2593 381 2628"/>
                        </Shape>
                        <String CONTENT="hung in the tent, where it is easily accessible to carrion-flies and other insects."/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l35" HPOS="381" VPOS="2654" WIDTH="1770" HEIGHT="48" BASELINE="381 2684 2151 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2684 381 2702 2151 2702 2151 2684 2142 2654 381 2654 381 2684"/>
                        </Shape>
                        <String CONTENT="After several days it is placed in a pit dug in the centre of the tent, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l36" HPOS="377" VPOS="2704" WIDTH="1771" HEIGHT="63" BASELINE="379 2747 2148 2743" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 2747 379 2762 2144 2767 2148 2743 2144 2715 1323 2704 1321 2704 1200 2715 535 2706 533 2706 377 2717 379 2747"/>
                        </Shape>
                        <String CONTENT="covered with sod. Later on, when the pit is opened, the stench is so strong"/>
                    </TextLine>

                    <TextLine ID="mz_1-251_l37" HPOS="377" VPOS="2764" WIDTH="1774" HEIGHT="61" BASELINE="379 2805 2151 2801" TAGREFS="TYPE_4">
                        <Shape>
