                    <TextLine ID="mz_1-343_l9" HPOS="415" VPOS="1086" WIDTH="1776" HEIGHT="52" BASELINE="417 1123 2191 1119" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1123 417 1138 2189 1134 2191 1119 2187 1086 415 1086 417 1123"/>
                        </Shape>
