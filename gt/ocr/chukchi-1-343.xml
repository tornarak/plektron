                        <Shape>
                            <Polygon POINTS="417 1483 417 1498 2189 1498 2191 1478 2187 1448 467 1439 465 1439 415 1450 417 1483"/>
                        </Shape>
                        <String CONTENT="spirited contest for any long distance. The Russianized natives frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l16" HPOS="415" VPOS="1498" WIDTH="1776" HEIGHT="58" BASELINE="417 1541 2191 1537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1541 417 1556 2189 1552 2191 1537 2187 1509 1344 1498 1342 1498 1275 1509 656 1500 654 1500 415 1511 417 1541"/>
                        </Shape>
                        <String CONTENT="arrange private dog-races, with a bet to be paid to the victor. In these races"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l17" HPOS="417" VPOS="1571" WIDTH="1776" HEIGHT="48" BASELINE="417 1602 2193 1602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1602 417 1615 2191 1619 2193 1602 2193 1571 417 1571 417 1602"/>
                        </Shape>
                        <String CONTENT="the contestants are allowed to use any means, fair or unfair, even to cutting"/>
