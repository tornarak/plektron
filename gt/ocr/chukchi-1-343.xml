                    </TextLine>

                    <TextLine ID="mz_1-343_l8" HPOS="417" VPOS="1019" WIDTH="1772" HEIGHT="59" BASELINE="420 1063 2189 1058" TAGREFS="TYPE_5">
                        <Shape>
