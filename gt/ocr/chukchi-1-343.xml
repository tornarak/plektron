                    <TextLine ID="mz_1-343_l12" HPOS="417" VPOS="1266" WIDTH="1776" HEIGHT="52" BASELINE="417 1301 2193 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1301 417 1318 2193 1318 2193 1301 2193 1273 417 1266 417 1301"/>
                        </Shape>
                        <String CONTENT="boats; but both are of little consequence compared with the racing-contests"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l13" HPOS="415" VPOS="1322" WIDTH="1780" HEIGHT="61" BASELINE="417 1357 2195 1361" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1357 415 1374 428 1383 430 1383 433 1383 435 1383 2193 1374 2195 1361 2191 1322 417 1324 417 1357"/>
                        </Shape>
                        <String CONTENT="of reindeer-breeders. Chukchee dogs, as I have already mentioned, are of"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l14" HPOS="417" VPOS="1379" WIDTH="1774" HEIGHT="58" BASELINE="417 1422 2191 1422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1422 417 1437 2191 1437 2191 1422 2191 1392 2066 1379 2063 1379 2061 1379 2016 1392 1899 1392 1881 1379 1879 1379 1877 1379 1875 1379 1812 1389 1749 1379 1747 1379 1745 1379 1721 1392 1563 1392 1548 1379 1546 1379 1544 1379 1541 1379 1539 1379 1509 1389 1414 1379 1412 1379 1409 1379 1383 1392 1282 1392 1266 1379 1264 1379 1262 1379 1260 1379 1258 1379 1236 1389 1193 1379 1191 1379 1188 1379 1130 1389 1069 1379 1067 1379 1065 1379 1041 1389 970 1379 968 1379 417 1385 417 1422"/>
                        </Shape>
                        <String CONTENT="inferior quality. Paddling in skin boats is rather too irregular to allow a"/>
                    </TextLine>

