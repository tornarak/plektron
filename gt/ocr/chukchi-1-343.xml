                        </Shape>
                        <String CONTENT="snow loosened by the hoofs of the deer. The race is always for a long distance,"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l22" HPOS="420" VPOS="1870" WIDTH="1773" HEIGHT="48" BASELINE="420 1900 2193 1900" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="420 1900 420 1913 2191 1918 2193 1900 2193 1870 420 1870 420 1900"/>
                        </Shape>
