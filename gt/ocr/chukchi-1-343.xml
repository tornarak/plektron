                    <TextLine ID="mz_1-343_l26" HPOS="526" VPOS="2106" WIDTH="1669" HEIGHT="48" BASELINE="528 2139 2195 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="528 2139 528 2154 2193 2152 2195 2134 2191 2106 526 2106 528 2139"/>
                        </Shape>
                        <String CONTENT="The Chukchee are not so swift of foot as they are enduring, especially"/>
