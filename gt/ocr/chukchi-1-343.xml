                    </TextLine>

                    <TextLine ID="mz_1-343_l7" HPOS="413" VPOS="961" WIDTH="1778" HEIGHT="56" BASELINE="415 1004 2191 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1004 415 1017 2189 1015 2191 1000 2187 967 482 961 480 961 413 972 415 1004"/>
                        </Shape>
