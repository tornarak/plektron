                    </TextLine>

                    <TextLine ID="mz_1-343_l36" HPOS="420" VPOS="2695" WIDTH="1778" HEIGHT="67" BASELINE="422 2736 2198 2732" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="422 2736 422 2751 697 2762 699 2762 842 2751 946 2762 948 2762 950 2762 952 2762 968 2751 1214 2760 1217 2760 1531 2749 1619 2760 1622 2760 1624 2760 1648 2749 1782 2749 1949 2760 1951 2760 1953 2760 1998 2749 2059 2760 2061 2760 2063 2760 2066 2760 2081 2749 2165 2760 2167 2760 2169 2760 2198 2747 2198 2732 2193 2704 504 2695 502 2695 420 2706 422 2736"/>
                        </Shape>
                        <String CONTENT="a dog-sledge for forty miles. At the end the dogs were only half an hour"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l37" HPOS="422" VPOS="2753" WIDTH="335" HEIGHT="61" BASELINE="422 2797 757 2797" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="422 2797 422 2814 757 2814 757 2797 757 2766 621 2753 619 2753 617 2753 573 2764 552 2753 550 2753 547 2753 487 2764 463 2753 461 2753 459 2753 456 2753 422 2764 422 2797"/>
                        </Shape>
                        <String CONTENT="ahead of him."/>
                    </TextLine>
</TextBlock>
