                        </Shape>
                        <String CONTENT="A fair amount of swiftness combined with endurance, however, is peculiar"/>
                    </TextLine>

                    <TextLine ID="mz_1-343_l31" HPOS="417" VPOS="2392" WIDTH="1781" HEIGHT="63" BASELINE="420 2439 2198 2433" TAGREFS="TYPE_5">
