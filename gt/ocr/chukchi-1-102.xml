                        </Shape>
                        <String CONTENT="Fall fawn-skins (black), called by the traders “pyshiki” (пыжики), are also"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l4" HPOS="637" VPOS="760" WIDTH="1767" HEIGHT="60" BASELINE="637 803 2404 803" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 803 637 820 2402 820 2404 803 2402 773 2317 760 2315 760 2313 760 2289 770 1592 760 1590 760 1505 770 1475 760 1473 760 1471 760 1468 760 1440 773 1280 773 1215 760 1213 760 1211 760 1209 760 1193 773 1089 773 966 760 964 760 910 770 847 760 845 760 843 760 795 770 719 760 717 760 637 770 637 803"/>
                        </Shape>
                        <String CONTENT="traded. The full-grown skins are soft-curried before being sold to the traders."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l5" HPOS="635" VPOS="818" WIDTH="1767" HEIGHT="63" BASELINE="637 866 2402 861" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 866 637 881 2400 879 2402 861 2400 831 2365 818 2363 818 2361 818 2359 818 2313 829 2300 818 2298 818 2296 818 2294 818 2291 818 2244 831 1997 831 1977 818 1975 818 1973 818 1971 818 1917 829 1826 818 1824 818 1821 818 1793 829 1780 818 1778 818 1776 818 1774 818 1772 818 1728 829 1557 818 1555 818 1479 831 1378 820 1284 820 1282 820 1280 820 1278 820 1263 831 1183 820 1180 820 1178 820 1152 831 1079 820 1076 820 1074 820 1046 831 1016 820 1014 820 1012 820 931 831 858 820 856 820 635 827 637 866"/>
                        </Shape>
                        <String CONTENT="In bartering with American Eskimo, white spotted fawn-skins are most highly"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l6" HPOS="635" VPOS="889" WIDTH="1767" HEIGHT="52" BASELINE="637 922 2402 926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 922 635 935 2398 941 2402 926 2400 894 637 889 637 922"/>
                        </Shape>
                        <String CONTENT="valued. Pure white skins are highly prized everywhere. For making garments,"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l7" HPOS="635" VPOS="952" WIDTH="1769" HEIGHT="48" BASELINE="635 983 2404 983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 983 635 1000 2404 1000 2404 983 2404 952 635 952 635 983"/>
                        </Shape>
                        <String CONTENT="the Chukchee men lay equal value on white, black, and spotted skins; but"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l8" HPOS="633" VPOS="1009" WIDTH="725" HEIGHT="58" BASELINE="635 1039 1358 1043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 1039 633 1058 648 1067 650 1067 652 1067 654 1067 1356 1058 1358 1043 1356 1013 635 1009 635 1039"/>
                        </Shape>
                        <String CONTENT="the women prefer spotted ones."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-102_r3" HPOS="625" VPOS="1066" WIDTH="1778" HEIGHT="179" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="625 1066 2403 1066 2403 1245 625 1245"/>
                    </Shape>
                    <TextLine ID="mz_1-102_l9" HPOS="741" VPOS="1061" WIDTH="1663" HEIGHT="58" BASELINE="741 1102 2404 1102" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1102 741 1119 2404 1119 2404 1102 2404 1071 2367 1061 2365 1061 2363 1061 2361 1061 2335 1073 2161 1073 2146 1061 2144 1061 2142 1061 2140 1061 2029 1073 1828 1073 1804 1061 1802 1061 1800 1061 1692 1071 1549 1061 1546 1061 1475 1071 1414 1061 1412 1061 1313 1071 1222 1061 1219 1061 1111 1071 1035 1061 1033 1061 1031 1061 1001 1071 884 1061 882 1061 741 1067 741 1102"/>
                        </Shape>
                        <String CONTENT="In winter the reindeer feed solely on reindeer-moss, which grows in"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l10" HPOS="633" VPOS="1132" WIDTH="1769" HEIGHT="48" BASELINE="633 1160 2402 1160" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1160 633 1180 2402 1180 2402 1160 2402 1132 633 1132 633 1160"/>
                        </Shape>
                        <String CONTENT="abundance everywhere on the flat tundra and on the hills. There are some"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l11" HPOS="633" VPOS="1190" WIDTH="786" HEIGHT="50" BASELINE="635 1223 1419 1219" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 1223 635 1240 1416 1236 1419 1219 1412 1190 633 1193 635 1223"/>
                        </Shape>
                        <String CONTENT="seven species of reindeer-moss: —"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-102_r4" HPOS="625" VPOS="1256" WIDTH="1778" HEIGHT="629" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="625 1256 2403 1256 2403 1885 625 1885"/>
                    </Shape>
                    <TextLine ID="mz_1-102_l12" HPOS="637" VPOS="1266" WIDTH="1767" HEIGHT="48" BASELINE="637 1296 2404 1296" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 1296 637 1314 2402 1314 2404 1296 2402 1266 637 1266 637 1296"/>
                        </Shape>
                        <String CONTENT="1. Lêˊê-wattaˊp (“genuine moss,” Cetraria Islandica), otherwise called êˊlhu-wattaˊp (“white moss”)"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l13" HPOS="732" VPOS="1312" WIDTH="552" HEIGHT="47" BASELINE="732 1340 1284 1340" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 1340 732 1357 1282 1359 1284 1340 1284 1312 732 1312 732 1340"/>
                        </Shape>
                        <String CONTENT="or koˊo-wattaˊp (“large moss”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l14" HPOS="637" VPOS="1359" WIDTH="1767" HEIGHT="48" BASELINE="637 1390 2404 1390" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="637 1390 637 1407 2402 1407 2404 1390 2402 1359 637 1359 637 1390"/>
                        </Shape>
                        <String CONTENT="2. Qai-wattaˊpqai (“small moss”) or êˊmu-wattaˊp (“fine moss”), small moss with thin tender fibres."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l15" HPOS="739" VPOS="1400" WIDTH="1663" HEIGHT="55" BASELINE="739 1435 2402 1435" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1435 739 1455 2402 1455 2402 1435 2402 1407 739 1400 739 1435"/>
                        </Shape>
                        <String CONTENT="There are two varieties of different color: (a) kɪˊmčir, black; and (b) loˊᵋqai, light green, like"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l16" HPOS="730" VPOS="1448" WIDTH="444" HEIGHT="48" BASELINE="732 1478 1174 1483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 1478 730 1491 1170 1496 1174 1483 1172 1452 732 1448 732 1478"/>
                        </Shape>
                        <String CONTENT="the ordinary large moss."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l17" HPOS="637" VPOS="1496" WIDTH="1765" HEIGHT="52" BASELINE="639 1530 2402 1524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="639 1530 639 1548 2400 1539 2402 1524 2395 1496 637 1500 639 1530"/>
                        </Shape>
                        <String CONTENT="3. Kaimaˊ-wattaˊp (“bald moss,” Stenocaulon paschale), otherwise called aᵋm-tal-wattaˊp (“ground-"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l18" HPOS="732" VPOS="1545" WIDTH="1310" HEIGHT="46" BASELINE="732 1574 2042 1574" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 1574 732 1591 2042 1591 2042 1574 2042 1545 732 1545 732 1574"/>
                        </Shape>
                        <String CONTENT="bones moss”). It is light green in color, with small round rolls of fibres."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l19" HPOS="637" VPOS="1580" WIDTH="1607" HEIGHT="59" BASELINE="639 1623 2244 1619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="639 1623 639 1639 2242 1634 2244 1619 2239 1591 1468 1580 1466 1580 1464 1580 1423 1591 700 1582 697 1582 637 1593 639 1623"/>
                        </Shape>
                        <String CONTENT="4. Koihuˊ-wattaˊp (“glacier moss”), like the ordinary large moss, but dark brown in color."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l20" HPOS="637" VPOS="1636" WIDTH="1767" HEIGHT="55" BASELINE="639 1671 2404 1665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="639 1671 639 1691 2402 1682 2404 1665 2398 1636 637 1641 639 1671"/>
                        </Shape>
                        <String CONTENT="5. Mɪˊrg̣ɪčhɪn, also of two colors: (a) uwaˊla-mɪˊrg̣ɪčhɪn, black, similar to very rough horse-hair tangled"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l21" HPOS="732" VPOS="1686" WIDTH="1261" HEIGHT="46" BASELINE="732 1714 1993 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 1714 732 1732 1993 1732 1993 1714 1993 1686 732 1686 732 1714"/>
                        </Shape>
                        <String CONTENT="together; and (b) êᵋw-mɪˊrg̣ɪčhɪn (“wolf’s moss”), similar to wolf’s hair."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l22" HPOS="633" VPOS="1732" WIDTH="1769" HEIGHT="47" BASELINE="633 1760 2402 1760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1760 633 1779 2402 1779 2402 1760 2402 1732 633 1732 633 1760"/>
                        </Shape>
                        <String CONTENT="6. Kaˊkwêl-wattaˊp (“ear-like moss,” Cetraria arctica), in large flaps, and light green in color."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l23" HPOS="732" VPOS="1779" WIDTH="591" HEIGHT="46" BASELINE="732 1807 1323 1807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="732 1807 732 1825 1323 1825 1323 1807 1323 1779 732 1779 732 1807"/>
                        </Shape>
                        <String CONTENT="Sprouts chiefly on burnt ground."/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l24" HPOS="633" VPOS="1823" WIDTH="1682" HEIGHT="52" BASELINE="635 1857 2315 1851" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 1857 635 1875 2313 1868 2315 1851 2309 1823 633 1827 635 1857"/>
                        </Shape>
                        <String CONTENT="7. Aioˊpɪču-wattaˊp (“pricking moss”), of two different colors, — light green and dark brown."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-102_r5" HPOS="625" VPOS="1898" WIDTH="1778" HEIGHT="246" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="625 1898 2403 1898 2403 2144 625 2144"/>
                    </Shape>
                    <TextLine ID="mz_1-102_l25" HPOS="732" VPOS="1898" WIDTH="1666" HEIGHT="65" BASELINE="734 1939 2398 1944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="734 1939 732 1950 762 1963 765 1963 767 1963 2395 1961 2398 1944 2395 1914 2008 1901 2006 1901 2003 1901 2001 1901 1986 1914 1601 1914 1566 1898 1564 1898 1562 1898 1559 1898 1523 1909 1481 1898 1479 1898 1477 1898 1475 1898 1442 1909 1336 1898 1334 1898 1271 1909 1204 1898 1202 1898 1115 1909 955 1898 953 1898 951 1898 918 1909 890 1898 888 1898 886 1898 734 1907 734 1939"/>
                        </Shape>
                        <String CONTENT="Of all these varieties, No. 1 is the most common; No. 3 is scarce,"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l26" HPOS="628" VPOS="1968" WIDTH="1772" HEIGHT="52" BASELINE="630 2002 2400 1998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2002 630 2020 2398 2015 2400 1998 2393 1968 628 1970 630 2002"/>
                        </Shape>
                        <String CONTENT="especially on the tundra; No. 4 is very good fodder, but grows only in cer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l27" HPOS="628" VPOS="2017" WIDTH="1772" HEIGHT="63" BASELINE="630 2063 2400 2059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2063 630 2080 2398 2076 2400 2059 2395 2030 2092 2017 2090 2017 2088 2017 2086 2017 2071 2028 2047 2017 2045 2017 2042 2017 2040 2017 2038 2017 2023 2028 2008 2017 2006 2017 2003 2017 2001 2017 1999 2017 1997 2017 1982 2030 1759 2030 1733 2017 1731 2017 1728 2017 1650 2028 1633 2017 1631 2017 1629 2017 1627 2017 1551 2028 1516 2017 1514 2017 1512 2017 1510 2017 1468 2030 1397 2020 1395 2020 990 2030 923 2020 921 2020 918 2020 875 2030 765 2020 762 2020 760 2020 721 2030 680 2020 678 2020 676 2020 674 2020 628 2033 630 2063"/>
                        </Shape>
                        <String CONTENT="tain places; No. 5 is poorer fodder; Nos. 6 and 7 are good fodder, but they"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l28" HPOS="630" VPOS="2093" WIDTH="997" HEIGHT="48" BASELINE="630 2124 1627 2124" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2124 630 2141 1627 2137 1627 2124 1627 2093 630 2093 630 2124"/>
                        </Shape>
                        <String CONTENT="grow only on burnt places, and are scarce."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-102_r6" HPOS="625" VPOS="2144" WIDTH="1778" HEIGHT="1076" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="625 2144 2403 2144 2403 3220 625 3220"/>
                    </Shape>
                    <TextLine ID="mz_1-102_l29" HPOS="739" VPOS="2143" WIDTH="1663" HEIGHT="65" BASELINE="741 2178 2402 2182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 2178 739 2193 938 2206 940 2206 1492 2197 1605 2208 1607 2208 2400 2197 2402 2182 2400 2152 741 2143 741 2178"/>
                        </Shape>
                        <String CONTENT="With the first green sprouts that shoot up through the snow, the reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l30" HPOS="626" VPOS="2208" WIDTH="1774" HEIGHT="50" BASELINE="628 2238 2400 2243" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2238 626 2253 2395 2258 2400 2243 2398 2212 628 2208 628 2238"/>
                        </Shape>
                        <String CONTENT="cease to care for the moss, and scatter over considerable distances in search"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l31" HPOS="626" VPOS="2269" WIDTH="1776" HEIGHT="49" BASELINE="628 2299 2402 2303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2299 626 2314 2398 2318 2402 2303 2400 2273 628 2269 628 2299"/>
                        </Shape>
                        <String CONTENT="of new kinds of food. In summer they feed on sprouts growing on the tundra,"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l32" HPOS="628" VPOS="2327" WIDTH="1774" HEIGHT="61" BASELINE="630 2357 2402 2362" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2357 628 2372 736 2385 739 2385 1293 2377 1523 2388 1525 2388 2400 2377 2402 2362 2400 2331 630 2327 630 2357"/>
                        </Shape>
                        <String CONTENT="chiefly on various species of reed-grass; also on young leaves of low willow-"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l33" HPOS="626" VPOS="2383" WIDTH="1774" HEIGHT="54" BASELINE="628 2416 2400 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2416 626 2431 2395 2437 2400 2422 2398 2394 628 2383 628 2416"/>
                        </Shape>
                        <String CONTENT="bushes, shore-grass, and the like, with the exception, however, of common"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l34" HPOS="628" VPOS="2437" WIDTH="1772" HEIGHT="65" BASELINE="630 2483 2400 2479" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2483 630 2502 2398 2494 2400 2479 2395 2448 1555 2437 1553 2437 628 2450 630 2483"/>
                        </Shape>
                        <String CONTENT="grass, — “horse-fodder” (koˊnên-vaˊᵋg̣lɪñɪn) as the Chukchee call it. Even late"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l35" HPOS="624" VPOS="2505" WIDTH="1776" HEIGHT="52" BASELINE="626 2537 2400 2541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2537 624 2552 2395 2557 2400 2541 2398 2511 626 2505 626 2537"/>
                        </Shape>
                        <String CONTENT="in the fall, reindeer require some reed-grass and withered leaves mixed with"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l36" HPOS="626" VPOS="2567" WIDTH="1774" HEIGHT="59" BASELINE="628 2598 2400 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="628 2598 626 2611 689 2624 691 2624 1479 2615 1536 2626 1538 2626 2398 2615 2400 2602 2398 2572 628 2567 628 2598"/>
                        </Shape>
                        <String CONTENT="moss, and without it they will not fatten. On the other hand, toward the"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l37" HPOS="624" VPOS="2626" WIDTH="1776" HEIGHT="60" BASELINE="626 2656 2400 2660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2656 624 2671 669 2684 672 2684 674 2684 1429 2676 1527 2686 1529 2686 2398 2676 2400 2660 2398 2630 626 2626 626 2656"/>
                        </Shape>
                        <String CONTENT="end of summer they require moss mixed with the grass, and without it they"/>
                    </TextLine>

                    <TextLine ID="mz_1-102_l38" HPOS="628" VPOS="2680" WIDTH="1772" HEIGHT="58" BASELINE="628 2721 2400 2721" TAGREFS="TYPE_5">
                        <Shape>
