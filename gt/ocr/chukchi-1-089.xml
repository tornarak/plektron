                    <TextLine ID="mz_1-089_l1" HPOS="933" VPOS="623" WIDTH="617" HEIGHT="56" BASELINE="935 655 1550 660" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1238 623 1217 623 1195 623 1173 623 1152 623 1130 623 1108 623 1087 623 1065 623 1043 623 1022 623 1000 623 978 623 957 623 935 623 935 655 933 675 1546 679 1550 660 1548 625 1240 623 1238 623"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l2" HPOS="2059" VPOS="623" WIDTH="50" HEIGHT="69" BASELINE="2061 666 2109 671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2061 666 2059 679 2102 692 2109 671 2109 627 2061 623 2061 666"/>
                        </Shape>
                        <String CONTENT="63"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r2" HPOS="351" VPOS="727" WIDTH="1778" HEIGHT="783" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="351 727 2129 727 2129 1510 351 1510"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l3" HPOS="350" VPOS="738" WIDTH="1774" HEIGHT="50" BASELINE="353 772 2124 768" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 772 353 788 2122 783 2124 768 2120 738 350 738 353 772"/>
                        </Shape>
                        <String CONTENT="be found trespassing in Russian waters or carrying on unlawful trade on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l4" HPOS="350" VPOS="788" WIDTH="1774" HEIGHT="58" BASELINE="353 831 2124 827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 831 353 846 2122 842 2124 827 2120 798 1238 788 1236 788 1234 788 1195 798 378 790 376 790 374 790 350 798 353 831"/>
                        </Shape>
                        <String CONTENT="shores. I cannot tell whether the “Kreisser” seized any American ships or"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l5" HPOS="353" VPOS="846" WIDTH="1771" HEIGHT="63" BASELINE="355 894 2124 887" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 894 355 909 2122 902 2124 887 2122 859 2072 846 2070 846 2068 846 2066 846 2040 857 1946 846 1944 846 1890 857 1866 846 1864 846 1862 846 1860 846 1858 846 1840 857 1816 846 1814 846 1812 846 1676 857 1554 846 1552 846 1550 846 1548 846 1526 859 1065 848 1063 848 1061 848 1030 859 944 848 942 848 939 848 937 848 918 861 905 850 903 850 900 850 898 850 641 861 623 850 621 850 619 850 489 850 487 850 485 850 443 861 426 850 424 850 422 850 420 850 353 863 355 894"/>
                        </Shape>
                        <String CONTENT="not, though several of them have been taken at different periods; but she"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l6" HPOS="355" VPOS="920" WIDTH="1769" HEIGHT="47" BASELINE="355 950 2124 950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 950 355 967 2124 967 2124 950 2124 920 355 920 355 950"/>
                        </Shape>
                        <String CONTENT="met the schooner “Henrietta,” just bought by Kuvaˊr, and carried her off as"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l7" HPOS="350" VPOS="967" WIDTH="1772" HEIGHT="61" BASELINE="353 1011 2122 1006" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1011 353 1028 2120 1024 2122 1006 2118 978 1236 967 1234 967 1232 967 1230 967 1212 978 459 969 456 969 350 980 353 1011"/>
                        </Shape>
                        <String CONTENT="a prize, in spite of all remonstrance. The schooner was afterwards fitted with"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l8" HPOS="353" VPOS="1028" WIDTH="1771" HEIGHT="67" BASELINE="355 1073 2124 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1073 355 1084 939 1095 942 1095 944 1095 946 1095 961 1084 2105 1091 2107 1091 2109 1091 2111 1091 2124 1080 2124 1067 2120 1037 944 1028 942 1028 939 1028 892 1039 452 1030 450 1030 353 1041 355 1073"/>
                        </Shape>
                        <String CONTENT="a steam-engine and used for keeping watch on the Sea of Okhotsk, where"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l9" HPOS="350" VPOS="1084" WIDTH="1772" HEIGHT="65" BASELINE="353 1134 2122 1125" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1134 353 1149 2120 1140 2122 1125 2118 1095 1680 1084 1678 1084 1676 1084 1674 1084 1654 1095 378 1091 376 1091 374 1091 350 1099 353 1134"/>
                        </Shape>
                        <String CONTENT="she was lost in a storm in 1895. Kuvaˊr applied several times to the authori-"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l10" HPOS="353" VPOS="1149" WIDTH="1769" HEIGHT="59" BASELINE="355 1192 2122 1186" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1192 355 1208 2120 1203 2122 1186 2118 1153 374 1149 372 1149 370 1149 368 1149 353 1156 355 1192"/>
                        </Shape>
                        <String CONTENT="ties for redress, but without avail. The officials in Vladivostok maintained"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l11" HPOS="355" VPOS="1208" WIDTH="1767" HEIGHT="60" BASELINE="357 1253 2122 1247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 1253 357 1268 2120 1262 2122 1247 2118 1216 955 1208 952 1208 950 1208 922 1218 374 1210 372 1210 370 1210 368 1210 355 1216 357 1253"/>
                        </Shape>
                        <String CONTENT="that the schooner was not yet paid for; but I was told at Indian Point that"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l12" HPOS="355" VPOS="1277" WIDTH="1765" HEIGHT="54" BASELINE="357 1314 2120 1307" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 1314 357 1329 2115 1331 2120 1307 2115 1277 355 1277 357 1314"/>
                        </Shape>
                        <String CONTENT="Kuvaˊr gave for it the whalebone of two whales, a large pile of walrus-tusks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l13" HPOS="353" VPOS="1327" WIDTH="1769" HEIGHT="62" BASELINE="355 1374 2122 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1374 355 1387 2118 1389 2122 1370 2118 1340 1600 1327 1598 1327 1537 1337 1466 1327 1463 1327 1461 1327 1431 1337 1396 1327 1394 1327 1392 1327 1316 1337 1238 1327 1236 1327 1234 1327 1204 1340 1186 1329 1184 1329 1182 1329 1180 1329 937 1340 877 1329 874 1329 872 1329 870 1329 853 1340 706 1329 703 1329 701 1329 654 1340 582 1329 580 1329 578 1329 547 1340 495 1329 493 1329 491 1329 446 1340 374 1329 372 1329 370 1329 368 1329 353 1337 355 1374"/>
                        </Shape>
                        <String CONTENT="three bagfuls of white-fox skins, and three polar-bear skins. During my stay,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l14" HPOS="350" VPOS="1387" WIDTH="1772" HEIGHT="61" BASELINE="353 1433 2122 1426" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1433 353 1448 2120 1441 2122 1426 2118 1398 1552 1387 1550 1387 1468 1398 443 1392 441 1392 350 1402 353 1433"/>
                        </Shape>
                        <String CONTENT="another occasion to buy a schooner presented itself, and I was asked for"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l15" HPOS="350" VPOS="1446" WIDTH="1731" HEIGHT="60" BASELINE="353 1487 2081 1491" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1487 350 1502 2076 1506 2081 1491 2079 1461 2007 1448 2005 1448 1814 1459 1799 1448 1797 1448 1795 1448 1648 1448 1645 1448 1643 1448 1596 1459 1524 1448 1522 1448 1461 1459 1424 1448 1422 1448 1420 1448 1362 1459 1327 1448 1325 1448 1323 1448 1238 1459 1219 1446 1217 1446 1214 1446 1212 1446 1145 1457 1017 1446 1015 1446 1013 1446 972 1457 905 1446 903 1446 809 1459 697 1459 682 1446 680 1446 677 1446 675 1446 673 1446 649 1459 474 1459 454 1446 452 1446 450 1446 448 1446 353 1454 353 1487"/>
                        </Shape>
                        <String CONTENT="advice as to the possibility of a second confiscation, but withheld my opinion."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r3" HPOS="351" VPOS="1510" WIDTH="1778" HEIGHT="665" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="351 1510 2129 1510 2129 2175 351 2175"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l16" HPOS="461" VPOS="1511" WIDTH="1663" HEIGHT="56" BASELINE="463 1552 2124 1547" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="463 1552 463 1567 2122 1563 2124 1547 2120 1519 482 1511 480 1511 478 1511 476 1511 461 1517 463 1552"/>
                        </Shape>
                        <String CONTENT="American wares generally are twice as cheap as those brought from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l17" HPOS="353" VPOS="1578" WIDTH="1773" HEIGHT="47" BASELINE="353 1610 2126 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1610 353 1625 2126 1625 2126 1610 2126 1580 353 1578 353 1610"/>
                        </Shape>
                        <String CONTENT="interior of Siberia. Even those brought from Vladivostok by sea cannot"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l18" HPOS="350" VPOS="1628" WIDTH="1776" HEIGHT="58" BASELINE="353 1671 2126 1667" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1671 353 1686 2126 1682 2126 1667 2122 1638 1238 1628 1236 1628 1147 1638 595 1630 593 1630 350 1641 353 1671"/>
                        </Shape>
                        <String CONTENT="compete with them, because most of them are of American origin, and have"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l19" HPOS="353" VPOS="1699" WIDTH="1771" HEIGHT="50" BASELINE="355 1732 2124 1727" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1732 355 1749 2122 1744 2124 1727 2118 1699 353 1701 355 1732"/>
                        </Shape>
                        <String CONTENT="come by a more circuitous route. American granulated sugar forms an exception."/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l20" HPOS="353" VPOS="1744" WIDTH="1769" HEIGHT="63" BASELINE="355 1792 2122 1786" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 1792 355 1807 2120 1801 2122 1786 2118 1755 1533 1744 1531 1744 1528 1744 1526 1744 1507 1755 970 1747 968 1747 353 1757 355 1792"/>
                        </Shape>
                        <String CONTENT="It is inferior to the well-refined, hard lump-sugar of the Russians. American"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l21" HPOS="350" VPOS="1807" WIDTH="1774" HEIGHT="61" BASELINE="353 1853 2124 1844" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1853 353 1868 2122 1859 2124 1844 2120 1816 1238 1807 1236 1807 1149 1818 413 1812 411 1812 350 1822 353 1853"/>
                        </Shape>
                        <String CONTENT="cutlery is not always so well adapted to the uses of the natives as are the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l22" HPOS="350" VPOS="1864" WIDTH="1774" HEIGHT="69" BASELINE="353 1913 2124 1905" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1913 353 1929 1678 1933 1680 1933 2122 1920 2124 1905 2120 1874 1708 1864 1706 1864 1704 1864 1676 1874 456 1870 454 1870 350 1881 353 1913"/>
                        </Shape>
                        <String CONTENT="rough strong knives made for this purpose in Yakutsk, Sredne-Kolymsk, Mar-"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l23" HPOS="350" VPOS="1926" WIDTH="1774" HEIGHT="61" BASELINE="353 1972 2124 1965" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 1972 353 1987 2122 1980 2124 1965 2120 1937 1537 1926 1535 1926 1533 1926 1531 1926 1518 1939 350 1939 353 1972"/>
                        </Shape>
                        <String CONTENT="kova, etc. Moreover, the whalers do not trade in brick-tea, because they do"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l24" HPOS="353" VPOS="1985" WIDTH="1771" HEIGHT="63" BASELINE="355 2032 2124 2026" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2032 355 2048 2122 2041 2124 2026 2122 1998 2072 1985 2070 1985 2068 1985 1970 1996 1949 1985 1946 1985 1944 1985 1873 1996 1851 1985 1849 1985 1847 1985 1784 1996 1758 1985 1756 1985 1754 1985 1752 1985 1749 1985 1732 1998 1563 1998 1535 1985 1533 1985 1531 1985 1528 1985 1489 1998 1015 1987 1013 1987 926 2000 680 1989 677 1989 675 1989 673 1989 656 2002 552 2002 478 1989 476 1989 353 2002 355 2032"/>
                        </Shape>
                        <String CONTENT="not visit any Chinese or southern Siberian ports. Once or twice they brought"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l25" HPOS="353" VPOS="2045" WIDTH="1769" HEIGHT="65" BASELINE="355 2093 2122 2087" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2093 355 2110 2120 2104 2122 2087 2118 2056 1626 2045 1624 2045 1476 2058 353 2058 355 2093"/>
                        </Shape>
                        <String CONTENT="brick-tea from Japan; but Japanese brick-tea is of much poorer quality than"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l26" HPOS="350" VPOS="2117" WIDTH="997" HEIGHT="56" BASELINE="353 2147 1347 2152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2147 350 2162 372 2173 374 2173 376 2173 1344 2165 1347 2152 1344 2121 353 2117 353 2147"/>
                        </Shape>
                        <String CONTENT="Chinese, and the cakes are smaller in size."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r4" HPOS="351" VPOS="2175" WIDTH="1778" HEIGHT="778" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="351 2175 2129 2175 2129 2953 351 2953"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l27" HPOS="461" VPOS="2180" WIDTH="1663" HEIGHT="47" BASELINE="461 2210 2124 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="461 2210 461 2227 2124 2227 2124 2210 2124 2180 461 2180 461 2210"/>
                        </Shape>
                        <String CONTENT="After the native stock of whalebone became exhausted, the whalers began"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l28" HPOS="350" VPOS="2229" WIDTH="1774" HEIGHT="59" BASELINE="353 2271 2124 2266" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2271 353 2288 2122 2284 2124 2266 2120 2234 589 2229 586 2229 350 2240 353 2271"/>
                        </Shape>
                        <String CONTENT="to accept instead walrus ivory and the skins of white foxes and of black and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l29" HPOS="350" VPOS="2290" WIDTH="1774" HEIGHT="65" BASELINE="353 2331 2124 2327" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2331 353 2355 2122 2342 2124 2327 2120 2294 411 2290 409 2290 350 2301 353 2331"/>
                        </Shape>
                        <String CONTENT="polar bears. Other Asiatic peltries, such as those of red and cross foxes and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l30" HPOS="353" VPOS="2357" WIDTH="1769" HEIGHT="50" BASELINE="355 2390 2122 2385" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2390 355 2407 2120 2403 2122 2385 2115 2357 353 2359 355 2390"/>
                        </Shape>
                        <String CONTENT="of wolves, also skins from America, like the beaver and marten, are taken to"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l31" HPOS="353" VPOS="2409" WIDTH="1771" HEIGHT="59" BASELINE="355 2452 2124 2448" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2452 355 2468 2122 2463 2124 2448 2120 2416 374 2409 372 2409 370 2409 368 2409 353 2416 355 2452"/>
                        </Shape>
                        <String CONTENT="the Russian fairs because they fetch a much better price in Asia than would"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l32" HPOS="353" VPOS="2465" WIDTH="1775" HEIGHT="61" BASELINE="355 2511 2128 2507" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2511 355 2526 2126 2522 2128 2507 2120 2465 2076 2476 1563 2465 1561 2465 1496 2476 1468 2465 1466 2465 1463 2465 1399 2476 1347 2465 1344 2465 1219 2478 1087 2468 1084 2468 1082 2468 1050 2478 1007 2468 1004 2468 1002 2468 1000 2468 974 2478 851 2468 848 2468 353 2476 355 2511"/>
                        </Shape>
                        <String CONTENT="be paid by the whalers. At the present time the chief source of income of"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l33" HPOS="350" VPOS="2526" WIDTH="1776" HEIGHT="61" BASELINE="353 2572 2126 2567" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2572 353 2587 2124 2582 2126 2567 2122 2539 2044 2526 2042 2526 2040 2526 2009 2537 1747 2526 1745 2526 1689 2537 1654 2526 1652 2526 1650 2526 1648 2526 1600 2537 1472 2526 1470 2526 1364 2537 1334 2526 1331 2526 1329 2526 1234 2539 881 2528 879 2528 805 2539 751 2528 749 2528 747 2528 744 2528 729 2541 615 2541 526 2528 524 2528 433 2539 376 2528 374 2528 372 2528 370 2528 350 2537 353 2572"/>
                        </Shape>
                        <String CONTENT="the natives are fawn-skins, which are much needed by the American natives"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l34" HPOS="350" VPOS="2585" WIDTH="1772" HEIGHT="62" BASELINE="353 2632 2122 2626" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2632 353 2647 2120 2643 2122 2626 2118 2598 1868 2585 1866 2585 1786 2595 1721 2585 1719 2585 1717 2585 1671 2595 1615 2585 1613 2585 1611 2585 1587 2598 1273 2598 1208 2587 1206 2587 1117 2598 1056 2587 1054 2587 1052 2587 1050 2587 1035 2598 677 2589 675 2589 673 2589 630 2600 571 2589 569 2589 567 2589 532 2600 424 2589 422 2589 350 2602 353 2632"/>
                        </Shape>
                        <String CONTENT="and by the Alaskan miners for making garments; also skins of full-grown"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l35" HPOS="353" VPOS="2660" WIDTH="1767" HEIGHT="50" BASELINE="353 2691 2120 2691" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="353 2691 353 2706 2115 2710 2120 2691 2118 2660 353 2660 353 2691"/>
                        </Shape>
                        <String CONTENT="reindeer for sleeping-bags, ready-made garments even of poor quality, and,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l36" HPOS="355" VPOS="2706" WIDTH="1769" HEIGHT="58" BASELINE="357 2751 2124 2747" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2751 357 2764 2122 2760 2124 2747 2120 2717 1240 2706 1238 2706 1132 2717 530 2708 528 2708 355 2719 357 2751"/>
                        </Shape>
                        <String CONTENT="most of all, various kinds of seal-skin boots, which are used both by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l37" HPOS="355" VPOS="2766" WIDTH="1769" HEIGHT="61" BASELINE="357 2812 2124 2808" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2812 357 2827 2122 2823 2124 2808 2120 2777 1264 2766 1262 2766 1199 2777 391 2769 389 2769 387 2769 355 2779 357 2812"/>
                        </Shape>
                        <String CONTENT="whaling-crews and by the miners. Asiatic and American natives sell these"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l38" HPOS="355" VPOS="2833" WIDTH="1767" HEIGHT="55" BASELINE="357 2872 2122 2866" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="357 2872 357 2888 2120 2883 2122 2866 2115 2833 355 2833 357 2872"/>
                        </Shape>
                        <String CONTENT="boots by the thousand every summer; but the demand keeps increasing, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l39" HPOS="353" VPOS="2894" WIDTH="1470" HEIGHT="56" BASELINE="355 2924 1823 2931" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="355 2924 353 2944 357 2948 359 2948 359 2950 361 2950 363 2950 365 2950 1821 2944 1823 2931 1821 2901 355 2894 355 2924"/>
                        </Shape>
                        <String CONTENT="in 1901 the price at Indian Point was a sack of flour per pair."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r5" HPOS="351" VPOS="2953" WIDTH="1778" HEIGHT="298" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="351 2953 2129 2953 2129 3251 351 3251"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l40" HPOS="461" VPOS="2944" WIDTH="1663" HEIGHT="61" BASELINE="463 2985 2124 2989" TAGREFS="TYPE_4">
