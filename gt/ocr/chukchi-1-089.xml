                    <TextLine ID="mz_1-089_l1" HPOS="912" VPOS="608" WIDTH="617" HEIGHT="56" BASELINE="914 640 1529 645" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1217 608 1196 608 1174 608 1152 608 1131 608 1109 608 1087 608 1066 608 1044 608 1022 608 1001 608 979 608 957 608 936 608 914 608 914 640 912 660 1525 664 1529 645 1527 610 1219 608 1217 608"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l2" HPOS="2038" VPOS="608" WIDTH="50" HEIGHT="69" BASELINE="2040 651 2088 656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2040 651 2038 664 2081 677 2088 656 2088 612 2040 608 2040 651"/>
                        </Shape>
                        <String CONTENT="63"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r2" HPOS="330" VPOS="712" WIDTH="1778" HEIGHT="783" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="330 712 2108 712 2108 1495 330 1495"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l3" HPOS="329" VPOS="723" WIDTH="1774" HEIGHT="50" BASELINE="332 757 2103 753" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 757 332 773 2101 768 2103 753 2099 723 329 723 332 757"/>
                        </Shape>
                        <String CONTENT="be found trespassing in Russian waters or carrying on unlawful trade on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l4" HPOS="329" VPOS="773" WIDTH="1774" HEIGHT="58" BASELINE="332 816 2103 812" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 816 332 831 2101 827 2103 812 2099 783 1217 773 1215 773 1213 773 1174 783 357 775 355 775 353 775 329 783 332 816"/>
                        </Shape>
                        <String CONTENT="shores. I cannot tell whether the “Kreisser” seized any American ships or"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l5" HPOS="332" VPOS="831" WIDTH="1771" HEIGHT="63" BASELINE="334 879 2103 872" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 879 334 894 2101 887 2103 872 2101 844 2051 831 2049 831 2047 831 2045 831 2019 842 1925 831 1923 831 1869 842 1845 831 1843 831 1841 831 1839 831 1837 831 1819 842 1795 831 1793 831 1791 831 1655 842 1533 831 1531 831 1529 831 1527 831 1505 844 1044 833 1042 833 1040 833 1009 844 923 833 921 833 918 833 916 833 897 846 884 835 882 835 879 835 877 835 620 846 602 835 600 835 598 835 468 835 466 835 464 835 422 846 405 835 403 835 401 835 399 835 332 848 334 879"/>
                        </Shape>
                        <String CONTENT="not, though several of them have been taken at different periods; but she"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l6" HPOS="334" VPOS="905" WIDTH="1769" HEIGHT="47" BASELINE="334 935 2103 935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 935 334 952 2103 952 2103 935 2103 905 334 905 334 935"/>
                        </Shape>
                        <String CONTENT="met the schooner “Henrietta,” just bought by Kuvaˊr, and carried her off as"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l7" HPOS="329" VPOS="952" WIDTH="1772" HEIGHT="61" BASELINE="332 996 2101 991" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 996 332 1013 2099 1009 2101 991 2097 963 1215 952 1213 952 1211 952 1209 952 1191 963 438 954 435 954 329 965 332 996"/>
                        </Shape>
                        <String CONTENT="a prize, in spite of all remonstrance. The schooner was afterwards fitted with"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l8" HPOS="332" VPOS="1013" WIDTH="1771" HEIGHT="67" BASELINE="334 1058 2103 1052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1058 334 1069 918 1080 921 1080 923 1080 925 1080 940 1069 2084 1076 2086 1076 2088 1076 2090 1076 2103 1065 2103 1052 2099 1022 923 1013 921 1013 918 1013 871 1024 431 1015 429 1015 332 1026 334 1058"/>
                        </Shape>
                        <String CONTENT="a steam-engine and used for keeping watch on the Sea of Okhotsk, where"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l9" HPOS="329" VPOS="1069" WIDTH="1772" HEIGHT="65" BASELINE="332 1119 2101 1110" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1119 332 1134 2099 1125 2101 1110 2097 1080 1659 1069 1657 1069 1655 1069 1653 1069 1633 1080 357 1076 355 1076 353 1076 329 1084 332 1119"/>
                        </Shape>
                        <String CONTENT="she was lost in a storm in 1895. Kuvaˊr applied several times to the authori-"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l10" HPOS="332" VPOS="1134" WIDTH="1769" HEIGHT="59" BASELINE="334 1177 2101 1171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1177 334 1193 2099 1188 2101 1171 2097 1138 353 1134 351 1134 349 1134 347 1134 332 1141 334 1177"/>
                        </Shape>
                        <String CONTENT="ties for redress, but without avail. The officials in Vladivostok maintained"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l11" HPOS="334" VPOS="1193" WIDTH="1767" HEIGHT="60" BASELINE="336 1238 2101 1232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 1238 336 1253 2099 1247 2101 1232 2097 1201 934 1193 931 1193 929 1193 901 1203 353 1195 351 1195 349 1195 347 1195 334 1201 336 1238"/>
                        </Shape>
                        <String CONTENT="that the schooner was not yet paid for; but I was told at Indian Point that"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l12" HPOS="334" VPOS="1262" WIDTH="1765" HEIGHT="54" BASELINE="336 1299 2099 1292" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 1299 336 1314 2094 1316 2099 1292 2094 1262 334 1262 336 1299"/>
                        </Shape>
                        <String CONTENT="Kuvaˊr gave for it the whalebone of two whales, a large pile of walrus-tusks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l13" HPOS="332" VPOS="1312" WIDTH="1769" HEIGHT="62" BASELINE="334 1359 2101 1355" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1359 334 1372 2097 1374 2101 1355 2097 1325 1579 1312 1577 1312 1516 1322 1445 1312 1442 1312 1440 1312 1410 1322 1375 1312 1373 1312 1371 1312 1295 1322 1217 1312 1215 1312 1213 1312 1183 1325 1165 1314 1163 1314 1161 1314 1159 1314 916 1325 856 1314 853 1314 851 1314 849 1314 832 1325 685 1314 682 1314 680 1314 633 1325 561 1314 559 1314 557 1314 526 1325 474 1314 472 1314 470 1314 425 1325 353 1314 351 1314 349 1314 347 1314 332 1322 334 1359"/>
                        </Shape>
                        <String CONTENT="three bagfuls of white-fox skins, and three polar-bear skins. During my stay,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l14" HPOS="329" VPOS="1372" WIDTH="1772" HEIGHT="61" BASELINE="332 1418 2101 1411" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1418 332 1433 2099 1426 2101 1411 2097 1383 1531 1372 1529 1372 1447 1383 422 1377 420 1377 329 1387 332 1418"/>
                        </Shape>
                        <String CONTENT="another occasion to buy a schooner presented itself, and I was asked for"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l15" HPOS="329" VPOS="1431" WIDTH="1731" HEIGHT="60" BASELINE="332 1472 2060 1476" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1472 329 1487 2055 1491 2060 1476 2058 1446 1986 1433 1984 1433 1793 1444 1778 1433 1776 1433 1774 1433 1627 1433 1624 1433 1622 1433 1575 1444 1503 1433 1501 1433 1440 1444 1403 1433 1401 1433 1399 1433 1341 1444 1306 1433 1304 1433 1302 1433 1217 1444 1198 1431 1196 1431 1193 1431 1191 1431 1124 1442 996 1431 994 1431 992 1431 951 1442 884 1431 882 1431 788 1444 676 1444 661 1431 659 1431 656 1431 654 1431 652 1431 628 1444 453 1444 433 1431 431 1431 429 1431 427 1431 332 1439 332 1472"/>
                        </Shape>
                        <String CONTENT="advice as to the possibility of a second confiscation, but withheld my opinion."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r3" HPOS="330" VPOS="1495" WIDTH="1778" HEIGHT="665" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="330 1495 2108 1495 2108 2160 330 2160"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l16" HPOS="440" VPOS="1496" WIDTH="1663" HEIGHT="56" BASELINE="442 1537 2103 1532" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="442 1537 442 1552 2101 1548 2103 1532 2099 1504 461 1496 459 1496 457 1496 455 1496 440 1502 442 1537"/>
                        </Shape>
                        <String CONTENT="American wares generally are twice as cheap as those brought from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l17" HPOS="332" VPOS="1563" WIDTH="1773" HEIGHT="47" BASELINE="332 1595 2105 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1595 332 1610 2105 1610 2105 1595 2105 1565 332 1563 332 1595"/>
                        </Shape>
                        <String CONTENT="interior of Siberia. Even those brought from Vladivostok by sea cannot"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l18" HPOS="329" VPOS="1613" WIDTH="1776" HEIGHT="58" BASELINE="332 1656 2105 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1656 332 1671 2105 1667 2105 1652 2101 1623 1217 1613 1215 1613 1126 1623 574 1615 572 1615 329 1626 332 1656"/>
                        </Shape>
                        <String CONTENT="compete with them, because most of them are of American origin, and have"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l19" HPOS="332" VPOS="1684" WIDTH="1771" HEIGHT="50" BASELINE="334 1717 2103 1712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1717 334 1734 2101 1729 2103 1712 2097 1684 332 1686 334 1717"/>
                        </Shape>
                        <String CONTENT="come by a more circuitous route. American granulated sugar forms an exception."/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l20" HPOS="332" VPOS="1729" WIDTH="1769" HEIGHT="63" BASELINE="334 1777 2101 1771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 1777 334 1792 2099 1786 2101 1771 2097 1740 1512 1729 1510 1729 1507 1729 1505 1729 1486 1740 949 1732 947 1732 332 1742 334 1777"/>
                        </Shape>
                        <String CONTENT="It is inferior to the well-refined, hard lump-sugar of the Russians. American"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l21" HPOS="329" VPOS="1792" WIDTH="1774" HEIGHT="61" BASELINE="332 1838 2103 1829" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1838 332 1853 2101 1844 2103 1829 2099 1801 1217 1792 1215 1792 1128 1803 392 1797 390 1797 329 1807 332 1838"/>
                        </Shape>
                        <String CONTENT="cutlery is not always so well adapted to the uses of the natives as are the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l22" HPOS="329" VPOS="1849" WIDTH="1774" HEIGHT="69" BASELINE="332 1898 2103 1890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1898 332 1914 1657 1918 1659 1918 2101 1905 2103 1890 2099 1859 1687 1849 1685 1849 1683 1849 1655 1859 435 1855 433 1855 329 1866 332 1898"/>
                        </Shape>
                        <String CONTENT="rough strong knives made for this purpose in Yakutsk, Sredne-Kolymsk, Mar-"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l23" HPOS="329" VPOS="1911" WIDTH="1774" HEIGHT="61" BASELINE="332 1957 2103 1950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 1957 332 1972 2101 1965 2103 1950 2099 1922 1516 1911 1514 1911 1512 1911 1510 1911 1497 1924 329 1924 332 1957"/>
                        </Shape>
                        <String CONTENT="kova, etc. Moreover, the whalers do not trade in brick-tea, because they do"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l24" HPOS="332" VPOS="1970" WIDTH="1771" HEIGHT="63" BASELINE="334 2017 2103 2011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2017 334 2033 2101 2026 2103 2011 2101 1983 2051 1970 2049 1970 2047 1970 1949 1981 1928 1970 1925 1970 1923 1970 1852 1981 1830 1970 1828 1970 1826 1970 1763 1981 1737 1970 1735 1970 1733 1970 1731 1970 1728 1970 1711 1983 1542 1983 1514 1970 1512 1970 1510 1970 1507 1970 1468 1983 994 1972 992 1972 905 1985 659 1974 656 1974 654 1974 652 1974 635 1987 531 1987 457 1974 455 1974 332 1987 334 2017"/>
                        </Shape>
                        <String CONTENT="not visit any Chinese or southern Siberian ports. Once or twice they brought"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l25" HPOS="332" VPOS="2030" WIDTH="1769" HEIGHT="65" BASELINE="334 2078 2101 2072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2078 334 2095 2099 2089 2101 2072 2097 2041 1605 2030 1603 2030 1455 2043 332 2043 334 2078"/>
                        </Shape>
                        <String CONTENT="brick-tea from Japan; but Japanese brick-tea is of much poorer quality than"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l26" HPOS="329" VPOS="2102" WIDTH="997" HEIGHT="56" BASELINE="332 2132 1326 2137" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2132 329 2147 351 2158 353 2158 355 2158 1323 2150 1326 2137 1323 2106 332 2102 332 2132"/>
                        </Shape>
                        <String CONTENT="Chinese, and the cakes are smaller in size."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r4" HPOS="330" VPOS="2160" WIDTH="1778" HEIGHT="778" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="330 2160 2108 2160 2108 2938 330 2938"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l27" HPOS="440" VPOS="2165" WIDTH="1663" HEIGHT="47" BASELINE="440 2195 2103 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="440 2195 440 2212 2103 2212 2103 2195 2103 2165 440 2165 440 2195"/>
                        </Shape>
                        <String CONTENT="After the native stock of whalebone became exhausted, the whalers began"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l28" HPOS="329" VPOS="2214" WIDTH="1774" HEIGHT="59" BASELINE="332 2256 2103 2251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2256 332 2273 2101 2269 2103 2251 2099 2219 568 2214 565 2214 329 2225 332 2256"/>
                        </Shape>
                        <String CONTENT="to accept instead walrus ivory and the skins of white foxes and of black and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l29" HPOS="329" VPOS="2275" WIDTH="1774" HEIGHT="65" BASELINE="332 2316 2103 2312" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2316 332 2340 2101 2327 2103 2312 2099 2279 390 2275 388 2275 329 2286 332 2316"/>
                        </Shape>
                        <String CONTENT="polar bears. Other Asiatic peltries, such as those of red and cross foxes and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l30" HPOS="332" VPOS="2342" WIDTH="1769" HEIGHT="50" BASELINE="334 2375 2101 2370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2375 334 2392 2099 2388 2101 2370 2094 2342 332 2344 334 2375"/>
                        </Shape>
                        <String CONTENT="of wolves, also skins from America, like the beaver and marten, are taken to"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l31" HPOS="332" VPOS="2394" WIDTH="1771" HEIGHT="59" BASELINE="334 2437 2103 2433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2437 334 2453 2101 2448 2103 2433 2099 2401 353 2394 351 2394 349 2394 347 2394 332 2401 334 2437"/>
                        </Shape>
                        <String CONTENT="the Russian fairs because they fetch a much better price in Asia than would"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l32" HPOS="332" VPOS="2450" WIDTH="1775" HEIGHT="61" BASELINE="334 2496 2107 2492" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2496 334 2511 2105 2507 2107 2492 2099 2450 2055 2461 1542 2450 1540 2450 1475 2461 1447 2450 1445 2450 1442 2450 1378 2461 1326 2450 1323 2450 1198 2463 1066 2453 1063 2453 1061 2453 1029 2463 986 2453 983 2453 981 2453 979 2453 953 2463 830 2453 827 2453 332 2461 334 2496"/>
                        </Shape>
                        <String CONTENT="be paid by the whalers. At the present time the chief source of income of"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l33" HPOS="329" VPOS="2511" WIDTH="1776" HEIGHT="61" BASELINE="332 2557 2105 2552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2557 332 2572 2103 2567 2105 2552 2101 2524 2023 2511 2021 2511 2019 2511 1988 2522 1726 2511 1724 2511 1668 2522 1633 2511 1631 2511 1629 2511 1627 2511 1579 2522 1451 2511 1449 2511 1343 2522 1313 2511 1310 2511 1308 2511 1213 2524 860 2513 858 2513 784 2524 730 2513 728 2513 726 2513 723 2513 708 2526 594 2526 505 2513 503 2513 412 2524 355 2513 353 2513 351 2513 349 2513 329 2522 332 2557"/>
                        </Shape>
                        <String CONTENT="the natives are fawn-skins, which are much needed by the American natives"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l34" HPOS="329" VPOS="2570" WIDTH="1772" HEIGHT="62" BASELINE="332 2617 2101 2611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2617 332 2632 2099 2628 2101 2611 2097 2583 1847 2570 1845 2570 1765 2580 1700 2570 1698 2570 1696 2570 1650 2580 1594 2570 1592 2570 1590 2570 1566 2583 1252 2583 1187 2572 1185 2572 1096 2583 1035 2572 1033 2572 1031 2572 1029 2572 1014 2583 656 2574 654 2574 652 2574 609 2585 550 2574 548 2574 546 2574 511 2585 403 2574 401 2574 329 2587 332 2617"/>
                        </Shape>
                        <String CONTENT="and by the Alaskan miners for making garments; also skins of full-grown"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l35" HPOS="332" VPOS="2645" WIDTH="1767" HEIGHT="50" BASELINE="332 2676 2099 2676" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2676 332 2691 2094 2695 2099 2676 2097 2645 332 2645 332 2676"/>
                        </Shape>
                        <String CONTENT="reindeer for sleeping-bags, ready-made garments even of poor quality, and,"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l36" HPOS="334" VPOS="2691" WIDTH="1769" HEIGHT="58" BASELINE="336 2736 2103 2732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2736 336 2749 2101 2745 2103 2732 2099 2702 1219 2691 1217 2691 1111 2702 509 2693 507 2693 334 2704 336 2736"/>
                        </Shape>
                        <String CONTENT="most of all, various kinds of seal-skin boots, which are used both by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l37" HPOS="334" VPOS="2751" WIDTH="1769" HEIGHT="61" BASELINE="336 2797 2103 2793" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2797 336 2812 2101 2808 2103 2793 2099 2762 1243 2751 1241 2751 1178 2762 370 2754 368 2754 366 2754 334 2764 336 2797"/>
                        </Shape>
                        <String CONTENT="whaling-crews and by the miners. Asiatic and American natives sell these"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l38" HPOS="334" VPOS="2818" WIDTH="1767" HEIGHT="55" BASELINE="336 2857 2101 2851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2857 336 2873 2099 2868 2101 2851 2094 2818 334 2818 336 2857"/>
                        </Shape>
                        <String CONTENT="boots by the thousand every summer; but the demand keeps increasing, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-089_l39" HPOS="332" VPOS="2879" WIDTH="1470" HEIGHT="56" BASELINE="334 2909 1802 2916" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="334 2909 332 2929 336 2933 338 2933 338 2935 340 2935 342 2935 344 2935 1800 2929 1802 2916 1800 2886 334 2879 334 2909"/>
                        </Shape>
                        <String CONTENT="in 1901 the price at Indian Point was a sack of flour per pair."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-089_r5" HPOS="330" VPOS="2938" WIDTH="1778" HEIGHT="298" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="330 2938 2108 2938 2108 3236 330 3236"/>
                    </Shape>
                    <TextLine ID="mz_1-089_l40" HPOS="440" VPOS="2929" WIDTH="1663" HEIGHT="61" BASELINE="442 2970 2103 2974" TAGREFS="TYPE_4">
