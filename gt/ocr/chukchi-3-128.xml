                        </Shape>
                        <String CONTENT="MURDER AND BLOOD-REVENGE WITHIN THE FAMILY-GROUP. — The principal"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-128_r5" HPOS="546" VPOS="2659" WIDTH="1782" HEIGHT="433" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="546 2659 2328 2659 2328 3092 546 3092"/>
                    </Shape>
                    <TextLine ID="mz_3-128_l32" HPOS="645" VPOS="2665" WIDTH="1668" HEIGHT="49" BASELINE="646 2690 2313 2694" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2690 645 2702 2309 2714 2313 2694 2311 2669 646 2665 646 2690"/>
                        </Shape>
                        <String CONTENT="¹ The Chukchee have no other general term covering the concept “crime.” Two roots, taiñ and qäs˙m,"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l33" HPOS="541" VPOS="2708" WIDTH="1770" HEIGHT="46" BASELINE="543 2735 2311 2731" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="543 2735 543 2751 2307 2754 2311 2731 2305 2708 541 2710 543 2735"/>
                        </Shape>
                        <String CONTENT="several derivations of which are used in reference to crime, express only a trespass against religious prescriptions,"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l34" HPOS="545" VPOS="2751" WIDTH="1766" HEIGHT="41" BASELINE="545 2776 2311 2776" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="545 2776 545 2790 2307 2792 2311 2776 2309 2751 545 2751 545 2776"/>
                        </Shape>
                        <String CONTENT="mostly of ceremonial character, and the “bad luck” which is the result thereof. Thus the adjective nɪtaˊɪnqên"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l35" HPOS="543" VPOS="2792" WIDTH="1768" HEIGHT="40" BASELINE="545 2815 2311 2819" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="545 2815 543 2829 2307 2832 2311 2819 2311 2793 545 2792 545 2815"/>
                        </Shape>
                        <String CONTENT="means “bringing bad luck.” The opposite of it is nɪkɪˊntaqên (“bringing good luck,” “favorable”). The noun"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l36" HPOS="543" VPOS="2830" WIDTH="1766" HEIGHT="47" BASELINE="545 2858 2309 2866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="545 2858 543 2869 2305 2877 2309 2866 2307 2838 545 2830 545 2858"/>
                        </Shape>
                        <String CONTENT="taiˊñɪkut (pl.) with the meaning of “misfortune-protectors,” is used as a designation for charm-strings (cf. p. 353)."/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l37" HPOS="545" VPOS="2873" WIDTH="1316" HEIGHT="45" BASELINE="547 2899 1861 2903" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="547 2899 545 2912 1857 2918 1861 2903 1859 2877 547 2873 547 2899"/>
                        </Shape>
                        <String CONTENT="The noun qas˙muˊurg̣ɪn means “bad luck” coming from the influence of keˊlet, etc."/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l38" HPOS="654" VPOS="2914" WIDTH="1659" HEIGHT="45" BASELINE="656 2940 2313 2944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2940 654 2955 2309 2959 2313 2944 2311 2918 656 2914 656 2940"/>
                        </Shape>
                        <String CONTENT="² F. Boas mentions that among the Central Eskimo there exists a kind of temporary chief, who may give"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l39" HPOS="545" VPOS="2961" WIDTH="1766" HEIGHT="43" BASELINE="545 2986 2311 2986" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="545 2986 545 3004 2309 3004 2311 2986 2309 2961 545 2961 545 2986"/>
                        </Shape>
                        <String CONTENT="orders, but that there is not the slightest obligation to obey his orders (Central Eskimo, p. 581). In the same"/>
                    </TextLine>

                    <TextLine ID="mz_3-128_l40" HPOS="547" VPOS="3004" WIDTH="1549" HEIGHT="45" BASELINE="547 3027 2096 3027" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="547 3027 547 3049 2096 3049 2096 3027 2096 3004 547 3004 547 3027"/>
                        </Shape>
                        <String CONTENT="way among the Chukchee the advice of the old men was not binding upon the interested parties."/>
                    </TextLine>

