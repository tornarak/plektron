                            <Polygon POINTS="340 2185 340 2197 468 2207 470 2207 472 2207 473 2207 489 2195 1008 2195 1077 2205 1079 2205 1126 2195 1237 2205 1239 2205 1333 2195 1410 2205 1412 2205 1494 2195 1903 2203 1905 2203 1997 2193 2091 2203 2093 2203 2095 2203 2097 2203 2113 2191 2113 2179 2109 2150 2021 2140 2019 2140 2017 2140 2015 2140 1999 2152 1811 2152 1760 2140 1758 2140 1756 2140 1754 2140 1739 2152 1613 2152 1517 2140 1515 2140 1513 2140 1511 2140 1490 2152 1024 2142 1022 2142 975 2152 928 2142 926 2142 867 2154 387 2144 385 2144 338 2154 340 2185"/>
                        </Shape>
                        <String CONTENT="mind, there arises an idea that material objects have two shapes, — their"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l30" HPOS="340" VPOS="2203" WIDTH="1773" HEIGHT="53" BASELINE="342 2242 2113 2238" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2242 342 2256 2113 2252 2113 2238 2109 2210 405 2203 403 2203 340 2212 342 2242"/>
                        </Shape>
                        <String CONTENT="ordinary form and a transformed form more or less human-like. Both forms"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l31" HPOS="340" VPOS="2261" WIDTH="1769" HEIGHT="65" BASELINE="340 2303 2109 2303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2303 340 2314 354 2324 356 2324 358 2324 360 2324 426 2314 456 2324 458 2324 460 2326 640 2326 640 2324 642 2324 644 2324 660 2314 885 2314 922 2324 924 2324 926 2324 1043 2314 1433 2324 1435 2324 1504 2314 1980 2314 2105 2324 2109 2303 2107 2275 2034 2261 2032 2261 1958 2273 1860 2261 1858 2261 1801 2273 1739 2261 1737 2261 1735 2261 1700 2273 1627 2261 1625 2261 1623 2261 1621 2261 1604 2275 1498 2275 1363 2261 1361 2261 1359 2261 1357 2261 1339 2273 1276 2261 1275 2261 1273 2261 1239 2273 1210 2263 1208 2263 1206 2263 1043 2273 914 2261 912 2261 857 2273 802 2261 801 2261 799 2261 771 2273 740 2261 738 2261 736 2261 650 2273 575 2261 573 2261 571 2261 569 2261 554 2273 340 2273 340 2303"/>
                        </Shape>
                        <String CONTENT="are material, and the objects can at will change one for the other. Thus,"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l32" HPOS="338" VPOS="2318" WIDTH="1773" HEIGHT="59" BASELINE="340 2365 2111 2359" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2365 340 2377 2109 2375 2111 2359 2107 2328 1980 2318 1978 2318 1976 2318 1936 2328 1911 2318 1909 2318 1907 2318 1905 2318 1903 2318 1888 2330 1666 2330 1590 2318 1588 2318 1586 2318 1584 2318 1568 2328 1190 2320 1188 2320 1071 2330 1055 2320 1053 2320 1051 2320 953 2320 951 2320 949 2320 912 2330 689 2322 687 2322 628 2332 585 2322 583 2322 581 2322 338 2332 340 2365"/>
                        </Shape>
                        <String CONTENT="stone mauls of the household transform themselves into men, and shortly"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l33" HPOS="340" VPOS="2381" WIDTH="1769" HEIGHT="63" BASELINE="340 2422 2109 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2422 340 2436 352 2444 354 2444 356 2444 358 2444 562 2434 644 2444 646 2444 703 2434 897 2444 898 2444 1071 2434 1461 2434 1531 2444 1533 2444 1974 2434 2105 2444 2109 2422 2109 2391 2093 2381 2091 2381 2089 2381 2087 2381 2034 2391 2001 2381 1999 2381 1997 2381 1995 2381 1962 2391 1901 2381 1899 2381 1846 2391 1488 2381 1486 2381 1398 2391 1310 2381 1308 2381 1306 2381 1273 2391 1184 2381 1182 2381 1133 2391 1043 2381 1041 2381 875 2391 822 2381 820 2381 818 2381 816 2381 799 2393 681 2393 599 2381 597 2381 595 2381 567 2391 538 2381 536 2381 534 2381 428 2391 381 2381 379 2381 377 2381 340 2391 340 2422"/>
                        </Shape>
                        <String CONTENT="afterward drop on the ground in their former shape. On the other hand,"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l34" HPOS="338" VPOS="2438" WIDTH="1771" HEIGHT="60" BASELINE="340 2483 2109 2477" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2483 340 2498 2107 2498 2109 2477 2105 2447 1870 2438 1868 2438 1866 2438 1864 2438 1848 2449 1750 2449 1701 2438 1700 2438 1647 2447 1611 2438 1609 2438 1607 2438 1605 2438 1604 2438 1588 2447 1177 2440 1175 2440 1055 2449 965 2440 963 2440 887 2449 832 2442 830 2442 828 2442 826 2442 810 2451 601 2442 599 2442 597 2442 595 2442 579 2453 338 2453 340 2483"/>
                        </Shape>
                        <String CONTENT="men may transform themselves at will into animals or inanimate objects. In"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_2-004_r5" HPOS="337" VPOS="2546" WIDTH="1776" HEIGHT="572" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="337 2546 2113 2546 2113 3118 337 3118"/>
                    </Shape>
                    <TextLine ID="mz_2-004_l35" HPOS="446" VPOS="2553" WIDTH="1665" HEIGHT="45" BASELINE="448 2581 2111 2577" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2581 448 2596 2107 2598 2111 2577 2105 2553 446 2555 448 2581"/>
                        </Shape>
                        <String CONTENT="¹ Daniel G. Brinton says, “To the mind of the savage, whatever displayed movement, emitted sound or odor,"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l36" HPOS="338" VPOS="2594" WIDTH="1773" HEIGHT="45" BASELINE="340 2624 2111 2620" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2624 340 2639 2109 2635 2111 2620 2105 2594 338 2596 340 2624"/>
                        </Shape>
                        <String CONTENT="or by its defined limits and form indicated unity, was to him a manifestation in personality of that impersonal"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l37" HPOS="340" VPOS="2635" WIDTH="1767" HEIGHT="49" BASELINE="342 2669 2107 2663" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2669 342 2684 2105 2684 2107 2663 2101 2635 340 2639 342 2669"/>
                        </Shape>
                        <String CONTENT="spiritual Power of which he felt himself but one of the expressions. All other expressions shared his powers,"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l38" HPOS="338" VPOS="2679" WIDTH="1769" HEIGHT="45" BASELINE="340 2710 2107 2704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2710 340 2724 2105 2720 2107 2704 2101 2679 338 2682 340 2710"/>
                        </Shape>
                        <String CONTENT="and did not in essence differ from him. The brute, the plant, the stone, the wandering orbs of night, the"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l39" HPOS="342" VPOS="2724" WIDTH="1769" HEIGHT="43" BASELINE="342 2751 2111 2751" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2751 342 2767 2109 2767 2111 2751 2109 2726 342 2724 342 2751"/>
                        </Shape>
                        <String CONTENT="howling wind, the crackling fire, the towering hill, — all were his fell-creatures, inspired by the same life as"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l40" HPOS="338" VPOS="2763" WIDTH="1548" HEIGHT="49" BASELINE="340 2794 1886 2790" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2794 340 2812 1884 2812 1886 2790 1880 2763 338 2765 340 2794"/>
                        </Shape>
                        <String CONTENT="himself, drawing it from the same universal font of life” (Religions of Primitive Peoples, p. 136)."/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l41" HPOS="450" VPOS="2808" WIDTH="1661" HEIGHT="41" BASELINE="450 2833 2111 2833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 2833 450 2849 2111 2849 2111 2833 2111 2808 450 2808 450 2833"/>
                        </Shape>
                        <String CONTENT="This — if we except the “impersonal spiritual Power” and the “universal font of life,” which seem to be"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l42" HPOS="338" VPOS="2847" WIDTH="1655" HEIGHT="47" BASELINE="340 2880 1993 2874" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 2880 340 2894 1991 2888 1993 2874 1987 2847 338 2851 340 2880"/>
                        </Shape>
                        <String CONTENT="rather too abstract for the lowest stage of primitive religious thought — is nearly what was said above."/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l43" HPOS="446" VPOS="2892" WIDTH="1663" HEIGHT="43" BASELINE="448 2919 2109 2915" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2919 448 2935 2107 2931 2109 2915 2103 2892 446 2894 448 2919"/>
                        </Shape>
                        <String CONTENT="Andrew Lang says still more definitely, “The savage draws no hard line between himself and the things"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l44" HPOS="340" VPOS="2931" WIDTH="1769" HEIGHT="47" BASELINE="342 2962 2109 2959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2962 342 2978 2107 2974 2109 2959 2103 2931 340 2933 342 2962"/>
                        </Shape>
                        <String CONTENT="in the world he regards himself as literally akin to, — animals and plants and heavenly bodies. He attributes"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l45" HPOS="338" VPOS="2974" WIDTH="1769" HEIGHT="49" BASELINE="340 3006 2107 3002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2103 2986 2101 2974 338 2976 340 3006 340 3021 2103 3023 2107 3002 2105 2998 2103 2986"/>
                        </Shape>
                        <String CONTENT="sex and procreative powers even to stones and rocks, and human feelings to sun and moon and stars and wind,"/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l46" HPOS="342" VPOS="3021" WIDTH="1269" HEIGHT="43" BASELINE="342 3047 1611 3047" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 3047 342 3062 1609 3064 1611 3047 1611 3021 342 3021 342 3047"/>
                        </Shape>
                        <String CONTENT="no less than to beasts, birds, and fishes” (Myth, Ritual, and Religion, I, p. 47)."/>
                    </TextLine>

                    <TextLine ID="mz_2-004_l47" HPOS="444" VPOS="3058" WIDTH="409" HEIGHT="53" BASELINE="446 3084 853 3088" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 3084 444 3100 515 3111 517 3111 851 3103 853 3088 851 3062 446 3058 446 3084"/>
                        </Shape>
                        <String CONTENT="² Descent of Man, p. 67."/>
                    </TextLine>

