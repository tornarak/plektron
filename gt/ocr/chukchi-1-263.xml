                        <Shape>
                            <Polygon POINTS="387 2680 387 2693 1260 2701 1262 2701 1327 2691 1838 2691 2135 2701 2137 2701 2139 2701 2141 2701 2159 2688 2159 2675 2154 2645 1273 2634 1271 2634 1269 2634 1247 2645 422 2636 420 2636 417 2636 385 2647 387 2680"/>
                        </Shape>
                        <String CONTENT="villages on the northern border of the Kamchatka district. These people"/>
                    </TextLine>

