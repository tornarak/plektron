                <TextBlock ID="text_1-263" HPOS="360" VPOS="599" WIDTH="1780" HEIGHT="2633"><TextLine ID="mz_1-263_l1" HPOS="940" VPOS="599" WIDTH="624" HEIGHT="57" BASELINE="942 632 1564 636" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="942 632 940 651 1559 656 1564 636 1562 604 942 599 942 632"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l2" HPOS="2040" VPOS="612" WIDTH="98" HEIGHT="57" BASELINE="2040 643 2138 643" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2127 615 2105 612 2040 612 2040 643 2040 656 2099 669 2101 669 2103 669 2138 656 2138 643 2138 615 2127 615"/>
                        </Shape>
                        <String CONTENT="207"/>
                    </TextLine>
<TextLine ID="mz_1-263_l3" HPOS="362" VPOS="705" WIDTH="1778" HEIGHT="68" BASELINE="364 749 2140 742" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="427 708 405 708 383 710 368 710 362 712 364 749 364 764 1542 773 1544 773 1546 773 1549 773 1562 762 2120 770 2122 770 2125 770 2127 770 2140 760 2140 742 2135 712 444 705 427 708"/>
                        </Shape>
                        <String CONTENT="An intoxicated man, while talking to me reasonably enough, suddenly leaped"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l4" HPOS="362" VPOS="762" WIDTH="1776" HEIGHT="60" BASELINE="364 807 2138 803" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 807 364 822 2135 820 2138 803 2135 775 2094 762 2092 762 2090 762 2088 762 2055 773 2001 762 1999 762 1997 762 1995 762 1980 773 1960 762 1958 762 1956 762 1954 762 1930 775 1793 775 1769 762 1767 762 1765 762 1668 773 1640 762 1637 762 1635 762 1633 762 1594 773 1477 762 1475 762 1473 762 1442 773 1414 762 1412 762 1410 762 1408 762 1373 773 1287 762 1284 762 1219 775 667 764 665 764 663 764 626 775 591 764 589 764 587 764 481 775 416 764 414 764 412 764 362 777 364 807"/>
                        </Shape>
                        <String CONTENT="aside, and, dropping on his knees, exclaimed, “Hills, how do you do? Be"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l5" HPOS="364" VPOS="820" WIDTH="1769" HEIGHT="72" BASELINE="366 870 2133 861" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 870 366 892 2131 876 2133 861 2131 831 2116 820 2114 820 2112 820 2109 820 2058 831 2006 820 2003 820 2001 820 1999 820 1984 831 1943 820 1941 820 1938 820 1936 820 1934 820 1919 831 1629 822 1627 822 1624 822 1622 822 1607 833 1310 822 1308 822 1306 822 1282 833 1252 822 1250 822 1248 822 1245 822 1243 822 1226 835 1202 825 1200 825 1198 825 1141 835 782 827 780 827 778 827 775 827 758 838 472 827 470 827 364 840 366 870"/>
                        </Shape>
                        <String CONTENT="greeted!” Then he stood up, and, looking at the full moon, asked, “O"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l6" HPOS="366" VPOS="885" WIDTH="1772" HEIGHT="63" BASELINE="366 928 2138 928" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 928 366 941 2135 948 2138 928 2138 896 2116 885 2114 885 2112 885 2023 896 1858 885 1856 885 1765 896 1711 885 1709 885 1707 885 1670 896 1598 885 1596 885 1594 885 1559 898 1471 898 1455 885 1453 885 1451 885 1449 885 1362 896 1323 885 1321 885 1319 885 1256 896 1226 885 1224 885 1111 885 1109 885 1107 885 1105 885 1089 896 955 885 953 885 886 896 366 892 366 928"/>
                        </Shape>
                        <String CONTENT="Moon! why are you waning so fast?” He told me that the spirits answered,"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l7" HPOS="373" VPOS="946" WIDTH="1760" HEIGHT="58" BASELINE="373 985 2133 985" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 985 373 1004 2133 1004 2133 985 2131 946 373 950 373 985"/>
                        </Shape>
                        <String CONTENT="“Even so will your life wane, unless you show the moon your bare buttocks.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l8" HPOS="364" VPOS="1000" WIDTH="1774" HEIGHT="65" BASELINE="366 1048 2138 1041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 1048 366 1065 2135 1058 2138 1041 2133 1013 2075 1000 2073 1000 2071 1000 2068 1000 2053 1011 1958 1000 1956 1000 1954 1000 1951 1000 1934 1011 1869 1000 1867 1000 1865 1000 1841 1013 1668 1013 1653 1000 1650 1000 1648 1000 1646 1000 1533 1015 1436 1015 1421 1002 1419 1002 1416 1002 1414 1002 1362 1013 1295 1002 1293 1002 1291 1002 1265 1015 1107 1015 1079 1002 1076 1002 1074 1002 914 1015 814 1004 812 1004 810 1004 775 1015 760 1004 758 1004 756 1004 754 1004 697 1015 641 1004 639 1004 563 1015 511 1004 509 1004 507 1004 472 1015 451 1004 448 1004 446 1004 364 1009 366 1048"/>
                        </Shape>
                        <String CONTENT="This he did, and then, suddenly recovering his senses, began to laugh at his"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l9" HPOS="362" VPOS="1063" WIDTH="348" HEIGHT="58" BASELINE="364 1108 710 1104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1108 364 1121 710 1117 710 1104 706 1071 435 1063 433 1063 431 1063 407 1073 379 1063 377 1063 375 1063 373 1063 370 1063 362 1067 364 1108"/>
                        </Shape>
                        <String CONTENT="foolish actions."/>
                    </TextLine>
<TextLine ID="mz_1-263_l10" HPOS="472" VPOS="1123" WIDTH="1668" HEIGHT="59" BASELINE="472 1167 2140 1167" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="472 1167 472 1182 2138 1182 2140 1167 2140 1136 2107 1123 2105 1123 2103 1123 2101 1123 2075 1134 2032 1123 2029 1123 2027 1123 2025 1123 1997 1134 1934 1123 1932 1123 1930 1123 1899 1134 1808 1123 1806 1123 1739 1136 1588 1136 1570 1123 1568 1123 1566 1123 1564 1123 1458 1134 1360 1123 1358 1123 1278 1136 1159 1136 1144 1123 1141 1123 1139 1123 1137 1123 1135 1123 1102 1134 944 1123 942 1123 940 1123 905 1134 472 1130 472 1167"/>
                        </Shape>
                        <String CONTENT="In the third stage the man is unconscious of his surroundings, but he is"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l11" HPOS="362" VPOS="1186" WIDTH="1776" HEIGHT="59" BASELINE="364 1229 2138 1223" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1229 364 1245 2135 1238 2138 1223 2133 1190 399 1186 396 1186 394 1186 362 1197 364 1229"/>
                        </Shape>
                        <String CONTENT="still active, walking or tumbling about on the ground, sometimes raving, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l12" HPOS="362" VPOS="1253" WIDTH="1778" HEIGHT="50" BASELINE="364 1288 2140 1284" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1288 364 1303 2138 1299 2140 1284 2135 1253 362 1253 364 1288"/>
                        </Shape>
                        <String CONTENT="breaking whatever happens to come into his hands. During this period the"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l13" HPOS="364" VPOS="1316" WIDTH="1776" HEIGHT="45" BASELINE="364 1346 2140 1346" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1346 364 1361 2140 1361 2140 1346 2140 1316 364 1316 364 1346"/>
                        </Shape>
                        <String CONTENT="agaric spirits take him through various worlds and show him strange sights"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l14" HPOS="364" VPOS="1374" WIDTH="1774" HEIGHT="50" BASELINE="364 1405 2138 1405" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1405 364 1422 2135 1424 2138 1405 2138 1374 364 1374 364 1405"/>
                        </Shape>
                        <String CONTENT="and peoples. Then a heavy slumber ensues, lasting for several hours, during"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l15" HPOS="362" VPOS="1424" WIDTH="1769" HEIGHT="57" BASELINE="364 1465 2131 1461" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1465 364 1481 2129 1476 2131 1461 2127 1424 405 1424 403 1424 401 1424 362 1435 364 1465"/>
                        </Shape>
                        <String CONTENT="which it is impossible to rouse the sleeper. How persistent are the spirits’"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l16" HPOS="364" VPOS="1496" WIDTH="1776" HEIGHT="47" BASELINE="364 1524 2140 1524" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1524 364 1543 2140 1543 2140 1524 2140 1496 364 1496 364 1524"/>
                        </Shape>
                        <String CONTENT="commands is shown by the following instance of a man, who, when about to"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l17" HPOS="360" VPOS="1543" WIDTH="1780" HEIGHT="59" BASELINE="362 1584 2140 1580" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1584 362 1602 2138 1597 2140 1580 2135 1552 429 1543 427 1543 360 1554 362 1584"/>
                        </Shape>
                        <String CONTENT="retire, was ordered to lie down in the midst of his dog-team. Although he"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l18" HPOS="362" VPOS="1602" WIDTH="1776" HEIGHT="69" BASELINE="364 1647 2138 1641" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1647 364 1660 697 1660 745 1671 747 1671 749 1671 752 1671 754 1671 769 1660 890 1660 951 1671 953 1671 1027 1658 1271 1658 1287 1669 1289 1669 1291 1669 1293 1669 1365 1658 1393 1669 1395 1669 1397 1669 1605 1656 1696 1667 1698 1667 1700 1667 1746 1656 1800 1667 1802 1667 2135 1656 2138 1641 2133 1613 1546 1602 1544 1602 1542 1602 1499 1613 518 1606 516 1606 362 1617 364 1647"/>
                        </Shape>
                        <String CONTENT="was attacked by the dogs, we could not keep him away from them. He"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l19" HPOS="360" VPOS="1660" WIDTH="1195" HEIGHT="74" BASELINE="362 1708 1555 1701" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1708 362 1723 487 1734 490 1734 492 1734 494 1734 494 1732 505 1723 979 1732 981 1732 983 1732 986 1732 986 1729 996 1721 1553 1721 1555 1701 1551 1671 1154 1660 1152 1660 1150 1660 1124 1671 767 1662 765 1662 762 1662 760 1662 760 1665 749 1673 377 1665 375 1665 373 1665 370 1665 360 1671 362 1708"/>
                        </Shape>
                        <String CONTENT="finally succeeded in staying with the dogs all night."/>
                    </TextLine>
<TextLine ID="mz_1-263_l20" HPOS="470" VPOS="1736" WIDTH="1670" HEIGHT="45" BASELINE="470 1764 2140 1764" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="470 1764 470 1781 2140 1781 2140 1764 2140 1736 470 1736 470 1764"/>
                        </Shape>
                        <String CONTENT="On awakening, a general weakness and heavy headache ensue, accom-"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l21" HPOS="360" VPOS="1784" WIDTH="1780" HEIGHT="62" BASELINE="362 1827 2140 1823" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 1827 362 1846 2138 1838 2140 1823 2135 1790 451 1784 448 1784 360 1794 362 1827"/>
                        </Shape>
                        <String CONTENT="panied by nausea, often violent vomiting. The drunken state can be renewed"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l22" HPOS="362" VPOS="1853" WIDTH="1776" HEIGHT="50" BASELINE="364 1888 2138 1881" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1888 364 1903 2135 1896 2138 1881 2133 1853 362 1853 364 1888"/>
                        </Shape>
                        <String CONTENT="by a single mushroom. In this manner inveterate agaric-eaters keep up their"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l23" HPOS="362" VPOS="1901" WIDTH="604" HEIGHT="62" BASELINE="364 1946 966 1942" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 1946 364 1963 964 1963 966 1942 962 1914 778 1901 775 1901 693 1911 665 1901 663 1901 661 1901 659 1901 656 1901 641 1914 373 1903 370 1903 368 1903 366 1903 366 1905 364 1905 362 1905 364 1946"/>
                        </Shape>
                        <String CONTENT="intoxication day after day."/>
                    </TextLine>
<TextLine ID="mz_1-263_l24" HPOS="468" VPOS="1959" WIDTH="1672" HEIGHT="63" BASELINE="470 2007 2140 2000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="470 2007 470 2022 2138 2015 2140 2000 2135 1972 2075 1959 2073 1959 1962 1970 1936 1959 1934 1959 1932 1959 1828 1970 1795 1959 1793 1959 1791 1959 1683 1970 1640 1959 1637 1959 1635 1959 1633 1959 1631 1959 1618 1972 1518 1972 1204 1961 1202 1961 1200 1961 1198 1961 1180 1972 1126 1961 1124 1961 994 1974 981 1963 979 1963 977 1963 975 1963 973 1963 927 1974 851 1963 849 1963 791 1974 732 1963 730 1963 728 1963 691 1974 622 1963 620 1963 468 1972 470 2007"/>
                        </Shape>
                        <String CONTENT="Drinking the urine of one who has recently eaten fly-agaric produces the"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l25" HPOS="362" VPOS="2024" WIDTH="1776" HEIGHT="58" BASELINE="364 2067 2138 2059" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2067 364 2082 2135 2074 2138 2059 2133 2030 808 2024 806 2024 743 2035 542 2026 539 2026 362 2037 364 2067"/>
                        </Shape>
                        <String CONTENT="same effect as eating the mushroom. The passion for intoxication becomes"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l26" HPOS="362" VPOS="2082" WIDTH="1778" HEIGHT="59" BASELINE="364 2126 2140 2121" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2126 364 2141 2138 2137 2140 2121 2135 2093 1453 2082 1451 2082 362 2095 364 2126"/>
                        </Shape>
                        <String CONTENT="so strong that the people will often resort to this source when agaric is not"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l27" HPOS="362" VPOS="2141" WIDTH="1778" HEIGHT="67" BASELINE="364 2186 2140 2182" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2186 364 2199 2118 2208 2120 2208 2122 2208 2125 2208 2140 2197 2140 2182 2135 2152 1300 2141 1297 2141 1232 2152 446 2143 444 2143 362 2154 364 2186"/>
                        </Shape>
                        <String CONTENT="available. Apparently without aversion they will even pass this liquor around"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l28" HPOS="362" VPOS="2201" WIDTH="1776" HEIGHT="61" BASELINE="364 2245 2138 2240" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2245 364 2262 2135 2258 2138 2240 2133 2212 1258 2201 1256 2201 1254 2201 1252 2201 1252 2204 1241 2214 362 2214 364 2245"/>
                        </Shape>
                        <String CONTENT="in their ordinary tea-cups. The effect is said to be less than from the mush-"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l29" HPOS="364" VPOS="2277" WIDTH="422" HEIGHT="48" BASELINE="364 2305 786 2305" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2305 364 2325 786 2325 786 2305 786 2277 364 2277 364 2305"/>
                        </Shape>
                        <String CONTENT="rooms themselves."/>
                    </TextLine>
<TextLine ID="mz_1-263_l30" HPOS="472" VPOS="2331" WIDTH="1666" HEIGHT="50" BASELINE="474 2366 2138 2360" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 2366 474 2381 2135 2375 2138 2360 2133 2331 472 2331 474 2366"/>
                        </Shape>
                        <String CONTENT="I have already spoken about the amount of trade in strong liquors car-"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l31" HPOS="360" VPOS="2377" WIDTH="1778" HEIGHT="67" BASELINE="362 2427 2138 2418" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="362 2427 362 2444 2135 2435 2138 2418 2133 2390 1895 2377 1893 2377 1832 2388 1808 2377 1806 2377 1804 2377 1802 2377 1759 2388 1720 2377 1718 2377 1715 2377 1713 2377 1687 2390 1583 2379 1581 2379 1579 2379 1577 2379 1559 2392 1382 2392 1356 2379 1354 2379 1352 2379 1349 2379 1347 2379 1332 2390 1250 2379 1248 2379 1245 2379 1206 2392 1163 2381 1161 2381 1159 2381 773 2394 713 2383 710 2383 477 2394 390 2383 388 2383 386 2383 360 2394 362 2427"/>
                        </Shape>
                        <String CONTENT="ried on in northeastern Siberia. The Chukchee, as well as all other inhabitants"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l32" HPOS="362" VPOS="2440" WIDTH="1776" HEIGHT="71" BASELINE="364 2487 2138 2481" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2487 364 2500 721 2511 723 2511 726 2511 728 2511 743 2500 849 2500 931 2511 934 2511 936 2511 973 2498 1501 2498 1540 2509 1542 2509 1544 2509 1661 2496 2114 2507 2116 2507 2118 2507 2120 2507 2138 2494 2138 2481 2133 2453 1951 2440 1949 2440 1850 2450 1802 2440 1800 2440 1798 2440 1795 2440 1752 2450 1709 2440 1707 2440 1705 2440 1635 2450 1557 2440 1555 2440 1553 2440 1512 2453 1477 2442 1475 2442 1473 2442 1063 2453 1003 2442 1001 2442 999 2442 996 2442 981 2455 853 2455 403 2444 401 2444 399 2444 362 2457 364 2487"/>
                        </Shape>
                        <String CONTENT="of the country, are eager for a chance to drink spirits. In all my journeys"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l33" HPOS="362" VPOS="2500" WIDTH="1773" HEIGHT="63" BASELINE="364 2546 2135 2541" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2546 364 2561 2131 2563 2135 2541 2131 2511 1269 2500 1267 2500 1265 2500 1243 2511 388 2502 386 2502 383 2502 362 2511 364 2546"/>
                        </Shape>
                        <String CONTENT="through these countries I met people in only two places who knew nothing"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l34" HPOS="362" VPOS="2559" WIDTH="1776" HEIGHT="62" BASELINE="364 2606 2138 2600" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2606 364 2621 2135 2615 2138 2600 2133 2570 1555 2559 1553 2559 1551 2559 1549 2559 1536 2570 396 2563 394 2563 392 2563 362 2574 364 2606"/>
                        </Shape>
                        <String CONTENT="about strong liquors. In one case they were some Maritime Koryak in small"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l35" HPOS="364" VPOS="2619" WIDTH="1774" HEIGHT="67" BASELINE="366 2665 2138 2660" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2665 366 2678 1239 2686 1241 2686 1306 2676 1817 2676 2114 2686 2116 2686 2118 2686 2120 2686 2138 2673 2138 2660 2133 2630 1252 2619 1250 2619 1248 2619 1226 2630 401 2621 399 2621 396 2621 364 2632 366 2665"/>
                        </Shape>
                        <String CONTENT="villages on the northern border of the Kamchatka district. These people"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l36" HPOS="364" VPOS="2678" WIDTH="1771" HEIGHT="63" BASELINE="366 2725 2135 2719" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2725 366 2741 2133 2734 2135 2719 2131 2689 1557 2678 1555 2678 1451 2689 1001 2680 999 2680 914 2691 511 2682 509 2682 364 2693 366 2725"/>
                        </Shape>
                        <String CONTENT="were far from the Kamchatka towns and from Gishiginsk trading-settlements."/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l37" HPOS="364" VPOS="2743" WIDTH="1774" HEIGHT="67" BASELINE="366 2784 2138 2780" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2784 366 2799 817 2810 819 2810 821 2810 851 2799 938 2810 940 2810 942 2810 944 2810 960 2799 1165 2799 1209 2810 1211 2810 1213 2810 1289 2797 1546 2808 1549 2808 1551 2808 1590 2797 1670 2808 1672 2808 2135 2795 2138 2780 2133 2751 386 2743 383 2743 381 2743 379 2743 364 2749 366 2784"/>
                        </Shape>
                        <String CONTENT="At the same time, they were so poor that nobody sought to bring liquors"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l38" HPOS="362" VPOS="2803" WIDTH="1778" HEIGHT="57" BASELINE="364 2844 2140 2838" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2844 364 2860 2138 2853 2140 2838 2135 2803 461 2803 459 2803 362 2814 364 2844"/>
                        </Shape>
                        <String CONTENT="to them. The other case was that of the Kerek of the southern shore of"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l39" HPOS="364" VPOS="2857" WIDTH="303" HEIGHT="70" BASELINE="366 2899 667 2905" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2899 364 2920 373 2927 375 2927 377 2927 379 2927 665 2920 667 2905 665 2875 565 2860 563 2860 561 2860 559 2860 546 2870 492 2860 490 2860 487 2860 466 2870 399 2857 396 2857 394 2857 366 2866 366 2899"/>
                        </Shape>
