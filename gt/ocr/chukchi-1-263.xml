                        </Shape>
                        <String CONTENT="Moon! why are you waning so fast?” He told me that the spirits answered,"/>
                    </TextLine>

                    <TextLine ID="mz_1-263_l7" HPOS="394" VPOS="961" WIDTH="1760" HEIGHT="58" BASELINE="394 1000 2154 1000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="394 1000 394 1019 2154 1019 2154 1000 2152 961 394 965 394 1000"/>
