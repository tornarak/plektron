                        </Shape>
                        <String CONTENT="BIRTH AND CHILDHOOD. — The Chukchee women are delivered with little"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l32" HPOS="675" VPOS="2461" WIDTH="1778" HEIGHT="69" BASELINE="677 2507 2453 2500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="677 2507 677 2520 1206 2530 1208 2530 1210 2530 1212 2530 1227 2520 1258 2530 1260 2530 1262 2530 1399 2517 1803 2528 1806 2528 1931 2515 2050 2515 2066 2526 2068 2526 2070 2526 2072 2526 2364 2515 2429 2526 2432 2526 2434 2526 2436 2526 2453 2513 2453 2500 2449 2472 2105 2461 2102 2461 675 2472 677 2507"/>
                        </Shape>
                        <String CONTENT="labor. Custom strictly forbids the woman to groan, or to give way to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l33" HPOS="677" VPOS="2517" WIDTH="1776" HEIGHT="72" BASELINE="680 2567 2453 2559" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2567 680 2589 1173 2578 1225 2589 1227 2589 1305 2578 1550 2589 1552 2589 1554 2589 1557 2589 1574 2576 1637 2587 1639 2587 1693 2576 1877 2587 1879 2587 1881 2587 1912 2576 1968 2587 1970 2587 1972 2587 1975 2587 1990 2576 2098 2585 2100 2585 2102 2585 2105 2585 2120 2574 2432 2585 2434 2585 2436 2585 2438 2585 2453 2572 2453 2559 2449 2530 2356 2517 2354 2517 2351 2517 2349 2517 2334 2530 2072 2530 2044 2517 2042 2517 2040 2517 2037 2517 2005 2530 1587 2520 1585 2520 1583 2520 1580 2520 1565 2530 1217 2522 1214 2522 1212 2522 1169 2533 1128 2522 1126 2522 1123 2522 1009 2535 738 2524 736 2524 677 2537 680 2567"/>
                        </Shape>
                        <String CONTENT="pain by any audible sign. Nor may help be given by other women. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l34" HPOS="680" VPOS="2582" WIDTH="1773" HEIGHT="59" BASELINE="682 2626 2453 2617" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2626 682 2641 2451 2634 2453 2617 2449 2587 1221 2582 1219 2582 680 2595 682 2626"/>
                        </Shape>
                        <String CONTENT="woman who has been delivered has to attend to her own needs herself, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l35" HPOS="677" VPOS="2645" WIDTH="1778" HEIGHT="56" BASELINE="680 2686 2455 2678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2686 680 2701 2453 2693 2455 2678 2451 2649 699 2645 697 2645 695 2645 693 2645 677 2652 680 2686"/>
                        </Shape>
                        <String CONTENT="to those of the new-born infant. She cuts the navel-string and puts away the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l36" HPOS="680" VPOS="2697" WIDTH="1773" HEIGHT="72" BASELINE="682 2745 2453 2736" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2745 682 2769 2451 2753 2453 2736 2447 2697 1106 2712 714 2704 712 2704 710 2704 680 2714 682 2745"/>
