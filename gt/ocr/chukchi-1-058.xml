                        <Shape>
                            <Polygon POINTS="680 1608 680 1621 959 1632 961 1632 1136 1619 2445 1619 2447 1599 2442 1569 2122 1558 2120 1558 1994 1569 1589 1560 1587 1560 1585 1560 1552 1573 677 1573 680 1608"/>
                        </Shape>
                        <String CONTENT="Lower Kolyma the number of unmarried people is disproportionately large."/>
                    </TextLine>

