                        </Shape>
                        <String CONTENT="nature. A number of them abstained from matrimony and from producing"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l14" HPOS="677" VPOS="1385" WIDTH="1772" HEIGHT="59" BASELINE="680 1428 2449 1420" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 1428 680 1444 2447 1437 2449 1420 2445 1389 718 1385 716 1385 714 1385 677 1396 680 1428"/>
                        </Shape>
                        <String CONTENT="offspring. They dropped a large part of their former pursuits, and patiently"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l15" HPOS="677" VPOS="1441" WIDTH="1774" HEIGHT="65" BASELINE="680 1485 2451 1478" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 1485 680 1500 1858 1506 1860 1506 1862 1506 1910 1496 2449 1496 2451 1478 2447 1450 1271 1441 1269 1441 1266 1441 1264 1441 1245 1452 731 1444 729 1444 677 1454 680 1485"/>
                        </Shape>
                        <String CONTENT="submitted to regular periods of famine, considering their tribe doomed to"/>
                    </TextLine>

