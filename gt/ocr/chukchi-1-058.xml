                        <Shape>
                            <Polygon POINTS="680 1545 680 1560 1858 1567 1860 1567 1862 1567 1903 1556 2449 1556 2451 1539 2447 1511 699 1504 697 1504 695 1504 693 1504 677 1511 680 1545"/>
                        </Shape>
                        <String CONTENT="destruction. For instance, among the vanishing clans of the Yukaghir on the"/>
                    </TextLine>

