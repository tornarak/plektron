                        </Shape>
                        <String CONTENT="take care that the people of this country shall not multiply. In olden times"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l27" HPOS="677" VPOS="2162" WIDTH="1774" HEIGHT="61" BASELINE="680 2208 2451 2201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2208 680 2223 2449 2216 2451 2201 2447 2171 1299 2162 1297 2162 1217 2173 1022 2165 1020 2165 677 2175 680 2208"/>
                        </Shape>
                        <String CONTENT="war was sent down to ward off increase. After that, in spite of the abundant"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l28" HPOS="677" VPOS="2221" WIDTH="1774" HEIGHT="63" BASELINE="680 2268 2451 2262" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2268 680 2284 2449 2281 2451 2262 2447 2232 1860 2221 1858 2221 1855 2221 1814 2232 755 2225 753 2225 677 2236 680 2268"/>
                        </Shape>
                        <String CONTENT="variety of sea-game, famine would come and carry off the surplus. At present,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l29" HPOS="677" VPOS="2281" WIDTH="1774" HEIGHT="63" BASELINE="680 2327 2451 2318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2327 680 2344 2449 2336 2451 2318 2447 2290 1565 2281 1563 2281 1561 2281 1559 2281 1544 2292 718 2286 716 2286 714 2286 677 2297 680 2327"/>
                        </Shape>
                        <String CONTENT="with the fulsome supply of American food, the disease comes down, and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l30" HPOS="677" VPOS="2342" WIDTH="620" HEIGHT="67" BASELINE="680 2387 1297 2381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 2387 680 2400 1087 2409 1089 2409 1141 2398 1275 2407 1277 2407 1279 2407 1282 2407 1297 2396 1297 2381 1290 2342 677 2357 680 2387"/>
                        </Shape>
                        <String CONTENT="result is exactly the same.”"/>
