                        </Shape>
                        <String CONTENT="which gave them the power and the will to struggle with the harsh Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l13" HPOS="675" VPOS="1331" WIDTH="1774" HEIGHT="52" BASELINE="677 1366 2449 1361" TAGREFS="TYPE_5">
                        <Shape>
