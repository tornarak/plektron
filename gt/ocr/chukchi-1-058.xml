                        </Shape>
                        <String CONTENT="Worst of all, the natives lost their vital energy and their zest for life,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l12" HPOS="677" VPOS="1260" WIDTH="1774" HEIGHT="67" BASELINE="680 1307 2451 1301" TAGREFS="TYPE_5">
