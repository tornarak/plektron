                        <Shape>
                            <Polygon POINTS="783 2087 783 2102 2449 2102 2451 2082 2447 2052 1946 2039 1944 2039 1942 2039 1940 2039 1927 2052 1754 2052 1697 2039 1695 2039 1693 2039 1650 2050 1518 2041 1515 2041 1459 2052 1416 2041 1414 2041 1412 2041 1409 2041 1407 2041 1394 2052 1357 2041 1355 2041 1353 2041 1351 2041 1349 2041 1334 2054 1165 2054 1102 2041 1100 2041 1097 2041 1054 2052 952 2041 950 2041 861 2052 805 2041 803 2041 801 2041 799 2041 781 2050 783 2087"/>
                        </Shape>
                        <String CONTENT="One of the old men at Indian Point said to me, “The spirits, it seems,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l26" HPOS="675" VPOS="2100" WIDTH="1776" HEIGHT="62" BASELINE="677 2147 2451 2141" TAGREFS="TYPE_5">
