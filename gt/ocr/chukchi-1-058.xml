                        <Shape>
                            <Polygon POINTS="680 1727 680 1742 2005 1747 2007 1747 2449 1734 2451 1719 2447 1690 1572 1682 1570 1682 1567 1682 1565 1682 1552 1693 1130 1684 1128 1684 1126 1684 1102 1695 697 1686 695 1686 693 1686 690 1686 677 1693 680 1727"/>
                        </Shape>
                        <String CONTENT="degree went out of practice, because they required too much exertion. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l20" HPOS="677" VPOS="1738" WIDTH="1785" HEIGHT="69" BASELINE="680 1788 2462 1781" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 1788 680 1807 2460 1796 2462 1781 2460 1751 2425 1738 2423 1738 2421 1738 2419 1738 2395 1749 2308 1738 2306 1738 2230 1749 2202 1738 2200 1738 2198 1738 2195 1738 2193 1738 2178 1751 2048 1751 2020 1738 2018 1738 2016 1738 1938 1749 1890 1738 1888 1738 1886 1738 1884 1738 1881 1738 1862 1751 1827 1740 1825 1740 1823 1740 1745 1751 1669 1740 1667 1740 1665 1740 1637 1751 1191 1742 1188 1742 1186 1742 1184 1742 1169 1753 855 1742 853 1742 851 1742 848 1742 831 1753 794 1742 792 1742 790 1742 677 1755 680 1788"/>
                        </Shape>
                        <String CONTENT="people live solely by fishing, and every spring suffer from the scarcity of food,"/>
