                    <TextLine ID="mz_1-074_l2" HPOS="751" VPOS="707" WIDTH="1748" HEIGHT="68" BASELINE="753 751 2499 744" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2483 716 2462 716 2440 716 2434 714 1334 707 1331 707 1329 707 1288 718 822 710 820 710 751 720 753 751 753 766 1912 775 1914 775 1975 764 2481 772 2483 772 2486 772 2488 772 2499 762 2499 744 2494 716 2483 714 2483 716"/>
                        </Shape>
                        <String CONTENT="1. Emyiˊrɪk (“in the extending [of the days]”). Loosely speaking, it corresponds to the first month"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l3" HPOS="851" VPOS="768" WIDTH="223" HEIGHT="46" BASELINE="851 796 1074 796" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="851 796 851 814 1074 814 1074 796 1074 768 851 768 851 796"/>
                        </Shape>
                        <String CONTENT="of the year."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l4" HPOS="760" VPOS="814" WIDTH="1355" HEIGHT="45" BASELINE="760 842 2115 842" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="760 842 760 859 2113 857 2115 842 2113 814 760 814 760 842"/>
                        </Shape>
                        <String CONTENT="2. Ureˊtvik (“in the lengthening”). This corresponds to the second month."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l5" HPOS="755" VPOS="848" WIDTH="1746" HEIGHT="63" BASELINE="757 891 2501 885" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 891 757 911 2501 900 2501 885 2496 857 1338 848 1336 848 1334 848 1286 859 825 850 822 850 755 861 757 891"/>
                        </Shape>
                        <String CONTENT="3. Niwleˊwkɪ (“during [the days] growing long”). It lasts about six weeks, until the reindeer-dams"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l6" HPOS="851" VPOS="909" WIDTH="272" HEIGHT="45" BASELINE="851 937 1123 937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="851 937 851 950 1121 954 1123 937 1123 909 851 909 851 937"/>
                        </Shape>
                        <String CONTENT="begin to calve."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l7" HPOS="760" VPOS="943" WIDTH="1656" HEIGHT="63" BASELINE="762 987 2416 976" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="762 987 762 1006 2063 1006 2063 1004 2152 993 2390 1002 2393 1002 2395 1002 2416 989 2416 976 2412 943 1106 943 1104 943 1102 943 1100 943 1082 954 831 946 829 946 760 956 762 987"/>
                        </Shape>
                        <String CONTENT="4. Am-g̣roˊkĭ (“in the calving [time]”). This corresponds more or less to our term “spring.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l8" HPOS="807" VPOS="1000" WIDTH="815" HEIGHT="47" BASELINE="807 1028 1622 1028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="807 1028 807 1047 1622 1047 1622 1028 1622 1000 807 1000 807 1028"/>
                        </Shape>
                        <String CONTENT="5. Tur-eleˊtvuk (“in the new summer growing”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l9" HPOS="755" VPOS="1041" WIDTH="648" HEIGHT="50" BASELINE="757 1071 1403 1076" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="757 1071 755 1086 1399 1091 1403 1076 1403 1045 757 1041 757 1071"/>
                        </Shape>
                        <String CONTENT="6. Kɪˊtkɪtɪk (“in the first summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l10" HPOS="768" VPOS="1091" WIDTH="646" HEIGHT="56" BASELINE="770 1123 1414 1119" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="770 1123 770 1147 1412 1138 1414 1119 1409 1093 768 1091 770 1123"/>
                        </Shape>
                        <String CONTENT="7. Aˊnok (“in the second summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l11" HPOS="755" VPOS="1138" WIDTH="650" HEIGHT="48" BASELINE="755 1166 1405 1166" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="755 1166 755 1186 1405 1186 1405 1166 1405 1138 755 1138 755 1166"/>
                        </Shape>
                        <String CONTENT="8. Eˊlek (“in the middle summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l12" HPOS="801" VPOS="1182" WIDTH="766" HEIGHT="47" BASELINE="803 1214 1567 1210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="803 1214 803 1229 1567 1225 1567 1210 1561 1182 801 1184 803 1214"/>
                        </Shape>
                        <String CONTENT="9. Êh-ɪˊntok (“with the fresh air going out”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l13" HPOS="738" VPOS="1227" WIDTH="758" HEIGHT="52" BASELINE="740 1264 1496 1257" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="740 1264 740 1279 1496 1273 1496 1257 1489 1227 738 1231 740 1264"/>
                        </Shape>
                        <String CONTENT="10. Ñerg̣eˊrɪk (“with the first light frost”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l14" HPOS="736" VPOS="1275" WIDTH="714" HEIGHT="52" BASELINE="738 1309 1450 1305" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="738 1309 738 1327 1448 1322 1450 1305 1444 1275 736 1277 738 1309"/>
                        </Shape>
                        <String CONTENT="11. Tur-äᵋleˊtɪk (“with the new snow”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l15" HPOS="734" VPOS="1322" WIDTH="491" HEIGHT="50" BASELINE="736 1355 1225 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1355 736 1372 1223 1370 1225 1353 1219 1322 734 1322 736 1355"/>
                        </Shape>
                        <String CONTENT="12. G̣ɪthaˊk (“in the fall”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l16" HPOS="738" VPOS="1363" WIDTH="572" HEIGHT="65" BASELINE="740 1405 1310 1398" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="740 1405 740 1418 775 1428 777 1428 779 1428 1310 1413 1310 1398 1305 1370 926 1363 924 1363 738 1374 740 1405"/>
                        </Shape>
                        <String CONTENT="13. Läᵋleˊñkɪ (“in the winter”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l17" HPOS="851" VPOS="1415" WIDTH="1520" HEIGHT="50" BASELINE="853 1448 2371 1444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2362 1415 851 1418 853 1448 853 1465 2369 1461 2371 1444 2364 1415 2362 1415"/>
                        </Shape>
                        <String CONTENT="Yawrɪˊna means “in the next year,” and is applied to the beginning of the next fall."/>
                    </TextLine>
