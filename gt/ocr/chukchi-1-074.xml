                        </Shape>
                        <String CONTENT="LANGUAGE. — The Chukchee language is rich in words, and pliant in"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l19" HPOS="727" VPOS="1552" WIDTH="1774" HEIGHT="69" BASELINE="729 1597 2501 1589" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 1597 729 1610 1152 1621 1154 1621 1643 1608 2479 1615 2481 1615 2483 1615 2486 1615 2501 1604 2501 1589 2496 1560 1615 1552 1613 1552 1611 1552 1576 1563 1225 1554 1223 1554 1152 1565 740 1556 738 1556 736 1556 734 1556 734 1558 727 1563 729 1597"/>
                        </Shape>
                        <String CONTENT="forms; and the people are eloquent in their own way, but they do not like"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l20" HPOS="729" VPOS="1608" WIDTH="1770" HEIGHT="61" BASELINE="731 1654 2499 1647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1654 731 1669 2496 1662 2499 1647 2494 1619 1968 1608 1966 1608 1903 1619 816 1612 814 1612 729 1623 731 1654"/>
                        </Shape>
                        <String CONTENT="to be bored with questions. The Reindeer men, who are in their houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l21" HPOS="731" VPOS="1669" WIDTH="1768" HEIGHT="73" BASELINE="734 1716 2499 1710" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1716 734 1742 961 1732 2494 1732 2499 1710 2494 1682 2115 1669 2113 1669 2009 1680 1975 1669 1972 1669 1970 1669 1968 1669 1966 1669 1951 1680 1522 1671 1520 1671 1518 1671 1515 1671 1500 1684 1364 1684 1323 1671 1321 1671 1318 1671 1316 1671 1260 1684 844 1673 842 1673 731 1686 734 1716"/>
                        </Shape>
                        <String CONTENT="practically only when eating or sleeping, and keep in motion all the time,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l22" HPOS="729" VPOS="1732" WIDTH="1770" HEIGHT="67" BASELINE="731 1777 2499 1770" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 1777 731 1788 1292 1799 1295 1799 1435 1788 2499 1788 2499 1770 2494 1740 1362 1732 1360 1732 729 1744 731 1777"/>
                        </Shape>
                        <String CONTENT="were with difficulty persuaded to spend a few hours with me in the tent,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l23" HPOS="731" VPOS="1792" WIDTH="1765" HEIGHT="72" BASELINE="734 1840 2496 1829" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1840 734 1864 883 1853 976 1861 978 1861 2494 1844 2496 1829 2492 1794 1297 1792 1295 1792 1292 1792 1290 1792 1275 1805 1173 1805 1087 1792 1084 1792 1082 1792 1043 1805 981 1794 978 1794 879 1805 762 1794 760 1794 757 1794 731 1805 734 1840"/>
                        </Shape>
                        <String CONTENT="giving explanations or dictating texts. Even the old men would say, “Bad"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l24" HPOS="727" VPOS="1848" WIDTH="1769" HEIGHT="65" BASELINE="729 1896 2496 1890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 1896 729 1913 2494 1913 2496 1890 2492 1861 1923 1848 1920 1848 1918 1848 1916 1848 1899 1861 1793 1851 1790 1851 1507 1861 1450 1851 1448 1851 1360 1861 1321 1851 1318 1851 1316 1851 1212 1864 1188 1853 1186 1853 1184 1853 1128 1864 909 1853 907 1853 820 1864 755 1853 753 1853 751 1853 727 1864 729 1896"/>
                        </Shape>
                        <String CONTENT="thing, dotage,” and would prefer to stay outside. Most of them, moreover,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l25" HPOS="727" VPOS="1907" WIDTH="1769" HEIGHT="65" BASELINE="729 1957 2496 1948" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 1957 729 1972 2494 1963 2496 1948 2490 1913 2219 1918 2180 1907 2178 1907 2176 1907 2174 1907 2141 1918 2109 1907 2107 1907 2105 1907 1983 1920 1957 1909 1955 1909 1953 1909 1951 1909 1929 1920 1875 1909 1873 1909 1871 1909 1849 1920 1814 1909 1812 1909 1810 1909 1723 1920 1637 1909 1635 1909 1632 1909 1606 1922 1474 1911 1472 1911 1407 1922 1279 1911 1277 1911 1275 1911 1273 1911 1258 1922 1089 1913 1087 1913 978 1924 926 1913 924 1913 727 1926 729 1957"/>
                        </Shape>
                        <String CONTENT="were quite unable to dictate. Even their curiosity is not lasting. When I"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l26" HPOS="727" VPOS="1967" WIDTH="1769" HEIGHT="65" BASELINE="729 2017 2496 2009" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 2017 729 2032 2494 2024 2496 2009 2492 1978 2107 1967 2105 1967 2046 1978 1689 1970 1687 1970 1602 1980 1269 1972 1266 1972 727 1985 729 2017"/>
                        </Shape>
                        <String CONTENT="came to a new camp, the inhabitants would pay close attention to my doings"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l27" HPOS="727" VPOS="2026" WIDTH="1769" HEIGHT="74" BASELINE="729 2076 2496 2065" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="729 2076 729 2091 1134 2100 1136 2100 1139 2100 1141 2100 1158 2089 1297 2089 1383 2100 1386 2100 1388 2100 1390 2100 1405 2089 1771 2097 1773 2097 1775 2097 1777 2097 1793 2084 1866 2095 1868 2095 1871 2095 1918 2084 1981 2095 1983 2095 2494 2082 2496 2065 2492 2037 2143 2026 2141 2026 2139 2026 2137 2026 2118 2037 1819 2028 1816 2028 1814 2028 1784 2039 740 2035 738 2035 736 2035 734 2035 734 2037 727 2041 729 2076"/>
                        </Shape>
                        <String CONTENT="for a few hours; then they would gradually drop off, and finally would be"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l28" HPOS="729" VPOS="2087" WIDTH="1767" HEIGHT="65" BASELINE="731 2136 2496 2126" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2136 731 2152 2494 2143 2496 2126 2492 2097 2143 2087 2141 2087 2139 2087 2111 2097 1933 2089 1931 2089 1784 2102 729 2102 731 2136"/>
                        </Shape>
                        <String CONTENT="interested only in barter. There were certainly exceptions, as Aiñanwaˊt, whom"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l29" HPOS="740" VPOS="2147" WIDTH="1754" HEIGHT="67" BASELINE="742 2197 2494 2190" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="742 2197 742 2214 2492 2203 2494 2190 2492 2160 2453 2147 2451 2147 2449 2147 2447 2147 2410 2158 2092 2147 2089 2147 2016 2158 1936 2147 1933 2147 1834 2160 1786 2149 1784 2149 1782 2149 1780 2149 1747 2160 1515 2149 1513 2149 1446 2160 1375 2149 1373 2149 1308 2162 1279 2152 1277 2152 1275 2152 1219 2162 1147 2152 1145 2152 1143 2152 1100 2162 1046 2152 1043 2152 968 2162 740 2154 742 2197"/>
                        </Shape>
                        <String CONTENT="I have mentioned, and a few others. In the Maritime villages, where the"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l30" HPOS="729" VPOS="2206" WIDTH="1770" HEIGHT="67" BASELINE="731 2258 2499 2247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="731 2258 731 2273 2496 2262 2499 2247 2494 2216 2165 2206 2163 2206 2161 2206 2137 2216 1795 2208 1793 2208 1790 2208 1788 2208 1775 2221 729 2221 731 2258"/>
                        </Shape>
                        <String CONTENT="inner rooms are much larger, and furnished with steadily burning lamps, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l31" HPOS="729" VPOS="2273" WIDTH="1770" HEIGHT="60" BASELINE="731 2314 2499 2305" TAGREFS="TYPE_4">
                        <Shape>
