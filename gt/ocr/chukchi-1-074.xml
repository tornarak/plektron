                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-074_r2" HPOS="730" VPOS="714" WIDTH="1778" HEIGHT="758" TAGREFS="TYPE_1">
