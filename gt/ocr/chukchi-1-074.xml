                <TextBlock ID="text_1-074" HPOS="706" VPOS="599" WIDTH="1774" HEIGHT="1780"><TextLine ID="mz_1-074_l1" HPOS="1287" VPOS="599" WIDTH="617" HEIGHT="54" BASELINE="1287 634 1904 634" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1893 599 1871 599 1850 599 1828 599 1806 599 1785 599 1763 599 1741 599 1720 599 1698 599 1676 599 1655 599 1633 599 1611 599 1590 599 1568 599 1546 599 1525 599 1503 599 1481 599 1460 599 1438 599 1416 599 1395 599 1373 599 1352 599 1330 599 1308 599 1287 612 1287 634 1287 653 1904 653 1904 634 1902 625 1893 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-074_l2" HPOS="730" VPOS="692" WIDTH="1748" HEIGHT="68" BASELINE="732 736 2478 729" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2462 701 2441 701 2419 701 2413 699 1313 692 1310 692 1308 692 1267 703 801 695 799 695 730 705 732 736 732 751 1891 760 1893 760 1954 749 2460 757 2462 757 2465 757 2467 757 2478 747 2478 729 2473 701 2462 699 2462 701"/>
                        </Shape>
                        <String CONTENT="1. Emyiˊrɪk (“in the extending [of the days]”). Loosely speaking, it corresponds to the first month"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l3" HPOS="830" VPOS="753" WIDTH="223" HEIGHT="46" BASELINE="830 781 1053 781" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="830 781 830 799 1053 799 1053 781 1053 753 830 753 830 781"/>
                        </Shape>
                        <String CONTENT="of the year."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l4" HPOS="739" VPOS="799" WIDTH="1355" HEIGHT="45" BASELINE="739 827 2094 827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="739 827 739 844 2092 842 2094 827 2092 799 739 799 739 827"/>
                        </Shape>
                        <String CONTENT="2. Ureˊtvik (“in the lengthening”). This corresponds to the second month."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l5" HPOS="734" VPOS="833" WIDTH="1746" HEIGHT="63" BASELINE="736 876 2480 870" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 876 736 896 2480 885 2480 870 2475 842 1317 833 1315 833 1313 833 1265 844 804 835 801 835 734 846 736 876"/>
                        </Shape>
                        <String CONTENT="3. Niwleˊwkɪ (“during [the days] growing long”). It lasts about six weeks, until the reindeer-dams"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l6" HPOS="830" VPOS="894" WIDTH="272" HEIGHT="45" BASELINE="830 922 1102 922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="830 922 830 935 1100 939 1102 922 1102 894 830 894 830 922"/>
                        </Shape>
                        <String CONTENT="begin to calve."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l7" HPOS="739" VPOS="928" WIDTH="1656" HEIGHT="63" BASELINE="741 972 2395 961" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 972 741 991 2042 991 2042 989 2131 978 2369 987 2372 987 2374 987 2395 974 2395 961 2391 928 1085 928 1083 928 1081 928 1079 928 1061 939 810 931 808 931 739 941 741 972"/>
                        </Shape>
                        <String CONTENT="4. Am-g̣roˊkĭ (“in the calving [time]”). This corresponds more or less to our term “spring.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l8" HPOS="786" VPOS="985" WIDTH="815" HEIGHT="47" BASELINE="786 1013 1601 1013" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="786 1013 786 1032 1601 1032 1601 1013 1601 985 786 985 786 1013"/>
                        </Shape>
                        <String CONTENT="5. Tur-eleˊtvuk (“in the new summer growing”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l9" HPOS="734" VPOS="1026" WIDTH="648" HEIGHT="50" BASELINE="736 1056 1382 1061" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1056 734 1071 1378 1076 1382 1061 1382 1030 736 1026 736 1056"/>
                        </Shape>
                        <String CONTENT="6. Kɪˊtkɪtɪk (“in the first summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l10" HPOS="747" VPOS="1076" WIDTH="646" HEIGHT="56" BASELINE="749 1108 1393 1104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="749 1108 749 1132 1391 1123 1393 1104 1388 1078 747 1076 749 1108"/>
                        </Shape>
                        <String CONTENT="7. Aˊnok (“in the second summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l11" HPOS="734" VPOS="1123" WIDTH="650" HEIGHT="48" BASELINE="734 1151 1384 1151" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="734 1151 734 1171 1384 1171 1384 1151 1384 1123 734 1123 734 1151"/>
                        </Shape>
                        <String CONTENT="8. Eˊlek (“in the middle summer”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l12" HPOS="780" VPOS="1167" WIDTH="766" HEIGHT="47" BASELINE="782 1199 1546 1195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="782 1199 782 1214 1546 1210 1546 1195 1540 1167 780 1169 782 1199"/>
                        </Shape>
                        <String CONTENT="9. Êh-ɪˊntok (“with the fresh air going out”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l13" HPOS="717" VPOS="1212" WIDTH="758" HEIGHT="52" BASELINE="719 1249 1475 1242" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="719 1249 719 1264 1475 1258 1475 1242 1468 1212 717 1216 719 1249"/>
                        </Shape>
                        <String CONTENT="10. Ñerg̣eˊrɪk (“with the first light frost”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l14" HPOS="715" VPOS="1260" WIDTH="714" HEIGHT="52" BASELINE="717 1294 1429 1290" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 1294 717 1312 1427 1307 1429 1290 1423 1260 715 1262 717 1294"/>
                        </Shape>
                        <String CONTENT="11. Tur-äᵋleˊtɪk (“with the new snow”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l15" HPOS="713" VPOS="1307" WIDTH="491" HEIGHT="50" BASELINE="715 1340 1204 1338" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1340 715 1357 1202 1355 1204 1338 1198 1307 713 1307 715 1340"/>
                        </Shape>
                        <String CONTENT="12. G̣ɪthaˊk (“in the fall”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l16" HPOS="717" VPOS="1348" WIDTH="572" HEIGHT="65" BASELINE="719 1390 1289 1383" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="719 1390 719 1403 754 1413 756 1413 758 1413 1289 1398 1289 1383 1284 1355 905 1348 903 1348 717 1359 719 1390"/>
                        </Shape>
                        <String CONTENT="13. Läᵋleˊñkɪ (“in the winter”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l17" HPOS="830" VPOS="1400" WIDTH="1520" HEIGHT="50" BASELINE="832 1433 2350 1429" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2341 1400 830 1403 832 1433 832 1450 2348 1446 2350 1429 2343 1400 2341 1400"/>
                        </Shape>
                        <String CONTENT="Yawrɪˊna means “in the next year,” and is applied to the beginning of the next fall."/>
                    </TextLine>
<TextLine ID="mz_1-074_l18" HPOS="810" VPOS="1472" WIDTH="1670" HEIGHT="65" BASELINE="812 1524 2480 1515" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="812 1524 812 1537 2478 1528 2480 1515 2475 1485 2309 1472 2307 1472 2304 1472 2272 1483 2242 1472 2239 1472 2237 1472 2138 1483 2105 1472 2103 1472 2101 1472 2099 1472 2047 1485 1837 1474 1834 1474 1832 1474 1787 1485 1756 1474 1754 1474 1752 1474 1640 1487 1289 1476 1287 1476 1284 1476 1282 1476 1269 1487 1161 1478 1159 1478 1157 1478 1154 1478 1141 1491 864 1491 825 1478 823 1478 821 1478 819 1478 817 1478 817 1481 810 1485 812 1524"/>
                        </Shape>
                        <String CONTENT="LANGUAGE. — The Chukchee language is rich in words, and pliant in"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l19" HPOS="706" VPOS="1537" WIDTH="1774" HEIGHT="69" BASELINE="708 1582 2480 1574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 1582 708 1595 1131 1606 1133 1606 1622 1593 2458 1600 2460 1600 2462 1600 2465 1600 2480 1589 2480 1574 2475 1545 1594 1537 1592 1537 1590 1537 1555 1548 1204 1539 1202 1539 1131 1550 719 1541 717 1541 715 1541 713 1541 713 1543 706 1548 708 1582"/>
                        </Shape>
                        <String CONTENT="forms; and the people are eloquent in their own way, but they do not like"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l20" HPOS="708" VPOS="1593" WIDTH="1770" HEIGHT="61" BASELINE="710 1639 2478 1632" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1639 710 1654 2475 1647 2478 1632 2473 1604 1947 1593 1945 1593 1882 1604 795 1597 793 1597 708 1608 710 1639"/>
                        </Shape>
                        <String CONTENT="to be bored with questions. The Reindeer men, who are in their houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l21" HPOS="710" VPOS="1654" WIDTH="1768" HEIGHT="73" BASELINE="713 1701 2478 1695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1701 713 1727 940 1717 2473 1717 2478 1695 2473 1667 2094 1654 2092 1654 1988 1665 1954 1654 1951 1654 1949 1654 1947 1654 1945 1654 1930 1665 1501 1656 1499 1656 1497 1656 1494 1656 1479 1669 1343 1669 1302 1656 1300 1656 1297 1656 1295 1656 1239 1669 823 1658 821 1658 710 1671 713 1701"/>
                        </Shape>
                        <String CONTENT="practically only when eating or sleeping, and keep in motion all the time,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l22" HPOS="708" VPOS="1717" WIDTH="1770" HEIGHT="67" BASELINE="710 1762 2478 1755" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 1762 710 1773 1271 1784 1274 1784 1414 1773 2478 1773 2478 1755 2473 1725 1341 1717 1339 1717 708 1729 710 1762"/>
                        </Shape>
                        <String CONTENT="were with difficulty persuaded to spend a few hours with me in the tent,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l23" HPOS="710" VPOS="1777" WIDTH="1765" HEIGHT="72" BASELINE="713 1825 2475 1814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1825 713 1849 862 1838 955 1846 957 1846 2473 1829 2475 1814 2471 1779 1276 1777 1274 1777 1271 1777 1269 1777 1254 1790 1152 1790 1066 1777 1063 1777 1061 1777 1022 1790 960 1779 957 1779 858 1790 741 1779 739 1779 736 1779 710 1790 713 1825"/>
                        </Shape>
                        <String CONTENT="giving explanations or dictating texts. Even the old men would say, “Bad"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l24" HPOS="706" VPOS="1833" WIDTH="1769" HEIGHT="65" BASELINE="708 1881 2475 1875" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 1881 708 1898 2473 1898 2475 1875 2471 1846 1902 1833 1899 1833 1897 1833 1895 1833 1878 1846 1772 1836 1769 1836 1486 1846 1429 1836 1427 1836 1339 1846 1300 1836 1297 1836 1295 1836 1191 1849 1167 1838 1165 1838 1163 1838 1107 1849 888 1838 886 1838 799 1849 734 1838 732 1838 730 1838 706 1849 708 1881"/>
                        </Shape>
                        <String CONTENT="thing, dotage,” and would prefer to stay outside. Most of them, moreover,"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l25" HPOS="706" VPOS="1892" WIDTH="1769" HEIGHT="65" BASELINE="708 1942 2475 1933" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 1942 708 1957 2473 1948 2475 1933 2469 1898 2198 1903 2159 1892 2157 1892 2155 1892 2153 1892 2120 1903 2088 1892 2086 1892 2084 1892 1962 1905 1936 1894 1934 1894 1932 1894 1930 1894 1908 1905 1854 1894 1852 1894 1850 1894 1828 1905 1793 1894 1791 1894 1789 1894 1702 1905 1616 1894 1614 1894 1611 1894 1585 1907 1453 1896 1451 1896 1386 1907 1258 1896 1256 1896 1254 1896 1252 1896 1237 1907 1068 1898 1066 1898 957 1909 905 1898 903 1898 706 1911 708 1942"/>
                        </Shape>
                        <String CONTENT="were quite unable to dictate. Even their curiosity is not lasting. When I"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l26" HPOS="706" VPOS="1952" WIDTH="1769" HEIGHT="65" BASELINE="708 2002 2475 1994" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 2002 708 2017 2473 2009 2475 1994 2471 1963 2086 1952 2084 1952 2025 1963 1668 1955 1666 1955 1581 1965 1248 1957 1245 1957 706 1970 708 2002"/>
                        </Shape>
                        <String CONTENT="came to a new camp, the inhabitants would pay close attention to my doings"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l27" HPOS="706" VPOS="2011" WIDTH="1769" HEIGHT="74" BASELINE="708 2061 2475 2050" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 2061 708 2076 1113 2085 1115 2085 1118 2085 1120 2085 1137 2074 1276 2074 1362 2085 1365 2085 1367 2085 1369 2085 1384 2074 1750 2082 1752 2082 1754 2082 1756 2082 1772 2069 1845 2080 1847 2080 1850 2080 1897 2069 1960 2080 1962 2080 2473 2067 2475 2050 2471 2022 2122 2011 2120 2011 2118 2011 2116 2011 2097 2022 1798 2013 1795 2013 1793 2013 1763 2024 719 2020 717 2020 715 2020 713 2020 713 2022 706 2026 708 2061"/>
                        </Shape>
                        <String CONTENT="for a few hours; then they would gradually drop off, and finally would be"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l28" HPOS="708" VPOS="2072" WIDTH="1767" HEIGHT="65" BASELINE="710 2121 2475 2111" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2121 710 2137 2473 2128 2475 2111 2471 2082 2122 2072 2120 2072 2118 2072 2090 2082 1912 2074 1910 2074 1763 2087 708 2087 710 2121"/>
                        </Shape>
                        <String CONTENT="interested only in barter. There were certainly exceptions, as Aiñanwaˊt, whom"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l29" HPOS="719" VPOS="2132" WIDTH="1754" HEIGHT="67" BASELINE="721 2182 2473 2175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="721 2182 721 2199 2471 2188 2473 2175 2471 2145 2432 2132 2430 2132 2428 2132 2426 2132 2389 2143 2071 2132 2068 2132 1995 2143 1915 2132 1912 2132 1813 2145 1765 2134 1763 2134 1761 2134 1759 2134 1726 2145 1494 2134 1492 2134 1425 2145 1354 2134 1352 2134 1287 2147 1258 2137 1256 2137 1254 2137 1198 2147 1126 2137 1124 2137 1122 2137 1079 2147 1025 2137 1022 2137 947 2147 719 2139 721 2182"/>
                        </Shape>
                        <String CONTENT="I have mentioned, and a few others. In the Maritime villages, where the"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l30" HPOS="708" VPOS="2191" WIDTH="1770" HEIGHT="67" BASELINE="710 2243 2478 2232" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2243 710 2258 2475 2247 2478 2232 2473 2201 2144 2191 2142 2191 2140 2191 2116 2201 1774 2193 1772 2193 1769 2193 1767 2193 1754 2206 708 2206 710 2243"/>
                        </Shape>
                        <String CONTENT="inner rooms are much larger, and furnished with steadily burning lamps, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l31" HPOS="708" VPOS="2258" WIDTH="1770" HEIGHT="60" BASELINE="710 2299 2478 2290" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="710 2299 710 2318 2475 2312 2478 2290 2473 2262 739 2258 736 2258 734 2258 708 2266 710 2299"/>
                        </Shape>
                        <String CONTENT="old people are more used to sitting indoors, and accordingly are more tractable"/>
                    </TextLine>

                    <TextLine ID="mz_1-074_l32" HPOS="708" VPOS="2327" WIDTH="979" HEIGHT="52" BASELINE="708 2357 1687 2357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="708 2357 708 2379 1687 2379 1687 2357 1687 2327 708 2327 708 2357"/>
                        </Shape>
                        <String CONTENT="and more useful for scientific investigation."/>
                    </TextLine>
</TextBlock></PrintSpace>
