                    <TextLine ID="mz_3-033_l1" HPOS="1030" VPOS="490" WIDTH="622" HEIGHT="51" BASELINE="1030 523 1652 523" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1032 504 1030 523 1030 541 1652 541 1652 523 1652 490 1044 490 1032 504"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l2" HPOS="2132" VPOS="486" WIDTH="83" HEIGHT="58" BASELINE="2134 529 2215 525" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2210 496 2190 492 2171 490 2155 486 2132 494 2134 529 2134 544 2215 544 2215 525 2213 496 2210 496"/>
                        </Shape>
                        <String CONTENT="567"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-033_r2" HPOS="456" VPOS="596" WIDTH="1782" HEIGHT="1044" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="456 596 2238 596 2238 1640 456 1640"/>
                    </Shape>
                    <TextLine ID="mz_3-033_l3" HPOS="450" VPOS="583" WIDTH="1779" HEIGHT="57" BASELINE="452 622 2229 619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="722 587 703 587 683 589 664 589 645 591 625 591 606 591 586 593 567 593 547 595 528 595 508 597 489 597 469 599 450 599 452 622 452 640 2227 636 2229 619 2225 593 1379 583 1377 583 1375 583 1334 593 722 585 722 587"/>
                        </Shape>
                        <String CONTENT="us reindeer-breeders it is a great sin to talk about voluntary death without executing one’s intentions:"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l4" HPOS="452" VPOS="642" WIDTH="1773" HEIGHT="43" BASELINE="452 667 2225 667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 667 452 683 2223 685 2225 667 2225 642 452 642 452 667"/>
                        </Shape>
                        <String CONTENT="therefore the next fall three of his sons died. Thus he brought a great misfortune upon himself by"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l5" HPOS="450" VPOS="687" WIDTH="1777" HEIGHT="45" BASELINE="452 716 2227 712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 716 452 732 2225 730 2227 712 2221 687 450 689 452 716"/>
                        </Shape>
                        <String CONTENT="talking about voluntary death. I sent him away, saying, ‘Do not stay here. We might become"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l6" HPOS="452" VPOS="733" WIDTH="1775" HEIGHT="45" BASELINE="454 763 2227 759" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="454 763 454 778 2225 776 2227 759 2221 733 452 735 454 763"/>
                        </Shape>
                        <String CONTENT="unlucky; we might lose our reindeer or have other misfortunes.’ Therefore we separated. Another"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l7" HPOS="450" VPOS="780" WIDTH="1777" HEIGHT="47" BASELINE="452 809 2227 806" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 809 452 827 2225 823 2227 806 2221 780 450 782 452 809"/>
                        </Shape>
                        <String CONTENT="year he died on the western tundra. And I say once more, when somebody speaks about voluntary"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l8" HPOS="454" VPOS="821" WIDTH="1775" HEIGHT="51" BASELINE="454 854 2229 854" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="454 854 454 872 2229 872 2229 854 2227 821 454 827 454 854"/>
                        </Shape>
                        <String CONTENT="death, the Outer Being hears his words. Should he say ever so little about it, he has to buy it off"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l9" HPOS="455" VPOS="876" WIDTH="1774" HEIGHT="43" BASELINE="455 901 2229 901" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="455 901 455 919 2229 919 2229 901 2229 876 455 876 455 901"/>
                        </Shape>
                        <String CONTENT="with heavy ransom. When his house-mates induce him to retract his intented promise, he gives"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l10" HPOS="452" VPOS="923" WIDTH="1779" HEIGHT="42" BASELINE="452 948 2231 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 948 452 965 2231 965 2231 948 2231 923 452 923 452 948"/>
                        </Shape>
                        <String CONTENT="away whatever is nearest to his heart. He gives it in ransom to the Outer Being, on account of a"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l11" HPOS="450" VPOS="960" WIDTH="1779" HEIGHT="52" BASELINE="452 997 2229 993" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 997 452 1012 2227 1010 2229 993 2225 967 473 960 471 960 469 960 450 967 452 997"/>
                        </Shape>
                        <String CONTENT="single word about voluntary death, saying, ‘This is my body, I have spoken foolishly.’ He gives"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l12" HPOS="450" VPOS="1012" WIDTH="1777" HEIGHT="47" BASELINE="452 1043 2227 1038" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 1043 452 1059 2225 1055 2227 1038 2221 1012 450 1016 452 1043"/>
                        </Shape>
                        <String CONTENT="as a sacrifice, on account of his word, something that he values most. This is because many who"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l13" HPOS="450" VPOS="1059" WIDTH="1779" HEIGHT="49" BASELINE="452 1088 2229 1084" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 1088 452 1108 2227 1108 2229 1084 2223 1059 450 1063 452 1088"/>
                        </Shape>
                        <String CONTENT="are sick ask for death and then recover, or are restrained by words of their friends and do not"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l14" HPOS="452" VPOS="1108" WIDTH="175" HEIGHT="48" BASELINE="454 1139 627 1133" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="454 1139 454 1152 613 1156 615 1156 617 1156 619 1156 619 1154 627 1147 627 1133 621 1108 452 1112 454 1139"/>
                        </Shape>
                        <String CONTENT="go away."/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l15" HPOS="559" VPOS="1151" WIDTH="1672" HEIGHT="46" BASELINE="561 1178 2231 1182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="561 1178 559 1193 2227 1197 2231 1182 2229 1154 561 1151 561 1178"/>
                        </Shape>
                        <String CONTENT="“I myself once spoke thus foolishly. It is not very long ago, when I was old enough to know"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l16" HPOS="452" VPOS="1201" WIDTH="1779" HEIGHT="43" BASELINE="454 1230 2231 1227" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="454 1230 454 1244 2229 1242 2231 1227 2227 1201 452 1201 454 1230"/>
                        </Shape>
                        <String CONTENT="better. I must say also, that, for the reindeer-breeder, the wolf and the evil spirit are a pair. One"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l17" HPOS="452" VPOS="1240" WIDTH="1779" HEIGHT="53" BASELINE="454 1277 2231 1273" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="454 1277 454 1293 2229 1293 2231 1273 2227 1248 510 1240 508 1240 452 1250 454 1277"/>
                        </Shape>
                        <String CONTENT="spring I could not keep my herd together. It was at the end of spring. About that time the earth"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l18" HPOS="457" VPOS="1291" WIDTH="1776" HEIGHT="47" BASELINE="459 1322 2233 1318" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="459 1322 459 1338 2231 1334 2233 1318 2229 1293 457 1291 459 1322"/>
                        </Shape>
                        <String CONTENT="begins to free itself from snow, and the reindeer like to scatter in all directions. The reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l19" HPOS="455" VPOS="1334" WIDTH="1774" HEIGHT="48" BASELINE="457 1365 2229 1369" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1365 455 1379 2225 1382 2229 1369 2227 1340 457 1334 457 1365"/>
                        </Shape>
                        <String CONTENT="breeders call this time ‘greedy fuss’ (čipčiˊñɪlet). This time is terrible for all. On account of my"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l20" HPOS="455" VPOS="1382" WIDTH="1776" HEIGHT="57" BASELINE="457 1410 2231 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1410 455 1427 1781 1439 1783 1439 2229 1429 2231 1416 2229 1388 457 1382 457 1410"/>
                        </Shape>
                        <String CONTENT="inability (to manage the reindeer), I spoke thus foolishly. When I was younger, I could assuage"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l21" HPOS="455" VPOS="1431" WIDTH="1776" HEIGHT="45" BASELINE="457 1458 2231 1462" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1458 455 1472 2227 1476 2231 1462 2229 1435 457 1431 457 1458"/>
                        </Shape>
                        <String CONTENT="my anger by outrunning the reindeer. That time I spoke foolishly because I felt my weakness:"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l22" HPOS="457" VPOS="1482" WIDTH="1774" HEIGHT="43" BASELINE="457 1507 2231 1507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1507 457 1525 2231 1525 2231 1507 2231 1484 457 1482 457 1507"/>
                        </Shape>
                        <String CONTENT="‘Here wolves, catch them and eat them!’ After a while I gave a ransom for these words, —"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l23" HPOS="455" VPOS="1529" WIDTH="1778" HEIGHT="44" BASELINE="455 1554 2233 1554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="455 1554 455 1573 2231 1573 2233 1554 2231 1529 455 1529 455 1554"/>
                        </Shape>
                        <String CONTENT="slaughtered some reindeer, and I also slaughtered one of my driving-reindeer that was very dear"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l24" HPOS="455" VPOS="1566" WIDTH="1137" HEIGHT="58" BASELINE="457 1603 1592 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1603 457 1616 951 1624 952 1624 1592 1610 1592 1595 1586 1566 455 1577 457 1603"/>
                        </Shape>
                        <String CONTENT="to me. It was the first time that I spoke such foolish words.”¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-033_r3" HPOS="456" VPOS="1665" WIDTH="1782" HEIGHT="322" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="456 1665 2238 1665 2238 1987 456 1987"/>
                    </Shape>
                    <TextLine ID="mz_3-033_l25" HPOS="567" VPOS="1673" WIDTH="1668" HEIGHT="66" BASELINE="569 1714 2235 1718" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="569 1714 567 1724 592 1737 594 1737 596 1739 789 1739 789 1737 791 1737 793 1737 804 1727 837 1737 839 1737 841 1737 1153 1727 1179 1737 1180 1737 1182 1737 1272 1727 1286 1737 1288 1737 1290 1737 1403 1739 1405 1739 1407 1739 1447 1729 1469 1739 1471 1739 1473 1739 1541 1729 1617 1739 1619 1739 2233 1727 2235 1718 2235 1688 2194 1675 2192 1675 2190 1675 2188 1675 2151 1686 2124 1675 2122 1675 2120 1675 2040 1686 1950 1675 1806 1675 1804 1675 1802 1675 1800 1675 1785 1686 1697 1675 1695 1675 1637 1686 1613 1675 1611 1675 1609 1675 1551 1686 1492 1675 1490 1675 1488 1675 1457 1686 1225 1686 1208 1673 1206 1673 1204 1673 1202 1673 1200 1673 1163 1686 952 1686 935 1673 933 1673 931 1673 929 1673 927 1673 902 1685 859 1673 857 1673 855 1673 853 1673 826 1685 569 1677 569 1714"/>
                        </Shape>
                        <String CONTENT="Voluntary death occurs also among the Maritime Chukchee and the"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l26" HPOS="455" VPOS="1733" WIDTH="1778" HEIGHT="59" BASELINE="457 1778 2233 1774" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1778 457 1792 2231 1788 2233 1774 2229 1747 2143 1747 2124 1733 2122 1733 2120 1733 2118 1733 2048 1745 1972 1733 1970 1733 1968 1733 1939 1747 1789 1747 1767 1733 1765 1733 1763 1733 1761 1733 1683 1743 1642 1733 1640 1733 1638 1733 1637 1733 1635 1733 1619 1745 1574 1733 1572 1733 1570 1733 1568 1733 1539 1747 1325 1747 1256 1735 1255 1735 1208 1745 1153 1735 1151 1735 1149 1735 1147 1735 1128 1749 982 1749 945 1735 943 1735 941 1735 939 1735 904 1747 874 1735 873 1735 871 1735 787 1747 761 1735 760 1735 758 1735 672 1747 567 1735 565 1735 455 1741 457 1778"/>
                        </Shape>
                        <String CONTENT="Eskimo, and with the same details as among the Reindeer people. I know"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l27" HPOS="455" VPOS="1796" WIDTH="1776" HEIGHT="56" BASELINE="457 1837 2231 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1837 457 1850 2227 1852 2231 1833 2227 1807 1779 1796 1777 1796 1658 1805 1596 1796 1594 1796 1533 1805 1481 1796 1479 1796 1430 1805 1393 1796 1391 1796 1389 1796 1387 1796 1338 1807 1280 1798 1278 1798 1210 1807 978 1798 976 1798 974 1798 972 1798 956 1809 802 1809 721 1798 719 1798 641 1807 588 1798 586 1798 539 1807 493 1798 491 1798 489 1798 455 1809 457 1837"/>
                        </Shape>
                        <String CONTENT="of only a few cases, however. Thus, in the village of Euˊnmun, a man"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l28" HPOS="455" VPOS="1858" WIDTH="1780" HEIGHT="53" BASELINE="457 1891 2235 1895" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 1891 455 1907 2231 1911 2235 1895 2231 1858 457 1862 457 1891"/>
                        </Shape>
                        <String CONTENT="of middle age, who suffered from an abscess in his side, had himself strangled"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l29" HPOS="457" VPOS="1916" WIDTH="301" HEIGHT="63" BASELINE="459 1953 758 1957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="459 1953 457 1967 471 1977 473 1977 475 1977 477 1977 578 1967 701 1979 703 1979 756 1967 758 1957 756 1930 561 1928 551 1918 551 1916 549 1916 547 1916 545 1916 459 1924 459 1953"/>
                        </Shape>
                        <String CONTENT="with a rope."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-033_r4" HPOS="456" VPOS="1987" WIDTH="1782" HEIGHT="176" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="456 1987 2238 1987 2238 2163 456 2163"/>
                    </Shape>
                    <TextLine ID="mz_3-033_l30" HPOS="565" VPOS="1973" WIDTH="1672" HEIGHT="58" BASELINE="567 2016 2237 2012" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="567 2016 567 2031 2235 2029 2237 2012 2233 1985 2171 1973 2169 1973 2167 1973 2139 1985 1902 1985 1888 1973 1886 1973 1884 1973 1882 1973 1831 1985 1707 1985 1693 1973 1691 1973 1689 1973 1687 1973 1685 1973 1652 1983 1638 1973 1637 1973 1635 1973 1543 1973 1541 1973 1457 1983 1401 1973 1399 1973 1397 1973 1370 1985 1280 1975 1182 1975 1180 1975 1179 1975 1177 1975 1163 1985 1122 1975 1120 1975 1118 1975 1116 1975 1085 1985 1040 1975 1038 1975 1036 1975 1007 1985 986 1975 984 1975 982 1975 873 1985 565 1981 567 2016"/>
                        </Shape>
                        <String CONTENT="In the year 1898, in the Eskimo village Uñiˊsak, an old man was shot"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l31" HPOS="455" VPOS="2035" WIDTH="1782" HEIGHT="55" BASELINE="457 2076 2237 2072" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 2076 457 2090 2235 2088 2237 2072 2229 2035 2188 2045 1459 2035 1457 2035 1385 2045 1350 2035 1348 2035 1346 2035 1344 2035 1313 2047 982 2037 980 2037 978 2037 976 2037 960 2049 611 2049 537 2037 535 2037 533 2037 531 2037 518 2047 500 2037 498 2037 496 2037 494 2037 455 2049 457 2076"/>
                        </Shape>
                        <String CONTENT="at his own request. He was shot from behind. This is the only case of"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l32" HPOS="457" VPOS="2094" WIDTH="1778" HEIGHT="58" BASELINE="459 2137 2235 2133" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="459 2137 459 2152 2233 2150 2235 2133 2233 2104 2215 2094 2213 2094 2211 2094 2210 2094 2208 2094 2184 2104 2161 2094 2159 2094 2157 2094 1670 2104 1642 2094 1640 2094 1638 2094 1549 2104 1522 2094 1520 2094 1518 2094 1516 2094 1475 2104 1444 2094 1442 2094 1440 2094 1383 2104 1352 2094 1350 2094 1348 2094 1346 2094 1344 2094 1327 2106 1229 2096 1227 2096 1179 2106 705 2096 703 2096 623 2106 516 2096 514 2096 457 2107 459 2137"/>
                        </Shape>
                        <String CONTENT="voluntary death known to me, where the death-stroke was dealt from behind."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_3-033_r5" HPOS="456" VPOS="2163" WIDTH="1782" HEIGHT="850" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="456 2163 2238 2163 2238 3013 456 3013"/>
                    </Shape>
                    <TextLine ID="mz_3-033_l33" HPOS="570" VPOS="2154" WIDTH="1661" HEIGHT="65" BASELINE="572 2195 2231 2199" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="572 2195 570 2207 843 2219 845 2219 2229 2217 2231 2199 2229 2170 2161 2156 2159 2156 2106 2166 1925 2156 1923 2156 1921 2156 1870 2168 1806 2156 1804 2156 1802 2156 1800 2156 1785 2168 1638 2168 1547 2156 1545 2156 1543 2156 1522 2168 1502 2156 1500 2156 1498 2156 1496 2156 1069 2166 993 2154 991 2154 989 2154 988 2154 974 2166 869 2166 851 2154 849 2154 847 2154 760 2154 758 2154 756 2154 732 2166 676 2154 674 2154 672 2154 670 2154 652 2166 637 2154 635 2154 633 2154 631 2154 572 2154 572 2195"/>
                        </Shape>
                        <String CONTENT="W. H. Dall, quoting a man named Noakum, a native of Plover Bay,"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l34" HPOS="455" VPOS="2213" WIDTH="1780" HEIGHT="58" BASELINE="457 2256 2235 2252" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 2256 457 2271 2233 2269 2235 2252 2231 2224 2165 2213 2163 2213 2161 2213 2135 2222 1886 2213 1884 2213 1882 2213 1839 2224 1580 2224 1549 2213 1547 2213 1545 2213 1543 2213 1504 2222 1426 2213 1424 2213 1370 2222 1348 2213 1346 2213 1344 2213 1342 2213 1340 2213 1321 2224 1272 2215 1270 2215 1268 2215 1243 2224 798 2215 797 2215 795 2215 761 2224 707 2215 705 2215 703 2215 660 2224 479 2215 477 2215 475 2215 473 2215 455 2222 457 2256"/>
                        </Shape>
                        <String CONTENT="describes the killing of old men in the following manner: “Old and useless"/>
                    </TextLine>

                    <TextLine ID="mz_3-033_l35" HPOS="455" VPOS="2273" WIDTH="1780" HEIGHT="64" BASELINE="457 2318 2235 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 2318 457 2337 2233 2330 2235 2312 2231 2285 2145 2273 2143 2273 2069 2283 2044 2273 2042 2273 2040 2273 2038 2273 2036 2273 2019 2285 1882 2285 1855 2273 1853 2273 1851 2273 1785 2283 1757 2273 1755 2273 1753 2273 1752 2273 1711 2283 1677 2273 1676 2273 1674 2273 1596 2285 1488 2275 1486 2275 1424 2285 1393 2275 1391 2275 1389 2275 1387 2275 1350 2285 1313 2275 1311 2275 1309 2275 1307 2275 1305 2275 1290 2287 1108 2287 1054 2275 1052 2275 1050 2275 1048 2275 1030 2287 646 2277 645 2277 643 2277 613 2287 565 2277 563 2277 455 2289 457 2318"/>
                        </Shape>
                        <String CONTENT="people frequently ask to be put to death. The victim is taken to the place"/>
                    </TextLine>

