                        <Shape>
                            <Polygon POINTS="754 2435 754 2453 2519 2453 2521 2435 2517 2401 2289 2405 2203 2394 2200 2394 2142 2405 2109 2394 2107 2394 2105 2394 2103 2394 2081 2405 1986 2394 1984 2394 1982 2394 1938 2405 1863 2394 1860 2394 1858 2394 1856 2394 1841 2405 1808 2394 1806 2394 1804 2394 1802 2394 1763 2405 1735 2394 1733 2394 1731 2394 1635 2405 1553 2394 1551 2394 1549 2394 1525 2407 1319 2407 1282 2394 1280 2394 1278 2394 1178 2405 1079 2394 1076 2394 1074 2394 1048 2407 754 2407 754 2435"/>
                        </Shape>
                        <String CONTENT="on account of the unclean ways of the animal that yields it. They asserted"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l32" HPOS="749" VPOS="2461" WIDTH="1770" HEIGHT="54" BASELINE="752 2494 2519 2500" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 2494 749 2507 2514 2515 2519 2500 2517 2468 752 2461 752 2494"/>
                        </Shape>
                        <String CONTENT="also that beef has a peculiar and unpleasant odor, similar to that of cow-dung,"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l33" HPOS="752" VPOS="2526" WIDTH="1769" HEIGHT="48" BASELINE="752 2557 2521 2557" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 2557 752 2574 2521 2574 2521 2557 2521 2526 752 2526 752 2557"/>
                        </Shape>
                        <String CONTENT="and some of them even refused to enter the room where beef was being cooked."/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l34" HPOS="749" VPOS="2576" WIDTH="1772" HEIGHT="56" BASELINE="752 2617 2521 2611" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 2617 752 2632 2519 2626 2521 2611 2517 2583 767 2576 765 2576 762 2576 760 2576 749 2583 752 2617"/>
                        </Shape>
                        <String CONTENT="On the other hand, when we objected to the odor of seal-meat, they, in their"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l35" HPOS="749" VPOS="2632" WIDTH="1774" HEIGHT="61" BASELINE="752 2676 2523 2671" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 2676 752 2693 2521 2689 2523 2671 2519 2643 1750 2632 1748 2632 1629 2643 973 2634 970 2634 749 2645 752 2676"/>
                        </Shape>
                        <String CONTENT="turn, would say, “The seal is quite clean. It washes itself continually in clean"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l36" HPOS="749" VPOS="2695" WIDTH="1768" HEIGHT="59" BASELINE="752 2736 2517 2732" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 2736 752 2754 2514 2749 2517 2732 2512 2695 940 2695 938 2695 749 2706 752 2736"/>
                        </Shape>
                        <String CONTENT="water. Why do you not object rather to the meat of your own filthy animals?”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-062_r12" HPOS="754" VPOS="2759" WIDTH="1778" HEIGHT="299" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="754 2759 2532 2759 2532 3058 754 3058"/>
                    </Shape>
                    <TextLine ID="mz_1-062_l37" HPOS="858" VPOS="2764" WIDTH="1667" HEIGHT="50" BASELINE="860 2799 2525 2795" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="860 2799 860 2814 2523 2810 2525 2795 2521 2764 858 2764 860 2799"/>
                        </Shape>
                        <String CONTENT="DISEASES. — Contagious diseases have repeatedly made their appearance"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l38" HPOS="747" VPOS="2823" WIDTH="1776" HEIGHT="56" BASELINE="749 2857 2523 2853" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="749 2857 749 2870 2473 2879 2475 2879 2478 2879 2523 2866 2523 2853 2517 2823 747 2825 749 2857"/>
                        </Shape>
                        <String CONTENT="among the Chukchee. Small-pox has several times ravaged the population"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l39" HPOS="754" VPOS="2886" WIDTH="1767" HEIGHT="47" BASELINE="754 2916 2521 2916" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="754 2916 754 2933 2519 2933 2521 2916 2519 2886 754 2886 754 2916"/>
                        </Shape>
                        <String CONTENT="of northeastern Siberia. Its latest outbreaks were on the Lower Kolyma in"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l40" HPOS="756" VPOS="2931" WIDTH="1765" HEIGHT="63" BASELINE="758 2979 2521 2974" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="758 2979 758 2994 2519 2990 2521 2974 2517 2940 2382 2931 2380 2931 2322 2942 2296 2931 2294 2931 2291 2931 2289 2931 2246 2942 2194 2931 2192 2931 2038 2942 2008 2931 2006 2931 2003 2931 2001 2931 1999 2931 1984 2942 1932 2931 1930 2931 1928 2931 1897 2942 1871 2931 1869 2931 1867 2931 1795 2942 1765 2931 1763 2931 1761 2931 1698 2942 1640 2931 1637 2931 1635 2931 1598 2944 1345 2933 1343 2933 1341 2933 1319 2944 1297 2933 1295 2933 1172 2933 1170 2933 1167 2933 1165 2933 1152 2944 1096 2933 1094 2933 1007 2944 975 2933 973 2933 970 2933 869 2944 793 2933 791 2933 788 2933 756 2944 758 2979"/>
                        </Shape>
                        <String CONTENT="1884, and on the Middle Kolyma in 1889; though the latter epidemic affected"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l41" HPOS="749" VPOS="3000" WIDTH="1720" HEIGHT="50" BASELINE="752 3031 2469 3035" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 3031 749 3046 2465 3050 2469 3035 2467 3005 752 3000 752 3031"/>
                        </Shape>
                        <String CONTENT="chiefly the Russians and the Yakut, and had little effect on the Chukchee."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-062_r13" HPOS="754" VPOS="3058" WIDTH="1778" HEIGHT="187" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="754 3058 2532 3058 2532 3245 754 3245"/>
                    </Shape>
                    <TextLine ID="mz_1-062_l42" HPOS="862" VPOS="3061" WIDTH="1659" HEIGHT="52" BASELINE="862 3096 2521 3096" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2517 3063 862 3061 862 3096 862 3113 2521 3113 2521 3096 2521 3087 2517 3063"/>
                        </Shape>
                        <String CONTENT="In 1899 an epidemic of measles, brought from Vladivostok by a Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l43" HPOS="749" VPOS="3122" WIDTH="1772" HEIGHT="52" BASELINE="752 3156 2521 3150" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="752 3156 752 3174 2521 3167 2521 3150 2514 3122 749 3126 752 3156"/>
                        </Shape>
                        <String CONTENT="trader, spread northwards, and in the summer of 1900 reached the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l44" HPOS="752" VPOS="3176" WIDTH="1767" HEIGHT="69" BASELINE="754 3215 2519 3210" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="754 3215 754 3232 847 3245 849 3245 927 3234 1399 3245 1401 3245 1637 3232 2501 3243 2504 3243 2506 3243 2508 3243 2519 3232 2519 3210 2514 3184 782 3176 780 3176 778 3176 752 3184 754 3215"/>
                        </Shape>
                        <String CONTENT="villages and camps. Everywhere its effects were most disastrous, especially"/>
                    </TextLine>
</TextBlock>
