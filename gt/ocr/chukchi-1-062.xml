                        <Shape>
                            <Polygon POINTS="775 2450 775 2468 2540 2468 2542 2450 2538 2416 2310 2420 2224 2409 2221 2409 2163 2420 2130 2409 2128 2409 2126 2409 2124 2409 2102 2420 2007 2409 2005 2409 2003 2409 1959 2420 1884 2409 1881 2409 1879 2409 1877 2409 1862 2420 1829 2409 1827 2409 1825 2409 1823 2409 1784 2420 1756 2409 1754 2409 1752 2409 1656 2420 1574 2409 1572 2409 1570 2409 1546 2422 1340 2422 1303 2409 1301 2409 1299 2409 1199 2420 1100 2409 1097 2409 1095 2409 1069 2422 775 2422 775 2450"/>
                        </Shape>
                        <String CONTENT="on account of the unclean ways of the animal that yields it. They asserted"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l32" HPOS="770" VPOS="2476" WIDTH="1770" HEIGHT="54" BASELINE="773 2509 2540 2515" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 2509 770 2522 2535 2530 2540 2515 2538 2483 773 2476 773 2509"/>
                        </Shape>
                        <String CONTENT="also that beef has a peculiar and unpleasant odor, similar to that of cow-dung,"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l33" HPOS="773" VPOS="2541" WIDTH="1769" HEIGHT="48" BASELINE="773 2572 2542 2572" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 2572 773 2589 2542 2589 2542 2572 2542 2541 773 2541 773 2572"/>
                        </Shape>
                        <String CONTENT="and some of them even refused to enter the room where beef was being cooked."/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l34" HPOS="770" VPOS="2591" WIDTH="1772" HEIGHT="56" BASELINE="773 2632 2542 2626" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 2632 773 2647 2540 2641 2542 2626 2538 2598 788 2591 786 2591 783 2591 781 2591 770 2598 773 2632"/>
                        </Shape>
                        <String CONTENT="On the other hand, when we objected to the odor of seal-meat, they, in their"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l35" HPOS="770" VPOS="2647" WIDTH="1774" HEIGHT="61" BASELINE="773 2691 2544 2686" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 2691 773 2708 2542 2704 2544 2686 2540 2658 1771 2647 1769 2647 1650 2658 994 2649 991 2649 770 2660 773 2691"/>
                        </Shape>
                        <String CONTENT="turn, would say, “The seal is quite clean. It washes itself continually in clean"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l36" HPOS="770" VPOS="2710" WIDTH="1768" HEIGHT="59" BASELINE="773 2751 2538 2747" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 2751 773 2769 2535 2764 2538 2747 2533 2710 961 2710 959 2710 770 2721 773 2751"/>
                        </Shape>
                        <String CONTENT="water. Why do you not object rather to the meat of your own filthy animals?”"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-062_r12" HPOS="775" VPOS="2774" WIDTH="1778" HEIGHT="299" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="775 2774 2553 2774 2553 3073 775 3073"/>
                    </Shape>
                    <TextLine ID="mz_1-062_l37" HPOS="879" VPOS="2779" WIDTH="1667" HEIGHT="50" BASELINE="881 2814 2546 2810" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="881 2814 881 2829 2544 2825 2546 2810 2542 2779 879 2779 881 2814"/>
                        </Shape>
                        <String CONTENT="DISEASES. — Contagious diseases have repeatedly made their appearance"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l38" HPOS="768" VPOS="2838" WIDTH="1776" HEIGHT="56" BASELINE="770 2872 2544 2868" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="770 2872 770 2885 2494 2894 2496 2894 2499 2894 2544 2881 2544 2868 2538 2838 768 2840 770 2872"/>
                        </Shape>
                        <String CONTENT="among the Chukchee. Small-pox has several times ravaged the population"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l39" HPOS="775" VPOS="2901" WIDTH="1767" HEIGHT="47" BASELINE="775 2931 2542 2931" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="775 2931 775 2948 2540 2948 2542 2931 2540 2901 775 2901 775 2931"/>
                        </Shape>
                        <String CONTENT="of northeastern Siberia. Its latest outbreaks were on the Lower Kolyma in"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l40" HPOS="777" VPOS="2946" WIDTH="1765" HEIGHT="63" BASELINE="779 2994 2542 2989" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="779 2994 779 3009 2540 3005 2542 2989 2538 2955 2403 2946 2401 2946 2343 2957 2317 2946 2315 2946 2312 2946 2310 2946 2267 2957 2215 2946 2213 2946 2059 2957 2029 2946 2027 2946 2024 2946 2022 2946 2020 2946 2005 2957 1953 2946 1951 2946 1949 2946 1918 2957 1892 2946 1890 2946 1888 2946 1816 2957 1786 2946 1784 2946 1782 2946 1719 2957 1661 2946 1658 2946 1656 2946 1619 2959 1366 2948 1364 2948 1362 2948 1340 2959 1318 2948 1316 2948 1193 2948 1191 2948 1188 2948 1186 2948 1173 2959 1117 2948 1115 2948 1028 2959 996 2948 994 2948 991 2948 890 2959 814 2948 812 2948 809 2948 777 2959 779 2994"/>
                        </Shape>
                        <String CONTENT="1884, and on the Middle Kolyma in 1889; though the latter epidemic affected"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l41" HPOS="770" VPOS="3015" WIDTH="1720" HEIGHT="50" BASELINE="773 3046 2490 3050" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 3046 770 3061 2486 3065 2490 3050 2488 3020 773 3015 773 3046"/>
                        </Shape>
                        <String CONTENT="chiefly the Russians and the Yakut, and had little effect on the Chukchee."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-062_r13" HPOS="775" VPOS="3073" WIDTH="1778" HEIGHT="187" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="775 3073 2553 3073 2553 3260 775 3260"/>
                    </Shape>
                    <TextLine ID="mz_1-062_l42" HPOS="883" VPOS="3076" WIDTH="1659" HEIGHT="52" BASELINE="883 3111 2542 3111" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2538 3078 883 3076 883 3111 883 3128 2542 3128 2542 3111 2542 3102 2538 3078"/>
                        </Shape>
                        <String CONTENT="In 1899 an epidemic of measles, brought from Vladivostok by a Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l43" HPOS="770" VPOS="3137" WIDTH="1772" HEIGHT="52" BASELINE="773 3171 2542 3165" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="773 3171 773 3189 2542 3182 2542 3165 2535 3137 770 3141 773 3171"/>
                        </Shape>
                        <String CONTENT="trader, spread northwards, and in the summer of 1900 reached the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-062_l44" HPOS="773" VPOS="3191" WIDTH="1767" HEIGHT="69" BASELINE="775 3230 2540 3225" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="775 3230 775 3247 868 3260 870 3260 948 3249 1420 3260 1422 3260 1658 3247 2522 3258 2525 3258 2527 3258 2529 3258 2540 3247 2540 3225 2535 3199 803 3191 801 3191 799 3191 773 3199 775 3230"/>
                        </Shape>
                        <String CONTENT="villages and camps. Everywhere its effects were most disastrous, especially"/>
                    </TextLine>
</TextBlock>
