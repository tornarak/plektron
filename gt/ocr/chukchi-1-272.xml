                    </TextLine>

                    <TextLine ID="mz_1-272_l16" HPOS="635" VPOS="1506" WIDTH="1776" HEIGHT="46" BASELINE="635 1535 2411 1535" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1535 635 1552 2411 1552 2411 1535 2411 1506 635 1506 635 1535"/>
                        </Shape>
                        <String CONTENT="chee out of American steel files of small size (cf. Fig. 132, a). A sheath or"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l17" HPOS="635" VPOS="1563" WIDTH="1773" HEIGHT="50" BASELINE="635 1595 2408 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1595 635 1613 2408 1613 2408 1595 2406 1563 635 1563 635 1595"/>
                        </Shape>
