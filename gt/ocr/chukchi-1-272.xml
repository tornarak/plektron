                        </Shape>
                        <String CONTENT="about five years old, has his own eating-knife. Often these knives are simply"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l9" HPOS="630" VPOS="1071" WIDTH="1549" HEIGHT="63" BASELINE="633 1119 2179 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 1119 633 1134 2177 1130 2179 1112 2174 1084 1876 1084 1850 1071 1847 1071 1845 1071 1843 1071 1815 1082 1782 1071 1780 1071 1778 1071 1709 1082 1683 1071 1681 1071 1679 1071 1676 1071 1637 1084 1523 1073 1520 1073 1462 1084 1438 1073 1436 1073 1434 1073 1356 1084 1317 1073 1315 1073 1313 1073 1310 1073 1308 1073 1295 1086 1209 1086 1165 1073 1163 1073 1161 1073 1068 1086 723 1076 721 1076 630 1089 633 1119"/>
                        </Shape>
                        <String CONTENT="small bits of iron, rudely set in a handle, and unfit for many uses."/>
                    </TextLine>
<TextLine ID="mz_1-272_l10" HPOS="743" VPOS="1130" WIDTH="1665" HEIGHT="63" BASELINE="745 1180 2408 1173" TAGREFS="TYPE_4">
                        <Shape>
