                            <Polygon POINTS="633 760 633 777 2404 770 2406 753 2402 723 1830 712 1828 712 1826 712 1824 712 1804 723 1267 714 1265 714 1191 727 630 727 633 760"/>
                        </Shape>
                        <String CONTENT="knife serves for ordinary cutting, or is used by reindeer herdsmen for slaughtering-"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l4" HPOS="630" VPOS="777" WIDTH="1778" HEIGHT="65" BASELINE="633 822 2408 814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="633 822 633 842 2406 829 2408 814 2404 781 1213 777 1211 777 630 790 633 822"/>
                        </Shape>
                        <String CONTENT="purposes. It is also used for carving and cutting meat at meals. The kind"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l5" HPOS="633" VPOS="833" WIDTH="1775" HEIGHT="61" BASELINE="635 879 2408 874" TAGREFS="TYPE_4">
                        <Shape>
