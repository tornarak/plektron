                    </TextLine>

                    <TextLine ID="mz_1-272_l23" HPOS="637" VPOS="1924" WIDTH="901" HEIGHT="48" BASELINE="637 1952 1538 1952" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="637 1952 637 1970 1536 1972 1538 1952 1538 1924 637 1924 637 1952"/>
                        </Shape>
