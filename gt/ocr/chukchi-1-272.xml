                        </Shape>
                        <String CONTENT="of meat usually consumed by the Reindeer and by the Maritime Chukchee is"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l6" HPOS="635" VPOS="896" WIDTH="1503" HEIGHT="58" BASELINE="635 937 2138 937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 937 635 954 2138 954 2138 937 2138 907 2103 896 2101 896 2014 896 2012 896 2010 896 2008 896 1995 907 1653 896 1650 896 1648 896 1646 896 1627 909 1442 909 1365 896 1362 896 1271 907 1219 896 1217 896 1215 896 1213 896 1196 907 1141 896 1139 896 1063 907 1033 896 1031 896 1029 896 1027 896 1025 896 1007 907 979 896 977 896 975 896 973 896 970 896 953 907 879 896 877 896 875 896 838 907 810 896 808 896 806 896 804 896 801 896 782 909 635 909 635 937"/>
                        </Shape>
                        <String CONTENT="so tough that it is quite impossible to get along without a knife."/>
                    </TextLine>
<TextLine ID="mz_1-272_l7" HPOS="739" VPOS="963" WIDTH="1669" HEIGHT="50" BASELINE="741 996 2408 991" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 996 741 1013 2406 1009 2408 991 2404 963 739 963 741 996"/>
                        </Shape>
                        <String CONTENT="Every adult member of a Chukchee family, and each child after he is"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l8" HPOS="630" VPOS="1015" WIDTH="1776" HEIGHT="61" BASELINE="633 1058 2406 1052" TAGREFS="TYPE_4">
                        <Shape>
