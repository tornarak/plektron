<TextLine ID="mz_1-272_l19" HPOS="741" VPOS="1684" WIDTH="1670" HEIGHT="48" BASELINE="741 1717 2411 1717" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="741 1717 741 1732 2411 1732 2411 1717 2411 1686 741 1684 741 1717"/>
                        </Shape>
