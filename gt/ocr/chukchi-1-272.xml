<TextLine ID="mz_1-272_l24" HPOS="747" VPOS="1976" WIDTH="1668" HEIGHT="57" BASELINE="747 2015 2415 2015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="747 2015 747 2033 2413 2033 2415 2015 2413 1985 747 1976 747 2015"/>
                        </Shape>
