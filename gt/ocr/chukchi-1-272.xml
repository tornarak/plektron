                        </Shape>
                        <String CONTENT="place. The handle is often notched to afford a better grip. Most of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l15" HPOS="635" VPOS="1444" WIDTH="1773" HEIGHT="50" BASELINE="635 1474 2408 1474" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1474 635 1494 2408 1494 2408 1474 2408 1446 635 1444 635 1474"/>
                        </Shape>
