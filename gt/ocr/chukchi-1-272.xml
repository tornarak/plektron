                    <TextLine ID="mz_1-272_l20" HPOS="635" VPOS="1740" WIDTH="1776" HEIGHT="52" BASELINE="635 1777 2411 1777" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1777 635 1792 2411 1792 2411 1777 2411 1747 635 1740 635 1777"/>
                        </Shape>
                        <String CONTENT="by merchants are the most convenient for the Reindeer Chukchee, because"/>
                    </TextLine>

