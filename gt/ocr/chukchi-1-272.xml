                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-272_l3" HPOS="630" VPOS="712" WIDTH="1776" HEIGHT="65" BASELINE="633 760 2406 753" TAGREFS="TYPE_4">
