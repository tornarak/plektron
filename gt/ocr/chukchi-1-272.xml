                        </Shape>
                        <String CONTENT="one is called rêˊččêt-vaˊlᴇ (“belt-knife”). The blade has a stout back and a"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l12" HPOS="633" VPOS="1264" WIDTH="1773" HEIGHT="50" BASELINE="635 1299 2406 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1299 635 1314 2404 1309 2406 1294 2402 1264 633 1264 635 1299"/>
                        </Shape>
                        <String CONTENT="long pointed end. The other end has a slender round stem, which is deeply"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l13" HPOS="633" VPOS="1312" WIDTH="1773" HEIGHT="62" BASELINE="635 1359 2406 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="635 1359 635 1374 2404 1370 2406 1353 2404 1325 2369 1312 2367 1312 2365 1312 2363 1312 2341 1322 2237 1312 2235 1312 2233 1312 2211 1322 2190 1312 2187 1312 2185 1312 2183 1312 2181 1312 2166 1325 1895 1325 1841 1312 1839 1312 1837 1312 1811 1325 1754 1314 1752 1314 1700 1325 1365 1314 1362 1314 1222 1327 1146 1316 1144 1316 936 1327 918 1316 916 1316 914 1316 702 1316 700 1316 633 1329 635 1359"/>
                        </Shape>
                        <String CONTENT="embedded in a wooden or antler handle, usually without pegs to hold it in"/>
                    </TextLine>

                    <TextLine ID="mz_1-272_l14" HPOS="633" VPOS="1370" WIDTH="1775" HEIGHT="69" BASELINE="635 1420 2408 1411" TAGREFS="TYPE_4">
                        <Shape>
