                        </Shape>
                        <String CONTENT="other hand, when in 1895, during a brawl at the Anui fair, a Reindeer Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l6" HPOS="378" VPOS="896" WIDTH="1774" HEIGHT="63" BASELINE="381 941 2152 935" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 941 381 959 2150 952 2152 935 2148 904 1017 896 1015 896 950 907 480 898 478 898 378 909 381 941"/>
                        </Shape>
                        <String CONTENT="was killed by the Cossacks, the others resented the deed so much that they were"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l7" HPOS="376" VPOS="954" WIDTH="1774" HEIGHT="61" BASELINE="378 1000 2150 995" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1000 378 1015 2148 1011 2150 995 2146 965 1275 954 1273 954 1271 954 1249 965 407 956 404 956 402 956 376 965 378 1000"/>
                        </Shape>
                        <String CONTENT="almost ready to attack the fort. Notwithstanding the “weregild” paid by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l8" HPOS="376" VPOS="1013" WIDTH="1776" HEIGHT="63" BASELINE="378 1058 2152 1054" TAGREFS="TYPE_5">
                        <Shape>
