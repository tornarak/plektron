                    <TextLine ID="mz_1-067_l11" HPOS="487" VPOS="1197" WIDTH="1663" HEIGHT="58" BASELINE="489 1238 2150 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="489 1238 489 1255 2148 1251 2150 1234 2146 1205 508 1197 506 1197 504 1197 502 1197 487 1203 489 1238"/>
                        </Shape>
                        <String CONTENT="A considerable part of their former intractability remains at the present"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l12" HPOS="374" VPOS="1257" WIDTH="1776" HEIGHT="59" BASELINE="376 1299 2150 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1299 376 1316 2148 1311 2150 1294 2146 1266 400 1257 398 1257 396 1257 374 1266 376 1299"/>
                        </Shape>
                        <String CONTENT="time, especially among the Reindeer people, and shows itself even in the minor"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l13" HPOS="374" VPOS="1316" WIDTH="1774" HEIGHT="58" BASELINE="376 1357 2148 1350" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1357 376 1374 2146 1368 2148 1350 2143 1320 400 1316 398 1316 396 1316 374 1324 376 1357"/>
                        </Shape>
                        <String CONTENT="details of every-day life. The Chukchee is easily angered; often a trifle will"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l14" HPOS="376" VPOS="1374" WIDTH="1770" HEIGHT="63" BASELINE="378 1420 2146 1411" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1420 378 1437 2143 1431 2146 1411 2141 1383 1262 1374 1260 1374 1258 1374 1234 1385 827 1376 825 1376 822 1376 820 1376 807 1387 435 1379 433 1379 376 1389 378 1420"/>
                        </Shape>
                        <String CONTENT="suffice to transform his merry laughter into the most unreasonable rage. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l15" HPOS="374" VPOS="1439" WIDTH="1772" HEIGHT="57" BASELINE="376 1480 2146 1472" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1480 376 1496 2143 1489 2146 1472 2141 1444 394 1439 391 1439 389 1439 387 1439 374 1446 376 1480"/>
                        </Shape>
                        <String CONTENT="themselves are not unconscious of this peculiar feature of their mind. “I am"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l16" HPOS="374" VPOS="1500" WIDTH="1774" HEIGHT="58" BASELINE="376 1541 2148 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1541 376 1558 2146 1547 2148 1530 2143 1500 448 1500 446 1500 374 1511 376 1541"/>
                        </Shape>
                        <String CONTENT="a tundra wanderer,” one of my Chukchee acquaintances, named Ñĭroˊn, would"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l17" HPOS="374" VPOS="1554" WIDTH="1769" HEIGHT="71" BASELINE="376 1599 2143 1591" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1599 376 1615 443 1625 446 1625 448 1625 450 1625 465 1615 690 1615 760 1625 762 1625 764 1625 766 1625 781 1615 868 1623 870 1623 1037 1612 1223 1623 1225 1623 1227 1623 1262 1610 1496 1610 1671 1621 1674 1621 1676 1621 1710 1608 1734 1619 1736 1619 1739 1619 1741 1619 1773 1608 2063 1619 2066 1619 2141 1606 2143 1591 2137 1554 374 1569 376 1599"/>
                        </Shape>
                        <String CONTENT="say to me. “My anger rises suddenly. It comes and goes of its own accord.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l18" HPOS="376" VPOS="1612" WIDTH="1772" HEIGHT="63" BASELINE="378 1660 2148 1651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1660 378 1675 2146 1669 2148 1651 2143 1623 1706 1612 1704 1612 1641 1623 1481 1615 1479 1615 376 1625 378 1660"/>
                        </Shape>
                        <String CONTENT="Some women bear a special name on account of their violent temper. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l19" HPOS="374" VPOS="1673" WIDTH="1776" HEIGHT="71" BASELINE="376 1719 2150 1712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 1719 376 1732 903 1744 905 1744 907 1744 909 1744 924 1734 1533 1742 1535 1742 1537 1742 1539 1742 1561 1729 1855 1729 1873 1740 1875 1740 1877 1740 1879 1740 2148 1727 2150 1712 2146 1684 1609 1673 1606 1673 1552 1684 1084 1675 1082 1675 374 1688 376 1719"/>
                        </Shape>
                        <String CONTENT="are called “quarrelling women” (maraˊ-ñaˊus˙qattê). These are regarded as"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l20" HPOS="376" VPOS="1742" WIDTH="1770" HEIGHT="52" BASELINE="378 1779 2146 1770" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1779 378 1794 2143 1790 2146 1770 2139 1742 376 1749 378 1779"/>
                        </Shape>
                        <String CONTENT="nuisances even by their housemates. Among the men, some have the very"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l21" HPOS="376" VPOS="1792" WIDTH="1763" HEIGHT="63" BASELINE="378 1838 2139 1831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1838 378 1855 2137 1848 2139 1831 2133 1792 1546 1803 965 1794 963 1794 883 1805 543 1796 541 1796 376 1807 378 1838"/>
                        </Shape>
                        <String CONTENT="suggestive epithet “hasty” (qɪvr) prefixed to their names, as “Hasty Aᵋmuˊlin”"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l22" HPOS="378" VPOS="1855" WIDTH="358" HEIGHT="63" BASELINE="378 1900 736 1900" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1900 378 1918 736 1918 736 1900 736 1866 712 1855 710 1855 708 1855 597 1866 537 1855 534 1855 532 1855 504 1866 398 1855 396 1855 394 1855 391 1855 378 1864 378 1900"/>
                        </Shape>
                        <String CONTENT="(Qɪvr-Aᵋmuˊlin)."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-067_r4" HPOS="376" VPOS="1919" WIDTH="1778" HEIGHT="176" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="376 1919 2154 1919 2154 2095 376 2095"/>
                    </Shape>
                    <TextLine ID="mz_1-067_l23" HPOS="485" VPOS="1911" WIDTH="1661" HEIGHT="65" BASELINE="487 1957 2146 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="487 1957 487 1976 2143 1974 2146 1952 2141 1922 1409 1911 1407 1911 1275 1924 485 1924 487 1957"/>
                        </Shape>
                        <String CONTENT="The Chukchee, when angry, growls, shows his teeth, and makes a threatening"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l24" HPOS="374" VPOS="1970" WIDTH="1774" HEIGHT="65" BASELINE="376 2017 2148 2011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2017 376 2035 2146 2028 2148 2011 2143 1983 1775 1970 1773 1970 1645 1980 1563 1970 1561 1970 1559 1970 1557 1970 1544 1983 1502 1972 1500 1972 1498 1972 1496 1972 1472 1983 1435 1972 1433 1972 1431 1972 1184 1983 1136 1972 1134 1972 1132 1972 1130 1972 1091 1983 1048 1972 1046 1972 1043 1972 1041 1972 1002 1983 974 1972 972 1972 970 1972 968 1972 965 1972 948 1987 712 1987 688 1974 686 1974 684 1974 682 1974 651 1985 612 1974 610 1974 608 1974 374 1983 376 2017"/>
                        </Shape>
                        <String CONTENT="bite on his sleeve or on the handle of his knife, in defiance of his foe. Some"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l25" HPOS="374" VPOS="2030" WIDTH="1772" HEIGHT="65" BASELINE="376 2078 2146 2071" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2078 376 2095 2143 2089 2146 2071 2141 2043 2055 2030 2053 2030 1773 2041 1758 2030 1756 2030 1754 2030 1576 2030 1574 2030 1507 2043 1399 2032 1396 2032 1394 2032 1370 2043 1182 2032 1180 2032 1076 2043 1011 2032 1009 2032 926 2045 892 2035 890 2035 887 2035 885 2035 842 2045 621 2035 619 2035 552 2045 417 2035 415 2035 413 2035 374 2048 376 2078"/>
                        </Shape>
                        <String CONTENT="of them, when angered, shed tears of rage, and tear their hair like unruly children."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-067_r5" HPOS="376" VPOS="2095" WIDTH="1778" HEIGHT="782" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="376 2095 2154 2095 2154 2877 376 2877"/>
