                        </Shape>
                        <String CONTENT="Their language is singularly poor in abusive terms, and quarrels are"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l27" HPOS="372" VPOS="2149" WIDTH="1776" HEIGHT="65" BASELINE="374 2199 2148 2190" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2199 374 2214 2146 2206 2148 2190 2143 2160 1706 2149 1704 2149 1702 2149 1700 2149 1700 2152 1689 2160 1366 2152 1364 2152 372 2165 374 2199"/>
                        </Shape>
                        <String CONTENT="immediately settled by blows or wrestling. There is no lack of murders, some"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l28" HPOS="372" VPOS="2210" WIDTH="1774" HEIGHT="65" BASELINE="374 2260 2146 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2260 374 2275 2143 2266 2146 2251 2141 2223 1853 2210 1851 2210 1780 2221 1734 2210 1732 2210 1730 2210 1728 2210 1697 2225 1383 2225 1347 2212 1344 2212 1342 2212 1340 2212 1338 2212 1323 2223 955 2214 952 2214 950 2214 948 2214 933 2225 699 2216 697 2216 695 2216 649 2227 615 2216 612 2216 610 2216 558 2227 413 2216 411 2216 409 2216 372 2229 374 2260"/>
                        </Shape>
                        <String CONTENT="of them of a barbarous character. Thus, in a camp near Cape Erri, the son"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l29" HPOS="372" VPOS="2271" WIDTH="1774" HEIGHT="67" BASELINE="374 2320 2146 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="374 2320 374 2336 1788 2338 1790 2338 2143 2325 2146 2310 2141 2279 1437 2271 1435 2271 1433 2271 1431 2271 1418 2281 1106 2273 1104 2273 1102 2273 1065 2284 446 2277 443 2277 372 2288 374 2320"/>
                        </Shape>
                        <String CONTENT="and the nephew of the rich reindeer-breeder Yekuˊtku, being goaded to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l30" HPOS="374" VPOS="2340" WIDTH="1772" HEIGHT="56" BASELINE="376 2379 2146 2370" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2379 376 2396 2143 2387 2146 2370 2139 2340 374 2346 376 2379"/>
                        </Shape>
                        <String CONTENT="extreme by constant blows and abuse, cut his throat, and that with the knowl-"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l31" HPOS="374" VPOS="2387" WIDTH="1774" HEIGHT="68" BASELINE="376 2439 2148 2429" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2439 376 2455 2133 2455 2133 2452 2135 2452 2137 2452 2148 2442 2148 2429 2141 2392 1849 2398 1825 2387 1823 2387 1821 2387 1819 2387 1788 2400 1736 2390 1734 2390 1732 2390 1730 2390 1715 2403 1626 2403 1550 2390 1548 2390 1407 2403 1327 2392 1325 2392 1180 2403 1145 2392 1143 2392 1141 2392 1080 2405 835 2394 833 2394 777 2405 731 2394 729 2394 727 2394 725 2394 699 2407 417 2396 415 2396 413 2396 374 2409 376 2439"/>
                        </Shape>
                        <String CONTENT="edge of his wife, the mother of one of the murderers. In the summer of"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l32" HPOS="378" VPOS="2450" WIDTH="1768" HEIGHT="72" BASELINE="381 2500 2146 2489" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 2500 381 2513 985 2522 987 2522 2143 2504 2146 2489 2141 2459 1440 2450 1437 2450 1435 2450 1405 2461 413 2457 411 2457 409 2457 378 2468 381 2500"/>
                        </Shape>
                        <String CONTENT="1896 on the Poplar River, an affluent of the Small Anui, a young man killed"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l33" HPOS="374" VPOS="2511" WIDTH="1769" HEIGHT="61" BASELINE="376 2556 2143 2550" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2556 376 2572 2141 2565 2143 2550 2139 2522 1606 2511 1604 2511 1548 2524 374 2524 376 2556"/>
                        </Shape>
                        <String CONTENT="his brother in order to get possession of his flock. The murderer, with his"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l34" HPOS="374" VPOS="2572" WIDTH="1769" HEIGHT="71" BASELINE="376 2617 2143 2608" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2617 376 2632 534 2643 537 2643 855 2630 1024 2641 1026 2641 1028 2641 1050 2630 1212 2641 1214 2641 1217 2641 1266 2628 1589 2639 1591 2639 1780 2636 1782 2636 1784 2636 1799 2626 2139 2630 2143 2608 2139 2580 1260 2572 1258 2572 1256 2572 1210 2582 825 2574 822 2574 374 2587 376 2617"/>
                        </Shape>
                        <String CONTENT="accomplice and their victim, arranged a contest of jumping over a barrier,"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l35" HPOS="374" VPOS="2636" WIDTH="1769" HEIGHT="57" BASELINE="376 2680 2143 2669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2680 376 2693 2141 2684 2143 2669 2139 2636 394 2636 391 2636 389 2636 387 2636 374 2643 376 2680"/>
                        </Shape>
                        <String CONTENT="the loser to pay the forfeit of skipping about for a while with his feet and"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l36" HPOS="374" VPOS="2686" WIDTH="1769" HEIGHT="65" BASELINE="376 2738 2143 2727" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="376 2738 376 2751 2141 2745 2143 2727 2139 2699 1860 2699 1836 2686 1834 2686 1832 2686 1829 2686 1784 2699 1565 2688 1563 2688 1509 2699 1461 2688 1459 2688 1457 2688 1455 2688 1422 2701 1388 2691 1386 2691 1383 2691 1381 2691 1355 2701 1253 2691 1251 2691 1199 2701 1145 2691 1143 2691 1141 2691 1139 2691 1123 2701 820 2693 818 2693 710 2706 682 2695 680 2695 677 2695 374 2704 376 2738"/>
                        </Shape>
