                        </Shape>
                        <String CONTENT="officials to the family of the slain man, the Chukchee harbored a feeling of ill will"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l9" HPOS="376" VPOS="1078" WIDTH="1774" HEIGHT="58" BASELINE="378 1119 2150 1114" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="378 1119 378 1136 2148 1132 2150 1114 2146 1086 389 1078 387 1078 385 1078 383 1078 383 1080 376 1084 378 1119"/>
                        </Shape>
                        <String CONTENT="for a long time afterwards; and the next winter, when travelling among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l10" HPOS="381" VPOS="1143" WIDTH="1713" HEIGHT="60" BASELINE="383 1173 2094 1177" TAGREFS="TYPE_5">
                        <Shape>
