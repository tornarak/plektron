            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-338" HPOS="628" VPOS="621" WIDTH="1787" HEIGHT="2617"><TextLine ID="mz_1-338_l1" HPOS="1209" VPOS="621" WIDTH="623" HEIGHT="56" BASELINE="1211 658 1832 653" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1821 621 1219 623 1209 636 1211 658 1211 677 1830 673 1832 653 1826 621 1821 621"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l2" HPOS="635" VPOS="630" WIDTH="114" HEIGHT="52" BASELINE="635 658 749 658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 647 635 658 635 673 641 679 641 682 643 682 646 682 648 682 749 669 749 658 749 630 646 630 635 647"/>
                        </Shape>
                        <String CONTENT="260"/>
                    </TextLine>
<TextLine ID="mz_1-338_l3" HPOS="628" VPOS="727" WIDTH="1776" HEIGHT="56" BASELINE="630 762 2404 768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 762 628 775 2400 783 2404 768 2404 734 630 727 630 762"/>
                        </Shape>
                        <String CONTENT="by the Central Eskimo.¹ It is uncertain whether, before the arrival of Europeans,"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l4" HPOS="630" VPOS="790" WIDTH="1566" HEIGHT="52" BASELINE="633 820 2196 827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 820 630 835 2192 842 2196 827 2194 796 633 790 633 820"/>
                        </Shape>
                        <String CONTENT="the Chukchee used necklaces made of small objects strung together."/>
                    </TextLine>
<TextLine ID="mz_1-338_l5" HPOS="736" VPOS="853" WIDTH="1666" HEIGHT="49" BASELINE="739 885 2402 881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 885 739 902 2400 898 2402 881 2398 853 736 853 739 885"/>
                        </Shape>
                        <String CONTENT="I have heard that necklaces of the vertebræ of fish were worn by children."/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l6" HPOS="630" VPOS="902" WIDTH="1774" HEIGHT="59" BASELINE="630 946 2404 946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 946 630 961 2404 961 2404 946 2404 915 2315 902 2313 902 2311 902 2283 913 2222 902 2220 902 2159 913 2051 902 2049 902 2047 902 2019 915 1834 915 1720 902 1718 902 1614 913 1551 902 1549 902 1546 902 1544 902 1527 915 1421 915 1406 902 1403 902 1401 902 1282 902 1280 902 1209 913 1161 902 1159 902 1157 902 1102 913 1070 902 1068 902 1066 902 1063 902 1038 913 957 902 955 902 886 913 856 902 853 902 851 902 849 902 825 913 797 902 795 902 793 902 706 913 650 902 648 902 646 902 643 902 630 911 630 946"/>
                        </Shape>
                        <String CONTENT="One of the dolls I collected had a necklace of tiny stones of irregular form"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l7" HPOS="628" VPOS="963" WIDTH="754" HEIGHT="56" BASELINE="630 1004 1382 1000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1004 630 1019 1380 1015 1382 1000 1378 972 648 963 646 963 643 963 641 963 628 970 630 1004"/>
                        </Shape>
                        <String CONTENT="tied together on a sinew thread."/>
                    </TextLine>
<TextLine ID="mz_1-338_l8" HPOS="736" VPOS="1019" WIDTH="1672" HEIGHT="70" BASELINE="739 1067 2408 1063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2404 1043 2400 1032 2294 1032 2274 1019 2272 1019 2270 1019 2268 1019 2265 1019 2242 1032 2001 1032 1982 1019 1980 1019 1977 1019 1975 1019 1973 1019 1945 1030 1934 1019 1932 1019 1930 1019 1928 1019 1925 1019 1893 1030 1804 1019 1802 1019 1800 1019 1772 1030 1670 1019 1668 1019 1666 1019 1640 1030 1627 1019 1624 1019 1622 1019 1620 1019 1529 1022 1527 1022 1525 1022 1512 1032 1460 1022 1458 1022 1455 1022 1423 1032 1189 1022 1187 1022 1185 1022 1159 1032 1124 1022 1122 1022 1120 1022 1025 1032 736 1030 739 1067 739 1078 1564 1089 1566 1089 1761 1078 2389 1086 2391 1086 2393 1086 2395 1086 2408 1076 2408 1063 2404 1032 2404 1043"/>
                        </Shape>
                        <String CONTENT="Buttons are little known to the Chukchee, since their garments do not"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l9" HPOS="628" VPOS="1082" WIDTH="1778" HEIGHT="59" BASELINE="630 1125 2406 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1125 630 1141 2404 1136 2406 1121 2402 1093 1575 1082 1572 1082 1475 1093 730 1084 728 1084 628 1095 630 1125"/>
                        </Shape>
                        <String CONTENT="require any. Some buttons carved out of ivory are used for clasping belts or"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l10" HPOS="630" VPOS="1143" WIDTH="1776" HEIGHT="69" BASELINE="630 1184 2406 1184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1184 630 1199 903 1212 905 1212 1148 1201 1403 1201 1451 1212 1453 1212 1455 1212 1512 1201 1536 1212 1538 1212 1540 1212 1646 1201 1692 1212 1694 1212 1696 1212 1776 1201 1802 1212 1804 1212 1806 1212 1910 1201 2060 1212 2062 1212 2064 1212 2092 1201 2179 1212 2181 1212 2183 1212 2185 1212 2200 1201 2406 1201 2406 1184 2406 1156 2248 1156 2233 1143 2231 1143 2229 1143 2226 1143 2224 1143 2196 1154 2008 1143 2006 1143 1941 1154 1884 1143 1882 1143 1880 1143 1843 1154 630 1145 630 1184"/>
                        </Shape>
                        <String CONTENT="for buttoning pouches and work-bags (Fig. 191, e, f). They may be com-"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l11" HPOS="628" VPOS="1201" WIDTH="1679" HEIGHT="65" BASELINE="630 1247 2307 1240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1247 630 1266 2304 1258 2307 1240 2302 1201 1252 1201 1250 1201 1139 1212 741 1203 739 1203 628 1214 630 1247"/>
                        </Shape>
                        <String CONTENT="pared to the buttons belonging to the Gilyak, and illustrated by Schrenck.²"/>
                    </TextLine>
<TextLine ID="mz_1-338_l12" HPOS="736" VPOS="1271" WIDTH="1662" HEIGHT="58" BASELINE="739 1301 2398 1307" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1301 736 1314 754 1327 756 1327 758 1327 760 1327 1085 1316 1304 1329 1306 1329 1486 1318 1544 1329 1546 1329 1549 1329 1551 1329 1568 1318 2393 1327 2398 1307 2395 1271 739 1271 739 1301"/>
                        </Shape>
                        <String CONTENT="SNOW-GOGGLES. — Snow-goggles of leather and wood (Fig. 192, a, b)"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l13" HPOS="630" VPOS="1333" WIDTH="1774" HEIGHT="52" BASELINE="630 1364 2404 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1364 630 1385 2404 1385 2404 1364 2404 1333 630 1333 630 1364"/>
                        </Shape>
                        <String CONTENT="are used by the Chukchee, the Asiatic Eskimo, the Lamut, and other tribes"/>
                    </TextLine>
<TextLine ID="mz_1-338_l14" HPOS="628" VPOS="2515" WIDTH="1776" HEIGHT="48" BASELINE="628 2546 2404 2546" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2389 2515 628 2515 628 2546 628 2563 2404 2563 2404 2546 2404 2539 2389 2515"/>
                        </Shape>
                        <String CONTENT="of northeastern Asia. They have narrow slits similar to those in the specimens"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l15" HPOS="628" VPOS="2561" WIDTH="1776" HEIGHT="60" BASELINE="630 2606 2404 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2606 630 2621 2402 2617 2404 2602 2398 2567 1977 2572 1921 2561 1919 2561 1917 2561 1915 2561 1899 2572 1871 2561 1869 2561 1867 2561 1791 2572 1744 2561 1741 2561 1739 2561 1505 2574 1449 2563 1447 2563 1445 2563 1421 2574 1336 2563 1334 2563 1239 2574 1111 2563 1109 2563 1107 2563 1076 2574 882 2563 879 2563 877 2563 840 2574 780 2563 778 2563 775 2563 736 2574 641 2563 639 2563 637 2563 635 2563 635 2565 628 2570 630 2606"/>
                        </Shape>
                        <String CONTENT="from the American Eskimo. The Lamut sometimes fashion snow-goggles of"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l16" HPOS="628" VPOS="2626" WIDTH="1772" HEIGHT="65" BASELINE="630 2667 2400 2663" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2667 630 2680 973 2691 975 2691 977 2691 1009 2680 2398 2680 2400 2663 2395 2634 646 2626 643 2626 641 2626 639 2626 628 2632 630 2667"/>
                        </Shape>
                        <String CONTENT="the same shape out of thin sheets of silver hammered out of silver coins."/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l17" HPOS="633" VPOS="2689" WIDTH="1782" HEIGHT="54" BASELINE="635 2725 2415 2723" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 2725 635 2743 2413 2741 2415 2723 2411 2693 633 2689 635 2725"/>
                        </Shape>
                        <String CONTENT="Nowadays snow-goggles of Yakut make, covered with a net of horsehair, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l18" HPOS="630" VPOS="2745" WIDTH="1770" HEIGHT="65" BASELINE="633 2780 2400 2786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 2780 630 2799 641 2808 643 2808 646 2808 648 2808 1126 2799 1228 2810 1230 2810 2398 2801 2400 2786 2398 2756 633 2745 633 2780"/>
                        </Shape>
                        <String CONTENT="bought from Russian traders. Glass goggles from civilized countries are also"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l19" HPOS="630" VPOS="2810" WIDTH="1770" HEIGHT="58" BASELINE="633 2840 2400 2847" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 2840 630 2855 663 2868 665 2868 667 2868 2398 2864 2400 2847 2398 2816 633 2810 633 2840"/>
                        </Shape>
                        <String CONTENT="eagerly purchased. The Chukchee sometimes imitate European snow-goggles,"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l20" HPOS="633" VPOS="2866" WIDTH="1767" HEIGHT="56" BASELINE="633 2905 2400 2905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 2905 633 2922 2398 2922 2400 2905 2398 2873 633 2866 633 2905"/>
                        </Shape>
                        <String CONTENT="but in place of smoked glass or hair-netting they use round bits of iron pierced"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l21" HPOS="628" VPOS="2929" WIDTH="485" HEIGHT="52" BASELINE="630 2964 1113 2959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2964 630 2981 1113 2977 1113 2959 1107 2929 628 2931 630 2964"/>
                        </Shape>
                        <String CONTENT="with numerous holes."/>
                    </TextLine>
<TextLine ID="mz_1-338_l22" HPOS="739" VPOS="2987" WIDTH="1663" HEIGHT="54" BASELINE="739 3024 2402 3024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 3024 739 3041 2402 3041 2402 3024 2402 2994 739 2987 739 3024"/>
                        </Shape>
                        <String CONTENT="I once saw among the Reindeer Chukchee an eye-shade used by a man"/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l23" HPOS="630" VPOS="3052" WIDTH="1768" HEIGHT="50" BASELINE="630 3083 2398 3083" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 3083 630 3102 2395 3102 2398 3083 2395 3052 630 3052 630 3083"/>
                        </Shape>
                        <String CONTENT="who had weak eyes. It was made of thick leather, and fastened with strings"/>
                    </TextLine>
<TextLine ID="mz_1-338_l24" HPOS="736" VPOS="3143" WIDTH="1623" HEIGHT="57" BASELINE="739 3171 2359 3180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 3171 736 3191 2354 3200 2359 3180 2356 3152 739 3143 739 3171"/>
                        </Shape>
                        <String CONTENT="¹ Compare Boas, Central Eskimo, Fig. 509, a, p. 555; and Boas, Baffin-Land Eskimo, Fig. 75, p. 52."/>
                    </TextLine>

                    <TextLine ID="mz_1-338_l25" HPOS="734" VPOS="3187" WIDTH="615" HEIGHT="51" BASELINE="736 3217 1349 3223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 3217 734 3232 1345 3238 1349 3223 1347 3193 736 3187 736 3217"/>
                        </Shape>
                        <String CONTENT="² Schrenck, II, Plate XXIX, Figs. 4, 5."/>
                    </TextLine>
</TextBlock></PrintSpace>
        </Page>
