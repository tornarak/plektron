                        </Shape>
                        <String CONTENT="This man, in the winter of 1898, met in the open country two young men"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l23" HPOS="539" VPOS="1776" WIDTH="1768" HEIGHT="57" BASELINE="539 1817 2307 1817" TAGREFS="TYPE_5">
