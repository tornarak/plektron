                        </Shape>
                        <String CONTENT="too much experience in keeping reindeer. His herd, too, consisted, for the"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l4" HPOS="537" VPOS="644" WIDTH="1768" HEIGHT="52" BASELINE="537 681 2305 681" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="537 681 537 696 2305 696 2305 681 2303 644 537 650 537 681"/>
                        </Shape>
                        <String CONTENT="most part, of new animals just bought from strange herds, and the mutual"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l5" HPOS="533" VPOS="698" WIDTH="1768" HEIGHT="57" BASELINE="535 741 2301 737" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="535 741 535 755 2299 753 2301 737 2297 710 2202 698 2200 698 2198 698 2159 708 2120 698 2118 698 2116 698 2114 698 2091 708 1983 698 1981 698 1980 698 1937 708 1348 700 1346 700 1344 700 1342 700 1327 710 594 700 592 700 533 712 535 741"/>
                        </Shape>
                        <String CONTENT="attachment of these reindeer was less strong than in an ordinary herd: so"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l6" HPOS="533" VPOS="759" WIDTH="1770" HEIGHT="56" BASELINE="535 802 2303 798" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="535 802 535 815 2301 815 2303 798 2299 771 2204 759 2202 759 2200 759 2169 769 2059 759 2057 759 2056 759 2026 771 1820 771 1761 759 1759 759 1757 759 1755 759 1740 771 1370 771 1233 761 1231 761 1229 761 1188 771 1141 761 1140 761 995 771 919 761 917 761 869 771 533 763 535 802"/>
                        </Shape>
                        <String CONTENT="Čêpaˊt lost a few animals almost every summer. One year, quite a large"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l7" HPOS="535" VPOS="817" WIDTH="1766" HEIGHT="65" BASELINE="537 862 2301 858" TAGREFS="TYPE_5">
