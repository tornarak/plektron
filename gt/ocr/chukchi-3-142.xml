                        </Shape>
                        <String CONTENT="to their country from the Pacific shore with a load of foreign wares."/>
                    </TextLine>
<TextLine ID="mz_3-142_l21" HPOS="646" VPOS="1657" WIDTH="1657" HEIGHT="57" BASELINE="646 1698 2303 1698" TAGREFS="TYPE_5">
                        <Shape>
