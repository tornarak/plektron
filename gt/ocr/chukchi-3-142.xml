                        </Shape>
                        <String CONTENT="on the snow, bought some liquor of them with fur-skins he had with him,"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l26" HPOS="537" VPOS="1955" WIDTH="1766" HEIGHT="63" BASELINE="539 1994 2303 1998" TAGREFS="TYPE_5">
