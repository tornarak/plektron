                        </Shape>
                        <String CONTENT="and in the end robbed them of more of their brandy, and went away. They"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l27" HPOS="539" VPOS="2016" WIDTH="1764" HEIGHT="66" BASELINE="541 2055 2303 2059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="541 2055 539 2067 758 2078 760 2078 1366 2070 1459 2080 1461 2082 2301 2082 2303 2059 2301 2029 2130 2018 2128 2018 2050 2028 2017 2018 2015 2018 2013 2018 1909 2028 1841 2018 1839 2018 1707 2028 1633 2018 1631 2018 1629 2018 1598 2028 1516 2018 1514 2018 1512 2018 1481 2028 1391 2016 1389 2016 1387 2016 1352 2028 1112 2028 1091 2016 1089 2016 1087 2016 1085 2016 1050 2026 991 2016 989 2016 906 2026 820 2016 818 2016 816 2016 785 2026 541 2026 541 2055"/>
                        </Shape>
                        <String CONTENT="were two, but, being in a strange land, they did not offer much resistance;"/>
                    </TextLine>

