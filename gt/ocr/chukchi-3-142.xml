                        <Shape>
                            <Polygon POINTS="539 1879 539 1891 2301 1893 2305 1879 2303 1848 2219 1837 2217 1837 2215 1837 2188 1846 2153 1837 2151 1837 2149 1837 2091 1846 2024 1837 2022 1837 1946 1848 1689 1848 1656 1837 1654 1837 1652 1837 1650 1837 1619 1846 1598 1837 1596 1837 1594 1837 1547 1846 1523 1837 1522 1837 1520 1837 1449 1846 1373 1837 1371 1837 1295 1846 1264 1837 1262 1837 1260 1837 1258 1837 1216 1846 539 1842 539 1879"/>
                        </Shape>
                        <String CONTENT="brandy for trading-purposes. Qoplaˊnto joined them, spent a night with them"/>
                    </TextLine>

                    <TextLine ID="mz_3-142_l25" HPOS="537" VPOS="1893" WIDTH="1764" HEIGHT="68" BASELINE="539 1932 2301 1940" TAGREFS="TYPE_5">
