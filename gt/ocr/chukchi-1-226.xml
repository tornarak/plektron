                            <Polygon POINTS="589 2563 589 2582 2360 2582 2360 2563 2360 2533 589 2533 589 2563"/>
                        </Shape>
                        <String CONTENT="represents a shovel collected among the Lamut, though the Kolyma Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l34" HPOS="589" VPOS="2587" WIDTH="1769" HEIGHT="54" BASELINE="591 2623 2358 2619" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="591 2623 591 2641 2356 2639 2358 2619 2354 2591 589 2587 591 2623"/>
                        </Shape>
                        <String CONTENT="Chukchee use exactly the same form. It also resembles the shovel used in"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l35" HPOS="593" VPOS="2641" WIDTH="825" HEIGHT="60" BASELINE="593 2684 1418 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="593 2684 593 2701 1418 2701 1418 2684 1416 2645 868 2652 844 2641 842 2641 840 2641 838 2641 835 2641 835 2643 825 2654 729 2654 706 2641 703 2641 701 2641 699 2641 675 2652 617 2641 615 2641 612 2641 593 2649 593 2684"/>
                        </Shape>
                        <String CONTENT="Alaska and represented by Nelson.¹"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-226_r6" HPOS="583" VPOS="2709" WIDTH="1778" HEIGHT="480" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="583 2709 2361 2709 2361 3189 583 3189"/>
                    </Shape>
                    <TextLine ID="mz_1-226_l36" HPOS="673" VPOS="2708" WIDTH="1687" HEIGHT="54" BASELINE="673 2745 2360 2745" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="673 2745 673 2762 2360 2762 2360 2745 2360 2714 673 2708 673 2745"/>
                        </Shape>
                        <String CONTENT="The covering of the house is for the most part sewed together out of worn-"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l37" HPOS="586" VPOS="2760" WIDTH="1774" HEIGHT="60" BASELINE="589 2805 2360 2801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="589 2805 589 2820 2358 2816 2360 2801 2356 2773 2250 2760 2247 2760 2245 2760 2221 2771 2079 2760 2076 2760 2074 2760 2037 2771 2007 2760 2005 2760 2003 2760 1931 2771 1899 2760 1897 2760 1894 2760 1752 2771 1730 2760 1728 2760 1580 2760 1578 2760 1576 2760 1554 2771 1502 2760 1500 2760 1498 2760 1468 2773 1392 2762 1390 2762 1388 2762 1357 2773 1321 2762 1318 2762 1316 2762 1314 2762 1277 2773 1110 2762 1108 2762 987 2773 866 2762 864 2762 861 2762 820 2773 712 2762 710 2762 708 2762 677 2773 664 2762 662 2762 660 2762 658 2762 586 2775 589 2805"/>
                        </Shape>
                        <String CONTENT="out pieces of tent-covering bought from the Reindeer people. In front a large"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l38" HPOS="591" VPOS="2833" WIDTH="1769" HEIGHT="48" BASELINE="591 2864 2360 2864" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="591 2864 591 2881 2360 2881 2360 2864 2360 2833 591 2833 591 2864"/>
                        </Shape>
                        <String CONTENT="walrus-skin is placed, in order to give protection against the storms, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l39" HPOS="589" VPOS="2879" WIDTH="1773" HEIGHT="61" BASELINE="591 2920 2362 2924" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="589 2935 2358 2940 2362 2924 2360 2894 1269 2881 1266 2881 615 2890 595 2879 591 2920 589 2935"/>
                        </Shape>
                        <String CONTENT="usually come from the sea. In more recent years old sail-cloth has begun to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l40" HPOS="591" VPOS="2953" WIDTH="1767" HEIGHT="49" BASELINE="591 2983 2358 2983" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="591 2983 591 3002 2356 3002 2358 2983 2356 2953 591 2953 591 2983"/>
                        </Shape>
                        <String CONTENT="used instead of old reindeer-skins, especially in the Eskimo settlements. Every"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l41" HPOS="586" VPOS="3002" WIDTH="1774" HEIGHT="65" BASELINE="589 3048 2360 3041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="589 3048 589 3067 2358 3054 2360 3041 2356 3011 1191 3002 1188 3002 1069 3013 671 3005 669 3005 586 3015 589 3048"/>
                        </Shape>
                        <String CONTENT="part of the cover is well fastened with thongs, and weighted down by means"/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l42" HPOS="589" VPOS="3059" WIDTH="1767" HEIGHT="60" BASELINE="591 3100 2356 3104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="591 3100 589 3115 2351 3119 2356 3104 2356 3074 2330 3061 2328 3061 2325 3061 2323 3061 2291 3072 2230 3061 2228 3061 2159 3072 2007 3061 2005 3061 1933 3072 1868 3061 1866 3061 1788 3072 1689 3061 1687 3061 1684 3061 1658 3072 1572 3061 1570 3061 1567 3061 1565 3061 1550 3072 1522 3061 1520 3061 1518 3061 1383 3069 1336 3059 1334 3059 1331 3059 1251 3069 1225 3059 1223 3059 1221 3059 1126 3069 1100 3059 1097 3059 1095 3059 1004 3072 703 3072 688 3059 686 3059 684 3059 682 3059 591 3067 591 3100"/>
                        </Shape>
                        <String CONTENT="of heavy stones and loaded sledges, and even iron chains (Plate XV, Fig. 2)."/>
                    </TextLine>

                    <TextLine ID="mz_1-226_l43" HPOS="593" VPOS="3121" WIDTH="1761" HEIGHT="61" BASELINE="595 3158 2354 3163" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="595 3158 593 3178 2349 3182 2354 3163 2351 3132 595 3121 595 3158"/>
