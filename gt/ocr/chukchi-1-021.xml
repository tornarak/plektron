                        <String CONTENT="the Chukchee Peninsula, in 1900-01. From 1895 to 1898 the work was"/>
                    </TextLine>

                    <TextLine ID="mz_1-021_l7" HPOS="307" VPOS="1935" WIDTH="1767" HEIGHT="54" BASELINE="307 1965 2074 1965" TAGREFS="TYPE_5">
                        <Shape>
