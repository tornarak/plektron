                    </TextLine>

                    <TextLine ID="mz_1-021_l5" HPOS="303" VPOS="1805" WIDTH="1769" HEIGHT="59" BASELINE="305 1846 2072 1842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="305 1846 305 1864 2070 1864 2072 1842 2068 1809 316 1805 314 1805 311 1805 309 1805 309 1807 303 1812 305 1846"/>
