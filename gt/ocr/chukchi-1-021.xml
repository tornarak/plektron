                    <TextLine ID="mz_1-021_l4" HPOS="307" VPOS="1755" WIDTH="1767" HEIGHT="48" BASELINE="307 1786 2074 1786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="307 1786 307 1803 2072 1803 2074 1786 2072 1755 307 1755 307 1786"/>
                        </Shape>
