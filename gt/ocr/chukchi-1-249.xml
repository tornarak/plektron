                        </Shape>
                        <String CONTENT="VIII. — FOOD."/>
                    </TextLine>
<TextLine ID="mz_1-249_l2" HPOS="470" VPOS="1026" WIDTH="1672" HEIGHT="73" BASELINE="472 1076 2142 1067" TAGREFS="TYPE_5">
