                        </Shape>
                        <String CONTENT="Tuˊlla, tuˊlla; — are identical with the urging calls of the Point Barrow Eskimo."/>
                    </TextLine>
<TextLine ID="mz_1-147_l42" HPOS="459" VPOS="2063" WIDTH="1655" HEIGHT="54" BASELINE="459 2098 2114 2098" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="459 2098 459 2113 2109 2117 2114 2098 2112 2067 459 2063 459 2098"/>
                        </Shape>
                        <String CONTENT="When running fast, the dogs are urged forward by whistling, shouting,"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l43" HPOS="344" VPOS="2124" WIDTH="1772" HEIGHT="51" BASELINE="347 2158 2116 2152" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="347 2158 347 2175 2114 2169 2116 2152 2109 2124 344 2128 347 2158"/>
                        </Shape>
                        <String CONTENT="or the utterance of various short words suitable to the occasion; such as, “He"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l44" HPOS="347" VPOS="2171" WIDTH="1771" HEIGHT="72" BASELINE="349 2219 2118 2212" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="349 2219 349 2232 825 2243 827 2243 830 2243 866 2232 1360 2240 1362 2240 1440 2230 1518 2240 1520 2240 1581 2227 1603 2238 1605 2238 1607 2238 2116 2227 2118 2212 2114 2184 1930 2184 1904 2171 1902 2171 1899 2171 1897 2171 1856 2182 1828 2171 1826 2171 1824 2171 1821 2171 1782 2182 1754 2171 1752 2171 1750 2171 1748 2171 1711 2182 1687 2171 1685 2171 1683 2171 1681 2171 1648 2182 1618 2171 1616 2171 1614 2171 1525 2184 1510 2173 1507 2173 1505 2173 1503 2173 1425 2184 1386 2173 1384 2173 1382 2173 1248 2184 1141 2173 1139 2173 1137 2173 1115 2184 1079 2173 1076 2173 1074 2173 992 2184 938 2173 936 2173 934 2173 895 2186 882 2175 879 2175 877 2175 875 2175 873 2175 834 2186 732 2175 730 2175 728 2175 704 2186 594 2175 591 2175 347 2184 349 2219"/>
                        </Shape>
                        <String CONTENT="boys!” “Home, home!” “Goose!” “Reindeer!” When tired, the leader ceases"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l45" HPOS="344" VPOS="2238" WIDTH="1774" HEIGHT="57" BASELINE="347 2279 2118 2273" TAGREFS="TYPE_6">
                        <Shape>
