                    <TextLine ID="mz_1-147_l52" HPOS="344" VPOS="2652" WIDTH="1774" HEIGHT="65" BASELINE="347 2702 2118 2693" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="347 2702 347 2717 2116 2708 2118 2693 2114 2663 1674 2652 1672 2652 1670 2652 1668 2652 1668 2654 1657 2663 1232 2654 1230 2654 1228 2654 1206 2665 821 2656 819 2656 758 2667 429 2658 427 2658 344 2669 347 2702"/>
                        </Shape>
                        <String CONTENT="ered to be badly trained, since this habit indicates either shyness or too much"/>
                    </TextLine>

