                        </Shape>
                        <String CONTENT="The training of the leader is very simple. A swift and clever young dog,"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l48" HPOS="342" VPOS="2422" WIDTH="1774" HEIGHT="59" BASELINE="344 2459 2116 2453" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="344 2459 344 2481 2114 2470 2116 2453 2109 2422 342 2427 344 2459"/>
                        </Shape>
                        <String CONTENT="perhaps two years old, is placed as one of the front pair in the team, and in"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l49" HPOS="349" VPOS="2476" WIDTH="1767" HEIGHT="59" BASELINE="349 2520 2116 2520" TAGREFS="TYPE_6">
