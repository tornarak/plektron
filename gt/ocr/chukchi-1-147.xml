                        </Shape>
                        <String CONTENT="to obey the driver or to understand his calls, and accordingly looks around"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l46" HPOS="344" VPOS="2308" WIDTH="620" HEIGHT="47" BASELINE="347 2340 964 2336" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="347 2340 347 2355 962 2351 964 2336 957 2308 344 2310 347 2340"/>
