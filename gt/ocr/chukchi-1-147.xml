                        </Shape>
                        <String CONTENT="a couple of months begins to learn from its companion. Well-trained dogs,"/>
                    </TextLine>

                    <TextLine ID="mz_1-147_l50" HPOS="347" VPOS="2535" WIDTH="1771" HEIGHT="60" BASELINE="349 2580 2118 2572" TAGREFS="TYPE_6">
