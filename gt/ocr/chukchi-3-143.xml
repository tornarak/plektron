                        <Shape>
                            <Polygon POINTS="329 2072 329 2086 2038 2086 2038 2072 2038 2043 1941 2031 1939 2031 1872 2041 1477 2031 1475 2031 1276 2041 1241 2031 1239 2031 1237 2031 1145 2041 1052 2031 1050 2031 1048 2031 1046 2031 1030 2043 900 2043 847 2031 845 2031 843 2031 841 2031 826 2041 719 2031 717 2031 715 2031 713 2031 697 2043 518 2043 448 2031 446 2031 391 2041 356 2031 354 2031 352 2031 350 2031 329 2041 329 2072"/>
                        </Shape>
                        <String CONTENT="dered it away. Now he was older, and expressed his intention to reform."/>
                    </TextLine>
<TextLine ID="mz_3-143_l28" HPOS="438" VPOS="2088" WIDTH="1662" HEIGHT="58" BASELINE="440 2135 2100 2129" TAGREFS="TYPE_6">
                        <Shape>
