                        <Shape>
                            <Polygon POINTS="325 997 325 1010 2093 1010 2095 991 2093 963 2063 950 2061 950 2059 950 2057 950 2011 963 1948 963 1931 950 1929 950 1927 950 1925 950 1853 962 1790 950 1789 950 1718 962 1623 950 1621 950 1619 950 1617 950 1598 963 1502 963 1352 952 1284 952 1282 952 1280 952 1278 952 1260 963 1145 952 1143 952 1040 963 921 952 919 952 917 952 890 965 779 954 777 954 775 954 738 965 707 956 705 956 703 956 641 967 481 967 448 954 446 954 444 954 442 954 399 965 354 954 352 954 350 954 348 954 323 960 325 997"/>
                        </Shape>
                        <String CONTENT="in the rear, not those of the fathers. When a man like Aiñanwaˊt really"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l10" HPOS="327" VPOS="1024" WIDTH="1766" HEIGHT="51" BASELINE="327 1053 2093 1053" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="327 1053 327 1067 2089 1075 2093 1053 2091 1024 327 1024 327 1053"/>
                        </Shape>
                        <String CONTENT="does cede his house and herd to his son, it is because of personal motives,"/>
                    </TextLine>

