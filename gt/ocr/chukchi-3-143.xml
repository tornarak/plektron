                        </Shape>
                        <String CONTENT="tioned before, also became poor. Then his kinsmen on the Indighirka tundra"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l30" HPOS="331" VPOS="2205" WIDTH="1767" HEIGHT="70" BASELINE="333 2256 2098 2248" TAGREFS="TYPE_6">
                        <Shape>
