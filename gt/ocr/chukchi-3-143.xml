                        </Shape>
                        <String CONTENT="years after I left the Kolyma country."/>
                    </TextLine>
<TextLine ID="mz_3-143_l18" HPOS="442" VPOS="1492" WIDTH="1654" HEIGHT="66" BASELINE="442 1533 2096 1533" TAGREFS="TYPE_6">
                        <Shape>
