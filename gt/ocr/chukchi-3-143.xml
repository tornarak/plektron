                        </Shape>
                        <String CONTENT="close-fisted, still gave to a cousin of theirs five scores² of their reindeer-does."/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l26" HPOS="333" VPOS="1977" WIDTH="1765" HEIGHT="51" BASELINE="333 2010 2098 2010" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="333 2010 333 2028 2096 2028 2098 2010 2096 1981 333 1977 333 2010"/>
                        </Shape>
                        <String CONTENT="This cousin, in former times, also had owned a large herd, but he had squan-"/>
                    </TextLine>

