                        </Shape>
                        <String CONTENT="father cedes to the son the master’s side (aig̣ɪs˙qaoroˊn, “the left one.”)¹ If,"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l5" HPOS="321" VPOS="712" WIDTH="1774" HEIGHT="59" BASELINE="323 757 2095 751" TAGREFS="TYPE_6">
