                        </Shape>
                        <String CONTENT="however, they should prefer to have separate houses, the father gives over"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l6" HPOS="323" VPOS="772" WIDTH="1770" HEIGHT="59" BASELINE="325 815 2093 811" TAGREFS="TYPE_6">
