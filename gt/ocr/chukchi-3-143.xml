                        </Shape>
                        <String CONTENT="to the son the front house, and puts up for himself a new house in the rear."/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l7" HPOS="325" VPOS="835" WIDTH="1770" HEIGHT="52" BASELINE="325 874 2095 874" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="325 874 325 886 2091 887 2095 874 2091 835 325 841 325 874"/>
                        </Shape>
                        <String CONTENT="Still I found but few facts corroborating this information. Everywhere old"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l8" HPOS="323" VPOS="889" WIDTH="1772" HEIGHT="61" BASELINE="325 936 2095 928" TAGREFS="TYPE_6">
