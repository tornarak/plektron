                        </Shape>
                        <String CONTENT="three brothers, sons of Taˊtko, though the eldest of them was reported to be"/>
                    </TextLine>

                    <TextLine ID="mz_3-143_l25" HPOS="329" VPOS="1909" WIDTH="1767" HEIGHT="58" BASELINE="331 1952 2096 1948" TAGREFS="TYPE_6">
