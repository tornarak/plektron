                        </Shape>
                        <String CONTENT="V. — DOG-BREEDING."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-128_r2" HPOS="597" VPOS="993" WIDTH="1778" HEIGHT="558" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="597 993 2375 993 2375 1551 597 1551"/>
                    </Shape>
                    <TextLine ID="mz_1-128_l2" HPOS="702" VPOS="998" WIDTH="1670" HEIGHT="71" BASELINE="704 1043 2372 1039" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2348 1004 2326 1004 2317 1004 2309 1009 2270 1002 2261 1002 2239 1002 2218 1000 2196 1000 2190 1000 1973 1009 1886 998 1884 998 1828 1009 1750 998 1748 998 1670 1009 1585 998 1583 998 1581 998 1531 1011 723 1000 721 1000 719 1000 717 1000 702 1009 704 1043 704 1058 1237 1069 1239 1069 1295 1058 1471 1067 1473 1067 1700 1056 1793 1067 1795 1067 1919 1056 2088 1067 2090 1067 2142 1056 2333 1067 2335 1067 2337 1067 2372 1054 2372 1039 2369 1011 2354 1004 2348 1004"/>
                        </Shape>
                        <String CONTENT="GROUPS OF DOG-BREEDING TRIBES. — The origin of dog-team driving is"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l3" HPOS="598" VPOS="1061" WIDTH="1769" HEIGHT="58" BASELINE="600 1104 2367 1099" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1104 600 1119 2365 1117 2367 1099 2363 1071 1484 1061 1481 1061 1479 1061 1477 1061 1462 1071 641 1063 639 1063 637 1063 598 1073 600 1104"/>
                        </Shape>
                        <String CONTENT="still more obscure than that of the domestication of the reindeer. In Asia"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l4" HPOS="598" VPOS="1121" WIDTH="1776" HEIGHT="61" BASELINE="600 1164 2374 1158" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1164 600 1182 2372 1175 2374 1158 2369 1121 1200 1121 1198 1121 1196 1121 1172 1132 617 1123 615 1123 613 1123 611 1123 598 1130 600 1164"/>
                        </Shape>
                        <String CONTENT="there are three groups of dog-driving tribes, differing in their methods of"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l5" HPOS="598" VPOS="1180" WIDTH="1774" HEIGHT="60" BASELINE="600 1225 2372 1221" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1225 600 1240 2369 1236 2372 1221 2361 1190 2322 1180 2320 1180 2317 1180 2315 1180 2285 1190 2142 1180 2140 1180 2138 1180 2103 1190 2049 1180 2047 1180 1967 1190 1878 1180 1876 1180 1806 1190 1605 1180 1603 1180 1427 1193 1230 1182 1228 1182 1141 1193 1016 1182 1014 1182 1012 1182 979 1193 914 1182 912 1182 910 1182 873 1193 782 1182 780 1182 598 1188 600 1225"/>
                        </Shape>
                        <String CONTENT="harnessing, the shape of harness and sledge, etc. Those belonging to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l6" HPOS="596" VPOS="1245" WIDTH="1776" HEIGHT="58" BASELINE="598 1286 2372 1279" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1286 598 1303 2369 1296 2372 1279 2359 1249 609 1245 607 1245 604 1245 602 1245 602 1247 596 1251 598 1286"/>
                        </Shape>
                        <String CONTENT="first group, who inhabit northwestern Siberia, use a peculiar circular strap that"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l7" HPOS="600" VPOS="1303" WIDTH="1772" HEIGHT="65" BASELINE="602 1346 2372 1342" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="602 1346 602 1368 2372 1355 2372 1342 2361 1309 635 1303 633 1303 630 1303 600 1314 602 1346"/>
                        </Shape>
                        <String CONTENT="girds the dog’s body about the middle, like a belt, and without bands across"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l8" HPOS="598" VPOS="1364" WIDTH="1771" HEIGHT="58" BASELINE="600 1407 2369 1400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1407 600 1422 2367 1418 2369 1400 2365 1370 620 1364 617 1364 615 1364 613 1364 598 1370 600 1407"/>
                        </Shape>
                        <String CONTENT="the shoulders, so that the dog can pull only with the hind-part of its body"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l9" HPOS="598" VPOS="1424" WIDTH="1771" HEIGHT="57" BASELINE="600 1468 2369 1461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 1468 600 1481 2367 1474 2369 1461 2365 1431 611 1424 609 1424 607 1424 604 1424 604 1426 598 1431 600 1468"/>
                        </Shape>
                        <String CONTENT="(Fig. 20, a). This method of harnessing does not work well: the dogs do"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l10" HPOS="598" VPOS="1478" WIDTH="1767" HEIGHT="65" BASELINE="600 1526 2365 1519" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1517 600 1526 600 1543 2363 1543 2365 1519 2363 1491 2317 1478 2315 1478 2313 1478 2311 1478 2309 1478 2289 1491 1945 1491 1863 1478 1860 1478 1772 1491 1445 1481 1442 1481 1384 1491 1323 1481 1321 1481 1319 1481 1317 1481 1304 1491 1250 1481 1248 1481 1170 1494 1135 1483 1133 1483 1131 1483 812 1494 708 1483 706 1483 607 1496 598 1517"/>
                        </Shape>
                        <String CONTENT="not draw as heavy loads as the East Siberian teams, and they go more slowly."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-128_r3" HPOS="597" VPOS="2402" WIDTH="1778" HEIGHT="547" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="597 2402 2375 2402 2375 2949 597 2949"/>
                    </Shape>
                    <TextLine ID="mz_1-128_l11" HPOS="704" VPOS="2409" WIDTH="1670" HEIGHT="65" BASELINE="706 2453 2374 2446" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2453 706 2466 1739 2474 1741 2474 2372 2461 2374 2446 2367 2409 704 2416 706 2453"/>
                        </Shape>
                        <String CONTENT="East of the Lena River, and as far south as the Amur, all fishing and"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l12" HPOS="596" VPOS="2468" WIDTH="1773" HEIGHT="67" BASELINE="598 2511 2369 2507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 2511 598 2524 1356 2535 1358 2535 1419 2524 1477 2535 1479 2535 1481 2535 1523 2522 1562 2533 1564 2533 1566 2533 1722 2522 1795 2533 1798 2533 1897 2522 1928 2533 1930 2533 1932 2533 2012 2522 2038 2533 2040 2533 2042 2535 2203 2535 2203 2533 2268 2522 2328 2533 2330 2533 2333 2533 2369 2520 2369 2507 2365 2479 1484 2468 1481 2468 1419 2479 669 2470 667 2470 596 2481 598 2511"/>
                        </Shape>
                        <String CONTENT="seal-hunting tribes use dog-teams with uniform sledge and harness. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l13" HPOS="598" VPOS="2531" WIDTH="1769" HEIGHT="56" BASELINE="600 2572 2367 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2572 600 2587 2365 2583 2367 2565 2363 2537 620 2531 617 2531 615 2531 613 2531 598 2537 600 2572"/>
                        </Shape>
                        <String CONTENT="sledge has three or four pairs of stanchions and a circular fore-part.¹ The"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l14" HPOS="600" VPOS="2600" WIDTH="1769" HEIGHT="50" BASELINE="600 2630 2369 2630" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2630 600 2645 2367 2650 2369 2630 2369 2600 600 2600 600 2630"/>
                        </Shape>
                        <String CONTENT="dogs are attached in pairs to a long, thick strap, in place of a whiffletree,"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l15" HPOS="598" VPOS="2647" WIDTH="1774" HEIGHT="61" BASELINE="600 2691 2372 2684" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2691 600 2708 2369 2702 2372 2684 2367 2656 1191 2647 1189 2647 1187 2647 1157 2658 639 2650 637 2650 635 2650 598 2660 600 2691"/>
                        </Shape>
                        <String CONTENT="with about a fathom’s distance between the pairs; and a full team consists"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l16" HPOS="598" VPOS="2708" WIDTH="1771" HEIGHT="59" BASELINE="600 2751 2369 2747" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2751 600 2767 2367 2762 2369 2747 2365 2719 1484 2708 1481 2708 1479 2708 1477 2708 1477 2710 1466 2719 635 2710 633 2710 630 2710 598 2721 600 2751"/>
                        </Shape>
                        <String CONTENT="of six or seven pairs. The course is directed by the voice, with special call-"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l17" HPOS="600" VPOS="2777" WIDTH="1772" HEIGHT="50" BASELINE="600 2810 2372 2810" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2810 600 2827 2372 2827 2372 2810 2369 2777 600 2777 600 2810"/>
                        </Shape>
                        <String CONTENT="words. These are understood and obeyed by the leading dog, which is trained"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l18" HPOS="598" VPOS="2827" WIDTH="1769" HEIGHT="61" BASELINE="600 2870 2367 2866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2870 600 2888 2365 2888 2367 2866 2363 2838 1553 2827 1551 2827 1468 2838 693 2829 691 2829 598 2840 600 2870"/>
                        </Shape>
                        <String CONTENT="specially for that purpose. The harness is somewhat similar to the ordinary"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l19" HPOS="600" VPOS="2892" WIDTH="1728" HEIGHT="63" BASELINE="600 2927 2328 2931" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 2927 600 2944 1380 2944 1501 2955 1503 2955 2326 2944 2328 2931 2326 2901 600 2892 600 2927"/>
                        </Shape>
                        <String CONTENT="horse-harness, with a breast-piece, and two or three bands across the back."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-128_r4" HPOS="597" VPOS="2949" WIDTH="1778" HEIGHT="68" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="597 2949 2375 2949 2375 3017 597 3017"/>
                    </Shape>
                    <TextLine ID="mz_1-128_l20" HPOS="708" VPOS="2948" WIDTH="1659" HEIGHT="65" BASELINE="708 2992 2367 2992" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="708 2992 708 3005 2365 3013 2367 2992 2367 2959 2346 2948 2343 2948 2341 2948 2339 2948 2296 2961 2142 2961 2125 2948 2122 2948 2120 2948 2118 2948 2060 2959 2036 2948 2034 2948 1941 2948 1938 2948 1936 2948 1934 2948 1919 2959 1852 2948 1850 2948 1847 2948 1819 2959 1806 2948 1804 2948 1802 2948 1711 2948 1709 2948 1707 2948 1705 2948 1692 2959 1635 2948 1633 2948 1542 2961 1453 2961 1438 2948 1436 2948 1434 2948 1432 2948 1429 2948 1399 2961 1261 2961 1245 2948 1243 2948 1241 2948 1239 2948 1118 2959 708 2955 708 2992"/>
                        </Shape>
                        <String CONTENT="The third group of tribes — those of the Chukchee Peninsula — used,"/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-128_r5" HPOS="597" VPOS="3033" WIDTH="1778" HEIGHT="225" TAGREFS="TYPE_3">
<Shape>
                        <Polygon POINTS="597 3033 2375 3033 2375 3258 597 3258"/>
                    </Shape>
                    <TextLine ID="mz_1-128_l21" HPOS="706" VPOS="3039" WIDTH="1666" HEIGHT="48" BASELINE="708 3067 2372 3072" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="708 3067 706 3083 2367 3087 2372 3072 2369 3044 708 3039 708 3067"/>
                        </Shape>
                        <String CONTENT="¹ In the collections of the Smithsonian Institution, in Washington, I saw a sledge of the Alaskan Eskimo,"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l22" HPOS="600" VPOS="3085" WIDTH="1769" HEIGHT="43" BASELINE="602 3113 2369 3111" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="602 3113 602 3128 2367 3126 2369 3111 2363 3085 600 3085 602 3113"/>
                        </Shape>
                        <String CONTENT="which, curiously enough, is similar in shape to a Siberian form of sledge used by the Gilyaks of the Amur"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l23" HPOS="600" VPOS="3128" WIDTH="1772" HEIGHT="46" BASELINE="600 3154 2372 3154" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="600 3154 600 3174 2372 3174 2372 3154 2372 3128 600 3128 600 3154"/>
                        </Shape>
                        <String CONTENT="River. Its runners are bent upwards at both ends, and are joined by a horizontal bow similar to that at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l24" HPOS="600" VPOS="3165" WIDTH="1769" HEIGHT="52" BASELINE="602 3193 2369 3200" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="602 3193 600 3210 2365 3217 2369 3200 2367 3171 602 3165 602 3193"/>
                        </Shape>
                        <String CONTENT="front end of the Chukchee sledge (p. 105). The stanchions, too, are similar in shape, only their upper ends"/>
                    </TextLine>

                    <TextLine ID="mz_1-128_l25" HPOS="604" VPOS="3213" WIDTH="1189" HEIGHT="47" BASELINE="604 3241 1793 3241" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="604 3241 604 3260 1793 3260 1793 3241 1793 3213 604 3213 604 3241"/>
                        </Shape>
                        <String CONTENT="are bent inward and fastened to cross-pieces, in the usual Eskimo manner."/>
                    </TextLine>
</TextBlock>
