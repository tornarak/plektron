                    </TextLine>

                    <TextLine ID="mz_2-007_l19" HPOS="425" VPOS="1500" WIDTH="1114" HEIGHT="43" BASELINE="426 1525 1539 1529" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="426 1525 425 1539 1535 1543 1539 1529 1537 1504 426 1500 426 1525"/>
                        </Shape>
