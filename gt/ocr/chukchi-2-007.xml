                    </TextLine>

                    <TextLine ID="mz_2-007_l16" HPOS="423" VPOS="1359" WIDTH="1772" HEIGHT="49" BASELINE="425 1392 2195 1384" TAGREFS="TYPE_6">
                        <Shape>
