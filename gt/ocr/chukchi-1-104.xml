                <TextBlock ID="mz_1-104_r2" HPOS="624" VPOS="712" WIDTH="1778" HEIGHT="726" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="624 712 2402 712 2402 1438 624 1438"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l3" HPOS="622" VPOS="721" WIDTH="1778" HEIGHT="54" BASELINE="624 753 2400 760" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2378 727 2356 727 2354 725 624 721 624 753 622 766 2395 775 2400 760 2398 727 2378 727"/>
                        </Shape>
                        <String CONTENT="its abundant pasture, because they would lose half of their reindeer among"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l4" HPOS="626" VPOS="781" WIDTH="1776" HEIGHT="59" BASELINE="628 812 2402 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 812 626 829 641 840 643 840 646 840 648 840 2400 831 2402 816 2400 786 628 781 628 812"/>
                        </Shape>
                        <String CONTENT="those of their neighbors. In other, more spacious districts the reindeer-breeders"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l5" HPOS="626" VPOS="840" WIDTH="1774" HEIGHT="60" BASELINE="628 872 2400 876" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 872 626 887 702 900 704 900 2398 892 2400 876 2398 846 628 840 628 872"/>
                        </Shape>
                        <String CONTENT="keep a careful eye on the grounds around their summer camps, because they"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l6" HPOS="628" VPOS="902" WIDTH="1770" HEIGHT="50" BASELINE="628 935 2398 935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 935 628 950 2395 952 2398 935 2398 907 628 902 628 935"/>
                        </Shape>
                        <String CONTENT="have to take the herd there for the ceremonials and slaughtering of the early"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l7" HPOS="624" VPOS="967" WIDTH="1771" HEIGHT="52" BASELINE="624 998 2395 998" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 998 624 1011 2393 1019 2395 998 2395 967 624 967 624 998"/>
                        </Shape>
                        <String CONTENT="fall. Therefore trespassing on these pastures is held to be a grave offence,"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l8" HPOS="626" VPOS="1026" WIDTH="1776" HEIGHT="47" BASELINE="626 1056 2402 1056" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1056 626 1073 2402 1073 2402 1056 2402 1026 626 1026 626 1056"/>
                        </Shape>
                        <String CONTENT="and leads to quarrels and fighting. In the winter-time, trouble often arises, not"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l9" HPOS="626" VPOS="1082" WIDTH="1778" HEIGHT="52" BASELINE="626 1117 2404 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1117 626 1134 2404 1134 2404 1117 2402 1082 626 1084 626 1117"/>
                        </Shape>
                        <String CONTENT="from the encroachment upon pastures, but rather from the entanglement of"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l10" HPOS="624" VPOS="1141" WIDTH="1778" HEIGHT="52" BASELINE="626 1171 2402 1175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1171 624 1188 2398 1193 2402 1175 2400 1145 626 1141 626 1171"/>
                        </Shape>
                        <String CONTENT="the herds grazing together on the same spot, the separation of which requires"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l11" HPOS="624" VPOS="1190" WIDTH="1776" HEIGHT="68" BASELINE="626 1232 2400 1240" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1232 624 1249 637 1258 639 1258 641 1258 643 1258 2398 1255 2400 1240 2398 1210 2337 1197 2335 1197 1854 1206 1832 1195 1830 1195 1828 1195 1603 1206 1570 1195 1568 1195 1566 1195 1564 1195 1529 1206 1479 1193 1477 1193 1475 1193 1360 1203 1334 1193 1332 1193 1330 1193 1213 1203 1165 1193 1163 1193 1161 1193 1159 1193 1137 1203 1115 1193 1113 1193 1111 1193 1109 1193 1070 1203 1009 1190 1007 1190 1005 1190 977 1201 873 1190 871 1190 626 1199 626 1232"/>
                        </Shape>
                        <String CONTENT="considerable work and time. A rich breeder who finds a poor neighbor coming"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l12" HPOS="624" VPOS="1262" WIDTH="1774" HEIGHT="54" BASELINE="626 1292 2398 1299" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1292 624 1307 2393 1316 2398 1299 2395 1268 626 1262 626 1292"/>
                        </Shape>
                        <String CONTENT="too near, always suspects that the latter wants the herds to become entangled,"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l13" HPOS="624" VPOS="1320" WIDTH="1778" HEIGHT="63" BASELINE="626 1351 2402 1357" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1351 624 1368 1356 1383 1358 1383 2400 1374 2402 1357 2400 1327 626 1320 626 1351"/>
                        </Shape>
                        <String CONTENT="that he may have an opportunity of appropriating some stray animals, whose"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l14" HPOS="624" VPOS="1381" WIDTH="593" HEIGHT="56" BASELINE="626 1411 1217 1418" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1411 624 1429 637 1437 639 1437 641 1437 643 1437 1215 1431 1217 1418 1215 1387 626 1381 626 1411"/>
                        </Shape>
                        <String CONTENT="ear-marks he can change."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-104_r3" HPOS="624" VPOS="1438" WIDTH="1778" HEIGHT="477" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="624 1438 2402 1438 2402 1915 624 1915"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l15" HPOS="736" VPOS="1431" WIDTH="1664" HEIGHT="63" BASELINE="739 1472 2400 1478" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="739 1472 736 1487 2395 1494 2400 1478 2398 1448 2307 1435 2304 1435 2302 1435 2270 1446 2196 1435 2194 1435 2105 1446 2079 1435 2077 1435 2075 1435 2010 1446 1982 1435 1980 1435 1977 1435 1975 1435 1951 1446 1921 1435 1919 1435 1917 1435 1915 1435 1893 1446 1834 1433 1832 1433 1830 1433 1789 1444 1750 1433 1748 1433 1746 1433 1744 1433 1702 1444 1663 1433 1661 1433 1659 1433 1657 1433 1629 1444 1590 1433 1588 1433 1585 1433 1583 1433 1549 1444 1514 1433 1512 1433 1510 1433 1455 1444 1263 1444 1248 1431 1245 1431 1243 1431 1241 1431 1239 1431 1209 1442 739 1435 739 1472"/>
                        </Shape>
                        <String CONTENT="The reindeer scrape the snow with the hoofs of their fore-feet, the sharp"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l16" HPOS="624" VPOS="1502" WIDTH="1774" HEIGHT="50" BASELINE="626 1535 2398 1539" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1535 624 1548 2393 1552 2398 1539 2395 1506 626 1502 626 1535"/>
                        </Shape>
                        <String CONTENT="rims and pointed ends of which penetrate the snow, even when covered with"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l17" HPOS="624" VPOS="1563" WIDTH="1771" HEIGHT="54" BASELINE="626 1593 2395 1600" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1593 624 1608 635 1617 637 1617 639 1617 641 1617 2393 1610 2395 1600 2393 1569 626 1563 626 1593"/>
                        </Shape>
                        <String CONTENT="a very hard crust. But wherever the snow is very heavy, — for instance, in"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l18" HPOS="624" VPOS="1623" WIDTH="1776" HEIGHT="48" BASELINE="626 1654 2400 1658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1654 624 1667 2395 1671 2400 1658 2398 1628 626 1623 626 1654"/>
                        </Shape>
                        <String CONTENT="the thick of the forests, — the reindeer soon become tired, and want to lie"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l19" HPOS="624" VPOS="1682" WIDTH="1774" HEIGHT="50" BASELINE="626 1714 2398 1719" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1714 624 1727 2393 1732 2398 1719 2395 1686 626 1682 626 1714"/>
                        </Shape>
                        <String CONTENT="down before they have had enough to eat. Reindeer-breeders, therefore, do"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l20" HPOS="626" VPOS="1742" WIDTH="1774" HEIGHT="57" BASELINE="628 1775 2400 1779" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1775 626 1790 639 1799 641 1799 643 1799 646 1799 2398 1790 2400 1779 2398 1747 628 1742 628 1775"/>
                        </Shape>
                        <String CONTENT="not like to go too far into the forest. The hills of the forest-border are most"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l21" HPOS="624" VPOS="1803" WIDTH="1776" HEIGHT="50" BASELINE="626 1836 2400 1840" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1836 624 1849 2395 1853 2400 1840 2398 1807 626 1803 626 1836"/>
                        </Shape>
                        <String CONTENT="favorable for them, because on their slopes snow is always scarce, and moss"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l22" HPOS="626" VPOS="1853" WIDTH="232" HEIGHT="61" BASELINE="626 1894 858 1894" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1894 626 1914 858 1914 858 1894 858 1866 661 1853 659 1853 656 1853 626 1864 626 1894"/>
                        </Shape>
                        <String CONTENT="abundant."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-104_r4" HPOS="624" VPOS="1915" WIDTH="1778" HEIGHT="1208" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="624 1915 2402 1915 2402 3123 624 3123"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l23" HPOS="739" VPOS="1911" WIDTH="1663" HEIGHT="63" BASELINE="739 1957 2402 1957" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="739 1957 739 1974 2402 1974 2402 1957 2402 1924 2346 1911 2343 1911 2341 1911 2339 1911 2337 1911 2317 1924 2300 1911 2298 1911 2296 1911 2294 1911 2291 1911 2261 1927 2131 1927 2109 1911 2107 1911 2105 1911 2103 1911 2101 1911 2045 1924 1982 1911 1980 1911 1977 1911 1975 1911 1958 1924 1910 1911 1908 1911 1906 1911 1904 1911 1880 1924 1854 1911 1852 1911 1850 1911 1847 1911 1795 1924 1754 1911 1752 1911 1750 1911 1748 1911 1746 1911 1728 1924 1683 1911 1681 1911 1679 1911 1572 1924 1518 1911 1516 1911 1514 1911 1399 1924 1336 1911 1334 1911 1332 1911 1302 1924 1206 1911 1204 1911 1202 1911 1170 1924 1109 1911 1107 1911 1105 1911 1048 1924 981 1911 979 1911 977 1911 940 1922 871 1911 869 1911 866 1911 864 1911 847 1924 739 1916 739 1957"/>
                        </Shape>
                        <String CONTENT="The females calve from the middle of March till the breaking-up of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l24" HPOS="622" VPOS="1972" WIDTH="1778" HEIGHT="71" BASELINE="624 2015 2400 2020" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2015 622 2026 700 2041 702 2041 704 2041 734 2030 836 2041 838 2041 840 2041 869 2030 1239 2041 1241 2041 1442 2030 1568 2043 1570 2043 1572 2043 1603 2033 1776 2033 1808 2043 1811 2043 1813 2043 1815 2043 1860 2033 1921 2043 1923 2043 2398 2030 2400 2020 2400 1989 2354 1974 2352 1974 2350 1974 2348 1974 2313 1987 2276 1974 2274 1974 2272 1974 2270 1974 2224 1989 2142 1989 2118 1974 2116 1974 2114 1974 2112 1974 2051 1985 2025 1974 2023 1974 2021 1974 2019 1974 2016 1974 1997 1987 1795 1974 1793 1974 1791 1974 1789 1974 1769 1989 1715 1989 1644 1974 1642 1974 1572 1987 1475 1972 1473 1972 1471 1972 1438 1985 1388 1972 1386 1972 1384 1972 1313 1985 1219 1972 1128 1972 1126 1972 1124 1972 1096 1985 1066 1972 1063 1972 1061 1972 990 1985 916 1972 914 1972 912 1972 877 1987 788 1987 769 1972 767 1972 765 1972 762 1972 760 1972 730 1985 650 1972 648 1972 646 1972 624 1981 624 2015"/>
                        </Shape>
                        <String CONTENT="ice; i. e., the end of May. The fawns, after a few days, begin to dig for"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l25" HPOS="626" VPOS="2039" WIDTH="1776" HEIGHT="63" BASELINE="628 2074 2402 2078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2074 626 2087 856 2100 858 2100 1514 2091 1536 2102 1538 2102 1540 2102 2400 2091 2402 2078 2398 2039 628 2041 628 2074"/>
                        </Shape>
                        <String CONTENT="moss. They are weak, and sensitive to frost and hunger; and hundreds of"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l26" HPOS="624" VPOS="2100" WIDTH="1776" HEIGHT="65" BASELINE="626 2130 2400 2139" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2130 624 2147 639 2158 641 2158 643 2158 646 2158 1070 2150 1971 2165 1973 2165 2398 2154 2400 2139 2398 2108 626 2100 626 2130"/>
                        </Shape>
                        <String CONTENT="them perish under unfavorable conditions (in the average year, about fifteen"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l27" HPOS="624" VPOS="2154" WIDTH="1776" HEIGHT="63" BASELINE="626 2199 2400 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2199 626 2217 2398 2210 2400 2195 2395 2167 2281 2154 2278 2154 2276 2154 2274 2154 2259 2167 2114 2167 2097 2154 2094 2154 2092 2154 2090 2154 2088 2154 2086 2154 2071 2167 1982 2167 1956 2154 1954 2154 1951 2154 1949 2154 1906 2165 1884 2154 1882 2154 1880 2154 1746 2165 1674 2154 1672 2154 1670 2154 1668 2154 1650 2165 1172 2156 1170 2156 1167 2156 1126 2167 1050 2156 1048 2156 1046 2156 1003 2167 903 2156 901 2156 899 2156 860 2167 821 2156 819 2156 817 2156 624 2169 626 2199"/>
                        </Shape>
                        <String CONTENT="per cent). The wild reindeer calves two or three weeks later, in accordance"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l28" HPOS="626" VPOS="2212" WIDTH="1774" HEIGHT="70" BASELINE="628 2253 2400 2258" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2253 626 2266 780 2279 782 2279 1512 2271 1533 2282 1536 2282 1538 2282 2398 2271 2400 2258 2398 2227 2125 2214 2122 2214 1971 2225 1943 2214 1941 2214 1938 2214 1884 2225 1858 2214 1856 2214 1854 2214 1793 2225 1765 2214 1763 2214 1761 2214 1759 2214 1724 2225 1666 2214 1663 2214 1601 2225 1540 2214 1538 2214 1536 2214 1514 2225 1479 2212 1477 2212 1475 2212 1473 2212 1445 2223 1412 2212 1410 2212 1408 2212 1315 2225 1089 2225 1066 2212 1063 2212 1061 2212 628 2221 628 2253"/>
                        </Shape>
                        <String CONTENT="with its later rutting-season. This is favorable for the fawns, which do not"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l29" HPOS="628" VPOS="2284" WIDTH="1774" HEIGHT="54" BASELINE="628 2314 2402 2318" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2314 628 2338 2400 2331 2402 2318 2400 2288 628 2284 628 2314"/>
                        </Shape>
                        <String CONTENT="perish in such numbers as in the domesticated herds. During calving-time"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l30" HPOS="624" VPOS="2342" WIDTH="1776" HEIGHT="56" BASELINE="626 2372 2400 2379" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2372 624 2385 691 2398 693 2398 2398 2392 2400 2379 2398 2347 626 2342 626 2372"/>
                        </Shape>
                        <String CONTENT="the herdsmen resort to an open place well sheltered from north winds, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l31" HPOS="626" VPOS="2401" WIDTH="1772" HEIGHT="52" BASELINE="628 2433 2398 2440" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2433 626 2446 2393 2453 2398 2440 2395 2403 628 2401 628 2433"/>
                        </Shape>
                        <String CONTENT="with little snow; as otherwise the females will lack milk, and the fawns will"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l32" HPOS="624" VPOS="2457" WIDTH="1774" HEIGHT="56" BASELINE="626 2494 2398 2500" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2494 624 2507 2393 2513 2398 2500 2395 2468 626 2457 626 2494"/>
                        </Shape>
                        <String CONTENT="be starved. In all the larger herds the pregnant females, before calving, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l33" HPOS="624" VPOS="2522" WIDTH="1776" HEIGHT="52" BASELINE="626 2552 2400 2559" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2552 624 2567 2395 2574 2400 2559 2398 2528 626 2522 626 2552"/>
                        </Shape>
                        <String CONTENT="separated from the bucks, harness-animals, etc.; and each part of the herd is"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l34" HPOS="626" VPOS="2587" WIDTH="1774" HEIGHT="47" BASELINE="626 2617 2400 2617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2617 626 2634 2400 2630 2400 2617 2400 2587 626 2587 626 2617"/>
                        </Shape>
                        <String CONTENT="pastured on separate grounds. Otherwise the bucks would injure the fawns"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l35" HPOS="624" VPOS="2639" WIDTH="1776" HEIGHT="52" BASELINE="626 2673 2400 2678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2673 624 2686 2395 2691 2400 2678 2398 2643 626 2639 626 2673"/>
                        </Shape>
                        <String CONTENT="in their runs, which occur several times a day. The two parts of the herd"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l36" HPOS="622" VPOS="2693" WIDTH="1776" HEIGHT="58" BASELINE="624 2734 2398 2738" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2734 622 2747 2393 2751 2398 2738 2395 2708 2231 2695 2229 2695 2226 2695 2194 2706 2112 2695 2109 2695 2107 2695 2060 2708 1886 2708 1871 2695 1869 2695 1867 2695 1865 2695 1776 2706 1748 2695 1746 2695 1744 2695 1670 2706 1618 2695 1616 2695 1614 2695 1579 2706 1538 2695 1536 2695 1533 2695 1209 2704 1183 2693 1180 2693 1178 2693 1176 2693 1146 2704 1100 2693 1098 2693 1096 2693 1033 2704 994 2693 992 2693 990 2693 927 2704 869 2693 866 2693 624 2702 624 2734"/>
                        </Shape>
                        <String CONTENT="are joined again late in summer, or in the fall of the year, when they are"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l37" HPOS="622" VPOS="2762" WIDTH="1778" HEIGHT="59" BASELINE="624 2793 2400 2799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2793 622 2805 1237 2821 1239 2821 2398 2812 2400 2799 2398 2769 624 2762 624 2793"/>
                        </Shape>
                        <String CONTENT="returning from the summer pastures. The reindeer-doe begins to rut when one"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l38" HPOS="626" VPOS="2823" WIDTH="1772" HEIGHT="52" BASELINE="626 2853 2398 2857" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2853 626 2875 2395 2870 2398 2857 2395 2827 626 2823 626 2853"/>
                        </Shape>
                        <String CONTENT="year old; but some begin in the same year in which they were born. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l39" HPOS="626" VPOS="2870" WIDTH="1772" HEIGHT="63" BASELINE="628 2912 2398 2920" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 2912 626 2925 2393 2933 2398 2920 2395 2890 2131 2877 2129 2877 1958 2888 1912 2875 1910 2875 1908 2875 1906 2875 1871 2886 1826 2875 1824 2875 1821 2875 1360 2883 1328 2873 1326 2873 1323 2873 1321 2873 1284 2886 1072 2886 1027 2870 1025 2870 1022 2870 1020 2870 988 2881 951 2870 949 2870 947 2870 628 2879 628 2912"/>
                        </Shape>
                        <String CONTENT="more favorable the summer, the more frequent will be the cases of half-grown"/>
                    </TextLine>

