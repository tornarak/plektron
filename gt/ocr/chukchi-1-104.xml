                <TextBlock ID="mz_1-104_r2" HPOS="645" VPOS="727" WIDTH="1778" HEIGHT="726" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="645 727 2423 727 2423 1453 645 1453"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l3" HPOS="643" VPOS="736" WIDTH="1778" HEIGHT="54" BASELINE="645 768 2421 775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2399 742 2377 742 2375 740 645 736 645 768 643 781 2416 790 2421 775 2419 742 2399 742"/>
                        </Shape>
                        <String CONTENT="its abundant pasture, because they would lose half of their reindeer among"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l4" HPOS="647" VPOS="796" WIDTH="1776" HEIGHT="59" BASELINE="649 827 2423 831" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 827 647 844 662 855 664 855 667 855 669 855 2421 846 2423 831 2421 801 649 796 649 827"/>
                        </Shape>
                        <String CONTENT="those of their neighbors. In other, more spacious districts the reindeer-breeders"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l5" HPOS="647" VPOS="855" WIDTH="1774" HEIGHT="60" BASELINE="649 887 2421 891" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 887 647 902 723 915 725 915 2419 907 2421 891 2419 861 649 855 649 887"/>
                        </Shape>
                        <String CONTENT="keep a careful eye on the grounds around their summer camps, because they"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l6" HPOS="649" VPOS="917" WIDTH="1770" HEIGHT="50" BASELINE="649 950 2419 950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 950 649 965 2416 967 2419 950 2419 922 649 917 649 950"/>
                        </Shape>
                        <String CONTENT="have to take the herd there for the ceremonials and slaughtering of the early"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l7" HPOS="645" VPOS="982" WIDTH="1771" HEIGHT="52" BASELINE="645 1013 2416 1013" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 1013 645 1026 2414 1034 2416 1013 2416 982 645 982 645 1013"/>
                        </Shape>
                        <String CONTENT="fall. Therefore trespassing on these pastures is held to be a grave offence,"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l8" HPOS="647" VPOS="1041" WIDTH="1776" HEIGHT="47" BASELINE="647 1071 2423 1071" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1071 647 1088 2423 1088 2423 1071 2423 1041 647 1041 647 1071"/>
                        </Shape>
                        <String CONTENT="and leads to quarrels and fighting. In the winter-time, trouble often arises, not"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l9" HPOS="647" VPOS="1097" WIDTH="1778" HEIGHT="52" BASELINE="647 1132 2425 1132" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1132 647 1149 2425 1149 2425 1132 2423 1097 647 1099 647 1132"/>
                        </Shape>
                        <String CONTENT="from the encroachment upon pastures, but rather from the entanglement of"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l10" HPOS="645" VPOS="1156" WIDTH="1778" HEIGHT="52" BASELINE="647 1186 2423 1190" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1186 645 1203 2419 1208 2423 1190 2421 1160 647 1156 647 1186"/>
                        </Shape>
                        <String CONTENT="the herds grazing together on the same spot, the separation of which requires"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l11" HPOS="645" VPOS="1205" WIDTH="1776" HEIGHT="68" BASELINE="647 1247 2421 1255" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1247 645 1264 658 1273 660 1273 662 1273 664 1273 2419 1270 2421 1255 2419 1225 2358 1212 2356 1212 1875 1221 1853 1210 1851 1210 1849 1210 1624 1221 1591 1210 1589 1210 1587 1210 1585 1210 1550 1221 1500 1208 1498 1208 1496 1208 1381 1218 1355 1208 1353 1208 1351 1208 1234 1218 1186 1208 1184 1208 1182 1208 1180 1208 1158 1218 1136 1208 1134 1208 1132 1208 1130 1208 1091 1218 1030 1205 1028 1205 1026 1205 998 1216 894 1205 892 1205 647 1214 647 1247"/>
                        </Shape>
                        <String CONTENT="considerable work and time. A rich breeder who finds a poor neighbor coming"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l12" HPOS="645" VPOS="1277" WIDTH="1774" HEIGHT="54" BASELINE="647 1307 2419 1314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1307 645 1322 2414 1331 2419 1314 2416 1283 647 1277 647 1307"/>
                        </Shape>
                        <String CONTENT="too near, always suspects that the latter wants the herds to become entangled,"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l13" HPOS="645" VPOS="1335" WIDTH="1778" HEIGHT="63" BASELINE="647 1366 2423 1372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1366 645 1383 1377 1398 1379 1398 2421 1389 2423 1372 2421 1342 647 1335 647 1366"/>
                        </Shape>
                        <String CONTENT="that he may have an opportunity of appropriating some stray animals, whose"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l14" HPOS="645" VPOS="1396" WIDTH="593" HEIGHT="56" BASELINE="647 1426 1238 1433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1426 645 1444 658 1452 660 1452 662 1452 664 1452 1236 1446 1238 1433 1236 1402 647 1396 647 1426"/>
                        </Shape>
                        <String CONTENT="ear-marks he can change."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-104_r3" HPOS="645" VPOS="1453" WIDTH="1778" HEIGHT="477" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="645 1453 2423 1453 2423 1930 645 1930"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l15" HPOS="757" VPOS="1446" WIDTH="1664" HEIGHT="63" BASELINE="760 1487 2421 1493" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="760 1487 757 1502 2416 1509 2421 1493 2419 1463 2328 1450 2325 1450 2323 1450 2291 1461 2217 1450 2215 1450 2126 1461 2100 1450 2098 1450 2096 1450 2031 1461 2003 1450 2001 1450 1998 1450 1996 1450 1972 1461 1942 1450 1940 1450 1938 1450 1936 1450 1914 1461 1855 1448 1853 1448 1851 1448 1810 1459 1771 1448 1769 1448 1767 1448 1765 1448 1723 1459 1684 1448 1682 1448 1680 1448 1678 1448 1650 1459 1611 1448 1609 1448 1606 1448 1604 1448 1570 1459 1535 1448 1533 1448 1531 1448 1476 1459 1284 1459 1269 1446 1266 1446 1264 1446 1262 1446 1260 1446 1230 1457 760 1450 760 1487"/>
                        </Shape>
                        <String CONTENT="The reindeer scrape the snow with the hoofs of their fore-feet, the sharp"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l16" HPOS="645" VPOS="1517" WIDTH="1774" HEIGHT="50" BASELINE="647 1550 2419 1554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1550 645 1563 2414 1567 2419 1554 2416 1521 647 1517 647 1550"/>
                        </Shape>
                        <String CONTENT="rims and pointed ends of which penetrate the snow, even when covered with"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l17" HPOS="645" VPOS="1578" WIDTH="1771" HEIGHT="54" BASELINE="647 1608 2416 1615" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1608 645 1623 656 1632 658 1632 660 1632 662 1632 2414 1625 2416 1615 2414 1584 647 1578 647 1608"/>
                        </Shape>
                        <String CONTENT="a very hard crust. But wherever the snow is very heavy, — for instance, in"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l18" HPOS="645" VPOS="1638" WIDTH="1776" HEIGHT="48" BASELINE="647 1669 2421 1673" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1669 645 1682 2416 1686 2421 1673 2419 1643 647 1638 647 1669"/>
                        </Shape>
                        <String CONTENT="the thick of the forests, — the reindeer soon become tired, and want to lie"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l19" HPOS="645" VPOS="1697" WIDTH="1774" HEIGHT="50" BASELINE="647 1729 2419 1734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1729 645 1742 2414 1747 2419 1734 2416 1701 647 1697 647 1729"/>
                        </Shape>
                        <String CONTENT="down before they have had enough to eat. Reindeer-breeders, therefore, do"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l20" HPOS="647" VPOS="1757" WIDTH="1774" HEIGHT="57" BASELINE="649 1790 2421 1794" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 1790 647 1805 660 1814 662 1814 664 1814 667 1814 2419 1805 2421 1794 2419 1762 649 1757 649 1790"/>
                        </Shape>
                        <String CONTENT="not like to go too far into the forest. The hills of the forest-border are most"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l21" HPOS="645" VPOS="1818" WIDTH="1776" HEIGHT="50" BASELINE="647 1851 2421 1855" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1851 645 1864 2416 1868 2421 1855 2419 1822 647 1818 647 1851"/>
                        </Shape>
                        <String CONTENT="favorable for them, because on their slopes snow is always scarce, and moss"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l22" HPOS="647" VPOS="1868" WIDTH="232" HEIGHT="61" BASELINE="647 1909 879 1909" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 1909 647 1929 879 1929 879 1909 879 1881 682 1868 680 1868 677 1868 647 1879 647 1909"/>
                        </Shape>
                        <String CONTENT="abundant."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-104_r4" HPOS="645" VPOS="1930" WIDTH="1778" HEIGHT="1208" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="645 1930 2423 1930 2423 3138 645 3138"/>
                    </Shape>
                    <TextLine ID="mz_1-104_l23" HPOS="760" VPOS="1926" WIDTH="1663" HEIGHT="63" BASELINE="760 1972 2423 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="760 1972 760 1989 2423 1989 2423 1972 2423 1939 2367 1926 2364 1926 2362 1926 2360 1926 2358 1926 2338 1939 2321 1926 2319 1926 2317 1926 2315 1926 2312 1926 2282 1942 2152 1942 2130 1926 2128 1926 2126 1926 2124 1926 2122 1926 2066 1939 2003 1926 2001 1926 1998 1926 1996 1926 1979 1939 1931 1926 1929 1926 1927 1926 1925 1926 1901 1939 1875 1926 1873 1926 1871 1926 1868 1926 1816 1939 1775 1926 1773 1926 1771 1926 1769 1926 1767 1926 1749 1939 1704 1926 1702 1926 1700 1926 1593 1939 1539 1926 1537 1926 1535 1926 1420 1939 1357 1926 1355 1926 1353 1926 1323 1939 1227 1926 1225 1926 1223 1926 1191 1939 1130 1926 1128 1926 1126 1926 1069 1939 1002 1926 1000 1926 998 1926 961 1937 892 1926 890 1926 887 1926 885 1926 868 1939 760 1931 760 1972"/>
                        </Shape>
                        <String CONTENT="The females calve from the middle of March till the breaking-up of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l24" HPOS="643" VPOS="1987" WIDTH="1778" HEIGHT="71" BASELINE="645 2030 2421 2035" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2030 643 2041 721 2056 723 2056 725 2056 755 2045 857 2056 859 2056 861 2056 890 2045 1260 2056 1262 2056 1463 2045 1589 2058 1591 2058 1593 2058 1624 2048 1797 2048 1829 2058 1832 2058 1834 2058 1836 2058 1881 2048 1942 2058 1944 2058 2419 2045 2421 2035 2421 2004 2375 1989 2373 1989 2371 1989 2369 1989 2334 2002 2297 1989 2295 1989 2293 1989 2291 1989 2245 2004 2163 2004 2139 1989 2137 1989 2135 1989 2133 1989 2072 2000 2046 1989 2044 1989 2042 1989 2040 1989 2037 1989 2018 2002 1816 1989 1814 1989 1812 1989 1810 1989 1790 2004 1736 2004 1665 1989 1663 1989 1593 2002 1496 1987 1494 1987 1492 1987 1459 2000 1409 1987 1407 1987 1405 1987 1334 2000 1240 1987 1149 1987 1147 1987 1145 1987 1117 2000 1087 1987 1084 1987 1082 1987 1011 2000 937 1987 935 1987 933 1987 898 2002 809 2002 790 1987 788 1987 786 1987 783 1987 781 1987 751 2000 671 1987 669 1987 667 1987 645 1996 645 2030"/>
                        </Shape>
                        <String CONTENT="ice; i. e., the end of May. The fawns, after a few days, begin to dig for"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l25" HPOS="647" VPOS="2054" WIDTH="1776" HEIGHT="63" BASELINE="649 2089 2423 2093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2089 647 2102 877 2115 879 2115 1535 2106 1557 2117 1559 2117 1561 2117 2421 2106 2423 2093 2419 2054 649 2056 649 2089"/>
                        </Shape>
                        <String CONTENT="moss. They are weak, and sensitive to frost and hunger; and hundreds of"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l26" HPOS="645" VPOS="2115" WIDTH="1776" HEIGHT="65" BASELINE="647 2145 2421 2154" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2145 645 2162 660 2173 662 2173 664 2173 667 2173 1091 2165 1992 2180 1994 2180 2419 2169 2421 2154 2419 2123 647 2115 647 2145"/>
                        </Shape>
                        <String CONTENT="them perish under unfavorable conditions (in the average year, about fifteen"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l27" HPOS="645" VPOS="2169" WIDTH="1776" HEIGHT="63" BASELINE="647 2214 2421 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2214 647 2232 2419 2225 2421 2210 2416 2182 2302 2169 2299 2169 2297 2169 2295 2169 2280 2182 2135 2182 2118 2169 2115 2169 2113 2169 2111 2169 2109 2169 2107 2169 2092 2182 2003 2182 1977 2169 1975 2169 1972 2169 1970 2169 1927 2180 1905 2169 1903 2169 1901 2169 1767 2180 1695 2169 1693 2169 1691 2169 1689 2169 1671 2180 1193 2171 1191 2171 1188 2171 1147 2182 1071 2171 1069 2171 1067 2171 1024 2182 924 2171 922 2171 920 2171 881 2182 842 2171 840 2171 838 2171 645 2184 647 2214"/>
                        </Shape>
                        <String CONTENT="per cent). The wild reindeer calves two or three weeks later, in accordance"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l28" HPOS="647" VPOS="2227" WIDTH="1774" HEIGHT="70" BASELINE="649 2268 2421 2273" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2268 647 2281 801 2294 803 2294 1533 2286 1554 2297 1557 2297 1559 2297 2419 2286 2421 2273 2419 2242 2146 2229 2143 2229 1992 2240 1964 2229 1962 2229 1959 2229 1905 2240 1879 2229 1877 2229 1875 2229 1814 2240 1786 2229 1784 2229 1782 2229 1780 2229 1745 2240 1687 2229 1684 2229 1622 2240 1561 2229 1559 2229 1557 2229 1535 2240 1500 2227 1498 2227 1496 2227 1494 2227 1466 2238 1433 2227 1431 2227 1429 2227 1336 2240 1110 2240 1087 2227 1084 2227 1082 2227 649 2236 649 2268"/>
                        </Shape>
                        <String CONTENT="with its later rutting-season. This is favorable for the fawns, which do not"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l29" HPOS="649" VPOS="2299" WIDTH="1774" HEIGHT="54" BASELINE="649 2329 2423 2333" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2329 649 2353 2421 2346 2423 2333 2421 2303 649 2299 649 2329"/>
                        </Shape>
                        <String CONTENT="perish in such numbers as in the domesticated herds. During calving-time"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l30" HPOS="645" VPOS="2357" WIDTH="1776" HEIGHT="56" BASELINE="647 2387 2421 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2387 645 2400 712 2413 714 2413 2419 2407 2421 2394 2419 2362 647 2357 647 2387"/>
                        </Shape>
                        <String CONTENT="the herdsmen resort to an open place well sheltered from north winds, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l31" HPOS="647" VPOS="2416" WIDTH="1772" HEIGHT="52" BASELINE="649 2448 2419 2455" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2448 647 2461 2414 2468 2419 2455 2416 2418 649 2416 649 2448"/>
                        </Shape>
                        <String CONTENT="with little snow; as otherwise the females will lack milk, and the fawns will"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l32" HPOS="645" VPOS="2472" WIDTH="1774" HEIGHT="56" BASELINE="647 2509 2419 2515" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2509 645 2522 2414 2528 2419 2515 2416 2483 647 2472 647 2509"/>
                        </Shape>
                        <String CONTENT="be starved. In all the larger herds the pregnant females, before calving, are"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l33" HPOS="645" VPOS="2537" WIDTH="1776" HEIGHT="52" BASELINE="647 2567 2421 2574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2567 645 2582 2416 2589 2421 2574 2419 2543 647 2537 647 2567"/>
                        </Shape>
                        <String CONTENT="separated from the bucks, harness-animals, etc.; and each part of the herd is"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l34" HPOS="647" VPOS="2602" WIDTH="1774" HEIGHT="47" BASELINE="647 2632 2421 2632" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2632 647 2649 2421 2645 2421 2632 2421 2602 647 2602 647 2632"/>
                        </Shape>
                        <String CONTENT="pastured on separate grounds. Otherwise the bucks would injure the fawns"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l35" HPOS="645" VPOS="2654" WIDTH="1776" HEIGHT="52" BASELINE="647 2688 2421 2693" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2688 645 2701 2416 2706 2421 2693 2419 2658 647 2654 647 2688"/>
                        </Shape>
                        <String CONTENT="in their runs, which occur several times a day. The two parts of the herd"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l36" HPOS="643" VPOS="2708" WIDTH="1776" HEIGHT="58" BASELINE="645 2749 2419 2753" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2749 643 2762 2414 2766 2419 2753 2416 2723 2252 2710 2250 2710 2247 2710 2215 2721 2133 2710 2130 2710 2128 2710 2081 2723 1907 2723 1892 2710 1890 2710 1888 2710 1886 2710 1797 2721 1769 2710 1767 2710 1765 2710 1691 2721 1639 2710 1637 2710 1635 2710 1600 2721 1559 2710 1557 2710 1554 2710 1230 2719 1204 2708 1201 2708 1199 2708 1197 2708 1167 2719 1121 2708 1119 2708 1117 2708 1054 2719 1015 2708 1013 2708 1011 2708 948 2719 890 2708 887 2708 645 2717 645 2749"/>
                        </Shape>
                        <String CONTENT="are joined again late in summer, or in the fall of the year, when they are"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l37" HPOS="643" VPOS="2777" WIDTH="1778" HEIGHT="59" BASELINE="645 2808 2421 2814" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="645 2808 643 2820 1258 2836 1260 2836 2419 2827 2421 2814 2419 2784 645 2777 645 2808"/>
                        </Shape>
                        <String CONTENT="returning from the summer pastures. The reindeer-doe begins to rut when one"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l38" HPOS="647" VPOS="2838" WIDTH="1772" HEIGHT="52" BASELINE="647 2868 2419 2872" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="647 2868 647 2890 2416 2885 2419 2872 2416 2842 647 2838 647 2868"/>
                        </Shape>
                        <String CONTENT="year old; but some begin in the same year in which they were born. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-104_l39" HPOS="647" VPOS="2885" WIDTH="1772" HEIGHT="63" BASELINE="649 2927 2419 2935" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="649 2927 647 2940 2414 2948 2419 2935 2416 2905 2152 2892 2150 2892 1979 2903 1933 2890 1931 2890 1929 2890 1927 2890 1892 2901 1847 2890 1845 2890 1842 2890 1381 2898 1349 2888 1347 2888 1344 2888 1342 2888 1305 2901 1093 2901 1048 2885 1046 2885 1043 2885 1041 2885 1009 2896 972 2885 970 2885 968 2885 649 2894 649 2927"/>
                        </Shape>
                        <String CONTENT="more favorable the summer, the more frequent will be the cases of half-grown"/>
                    </TextLine>

