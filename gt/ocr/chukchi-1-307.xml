                    <TextLine ID="mz_1-307_l20" HPOS="511" VPOS="1762" WIDTH="1671" HEIGHT="60" BASELINE="513 1809 2182 1803" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="513 1809 513 1822 2180 1816 2182 1803 2178 1773 1678 1762 1676 1762 1615 1775 511 1775 513 1809"/>
                        </Shape>
                        <String CONTENT="In former times the Maritime Chukchee on the Arctic shores used the"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l21" HPOS="404" VPOS="1833" WIDTH="1774" HEIGHT="50" BASELINE="407 1868 2178 1864" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1868 407 1883 2176 1881 2178 1864 2174 1833 404 1833 407 1868"/>
                        </Shape>
                        <String CONTENT="leg-skins of the white bear for making winter boots, including the soles. This"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l22" HPOS="407" VPOS="1881" WIDTH="1773" HEIGHT="61" BASELINE="409 1929 2180 1922" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1929 409 1942 2178 1939 2180 1922 2176 1894 2005 1881 2003 1881 1903 1892 1877 1881 1875 1881 1873 1881 1821 1892 1793 1881 1790 1881 1788 1881 1786 1881 1760 1892 1734 1881 1732 1881 1730 1881 1585 1894 1026 1883 1024 1883 1022 1883 994 1896 950 1885 948 1885 946 1885 944 1885 916 1896 900 1885 898 1885 896 1885 894 1885 736 1896 675 1885 673 1885 671 1885 647 1898 500 1898 420 1885 417 1885 415 1885 413 1885 413 1887 407 1892 409 1929"/>
                        </Shape>
                        <String CONTENT="fact was also noted by Nordenskiöld. These parts of the bear-skin are"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l23" HPOS="409" VPOS="1944" WIDTH="1771" HEIGHT="58" BASELINE="409 1985 2180 1985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1985 409 2002 2180 2002 2180 1985 2180 1957 1745 1944 1743 1944 1741 1944 1739 1944 1723 1957 1628 1957 1539 1944 1537 1944 1535 1944 1509 1954 1433 1944 1431 1944 1377 1954 1284 1944 1282 1944 1279 1944 1245 1954 1186 1944 1184 1944 1182 1944 1143 1954 1115 1944 1113 1944 1110 1944 955 1954 924 1944 922 1944 920 1944 827 1954 796 1944 794 1944 792 1944 667 1954 625 1944 623 1944 621 1944 619 1944 595 1954 550 1944 547 1944 545 1944 409 1954 409 1985"/>
                        </Shape>
                        <String CONTENT="exceedingly tough and covered with thick white hair, so they serve the pur-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l24" HPOS="407" VPOS="2002" WIDTH="1775" HEIGHT="69" BASELINE="409 2050 2182 2043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2050 409 2071 2180 2058 2182 2043 2178 2013 1626 2002 1624 2002 1622 2002 1580 2013 589 2006 586 2006 407 2017 409 2050"/>
                        </Shape>
                        <String CONTENT="pose well. Nowadays, however, the skin of a polar bear brings a very good"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l25" HPOS="407" VPOS="2063" WIDTH="1775" HEIGHT="67" BASELINE="409 2110 2182 2104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2110 409 2130 2180 2117 2182 2104 2178 2074 1591 2063 1589 2063 1587 2063 1563 2074 456 2067 454 2067 452 2067 407 2078 409 2110"/>
                        </Shape>
                        <String CONTENT="price either from Russian or American buyers, so the natives have ceased to"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l26" HPOS="407" VPOS="2132" WIDTH="1775" HEIGHT="50" BASELINE="409 2162 2182 2167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2162 407 2177 2178 2182 2182 2167 2180 2136 409 2132 409 2162"/>
                        </Shape>
                        <String CONTENT="use it for shoes. Only the elbow-protectors, that form part of the seal-hunter’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l27" HPOS="409" VPOS="2197" WIDTH="1771" HEIGHT="52" BASELINE="409 2225 2180 2225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2225 409 2240 2178 2249 2180 2225 2180 2197 409 2197 409 2225"/>
                        </Shape>
                        <String CONTENT="dress,¹ continue to be made of polar-bear skin. For all other seasons, covering"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l28" HPOS="407" VPOS="2247" WIDTH="1773" HEIGHT="58" BASELINE="409 2288 2180 2281" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2288 409 2305 2178 2301 2180 2281 2176 2253 435 2247 433 2247 430 2247 407 2255 409 2288"/>
                        </Shape>
                        <String CONTENT="about nine months of the year, the soles of boots are made of thong-seal hide"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l29" HPOS="407" VPOS="2305" WIDTH="1775" HEIGHT="57" BASELINE="409 2346 2182 2342" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2346 409 2362 2180 2357 2182 2342 2178 2314 450 2305 448 2305 446 2305 407 2316 409 2346"/>
                        </Shape>
                        <String CONTENT="with the hair side in, or of split walrus-skin. The latter is not so durable as"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l30" HPOS="409" VPOS="2364" WIDTH="1773" HEIGHT="65" BASELINE="411 2409 2182 2403" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2409 411 2429 2180 2418 2182 2403 2178 2372 1000 2364 998 2364 409 2377 411 2409"/>
                        </Shape>
                        <String CONTENT="ground-seal skin. Notwithstanding the extreme toughness of these hides, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l31" HPOS="407" VPOS="2422" WIDTH="1775" HEIGHT="61" BASELINE="409 2468 2182 2461" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2468 409 2483 2180 2476 2182 2461 2178 2433 1765 2422 1762 2422 1580 2435 407 2435 409 2468"/>
                        </Shape>
                        <String CONTENT="herdsmen wear them out quickly, especially in summer. The inland camps"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l32" HPOS="407" VPOS="2481" WIDTH="1775" HEIGHT="62" BASELINE="409 2528 2182 2522" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 2528 409 2543 2180 2537 2182 2522 2178 2494 1665 2481 1663 2481 1661 2481 1639 2491 1593 2481 1591 2481 1589 2481 1587 2481 1585 2481 1567 2494 1528 2483 1526 2483 1524 2483 1522 2483 1487 2494 1221 2483 1219 2483 1139 2494 1080 2483 1078 2483 1076 2483 1048 2494 1002 2483 1000 2483 998 2483 870 2496 530 2485 528 2485 407 2498 409 2528"/>
                        </Shape>
                        <String CONTENT="are always in want of hides for making soles. In the Kolyma country thong-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l33" HPOS="409" VPOS="2541" WIDTH="1773" HEIGHT="61" BASELINE="411 2587 2182 2582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2587 411 2602 2180 2598 2182 2582 2178 2552 1347 2541 1344 2541 1290 2552 482 2543 480 2543 409 2554 411 2587"/>
                        </Shape>
                        <String CONTENT="seal hides sell for twenty fawn-skins apiece. Even cow’s hide, furnished by"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l34" HPOS="413" VPOS="2606" WIDTH="1769" HEIGHT="54" BASELINE="415 2645 2182 2641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2645 415 2660 2180 2656 2182 2641 2178 2613 413 2606 415 2645"/>
                        </Shape>
                        <String CONTENT="Yakut traders, is gladly bought at the rate of three reindeer-bucks for one"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l35" HPOS="411" VPOS="2667" WIDTH="1776" HEIGHT="54" BASELINE="411 2704 2187 2704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2704 411 2721 2187 2721 2187 2704 2185 2667 411 2669 411 2704"/>
                        </Shape>
                        <String CONTENT="hide. Poor people, unable to procure enough hide for soles, make them of"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l36" HPOS="409" VPOS="2719" WIDTH="1776" HEIGHT="69" BASELINE="411 2769 2185 2760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2769 411 2788 2182 2775 2185 2760 2182 2732 2148 2719 2146 2719 2143 2719 2141 2719 2139 2719 2124 2730 1847 2719 1845 2719 1842 2719 1840 2719 1825 2730 1734 2721 1732 2721 1730 2721 1728 2721 1713 2732 1671 2721 1669 2721 1667 2721 1459 2732 1401 2721 1399 2721 1396 2721 1366 2732 1336 2721 1334 2721 1331 2721 1329 2721 1292 2734 1251 2723 1249 2723 1247 2723 1245 2723 1219 2734 1082 2723 1080 2723 1078 2723 1030 2734 937 2723 935 2723 933 2723 931 2723 916 2734 816 2725 814 2725 812 2725 768 2736 723 2725 721 2725 718 2725 552 2736 443 2725 441 2725 439 2725 409 2736 411 2769"/>
                        </Shape>
                        <String CONTENT="pieces of skin taken from the neck of old reindeer-bucks. This leather is"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l37" HPOS="411" VPOS="2795" WIDTH="1774" HEIGHT="47" BASELINE="411 2823 2185 2823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2823 411 2842 2185 2842 2185 2823 2185 2795 411 2795 411 2823"/>
                        </Shape>
                        <String CONTENT="tough enough for soles, especially when taken from wild animals, but it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l38" HPOS="411" VPOS="2855" WIDTH="968" HEIGHT="48" BASELINE="411 2885 1379 2885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 2885 411 2903 1379 2903 1379 2885 1379 2855 411 2855 411 2885"/>
                        </Shape>
                        <String CONTENT="more susceptible to damage by dampness."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-307_r4" HPOS="411" VPOS="2912" WIDTH="1778" HEIGHT="299" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="411 2912 2189 2912 2189 3211 411 3211"/>
                    </Shape>
