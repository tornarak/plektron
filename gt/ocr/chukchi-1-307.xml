                <TextBlock ID="mz_1-307_r2" HPOS="390" VPOS="730" WIDTH="1778" HEIGHT="1022" TAGREFS="TYPE_1">
<Shape>
                        <Polygon POINTS="390 730 2168 730 2168 1752 390 1752"/>
                    </Shape>
                    <TextLine ID="mz_1-307_l3" HPOS="379" VPOS="729" WIDTH="1780" HEIGHT="61" BASELINE="381 775 2159 768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="444 734 422 734 401 736 386 736 379 738 381 775 381 790 2157 783 2159 768 2155 738 975 729 973 729 970 729 929 740 455 731 444 734"/>
                        </Shape>
                        <String CONTENT="this peculiar vamp, the Chukchee winter boot has a square-shaped toe. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l4" HPOS="383" VPOS="803" WIDTH="1778" HEIGHT="48" BASELINE="383 833 2161 833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 833 383 851 2161 851 2161 833 2161 803 383 803 383 833"/>
                        </Shape>
                        <String CONTENT="same shape is used for the summer boots of seal-skin or curried leather, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l5" HPOS="379" VPOS="853" WIDTH="1780" HEIGHT="65" BASELINE="381 894 2159 889" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 894 381 907 927 918 929 918 931 918 970 907 1007 918 1009 918 1012 918 1702 905 1741 915 1744 915 1746 915 1748 915 1774 905 1839 915 1841 915 1843 915 1845 915 1863 905 1964 915 1967 915 2016 905 2029 915 2032 915 2034 915 2036 918 2140 918 2140 915 2142 915 2144 915 2159 902 2159 889 2155 861 399 853 396 853 394 853 392 853 379 859 381 894"/>
                        </Shape>
                        <String CONTENT="the vamp in the latter consists of a plain piece sewed to the sole. Other"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l6" HPOS="379" VPOS="911" WIDTH="1780" HEIGHT="59" BASELINE="381 952 2159 948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="381 952 381 970 2157 965 2159 948 2155 920 422 911 420 911 418 911 379 922 381 952"/>
                        </Shape>
                        <String CONTENT="tribes of northeastern Asia neighboring on the Chukchee generally wear boots"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l7" HPOS="381" VPOS="972" WIDTH="1778" HEIGHT="56" BASELINE="383 1015 2159 1011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1015 383 1028 2157 1026 2159 1011 2155 980 422 972 420 972 418 972 381 983 383 1015"/>
                        </Shape>
                        <String CONTENT="with pointed toes. In the Yakut boots the toes even bend upward with a"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l8" HPOS="381" VPOS="1039" WIDTH="1778" HEIGHT="50" BASELINE="383 1073 2159 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1073 383 1089 2157 1084 2159 1069 2155 1039 381 1039 383 1073"/>
                        </Shape>
                        <String CONTENT="long curved strip, somewhat resembling the well-known mediæval form. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l9" HPOS="381" VPOS="1091" WIDTH="1778" HEIGHT="58" BASELINE="383 1134 2159 1128" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1134 383 1149 2157 1143 2159 1128 2155 1099 975 1091 973 1091 970 1091 944 1102 455 1093 453 1093 381 1104 383 1134"/>
                        </Shape>
                        <String CONTENT="natives are well aware of the peculiar square shape of the toe of the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l10" HPOS="381" VPOS="1147" WIDTH="1778" HEIGHT="61" BASELINE="383 1195 2159 1188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1195 383 1208 2157 1201 2159 1188 2155 1158 1581 1147 1579 1147 1577 1147 1575 1147 1559 1158 409 1151 407 1151 405 1151 381 1160 383 1195"/>
                        </Shape>
                        <String CONTENT="chee boot. In one of the legends of the local Russians about their early war"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l11" HPOS="386" VPOS="1223" WIDTH="1773" HEIGHT="45" BASELINE="386 1251 2159 1251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="386 1251 386 1268 2159 1268 2159 1251 2159 1223 386 1223 386 1251"/>
                        </Shape>
                        <String CONTENT="with the Chukchee, a party of the latter is discovered by means of the square-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l12" HPOS="381" VPOS="1268" WIDTH="1778" HEIGHT="61" BASELINE="383 1314 2159 1309" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1314 383 1329 2157 1325 2159 1309 2155 1279 1271 1268 1269 1268 1267 1268 1265 1268 1245 1279 409 1271 407 1271 405 1271 381 1279 383 1314"/>
                        </Shape>
                        <String CONTENT="shaped grass insoles which they had thrown into the river flowing past their"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l13" HPOS="383" VPOS="1331" WIDTH="1778" HEIGHT="56" BASELINE="386 1372 2161 1368" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="386 1372 386 1387 2159 1383 2161 1368 2157 1331 581 1331 578 1331 383 1342 386 1372"/>
                        </Shape>
                        <String CONTENT="camp. The soles for the coldest time of the year are made of patches of"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l14" HPOS="388" VPOS="1403" WIDTH="1771" HEIGHT="45" BASELINE="388 1433 2159 1433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 1433 388 1448 2159 1448 2159 1433 2159 1403 388 1403 388 1433"/>
                        </Shape>
                        <String CONTENT="very tough skin taken from between the four toes of the reindeer’s foot."/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l15" HPOS="386" VPOS="1457" WIDTH="1773" HEIGHT="52" BASELINE="388 1491 2159 1487" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 1491 388 1509 2157 1506 2159 1487 2153 1457 386 1457 388 1491"/>
                        </Shape>
                        <String CONTENT="These patches are covered with thick tufts of hair, dirty white in color, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l16" HPOS="381" VPOS="1517" WIDTH="1774" HEIGHT="57" BASELINE="383 1550 2155 1554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1550 381 1565 392 1574 394 1574 396 1574 399 1574 2153 1571 2155 1554 2153 1522 383 1517 383 1550"/>
                        </Shape>
                        <String CONTENT="almost as stiff as bristles. They are sewed together, fashioned into a sole,"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l17" HPOS="383" VPOS="1580" WIDTH="1774" HEIGHT="54" BASELINE="383 1610 2157 1610" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1610 383 1626 2155 1634 2157 1610 2157 1580 383 1580 383 1610"/>
                        </Shape>
                        <String CONTENT="and then well dried. The sole has the hair side out, so that the whole covering"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l18" HPOS="381" VPOS="1628" WIDTH="1778" HEIGHT="60" BASELINE="383 1673 2159 1669" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="383 1673 383 1688 2157 1684 2159 1669 2155 1639 1271 1628 1269 1628 1267 1628 1265 1628 1245 1639 425 1630 422 1630 420 1630 381 1641 383 1673"/>
                        </Shape>
                        <String CONTENT="of the man, from the crown of his head to the sole of his foot, literally bristles"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l19" HPOS="383" VPOS="1686" WIDTH="873" HEIGHT="63" BASELINE="386 1734 1256 1729" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="386 1734 386 1749 1254 1745 1256 1729 1254 1699 1230 1686 1228 1686 1226 1686 1224 1686 1196 1697 1144 1686 1141 1686 1005 1697 981 1686 979 1686 977 1686 914 1697 853 1686 851 1686 849 1686 814 1699 769 1688 767 1688 765 1688 598 1699 511 1688 509 1688 507 1688 481 1699 427 1688 425 1688 422 1688 383 1701 386 1734"/>
                        </Shape>
                        <String CONTENT="with hair, like the skin of an animal."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-307_r3" HPOS="390" VPOS="1752" WIDTH="1778" HEIGHT="1145" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="390 1752 2168 1752 2168 2897 390 2897"/>
                    </Shape>
                    <TextLine ID="mz_1-307_l20" HPOS="490" VPOS="1747" WIDTH="1671" HEIGHT="60" BASELINE="492 1794 2161 1788" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="492 1794 492 1807 2159 1801 2161 1788 2157 1758 1657 1747 1655 1747 1594 1760 490 1760 492 1794"/>
                        </Shape>
                        <String CONTENT="In former times the Maritime Chukchee on the Arctic shores used the"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l21" HPOS="383" VPOS="1818" WIDTH="1774" HEIGHT="50" BASELINE="386 1853 2157 1849" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="386 1853 386 1868 2155 1866 2157 1849 2153 1818 383 1818 386 1853"/>
                        </Shape>
                        <String CONTENT="leg-skins of the white bear for making winter boots, including the soles. This"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l22" HPOS="386" VPOS="1866" WIDTH="1773" HEIGHT="61" BASELINE="388 1914 2159 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 1914 388 1927 2157 1924 2159 1907 2155 1879 1984 1866 1982 1866 1882 1877 1856 1866 1854 1866 1852 1866 1800 1877 1772 1866 1769 1866 1767 1866 1765 1866 1739 1877 1713 1866 1711 1866 1709 1866 1564 1879 1005 1868 1003 1868 1001 1868 973 1881 929 1870 927 1870 925 1870 923 1870 895 1881 879 1870 877 1870 875 1870 873 1870 715 1881 654 1870 652 1870 650 1870 626 1883 479 1883 399 1870 396 1870 394 1870 392 1870 392 1872 386 1877 388 1914"/>
                        </Shape>
                        <String CONTENT="fact was also noted by Nordenskiöld. These parts of the bear-skin are"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l23" HPOS="388" VPOS="1929" WIDTH="1771" HEIGHT="58" BASELINE="388 1970 2159 1970" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 1970 388 1987 2159 1987 2159 1970 2159 1942 1724 1929 1722 1929 1720 1929 1718 1929 1702 1942 1607 1942 1518 1929 1516 1929 1514 1929 1488 1939 1412 1929 1410 1929 1356 1939 1263 1929 1261 1929 1258 1929 1224 1939 1165 1929 1163 1929 1161 1929 1122 1939 1094 1929 1092 1929 1089 1929 934 1939 903 1929 901 1929 899 1929 806 1939 775 1929 773 1929 771 1929 646 1939 604 1929 602 1929 600 1929 598 1929 574 1939 529 1929 526 1929 524 1929 388 1939 388 1970"/>
                        </Shape>
                        <String CONTENT="exceedingly tough and covered with thick white hair, so they serve the pur-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l24" HPOS="386" VPOS="1987" WIDTH="1775" HEIGHT="69" BASELINE="388 2035 2161 2028" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2035 388 2056 2159 2043 2161 2028 2157 1998 1605 1987 1603 1987 1601 1987 1559 1998 568 1991 565 1991 386 2002 388 2035"/>
                        </Shape>
                        <String CONTENT="pose well. Nowadays, however, the skin of a polar bear brings a very good"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l25" HPOS="386" VPOS="2048" WIDTH="1775" HEIGHT="67" BASELINE="388 2095 2161 2089" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2095 388 2115 2159 2102 2161 2089 2157 2059 1570 2048 1568 2048 1566 2048 1542 2059 435 2052 433 2052 431 2052 386 2063 388 2095"/>
                        </Shape>
                        <String CONTENT="price either from Russian or American buyers, so the natives have ceased to"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l26" HPOS="386" VPOS="2117" WIDTH="1775" HEIGHT="50" BASELINE="388 2147 2161 2152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2147 386 2162 2157 2167 2161 2152 2159 2121 388 2117 388 2147"/>
                        </Shape>
                        <String CONTENT="use it for shoes. Only the elbow-protectors, that form part of the seal-hunter’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l27" HPOS="388" VPOS="2182" WIDTH="1771" HEIGHT="52" BASELINE="388 2210 2159 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2210 388 2225 2157 2234 2159 2210 2159 2182 388 2182 388 2210"/>
                        </Shape>
                        <String CONTENT="dress,¹ continue to be made of polar-bear skin. For all other seasons, covering"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l28" HPOS="386" VPOS="2232" WIDTH="1773" HEIGHT="58" BASELINE="388 2273 2159 2266" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2273 388 2290 2157 2286 2159 2266 2155 2238 414 2232 412 2232 409 2232 386 2240 388 2273"/>
                        </Shape>
                        <String CONTENT="about nine months of the year, the soles of boots are made of thong-seal hide"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l29" HPOS="386" VPOS="2290" WIDTH="1775" HEIGHT="57" BASELINE="388 2331 2161 2327" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2331 388 2347 2159 2342 2161 2327 2157 2299 429 2290 427 2290 425 2290 386 2301 388 2331"/>
                        </Shape>
                        <String CONTENT="with the hair side in, or of split walrus-skin. The latter is not so durable as"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l30" HPOS="388" VPOS="2349" WIDTH="1773" HEIGHT="65" BASELINE="390 2394 2161 2388" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2394 390 2414 2159 2403 2161 2388 2157 2357 979 2349 977 2349 388 2362 390 2394"/>
                        </Shape>
                        <String CONTENT="ground-seal skin. Notwithstanding the extreme toughness of these hides, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l31" HPOS="386" VPOS="2407" WIDTH="1775" HEIGHT="61" BASELINE="388 2453 2161 2446" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2453 388 2468 2159 2461 2161 2446 2157 2418 1744 2407 1741 2407 1559 2420 386 2420 388 2453"/>
                        </Shape>
                        <String CONTENT="herdsmen wear them out quickly, especially in summer. The inland camps"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l32" HPOS="386" VPOS="2466" WIDTH="1775" HEIGHT="62" BASELINE="388 2513 2161 2507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2513 388 2528 2159 2522 2161 2507 2157 2479 1644 2466 1642 2466 1640 2466 1618 2476 1572 2466 1570 2466 1568 2466 1566 2466 1564 2466 1546 2479 1507 2468 1505 2468 1503 2468 1501 2468 1466 2479 1200 2468 1198 2468 1118 2479 1059 2468 1057 2468 1055 2468 1027 2479 981 2468 979 2468 977 2468 849 2481 509 2470 507 2470 386 2483 388 2513"/>
                        </Shape>
                        <String CONTENT="are always in want of hides for making soles. In the Kolyma country thong-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l33" HPOS="388" VPOS="2526" WIDTH="1773" HEIGHT="61" BASELINE="390 2572 2161 2567" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2572 390 2587 2159 2583 2161 2567 2157 2537 1326 2526 1323 2526 1269 2537 461 2528 459 2528 388 2539 390 2572"/>
                        </Shape>
                        <String CONTENT="seal hides sell for twenty fawn-skins apiece. Even cow’s hide, furnished by"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l34" HPOS="392" VPOS="2591" WIDTH="1769" HEIGHT="54" BASELINE="394 2630 2161 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="394 2630 394 2645 2159 2641 2161 2626 2157 2598 392 2591 394 2630"/>
                        </Shape>
                        <String CONTENT="Yakut traders, is gladly bought at the rate of three reindeer-bucks for one"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l35" HPOS="390" VPOS="2652" WIDTH="1776" HEIGHT="54" BASELINE="390 2689 2166 2689" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2689 390 2706 2166 2706 2166 2689 2164 2652 390 2654 390 2689"/>
                        </Shape>
                        <String CONTENT="hide. Poor people, unable to procure enough hide for soles, make them of"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l36" HPOS="388" VPOS="2704" WIDTH="1776" HEIGHT="69" BASELINE="390 2754 2164 2745" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2754 390 2773 2161 2760 2164 2745 2161 2717 2127 2704 2125 2704 2122 2704 2120 2704 2118 2704 2103 2715 1826 2704 1824 2704 1821 2704 1819 2704 1804 2715 1713 2706 1711 2706 1709 2706 1707 2706 1692 2717 1650 2706 1648 2706 1646 2706 1438 2717 1380 2706 1378 2706 1375 2706 1345 2717 1315 2706 1313 2706 1310 2706 1308 2706 1271 2719 1230 2708 1228 2708 1226 2708 1224 2708 1198 2719 1061 2708 1059 2708 1057 2708 1009 2719 916 2708 914 2708 912 2708 910 2708 895 2719 795 2710 793 2710 791 2710 747 2721 702 2710 700 2710 697 2710 531 2721 422 2710 420 2710 418 2710 388 2721 390 2754"/>
                        </Shape>
                        <String CONTENT="pieces of skin taken from the neck of old reindeer-bucks. This leather is"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l37" HPOS="390" VPOS="2780" WIDTH="1774" HEIGHT="47" BASELINE="390 2808 2164 2808" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2808 390 2827 2164 2827 2164 2808 2164 2780 390 2780 390 2808"/>
                        </Shape>
                        <String CONTENT="tough enough for soles, especially when taken from wild animals, but it is"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l38" HPOS="390" VPOS="2840" WIDTH="968" HEIGHT="48" BASELINE="390 2870 1358 2870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="390 2870 390 2888 1358 2888 1358 2870 1358 2840 390 2840 390 2870"/>
                        </Shape>
                        <String CONTENT="more susceptible to damage by dampness."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-307_r4" HPOS="390" VPOS="2897" WIDTH="1778" HEIGHT="299" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="390 2897 2168 2897 2168 3196 390 3196"/>
                    </Shape>
                    <TextLine ID="mz_1-307_l39" HPOS="500" VPOS="2894" WIDTH="1664" HEIGHT="52" BASELINE="500 2929 2164 2929" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="500 2929 500 2946 2164 2946 2164 2929 2164 2899 500 2894 500 2929"/>
                        </Shape>
                        <String CONTENT="The boot-string is made of strips of curried leather, which are sewed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l40" HPOS="386" VPOS="2944" WIDTH="1778" HEIGHT="61" BASELINE="388 2990 2164 2985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="388 2990 388 3005 2161 3000 2164 2985 2159 2957 2029 2957 2006 2944 2003 2944 2001 2944 1904 2955 1876 2944 1873 2944 1871 2944 1869 2944 1867 2944 1852 2957 1702 2957 1614 2944 1611 2944 1609 2944 1579 2955 1516 2944 1514 2944 1436 2955 1382 2944 1380 2944 1378 2944 1347 2955 1276 2944 1274 2944 1174 2957 1135 2946 1133 2946 1131 2946 1042 2957 719 2946 717 2946 715 2946 713 2946 697 2959 552 2959 500 2946 498 2946 496 2946 466 2957 414 2946 412 2946 409 2946 386 2957 388 2990"/>
                        </Shape>
                        <String CONTENT="the boot on both sides, a little behind the ankle (Fig. 171, b), and taper"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l41" HPOS="390" VPOS="3018" WIDTH="1774" HEIGHT="47" BASELINE="390 3048 2164 3048" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2155 3018 390 3018 390 3048 390 3065 2164 3065 2164 3048 2161 3037 2155 3018"/>
                        </Shape>
