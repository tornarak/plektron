                        </Shape>
                        <String CONTENT="The boot-string is made of strips of curried leather, which are sewed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l40" HPOS="407" VPOS="2959" WIDTH="1778" HEIGHT="61" BASELINE="409 3005 2185 3000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 3005 409 3020 2182 3015 2185 3000 2180 2972 2050 2972 2027 2959 2024 2959 2022 2959 1925 2970 1897 2959 1894 2959 1892 2959 1890 2959 1888 2959 1873 2972 1723 2972 1635 2959 1632 2959 1630 2959 1600 2970 1537 2959 1535 2959 1457 2970 1403 2959 1401 2959 1399 2959 1368 2970 1297 2959 1295 2959 1195 2972 1156 2961 1154 2961 1152 2961 1063 2972 740 2961 738 2961 736 2961 734 2961 718 2974 573 2974 521 2961 519 2961 517 2961 487 2972 435 2961 433 2961 430 2961 407 2972 409 3005"/>
                        </Shape>
                        <String CONTENT="the boot on both sides, a little behind the ankle (Fig. 171, b), and taper"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l41" HPOS="411" VPOS="3033" WIDTH="1774" HEIGHT="47" BASELINE="411 3063 2185 3063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2176 3033 411 3033 411 3063 411 3080 2185 3080 2185 3063 2182 3052 2176 3033"/>
                        </Shape>
