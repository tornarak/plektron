                        </Shape>
                        <String CONTENT="this peculiar vamp, the Chukchee winter boot has a square-shaped toe. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l4" HPOS="404" VPOS="818" WIDTH="1778" HEIGHT="48" BASELINE="404 848 2182 848" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 848 404 866 2182 866 2182 848 2182 818 404 818 404 848"/>
                        </Shape>
                        <String CONTENT="same shape is used for the summer boots of seal-skin or curried leather, though"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l5" HPOS="400" VPOS="868" WIDTH="1780" HEIGHT="65" BASELINE="402 909 2180 904" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="402 909 402 922 948 933 950 933 952 933 991 922 1028 933 1030 933 1033 933 1723 920 1762 930 1765 930 1767 930 1769 930 1795 920 1860 930 1862 930 1864 930 1866 930 1884 920 1985 930 1988 930 2037 920 2050 930 2053 930 2055 930 2057 933 2161 933 2161 930 2163 930 2165 930 2180 917 2180 904 2176 876 420 868 417 868 415 868 413 868 400 874 402 909"/>
                        </Shape>
                        <String CONTENT="the vamp in the latter consists of a plain piece sewed to the sole. Other"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l6" HPOS="400" VPOS="926" WIDTH="1780" HEIGHT="59" BASELINE="402 967 2180 963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="402 967 402 985 2178 980 2180 963 2176 935 443 926 441 926 439 926 400 937 402 967"/>
                        </Shape>
                        <String CONTENT="tribes of northeastern Asia neighboring on the Chukchee generally wear boots"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l7" HPOS="402" VPOS="987" WIDTH="1778" HEIGHT="56" BASELINE="404 1030 2180 1026" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1030 404 1043 2178 1041 2180 1026 2176 995 443 987 441 987 439 987 402 998 404 1030"/>
                        </Shape>
                        <String CONTENT="with pointed toes. In the Yakut boots the toes even bend upward with a"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l8" HPOS="402" VPOS="1054" WIDTH="1778" HEIGHT="50" BASELINE="404 1088 2180 1084" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1088 404 1104 2178 1099 2180 1084 2176 1054 402 1054 404 1088"/>
                        </Shape>
                        <String CONTENT="long curved strip, somewhat resembling the well-known mediæval form. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l9" HPOS="402" VPOS="1106" WIDTH="1778" HEIGHT="58" BASELINE="404 1149 2180 1143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1149 404 1164 2178 1158 2180 1143 2176 1114 996 1106 994 1106 991 1106 965 1117 476 1108 474 1108 402 1119 404 1149"/>
                        </Shape>
                        <String CONTENT="natives are well aware of the peculiar square shape of the toe of the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l10" HPOS="402" VPOS="1162" WIDTH="1778" HEIGHT="61" BASELINE="404 1210 2180 1203" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1210 404 1223 2178 1216 2180 1203 2176 1173 1602 1162 1600 1162 1598 1162 1596 1162 1580 1173 430 1166 428 1166 426 1166 402 1175 404 1210"/>
                        </Shape>
                        <String CONTENT="chee boot. In one of the legends of the local Russians about their early war"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l11" HPOS="407" VPOS="1238" WIDTH="1773" HEIGHT="45" BASELINE="407 1266 2180 1266" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1266 407 1283 2180 1283 2180 1266 2180 1238 407 1238 407 1266"/>
                        </Shape>
                        <String CONTENT="with the Chukchee, a party of the latter is discovered by means of the square-"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l12" HPOS="402" VPOS="1283" WIDTH="1778" HEIGHT="61" BASELINE="404 1329 2180 1324" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1329 404 1344 2178 1340 2180 1324 2176 1294 1292 1283 1290 1283 1288 1283 1286 1283 1266 1294 430 1286 428 1286 426 1286 402 1294 404 1329"/>
                        </Shape>
                        <String CONTENT="shaped grass insoles which they had thrown into the river flowing past their"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l13" HPOS="404" VPOS="1346" WIDTH="1778" HEIGHT="56" BASELINE="407 1387 2182 1383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1387 407 1402 2180 1398 2182 1383 2178 1346 602 1346 599 1346 404 1357 407 1387"/>
                        </Shape>
                        <String CONTENT="camp. The soles for the coldest time of the year are made of patches of"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l14" HPOS="409" VPOS="1418" WIDTH="1771" HEIGHT="45" BASELINE="409 1448 2180 1448" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1448 409 1463 2180 1463 2180 1448 2180 1418 409 1418 409 1448"/>
                        </Shape>
                        <String CONTENT="very tough skin taken from between the four toes of the reindeer’s foot."/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l15" HPOS="407" VPOS="1472" WIDTH="1773" HEIGHT="52" BASELINE="409 1506 2180 1502" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1506 409 1524 2178 1521 2180 1502 2174 1472 407 1472 409 1506"/>
                        </Shape>
                        <String CONTENT="These patches are covered with thick tufts of hair, dirty white in color, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l16" HPOS="402" VPOS="1532" WIDTH="1774" HEIGHT="57" BASELINE="404 1565 2176 1569" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1565 402 1580 413 1589 415 1589 417 1589 420 1589 2174 1586 2176 1569 2174 1537 404 1532 404 1565"/>
                        </Shape>
                        <String CONTENT="almost as stiff as bristles. They are sewed together, fashioned into a sole,"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l17" HPOS="404" VPOS="1595" WIDTH="1774" HEIGHT="54" BASELINE="404 1625 2178 1625" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1625 404 1641 2176 1649 2178 1625 2178 1595 404 1595 404 1625"/>
                        </Shape>
                        <String CONTENT="and then well dried. The sole has the hair side out, so that the whole covering"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l18" HPOS="402" VPOS="1643" WIDTH="1778" HEIGHT="60" BASELINE="404 1688 2180 1684" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="404 1688 404 1703 2178 1699 2180 1684 2176 1654 1292 1643 1290 1643 1288 1643 1286 1643 1266 1654 446 1645 443 1645 441 1645 402 1656 404 1688"/>
                        </Shape>
                        <String CONTENT="of the man, from the crown of his head to the sole of his foot, literally bristles"/>
                    </TextLine>

                    <TextLine ID="mz_1-307_l19" HPOS="404" VPOS="1701" WIDTH="873" HEIGHT="63" BASELINE="407 1749 1277 1744" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1749 407 1764 1275 1760 1277 1744 1275 1714 1251 1701 1249 1701 1247 1701 1245 1701 1217 1712 1165 1701 1162 1701 1026 1712 1002 1701 1000 1701 998 1701 935 1712 874 1701 872 1701 870 1701 835 1714 790 1703 788 1703 786 1703 619 1714 532 1703 530 1703 528 1703 502 1714 448 1703 446 1703 443 1703 404 1716 407 1749"/>
                        </Shape>
                        <String CONTENT="with hair, like the skin of an animal."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-307_r3" HPOS="411" VPOS="1767" WIDTH="1778" HEIGHT="1145" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="411 1767 2189 1767 2189 2912 411 2912"/>
