                        </Shape>
                        <String CONTENT="GROUPS OF REINDEER-BREEDERS. — The domestication of the reindeer among"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l3" HPOS="667" VPOS="1071" WIDTH="1775" HEIGHT="61" BASELINE="667 1114 2442 1114" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1114 667 1132 2442 1132 2442 1114 2442 1084 2380 1071 2377 1071 2375 1071 2338 1082 2304 1071 2302 1071 2299 1071 1905 1082 1877 1071 1875 1071 1873 1071 1816 1082 1771 1071 1769 1071 1767 1071 1708 1082 1674 1071 1671 1071 1669 1071 1667 1071 1665 1071 1650 1082 1563 1071 1561 1071 1502 1082 1442 1071 1440 1071 1437 1071 1392 1082 1308 1071 1305 1071 1303 1071 1301 1071 1288 1082 1266 1071 1264 1071 1262 1071 1260 1071 1217 1082 1171 1071 1169 1071 1167 1071 1097 1082 1074 1071 1071 1071 913 1071 911 1071 909 1071 885 1082 805 1071 803 1071 721 1082 695 1071 693 1071 690 1071 688 1071 667 1082 667 1114"/>
                        </Shape>
                        <String CONTENT="the tribes inhabiting the Asiatic side of Bering Sea forms the chief distinctive"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l4" HPOS="669" VPOS="1143" WIDTH="1773" HEIGHT="47" BASELINE="669 1173 2442 1173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="669 1173 669 1190 2442 1190 2442 1173 2442 1145 669 1143 669 1173"/>
                        </Shape>
                        <String CONTENT="feature in their economic condition as compared to that of the Arctic tribes"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l5" HPOS="667" VPOS="1203" WIDTH="1775" HEIGHT="48" BASELINE="667 1234 2442 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1234 667 1251 2442 1251 2442 1234 2442 1203 667 1203 667 1234"/>
                        </Shape>
                        <String CONTENT="of America. Nevertheless it is difficult to say how reindeer-breeding, and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l6" HPOS="667" VPOS="1264" WIDTH="1775" HEIGHT="47" BASELINE="667 1294 2442 1294" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1294 667 1311 2442 1311 2442 1294 2442 1264 667 1264 667 1294"/>
                        </Shape>
                        <String CONTENT="nomadic state of life entailed by it, were introduced into the extreme north-"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l7" HPOS="667" VPOS="1318" WIDTH="539" HEIGHT="56" BASELINE="669 1348 1206 1355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="669 1348 667 1366 677 1374 680 1374 682 1374 684 1374 1204 1368 1206 1355 1204 1324 669 1318 669 1348"/>
                        </Shape>
                        <String CONTENT="eastern corner of Asia."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-096_r3" HPOS="663" VPOS="1371" WIDTH="1778" HEIGHT="548" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="663 1371 2441 1371 2441 1919 663 1919"/>
                    </Shape>
                    <TextLine ID="mz_1-096_l8" HPOS="773" VPOS="1368" WIDTH="1669" HEIGHT="67" BASELINE="775 1411 2442 1415" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="775 1411 773 1424 781 1433 781 1435 783 1435 786 1435 788 1435 2440 1426 2442 1415 2440 1383 2057 1370 2055 1370 1998 1381 1977 1370 1975 1370 1972 1370 1970 1370 1968 1370 1951 1381 1927 1370 1925 1370 1923 1370 1920 1370 1918 1370 1901 1383 1780 1383 1752 1370 1749 1370 1747 1370 1745 1370 1702 1381 1674 1370 1671 1370 1669 1370 1667 1370 1635 1381 1602 1368 1600 1368 1598 1368 1596 1368 1565 1379 1502 1368 1500 1368 1498 1368 1468 1379 1446 1368 1444 1368 1442 1368 1440 1368 1396 1381 1000 1381 987 1368 985 1368 983 1368 981 1368 978 1368 950 1379 840 1368 838 1368 775 1376 775 1411"/>
                        </Shape>
                        <String CONTENT="Along the western parts of the Arctic shores of the Old World there"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l9" HPOS="662" VPOS="1439" WIDTH="1778" HEIGHT="50" BASELINE="664 1470 2440 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="664 1470 662 1485 2436 1489 2440 1474 2438 1439 664 1439 664 1470"/>
                        </Shape>
                        <String CONTENT="dwell a number of tribes who have possessed from ancient times domesticated"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l10" HPOS="667" VPOS="1502" WIDTH="1775" HEIGHT="48" BASELINE="667 1532 2442 1532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1532 667 1550 2442 1550 2442 1532 2442 1502 667 1502 667 1532"/>
                        </Shape>
                        <String CONTENT="reindeer that are harnessed to sledges and also used for food. Their herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l11" HPOS="664" VPOS="1558" WIDTH="1774" HEIGHT="59" BASELINE="667 1589 2438 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1589 664 1604 731 1617 734 1617 2436 1608 2438 1593 2436 1563 667 1558 667 1589"/>
                        </Shape>
                        <String CONTENT="are, or rather were, large; and their whole existence is based on the supply"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l12" HPOS="667" VPOS="1621" WIDTH="1773" HEIGHT="50" BASELINE="667 1651 2440 1651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1651 667 1671 2440 1671 2440 1651 2440 1621 667 1621 667 1651"/>
                        </Shape>
                        <String CONTENT="of meat and skins furnished by these herds. Their economic condition resembles"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l13" HPOS="664" VPOS="1669" WIDTH="1776" HEIGHT="63" BASELINE="667 1714 2440 1710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1714 667 1732 2438 1727 2440 1710 2436 1682 2360 1669 2358 1669 2356 1669 2334 1680 2308 1669 2306 1669 2304 1669 2302 1669 2299 1669 2282 1680 2118 1669 2115 1669 2113 1669 2111 1669 2096 1682 2005 1682 1968 1669 1966 1669 1964 1669 1879 1680 1834 1669 1832 1669 1829 1669 1773 1680 1674 1669 1671 1669 1583 1680 1554 1669 1552 1669 1550 1669 1548 1669 1518 1682 1487 1671 1485 1671 1483 1671 1405 1682 1201 1671 1199 1671 1115 1682 1035 1671 1033 1671 1030 1671 996 1684 818 1684 803 1671 801 1671 799 1671 796 1671 664 1680 667 1714"/>
                        </Shape>
                        <String CONTENT="in this respect that of the more southerly cattle-breeding tribes. These reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l14" HPOS="664" VPOS="1738" WIDTH="1776" HEIGHT="52" BASELINE="667 1770 2440 1775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1770 664 1786 2436 1790 2440 1775 2438 1742 667 1738 667 1770"/>
                        </Shape>
                        <String CONTENT="tribes are the Laplanders, Zyrians, and Samoyeds (European and Asiatic). Their"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l15" HPOS="667" VPOS="1805" WIDTH="1775" HEIGHT="46" BASELINE="667 1833 2442 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 1833 667 1851 2442 1851 2442 1833 2442 1805 667 1805 667 1833"/>
                        </Shape>
                        <String CONTENT="methods of reindeer-breeding are somewhat uniform, and they all use the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l16" HPOS="669" VPOS="1861" WIDTH="885" HEIGHT="50" BASELINE="669 1892 1554 1892" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="669 1892 669 1911 1554 1911 1554 1892 1554 1861 669 1861 669 1892"/>
                        </Shape>
                        <String CONTENT="shepherd-dog in managing their herds."/>
                    </TextLine>
</TextBlock>
                <TextBlock ID="mz_1-096_r4" HPOS="663" VPOS="1919" WIDTH="1778" HEIGHT="538" TAGREFS="TYPE_2">
<Shape>
                        <Polygon POINTS="663 1919 2441 1919 2441 2457 663 2457"/>
                    </Shape>
                    <TextLine ID="mz_1-096_l17" HPOS="775" VPOS="1911" WIDTH="1670" HEIGHT="67" BASELINE="777 1948 2445 1952" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="777 1948 775 1963 820 1976 822 1976 825 1976 1546 1967 1624 1978 1626 1978 2442 1967 2445 1952 2442 1922 777 1911 777 1948"/>
                        </Shape>
                        <String CONTENT="The widespread branches of the Tungus and Lamut constitute the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l18" HPOS="667" VPOS="1972" WIDTH="1773" HEIGHT="65" BASELINE="667 2015 2440 2015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2015 667 2037 2440 2028 2440 2015 2440 1985 2020 1972 2018 1972 1949 1983 1920 1972 1918 1972 1916 1972 1914 1972 1879 1983 1825 1972 1823 1972 1821 1972 1795 1983 1715 1972 1713 1972 1643 1983 1628 1972 1626 1972 1624 1972 1502 1972 1500 1972 1498 1972 1496 1972 1481 1985 1325 1985 1292 1972 1290 1972 1288 1972 1232 1983 1169 1972 1167 1972 1059 1983 968 1972 965 1972 896 1983 783 1972 781 1972 667 1983 667 2015"/>
                        </Shape>
                        <String CONTENT="prominent reindeer tribe of eastern Siberia. Usually they live some distance"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l19" HPOS="664" VPOS="2037" WIDTH="1776" HEIGHT="63" BASELINE="667 2067 2440 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2067 664 2082 1297 2097 1299 2097 1760 2089 1847 2100 1849 2100 2438 2089 2440 2074 2438 2043 667 2037 667 2067"/>
                        </Shape>
                        <String CONTENT="from the shore, and many bands use the saddle in place of the sledge. Their"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l20" HPOS="667" VPOS="2097" WIDTH="1771" HEIGHT="55" BASELINE="667 2132 2438 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2132 667 2152 2438 2152 2438 2132 2438 2104 667 2097 667 2132"/>
                        </Shape>
                        <String CONTENT="herds are so small that they can use their reindeer for riding and transportation"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l21" HPOS="667" VPOS="2165" WIDTH="1773" HEIGHT="45" BASELINE="667 2193 2440 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2193 667 2210 2440 2210 2440 2193 2440 2165 667 2165 667 2193"/>
                        </Shape>
                        <String CONTENT="only, not for slaughter. They have not become nomadic, but, owing to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l22" HPOS="664" VPOS="2214" WIDTH="1772" HEIGHT="57" BASELINE="667 2249 2436 2255" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2249 664 2264 2432 2271 2436 2255 2434 2216 667 2214 667 2249"/>
                        </Shape>
                        <String CONTENT="introduction of the reindeer, have been enabled to extend their hunting and"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l23" HPOS="669" VPOS="2279" WIDTH="1769" HEIGHT="52" BASELINE="669 2312 2438 2312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="669 2312 669 2331 2438 2331 2438 2312 2438 2284 669 2279 669 2312"/>
                        </Shape>
                        <String CONTENT="fishing expeditions over a larger extent of territory, in the same way as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l24" HPOS="669" VPOS="2329" WIDTH="1765" HEIGHT="65" BASELINE="671 2370 2434 2377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="671 2370 669 2383 2429 2394 2434 2377 2434 2344 2397 2331 2395 2331 2393 2331 1931 2342 1916 2331 1914 2331 1912 2331 1910 2331 1780 2340 1758 2329 1756 2329 1754 2329 1752 2329 1710 2340 1682 2329 1680 2329 1678 2329 1676 2329 1630 2340 1570 2329 1567 2329 1565 2329 1537 2340 1492 2329 1489 2329 1487 2329 1485 2329 1457 2340 1375 2329 1373 2329 1370 2329 1368 2329 1355 2340 1305 2329 1303 2329 671 2329 671 2370"/>
                        </Shape>
                        <String CONTENT="North American Indians did after the introduction of horses. Several bands,"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l25" HPOS="664" VPOS="2394" WIDTH="1718" HEIGHT="54" BASELINE="667 2429 2382 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="667 2429 664 2444 2377 2448 2382 2433 2380 2403 667 2394 667 2429"/>
                        </Shape>
                        <String CONTENT="however, raise large herds, so that they are able to live on their products."/>
                    </TextLine>
</TextBlock>
