                <TextBlock ID="text_1-096" HPOS="639" VPOS="870" WIDTH="1785" HEIGHT="2440"><TextLine ID="mz_1-096_l1" HPOS="1139" VPOS="870" WIDTH="786" HEIGHT="74" BASELINE="1141 920 1925 915" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1139 896 1141 920 1141 935 1908 944 1910 944 1912 944 1915 944 1915 941 1925 931 1925 915 1921 881 1330 870 1328 870 1326 870 1323 870 1323 872 1313 883 1222 883 1161 870 1159 870 1139 896"/>
                        </Shape>
                        <String CONTENT="IV. — REINDEER-BREEDING."/>
                    </TextLine>
<TextLine ID="mz_1-096_l2" HPOS="749" VPOS="993" WIDTH="1672" HEIGHT="63" BASELINE="752 1037 2421 1041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2419 1013 2413 1006 1977 996 1975 996 1897 1006 1865 996 1863 996 1860 996 1858 996 1821 1006 1793 996 1791 996 1789 996 1687 1006 1655 996 1653 996 1650 996 1648 996 1618 1006 1585 993 1583 993 1581 993 1514 1004 1267 993 1265 993 752 1002 752 1037 749 1050 2417 1056 2421 1041 2419 1013 2419 1013"/>
                        </Shape>
                        <String CONTENT="GROUPS OF REINDEER-BREEDERS. — The domestication of the reindeer among"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l3" HPOS="646" VPOS="1056" WIDTH="1775" HEIGHT="61" BASELINE="646 1099 2421 1099" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1099 646 1117 2421 1117 2421 1099 2421 1069 2359 1056 2356 1056 2354 1056 2317 1067 2283 1056 2281 1056 2278 1056 1884 1067 1856 1056 1854 1056 1852 1056 1795 1067 1750 1056 1748 1056 1746 1056 1687 1067 1653 1056 1650 1056 1648 1056 1646 1056 1644 1056 1629 1067 1542 1056 1540 1056 1481 1067 1421 1056 1419 1056 1416 1056 1371 1067 1287 1056 1284 1056 1282 1056 1280 1056 1267 1067 1245 1056 1243 1056 1241 1056 1239 1056 1196 1067 1150 1056 1148 1056 1146 1056 1076 1067 1053 1056 1050 1056 892 1056 890 1056 888 1056 864 1067 784 1056 782 1056 700 1067 674 1056 672 1056 669 1056 667 1056 646 1067 646 1099"/>
                        </Shape>
                        <String CONTENT="the tribes inhabiting the Asiatic side of Bering Sea forms the chief distinctive"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l4" HPOS="648" VPOS="1128" WIDTH="1773" HEIGHT="47" BASELINE="648 1158 2421 1158" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1158 648 1175 2421 1175 2421 1158 2421 1130 648 1128 648 1158"/>
                        </Shape>
                        <String CONTENT="feature in their economic condition as compared to that of the Arctic tribes"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l5" HPOS="646" VPOS="1188" WIDTH="1775" HEIGHT="48" BASELINE="646 1219 2421 1219" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1219 646 1236 2421 1236 2421 1219 2421 1188 646 1188 646 1219"/>
                        </Shape>
                        <String CONTENT="of America. Nevertheless it is difficult to say how reindeer-breeding, and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l6" HPOS="646" VPOS="1249" WIDTH="1775" HEIGHT="47" BASELINE="646 1279 2421 1279" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1279 646 1296 2421 1296 2421 1279 2421 1249 646 1249 646 1279"/>
                        </Shape>
                        <String CONTENT="nomadic state of life entailed by it, were introduced into the extreme north-"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l7" HPOS="646" VPOS="1303" WIDTH="539" HEIGHT="56" BASELINE="648 1333 1185 1340" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1333 646 1351 656 1359 659 1359 661 1359 663 1359 1183 1353 1185 1340 1183 1309 648 1303 648 1333"/>
                        </Shape>
                        <String CONTENT="eastern corner of Asia."/>
                    </TextLine>
<TextLine ID="mz_1-096_l8" HPOS="752" VPOS="1353" WIDTH="1669" HEIGHT="67" BASELINE="754 1396 2421 1400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="754 1396 752 1409 760 1418 760 1420 762 1420 765 1420 767 1420 2419 1411 2421 1400 2419 1368 2036 1355 2034 1355 1977 1366 1956 1355 1954 1355 1951 1355 1949 1355 1947 1355 1930 1366 1906 1355 1904 1355 1902 1355 1899 1355 1897 1355 1880 1368 1759 1368 1731 1355 1728 1355 1726 1355 1724 1355 1681 1366 1653 1355 1650 1355 1648 1355 1646 1355 1614 1366 1581 1353 1579 1353 1577 1353 1575 1353 1544 1364 1481 1353 1479 1353 1477 1353 1447 1364 1425 1353 1423 1353 1421 1353 1419 1353 1375 1366 979 1366 966 1353 964 1353 962 1353 960 1353 957 1353 929 1364 819 1353 817 1353 754 1361 754 1396"/>
                        </Shape>
                        <String CONTENT="Along the western parts of the Arctic shores of the Old World there"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l9" HPOS="641" VPOS="1424" WIDTH="1778" HEIGHT="50" BASELINE="643 1455 2419 1459" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="643 1455 641 1470 2415 1474 2419 1459 2417 1424 643 1424 643 1455"/>
                        </Shape>
                        <String CONTENT="dwell a number of tribes who have possessed from ancient times domesticated"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l10" HPOS="646" VPOS="1487" WIDTH="1775" HEIGHT="48" BASELINE="646 1517 2421 1517" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1517 646 1535 2421 1535 2421 1517 2421 1487 646 1487 646 1517"/>
                        </Shape>
                        <String CONTENT="reindeer that are harnessed to sledges and also used for food. Their herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l11" HPOS="643" VPOS="1543" WIDTH="1774" HEIGHT="59" BASELINE="646 1574 2417 1578" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1574 643 1589 710 1602 713 1602 2415 1593 2417 1578 2415 1548 646 1543 646 1574"/>
                        </Shape>
                        <String CONTENT="are, or rather were, large; and their whole existence is based on the supply"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l12" HPOS="646" VPOS="1606" WIDTH="1773" HEIGHT="50" BASELINE="646 1636 2419 1636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1636 646 1656 2419 1656 2419 1636 2419 1606 646 1606 646 1636"/>
                        </Shape>
                        <String CONTENT="of meat and skins furnished by these herds. Their economic condition resembles"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l13" HPOS="643" VPOS="1654" WIDTH="1776" HEIGHT="63" BASELINE="646 1699 2419 1695" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1699 646 1717 2417 1712 2419 1695 2415 1667 2339 1654 2337 1654 2335 1654 2313 1665 2287 1654 2285 1654 2283 1654 2281 1654 2278 1654 2261 1665 2097 1654 2094 1654 2092 1654 2090 1654 2075 1667 1984 1667 1947 1654 1945 1654 1943 1654 1858 1665 1813 1654 1811 1654 1808 1654 1752 1665 1653 1654 1650 1654 1562 1665 1533 1654 1531 1654 1529 1654 1527 1654 1497 1667 1466 1656 1464 1656 1462 1656 1384 1667 1180 1656 1178 1656 1094 1667 1014 1656 1012 1656 1009 1656 975 1669 797 1669 782 1656 780 1656 778 1656 775 1656 643 1665 646 1699"/>
                        </Shape>
                        <String CONTENT="in this respect that of the more southerly cattle-breeding tribes. These reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l14" HPOS="643" VPOS="1723" WIDTH="1776" HEIGHT="52" BASELINE="646 1755 2419 1760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1755 643 1771 2415 1775 2419 1760 2417 1727 646 1723 646 1755"/>
                        </Shape>
                        <String CONTENT="tribes are the Laplanders, Zyrians, and Samoyeds (European and Asiatic). Their"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l15" HPOS="646" VPOS="1790" WIDTH="1775" HEIGHT="46" BASELINE="646 1818 2421 1818" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 1818 646 1836 2421 1836 2421 1818 2421 1790 646 1790 646 1818"/>
                        </Shape>
                        <String CONTENT="methods of reindeer-breeding are somewhat uniform, and they all use the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l16" HPOS="648" VPOS="1846" WIDTH="885" HEIGHT="50" BASELINE="648 1877 1533 1877" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1877 648 1896 1533 1896 1533 1877 1533 1846 648 1846 648 1877"/>
                        </Shape>
                        <String CONTENT="shepherd-dog in managing their herds."/>
                    </TextLine>
<TextLine ID="mz_1-096_l17" HPOS="754" VPOS="1896" WIDTH="1670" HEIGHT="67" BASELINE="756 1933 2424 1937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="756 1933 754 1948 799 1961 801 1961 804 1961 1525 1952 1603 1963 1605 1963 2421 1952 2424 1937 2421 1907 756 1896 756 1933"/>
                        </Shape>
                        <String CONTENT="The widespread branches of the Tungus and Lamut constitute the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l18" HPOS="646" VPOS="1957" WIDTH="1773" HEIGHT="65" BASELINE="646 2000 2419 2000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2000 646 2022 2419 2013 2419 2000 2419 1970 1999 1957 1997 1957 1928 1968 1899 1957 1897 1957 1895 1957 1893 1957 1858 1968 1804 1957 1802 1957 1800 1957 1774 1968 1694 1957 1692 1957 1622 1968 1607 1957 1605 1957 1603 1957 1481 1957 1479 1957 1477 1957 1475 1957 1460 1970 1304 1970 1271 1957 1269 1957 1267 1957 1211 1968 1148 1957 1146 1957 1038 1968 947 1957 944 1957 875 1968 762 1957 760 1957 646 1968 646 2000"/>
                        </Shape>
                        <String CONTENT="prominent reindeer tribe of eastern Siberia. Usually they live some distance"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l19" HPOS="643" VPOS="2022" WIDTH="1776" HEIGHT="63" BASELINE="646 2052 2419 2059" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2052 643 2067 1276 2082 1278 2082 1739 2074 1826 2085 1828 2085 2417 2074 2419 2059 2417 2028 646 2022 646 2052"/>
                        </Shape>
                        <String CONTENT="from the shore, and many bands use the saddle in place of the sledge. Their"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l20" HPOS="646" VPOS="2082" WIDTH="1771" HEIGHT="55" BASELINE="646 2117 2417 2117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2117 646 2137 2417 2137 2417 2117 2417 2089 646 2082 646 2117"/>
                        </Shape>
                        <String CONTENT="herds are so small that they can use their reindeer for riding and transportation"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l21" HPOS="646" VPOS="2150" WIDTH="1773" HEIGHT="45" BASELINE="646 2178 2419 2178" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2178 646 2195 2419 2195 2419 2178 2419 2150 646 2150 646 2178"/>
                        </Shape>
                        <String CONTENT="only, not for slaughter. They have not become nomadic, but, owing to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l22" HPOS="643" VPOS="2199" WIDTH="1772" HEIGHT="57" BASELINE="646 2234 2415 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2234 643 2249 2411 2256 2415 2240 2413 2201 646 2199 646 2234"/>
                        </Shape>
                        <String CONTENT="introduction of the reindeer, have been enabled to extend their hunting and"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l23" HPOS="648" VPOS="2264" WIDTH="1769" HEIGHT="52" BASELINE="648 2297 2417 2297" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2297 648 2316 2417 2316 2417 2297 2417 2269 648 2264 648 2297"/>
                        </Shape>
                        <String CONTENT="fishing expeditions over a larger extent of territory, in the same way as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l24" HPOS="648" VPOS="2314" WIDTH="1765" HEIGHT="65" BASELINE="650 2355 2413 2362" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2355 648 2368 2408 2379 2413 2362 2413 2329 2376 2316 2374 2316 2372 2316 1910 2327 1895 2316 1893 2316 1891 2316 1889 2316 1759 2325 1737 2314 1735 2314 1733 2314 1731 2314 1689 2325 1661 2314 1659 2314 1657 2314 1655 2314 1609 2325 1549 2314 1546 2314 1544 2314 1516 2325 1471 2314 1468 2314 1466 2314 1464 2314 1436 2325 1354 2314 1352 2314 1349 2314 1347 2314 1334 2325 1284 2314 1282 2314 650 2314 650 2355"/>
                        </Shape>
                        <String CONTENT="North American Indians did after the introduction of horses. Several bands,"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l25" HPOS="643" VPOS="2379" WIDTH="1718" HEIGHT="54" BASELINE="646 2414 2361 2418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 2414 643 2429 2356 2433 2361 2418 2359 2388 646 2379 646 2414"/>
                        </Shape>
                        <String CONTENT="however, raise large herds, so that they are able to live on their products."/>
                    </TextLine>
<TextLine ID="mz_1-096_l26" HPOS="752" VPOS="2433" WIDTH="1665" HEIGHT="63" BASELINE="754 2479 2417 2474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="754 2479 754 2496 2415 2492 2417 2474 2413 2446 2296 2446 2283 2433 2281 2433 2278 2433 2276 2433 2274 2433 2229 2444 1798 2433 1795 2433 1793 2433 1791 2433 1778 2446 1579 2446 1564 2435 1562 2435 1559 2435 1557 2435 1555 2435 1525 2446 1492 2435 1490 2435 1488 2435 1486 2435 1460 2446 1254 2435 1252 2435 1172 2446 1094 2435 1092 2435 1089 2435 1057 2446 1003 2435 1001 2435 999 2435 973 2446 960 2435 957 2435 955 2435 773 2435 771 2435 769 2435 767 2435 752 2444 754 2479"/>
                        </Shape>
                        <String CONTENT="Although the riding of reindeer is the most striking feature among Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l27" HPOS="639" VPOS="2505" WIDTH="1778" HEIGHT="58" BASELINE="641 2535 2417 2539" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="641 2535 639 2548 797 2561 799 2561 1453 2552 1551 2563 1553 2563 2415 2552 2417 2539 2417 2509 641 2505 641 2535"/>
                        </Shape>
                        <String CONTENT="reindeer-breeders, numerous bands have adopted a peculiar form of sledge"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l28" HPOS="643" VPOS="2554" WIDTH="1774" HEIGHT="63" BASELINE="643 2598 2417 2598" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="643 2598 643 2617 2417 2617 2417 2598 2417 2563 2402 2554 2400 2554 2398 2554 2395 2554 2393 2554 2354 2567 2268 2567 2252 2554 2250 2554 2248 2554 2246 2554 2244 2554 2218 2565 2200 2554 2198 2554 2196 2554 2194 2554 2192 2554 2168 2567 1893 2567 1876 2554 1873 2554 1871 2554 1869 2554 1867 2554 1841 2565 1791 2554 1789 2554 1787 2554 1763 2565 1713 2554 1711 2554 1709 2554 1676 2565 1661 2554 1659 2554 1657 2554 1655 2554 1653 2554 1627 2565 1577 2554 1575 2554 1572 2554 1544 2565 1499 2554 1497 2554 1494 2554 1492 2554 1468 2565 1369 2554 1367 2554 643 2563 643 2598"/>
                        </Shape>
                        <String CONTENT="(Fig. 4) with stanchions fitted into circular holes in the runners and fastened"/>
                    </TextLine>
<TextLine ID="mz_1-096_l29" HPOS="643" VPOS="3100" WIDTH="1765" HEIGHT="61" BASELINE="646 3141 2408 3145" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2400 3124 2389 3113 1579 3113 1525 3100 1523 3100 646 3106 646 3141 643 3156 2404 3161 2408 3145 2406 3141 2400 3124"/>
                        </Shape>
                        <String CONTENT="with thongs, and with a circular bow-like fore-part for attaching the traces, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l30" HPOS="643" VPOS="3167" WIDTH="1432" HEIGHT="63" BASELINE="646 3197 2075 3204" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 3197 643 3215 1232 3230 1235 3230 2073 3221 2075 3204 2073 3174 646 3167 646 3197"/>
                        </Shape>
                        <String CONTENT="the same as is used throughout eastern Siberia for dog-teams."/>
                    </TextLine>
<TextLine ID="mz_1-096_l31" HPOS="1471" VPOS="3221" WIDTH="95" HEIGHT="89" BASELINE="1475 3284 1566 3277" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1475 3284 1475 3301 1486 3310 1488 3310 1490 3310 1492 3310 1494 3310 1497 3310 1518 3297 1566 3303 1566 3277 1557 3221 1471 3236 1475 3284"/>
                        </Shape>
                        <String CONTENT="[70]"/>
                    </TextLine>
