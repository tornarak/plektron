                        <Shape>
                            <Polygon POINTS="775 2494 775 2511 2436 2507 2438 2489 2434 2461 2317 2461 2304 2448 2302 2448 2299 2448 2297 2448 2295 2448 2250 2459 1819 2448 1816 2448 1814 2448 1812 2448 1799 2461 1600 2461 1585 2450 1583 2450 1580 2450 1578 2450 1576 2450 1546 2461 1513 2450 1511 2450 1509 2450 1507 2450 1481 2461 1275 2450 1273 2450 1193 2461 1115 2450 1113 2450 1110 2450 1078 2461 1024 2450 1022 2450 1020 2450 994 2461 981 2450 978 2450 976 2450 794 2450 792 2450 790 2450 788 2450 773 2459 775 2494"/>
                        </Shape>
                        <String CONTENT="Although the riding of reindeer is the most striking feature among Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l27" HPOS="660" VPOS="2520" WIDTH="1778" HEIGHT="58" BASELINE="662 2550 2438 2554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="662 2550 660 2563 818 2576 820 2576 1474 2567 1572 2578 1574 2578 2436 2567 2438 2554 2438 2524 662 2520 662 2550"/>
                        </Shape>
                        <String CONTENT="reindeer-breeders, numerous bands have adopted a peculiar form of sledge"/>
                    </TextLine>

                    <TextLine ID="mz_1-096_l28" HPOS="664" VPOS="2569" WIDTH="1774" HEIGHT="63" BASELINE="664 2613 2438 2613" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="664 2613 664 2632 2438 2632 2438 2613 2438 2578 2423 2569 2421 2569 2419 2569 2416 2569 2414 2569 2375 2582 2289 2582 2273 2569 2271 2569 2269 2569 2267 2569 2265 2569 2239 2580 2221 2569 2219 2569 2217 2569 2215 2569 2213 2569 2189 2582 1914 2582 1897 2569 1894 2569 1892 2569 1890 2569 1888 2569 1862 2580 1812 2569 1810 2569 1808 2569 1784 2580 1734 2569 1732 2569 1730 2569 1697 2580 1682 2569 1680 2569 1678 2569 1676 2569 1674 2569 1648 2580 1598 2569 1596 2569 1593 2569 1565 2580 1520 2569 1518 2569 1515 2569 1513 2569 1489 2580 1390 2569 1388 2569 664 2578 664 2613"/>
                        </Shape>
                        <String CONTENT="(Fig. 4) with stanchions fitted into circular holes in the runners and fastened"/>
                    </TextLine>
</TextBlock>
