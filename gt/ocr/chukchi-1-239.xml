                        </Shape>
                        <String CONTENT="house” of the Chukchee. It is also ancient, and the Chukchee consider it as"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l12" HPOS="357" VPOS="1283" WIDTH="1776" HEIGHT="57" BASELINE="359 1324 2133 1316" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="359 1324 359 1340 2130 1331 2133 1316 2126 1283 357 1290 359 1324"/>
                        </Shape>
                        <String CONTENT="characteristic of their tribe. Outside of the Chukchee territory, setting aside its"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l13" HPOS="357" VPOS="1340" WIDTH="1773" HEIGHT="60" BASELINE="359 1383 2130 1379" TAGREFS="TYPE_5">
                        <Shape>
