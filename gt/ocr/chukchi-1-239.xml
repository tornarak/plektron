                        <String CONTENT="shore no logs fit for the purpose can be found. Thus the use of the tree-"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l32" HPOS="365" VPOS="2474" WIDTH="1772" HEIGHT="65" BASELINE="368 2522 2137 2515" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2522 368 2539 2135 2533 2137 2515 2133 2485 1552 2474 1550 2474 1548 2474 1546 2474 1533 2487 365 2487 368 2522"/>
                        </Shape>
                        <String CONTENT="ladder ceases suddenly on this part of the Asiatic shore for want of material."/>
