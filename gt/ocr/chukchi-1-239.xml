                        </Shape>
                        <String CONTENT="Kamchadal in Asia. Another type is the double skin house, the “genuine"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l11" HPOS="359" VPOS="1216" WIDTH="1774" HEIGHT="61" BASELINE="361 1262 2133 1257" TAGREFS="TYPE_5">
                        <Shape>
