                        </Shape>
                        <String CONTENT="branches of the Maritime Koryak. The lack of a roof-entrance with its cha-"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l30" HPOS="365" VPOS="2355" WIDTH="1774" HEIGHT="63" BASELINE="368 2405 2139 2396" TAGREFS="TYPE_5">
                        <Shape>
