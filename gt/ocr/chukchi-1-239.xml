                        <Shape>
                            <Polygon POINTS="363 1801 363 1818 2137 1818 2137 1801 2135 1768 363 1768 363 1801"/>
                        </Shape>
                        <String CONTENT="stunted willow and birch trees are placed between to fill in the spaces, and"/>
