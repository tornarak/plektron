                    <TextLine ID="mz_1-239_l33" HPOS="368" VPOS="2546" WIDTH="1769" HEIGHT="52" BASELINE="370 2580 2137 2576" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2580 370 2598 2135 2593 2137 2576 2130 2546 368 2546 370 2580"/>
                        </Shape>
                        <String CONTENT="Farther to the northward and eastward, across Bering Strait, along the American"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l34" HPOS="365" VPOS="2598" WIDTH="1772" HEIGHT="58" BASELINE="368 2641 2137 2634" TAGREFS="TYPE_5">
                        <Shape>
