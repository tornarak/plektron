                        </Shape>
                        <String CONTENT="racteristic tree-ladder, however, gives it a peculiar feature. On that part of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l31" HPOS="365" VPOS="2416" WIDTH="1772" HEIGHT="69" BASELINE="368 2463 2137 2455" TAGREFS="TYPE_5">
                        <Shape>
