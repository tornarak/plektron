                    <TextLine ID="mz_1-239_l18" HPOS="363" VPOS="1647" WIDTH="1770" HEIGHT="52" BASELINE="365 1680 2133 1675" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="365 1680 365 1699 2130 1695 2133 1675 2128 1647 363 1647 365 1680"/>
                        </Shape>
                        <String CONTENT="Their half-underground house has a frame roughly constructed of such poles"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l19" HPOS="361" VPOS="1699" WIDTH="1776" HEIGHT="56" BASELINE="363 1742 2137 1738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="363 1742 363 1755 2135 1751 2137 1738 2133 1699 1249 1699 1247 1699 1158 1710 435 1701 433 1701 361 1712 363 1742"/>
                        </Shape>
                        <String CONTENT="and pieces of wood as they can find on the shore. Crooked branches of"/>
                    </TextLine>

