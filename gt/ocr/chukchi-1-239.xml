                        <Shape>
                            <Polygon POINTS="363 1920 363 1937 2137 1937 2137 1920 2137 1892 363 1892 363 1920"/>
                        </Shape>
                        <String CONTENT="and from without with sod and loose earth. A long, low, narrow passage"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l23" HPOS="363" VPOS="1939" WIDTH="1772" HEIGHT="59" BASELINE="365 1983 2135 1978" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="365 1983 365 1996 2130 1998 2135 1978 2130 1948 448 1939 446 1939 363 1950 365 1983"/>
                        </Shape>
                        <String CONTENT="made of similar material forms the entrance. It is divided into three parts,"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l24" HPOS="361" VPOS="1996" WIDTH="1774" HEIGHT="71" BASELINE="363 2043 2135 2037" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="363 2043 363 2056 578 2067 580 2067 582 2067 584 2067 599 2056 2133 2056 2135 2037 2133 2009 2107 1996 2105 1996 2102 1996 2100 1996 2076 2009 1821 2009 1788 1996 1786 1996 1784 1996 1667 2006 1632 1996 1630 1996 1628 1996 1541 2009 1518 1998 1515 1998 1513 1998 1071 2009 974 1998 972 1998 970 1998 968 1998 948 2011 868 2000 866 2000 712 2011 641 2000 638 2000 636 2000 597 2011 389 2000 387 2000 385 2000 361 2011 363 2043"/>
                        </Shape>
                        <String CONTENT="closed by skin curtains. This structure is used in spring and summer as it"/>
