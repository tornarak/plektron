                        <String CONTENT="two principal types of house. One is the “jaw-bone house,” which in ancient"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l7" HPOS="359" VPOS="978" WIDTH="1776" HEIGHT="61" BASELINE="361 1024 2135 1019" TAGREFS="TYPE_5">
