                    </TextLine>

                    <TextLine ID="mz_1-239_l9" HPOS="361" VPOS="1099" WIDTH="1772" HEIGHT="59" BASELINE="363 1140 2133 1136" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="363 1140 363 1158 2130 1153 2133 1136 2128 1104 389 1099 387 1099 385 1099 361 1108 363 1140"/>
                        </Shape>
