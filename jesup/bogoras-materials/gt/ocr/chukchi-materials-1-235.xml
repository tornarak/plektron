          <TextLine ID="mz_1-235_l1" HPOS="600" VPOS="541" WIDTH="2984" HEIGHT="100" BASELINE="600 634 3584 634">
            <Shape>
              <Polygon POINTS="600 541 3584 541 3584 641 600 641"/>
            </Shape>
            <String CONTENT="II,64. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 179" HPOS="600" VPOS="541" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-235_l2" HPOS="609" VPOS="753" WIDTH="2973" HEIGHT="99" BASELINE="609 851 3582 851">
            <Shape>
              <Polygon POINTS="609 753 3582 753 3582 852 609 852"/>
            </Shape>
            <String CONTENT="сдѣлаю? поскорѣе, а то прискачетъ сюда! Развѣ каменной плахой?»¹) —" HPOS="609" VPOS="753" WIDTH="2973" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l3" HPOS="611" VPOS="840" WIDTH="2982" HEIGHT="134" BASELINE="611 953 3593 953">
            <Shape>
              <Polygon POINTS="611 840 3593 840 3593 974 611 974"/>
            </Shape>
            <String CONTENT="«Узнаетъ!» — «Ну молотомъ». — «Узнаетъ!» — «Ну жердью». — «Узнаетъ!» —" HPOS="611" VPOS="840" WIDTH="2982" HEIGHT="134"/>
          </TextLine>
          <TextLine ID="mz_1-235_l4" HPOS="610" VPOS="947" WIDTH="2975" HEIGHT="154" BASELINE="610 1100 3585 1100">
            <Shape>
              <Polygon POINTS="610 947 3585 947 3585 1101 610 1101"/>
            </Shape>
            <String CONTENT="«Ну волосомъ въ пологу?» — «Узнаетъ, узнаетъ!» — «Что ты за диво!" HPOS="610" VPOS="947" WIDTH="2975" HEIGHT="154"/>
          </TextLine>
          <TextLine ID="mz_1-235_l5" HPOS="614" VPOS="1065" WIDTH="2974" HEIGHT="147" BASELINE="614 1211 3588 1211">
            <Shape>
              <Polygon POINTS="614 1065 3588 1065 3588 1212 614 1212"/>
            </Shape>
            <String CONTENT="Сдѣлаю тебя хоть лампой!» — «Ладно, ладно!» — «Ну, садись на огонь!»" HPOS="614" VPOS="1065" WIDTH="2974" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-235_l6" HPOS="611" VPOS="1244" WIDTH="2979" HEIGHT="103" BASELINE="611 1347 3590 1347">
            <Shape>
              <Polygon POINTS="611 1244 3590 1244 3590 1347 611 1347"/>
            </Shape>
            <String CONTENT="Только усѣлась, а мѣсяцъ уже обыскалъ стадо и примчался домой, оленей" HPOS="611" VPOS="1244" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-235_l7" HPOS="613" VPOS="1378" WIDTH="2979" HEIGHT="97" BASELINE="613 1474 3592 1474">
            <Shape>
              <Polygon POINTS="613 1378 3592 1378 3592 1475 613 1475"/>
            </Shape>
            <String CONTENT="привязалъ и вошелъ въ пологъ; ищетъ, ищетъ, найти не можетъ; смотритъ" HPOS="613" VPOS="1378" WIDTH="2979" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-235_l8" HPOS="610" VPOS="1504" WIDTH="2981" HEIGHT="97" BASELINE="610 1600 3591 1600">
            <Shape>
              <Polygon POINTS="610 1504 3591 1504 3591 1601 610 1601"/>
            </Shape>
            <String CONTENT="и между жердями, разсматриваетъ всѣ вещи, каждый волосъ на шкурахъ," HPOS="610" VPOS="1504" WIDTH="2981" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-235_l9" HPOS="615" VPOS="1628" WIDTH="2969" HEIGHT="97" BASELINE="615 1724 3584 1724">
            <Shape>
              <Polygon POINTS="615 1628 3584 1628 3584 1725 615 1725"/>
            </Shape>
            <String CONTENT="каждый сучекъ подъ постелями, каждую частичку земли по угламъ шатра;" HPOS="615" VPOS="1628" WIDTH="2969" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-235_l10" HPOS="611" VPOS="1751" WIDTH="2982" HEIGHT="100" BASELINE="611 1850 3593 1850">
            <Shape>
              <Polygon POINTS="611 1751 3593 1751 3593 1851 611 1851"/>
            </Shape>
            <String CONTENT="нигдѣ нѣтъ, а къ лампѣ подойти не можетъ, ибо огонь на огонь. Гово-" HPOS="611" VPOS="1751" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-235_l11" HPOS="618" VPOS="1871" WIDTH="2973" HEIGHT="106" BASELINE="618 1976 3591 1976">
            <Shape>
              <Polygon POINTS="618 1871 3591 1871 3591 1977 618 1977"/>
            </Shape>
            <String CONTENT="рить: «Диво, гдѣ же она? Развѣ вернуться домой?» Вышелъ, развязываетъ" HPOS="618" VPOS="1871" WIDTH="2973" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-235_l12" HPOS="615" VPOS="2003" WIDTH="2978" HEIGHT="98" BASELINE="615 2100 3593 2100">
            <Shape>
              <Polygon POINTS="615 2003 3593 2003 3593 2101 615 2101"/>
            </Shape>
            <String CONTENT="оленей. Только собрался уѣзжать, соскочила съ огня, высунулась по поясъ" HPOS="615" VPOS="2003" WIDTH="2978" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-235_l13" HPOS="612" VPOS="2128" WIDTH="2988" HEIGHT="99" BASELINE="612 2226 3600 2226">
            <Shape>
              <Polygon POINTS="612 2128 3600 2128 3600 2227 612 2227"/>
            </Shape>
            <String CONTENT="изъ полога. «Вотъ я, вотъ я!» Бросилъ оленей, опять въ пологъ, она опять" HPOS="612" VPOS="2128" WIDTH="2988" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l14" HPOS="619" VPOS="2249" WIDTH="2980" HEIGHT="102" BASELINE="619 2350 3599 2350">
            <Shape>
              <Polygon POINTS="619 2249 3599 2249 3599 2351 619 2351"/>
            </Shape>
            <String CONTENT="на огонь. Ищетъ и между сучками, и между листьями, и между шерстин-" HPOS="619" VPOS="2249" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-235_l15" HPOS="619" VPOS="2364" WIDTH="2979" HEIGHT="108" BASELINE="619 2472 3598 2472">
            <Shape>
              <Polygon POINTS="619 2364 3598 2364 3598 2472 619 2472"/>
            </Shape>
            <String CONTENT="ками, и между частицами земли, нигдѣ нѣтъ. «О, что за диво! гдѣ же она?" HPOS="619" VPOS="2364" WIDTH="2979" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-235_l16" HPOS="615" VPOS="2500" WIDTH="2987" HEIGHT="102" BASELINE="615 2602 3602 2602">
            <Shape>
              <Polygon POINTS="615 2500 3602 2500 3602 2602 615 2602"/>
            </Shape>
            <String CONTENT="Развѣ уѣхать?» Только вышелъ, развязываетъ оленей, а она высунулась" HPOS="615" VPOS="2500" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-235_l17" HPOS="621" VPOS="2628" WIDTH="2984" HEIGHT="96" BASELINE="621 2723 3605 2723">
            <Shape>
              <Polygon POINTS="621 2628 3605 2628 3605 2724 621 2724"/>
            </Shape>
            <String CONTENT="по поясъ изъ полога. «Вотъ я, вотъ я!» Опять началъ искать, не можетъ" HPOS="621" VPOS="2628" WIDTH="2984" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-235_l18" HPOS="624" VPOS="2746" WIDTH="2978" HEIGHT="104" BASELINE="624 2849 3602 2849">
            <Shape>
              <Polygon POINTS="624 2746 3602 2746 3602 2850 624 2850"/>
            </Shape>
            <String CONTENT="найти. Наконецъ усталъ, высохъ, мозгъ въ костяхъ изсохъ. Тогда уже" HPOS="624" VPOS="2746" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-235_l19" HPOS="623" VPOS="2881" WIDTH="2980" HEIGHT="93" BASELINE="623 2973 3603 2973">
            <Shape>
              <Polygon POINTS="623 2881 3603 2881 3603 2974 623 2974"/>
            </Shape>
            <String CONTENT="высунулась вся, схватила его, бросила на спину, связала ноги, положила" HPOS="623" VPOS="2881" WIDTH="2980" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-235_l20" HPOS="618" VPOS="2994" WIDTH="2985" HEIGHT="108" BASELINE="618 3101 3603 3101">
            <Shape>
              <Polygon POINTS="618 2994 3603 2994 3603 3102 618 3102"/>
            </Shape>
            <String CONTENT="въ шатрѣ. «Ого», говоритъ, «убьетъ меня! Ну чтожъ, пускай, ибо я хотѣлъ" HPOS="618" VPOS="2994" WIDTH="2985" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-235_l21" HPOS="620" VPOS="3125" WIDTH="2982" HEIGHT="101" BASELINE="620 3225 3602 3225">
            <Shape>
              <Polygon POINTS="620 3125 3602 3125 3602 3226 620 3226"/>
            </Shape>
            <String CONTENT="тебя увезти! Убьешь меня, такъ убей, а только передъ концомъ положи" HPOS="620" VPOS="3125" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-235_l22" HPOS="619" VPOS="3209" WIDTH="2983" HEIGHT="137" BASELINE="619 3345 3602 3345">
            <Shape>
              <Polygon POINTS="619 3209 3602 3209 3602 3346 619 3346"/>
            </Shape>
            <String CONTENT="меня въ пологъ, ибо зябну!» — «Какъ зябнешь? не ври! ты вѣчно на-" HPOS="619" VPOS="3209" WIDTH="2983" HEIGHT="137"/>
          </TextLine>
          <TextLine ID="mz_1-235_l23" HPOS="621" VPOS="3352" WIDTH="2987" HEIGHT="101" BASELINE="621 3452 3608 3452">
            <Shape>
              <Polygon POINTS="621 3352 3608 3352 3608 3453 621 3453"/>
            </Shape>
            <String CONTENT="ружный; оставайся и теперь снаружи! Какой пологъ тебѣ!» — «Если я," HPOS="621" VPOS="3352" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-235_l24" HPOS="620" VPOS="3480" WIDTH="2977" HEIGHT="119" BASELINE="620 3598 3597 3598">
            <Shape>
              <Polygon POINTS="620 3480 3597 3480 3597 3599 620 3599"/>
            </Shape>
            <String CONTENT="вѣчно наружный, отпусти меня наружу! Я буду забавой твоему народу;" HPOS="620" VPOS="3480" WIDTH="2977" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-235_l25" HPOS="624" VPOS="3624" WIDTH="2975" HEIGHT="97" BASELINE="624 3720 3599 3720">
            <Shape>
              <Polygon POINTS="624 3624 3599 3624 3599 3721 624 3721"/>
            </Shape>
            <String CONTENT="отпусти меня, я буду ему замѣтой; отпусти меня, я буду превращать день" HPOS="624" VPOS="3624" WIDTH="2975" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-235_l26" HPOS="629" VPOS="3749" WIDTH="2971" HEIGHT="99" BASELINE="629 3847 3600 3847">
            <Shape>
              <Polygon POINTS="629 3749 3600 3749 3600 3848 629 3848"/>
            </Shape>
            <String CONTENT="въ ночь, отпусти меня, я твоему народу измѣрю годъ, буду сперва мѣсяцемъ" HPOS="629" VPOS="3749" WIDTH="2971" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l27" HPOS="623" VPOS="3874" WIDTH="2975" HEIGHT="98" BASELINE="623 3972 3598 3972">
            <Shape>
              <Polygon POINTS="623 3874 3598 3874 3598 3972 623 3972"/>
            </Shape>
            <String CONTENT="стараго быка, потомъ мѣсяцемъ холода, потомъ мѣсяцемъ обнаженія вы-" HPOS="623" VPOS="3874" WIDTH="2975" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-235_l28" HPOS="620" VPOS="3997" WIDTH="2977" HEIGHT="99" BASELINE="620 4095 3597 4095">
            <Shape>
              <Polygon POINTS="620 3997 3597 3997 3597 4096 620 4096"/>
            </Shape>
            <String CONTENT="мени, потомъ мѣсяцемъ рожденія телятъ, потомъ мѣсяцемъ водъ, потомъ" HPOS="620" VPOS="3997" WIDTH="2977" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l29" HPOS="616" VPOS="4121" WIDTH="2981" HEIGHT="99" BASELINE="616 4219 3597 4219">
            <Shape>
              <Polygon POINTS="616 4121 3597 4121 3597 4220 616 4220"/>
            </Shape>
            <String CONTENT="мѣсяцемъ листьевъ, потомъ теплымъ мѣсяцемъ, потомъ мѣсяцемъ обди-" HPOS="616" VPOS="4121" WIDTH="2981" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l30" HPOS="620" VPOS="4248" WIDTH="2979" HEIGHT="98" BASELINE="620 4345 3599 4345">
            <Shape>
              <Polygon POINTS="620 4248 3599 4248 3599 4346 620 4346"/>
            </Shape>
            <String CONTENT="ранія роговъ, потомъ мѣсяцемъ течки дикихъ оленей, потомъ мѣсяцемъ" HPOS="620" VPOS="4248" WIDTH="2979" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-235_l31" HPOS="620" VPOS="4374" WIDTH="2977" HEIGHT="99" BASELINE="620 4472 3597 4472">
            <Shape>
              <Polygon POINTS="620 4374 3597 4374 3597 4473 620 4473"/>
            </Shape>
            <String CONTENT="первой зимы, потомъ мѣсяцемъ съуженія дней» (ынпlу́wlэӈ, чачанlо́рђын," HPOS="620" VPOS="4374" WIDTH="2977" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-235_l32" HPOS="620" VPOS="4483" WIDTH="2974" HEIGHT="120" BASELINE="620 4602 3594 4602">
            <Shape>
              <Polygon POINTS="620 4483 3594 4483 3594 4603 620 4603"/>
            </Shape>
            <String CONTENT="lееlо́рђын, ђрое̂́lђын, і́мlырыlын, та́wтын-је̂́lђын, о̀м-је̂́lһын, нэђі̂́lђын," HPOS="620" VPOS="4483" WIDTH="2974" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-235_l33" HPOS="620" VPOS="4612" WIDTH="2981" HEIGHT="115" BASELINE="620 4726 3601 4726">
            <Shape>
              <Polygon POINTS="620 4612 3601 4612 3601 4727 620 4727"/>
            </Shape>
            <String CONTENT="ӈэрђэђі̂́lђын, ђытһа̀-е̂́lђын, јара́ўчын, ӄу́уlэђ)²). — «А когда выпущу," HPOS="620" VPOS="4612" WIDTH="2981" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-235_l34" HPOS="624" VPOS="4748" WIDTH="2981" HEIGHT="98" BASELINE="624 4845 3605 4845">
            <Shape>
              <Polygon POINTS="624 4748 3605 4748 3605 4846 624 4846"/>
            </Shape>
            <String CONTENT="поправишься, станетъ хорошій мозгъ въ костяхъ, не станешь за мной" HPOS="624" VPOS="4748" WIDTH="2981" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-235_l35" HPOS="619" VPOS="4859" WIDTH="2983" HEIGHT="111" BASELINE="619 4965 3602 4965">
            <Shape>
              <Polygon POINTS="619 4859 3602 4859 3602 4970 619 4970"/>
            </Shape>
            <String CONTENT="пріѣзжать?» — «О, не стану! Совсѣмъ пересталъ! куда! ты слишкомъ" HPOS="619" VPOS="4859" WIDTH="2983" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-235_l36" HPOS="623" VPOS="4999" WIDTH="2978" HEIGHT="97" BASELINE="623 5095 3601 5095">
            <Shape>
              <Polygon POINTS="623 4999 3601 4999 3601 5096 623 5096"/>
            </Shape>
            <String CONTENT="вдохновенная! Никогда больше не сойду съ верхового пути! Отпусти, за-" HPOS="623" VPOS="4999" WIDTH="2978" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-235_l37" HPOS="624" VPOS="5126" WIDTH="1203" HEIGHT="95" BASELINE="624 5221 1827 5221">
            <Shape>
              <Polygon POINTS="624 5126 1827 5126 1827 5221 624 5221"/>
            </Shape>
            <String CONTENT="свѣчу!» Отпустила, засвѣтилъ." HPOS="624" VPOS="5126" WIDTH="1203" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-235_l38" HPOS="841" VPOS="5249" WIDTH="2214" HEIGHT="102" BASELINE="841 5350 3055 5350">
