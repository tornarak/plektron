          <TextLine ID="mz_1-283_l1" HPOS="608" VPOS="545" WIDTH="2986" HEIGHT="122" BASELINE="608 644 3594 644">
            <Shape>
              <Polygon POINTS="608 545 3594 545 3594 667 608 667"/>
            </Shape>
            <String CONTENT="II,84. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 227" HPOS="608" VPOS="545" WIDTH="2986" HEIGHT="122"/>
          </TextLine>
          <TextLine ID="mz_1-283_l2" HPOS="605" VPOS="778" WIDTH="2988" HEIGHT="101" BASELINE="605 878 3593 878">
            <Shape>
              <Polygon POINTS="605 778 3593 778 3593 879 605 879"/>
            </Shape>
            <String CONTENT="заснулъ; а онѣ тоже спятъ. Наконецъ, старшій Кэ́lє тихонько шепнулъ" HPOS="605" VPOS="778" WIDTH="2988" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-283_l3" HPOS="596" VPOS="846" WIDTH="2998" HEIGHT="160" BASELINE="596 1005 3594 1005">
            <Shape>
              <Polygon POINTS="596 846 3594 846 3594 1006 596 1006"/>
            </Shape>
            <String CONTENT="Нэнэ́ну, не слышно для другихъ: «Нэнэ́н!» — «Wуј?» — «Старикъ у тебя" HPOS="596" VPOS="846" WIDTH="2998" HEIGHT="160"/>
          </TextLine>
          <TextLine ID="mz_1-283_l4" HPOS="607" VPOS="1030" WIDTH="2992" HEIGHT="102" BASELINE="607 1131 3599 1131">
            <Shape>
              <Polygon POINTS="607 1030 3599 1030 3599 1132 607 1132"/>
            </Shape>
            <String CONTENT="женъ отнимаетъ. Проснись, и если не проснешься, потеряешь ихъ на" HPOS="607" VPOS="1030" WIDTH="2992" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-283_l5" HPOS="609" VPOS="1117" WIDTH="2986" HEIGHT="138" BASELINE="609 1254 3595 1254">
            <Shape>
              <Polygon POINTS="609 1117 3595 1117 3595 1255 609 1255"/>
            </Shape>
            <String CONTENT="вѣки!» — «Э-э-й!» Проснулся. «Поди на дворъ. Въ снѣгу спрятанъ гарпунъ," HPOS="609" VPOS="1117" WIDTH="2986" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-283_l6" HPOS="861" VPOS="1189" WIDTH="31" HEIGHT="24" BASELINE="861 1212 892 1212">
            <Shape>
              <Polygon POINTS="861 1189 892 1189 892 1213 861 1213"/>
            </Shape>
            <String CONTENT="" HPOS="861" VPOS="1189" WIDTH="31" HEIGHT="24"/>
          </TextLine>
          <TextLine ID="mz_1-283_l7" HPOS="606" VPOS="1282" WIDTH="2987" HEIGHT="99" BASELINE="606 1380 3593 1380">
            <Shape>
              <Polygon POINTS="606 1282 3593 1282 3593 1381 606 1381"/>
            </Shape>
            <String CONTENT="вынь его, перепрячь на другое мѣсто, войди въ пологъ. Станетъ старикъ" HPOS="606" VPOS="1282" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-283_l8" HPOS="606" VPOS="1383" WIDTH="2987" HEIGHT="120" BASELINE="606 1502 3593 1502">
            <Shape>
              <Polygon POINTS="606 1383 3593 1383 3593 1503 606 1503"/>
            </Shape>
            <String CONTENT="спрашивать: ‚Откуда ты?‘ Скажи: ‚Нѣтъ! Я только-что проснулся!‘» Вы-" HPOS="606" VPOS="1383" WIDTH="2987" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-283_l9" HPOS="601" VPOS="1469" WIDTH="2992" HEIGHT="135" BASELINE="601 1604 3593 1604">
            <Shape>
              <Polygon POINTS="601 1469 3593 1469 3593 1604 601 1604"/>
            </Shape>
            <String CONTENT="шелъ, перепряталъ, вошелъ. Старикъ проснулся: «Ты откуда?» — «Я не" HPOS="601" VPOS="1469" WIDTH="2992" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-283_l10" HPOS="600" VPOS="1614" WIDTH="2991" HEIGHT="138" BASELINE="600 1751 3591 1751">
            <Shape>
              <Polygon POINTS="600 1614 3591 1614 3591 1752 600 1752"/>
            </Shape>
            <String CONTENT="выходилъ изъ полога!» — «Нѣтъ, ты со двора!» — «Право я не выходилъ!» —" HPOS="600" VPOS="1614" WIDTH="2991" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-283_l11" HPOS="602" VPOS="1732" WIDTH="2985" HEIGHT="141" BASELINE="602 1872 3587 1872">
            <Shape>
              <Polygon POINTS="602 1732 3587 1732 3587 1873 602 1873"/>
            </Shape>
            <String CONTENT="«Э-э-э! Я пришелъ за женами!» — «Скорѣе одѣньтесь, выйдите!» Одѣлись," HPOS="602" VPOS="1732" WIDTH="2985" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-283_l12" HPOS="604" VPOS="1895" WIDTH="2988" HEIGHT="103" BASELINE="604 1998 3592 1998">
            <Shape>
              <Polygon POINTS="604 1895 3592 1895 3592 1998 604 1998"/>
            </Shape>
            <String CONTENT="вышли. Старикъ ихъ поставилъ вдоль. Говоритъ: «Подождите!» Пошелъ" HPOS="604" VPOS="1895" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-283_l13" HPOS="603" VPOS="1982" WIDTH="2981" HEIGHT="148" BASELINE="603 2129 3584 2129">
            <Shape>
              <Polygon POINTS="603 1982 3584 1982 3584 2130 603 2130"/>
            </Shape>
            <String CONTENT="искать гарпунъ. Ищетъ, роется въ снѣгу, — нѣту. Сталъ безспокоиться, —" HPOS="603" VPOS="1982" WIDTH="2981" HEIGHT="148"/>
          </TextLine>
          <TextLine ID="mz_1-283_l14" HPOS="601" VPOS="2119" WIDTH="2986" HEIGHT="131" BASELINE="601 2249 3587 2249">
            <Shape>
              <Polygon POINTS="601 2119 3587 2119 3587 2250 601 2250"/>
            </Shape>
            <String CONTENT="нѣтъ! Наконецъ заплакалъ. «Нэнэ́н! Отдай гарпунъ!» — «Какой гарпунъ?" HPOS="601" VPOS="2119" WIDTH="2986" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-283_l15" HPOS="593" VPOS="2268" WIDTH="2986" HEIGHT="105" BASELINE="593 2373 3579 2373">
            <Shape>
              <Polygon POINTS="593 2268 3579 2268 3579 2373 593 2373"/>
            </Shape>
            <String CONTENT="Нѣтъ! Не знаю!» Плачетъ старикъ, — нѣтъ гарпуна. Пошелъ къ дому." HPOS="593" VPOS="2268" WIDTH="2986" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-283_l16" HPOS="600" VPOS="2399" WIDTH="2987" HEIGHT="106" BASELINE="600 2504 3587 2504">
            <Shape>
              <Polygon POINTS="600 2399 3587 2399 3587 2505 600 2505"/>
            </Shape>
            <String CONTENT="Стоятъ жены. Ударилъ ихъ. «Уйдите, чтобъ я не видѣлъ васъ! Надоѣдливыя" HPOS="600" VPOS="2399" WIDTH="2987" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-283_l17" HPOS="600" VPOS="2529" WIDTH="2990" HEIGHT="99" BASELINE="600 2628 3590 2628">
            <Shape>
              <Polygon POINTS="600 2529 3590 2529 3590 2628 600 2628"/>
            </Shape>
            <String CONTENT="вы!» Выпросилъ у Нэнэ́на штаны; собралъ пищу, пошелъ съ посохомъ" HPOS="600" VPOS="2529" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-283_l18" HPOS="597" VPOS="2650" WIDTH="2981" HEIGHT="102" BASELINE="597 2751 3578 2751">
            <Shape>
              <Polygon POINTS="597 2650 3578 2650 3578 2752 597 2752"/>
            </Shape>
            <String CONTENT="домой пѣшкомъ. Идетъ пѣшкомъ, пѣшій. Остался Малютка съ женами," HPOS="597" VPOS="2650" WIDTH="2981" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-283_l19" HPOS="591" VPOS="2790" WIDTH="311" HEIGHT="70" BASELINE="591 2859 902 2859">
            <Shape>
              <Polygon POINTS="591 2790 902 2790 902 2860 591 2860"/>
            </Shape>
            <String CONTENT="живетъ." HPOS="591" VPOS="2790" WIDTH="311" HEIGHT="70"/>
          </TextLine>
          <TextLine ID="mz_1-283_l20" HPOS="805" VPOS="2961" WIDTH="1626" HEIGHT="97" BASELINE="805 3057 2431 3057">
            <Shape>
              <Polygon POINTS="805 2961 2431 2961 2431 3058 805 3058"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Чэ́ӈэ на р. Россомашьей." HPOS="805" VPOS="2961" WIDTH="1626" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-283_l21" HPOS="2009" VPOS="3233" WIDTH="144" HEIGHT="107" BASELINE="2009 3340 2153 3340">
            <Shape>
              <Polygon POINTS="2009 3233 2153 3233 2153 3340 2009 3340"/>
            </Shape>
            <String CONTENT="84." HPOS="2009" VPOS="3233" WIDTH="144" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-283_l22" HPOS="1358" VPOS="3510" WIDTH="1465" HEIGHT="108" BASELINE="1358 3617 2823 3617">
            <Shape>
              <Polygon POINTS="1358 3510 2823 3510 2823 3618 1358 3618"/>
            </Shape>
            <String CONTENT="Муłу́wђін э́кык. Муłу́wђі сынъ." HPOS="1358" VPOS="3510" WIDTH="1465" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-283_l23" HPOS="804" VPOS="3715" WIDTH="2783" HEIGHT="101" BASELINE="804 3815 3587 3815">
            <Shape>
              <Polygon POINTS="804 3715 3587 3715 3587 3816 804 3816"/>
            </Shape>
            <String CONTENT="Муłу́wђі шаманилъ въ наружномъ шатрѣ, постоянно спалъ у входа" HPOS="804" VPOS="3715" WIDTH="2783" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-283_l24" HPOS="596" VPOS="3831" WIDTH="2987" HEIGHT="99" BASELINE="596 3929 3583 3929">
            <Shape>
              <Polygon POINTS="596 3831 3583 3831 3583 3930 596 3930"/>
            </Shape>
            <String CONTENT="въ пологъ. Тамъ не могъ шаманить. Пошелъ къ каменнымъ людямъ¹)" HPOS="596" VPOS="3831" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-283_l25" HPOS="594" VPOS="3962" WIDTH="2989" HEIGHT="96" BASELINE="594 4058 3583 4058">
            <Shape>
              <Polygon POINTS="594 3962 3583 3962 3583 4058 594 4058"/>
            </Shape>
            <String CONTENT="ночевать. Утромъ вернулся, говоритъ: «Тамъ тоже не могу шаманить!»" HPOS="594" VPOS="3962" WIDTH="2989" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-283_l26" HPOS="588" VPOS="4085" WIDTH="2995" HEIGHT="98" BASELINE="588 4182 3583 4182">
            <Shape>
              <Polygon POINTS="588 4085 3583 4085 3583 4183 588 4183"/>
            </Shape>
            <String CONTENT="Прямо вошелъ въ пологъ спать. Вечеромъ опять ушелъ къ каменнымъ" HPOS="588" VPOS="4085" WIDTH="2995" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-283_l27" HPOS="590" VPOS="4163" WIDTH="2993" HEIGHT="144" BASELINE="590 4306 3583 4306">
            <Shape>
              <Polygon POINTS="590 4163 3583 4163 3583 4307 590 4307"/>
            </Shape>
            <String CONTENT="людямъ. Увидѣлъ потомъ поѣздъ Кэ́lє — одноглазыя одноухія собаки. Кэ́lє" HPOS="590" VPOS="4163" WIDTH="2993" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-283_l28" HPOS="596" VPOS="4332" WIDTH="2986" HEIGHT="103" BASELINE="596 4434 3582 4434">
            <Shape>
              <Polygon POINTS="596 4332 3582 4332 3582 4435 596 4435"/>
            </Shape>
            <String CONTENT="отпустилъ собакъ. Онъ сказалъ: «Вотъ это я увидѣлъ къ будущему шаман-" HPOS="596" VPOS="4332" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-283_l29" HPOS="593" VPOS="4461" WIDTH="2985" HEIGHT="102" BASELINE="593 4563 3578 4563">
            <Shape>
              <Polygon POINTS="593 4461 3578 4461 3578 4563 593 4563"/>
            </Shape>
            <String CONTENT="ству». Собаки вошли въ шатеръ (жилица Муłу́wђі пять шатровъ). Одного" HPOS="593" VPOS="4461" WIDTH="2985" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-283_l30" HPOS="593" VPOS="4589" WIDTH="2982" HEIGHT="100" BASELINE="593 4689 3575 4689">
            <Shape>
              <Polygon POINTS="593 4589 3575 4589 3575 4689 593 4689"/>
            </Shape>
            <String CONTENT="ребенка собака унесла на дворъ, съѣла. Муłу́wђі схватилъ собаку, на озеро" HPOS="593" VPOS="4589" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-283_l31" HPOS="586" VPOS="4708" WIDTH="2986" HEIGHT="101" BASELINE="586 4809 3572 4809">
            <Shape>
              <Polygon POINTS="586 4708 3572 4708 3572 4809 586 4809"/>
            </Shape>
            <String CONTENT="увезъ. Тамъ тюлень ползаетъ на льдинѣ. Вмѣстѣ съ тюленемъ связалъ;" HPOS="586" VPOS="4708" WIDTH="2986" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-283_l32" HPOS="591" VPOS="4834" WIDTH="2979" HEIGHT="105" BASELINE="591 4939 3570 4939">
            <Shape>
              <Polygon POINTS="591 4834 3570 4834 3570 4939 591 4939"/>
            </Shape>
            <String CONTENT="покинулъ на льду недвижными. На другой день пришелъ Кэ́lє, говоритъ:" HPOS="591" VPOS="4834" WIDTH="2979" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-283_l33" HPOS="590" VPOS="4917" WIDTH="2980" HEIGHT="144" BASELINE="590 5060 3570 5060">
            <Shape>
              <Polygon POINTS="590 4917 3570 4917 3570 5061 590 5061"/>
            </Shape>
            <String CONTENT="«Давай собаку! Это моя кормилица; это мое горло²)». — Говоритъ Муłу́wђі:" HPOS="590" VPOS="4917" WIDTH="2980" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-283_l34" HPOS="589" VPOS="5076" WIDTH="2979" HEIGHT="107" BASELINE="589 5182 3568 5182">
            <Shape>
              <Polygon POINTS="589 5076 3568 5076 3568 5183 589 5183"/>
            </Shape>
            <String CONTENT="«Не дамъ! не дамъ! Въ нашихъ шатрахъ ребенка съѣла». Говоритъ Кэ́lє:" HPOS="589" VPOS="5076" WIDTH="2979" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-283_l35" HPOS="587" VPOS="5204" WIDTH="2981" HEIGHT="110" BASELINE="587 5314 3568 5314">
            <Shape>
              <Polygon POINTS="587 5204 3568 5204 3568 5314 587 5314"/>
            </Shape>
            <String CONTENT="«Дамъ въ обмѣнъ ребенка!» Муłу́wђі говоритъ: «О, нѣтъ!» Кэ́lє говоритъ:" HPOS="587" VPOS="5204" WIDTH="2981" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-283_l36" HPOS="590" VPOS="5285" WIDTH="2977" HEIGHT="149" BASELINE="590 5434 3567 5434">
            <Shape>
              <Polygon POINTS="590 5285 3567 5285 3567 5434 590 5434"/>
            </Shape>
            <String CONTENT="«Да! Вѣдь словно горло мое, ты эту собаку взялъ». — «Принеси ребенка," HPOS="590" VPOS="5285" WIDTH="2977" HEIGHT="149"/>
          </TextLine>
          <TextLine ID="mz_1-283_l37" HPOS="808" VPOS="5538" WIDTH="1865" HEIGHT="114" BASELINE="808 5651 2673 5651">
            <Shape>
              <Polygon POINTS="808 5538 2673 5538 2673 5652 808 5652"/>
            </Shape>
            <String CONTENT="1) Перка́пер — См. № 82 прим. 4) на стр. 220." HPOS="808" VPOS="5538" WIDTH="1865" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-283_l38" HPOS="805" VPOS="5659" WIDTH="2659" HEIGHT="99" BASELINE="805 5757 3464 5757">
            <Shape>
              <Polygon POINTS="805 5659 3464 5659 3464 5758 805 5758"/>
            </Shape>
            <String CONTENT="2) Ђумні́н пі́lђын — мое горло, т. е. даетъ мнѣ средства наполнять горло." HPOS="805" VPOS="5659" WIDTH="2659" HEIGHT="99"/>
          </TextLine>
