          <TextLine ID="mz_1-061_l4" HPOS="454" VPOS="1260" WIDTH="2978" HEIGHT="88" BASELINE="454 1347 3432 1347">
            <Shape>
              <Polygon POINTS="454 1260 3432 1260 3432 1348 454 1348"/>
            </Shape>
            <String CONTENT="приходятъ въ прирученныя стада. Чукчи очень цѣнятъ примѣсь крови дикаго оленя," HPOS="454" VPOS="1260" WIDTH="2978" HEIGHT="88"/>
          </TextLine>
          <TextLine ID="mz_1-061_l5" HPOS="451" VPOS="1371" WIDTH="2984" HEIGHT="84" BASELINE="451 1455 3435 1455">
            <Shape>
              <Polygon POINTS="451 1371 3435 1371 3435 1455 451 1455"/>
            </Shape>
            <String CONTENT="и отличаютъ ее до третьяго и четвертаго колѣна. Поэтому, дикаго быка, пришедшаго" HPOS="451" VPOS="1371" WIDTH="2984" HEIGHT="84"/>
          </TextLine>
          <TextLine ID="mz_1-061_l6" HPOS="456" VPOS="1480" WIDTH="2981" HEIGHT="83" BASELINE="456 1562 3437 1562">
            <Shape>
              <Polygon POINTS="456 1480 3437 1480 3437 1563 456 1563"/>
            </Shape>
            <String CONTENT="въ стадо, стараются удержать въ теченіе нѣсколькихъ дней различными заговорами" HPOS="456" VPOS="1480" WIDTH="2981" HEIGHT="83"/>
          </TextLine>
          <TextLine ID="mz_1-061_l7" HPOS="452" VPOS="1568" WIDTH="2987" HEIGHT="101" BASELINE="452 1668 3439 1668">
            <Shape>
              <Polygon POINTS="452 1568 3439 1568 3439 1669 452 1669"/>
            </Shape>
            <String CONTENT="и заклинаніями. Заговоръ имѣетъ силу на 5—8 дней, по истеченіи которыхъ быка" HPOS="452" VPOS="1568" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-061_l8" HPOS="452" VPOS="1692" WIDTH="2983" HEIGHT="87" BASELINE="452 1778 3435 1778">
            <Shape>
              <Polygon POINTS="452 1692 3435 1692 3435 1779 452 1779"/>
            </Shape>
            <String CONTENT="необходимо убить съ различными обрядами, часть которыхъ описана здѣсь. Заговоръ" HPOS="452" VPOS="1692" WIDTH="2983" HEIGHT="87"/>
          </TextLine>
          <TextLine ID="mz_1-061_l9" HPOS="456" VPOS="1795" WIDTH="2977" HEIGHT="87" BASELINE="456 1881 3433 1881">
