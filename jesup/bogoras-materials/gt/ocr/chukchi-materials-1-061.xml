            <String CONTENT="5 (стр. 8). а́таl-ве́н-ӄор собственно «чуванская выученная важенка»; чуван-" HPOS="665" VPOS="2637" WIDTH="2776" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-061_l18" HPOS="456" VPOS="2767" WIDTH="2988" HEIGHT="90" BASELINE="456 2856 3444 2856">
