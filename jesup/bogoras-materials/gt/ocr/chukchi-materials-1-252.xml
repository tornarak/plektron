            </Shape>
            <String CONTENT="свѣжему слѣду ушелъ (Кэ́lє). Увидѣлъ по дорогѣ собакъ, говоритъ: «По-" HPOS="1171" VPOS="773" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l4" HPOS="1170" VPOS="895" WIDTH="2990" HEIGHT="105" BASELINE="1170 999 4160 999">
            <Shape>
              <Polygon POINTS="1170 895 4160 895 4160 1000 1170 1000"/>
            </Shape>
            <String CONTENT="чему же такъ скоро издыхаютъ; не нужно ихъ» (отбросилъ въ сторону)." HPOS="1170" VPOS="895" WIDTH="2990" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-252_l5" HPOS="1171" VPOS="1013" WIDTH="2986" HEIGHT="111" BASELINE="1171 1123 4157 1123">
            <Shape>
              <Polygon POINTS="1171 1013 4157 1013 4157 1124 1171 1124"/>
            </Shape>
            <String CONTENT="«Ну, ну, погонюсь по дорогѣ; стану вмѣсто собаки! Ну-ка, что будетъ" HPOS="1171" VPOS="1013" WIDTH="2986" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-252_l6" HPOS="1168" VPOS="1148" WIDTH="2987" HEIGHT="96" BASELINE="1168 1243 4155 1243">
            <Shape>
              <Polygon POINTS="1168 1148 4155 1148 4155 1244 1168 1244"/>
            </Shape>
            <String CONTENT="между нами!» Подходя, сталъ чувствовать страхъ. Влѣзъ въ пологъ. «Эй!»" HPOS="1168" VPOS="1148" WIDTH="2987" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-252_l7" HPOS="1166" VPOS="1272" WIDTH="2994" HEIGHT="101" BASELINE="1166 1373 4160 1373">
            <Shape>
              <Polygon POINTS="1166 1272 4160 1272 4160 1373 1166 1373"/>
            </Shape>
            <String CONTENT="Другой, пока еще только голова его была всунута, ткнулъ его талинкой" HPOS="1166" VPOS="1272" WIDTH="2994" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l8" HPOS="1171" VPOS="1355" WIDTH="2979" HEIGHT="140" BASELINE="1171 1494 4150 1494">
            <Shape>
              <Polygon POINTS="1171 1355 4150 1355 4150 1495 1171 1495"/>
            </Shape>
            <String CONTENT="въ грудь, говоритъ также грубо: «Wуј¹)?» — «Умираю!» говоритъ Кэ́lє." HPOS="1171" VPOS="1355" WIDTH="2979" HEIGHT="140"/>
          </TextLine>
          <TextLine ID="mz_1-252_l9" HPOS="1177" VPOS="1502" WIDTH="2980" HEIGHT="103" BASELINE="1177 1604 4157 1604">
            <Shape>
              <Polygon POINTS="1177 1502 4157 1502 4157 1605 1177 1605"/>
            </Shape>
            <String CONTENT="«Како́, како́, талинкою убитъ²)!»... Умеръ. Ибо человѣкъ былъ шаманъ." HPOS="1177" VPOS="1502" WIDTH="2980" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-252_l10" HPOS="1170" VPOS="1627" WIDTH="2248" HEIGHT="95" BASELINE="1170 1721 3418 1721">
            <Shape>
              <Polygon POINTS="1170 1627 3418 1627 3418 1722 1170 1722"/>
            </Shape>
            <String CONTENT="Вѣтеръ тогда пересталъ. Погода настала тихая и ясная." HPOS="1170" VPOS="1627" WIDTH="2248" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-252_l11" HPOS="1388" VPOS="1785" WIDTH="1618" HEIGHT="102" BASELINE="1388 1886 3006 1886">
