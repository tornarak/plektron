              <Polygon POINTS="1391 4999 2592 4999 2592 5085 1391 5085"/>
            </Shape>
            <String CONTENT="1) Междометіе отвѣтнаго отклика." HPOS="1391" VPOS="4999" WIDTH="1201" HEIGHT="86"/>
          </TextLine>
          <TextLine ID="mz_1-252_l34" HPOS="1391" VPOS="5074" WIDTH="2773" HEIGHT="121" BASELINE="1391 5194 4164 5194">
            <Shape>
              <Polygon POINTS="1391 5074 4164 5074 4164 5195 1391 5195"/>
            </Shape>
            <String CONTENT="2) Како́, како́, кӓкучу́тӓ на́нмы-ѵм. Аллитерація. Какочо́lђын — разновид-" HPOS="1391" VPOS="5074" WIDTH="2773" HEIGHT="121"/>
          </TextLine>
