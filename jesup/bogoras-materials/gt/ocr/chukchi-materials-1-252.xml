            <Shape>
              <Polygon POINTS="2025 2298 3297 2298 3297 2409 2025 2409"/>
            </Shape>
            <String CONTENT="Ка́lа-lѵ́мӈыl. О Кэ́lє сказка." HPOS="2025" VPOS="2298" WIDTH="1272" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-252_l14" HPOS="1388" VPOS="2500" WIDTH="2777" HEIGHT="106" BASELINE="1388 2605 4165 2605">
            <Shape>
              <Polygon POINTS="1388 2500 4165 2500 4165 2606 1388 2606"/>
            </Shape>
            <String CONTENT="Былъ на землѣ великій голодъ, остался одинъ мальчикъ съ сестрой." HPOS="1388" VPOS="2500" WIDTH="2777" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-252_l15" HPOS="1170" VPOS="2635" WIDTH="2996" HEIGHT="101" BASELINE="1170 2735 4166 2735">
            <Shape>
              <Polygon POINTS="1170 2635 4166 2635 4166 2736 1170 2736"/>
            </Shape>
            <String CONTENT="Ѣсть у нихъ нечего. Сдѣлалъ маленькій лучекъ, сестра сдѣлала бубенъ" HPOS="1170" VPOS="2635" WIDTH="2996" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l16" HPOS="1173" VPOS="2754" WIDTH="2989" HEIGHT="106" BASELINE="1173 2860 4162 2860">
            <Shape>
              <Polygon POINTS="1173 2754 4162 2754 4162 2860 1173 2860"/>
            </Shape>
            <String CONTENT="маленькій, онъ все стрѣляетъ и стрѣляетъ. Въ первый день убилъ комара." HPOS="1173" VPOS="2754" WIDTH="2989" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-252_l17" HPOS="1175" VPOS="2877" WIDTH="2988" HEIGHT="107" BASELINE="1175 2983 4163 2983">
            <Shape>
              <Polygon POINTS="1175 2877 4163 2877 4163 2984 1175 2984"/>
            </Shape>
            <String CONTENT="Сестра шаманитъ и шаманитъ надъ комаромъ. На другой день убилъ овода," HPOS="1175" VPOS="2877" WIDTH="2988" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-252_l18" HPOS="1180" VPOS="3003" WIDTH="2985" HEIGHT="108" BASELINE="1180 3110 4165 3110">
            <Shape>
              <Polygon POINTS="1180 3003 4165 3003 4165 3111 1180 3111"/>
            </Shape>
            <String CONTENT="она все шаманитъ и шаманитъ. На третій день убилъ маленькую зимушку," HPOS="1180" VPOS="3003" WIDTH="2985" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-252_l19" HPOS="1181" VPOS="3138" WIDTH="2985" HEIGHT="100" BASELINE="1181 3237 4166 3237">
            <Shape>
              <Polygon POINTS="1181 3138 4166 3138 4166 3238 1181 3238"/>
            </Shape>
            <String CONTENT="она еще шаманитъ да шаманитъ. Испекли и съѣли. Потомъ убилъ по-" HPOS="1181" VPOS="3138" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-252_l20" HPOS="1175" VPOS="3262" WIDTH="2986" HEIGHT="101" BASELINE="1175 3362 4161 3362">
            <Shape>
              <Polygon POINTS="1175 3262 4161 3262 4161 3363 1175 3363"/>
            </Shape>
            <String CONTENT="больше птицу, опять испекли и съѣли. Потомъ убилъ зайца, потомъ лисицу." HPOS="1175" VPOS="3262" WIDTH="2986" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l21" HPOS="1170" VPOS="3394" WIDTH="2992" HEIGHT="100" BASELINE="1170 3493 4162 3493">
            <Shape>
              <Polygon POINTS="1170 3394 4162 3394 4162 3494 1170 3494"/>
            </Shape>
            <String CONTENT="Черезъ нѣсколько лѣтъ пріобрѣлъ полное тѣло, убилъ дикаго оленя, на-" HPOS="1170" VPOS="3394" WIDTH="2992" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-252_l22" HPOS="1179" VPOS="3513" WIDTH="2979" HEIGHT="101" BASELINE="1179 3614 4158 3614">
            <Shape>
              <Polygon POINTS="1179 3513 4158 3513 4158 3614 1179 3614"/>
            </Shape>
            <String CONTENT="конецъ убилъ большого лося, убивалъ все, что есть на морѣ и на сушѣ," HPOS="1179" VPOS="3513" WIDTH="2979" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l23" HPOS="1169" VPOS="3640" WIDTH="2992" HEIGHT="103" BASELINE="1169 3743 4161 3743">
            <Shape>
              <Polygon POINTS="1169 3640 4161 3640 4161 3743 1169 3743"/>
            </Shape>
            <String CONTENT="моржей, медвѣдей, тюленей и лисицъ. Ничего не оставляетъ въ живыхъ." HPOS="1169" VPOS="3640" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-252_l24" HPOS="1170" VPOS="3770" WIDTH="2996" HEIGHT="101" BASELINE="1170 3870 4166 3870">
            <Shape>
              <Polygon POINTS="1170 3770 4166 3770 4166 3871 1170 3871"/>
            </Shape>
            <String CONTENT="Наконецъ сталъ большой, выросли я..... у него. Надо искать жену. По-" HPOS="1170" VPOS="3770" WIDTH="2996" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l25" HPOS="1177" VPOS="3891" WIDTH="2990" HEIGHT="103" BASELINE="1177 3993 4167 3993">
            <Shape>
              <Polygon POINTS="1177 3891 4167 3891 4167 3994 1177 3994"/>
            </Shape>
            <String CONTENT="шелъ, шелъ, нашелъ въ застругѣ³) жилище, въ немъ женщина. Вошелъ къ" HPOS="1177" VPOS="3891" WIDTH="2990" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-252_l26" HPOS="1178" VPOS="4005" WIDTH="2986" HEIGHT="115" BASELINE="1178 4120 4164 4120">
            <Shape>
              <Polygon POINTS="1178 4005 4164 4005 4164 4120 1178 4120"/>
            </Shape>
            <String CONTENT="ней, сосваталъ, привелъ домой. И она полеходящая⁴), и онъ полеходящій;" HPOS="1178" VPOS="4005" WIDTH="2986" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-252_l27" HPOS="1179" VPOS="4153" WIDTH="2987" HEIGHT="96" BASELINE="1179 4249 4166 4249">
            <Shape>
              <Polygon POINTS="1179 4153 4166 4153 4166 4249 1179 4249"/>
            </Shape>
            <String CONTENT="онъ ходитъ, убиваетъ всякую живность, она ходитъ, ищетъ корни и травы," HPOS="1179" VPOS="4153" WIDTH="2987" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-252_l28" HPOS="1183" VPOS="4272" WIDTH="2987" HEIGHT="102" BASELINE="1183 4373 4170 4373">
            <Shape>
              <Polygon POINTS="1183 4272 4170 4272 4170 4374 1183 4374"/>
            </Shape>
            <String CONTENT="приноситъ домой большіе запасы. Дѣйствительно, какъ женщина, хотя и" HPOS="1183" VPOS="4272" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-252_l29" HPOS="1183" VPOS="4358" WIDTH="2979" HEIGHT="141" BASELINE="1183 4498 4162 4498">
            <Shape>
              <Polygon POINTS="1183 4358 4162 4358 4162 4499 1183 4499"/>
            </Shape>
            <String CONTENT="полеходящая — не можетъ приносить крупную дичь. Сестра сидитъ дома," HPOS="1183" VPOS="4358" WIDTH="2979" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-252_l30" HPOS="1179" VPOS="4525" WIDTH="2992" HEIGHT="101" BASELINE="1179 4626 4171 4626">
            <Shape>
              <Polygon POINTS="1179 4525 4171 4525 4171 4626 1179 4626"/>
            </Shape>
            <String CONTENT="дѣлаетъ всякую женскую работу, шьетъ, скоблитъ. Однажды пришелъ" HPOS="1179" VPOS="4525" WIDTH="2992" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-252_l31" HPOS="1178" VPOS="4613" WIDTH="2988" HEIGHT="138" BASELINE="1178 4750 4166 4750">
            <Shape>
              <Polygon POINTS="1178 4613 4166 4613 4166 4751 1178 4751"/>
            </Shape>
            <String CONTENT="домой поздно ночью, принесъ дикаго оленя. «Гдѣ моя жена?» — «Не знаю," HPOS="1178" VPOS="4613" WIDTH="2988" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-252_l32" HPOS="1183" VPOS="4740" WIDTH="2986" HEIGHT="139" BASELINE="1183 4878 4169 4878">
            <Shape>
              <Polygon POINTS="1183 4740 4169 4740 4169 4879 1183 4879"/>
            </Shape>
            <String CONTENT="за тобой скоро ушла, такъ и не приходила!» Ночевали — нѣту, еще ноче-" HPOS="1183" VPOS="4740" WIDTH="2986" HEIGHT="139"/>
          </TextLine>
