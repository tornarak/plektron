          </TextLine>
          <TextLine ID="mz_1-248_l22" HPOS="2055" VPOS="3319" WIDTH="1274" HEIGHT="109" BASELINE="2055 3427 3329 3427">
            <Shape>
              <Polygon POINTS="2055 3319 3329 3319 3329 3428 2055 3428"/>
            </Shape>
            <String CONTENT="Ка́lа-lѵ́мӈыl. О Кэ́lє сказка." HPOS="2055" VPOS="3319" WIDTH="1274" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-248_l23" HPOS="1418" VPOS="3523" WIDTH="2771" HEIGHT="102" BASELINE="1418 3625 4189 3625">
            <Shape>
              <Polygon POINTS="1418 3523 4189 3523 4189 3625 1418 3625"/>
            </Shape>
            <String CONTENT="Была старуха у моря; у ней шестеро сыновей. На поискѣ пищи про-" HPOS="1418" VPOS="3523" WIDTH="2771" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-248_l24" HPOS="1204" VPOS="3658" WIDTH="2986" HEIGHT="95" BASELINE="1204 3752 4190 3752">
            <Shape>
              <Polygon POINTS="1204 3658 4190 3658 4190 3753 1204 3753"/>
            </Shape>
            <String CONTENT="пали; самый младшій остался, его не пускаютъ на промыселъ; питаются" HPOS="1204" VPOS="3658" WIDTH="2986" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-248_l25" HPOS="1201" VPOS="3775" WIDTH="2991" HEIGHT="108" BASELINE="1201 3882 4192 3882">
            <Shape>
              <Polygon POINTS="1201 3775 4192 3775 4192 3883 1201 3883"/>
            </Shape>
            <String CONTENT="только милостыннымъ мясомъ²). Какъ-то старуха захлопоталась, вышелъ" HPOS="1201" VPOS="3775" WIDTH="2991" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-248_l26" HPOS="1209" VPOS="3904" WIDTH="2981" HEIGHT="99" BASELINE="1209 4002 4190 4002">
            <Shape>
              <Polygon POINTS="1209 3904 4190 3904 4190 4003 1209 4003"/>
            </Shape>
            <String CONTENT="ребенокъ, пошелъ на сѣндуху, дошелъ до крутой горы, сталъ карабкаться" HPOS="1209" VPOS="3904" WIDTH="2981" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-248_l27" HPOS="1203" VPOS="4031" WIDTH="2981" HEIGHT="96" BASELINE="1203 4126 4184 4126">
            <Shape>
              <Polygon POINTS="1203 4031 4184 4031 4184 4127 1203 4127"/>
            </Shape>
            <String CONTENT="вверхъ. Карабкался, карабкался, не за что уцѣпиться, покатился внизъ." HPOS="1203" VPOS="4031" WIDTH="2981" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-248_l28" HPOS="1195" VPOS="4157" WIDTH="2991" HEIGHT="98" BASELINE="1195 4254 4186 4254">
            <Shape>
              <Polygon POINTS="1195 4157 4186 4157 4186 4255 1195 4255"/>
            </Shape>
            <String CONTENT="Катился, катился, всталъ, опять полѣзъ вверхъ, почти долѣзъ до самаго" HPOS="1195" VPOS="4157" WIDTH="2991" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-248_l29" HPOS="1200" VPOS="4279" WIDTH="2985" HEIGHT="96" BASELINE="1200 4374 4185 4374">
            <Shape>
              <Polygon POINTS="1200 4279 4185 4279 4185 4375 1200 4375"/>
            </Shape>
            <String CONTENT="верха, хотѣлъ ступить, перекатился на другой бокъ, опять покатился, за-" HPOS="1200" VPOS="4279" WIDTH="2985" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-248_l30" HPOS="1196" VPOS="4405" WIDTH="2990" HEIGHT="96" BASELINE="1196 4500 4186 4500">
            <Shape>
              <Polygon POINTS="1196 4405 4186 4405 4186 4501 1196 4501"/>
            </Shape>
            <String CONTENT="дѣлъ спиной за что-то твердое, оглянулся черезъ плечо, а за спиной ограда" HPOS="1196" VPOS="4405" WIDTH="2990" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-248_l31" HPOS="1201" VPOS="4527" WIDTH="2987" HEIGHT="98" BASELINE="1201 4624 4188 4624">
            <Shape>
              <Polygon POINTS="1201 4527 4188 4527 4188 4625 1201 4625"/>
            </Shape>
            <String CONTENT="изъ ножей. Туда, сюда, а уйти некуда. Вдругъ слышитъ голосъ: «Ко-ко-ко!" HPOS="1201" VPOS="4527" WIDTH="2987" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-248_l32" HPOS="1205" VPOS="4643" WIDTH="2986" HEIGHT="102" BASELINE="1205 4744 4191 4744">
            <Shape>
              <Polygon POINTS="1205 4643 4191 4643 4191 4745 1205 4745"/>
            </Shape>
            <String CONTENT="тюленчикъ чуть не ушелъ!» Взялъ Кэ́lє его за шиворотъ, сталъ щекотать" HPOS="1205" VPOS="4643" WIDTH="2986" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-248_l33" HPOS="1205" VPOS="4777" WIDTH="2980" HEIGHT="98" BASELINE="1205 4874 4185 4874">
            <Shape>
              <Polygon POINTS="1205 4777 4185 4777 4185 4875 1205 4875"/>
            </Shape>
            <String CONTENT="по животу, защекоталъ бы на смерть, но мальчикъ скоро представился, что" HPOS="1205" VPOS="4777" WIDTH="2980" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-248_l34" HPOS="1199" VPOS="4896" WIDTH="2986" HEIGHT="103" BASELINE="1199 4998 4185 4998">
            <Shape>
              <Polygon POINTS="1199 4896 4185 4896 4185 4999 1199 4999"/>
            </Shape>
            <String CONTENT="умеръ. Пошелъ домой, приволокъ санищи, положилъ его на санищи, сталъ" HPOS="1199" VPOS="4896" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-248_l35" HPOS="1206" VPOS="5023" WIDTH="2982" HEIGHT="96" BASELINE="1206 5118 4188 5118">
            <Shape>
              <Polygon POINTS="1206 5023 4188 5023 4188 5119 1206 5119"/>
            </Shape>
            <String CONTENT="обтягивать, обвязывать ремнемъ, мальчикъ п...... «Какой странный" HPOS="1206" VPOS="5023" WIDTH="2982" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-248_l36" HPOS="1203" VPOS="5153" WIDTH="2981" HEIGHT="96" BASELINE="1203 5248 4184 5248">
            <Shape>
              <Polygon POINTS="1203 5153 4184 5153 4184 5249 1203 5249"/>
            </Shape>
            <String CONTENT="тюлень!» говоритъ старикъ. «Отчего онъ трещитъ?» Подошелъ къ дому," HPOS="1203" VPOS="5153" WIDTH="2981" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-248_l37" HPOS="1409" VPOS="5404" WIDTH="2769" HEIGHT="107" BASELINE="1409 5510 4178 5510">
