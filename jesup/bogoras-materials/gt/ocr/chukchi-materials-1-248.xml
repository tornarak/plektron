            </Shape>
            <String CONTENT="1) Ӄо́l ѵм коlа́тје̂, ӄо́l ѵм терђа́тје̂, Ме́тыӈо, т. е. волкъ завылъ, а Ме́-" HPOS="1409" VPOS="5404" WIDTH="2769" HEIGHT="107"/>
          </TextLine>
