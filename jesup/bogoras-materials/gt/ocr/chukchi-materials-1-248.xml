          </TextLine>
          <TextLine ID="mz_1-248_l4" HPOS="1209" VPOS="875" WIDTH="2992" HEIGHT="102" BASELINE="1209 976 4201 976">
            <Shape>
              <Polygon POINTS="1209 875 4201 875 4201 977 1209 977"/>
            </Shape>
            <String CONTENT="(Люди) погнались за ними на оленяхъ. Одинъ завылъ, другой заплакалъ," HPOS="1209" VPOS="875" WIDTH="2992" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-248_l5" HPOS="1205" VPOS="995" WIDTH="3001" HEIGHT="103" BASELINE="1205 1098 4206 1098">
            <Shape>
              <Polygon POINTS="1205 995 4206 995 4206 1098 1205 1098"/>
            </Shape>
            <String CONTENT="Ме́тыӈо¹). Побѣжали волки къ выходу сквозь ряды охотниковъ. Арканомъ" HPOS="1205" VPOS="995" WIDTH="3001" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-248_l6" HPOS="1210" VPOS="1122" WIDTH="2987" HEIGHT="104" BASELINE="1210 1225 4197 1225">
            <Shape>
              <Polygon POINTS="1210 1122 4197 1122 4197 1226 1210 1226"/>
            </Shape>
            <String CONTENT="поймали Ме́тыӈо. Связали всего. Онъ дернулъ, ремни сорвались; бѣжалъ." HPOS="1210" VPOS="1122" WIDTH="2987" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-248_l7" HPOS="1208" VPOS="1242" WIDTH="2994" HEIGHT="98" BASELINE="1208 1339 4202 1339">
            <Shape>
              <Polygon POINTS="1208 1242 4202 1242 4202 1340 1208 1340"/>
            </Shape>
            <String CONTENT="Присоединился къ лисицамъ, ибо волки бѣжали. Пошелъ съ лисьей женой" HPOS="1208" VPOS="1242" WIDTH="2994" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-248_l8" HPOS="1210" VPOS="1375" WIDTH="2992" HEIGHT="99" BASELINE="1210 1473 4202 1473">
            <Shape>
              <Polygon POINTS="1210 1375 4202 1375 4202 1474 1210 1474"/>
            </Shape>
            <String CONTENT="на приманку, на волчеѣдину, попала въ капканъ лисица, и онъ тамъ" HPOS="1210" VPOS="1375" WIDTH="2992" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-248_l9" HPOS="1211" VPOS="1499" WIDTH="2986" HEIGHT="99" BASELINE="1211 1598 4197 1598">
            <Shape>
              <Polygon POINTS="1211 1499 4197 1499 4197 1598 1211 1598"/>
            </Shape>
            <String CONTENT="ждетъ. Пришли люди, и онъ тамъ; они лисицу взяли, онъ бросился, отнялъ" HPOS="1211" VPOS="1499" WIDTH="2986" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-248_l10" HPOS="1212" VPOS="1620" WIDTH="2985" HEIGHT="102" BASELINE="1212 1722 4197 1722">
            <Shape>
              <Polygon POINTS="1212 1620 4197 1620 4197 1722 1212 1722"/>
            </Shape>
            <String CONTENT="товарища. Они его осилили; лисицу убили, понесли домой, Ме́тыӈо послѣ-" HPOS="1212" VPOS="1620" WIDTH="2985" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-248_l11" HPOS="1214" VPOS="1746" WIDTH="2987" HEIGHT="104" BASELINE="1214 1849 4201 1849">
            <Shape>
              <Polygon POINTS="1214 1746 4201 1746 4201 1850 1214 1850"/>
            </Shape>
            <String CONTENT="довалъ сзади. Ибо человѣкъ хорошо кричалъ по лисьему, Ме́тыӈо за ними" HPOS="1214" VPOS="1746" WIDTH="2987" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-248_l12" HPOS="1208" VPOS="1873" WIDTH="2990" HEIGHT="99" BASELINE="1208 1971 4198 1971">
            <Shape>
              <Polygon POINTS="1208 1873 4198 1873 4198 1972 1208 1972"/>
            </Shape>
            <String CONTENT="двигался впередъ. Принесли лисицу; схватили Ме́тыӈо и привязали его въ" HPOS="1208" VPOS="1873" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-248_l13" HPOS="4044" VPOS="1995" WIDTH="17" HEIGHT="24" BASELINE="4044 2018 4061 2018">
            <Shape>
              <Polygon POINTS="4044 1995 4061 1995 4061 2019 4044 2019"/>
            </Shape>
            <String CONTENT="" HPOS="4044" VPOS="1995" WIDTH="17" HEIGHT="24"/>
          </TextLine>
          <TextLine ID="mz_1-248_l14" HPOS="1217" VPOS="1999" WIDTH="2984" HEIGHT="98" BASELINE="1217 2097 4201 2097">
            <Shape>
              <Polygon POINTS="1217 1999 4201 1999 4201 2097 1217 2097"/>
            </Shape>
            <String CONTENT="пологу. Чуть не умеръ отъ домашняго запаху. Сварили чистую воду, на-" HPOS="1217" VPOS="1999" WIDTH="2984" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-248_l15" HPOS="1212" VPOS="2128" WIDTH="2989" HEIGHT="91" BASELINE="1212 2218 4201 2218">
            <Shape>
              <Polygon POINTS="1212 2128 4201 2128 4201 2219 1212 2219"/>
            </Shape>
            <String CONTENT="поили, онъ сталъ блевать чистымъ мхомъ; потомъ хорошо сталъ жить въ" HPOS="1212" VPOS="2128" WIDTH="2989" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-248_l16" HPOS="1208" VPOS="2238" WIDTH="2988" HEIGHT="109" BASELINE="1208 2346 4196 2346">
            <Shape>
              <Polygon POINTS="1208 2238 4196 2238 4196 2347 1208 2347"/>
            </Shape>
            <String CONTENT="шатрѣ. Выблевалъ также клубъ оленьей шерсти, свалявшейся вмѣстѣ. Еще" HPOS="1208" VPOS="2238" WIDTH="2988" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-248_l17" HPOS="1211" VPOS="2366" WIDTH="2994" HEIGHT="105" BASELINE="1211 2470 4205 2470">
            <Shape>
              <Polygon POINTS="1211 2366 4205 2366 4205 2471 1211 2471"/>
            </Shape>
            <String CONTENT="не можетъ говорить. Стали спрашивать: «Кто ты?» Не отвѣчаетъ. Одно" HPOS="1211" VPOS="2366" WIDTH="2994" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-248_l18" HPOS="1210" VPOS="2482" WIDTH="2988" HEIGHT="116" BASELINE="1210 2597 4198 2597">
            <Shape>
              <Polygon POINTS="1210 2482 4198 2482 4198 2598 1210 2598"/>
            </Shape>
            <String CONTENT="лѣто прожилъ здѣсь. На будущій годъ говоритъ: «Я морской. Всѣ мои" HPOS="1210" VPOS="2482" WIDTH="2988" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-248_l19" HPOS="1207" VPOS="2621" WIDTH="1967" HEIGHT="97" BASELINE="1207 2717 3174 2717">
            <Shape>
              <Polygon POINTS="1207 2621 3174 2621 3174 2718 1207 2718"/>
            </Shape>
            <String CONTENT="умерли, — ушелъ я изъ дома!» Такъ сталъ жить." HPOS="1207" VPOS="2621" WIDTH="1967" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-248_l20" HPOS="1418" VPOS="2782" WIDTH="2340" HEIGHT="102" BASELINE="1418 2883 3758 2883">
