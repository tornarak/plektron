        <TextBlock ID="text_1-038" HPOS="1209" VPOS="563" WIDTH="3009" HEIGHT="5214">
          <TextLine ID="mz_1-038_l1" HPOS="1209" VPOS="563" WIDTH="1851" HEIGHT="92" BASELINE="1209 654 3060 654">
            <Shape>
              <Polygon POINTS="1209 563 3060 563 3060 655 1209 655"/>
            </Shape>
            <String CONTENT="XVIII В. Г. БОГОРАЗЪ," HPOS="1209" VPOS="563" WIDTH="1851" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-038_l2" HPOS="1218" VPOS="777" WIDTH="2989" HEIGHT="99" BASELINE="1218 875 4207 875">
            <Shape>
              <Polygon POINTS="1218 777 4207 777 4207 876 1218 876"/>
            </Shape>
            <String CONTENT="и замужество, были настоящими высокими и сильными мужчинами, и злые" HPOS="1218" VPOS="777" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-038_l3" HPOS="1219" VPOS="900" WIDTH="2987" HEIGHT="99" BASELINE="1219 999 4206 999">
            <Shape>
              <Polygon POINTS="1219 900 4206 900 4206 999 1219 999"/>
            </Shape>
            <String CONTENT="языки говорили, что они имѣли тайно собственныхъ любовницъ между жен-" HPOS="1219" VPOS="900" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-038_l4" HPOS="1231" VPOS="1020" WIDTH="2975" HEIGHT="103" BASELINE="1231 1122 4206 1122">
            <Shape>
              <Polygon POINTS="1231 1020 4206 1020 4206 1123 1231 1123"/>
            </Shape>
            <String CONTENT="щинами; въ одномъ случаѣ женоподобный жилъ со второй женой своего" HPOS="1231" VPOS="1020" WIDTH="2975" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l5" HPOS="1225" VPOS="1152" WIDTH="2242" HEIGHT="98" BASELINE="1225 1249 3467 1249">
            <Shape>
              <Polygon POINTS="1225 1152 3467 1152 3467 1250 1225 1250"/>
            </Shape>
            <String CONTENT="собственнаго мужа, которая была настоящей женщиной." HPOS="1225" VPOS="1152" WIDTH="2242" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-038_l6" HPOS="1434" VPOS="1278" WIDTH="2772" HEIGHT="101" BASELINE="1434 1379 4206 1379">
            <Shape>
              <Polygon POINTS="1434 1278 4206 1278 4206 1379 1434 1379"/>
            </Shape>
            <String CONTENT="Шаманская сила јырка̀-lа́ўl’а совершенно исключительна. Несмотря" HPOS="1434" VPOS="1278" WIDTH="2772" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-038_l7" HPOS="1220" VPOS="1408" WIDTH="2988" HEIGHT="96" BASELINE="1220 1504 4208 1504">
            <Shape>
              <Polygon POINTS="1220 1408 4208 1408 4208 1504 1220 1504"/>
            </Shape>
            <String CONTENT="на свою женскую одежду, онъ въ совершенствѣ владѣетъ особыми духами" HPOS="1220" VPOS="1408" WIDTH="2988" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-038_l8" HPOS="1217" VPOS="1526" WIDTH="2987" HEIGHT="103" BASELINE="1217 1629 4204 1629">
            <Shape>
              <Polygon POINTS="1217 1526 4204 1526 4204 1629 1217 1629"/>
            </Shape>
            <String CONTENT="и ихъ голосами (ја́нр̌а - коlе́коl). Онъ имѣетъ также пестрое шаманское" HPOS="1217" VPOS="1526" WIDTH="2987" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l9" HPOS="1220" VPOS="1658" WIDTH="2978" HEIGHT="101" BASELINE="1220 1758 4198 1758">
            <Shape>
              <Polygon POINTS="1220 1658 4198 1658 4198 1759 1220 1759"/>
            </Shape>
            <String CONTENT="платье, похожее на женское по обилію украшеній и бахромы. Надѣвъ это" HPOS="1220" VPOS="1658" WIDTH="2978" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-038_l10" HPOS="1225" VPOS="1784" WIDTH="2979" HEIGHT="98" BASELINE="1225 1881 4204 1881">
            <Shape>
              <Polygon POINTS="1225 1784 4204 1784 4204 1882 1225 1882"/>
            </Shape>
            <String CONTENT="платье, онъ стрѣляетъ въ своихъ противниковъ стержнемъ деревяннаго" HPOS="1225" VPOS="1784" WIDTH="2979" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-038_l11" HPOS="1227" VPOS="1912" WIDTH="2978" HEIGHT="103" BASELINE="1227 2015 4205 2015">
            <Shape>
              <Polygon POINTS="1227 1912 4205 1912 4205 2015 1227 2015"/>
            </Shape>
            <String CONTENT="огнива, замѣняя лукъ лучкомъ того-же огнива, и стержень превращается" HPOS="1227" VPOS="1912" WIDTH="2978" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l12" HPOS="1224" VPOS="2034" WIDTH="2984" HEIGHT="106" BASELINE="1224 2140 4208 2140">
            <Shape>
              <Polygon POINTS="1224 2034 4208 2034 4208 2140 1224 2140"/>
            </Shape>
            <String CONTENT="въ огненное копье, умерщвляющее всѣхъ противниковъ. Но даже вся его" HPOS="1224" VPOS="2034" WIDTH="2984" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-038_l13" HPOS="1225" VPOS="2167" WIDTH="2983" HEIGHT="101" BASELINE="1225 2267 4208 2267">
            <Shape>
              <Polygon POINTS="1225 2167 4208 2167 4208 2268 1225 2268"/>
            </Shape>
            <String CONTENT="шаманская сила и страхъ, ею внушаемый, не спасаютъ его отъ насмѣшекъ," HPOS="1225" VPOS="2167" WIDTH="2983" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-038_l14" HPOS="1225" VPOS="2291" WIDTH="2982" HEIGHT="103" BASELINE="1225 2393 4207 2393">
            <Shape>
              <Polygon POINTS="1225 2291 4207 2291 4207 2394 1225 2394"/>
            </Shape>
            <String CONTENT="особенно женскихъ; смотрѣть № 88. Про јырка̀-lа́ўl’ей сложено много на-" HPOS="1225" VPOS="2291" WIDTH="2982" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l15" HPOS="1222" VPOS="2425" WIDTH="2989" HEIGHT="96" BASELINE="1222 2520 4211 2520">
            <Shape>
              <Polygon POINTS="1222 2425 4211 2425 4211 2521 1222 2521"/>
            </Shape>
            <String CONTENT="смѣшливыхъ разсказовъ, которые передаются изъ устъ въ уста правда" HPOS="1222" VPOS="2425" WIDTH="2989" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-038_l16" HPOS="1219" VPOS="2548" WIDTH="1742" HEIGHT="95" BASELINE="1219 2642 2961 2642">
            <Shape>
              <Polygon POINTS="1219 2548 2961 2548 2961 2643 1219 2643"/>
            </Shape>
            <String CONTENT="шопотомъ, но за то постоянно обновляются." HPOS="1219" VPOS="2548" WIDTH="1742" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-038_l17" HPOS="1428" VPOS="2658" WIDTH="2781" HEIGHT="101" BASELINE="1428 2759 4209 2759">
            <Shape>
              <Polygon POINTS="1428 2658 4209 2658 4209 2759 1428 2759"/>
            </Shape>
            <String CONTENT="Ја́нр̌а-ка́lат вызываемые шаманами и шаманками при помощи чрево-" HPOS="1428" VPOS="2658" WIDTH="2781" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-038_l18" HPOS="1219" VPOS="2785" WIDTH="2987" HEIGHT="100" BASELINE="1219 2885 4206 2885">
            <Shape>
              <Polygon POINTS="1219 2785 4206 2785 4206 2885 1219 2885"/>
            </Shape>
            <String CONTENT="вѣщанія, и просто кэ́lэт, вызываемые помимо чревовѣщанія, отличаются" HPOS="1219" VPOS="2785" WIDTH="2987" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-038_l19" HPOS="1221" VPOS="2905" WIDTH="2982" HEIGHT="106" BASELINE="1221 3010 4203 3010">
            <Shape>
              <Polygon POINTS="1221 2905 4203 2905 4203 3011 1221 3011"/>
            </Shape>
            <String CONTENT="безконечнымъ разнообразіемъ. Чаще всего это птичьи и звѣриные духи," HPOS="1221" VPOS="2905" WIDTH="2982" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-038_l20" HPOS="1220" VPOS="3030" WIDTH="2989" HEIGHT="107" BASELINE="1220 3136 4209 3136">
            <Shape>
              <Polygon POINTS="1220 3030 4209 3030 4209 3137 1220 3137"/>
            </Shape>
            <String CONTENT="дикій олень (ыlвыlу̀-кэ́lє), которому даютъ обыкновенно имя А́јђынто (Чутье" HPOS="1220" VPOS="3030" WIDTH="2989" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-038_l21" HPOS="1214" VPOS="3160" WIDTH="2993" HEIGHT="103" BASELINE="1214 3262 4207 3262">
            <Shape>
              <Polygon POINTS="1214 3160 4207 3160 4207 3263 1214 3263"/>
            </Shape>
            <String CONTENT="духа вышло), птица-мышеловка (рэ́ўlын), сказочное имя медвѣдя (мэwэ́т-" HPOS="1214" VPOS="3160" WIDTH="2993" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l22" HPOS="1216" VPOS="3276" WIDTH="2994" HEIGHT="113" BASELINE="1216 3388 4210 3388">
            <Shape>
              <Polygon POINTS="1216 3276 4210 3276 4210 3389 1216 3389"/>
            </Shape>
            <String CONTENT="чын), морская птица (перру́пер), и т. п. Въ соотвѣтствіе этому шаманство" HPOS="1216" VPOS="3276" WIDTH="2994" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-038_l23" HPOS="1227" VPOS="3417" WIDTH="2985" HEIGHT="100" BASELINE="1227 3516 4212 3516">
            <Shape>
              <Polygon POINTS="1227 3417 4212 3417 4212 3517 1227 3517"/>
            </Shape>
            <String CONTENT="признается также и свойственнымъ звѣрямъ. Такъ, волкъ при помощи" HPOS="1227" VPOS="3417" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-038_l24" HPOS="1225" VPOS="3547" WIDTH="2981" HEIGHT="94" BASELINE="1225 3640 4206 3640">
            <Shape>
              <Polygon POINTS="1225 3547 4206 3547 4206 3641 1225 3641"/>
            </Shape>
            <String CONTENT="шаманства наводить порчу на дикихъ оленей, чтобы потомъ догонять ихъ," HPOS="1225" VPOS="3547" WIDTH="2981" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-038_l25" HPOS="1217" VPOS="3646" WIDTH="2991" HEIGHT="119" BASELINE="1217 3765 4208 3765">
            <Shape>
              <Polygon POINTS="1217 3646 4208 3646 4208 3765 1217 3765"/>
            </Shape>
            <String CONTENT="и сонъ на пастуха, прирученнаго стада. Смотрѣть также № 119, гдѣ дѣй-" HPOS="1217" VPOS="3646" WIDTH="2991" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-038_l26" HPOS="1219" VPOS="3797" WIDTH="2989" HEIGHT="97" BASELINE="1219 3893 4208 3893">
            <Shape>
              <Polygon POINTS="1219 3797 4208 3797 4208 3894 1219 3894"/>
            </Shape>
            <String CONTENT="ствительными лицами во время служенія (мӈі́кін) являются исключительно" HPOS="1219" VPOS="3797" WIDTH="2989" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-038_l27" HPOS="1219" VPOS="3915" WIDTH="2989" HEIGHT="100" BASELINE="1219 4015 4208 4015">
            <Shape>
              <Polygon POINTS="1219 3915 4208 3915 4208 4015 1219 4015"/>
            </Shape>
            <String CONTENT="животныя. Служебные духи считаются совершенно подчиненными волѣ" HPOS="1219" VPOS="3915" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-038_l28" HPOS="1223" VPOS="4040" WIDTH="2986" HEIGHT="99" BASELINE="1223 4139 4209 4139">
            <Shape>
              <Polygon POINTS="1223 4040 4209 4040 4209 4139 1223 4139"/>
            </Shape>
            <String CONTENT="шамана, ихъ хозяина; они даже являются по первому требованію и ис-" HPOS="1223" VPOS="4040" WIDTH="2986" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-038_l29" HPOS="1224" VPOS="4166" WIDTH="2987" HEIGHT="105" BASELINE="1224 4270 4211 4270">
            <Shape>
              <Polygon POINTS="1224 4166 4211 4166 4211 4271 1224 4271"/>
            </Shape>
            <String CONTENT="полнять всякія порученія, какъ бы трудно это не было. Рядомъ съ звѣри-" HPOS="1224" VPOS="4166" WIDTH="2987" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-038_l30" HPOS="1220" VPOS="4290" WIDTH="2992" HEIGHT="103" BASELINE="1220 4392 4212 4392">
            <Shape>
              <Polygon POINTS="1220 4290 4212 4290 4212 4393 1220 4393"/>
            </Shape>
            <String CONTENT="ными духами (ја́нр̌а - ка́lат) бываютъ выдѣляемые изъ неодушевленныхъ" HPOS="1220" VPOS="4290" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l31" HPOS="1227" VPOS="4416" WIDTH="2985" HEIGHT="103" BASELINE="1227 4518 4212 4518">
            <Shape>
              <Polygon POINTS="1227 4416 4212 4416 4212 4519 1227 4519"/>
            </Shape>
            <String CONTENT="предметовъ, включая и предметы домашняго обихода. Напр. вынималка для" HPOS="1227" VPOS="4416" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l32" HPOS="1220" VPOS="4549" WIDTH="2991" HEIGHT="98" BASELINE="1220 4646 4211 4646">
            <Shape>
              <Polygon POINTS="1220 4549 4211 4549 4211 4647 1220 4647"/>
            </Shape>
            <String CONTENT="мяса (рырампако́јӈын) является въ видѣ старика съ очень вольными рѣчами" HPOS="1220" VPOS="4549" WIDTH="2991" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-038_l33" HPOS="1224" VPOS="4666" WIDTH="2989" HEIGHT="105" BASELINE="1224 4770 4213 4770">
            <Shape>
              <Polygon POINTS="1224 4666 4213 4666 4213 4771 1224 4771"/>
            </Shape>
            <String CONTENT="и говорить, что женщины любятъ его. Игла является въ мужскомъ видѣ" HPOS="1224" VPOS="4666" WIDTH="2989" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-038_l34" HPOS="1225" VPOS="4793" WIDTH="2990" HEIGHT="106" BASELINE="1225 4899 4215 4899">
            <Shape>
              <Polygon POINTS="1225 4793 4215 4793 4215 4899 1225 4899"/>
            </Shape>
            <String CONTENT="подъ именемъ еwчу́wђі «долгій»; швейный мѣшокъ является напротивъ" HPOS="1225" VPOS="4793" WIDTH="2990" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-038_l35" HPOS="1221" VPOS="4928" WIDTH="1681" HEIGHT="97" BASELINE="1221 5025 2902 5025">
            <Shape>
              <Polygon POINTS="1221 4928 2902 4928 2902 5025 1221 5025"/>
            </Shape>
            <String CONTENT="женщиной, привычной сидѣть дома и т. п." HPOS="1221" VPOS="4928" WIDTH="1681" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-038_l36" HPOS="1440" VPOS="5049" WIDTH="2772" HEIGHT="97" BASELINE="1440 5145 4212 5145">
            <Shape>
              <Polygon POINTS="1440 5049 4212 5049 4212 5146 1440 5146"/>
            </Shape>
            <String CONTENT="Сказки много занимаются шаманствомъ, говорять о происхожденіи" HPOS="1440" VPOS="5049" WIDTH="2772" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-038_l37" HPOS="1224" VPOS="5178" WIDTH="2993" HEIGHT="99" BASELINE="1224 5276 4217 5276">
            <Shape>
              <Polygon POINTS="1224 5178 4217 5178 4217 5277 1224 5277"/>
            </Shape>
            <String CONTENT="бубна, о внезапномъ дарованіи шаманской силы, о добрыхъ шаманахъ и" HPOS="1224" VPOS="5178" WIDTH="2993" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-038_l38" HPOS="1222" VPOS="5302" WIDTH="2996" HEIGHT="104" BASELINE="1222 5405 4218 5405">
            <Shape>
              <Polygon POINTS="1222 5302 4218 5302 4218 5406 1222 5406"/>
            </Shape>
            <String CONTENT="злыхъ шаманахъ (ку́рђу эӈэ́ӈыlын или lэwlэ́у-эӈэ́ӈыlын, буквально «на-" HPOS="1222" VPOS="5302" WIDTH="2996" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-038_l39" HPOS="1223" VPOS="5420" WIDTH="2995" HEIGHT="101" BASELINE="1223 5520 4218 5520">
            <Shape>
              <Polygon POINTS="1223 5420 4218 5420 4218 5521 1223 5521"/>
            </Shape>
            <String CONTENT="смѣхающійся шаманъ»). Таковъ напр. Ры́нтеў въ сказкѣ о Чесоточномъ" HPOS="1223" VPOS="5420" WIDTH="2995" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-038_l40" HPOS="1225" VPOS="5547" WIDTH="2991" HEIGHT="103" BASELINE="1225 5650 4216 5650">
            <Shape>
              <Polygon POINTS="1225 5547 4216 5547 4216 5650 1225 5650"/>
            </Shape>
            <String CONTENT="шаманѣ. Среди женщинъ «насмѣхающемуся шаману» соотвѣтствуеть «ста-" HPOS="1225" VPOS="5547" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-038_l41" HPOS="1223" VPOS="5649" WIDTH="2995" HEIGHT="128" BASELINE="1223 5776 4218 5776">
            <Shape>
              <Polygon POINTS="1223 5649 4218 5649 4218 5777 1223 5777"/>
            </Shape>
            <String CONTENT="рушка съ порчей» (у́јwэl-ынпыӈэ́wӄӓј). Таковы въ № 78 старушка изъ пле" HPOS="1223" VPOS="5649" WIDTH="2995" HEIGHT="128"/>
          </TextLine>
        </TextBlock>
