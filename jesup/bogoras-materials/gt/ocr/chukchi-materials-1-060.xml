              <Polygon POINTS="1400 3056 3995 3056 3995 3158 1400 3158"/>
            </Shape>
            <String CONTENT="Записано весной 1897 г. отъ чукчи Ајӈан̀ва́та на урочищѣ Сухарномъ." HPOS="1400" VPOS="3056" WIDTH="2595" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-060_l22" HPOS="1190" VPOS="3377" WIDTH="2986" HEIGHT="100" BASELINE="1190 3476 4176 3476">
            <Shape>
              <Polygon POINTS="1190 3377 4176 3377 4176 3477 1190 3477"/>
            </Shape>
            <String CONTENT="кладутъ. Надѣваютъ узду на дикаго оленя. Потомъ къ окружному ремню" HPOS="1190" VPOS="3377" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-060_l23" HPOS="1187" VPOS="3499" WIDTH="2982" HEIGHT="101" BASELINE="1187 3599 4169 3599">
            <Shape>
              <Polygon POINTS="1187 3499 4169 3499 4169 3600 1187 3600"/>
            </Shape>
            <String CONTENT="привязываютъ, еще не заколовъ. Потомъ хозяйка надѣваетъ балахонъ." HPOS="1187" VPOS="3499" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-060_l24" HPOS="1075" VPOS="3627" WIDTH="3100" HEIGHT="102" BASELINE="1075 3728 4175 3728">
            <Shape>
              <Polygon POINTS="1075 3627 4175 3627 4175 3729 1075 3729"/>
            </Shape>
            <String CONTENT="35 Такъ какъ быкъ такимъ образомъ навзничь лежитъ, носъ (ему) хозяйка" HPOS="1075" VPOS="3627" WIDTH="3100" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-060_l25" HPOS="1188" VPOS="3758" WIDTH="2987" HEIGHT="95" BASELINE="1188 3852 4175 3852">
            <Shape>
              <Polygon POINTS="1188 3758 4175 3758 4175 3853 1188 3853"/>
            </Shape>
            <String CONTENT="окутываетъ, завертываетъ въ балахонъ, какъ разъ при закалываніи. По-" HPOS="1188" VPOS="3758" WIDTH="2987" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-060_l26" HPOS="1182" VPOS="3870" WIDTH="2988" HEIGHT="109" BASELINE="1182 3978 4170 3978">
            <Shape>
              <Polygon POINTS="1182 3870 4170 3870 4170 3979 1182 3979"/>
            </Shape>
            <String CONTENT="томъ кое-какъ закалываетъ мужъ. Жену же (оленя) убиваютъ ножемъ." HPOS="1182" VPOS="3870" WIDTH="2988" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-060_l27" HPOS="1175" VPOS="4008" WIDTH="3000" HEIGHT="99" BASELINE="1175 4106 4175 4106">
            <Shape>
              <Polygon POINTS="1175 4008 4175 4008 4175 4107 1175 4107"/>
            </Shape>
            <String CONTENT="Кончивъ убой, изъ мочепріемника поятъ мочей, какъ ручнаго оленя, кри-" HPOS="1175" VPOS="4008" WIDTH="3000" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-060_l28" HPOS="1180" VPOS="4134" WIDTH="2995" HEIGHT="98" BASELINE="1180 4231 4175 4231">
            <Shape>
              <Polygon POINTS="1180 4134 4175 4134 4175 4232 1180 4232"/>
            </Shape>
            <String CONTENT="чатъ: хрр!... Когда совсѣмъ издохнетъ, обводятъ ложечкой, съ носа на-" HPOS="1180" VPOS="4134" WIDTH="2995" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-060_l29" HPOS="1185" VPOS="4260" WIDTH="2985" HEIGHT="98" BASELINE="1185 4358 4170 4358">
            <Shape>
              <Polygon POINTS="1185 4260 4170 4260 4170 4358 1185 4358"/>
            </Shape>
            <String CONTENT="чинаютъ, каждое слово (заговора) возвращаютъ, отъ спины доходятъ до" HPOS="1185" VPOS="4260" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-060_l30" HPOS="1070" VPOS="4391" WIDTH="3101" HEIGHT="98" BASELINE="1070 4489 4171 4489">
            <Shape>
              <Polygon POINTS="1070 4391 4171 4391 4171 4489 1070 4489"/>
            </Shape>
            <String CONTENT="40 ногъ, лѣвой рукой кусочекъ листокваши притворно съѣдаютъ, корешокъ" HPOS="1070" VPOS="4391" WIDTH="3101" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-060_l31" HPOS="1185" VPOS="4509" WIDTH="2991" HEIGHT="103" BASELINE="1185 4611 4176 4611">
            <Shape>
              <Polygon POINTS="1185 4509 4176 4509 4176 4612 1185 4612"/>
            </Shape>
            <String CONTENT="„попо́кальгынъ‘ или что-нибудь, корень дикаго щавеля, только бы съ земли" HPOS="1185" VPOS="4509" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-060_l32" HPOS="1181" VPOS="4634" WIDTH="2991" HEIGHT="103" BASELINE="1181 4736 4172 4736">
            <Shape>
              <Polygon POINTS="1181 4634 4172 4634 4172 4737 1181 4737"/>
            </Shape>
            <String CONTENT="взятое, удобное для ѣды. Чтобы кровь была на землѣ, гдѣ попало, отвер-" HPOS="1181" VPOS="4634" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-060_l33" HPOS="1183" VPOS="4766" WIDTH="2991" HEIGHT="94" BASELINE="1183 4859 4174 4859">
            <Shape>
              <Polygon POINTS="1183 4766 4174 4766 4174 4860 1183 4860"/>
            </Shape>
            <String CONTENT="гаютъ. Говорятъ: «потомъ его дѣти родившись будутъ постоянно въ поле" HPOS="1183" VPOS="4766" WIDTH="2991" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-060_l34" HPOS="1187" VPOS="4891" WIDTH="2986" HEIGHT="100" BASELINE="1187 4990 4173 4990">
            <Shape>
              <Polygon POINTS="1187 4891 4173 4891 4173 4991 1187 4991"/>
            </Shape>
            <String CONTENT="стремиться!» Потомъ вносятъ все, варятъ сразу, такъ какъ много помощ-" HPOS="1187" VPOS="4891" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-060_l35" HPOS="1072" VPOS="5018" WIDTH="3101" HEIGHT="94" BASELINE="1072 5111 4173 5111">
            <Shape>
              <Polygon POINTS="1072 5018 4173 5018 4173 5112 1072 5112"/>
            </Shape>
            <String CONTENT="45 никовъ. Хозяинъ кусочекъ отъ каждаго мяса пробуетъ сначала, все по" HPOS="1072" VPOS="5018" WIDTH="3101" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-060_l36" HPOS="1184" VPOS="5136" WIDTH="2988" HEIGHT="101" BASELINE="1184 5236 4172 5236">
            <Shape>
              <Polygon POINTS="1184 5136 4172 5136 4172 5237 1184 5237"/>
            </Shape>
            <String CONTENT="одному глоточку. Потомъ же хозяинъ вмѣстѣ съ женой подъ мышками" HPOS="1184" VPOS="5136" WIDTH="2988" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-060_l37" HPOS="1184" VPOS="5266" WIDTH="2986" HEIGHT="101" BASELINE="1184 5367 4170 5367">
            <Shape>
              <Polygon POINTS="1184 5266 4170 5266 4170 5367 1184 5367"/>
            </Shape>
            <String CONTENT="подшиваютъ кисточки. Пока длится превращеніе, (хозяинъ) ничего не раз-" HPOS="1184" VPOS="5266" WIDTH="2986" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-060_l38" HPOS="1183" VPOS="5396" WIDTH="2978" HEIGHT="98" BASELINE="1183 5493 4161 5493">
            <Shape>
              <Polygon POINTS="1183 5396 4161 5396 4161 5494 1183 5494"/>
            </Shape>
            <String CONTENT="вязываетъ самъ, бережетъ заговоръ. Если развяжется, то олень уйдетъ." HPOS="1183" VPOS="5396" WIDTH="2978" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-060_l39" HPOS="1178" VPOS="5515" WIDTH="2994" HEIGHT="104" BASELINE="1178 5618 4172 5618">
            <Shape>
              <Polygon POINTS="1178 5515 4172 5515 4172 5619 1178 5619"/>
            </Shape>
            <String CONTENT="Къ людямъ также никуда не ходитъ, чтобы не уронить волоска у людей" HPOS="1178" VPOS="5515" WIDTH="2994" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-060_l40" HPOS="1074" VPOS="5646" WIDTH="2723" HEIGHT="104" BASELINE="1074 5749 3797 5749">
            <Shape>
              <Polygon POINTS="1074 5646 3797 5646 3797 5750 1074 5750"/>
            </Shape>
            <String CONTENT="50 собственнаго. Это тоже худо. Съ этихъ поръ это предѣлъ конца." HPOS="1074" VPOS="5646" WIDTH="2723" HEIGHT="104"/>
          </TextLine>
