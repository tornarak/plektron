        <TextBlock ID="text_1-327" HPOS="598" VPOS="571" WIDTH="3028" HEIGHT="5184">
          <TextLine ID="mz_1-327_l1" HPOS="598" VPOS="571" WIDTH="2992" HEIGHT="114" BASELINE="598 660 3590 660">
            <Shape>
              <Polygon POINTS="598 571 3590 571 3590 685 598 685"/>
            </Shape>
            <String CONTENT="II,99. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 271" HPOS="598" VPOS="571" WIDTH="2992" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-327_l2" HPOS="601" VPOS="772" WIDTH="2992" HEIGHT="103" BASELINE="601 874 3593 874">
            <Shape>
              <Polygon POINTS="601 772 3593 772 3593 875 601 875"/>
            </Shape>
            <String CONTENT="Стала сестра убитой думать: «Ой, худо! Надо матери вѣсть дать!» Спра-" HPOS="601" VPOS="772" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-327_l3" HPOS="602" VPOS="861" WIDTH="2993" HEIGHT="138" BASELINE="602 998 3595 998">
            <Shape>
              <Polygon POINTS="602 861 3595 861 3595 999 602 999"/>
            </Shape>
            <String CONTENT="шиваетъ у зятя: «Старуха моя тебѣ что наказывала?» — «Говорила: ‚меня" HPOS="602" VPOS="861" WIDTH="2993" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-327_l4" HPOS="603" VPOS="974" WIDTH="2999" HEIGHT="147" BASELINE="603 1120 3602 1120">
            <Shape>
              <Polygon POINTS="603 974 3602 974 3602 1121 603 1121"/>
            </Shape>
            <String CONTENT="захочешь вызвать, завой по волчьи ночью среди сѣндухи‘.» — «Да я ночью не" HPOS="603" VPOS="974" WIDTH="2999" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-327_l5" HPOS="599" VPOS="1117" WIDTH="2999" HEIGHT="132" BASELINE="599 1248 3598 1248">
            <Shape>
              <Polygon POINTS="599 1117 3598 1117 3598 1249 599 1249"/>
            </Shape>
            <String CONTENT="могу ходить: сонъ туманитъ голову.» — «А-а-а!» Пришла весна, говорятъ" HPOS="599" VPOS="1117" WIDTH="2999" HEIGHT="132"/>
          </TextLine>
          <TextLine ID="mz_1-327_l6" HPOS="611" VPOS="1275" WIDTH="2986" HEIGHT="100" BASELINE="611 1374 3597 1374">
            <Shape>
              <Polygon POINTS="611 1275 3597 1275 3597 1375 611 1375"/>
            </Shape>
            <String CONTENT="бабы: «Надо тюленьи шкуры! Пойдемъ-ка изъ нашего домика принесемъ!»" HPOS="611" VPOS="1275" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-327_l7" HPOS="599" VPOS="1403" WIDTH="2995" HEIGHT="100" BASELINE="599 1502 3594 1502">
            <Shape>
              <Polygon POINTS="599 1403 3594 1403 3594 1503 599 1503"/>
            </Shape>
            <String CONTENT="Поѣхали на оленяхъ. Весела старуха, всю дорогу поетъ пѣсни. Пріѣхали." HPOS="599" VPOS="1403" WIDTH="2995" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-327_l8" HPOS="607" VPOS="1488" WIDTH="2990" HEIGHT="143" BASELINE="607 1631 3597 1631">
            <Shape>
              <Polygon POINTS="607 1488 3597 1488 3597 1631 607 1631"/>
            </Shape>
            <String CONTENT="«Теперь переночуемъ, завтра увеземъ все назадъ!» — «Эђэ́й!» Легли спать" HPOS="607" VPOS="1488" WIDTH="2990" HEIGHT="143"/>
          </TextLine>
          <TextLine ID="mz_1-327_l9" HPOS="609" VPOS="1649" WIDTH="2986" HEIGHT="102" BASELINE="609 1751 3595 1751">
            <Shape>
              <Polygon POINTS="609 1649 3595 1649 3595 1751 609 1751"/>
            </Shape>
            <String CONTENT="въ пустомъ шатрѣ. Среди ночи вышла дѣвушка на дворъ, повернулась къ" HPOS="609" VPOS="1649" WIDTH="2986" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-327_l10" HPOS="610" VPOS="1778" WIDTH="2990" HEIGHT="99" BASELINE="610 1877 3600 1877">
            <Shape>
              <Polygon POINTS="610 1778 3600 1778 3600 1877 610 1877"/>
            </Shape>
            <String CONTENT="востоку, завыла по волчьи. Вдругъ налетѣла страшная буря, пролетѣла" HPOS="610" VPOS="1778" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-327_l11" HPOS="604" VPOS="1898" WIDTH="2995" HEIGHT="103" BASELINE="604 2001 3599 2001">
            <Shape>
              <Polygon POINTS="604 1898 3599 1898 3599 2001 604 2001"/>
            </Shape>
            <String CONTENT="мимо жилища колдовской старушки¹), унесла и домъ, и оленей, и обѣихъ" HPOS="604" VPOS="1898" WIDTH="2995" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-327_l12" HPOS="614" VPOS="2020" WIDTH="2984" HEIGHT="106" BASELINE="614 2125 3598 2125">
            <Shape>
              <Polygon POINTS="614 2020 3598 2020 3598 2126 614 2126"/>
            </Shape>
            <String CONTENT="женщинъ нагихъ унесла. Унося ознобила, ознобивъ скоро умертвила. Въ" HPOS="614" VPOS="2020" WIDTH="2984" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-327_l13" HPOS="609" VPOS="2146" WIDTH="2988" HEIGHT="101" BASELINE="609 2247 3597 2247">
            <Shape>
              <Polygon POINTS="609 2146 3597 2146 3597 2247 609 2247"/>
            </Shape>
            <String CONTENT="бурѣ и мятели явилась заморская теща. Спитъ человѣкъ, ничего не слы-" HPOS="609" VPOS="2146" WIDTH="2988" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-327_l14" HPOS="612" VPOS="2262" WIDTH="2988" HEIGHT="114" BASELINE="612 2375 3600 2375">
            <Shape>
              <Polygon POINTS="612 2262 3600 2262 3600 2376 612 2376"/>
            </Shape>
            <String CONTENT="шитъ; сорвала шатеръ надъ его пологомъ — ничего не слышитъ, сорвала" HPOS="612" VPOS="2262" WIDTH="2988" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-327_l15" HPOS="614" VPOS="2408" WIDTH="2984" HEIGHT="96" BASELINE="614 2503 3598 2503">
            <Shape>
              <Polygon POINTS="614 2408 3598 2408 3598 2504 614 2504"/>
            </Shape>
            <String CONTENT="пологъ надъ головой, ничего не слышитъ; дунула ему въ лицо, проснулся," HPOS="614" VPOS="2408" WIDTH="2984" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-327_l16" HPOS="613" VPOS="2524" WIDTH="2993" HEIGHT="102" BASELINE="613 2625 3606 2625">
            <Shape>
              <Polygon POINTS="613 2524 3606 2524 3606 2626 613 2626"/>
            </Shape>
            <String CONTENT="вскочилъ, просвѣтлѣлъ разумомъ. «Гдѣ моя дочь?» Молчитъ, потупивъ го-" HPOS="613" VPOS="2524" WIDTH="2993" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-327_l17" HPOS="614" VPOS="2632" WIDTH="2991" HEIGHT="118" BASELINE="614 2749 3605 2749">
            <Shape>
              <Polygon POINTS="614 2632 3605 2632 3605 2750 614 2750"/>
            </Shape>
            <String CONTENT="лову. «Я говорила, въ колдовской странѣ мою дочь убьютъ чарами! Ты" HPOS="614" VPOS="2632" WIDTH="2991" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-327_l18" HPOS="616" VPOS="2780" WIDTH="2988" HEIGHT="100" BASELINE="616 2879 3604 2879">
            <Shape>
              <Polygon POINTS="616 2780 3604 2780 3604 2880 616 2880"/>
            </Shape>
            <String CONTENT="говорилъ: ‚нѣтъ!‘» Молчитъ потупивъ голову. «Теперь другую дочь увезу," HPOS="616" VPOS="2780" WIDTH="2988" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-327_l19" HPOS="619" VPOS="2859" WIDTH="2990" HEIGHT="139" BASELINE="619 2997 3609 2997">
            <Shape>
              <Polygon POINTS="619 2859 3609 2859 3609 2998 619 2998"/>
            </Shape>
            <String CONTENT="боюсь-убьютъ и ее!» Поднялъ голову человѣкъ: «А я какъ?» — «Ты, какъ" HPOS="619" VPOS="2859" WIDTH="2990" HEIGHT="139"/>
          </TextLine>
          <TextLine ID="mz_1-327_l20" HPOS="619" VPOS="2963" WIDTH="2989" HEIGHT="143" BASELINE="619 3106 3608 3106">
            <Shape>
              <Polygon POINTS="619 2963 3608 2963 3608 3106 619 3106"/>
            </Shape>
            <String CONTENT="хочешь!» — «Я за вами!» — «Пускай!» Подняла и дочь, и его, унесла въ" HPOS="619" VPOS="2963" WIDTH="2989" HEIGHT="143"/>
          </TextLine>
          <TextLine ID="mz_1-327_l21" HPOS="619" VPOS="3154" WIDTH="2102" HEIGHT="98" BASELINE="619 3252 2721 3252">
            <Shape>
              <Polygon POINTS="619 3154 2721 3154 2721 3252 619 3252"/>
            </Shape>
            <String CONTENT="вѣтрѣ за море, принесла на свою землю, стали жить." HPOS="619" VPOS="3154" WIDTH="2102" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-327_l22" HPOS="840" VPOS="3320" WIDTH="1511" HEIGHT="96" BASELINE="840 3416 2351 3416">
            <Shape>
              <Polygon POINTS="840 3320 2351 3320 2351 3416 840 3416"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи кривого Кэўтэ́ђын’а." HPOS="840" VPOS="3320" WIDTH="1511" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-327_l23" HPOS="2028" VPOS="3730" WIDTH="178" HEIGHT="100" BASELINE="2028 3829 2206 3829">
            <Shape>
              <Polygon POINTS="2028 3730 2206 3730 2206 3830 2028 3830"/>
            </Shape>
            <String CONTENT="100." HPOS="2028" VPOS="3730" WIDTH="178" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-327_l24" HPOS="848" VPOS="3900" WIDTH="2769" HEIGHT="136" BASELINE="848 4036 3617 4036">
            <Shape>
              <Polygon POINTS="848 3900 3617 3900 3617 4036 848 4036"/>
            </Shape>
            <String CONTENT="Было пять братьевъ — всѣ холостые. Пошли искать дикихъ оленей." HPOS="848" VPOS="3900" WIDTH="2769" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-327_l25" HPOS="632" VPOS="4067" WIDTH="2985" HEIGHT="99" BASELINE="632 4166 3617 4166">
            <Shape>
              <Polygon POINTS="632 4067 3617 4067 3617 4166 632 4166"/>
            </Shape>
            <String CONTENT="Говорятъ: «Пойдемъ по сѣндухѣ, но когда солнце дойдетъ до такой-то" HPOS="632" VPOS="4067" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-327_l26" HPOS="632" VPOS="4183" WIDTH="2986" HEIGHT="108" BASELINE="632 4290 3618 4290">
            <Shape>
              <Polygon POINTS="632 4183 3618 4183 3618 4291 632 4291"/>
            </Shape>
            <String CONTENT="мѣры, придемъ домой!» Когда дошло, пришли. На другой день опять." HPOS="632" VPOS="4183" WIDTH="2986" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-327_l27" HPOS="639" VPOS="4309" WIDTH="2987" HEIGHT="106" BASELINE="639 4414 3626 4414">
            <Shape>
              <Polygon POINTS="639 4309 3626 4309 3626 4415 639 4415"/>
            </Shape>
            <String CONTENT="Каждый день ходятъ на поискъ, къ одной мѣрѣ солнца возвращаются" HPOS="639" VPOS="4309" WIDTH="2987" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-327_l28" HPOS="643" VPOS="4432" WIDTH="2982" HEIGHT="109" BASELINE="643 4540 3625 4540">
            <Shape>
              <Polygon POINTS="643 4432 3625 4432 3625 4541 643 4541"/>
            </Shape>
            <String CONTENT="домой. Однажды вернулись, нѣтъ самаго младшаго. «О!» говорятъ, «куда" HPOS="643" VPOS="4432" WIDTH="2982" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-327_l29" HPOS="644" VPOS="4563" WIDTH="2977" HEIGHT="103" BASELINE="644 4666 3621 4666">
            <Shape>
              <Polygon POINTS="644 4563 3621 4563 3621 4666 644 4666"/>
            </Shape>
            <String CONTENT="онъ дѣвался?» Пошли на другой день искать, разошлись въ разныя сто-" HPOS="644" VPOS="4563" WIDTH="2977" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-327_l30" HPOS="644" VPOS="4686" WIDTH="2980" HEIGHT="103" BASELINE="644 4788 3624 4788">
            <Shape>
              <Polygon POINTS="644 4686 3624 4686 3624 4789 644 4789"/>
            </Shape>
            <String CONTENT="роны, сошлись по одной мѣрѣ солнца, еще нѣтъ. Пришли домой, легли" HPOS="644" VPOS="4686" WIDTH="2980" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-327_l31" HPOS="646" VPOS="4773" WIDTH="2973" HEIGHT="139" BASELINE="646 4912 3619 4912">
            <Shape>
              <Polygon POINTS="646 4773 3619 4773 3619 4912 646 4912"/>
            </Shape>
            <String CONTENT="спать. На утро спрашиваетъ старшій братъ: «Не видѣли-ли его во снѣ?» —" HPOS="646" VPOS="4773" WIDTH="2973" HEIGHT="139"/>
          </TextLine>
          <TextLine ID="mz_1-327_l32" HPOS="636" VPOS="4937" WIDTH="2984" HEIGHT="105" BASELINE="636 5017 3620 5017">
            <Shape>
              <Polygon POINTS="636 4937 3620 4937 3620 5042 636 5042"/>
            </Shape>
            <String CONTENT="«Ничего!» — «Го-о-о! Пойдемъ опять!» Весь день ходятъ, придутъ домой," HPOS="636" VPOS="4937" WIDTH="2984" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-327_l33" HPOS="643" VPOS="5019" WIDTH="2981" HEIGHT="143" BASELINE="643 5162 3624 5162">
            <Shape>
              <Polygon POINTS="643 5019 3624 5019 3624 5162 643 5162"/>
            </Shape>
            <String CONTENT="лягутъ спать. Говоритъ старшій: «Ничего-ли не видѣли во снѣ?» — «Ни-" HPOS="643" VPOS="5019" WIDTH="2981" HEIGHT="143"/>
          </TextLine>
          <TextLine ID="mz_1-327_l34" HPOS="641" VPOS="5154" WIDTH="2985" HEIGHT="137" BASELINE="641 5290 3626 5290">
            <Shape>
              <Polygon POINTS="641 5154 3626 5154 3626 5291 641 5291"/>
            </Shape>
            <String CONTENT="чего!» — «О-о-о! Опять пойдемъ!» Искали десять дней, ничего не нашли." HPOS="641" VPOS="5154" WIDTH="2985" HEIGHT="137"/>
          </TextLine>
          <TextLine ID="mz_1-327_l35" HPOS="650" VPOS="5316" WIDTH="2975" HEIGHT="101" BASELINE="650 5416 3625 5416">
            <Shape>
              <Polygon POINTS="650 5316 3625 5316 3625 5417 650 5417"/>
            </Shape>
            <String CONTENT="Говоритъ старшій братъ: «Кости наши сохнутъ съ голода, надо перестать," HPOS="650" VPOS="5316" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-327_l36" HPOS="649" VPOS="5421" WIDTH="2977" HEIGHT="121" BASELINE="649 5542 3626 5542">
            <Shape>
              <Polygon POINTS="649 5421 3626 5421 3626 5542 649 5542"/>
            </Shape>
            <String CONTENT="ибо стали безъ ѣды. Но куда-же дѣлся? Мы не нашли ни лоскутка одежды," HPOS="649" VPOS="5421" WIDTH="2977" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-327_l37" HPOS="871" VPOS="5627" WIDTH="1949" HEIGHT="128" BASELINE="871 5754 2820 5754">
            <Shape>
              <Polygon POINTS="871 5627 2820 5627 2820 5755 871 5755"/>
            </Shape>
            <String CONTENT="1) У́јwэl-ынпыӈэ́wӄӓј — собств. старушка съ порчею." HPOS="871" VPOS="5627" WIDTH="1949" HEIGHT="128"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
