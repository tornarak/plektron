          <TextLine ID="mz_1-357_l1" HPOS="591" VPOS="604" WIDTH="2987" HEIGHT="112" BASELINE="591 696 3578 696">
            <Shape>
              <Polygon POINTS="591 604 3578 604 3578 716 591 716"/>
            </Shape>
            <String CONTENT="II,116. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 301" HPOS="591" VPOS="604" WIDTH="2987" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-357_l2" HPOS="591" VPOS="815" WIDTH="2987" HEIGHT="100" BASELINE="591 914 3578 914">
            <Shape>
              <Polygon POINTS="591 815 3578 815 3578 915 591 915"/>
            </Shape>
            <String CONTENT="маленькій лукъ изъ китоваго уса, стрѣлка деревянная. Народъ смѣется:" HPOS="591" VPOS="815" WIDTH="2987" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-357_l3" HPOS="599" VPOS="933" WIDTH="2980" HEIGHT="108" BASELINE="599 1041 3579 1041">
            <Shape>
              <Polygon POINTS="599 933 3579 933 3579 1041 599 1041"/>
            </Shape>
            <String CONTENT="«Ха, ха! Такой-то твой лукъ! Зачѣмъ пришелъ? Стрѣла у тебя изъ ка-" HPOS="599" VPOS="933" WIDTH="2980" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-357_l4" HPOS="599" VPOS="1058" WIDTH="2985" HEIGHT="110" BASELINE="599 1167 3584 1167">
            <Shape>
              <Polygon POINTS="599 1058 3584 1058 3584 1168 599 1168"/>
            </Shape>
            <String CONTENT="кого-то дерева, лукъ китоусовый. Нашъ порохъ не могъ; развѣ твое" HPOS="599" VPOS="1058" WIDTH="2985" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-357_l5" HPOS="597" VPOS="1186" WIDTH="2983" HEIGHT="109" BASELINE="597 1294 3580 1294">
            <Shape>
              <Polygon POINTS="597 1186 3580 1186 3580 1295 597 1295"/>
            </Shape>
            <String CONTENT="сможетъ? Ха, ха, ха! Зачѣмъ пришелъ, пустословъ?» Вдругъ онъ лукъ" HPOS="597" VPOS="1186" WIDTH="2983" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-357_l6" HPOS="597" VPOS="1324" WIDTH="2984" HEIGHT="97" BASELINE="597 1421 3581 1421">
            <Shape>
              <Polygon POINTS="597 1324 3581 1324 3581 1421 597 1421"/>
            </Shape>
            <String CONTENT="натянулъ, только одна стрѣла; стрѣла пробила волка, какъ мягкій снѣгъ и" HPOS="597" VPOS="1324" WIDTH="2984" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-357_l7" HPOS="603" VPOS="1442" WIDTH="2978" HEIGHT="102" BASELINE="603 1543 3581 1543">
            <Shape>
              <Polygon POINTS="603 1442 3581 1442 3581 1544 603 1544"/>
            </Shape>
            <String CONTENT="вышла насквозь. Волкъ тотчасъ упалъ. Убилъ. Всѣ люди подошли. Дѣ-" HPOS="603" VPOS="1442" WIDTH="2978" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-357_l8" HPOS="599" VPOS="1566" WIDTH="2978" HEIGHT="109" BASELINE="599 1674 3577 1674">
            <Shape>
              <Polygon POINTS="599 1566 3577 1566 3577 1675 599 1675"/>
            </Shape>
            <String CONTENT="вушка говоритъ: «Ну, потрошите!» Опять не могутъ. Какъ камень. Пре-" HPOS="599" VPOS="1566" WIDTH="2978" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-357_l9" HPOS="599" VPOS="1699" WIDTH="2973" HEIGHT="101" BASELINE="599 1799 3572 1799">
            <Shape>
              <Polygon POINTS="599 1699 3572 1699 3572 1800 599 1800"/>
            </Shape>
            <String CONTENT="красные ножи, большіе ножи, малые ножи, всѣ стали тупы, изломались." HPOS="599" VPOS="1699" WIDTH="2973" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-357_l10" HPOS="588" VPOS="1820" WIDTH="2988" HEIGHT="108" BASELINE="588 1927 3576 1927">
            <Shape>
              <Polygon POINTS="588 1820 3576 1820 3576 1928 588 1928"/>
            </Shape>
            <String CONTENT="Не могутъ. Всѣ люди опять перестали, не могутъ. Все изломали, чѣмъ" HPOS="588" VPOS="1820" WIDTH="2988" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-357_l11" HPOS="595" VPOS="1953" WIDTH="2974" HEIGHT="102" BASELINE="595 2054 3569 2054">
            <Shape>
              <Polygon POINTS="595 1953 3569 1953 3569 2055 595 2055"/>
            </Shape>
            <String CONTENT="станутъ. Всѣ перестали. Зайчикъ снова свой набедренный ножъ вынулъ," HPOS="595" VPOS="1953" WIDTH="2974" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-357_l12" HPOS="590" VPOS="2068" WIDTH="2989" HEIGHT="113" BASELINE="590 2181 3579 2181">
            <Shape>
              <Polygon POINTS="590 2068 3579 2068 3579 2181 590 2181"/>
            </Shape>
            <String CONTENT="деревянный ножъ. «Ха, ха, ха! Къ чему твой деревянный ножъ? Ты" HPOS="590" VPOS="2068" WIDTH="2989" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-357_l13" HPOS="596" VPOS="2196" WIDTH="2977" HEIGHT="108" BASELINE="596 2303 3573 2303">
            <Shape>
              <Polygon POINTS="596 2196 3573 2196 3573 2304 596 2304"/>
            </Shape>
            <String CONTENT="сломаешь! Наши всѣ большіе желѣзные ножи сошли на нѣтъ¹). Деревян-" HPOS="596" VPOS="2196" WIDTH="2977" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-357_l14" HPOS="594" VPOS="2329" WIDTH="2978" HEIGHT="103" BASELINE="594 2431 3572 2431">
            <Shape>
              <Polygon POINTS="594 2329 3572 2329 3572 2432 594 2432"/>
            </Shape>
            <String CONTENT="нымъ ножемъ, какъ мягкій снѣгъ, разрѣзалъ. Разрѣзалъ, отверстіе сдѣлалъ:" HPOS="594" VPOS="2329" WIDTH="2978" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-357_l15" HPOS="595" VPOS="2445" WIDTH="2982" HEIGHT="112" BASELINE="595 2556 3577 2556">
            <Shape>
              <Polygon POINTS="595 2445 3577 2445 3577 2557 595 2557"/>
            </Shape>
            <String CONTENT="дѣвушка изъ брюха вышла. Сѣла. О, хорошая дѣвка, красивая дѣвка, какъ" HPOS="595" VPOS="2445" WIDTH="2982" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-357_l16" HPOS="602" VPOS="2583" WIDTH="2970" HEIGHT="101" BASELINE="602 2683 3572 2683">
            <Shape>
              <Polygon POINTS="602 2583 3572 2583 3572 2684 602 2684"/>
            </Shape>
            <String CONTENT="огонь, красавица. Сильные люди взять хотятъ. Всѣ на оленяхъ ѣдущіе," HPOS="602" VPOS="2583" WIDTH="2970" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-357_l17" HPOS="593" VPOS="2711" WIDTH="2984" HEIGHT="99" BASELINE="593 2810 3577 2810">
            <Shape>
              <Polygon POINTS="593 2711 3577 2711 3577 2810 593 2810"/>
            </Shape>
            <String CONTENT="всѣ говорятъ: «Тутъ сядь на моихъ саняхъ!» Сѣла, сломала сани. Другой" HPOS="593" VPOS="2711" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-357_l18" HPOS="598" VPOS="2838" WIDTH="2975" HEIGHT="101" BASELINE="598 2938 3573 2938">
            <Shape>
              <Polygon POINTS="598 2838 3573 2838 3573 2939 598 2939"/>
            </Shape>
            <String CONTENT="говоритъ: «Тутъ сядь!» Всѣ изломала. Сколько ни было, всѣ сани изломала." HPOS="598" VPOS="2838" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-357_l19" HPOS="589" VPOS="2919" WIDTH="2986" HEIGHT="141" BASELINE="589 3059 3575 3059">
            <Shape>
              <Polygon POINTS="589 2919 3575 2919 3575 3060 589 3060"/>
            </Shape>
            <String CONTENT="Всѣ люди стали пѣшіе, — всѣ изломала, искрошила. Снова зайчикъ изъ" HPOS="589" VPOS="2919" WIDTH="2986" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-357_l20" HPOS="594" VPOS="3089" WIDTH="2981" HEIGHT="99" BASELINE="594 3187 3575 3187">
            <Shape>
              <Polygon POINTS="594 3089 3575 3089 3575 3188 594 3188"/>
            </Shape>
            <String CONTENT="травы; изъ тальничка санки сдѣлалъ, быстро сдѣлалъ вродѣ санокъ. Сѣла" HPOS="594" VPOS="3089" WIDTH="2981" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-357_l21" HPOS="595" VPOS="3214" WIDTH="2984" HEIGHT="101" BASELINE="595 3314 3579 3314">
            <Shape>
              <Polygon POINTS="595 3214 3579 3214 3579 3315 595 3315"/>
            </Shape>
            <String CONTENT="на тальничныя санки, вдвоемъ уѣхали. Въ свою землю увезъ, женою взялъ;" HPOS="595" VPOS="3214" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-357_l22" HPOS="594" VPOS="3355" WIDTH="992" HEIGHT="86" BASELINE="594 3441 1586 3441">
            <Shape>
              <Polygon POINTS="594 3355 1586 3355 1586 3441 594 3441"/>
            </Shape>
            <String CONTENT="въ свою землю ускакалъ." HPOS="594" VPOS="3355" WIDTH="992" HEIGHT="86"/>
          </TextLine>
          <TextLine ID="mz_1-357_l23" HPOS="795" VPOS="3497" WIDTH="1877" HEIGHT="93" BASELINE="795 3590 2672 3590">
            <Shape>
              <Polygon POINTS="795 3497 2672 3497 2672 3590 795 3590"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Ајӈанва́т’а въ Нижнеколымскѣ." HPOS="795" VPOS="3497" WIDTH="1877" HEIGHT="93"/>
          </TextLine>
