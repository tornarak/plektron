          </TextLine>
          <TextLine ID="mz_1-357_l25" HPOS="1020" VPOS="4037" WIDTH="2113" HEIGHT="114" BASELINE="1020 4150 3133 4150">
            <Shape>
              <Polygon POINTS="1020 4037 3133 4037 3133 4151 1020 4151"/>
            </Shape>
            <String CONTENT="Ӈа̀w-о́мӄы-lѵ́мӈыl. О бѣлой медвѣдицѣ сказка." HPOS="1020" VPOS="4037" WIDTH="2113" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-357_l26" HPOS="784" VPOS="4239" WIDTH="2777" HEIGHT="104" BASELINE="784 4342 3561 4342">
            <Shape>
              <Polygon POINTS="784 4239 3561 4239 3561 4343 784 4343"/>
            </Shape>
            <String CONTENT="Парень²); у него только старушка въ товарищахъ. Онъ холостой." HPOS="784" VPOS="4239" WIDTH="2777" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-357_l27" HPOS="582" VPOS="4377" WIDTH="2982" HEIGHT="96" BASELINE="582 4472 3564 4472">
            <Shape>
              <Polygon POINTS="582 4377 3564 4377 3564 4473 582 4473"/>
            </Shape>
            <String CONTENT="Постоянно ходитъ по берегу, много тюленей убиваетъ, постоянно убиваетъ" HPOS="582" VPOS="4377" WIDTH="2982" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-357_l28" HPOS="581" VPOS="4502" WIDTH="2984" HEIGHT="95" BASELINE="581 4596 3565 4596">
            <Shape>
              <Polygon POINTS="581 4502 3565 4502 3565 4597 581 4597"/>
            </Shape>
            <String CONTENT="тюленей; постоянно приходитъ вечеромъ. Наконецъ, въ ночномъ стран-" HPOS="581" VPOS="4502" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-357_l29" HPOS="589" VPOS="4622" WIDTH="2976" HEIGHT="101" BASELINE="589 4722 3565 4722">
            <Shape>
              <Polygon POINTS="589 4622 3565 4622 3565 4723 589 4723"/>
            </Shape>
            <String CONTENT="ствованіи увидѣлъ огонь, свѣтъ лампы, выходитъ изъ снѣга. Туда и пошелъ." HPOS="589" VPOS="4622" WIDTH="2976" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-357_l30" HPOS="579" VPOS="4711" WIDTH="2988" HEIGHT="141" BASELINE="579 4851 3567 4851">
            <Shape>
              <Polygon POINTS="579 4711 3567 4711 3567 4852 579 4852"/>
            </Shape>
            <String CONTENT="Пришелъ, заглянулъ во входъ: дѣвушка совсѣмъ бѣлая, — а это морская" HPOS="579" VPOS="4711" WIDTH="2988" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-357_l31" HPOS="584" VPOS="4828" WIDTH="2982" HEIGHT="138" BASELINE="584 4965 3566 4965">
            <Shape>
              <Polygon POINTS="584 4828 3566 4828 3566 4966 584 4966"/>
            </Shape>
            <String CONTENT="бѣлая медвѣдица. Говоритъ: «Ты откуда-же?» — «Вотъ здѣшній!» Сталъ" HPOS="584" VPOS="4828" WIDTH="2982" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-357_l32" HPOS="580" VPOS="5003" WIDTH="2986" HEIGHT="103" BASELINE="580 5105 3566 5105">
            <Shape>
              <Polygon POINTS="580 5003 3566 5003 3566 5106 580 5106"/>
            </Shape>
            <String CONTENT="тамъ ночевать, женился на ней, совокупился, она родила сына. Пошли" HPOS="580" VPOS="5003" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-357_l33" HPOS="581" VPOS="5121" WIDTH="2984" HEIGHT="111" BASELINE="581 5231 3565 5231">
            <Shape>
              <Polygon POINTS="581 5121 3565 5121 3565 5232 581 5232"/>
            </Shape>
            <String CONTENT="домой навѣстить старушку. Стали жить у ней. Родилась еще и дочь. Мужъ" HPOS="581" VPOS="5121" WIDTH="2984" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-357_l34" HPOS="582" VPOS="5252" WIDTH="2985" HEIGHT="102" BASELINE="582 5353 3567 5353">
            <Shape>
              <Polygon POINTS="582 5252 3567 5252 3567 5354 582 5354"/>
            </Shape>
            <String CONTENT="и жена ходятъ, постоянно убиваютъ тюленей. Дѣвочка постоянно ѣстъ" HPOS="582" VPOS="5252" WIDTH="2985" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-357_l35" HPOS="578" VPOS="5378" WIDTH="2986" HEIGHT="104" BASELINE="578 5481 3564 5481">
            <Shape>
              <Polygon POINTS="578 5378 3564 5378 3564 5482 578 5482"/>
            </Shape>
            <String CONTENT="только жиръ, другіе-же ѣдятъ только мясо, дѣвочка-же и мать ѣдятъ" HPOS="578" VPOS="5378" WIDTH="2986" HEIGHT="104"/>
          </TextLine>
