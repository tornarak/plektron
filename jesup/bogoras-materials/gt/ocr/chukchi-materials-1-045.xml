            </Shape>
            <String CONTENT="эпизоды; но самый красивый изъ а̂ӄӓlыlэ́ткін пы́ӈыl есть большой разсказъ" HPOS="559" VPOS="4024" WIDTH="2985" HEIGHT="115"/>
          </TextLine>
