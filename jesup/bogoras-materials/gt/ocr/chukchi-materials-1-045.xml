          </TextLine>
          <TextLine ID="mz_1-045_l19" HPOS="552" VPOS="2902" WIDTH="2982" HEIGHT="98" BASELINE="552 2999 3534 2999">
            <Shape>
              <Polygon POINTS="552 2902 3534 2902 3534 3000 552 3000"/>
            </Shape>
            <String CONTENT="но яркихъ краскахъ. Та́lо лежитъ въ пологу, нагуливаетъ жиръ. Онъ такъ" HPOS="552" VPOS="2902" WIDTH="2982" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-045_l20" HPOS="545" VPOS="3027" WIDTH="2984" HEIGHT="103" BASELINE="545 3129 3529 3129">
            <Shape>
              <Polygon POINTS="545 3027 3529 3027 3529 3130 545 3130"/>
            </Shape>
            <String CONTENT="лѣнивъ, что ему лѣнь даже отправлять естественныя нужды, какъ слѣдуетъ," HPOS="545" VPOS="3027" WIDTH="2984" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-045_l21" HPOS="553" VPOS="3148" WIDTH="2981" HEIGHT="105" BASELINE="553 3252 3534 3252">
            <Shape>
              <Polygon POINTS="553 3148 3534 3148 3534 3253 553 3253"/>
            </Shape>
            <String CONTENT="и женщины помогаютъ ему, какъ разслабленному. Питается онъ исключи-" HPOS="553" VPOS="3148" WIDTH="2981" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-045_l22" HPOS="554" VPOS="3278" WIDTH="2985" HEIGHT="103" BASELINE="554 3380 3539 3380">
            <Shape>
              <Polygon POINTS="554 3278 3539 3278 3539 3381 554 3381"/>
            </Shape>
            <String CONTENT="тельно жиромъ, языками, мясомъ молодыхъ телять. За то, когда прибли-" HPOS="554" VPOS="3278" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-045_l23" HPOS="554" VPOS="3409" WIDTH="2987" HEIGHT="94" BASELINE="554 3503 3541 3503">
            <Shape>
              <Polygon POINTS="554 3409 3541 3409 3541 3503 554 3503"/>
            </Shape>
            <String CONTENT="жается время войны и онъ наконецъ выходитъ изъ полога, онъ весь обре-" HPOS="554" VPOS="3409" WIDTH="2987" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-045_l24" HPOS="552" VPOS="3533" WIDTH="2986" HEIGHT="99" BASELINE="552 3631 3538 3631">
            <Shape>
              <Polygon POINTS="552 3533 3538 3533 3538 3632 552 3632"/>
            </Shape>
            <String CONTENT="мененъ мускулами и мясомъ, которое подпираетъ ему щеки. Та́lо подвер-" HPOS="552" VPOS="3533" WIDTH="2986" HEIGHT="99"/>
          </TextLine>
