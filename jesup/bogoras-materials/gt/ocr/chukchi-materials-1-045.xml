          </TextLine>
          <TextLine ID="mz_1-045_l40" HPOS="569" VPOS="5540" WIDTH="2984" HEIGHT="102" BASELINE="569 5641 3553 5641">
            <Shape>
              <Polygon POINTS="569 5540 3553 5540 3553 5642 569 5642"/>
            </Shape>
