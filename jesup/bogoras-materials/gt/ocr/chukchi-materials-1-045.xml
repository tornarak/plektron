              <Polygon POINTS="559 4160 3544 4160 3544 4259 559 4259"/>
            </Shape>
            <String CONTENT="объ Эlэ́нді и его сыновьяхъ, распадающійся на четыре отдѣльныхъ эпи-" HPOS="559" VPOS="4160" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-045_l30" HPOS="559" VPOS="4282" WIDTH="2975" HEIGHT="94" BASELINE="559 4375 3534 4375">
            <Shape>
              <Polygon POINTS="559 4282 3534 4282 3534 4376 559 4376"/>
            </Shape>
