          </TextLine>
          <TextLine ID="mz_1-045_l32" HPOS="557" VPOS="4529" WIDTH="2982" HEIGHT="102" BASELINE="557 4630 3539 4630">
            <Shape>
              <Polygon POINTS="557 4529 3539 4529 3539 4631 557 4631"/>
            </Shape>
            <String CONTENT="Эlэ́нді и уводятъ ихъ на свою родину. Младшая дѣвушка успѣваетъ бѣжать;" HPOS="557" VPOS="4529" WIDTH="2982" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-045_l33" HPOS="561" VPOS="4655" WIDTH="2981" HEIGHT="102" BASELINE="561 4756 3542 4756">
