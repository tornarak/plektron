          <TextLine ID="mz_1-045_l7" HPOS="755" VPOS="1397" WIDTH="2766" HEIGHT="102" BASELINE="755 1498 3521 1498">
            <Shape>
              <Polygon POINTS="755 1397 3521 1397 3521 1499 755 1499"/>
            </Shape>
            <String CONTENT="Самые характерные изъ этихъ разсказовъ относятся къ Тэмэ́эрэч’у," HPOS="755" VPOS="1397" WIDTH="2766" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-045_l8" HPOS="542" VPOS="1523" WIDTH="2982" HEIGHT="99" BASELINE="542 1621 3524 1621">
            <Shape>
              <Polygon POINTS="542 1523 3524 1523 3524 1622 542 1622"/>
            </Shape>
            <String CONTENT="Та́lо, воспитаннику таньговъ, и Эlэ́нді. Тэмэ́эрэч въ началѣ является бѣд-" HPOS="542" VPOS="1523" WIDTH="2982" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-045_l9" HPOS="553" VPOS="1647" WIDTH="2975" HEIGHT="99" BASELINE="553 1745 3528 1745">
            <Shape>
              <Polygon POINTS="553 1647 3528 1647 3528 1746 553 1746"/>
            </Shape>
            <String CONTENT="нымъ сиротой, отвергаемымъ всѣми, и описаніе его поведенія напоминаетъ" HPOS="553" VPOS="1647" WIDTH="2975" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-045_l10" HPOS="547" VPOS="1776" WIDTH="2979" HEIGHT="96" BASELINE="547 1872 3526 1872">
            <Shape>
              <Polygon POINTS="547 1776 3526 1776 3526 1872 547 1872"/>
            </Shape>
            <String CONTENT="то вышеупомянутый сказочный мотивъ превращенія сиротки въ удальца" HPOS="547" VPOS="1776" WIDTH="2979" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-045_l11" HPOS="544" VPOS="1900" WIDTH="2980" HEIGHT="97" BASELINE="544 1996 3524 1996">
            <Shape>
              <Polygon POINTS="544 1900 3524 1900 3524 1997 544 1997"/>
            </Shape>
            <String CONTENT="и красавца, то проказы отрока-шамана Ры́нтеў. Во время преслѣдованія" HPOS="544" VPOS="1900" WIDTH="2980" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-045_l12" HPOS="549" VPOS="2028" WIDTH="2974" HEIGHT="93" BASELINE="549 2120 3523 2120">
            <Shape>
              <Polygon POINTS="549 2028 3523 2028 3523 2121 549 2121"/>
            </Shape>
            <String CONTENT="жителей таньгами онъ убиваетъ изъ дѣтскаго лука главнаго богатыря" HPOS="549" VPOS="2028" WIDTH="2974" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-045_l13" HPOS="546" VPOS="2146" WIDTH="2980" HEIGHT="103" BASELINE="546 2248 3526 2248">
            <Shape>
              <Polygon POINTS="546 2146 3526 2146 3526 2249 546 2249"/>
            </Shape>
            <String CONTENT="таньговъ и овладѣваетъ его вооруженіемъ. Послѣ того уже юношей онъ" HPOS="546" VPOS="2146" WIDTH="2980" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-045_l14" HPOS="551" VPOS="2276" WIDTH="2977" HEIGHT="100" BASELINE="551 2375 3528 2375">
            <Shape>
              <Polygon POINTS="551 2276 3528 2276 3528 2376 551 2376"/>
            </Shape>
            <String CONTENT="принимаетъ участіе въ бѣгѣ на оленяхъ, но обгоняетъ самыхъ лучшихъ" HPOS="551" VPOS="2276" WIDTH="2977" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-045_l15" HPOS="547" VPOS="2405" WIDTH="2984" HEIGHT="95" BASELINE="547 2499 3531 2499">
            <Shape>
              <Polygon POINTS="547 2405 3531 2405 3531 2500 547 2500"/>
            </Shape>
            <String CONTENT="бѣгуновъ собственными ногами, волоча за собой своего дядю на нартѣ въ" HPOS="547" VPOS="2405" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-045_l16" HPOS="546" VPOS="2535" WIDTH="2984" HEIGHT="93" BASELINE="546 2627 3530 2627">
            <Shape>
              <Polygon POINTS="546 2535 3530 2535 3530 2628 546 2628"/>
            </Shape>
            <String CONTENT="видѣ ѣздока. Эпизодъ этотъ описанъ очень подробно и красиво и кончается" HPOS="546" VPOS="2535" WIDTH="2984" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-045_l17" HPOS="547" VPOS="2653" WIDTH="1449" HEIGHT="99" BASELINE="547 2751 1996 2751">
            <Shape>
              <Polygon POINTS="547 2653 1996 2653 1996 2752 547 2752"/>
            </Shape>
            <String CONTENT="полнѣйшимъ торжествомъ Тэмэ́эрэч." HPOS="547" VPOS="2653" WIDTH="1449" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-045_l18" HPOS="764" VPOS="2772" WIDTH="2769" HEIGHT="106" BASELINE="764 2877 3533 2877">
