            <Shape>
              <Polygon POINTS="551 3655 3541 3655 3541 3756 551 3756"/>
            </Shape>
            <String CONTENT="гаетъ себя неумолимо крутой дрессировкѣ и въ двадцать дней успѣваетъ" HPOS="551" VPOS="3655" WIDTH="2990" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-045_l26" HPOS="555" VPOS="3777" WIDTH="1979" HEIGHT="103" BASELINE="555 3879 2534 3879">
            <Shape>
              <Polygon POINTS="555 3777 2534 3777 2534 3880 555 3880"/>
            </Shape>
            <String CONTENT="реализовать всю скрытую энергію своихъ мышцъ." HPOS="555" VPOS="3777" WIDTH="1979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-045_l27" HPOS="765" VPOS="3899" WIDTH="2776" HEIGHT="102" BASELINE="765 4000 3541 4000">
            <Shape>
              <Polygon POINTS="765 3899 3541 3899 3541 4001 765 4001"/>
            </Shape>
            <String CONTENT="Въ этой сказкѣ есть красиво описанные драматическіе и своеобразные" HPOS="765" VPOS="3899" WIDTH="2776" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-045_l28" HPOS="559" VPOS="4024" WIDTH="2985" HEIGHT="115" BASELINE="559 4138 3544 4138">
            <Shape>
