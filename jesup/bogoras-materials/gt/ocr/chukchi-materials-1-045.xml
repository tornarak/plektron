            <Shape>
              <Polygon POINTS="561 4781 3550 4781 3550 4877 561 4877"/>
            </Shape>
            <String CONTENT="таньговъ, который въ концѣ концовъ кончается гибелью таньговъ. Послѣ" HPOS="561" VPOS="4781" WIDTH="2989" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-045_l35" HPOS="565" VPOS="4906" WIDTH="2986" HEIGHT="98" BASELINE="565 5004 3551 5004">
