        <TextBlock ID="text_1-389" HPOS="545" VPOS="638" WIDTH="3045" HEIGHT="5168">
          <TextLine ID="mz_1-389_l1" HPOS="578" VPOS="638" WIDTH="3012" HEIGHT="112" BASELINE="578 734 3590 734">
            <Shape>
              <Polygon POINTS="578 638 3590 638 3590 750 578 750"/>
            </Shape>
            <String CONTENT="II,128. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 333" HPOS="578" VPOS="638" WIDTH="3012" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-389_l2" HPOS="584" VPOS="834" WIDTH="2997" HEIGHT="108" BASELINE="584 941 3581 941">
            <Shape>
              <Polygon POINTS="584 834 3581 834 3581 942 584 942"/>
            </Shape>
            <String CONTENT="сверху камни, изломали укрѣпленіе и истребили людей. На землѣ Нэ́тэн за" HPOS="584" VPOS="834" WIDTH="2997" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-389_l3" HPOS="578" VPOS="968" WIDTH="2996" HEIGHT="98" BASELINE="578 1066 3574 1066">
            <Shape>
              <Polygon POINTS="578 968 3574 968 3574 1066 578 1066"/>
            </Shape>
            <String CONTENT="мысомъ Пэ́эк поставили подъ утесомъ, нависшимъ надъ берегомъ, другую" HPOS="578" VPOS="968" WIDTH="2996" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-389_l4" HPOS="585" VPOS="1100" WIDTH="2988" HEIGHT="98" BASELINE="585 1197 3573 1197">
            <Shape>
              <Polygon POINTS="585 1100 3573 1100 3573 1198 585 1198"/>
            </Shape>
            <String CONTENT="крѣпость. Сверху нельзя скатить туда камни. Таньги взошли на утесъ." HPOS="585" VPOS="1100" WIDTH="2988" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-389_l5" HPOS="584" VPOS="1223" WIDTH="2994" HEIGHT="93" BASELINE="584 1316 3578 1316">
            <Shape>
              <Polygon POINTS="584 1223 3578 1223 3578 1316 584 1316"/>
            </Shape>
            <String CONTENT="Ничего не могутъ сдѣлать, ибо перелетаютъ камни ихъ черезъ границу" HPOS="584" VPOS="1223" WIDTH="2994" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-389_l6" HPOS="587" VPOS="1342" WIDTH="2995" HEIGHT="105" BASELINE="587 1447 3582 1447">
            <Shape>
              <Polygon POINTS="587 1342 3582 1342 3582 1447 587 1447"/>
            </Shape>
            <String CONTENT="жительства. Стали обходить, ища прохода, впереди идетъ въ желѣзномъ" HPOS="587" VPOS="1342" WIDTH="2995" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-389_l7" HPOS="587" VPOS="1447" WIDTH="2994" HEIGHT="123" BASELINE="587 1569 3581 1569">
            <Shape>
              <Polygon POINTS="587 1447 3581 1447 3581 1570 587 1570"/>
            </Shape>
            <String CONTENT="панцырѣ Јӓку́ннін. У входа въ узкое ущелье стоитъ чукотскій парень" HPOS="587" VPOS="1447" WIDTH="2994" HEIGHT="123"/>
          </TextLine>
          <TextLine ID="mz_1-389_l8" HPOS="586" VPOS="1586" WIDTH="2998" HEIGHT="115" BASELINE="586 1700 3584 1700">
            <Shape>
              <Polygon POINTS="586 1586 3584 1586 3584 1701 586 1701"/>
            </Shape>
            <String CONTENT="Е́ырђын съ лукомъ въ рукахъ и пьетъ изъ деревянной чаши воду. «Пей" HPOS="586" VPOS="1586" WIDTH="2998" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-389_l9" HPOS="583" VPOS="1722" WIDTH="3002" HEIGHT="103" BASELINE="583 1824 3585 1824">
            <Shape>
              <Polygon POINTS="583 1722 3585 1722 3585 1825 583 1825"/>
            </Shape>
            <String CONTENT="хорошенько», говоритъ Јӓку́ннін, «больше ты не будешь пить на этой" HPOS="583" VPOS="1722" WIDTH="3002" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-389_l10" HPOS="586" VPOS="1852" WIDTH="2995" HEIGHT="97" BASELINE="586 1948 3581 1948">
            <Shape>
              <Polygon POINTS="586 1852 3581 1852 3581 1949 586 1949"/>
            </Shape>
            <String CONTENT="землѣ!» Схватилъ Јӓку́ннін копье, сталъ размахивать, прыгаетъ вверхъ," HPOS="586" VPOS="1852" WIDTH="2995" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-389_l11" HPOS="590" VPOS="1973" WIDTH="2994" HEIGHT="95" BASELINE="590 2068 3584 2068">
            <Shape>
              <Polygon POINTS="590 1973 3584 1973 3584 2068 590 2068"/>
            </Shape>
            <String CONTENT="какъ вершина дерева, и машетъ копьемъ. Парень снялъ со стѣны небольшой" HPOS="590" VPOS="1973" WIDTH="2994" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-389_l12" HPOS="585" VPOS="2097" WIDTH="2996" HEIGHT="100" BASELINE="585 2196 3581 2196">
            <Shape>
              <Polygon POINTS="585 2097 3581 2097 3581 2197 585 2197"/>
            </Shape>
            <String CONTENT="лукъ, наложилъ небольшую стрѣлу изъ китоваго уса. Лицо Јӓку́ннін’а по-" HPOS="585" VPOS="2097" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-389_l13" HPOS="592" VPOS="2214" WIDTH="2992" HEIGHT="105" BASELINE="592 2318 3584 2318">
            <Shape>
              <Polygon POINTS="592 2214 3584 2214 3584 2319 592 2319"/>
            </Shape>
            <String CONTENT="крыто желѣзомъ, только двѣ дыры вмѣсто глазъ. Тотъ выстрѣлилъ. Пока" HPOS="592" VPOS="2214" WIDTH="2992" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-389_l14" HPOS="589" VPOS="2343" WIDTH="2990" HEIGHT="100" BASELINE="589 2443 3579 2443">
            <Shape>
              <Polygon POINTS="589 2343 3579 2343 3579 2443 589 2443"/>
            </Shape>
            <String CONTENT="прыгаетъ, попалъ ему прямо въ глазъ. Упалъ на землю Јӓку́ннін; по-" HPOS="589" VPOS="2343" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-389_l15" HPOS="588" VPOS="2452" WIDTH="2994" HEIGHT="118" BASELINE="588 2569 3582 2569">
            <Shape>
              <Polygon POINTS="588 2452 3582 2452 3582 2570 588 2570"/>
            </Shape>
            <String CONTENT="бѣжалъ и схватилъ его: «Ты, худо убивательный! У насъ нѣтъ топоровъ," HPOS="588" VPOS="2452" WIDTH="2994" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-389_l16" HPOS="590" VPOS="2593" WIDTH="2992" HEIGHT="101" BASELINE="590 2693 3582 2693">
            <Shape>
              <Polygon POINTS="590 2593 3582 2593 3582 2694 590 2694"/>
            </Shape>
            <String CONTENT="но по крайней мѣрѣ иначе умертвимъ тебя!» Развели огонь, жарятъ его у" HPOS="590" VPOS="2593" WIDTH="2992" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-389_l17" HPOS="587" VPOS="2718" WIDTH="2993" HEIGHT="100" BASELINE="587 2818 3580 2818">
            <Shape>
              <Polygon POINTS="587 2718 3580 2718 3580 2818 587 2818"/>
            </Shape>
            <String CONTENT="огна, хорошо исжаренное мясо срѣзываютъ ломтиками и жарятъ снова." HPOS="587" VPOS="2718" WIDTH="2993" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-389_l18" HPOS="589" VPOS="2844" WIDTH="2997" HEIGHT="102" BASELINE="589 2945 3586 2945">
            <Shape>
              <Polygon POINTS="589 2844 3586 2844 3586 2946 589 2946"/>
            </Shape>
            <String CONTENT="Умеръ. Таньги испугавшись бѣжали, но ихъ настигли и истребили. Тогда" HPOS="589" VPOS="2844" WIDTH="2997" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-389_l19" HPOS="587" VPOS="2972" WIDTH="3000" HEIGHT="98" BASELINE="587 3069 3587 3069">
            <Shape>
              <Polygon POINTS="587 2972 3587 2972 3587 3070 587 3070"/>
            </Shape>
            <String CONTENT="въ знакъ радости устроили гонку судовъ жители Нэ́тэна. Собрались на" HPOS="587" VPOS="2972" WIDTH="3000" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-389_l20" HPOS="590" VPOS="3102" WIDTH="2997" HEIGHT="99" BASELINE="590 3200 3587 3200">
            <Shape>
              <Polygon POINTS="590 3102 3587 3102 3587 3201 590 3201"/>
            </Shape>
            <String CONTENT="гонку изъ Нуукана, Уэлена, Пичуна и всѣхъ приморскихъ селеній до Ван-" HPOS="590" VPOS="3102" WIDTH="2997" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-389_l21" HPOS="586" VPOS="3224" WIDTH="2992" HEIGHT="99" BASELINE="586 3323 3578 3323">
            <Shape>
              <Polygon POINTS="586 3224 3578 3224 3578 3323 586 3323"/>
            </Shape>
            <String CONTENT="карэма, но всѣхъ побѣдили два брата, рожденные сукой, изъ Эка́люруна." HPOS="586" VPOS="3224" WIDTH="2992" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-389_l22" HPOS="589" VPOS="3344" WIDTH="2992" HEIGHT="102" BASELINE="589 3445 3581 3445">
            <Shape>
              <Polygon POINTS="589 3344 3581 3344 3581 3446 589 3446"/>
            </Shape>
            <String CONTENT="Ставкой была плѣнная дѣвушка. Ее взявъ женились на ней. Отъ нихъ раз-" HPOS="589" VPOS="3344" WIDTH="2992" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-389_l23" HPOS="582" VPOS="3472" WIDTH="1541" HEIGHT="101" BASELINE="582 3572 2123 3572">
            <Shape>
              <Polygon POINTS="582 3472 2123 3472 2123 3573 582 3573"/>
            </Shape>
            <String CONTENT="множился родъ «рожденныхъ сукой»¹)." HPOS="582" VPOS="3472" WIDTH="1541" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-389_l24" HPOS="804" VPOS="3632" WIDTH="1876" HEIGHT="104" BASELINE="804 3735 2680 3735">
            <Shape>
              <Polygon POINTS="804 3632 2680 3632 2680 3736 804 3736"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Ӈыро́н’а на урочищѣ Акона́јке." HPOS="804" VPOS="3632" WIDTH="1876" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-389_l25" HPOS="1994" VPOS="3974" WIDTH="173" HEIGHT="95" BASELINE="1994 4069 2167 4069">
            <Shape>
              <Polygon POINTS="1994 3974 2167 3974 2167 4069 1994 4069"/>
            </Shape>
            <String CONTENT="129." HPOS="1994" VPOS="3974" WIDTH="173" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-389_l26" HPOS="1225" VPOS="4170" WIDTH="1718" HEIGHT="102" BASELINE="1225 4271 2943 4271">
            <Shape>
              <Polygon POINTS="1225 4170 2943 4170 2943 4272 1225 4272"/>
            </Shape>
            <String CONTENT="Јако́нне-lѵ́мӈыl. О Јӓку́ннін’ѣ сказка." HPOS="1225" VPOS="4170" WIDTH="1718" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-389_l27" HPOS="808" VPOS="4334" WIDTH="2777" HEIGHT="135" BASELINE="808 4469 3585 4469">
            <Shape>
              <Polygon POINTS="808 4334 3585 4334 3585 4469 808 4469"/>
            </Shape>
            <String CONTENT="Былъ русскій начальникъ — очень жестокій, худо убивалъ нашихъ" HPOS="808" VPOS="4334" WIDTH="2777" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-389_l28" HPOS="590" VPOS="4504" WIDTH="2994" HEIGHT="96" BASELINE="590 4599 3584 4599">
            <Shape>
              <Polygon POINTS="590 4504 3584 4504 3584 4600 590 4600"/>
            </Shape>
            <String CONTENT="людей. Держали за ноги, разрубали топоромъ сверху внизъ промежду" HPOS="590" VPOS="4504" WIDTH="2994" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-389_l29" HPOS="595" VPOS="4617" WIDTH="2990" HEIGHT="100" BASELINE="595 4716 3585 4716">
            <Shape>
              <Polygon POINTS="595 4617 3585 4617 3585 4717 595 4717"/>
            </Shape>
            <String CONTENT="ногъ, внутренности выпадали. Привязывали мужчинамъ членъ къ шеѣ и" HPOS="595" VPOS="4617" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-389_l30" HPOS="592" VPOS="4743" WIDTH="2990" HEIGHT="97" BASELINE="592 4840 3582 4840">
            <Shape>
              <Polygon POINTS="592 4743 3582 4743 3582 4840 592 4840"/>
            </Shape>
            <String CONTENT="били по спинѣ. Человѣкъ вскакивалъ и отрывалъ членъ или ядра. Много" HPOS="592" VPOS="4743" WIDTH="2990" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-389_l31" HPOS="595" VPOS="4859" WIDTH="2989" HEIGHT="106" BASELINE="595 4965 3584 4965">
            <Shape>
              <Polygon POINTS="595 4859 3584 4859 3584 4965 595 4965"/>
            </Shape>
            <String CONTENT="стадъ заграбили. Поѣхалъ онъ однажды съ Колымы на Анадыръ. Самъ" HPOS="595" VPOS="4859" WIDTH="2989" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-389_l32" HPOS="597" VPOS="4993" WIDTH="2990" HEIGHT="102" BASELINE="597 5094 3587 5094">
            <Shape>
              <Polygon POINTS="597 4993 3587 4993 3587 5095 597 5095"/>
            </Shape>
            <String CONTENT="ѣдетъ въ кибиткѣ, люди бѣгутъ рядомъ. Услышали наши, собралось ско-" HPOS="597" VPOS="4993" WIDTH="2990" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-389_l33" HPOS="595" VPOS="5117" WIDTH="2985" HEIGHT="103" BASELINE="595 5219 3580 5219">
            <Shape>
              <Polygon POINTS="595 5117 3580 5117 3580 5220 595 5220"/>
            </Shape>
            <String CONTENT="пище съ тундры, прибѣжали, засѣли по дорогѣ. Ночью напали на сонныхъ," HPOS="595" VPOS="5117" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-389_l34" HPOS="591" VPOS="5231" WIDTH="2991" HEIGHT="110" BASELINE="591 5340 3582 5340">
            <Shape>
              <Polygon POINTS="591 5231 3582 5231 3582 5341 591 5341"/>
            </Shape>
            <String CONTENT="перерѣзали всѣхъ, только начальника взяли живымъ. Еще двухъ русаковъ," HPOS="591" VPOS="5231" WIDTH="2991" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-389_l35" HPOS="814" VPOS="5507" WIDTH="2772" HEIGHT="91" BASELINE="814 5597 3586 5597">
            <Shape>
              <Polygon POINTS="814 5507 3586 5507 3586 5598 814 5598"/>
            </Shape>
            <String CONTENT="1) Семья такъ называемаго «тойона всѣхъ чукочъ» ведетъ свое происхожденіе" HPOS="814" VPOS="5507" WIDTH="2772" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-389_l36" HPOS="545" VPOS="5615" WIDTH="3043" HEIGHT="91" BASELINE="545 5706 3588 5706">
            <Shape>
              <Polygon POINTS="545 5615 3588 5615 3588 5706 545 5706"/>
            </Shape>
            <String CONTENT="именно отъ этихъ братьевъ, прародительницей (но не матерью) которыхъ считается" HPOS="545" VPOS="5615" WIDTH="3043" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-389_l37" HPOS="596" VPOS="5725" WIDTH="746" HEIGHT="81" BASELINE="596 5806 1342 5806">
            <Shape>
              <Polygon POINTS="596 5725 1342 5725 1342 5806 596 5806"/>
            </Shape>
            <String CONTENT="большая черная сука." HPOS="596" VPOS="5725" WIDTH="746" HEIGHT="81"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
