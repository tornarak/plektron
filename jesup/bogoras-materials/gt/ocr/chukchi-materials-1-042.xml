          </TextLine>
          <TextLine ID="mz_1-042_l10" HPOS="1355" VPOS="1797" WIDTH="2778" HEIGHT="109" BASELINE="1355 1905 4133 1905">
            <Shape>
              <Polygon POINTS="1355 1797 4133 1797 4133 1906 1355 1906"/>
            </Shape>
            <String CONTENT="Китъ (№ 115) является въ видѣ могущественнаго шамана, похищаю-" HPOS="1355" VPOS="1797" WIDTH="2778" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-042_l11" HPOS="1160" VPOS="1922" WIDTH="2976" HEIGHT="109" BASELINE="1160 2030 4136 2030">
            <Shape>
              <Polygon POINTS="1160 1922 4136 1922 4136 2031 1160 2031"/>
            </Shape>
            <String CONTENT="щаго человѣческую дѣвушку себѣ въ жены. Она должна ковырять паль-" HPOS="1160" VPOS="1922" WIDTH="2976" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-042_l12" HPOS="1154" VPOS="2057" WIDTH="2980" HEIGHT="98" BASELINE="1154 2154 4134 2154">
            <Shape>
              <Polygon POINTS="1154 2057 4134 2057 4134 2155 1154 2155"/>
            </Shape>
            <String CONTENT="цами червей изъ его кожи и стираетъ при этомъ концы пальцевъ до костей." HPOS="1154" VPOS="2057" WIDTH="2980" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-042_l13" HPOS="1153" VPOS="2180" WIDTH="2981" HEIGHT="102" BASELINE="1153 2281 4134 2281">
            <Shape>
              <Polygon POINTS="1153 2180 4134 2180 4134 2282 1153 2282"/>
            </Shape>
            <String CONTENT="Возвращенная своимъ братомъ на землю, она рождаетъ китенка, который" HPOS="1153" VPOS="2180" WIDTH="2981" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-042_l14" HPOS="1154" VPOS="2301" WIDTH="2980" HEIGHT="102" BASELINE="1154 2403 4134 2403">
            <Shape>
              <Polygon POINTS="1154 2301 4134 2301 4134 2403 1154 2403"/>
            </Shape>
            <String CONTENT="выросши становится помощникомъ своихъ дядьевъ въ китовомъ промыслѣ." HPOS="1154" VPOS="2301" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-042_l15" HPOS="1155" VPOS="2411" WIDTH="2985" HEIGHT="120" BASELINE="1155 2530 4140 2530">
            <Shape>
              <Polygon POINTS="1155 2411 4140 2411 4140 2531 1155 2531"/>
            </Shape>
            <String CONTENT="У тунгусовъ есть точно такая же сказка о медвѣдѣ, взявшемъ въ жены" HPOS="1155" VPOS="2411" WIDTH="2985" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-042_l16" HPOS="1154" VPOS="2554" WIDTH="2983" HEIGHT="104" BASELINE="1154 2657 4137 2657">
            <Shape>
              <Polygon POINTS="1154 2554 4137 2554 4137 2658 1154 2658"/>
            </Shape>
            <String CONTENT="человѣческую дѣвушку, у которой впослѣдствіе рождается медвѣжій сынъ." HPOS="1154" VPOS="2554" WIDTH="2983" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-042_l17" HPOS="1152" VPOS="2679" WIDTH="2991" HEIGHT="103" BASELINE="1152 2781 4143 2781">
