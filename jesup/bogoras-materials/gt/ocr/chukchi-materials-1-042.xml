              <Polygon POINTS="1155 1432 4137 1432 4137 1530 1155 1530"/>
            </Shape>
            <String CONTENT="питавшійся собачьимъ каломъ благодаря злости мачихи. Превращеніе его" HPOS="1155" VPOS="1432" WIDTH="2982" HEIGHT="98"/>
          </TextLine>
