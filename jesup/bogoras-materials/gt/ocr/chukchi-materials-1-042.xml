            </Shape>
            <String CONTENT="китовъ. Въ сказкѣ № 116 дѣйствующимъ лицомъ является богатырь-заяцъ" HPOS="1158" VPOS="2802" WIDTH="2981" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-042_l19" HPOS="1159" VPOS="2934" WIDTH="2985" HEIGHT="99" BASELINE="1159 3033 4144 3033">
            <Shape>
              <Polygon POINTS="1159 2934 4144 2934 4144 3033 1159 3033"/>
            </Shape>
            <String CONTENT="съ маленькимъ лучкомъ, съ стрѣлками и ножикомъ изъ дерева, которымъ" HPOS="1159" VPOS="2934" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-042_l20" HPOS="1159" VPOS="3052" WIDTH="2983" HEIGHT="111" BASELINE="1159 3163 4142 3163">
            <Shape>
              <Polygon POINTS="1159 3052 4142 3052 4142 3163 1159 3163"/>
            </Shape>
            <String CONTENT="однако побѣждаетъ всѣхъ своихъ соперниковъ и увозитъ дѣвушку, бывшую" HPOS="1159" VPOS="3052" WIDTH="2983" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-042_l21" HPOS="1161" VPOS="3187" WIDTH="2978" HEIGHT="104" BASELINE="1161 3290 4139 3290">
            <Shape>
              <Polygon POINTS="1161 3187 4139 3187 4139 3291 1161 3291"/>
            </Shape>
            <String CONTENT="предметомъ спора. Но по всему своему складу сказка является заимство-" HPOS="1161" VPOS="3187" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-042_l22" HPOS="1158" VPOS="3313" WIDTH="2985" HEIGHT="103" BASELINE="1158 3415 4143 3415">
            <Shape>
              <Polygon POINTS="1158 3313 4143 3313 4143 3416 1158 3416"/>
            </Shape>
            <String CONTENT="ванной, вѣроятно, у тунгусовъ. Впрочемъ въ одной изъ сказокъ о воронѣ" HPOS="1158" VPOS="3313" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-042_l23" HPOS="1156" VPOS="3441" WIDTH="2983" HEIGHT="99" BASELINE="1156 3539 4139 3539">
            <Shape>
              <Polygon POINTS="1156 3441 4139 3441 4139 3540 1156 3540"/>
            </Shape>
            <String CONTENT="два маленькіе, всѣми осмѣиваемые зайца внезапно тоже обнаруживаютъ" HPOS="1156" VPOS="3441" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-042_l24" HPOS="1160" VPOS="3571" WIDTH="2977" HEIGHT="95" BASELINE="1160 3665 4137 3665">
            <Shape>
              <Polygon POINTS="1160 3571 4137 3571 4137 3666 1160 3666"/>
            </Shape>
            <String CONTENT="огромную силу и увозятъ вскачь лодку, до верху нагруженную имуществомъ." HPOS="1160" VPOS="3571" WIDTH="2977" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-042_l25" HPOS="1365" VPOS="3683" WIDTH="2769" HEIGHT="102" BASELINE="1365 3784 4134 3784">
            <Shape>
              <Polygon POINTS="1365 3683 4134 3683 4134 3785 1365 3785"/>
            </Shape>
            <String CONTENT="Въ сказкахъ №№ 111 и 114 являются двѣ очень сходныя пары птицъ," HPOS="1365" VPOS="3683" WIDTH="2769" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-042_l26" HPOS="1157" VPOS="3785" WIDTH="2979" HEIGHT="133" BASELINE="1157 3917 4136 3917">
            <Shape>
              <Polygon POINTS="1157 3785 4136 3785 4136 3918 1157 3918"/>
            </Shape>
            <String CONTENT="живущихъ въ товариществѣ и смѣнномъ бракѣ, — въ первомъ случаѣ" HPOS="1157" VPOS="3785" WIDTH="2979" HEIGHT="133"/>
          </TextLine>
          <TextLine ID="mz_1-042_l27" HPOS="1155" VPOS="3945" WIDTH="2986" HEIGHT="102" BASELINE="1155 4046 4141 4046">
            <Shape>
              <Polygon POINTS="1155 3945 4141 3945 4141 4047 1155 4047"/>
            </Shape>
            <String CONTENT="воронъ и орелъ, а во второмъ соколъ и морская крачка (тыкы́ђаӄ¹). Обѣ" HPOS="1155" VPOS="3945" WIDTH="2986" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-042_l28" HPOS="1156" VPOS="4072" WIDTH="2979" HEIGHT="101" BASELINE="1156 4173 4135 4173">
            <Shape>
              <Polygon POINTS="1156 4072 4135 4072 4135 4173 1156 4173"/>
            </Shape>
            <String CONTENT="дружескія пары являются независимыми жителями пустыни, благосклон-" HPOS="1156" VPOS="4072" WIDTH="2979" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-042_l29" HPOS="1157" VPOS="4202" WIDTH="2981" HEIGHT="96" BASELINE="1157 4298 4138 4298">
            <Shape>
              <Polygon POINTS="1157 4202 4138 4202 4138 4298 1157 4298"/>
            </Shape>
            <String CONTENT="наго къ странникамъ нрава. Они обладаютъ значительной шаманской силой" HPOS="1157" VPOS="4202" WIDTH="2981" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-042_l30" HPOS="1155" VPOS="4334" WIDTH="2985" HEIGHT="89" BASELINE="1155 4423 4140 4423">
            <Shape>
              <Polygon POINTS="1155 4334 4140 4334 4140 4423 1155 4423"/>
            </Shape>
            <String CONTENT="и враждуютъ съ заморскимъ орломъ-шаманомъ, похищающимъ съ земли" HPOS="1155" VPOS="4334" WIDTH="2985" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-042_l31" HPOS="1154" VPOS="4455" WIDTH="901" HEIGHT="99" BASELINE="1154 4553 2055 4553">
            <Shape>
              <Polygon POINTS="1154 4455 2055 4455 2055 4554 1154 4554"/>
            </Shape>
            <String CONTENT="то женщинъ, то дѣтей." HPOS="1154" VPOS="4455" WIDTH="901" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-042_l32" HPOS="1355" VPOS="4540" WIDTH="2782" HEIGHT="138" BASELINE="1355 4677 4137 4677">
            <Shape>
              <Polygon POINTS="1355 4540 4137 4540 4137 4678 1355 4678"/>
            </Shape>
            <String CONTENT="Напротивъ въ сказкѣ № 113 птица Каӈо́lђын, не желающая воз-" HPOS="1355" VPOS="4540" WIDTH="2782" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-042_l33" HPOS="1152" VPOS="4693" WIDTH="2986" HEIGHT="106" BASELINE="1152 4798 4138 4798">
            <Shape>
              <Polygon POINTS="1152 4693 4138 4693 4138 4799 1152 4799"/>
            </Shape>
            <String CONTENT="вратить человѣку его жены, изображена очень забавно, благодаря смѣ-" HPOS="1152" VPOS="4693" WIDTH="2986" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-042_l34" HPOS="1154" VPOS="4823" WIDTH="2981" HEIGHT="102" BASELINE="1154 4925 4135 4925">
            <Shape>
              <Polygon POINTS="1154 4823 4135 4823 4135 4925 1154 4925"/>
            </Shape>
            <String CONTENT="шенію птичьихъ и человѣческихъ признаковъ. Каӈо́lђын является началь-" HPOS="1154" VPOS="4823" WIDTH="2981" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-042_l35" HPOS="1154" VPOS="4937" WIDTH="2985" HEIGHT="103" BASELINE="1154 5040 4139 5040">
            <Shape>
              <Polygon POINTS="1154 4937 4139 4937 4139 5040 1154 5040"/>
            </Shape>
            <String CONTENT="никомъ страны птицъ и имѣетъ весьма многочисленный народъ. Онъ" HPOS="1154" VPOS="4937" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-042_l36" HPOS="1154" VPOS="5070" WIDTH="2983" HEIGHT="101" BASELINE="1154 5170 4137 5170">
            <Shape>
              <Polygon POINTS="1154 5070 4137 5070 4137 5171 1154 5171"/>
            </Shape>
            <String CONTENT="считаетъ себя непобѣдимымъ, но на самомъ дѣлѣ и онъ и воины его" HPOS="1154" VPOS="5070" WIDTH="2983" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-042_l37" HPOS="1154" VPOS="5191" WIDTH="2982" HEIGHT="103" BASELINE="1154 5294 4136 5294">
            <Shape>
              <Polygon POINTS="1154 5191 4136 5191 4136 5294 1154 5294"/>
            </Shape>
            <String CONTENT="слабосильны. Птицы, собравшіяся на битву, стрѣляютъ своими маховыми" HPOS="1154" VPOS="5191" WIDTH="2982" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-042_l38" HPOS="1155" VPOS="5322" WIDTH="2981" HEIGHT="97" BASELINE="1155 5419 4136 5419">
            <Shape>
              <Polygon POINTS="1155 5322 4136 5322 4136 5419 1155 5419"/>
            </Shape>
            <String CONTENT="перьями, не причиняя противнику никакого вреда. Человѣкъ свертываетъ" HPOS="1155" VPOS="5322" WIDTH="2981" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-042_l39" HPOS="1147" VPOS="5446" WIDTH="2991" HEIGHT="101" BASELINE="1147 5546 4138 5546">
            <Shape>
              <Polygon POINTS="1147 5446 4138 5446 4138 5547 1147 5547"/>
            </Shape>
            <String CONTENT="Каӈо́lђын’у голову, потомъ при помощи дубинки расправляется со всѣми" HPOS="1147" VPOS="5446" WIDTH="2991" HEIGHT="101"/>
          </TextLine>
