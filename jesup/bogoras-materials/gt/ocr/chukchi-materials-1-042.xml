              <Polygon POINTS="1156 1048 4136 1048 4136 1149 1156 1149"/>
            </Shape>
            <String CONTENT="однимъ изъ самыхъ любимыхъ, конечно соотвѣтственно большому распро-" HPOS="1156" VPOS="1048" WIDTH="2980" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-042_l5" HPOS="1154" VPOS="1166" WIDTH="2982" HEIGHT="100" BASELINE="1154 1266 4136 1266">
            <Shape>
              <Polygon POINTS="1154 1166 4136 1166 4136 1266 1154 1266"/>
            </Shape>
            <String CONTENT="страненію такого явленія въ дѣйствительной жизни. Женихомъ является" HPOS="1154" VPOS="1166" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-042_l6" HPOS="1155" VPOS="1301" WIDTH="2979" HEIGHT="105" BASELINE="1155 1405 4134 1405">
            <Shape>
              <Polygon POINTS="1155 1301 4134 1301 4134 1406 1155 1406"/>
            </Shape>
            <String CONTENT="сиротка, покрытый струпьями, одѣтый въ лохмотья собачьей шкуры," HPOS="1155" VPOS="1301" WIDTH="2979" HEIGHT="105"/>
          </TextLine>
