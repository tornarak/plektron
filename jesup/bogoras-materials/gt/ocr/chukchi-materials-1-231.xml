        <TextBlock ID="text_1-231" HPOS="601" VPOS="574" WIDTH="3017" HEIGHT="5176">
          <TextLine ID="mz_1-231_l1" HPOS="601" VPOS="574" WIDTH="2999" HEIGHT="112" BASELINE="601 667 3600 667">
            <Shape>
              <Polygon POINTS="601 574 3600 574 3600 686 601 686"/>
            </Shape>
            <String CONTENT="II,61. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 175" HPOS="601" VPOS="574" WIDTH="2999" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-231_l2" HPOS="609" VPOS="759" WIDTH="2986" HEIGHT="121" BASELINE="609 879 3595 879">
            <Shape>
              <Polygon POINTS="609 759 3595 759 3595 880 609 880"/>
            </Shape>
            <String CONTENT="«Я», говоритъ, «тебя выучу!» Привела она двухъ бѣлыхъ оленей. «Вотъ»," HPOS="609" VPOS="759" WIDTH="2986" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-231_l3" HPOS="608" VPOS="911" WIDTH="2988" HEIGHT="93" BASELINE="608 1003 3596 1003">
            <Shape>
              <Polygon POINTS="608 911 3596 911 3596 1004 608 1004"/>
            </Shape>
            <String CONTENT="говоритъ, «пряговой олень, вотъ ремни; показала ему, какъ ѣздить; онъ" HPOS="608" VPOS="911" WIDTH="2988" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-231_l4" HPOS="610" VPOS="1034" WIDTH="2992" HEIGHT="97" BASELINE="610 1130 3602 1130">
            <Shape>
              <Polygon POINTS="610 1034 3602 1034 3602 1131 610 1131"/>
            </Shape>
            <String CONTENT="поѣхалъ и назадъ вернулся. «Очень хорошо», говоритъ; «прежде я пѣшкомъ" HPOS="610" VPOS="1034" WIDTH="2992" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-231_l5" HPOS="613" VPOS="1151" WIDTH="2986" HEIGHT="106" BASELINE="613 1252 3599 1252">
            <Shape>
              <Polygon POINTS="613 1151 3599 1151 3599 1257 613 1257"/>
            </Shape>
            <String CONTENT="ходилъ, а теперь онъ меня тащитъ; хочу, тихо ѣду, хочу — скоро». «Ну" HPOS="613" VPOS="1151" WIDTH="2986" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-231_l6" HPOS="610" VPOS="1285" WIDTH="2988" HEIGHT="97" BASELINE="610 1381 3598 1381">
            <Shape>
              <Polygon POINTS="610 1285 3598 1285 3598 1382 610 1382"/>
            </Shape>
            <String CONTENT="вотъ», говоритъ, «важенка: она будетъ тебѣ рождать оленей. Дай ре-" HPOS="610" VPOS="1285" WIDTH="2988" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-231_l7" HPOS="607" VPOS="1367" WIDTH="2990" HEIGHT="113" BASELINE="607 1479 3597 1479">
            <Shape>
              <Polygon POINTS="607 1367 3597 1367 3597 1480 607 1480"/>
            </Shape>
            <String CONTENT="бенка!» — «Не дамъ! Я не понимаю, какъ это она будетъ рождать оленей." HPOS="607" VPOS="1367" WIDTH="2990" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-231_l8" HPOS="612" VPOS="1526" WIDTH="2990" HEIGHT="105" BASELINE="612 1630 3602 1630">
            <Shape>
              <Polygon POINTS="612 1526 3602 1526 3602 1631 612 1631"/>
            </Shape>
            <String CONTENT="Развѣ только ты бы осталась со мной, ночуя, можетъ быть, ты мнѣ по-" HPOS="612" VPOS="1526" WIDTH="2990" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-231_l9" HPOS="619" VPOS="1655" WIDTH="2986" HEIGHT="97" BASELINE="619 1751 3605 1751">
            <Shape>
              <Polygon POINTS="619 1655 3605 1655 3605 1752 619 1752"/>
            </Shape>
            <String CONTENT="кажешь, какъ это она принесетъ теленка». — «Ночевать я не стану, а къ" HPOS="619" VPOS="1655" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-231_l10" HPOS="619" VPOS="1776" WIDTH="2984" HEIGHT="102" BASELINE="619 1877 3603 1877">
            <Shape>
              <Polygon POINTS="619 1776 3603 1776 3603 1878 619 1878"/>
            </Shape>
            <String CONTENT="утру самъ увидишь». Ушла; а они спать легли. На утро сестра будитъ" HPOS="619" VPOS="1776" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-231_l11" HPOS="618" VPOS="1914" WIDTH="2987" HEIGHT="93" BASELINE="618 2007 3605 2007">
            <Shape>
              <Polygon POINTS="618 1914 3605 1914 3605 2007 618 2007"/>
            </Shape>
            <String CONTENT="брата. «Вставай», говоритъ, «у насъ дѣйствительно олень прибавился: три" HPOS="618" VPOS="1914" WIDTH="2987" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-231_l12" HPOS="618" VPOS="2032" WIDTH="2982" HEIGHT="102" BASELINE="618 2133 3600 2133">
            <Shape>
              <Polygon POINTS="618 2032 3600 2032 3600 2134 618 2134"/>
            </Shape>
            <String CONTENT="стало, только третій маленькій». Женщина приходитъ опять. «Вотъ теперь" HPOS="618" VPOS="2032" WIDTH="2982" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-231_l13" HPOS="617" VPOS="2122" WIDTH="2987" HEIGHT="136" BASELINE="617 2258 3604 2258">
            <Shape>
              <Polygon POINTS="617 2122 3604 2122 3604 2258 617 2258"/>
            </Shape>
            <String CONTENT="ты увидѣлъ самъ. Отдай ребенка!» — «Нѣтъ», говоритъ, «ты сперва скажи," HPOS="617" VPOS="2122" WIDTH="2987" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-231_l14" HPOS="623" VPOS="2286" WIDTH="2979" HEIGHT="99" BASELINE="623 2384 3602 2384">
            <Shape>
              <Polygon POINTS="623 2286 3602 2286 3602 2385 623 2385"/>
            </Shape>
            <String CONTENT="что ты у меня не отнимешь того, что дала, и оленей не уведешь». Сказала," HPOS="623" VPOS="2286" WIDTH="2979" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-231_l15" HPOS="621" VPOS="2408" WIDTH="2981" HEIGHT="97" BASELINE="621 2504 3602 2504">
            <Shape>
              <Polygon POINTS="621 2408 3602 2408 3602 2505 621 2505"/>
            </Shape>
            <String CONTENT="что не отниметъ у него оленей и имущества. Отдалъ ей ребенка. Отъ тѣхъ" HPOS="621" VPOS="2408" WIDTH="2981" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-231_l16" HPOS="621" VPOS="2540" WIDTH="1445" HEIGHT="94" BASELINE="621 2634 2066 2634">
            <Shape>
              <Polygon POINTS="621 2540 2066 2540 2066 2634 621 2634"/>
            </Shape>
            <String CONTENT="оленей размножились олени у людей." HPOS="621" VPOS="2540" WIDTH="1445" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-231_l17" HPOS="829" VPOS="2704" WIDTH="1184" HEIGHT="96" BASELINE="829 2800 2013 2800">
            <Shape>
              <Polygon POINTS="829 2704 2013 2704 2013 2800 829 2800"/>
            </Shape>
            <String CONTENT="Записано отъ чукчанки Ӈэ́ўс̧ӄӓт." HPOS="829" VPOS="2704" WIDTH="1184" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-231_l18" HPOS="2050" VPOS="3026" WIDTH="113" HEIGHT="94" BASELINE="2050 3119 2163 3119">
            <Shape>
              <Polygon POINTS="2050 3026 2163 3026 2163 3120 2050 3120"/>
            </Shape>
            <String CONTENT="61." HPOS="2050" VPOS="3026" WIDTH="113" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-231_l19" HPOS="1600" VPOS="3202" WIDTH="972" HEIGHT="107" BASELINE="1600 3308 2572 3308">
            <Shape>
              <Polygon POINTS="1600 3202 2572 3202 2572 3309 1600 3309"/>
            </Shape>
            <String CONTENT="Тот-төмwа́ткен пы́ӈыl." HPOS="1600" VPOS="3202" WIDTH="972" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-231_l20" HPOS="2619" VPOS="3261" WIDTH="13" HEIGHT="48" BASELINE="2619 3308 2632 3308">
            <Shape>
              <Polygon POINTS="2619 3261 2632 3261 2632 3309 2619 3309"/>
            </Shape>
            <String CONTENT="" HPOS="2619" VPOS="3261" WIDTH="13" HEIGHT="48"/>
          </TextLine>
          <TextLine ID="mz_1-231_l21" HPOS="838" VPOS="3408" WIDTH="2766" HEIGHT="104" BASELINE="838 3511 3604 3511">
            <Shape>
              <Polygon POINTS="838 3408 3604 3408 3604 3512 838 3512"/>
            </Shape>
            <String CONTENT="Былъ человѣкъ съ сестрой. Оленей у нихъ не было. Этотъ человѣкъ" HPOS="838" VPOS="3408" WIDTH="2766" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-231_l22" HPOS="625" VPOS="3538" WIDTH="2976" HEIGHT="101" BASELINE="625 3639 3601 3639">
            <Shape>
              <Polygon POINTS="625 3538 3601 3538 3601 3639 625 3639"/>
            </Shape>
            <String CONTENT="съ утра до вечера спалъ, ѣды у него не было, а ѣлъ онъ землю и камни." HPOS="625" VPOS="3538" WIDTH="2976" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-231_l23" HPOS="622" VPOS="3655" WIDTH="2986" HEIGHT="107" BASELINE="622 3761 3608 3761">
            <Shape>
              <Polygon POINTS="622 3655 3608 3655 3608 3762 622 3762"/>
            </Shape>
            <String CONTENT="Черный камень у него — мясо, бѣлый камень вмѣсто жиру; поѣстъ и опять" HPOS="622" VPOS="3655" WIDTH="2986" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-231_l24" HPOS="630" VPOS="3762" WIDTH="2966" HEIGHT="123" BASELINE="630 3885 3596 3885">
            <Shape>
              <Polygon POINTS="630 3762 3596 3762 3596 3885 630 3885"/>
            </Shape>
            <String CONTENT="спитъ. Вотъ сестра ему говоритъ: «Почему ты все спишь? Вотъ я пойду —" HPOS="630" VPOS="3762" WIDTH="2966" HEIGHT="123"/>
          </TextLine>
          <TextLine ID="mz_1-231_l25" HPOS="629" VPOS="3906" WIDTH="2972" HEIGHT="100" BASELINE="629 4006 3601 4006">
            <Shape>
              <Polygon POINTS="629 3906 3601 3906 3601 4006 629 4006"/>
            </Shape>
            <String CONTENT="найду тебѣ жену!» — «Гдѣ ты мнѣ достанешь жену? Людей нигдѣ нѣтъ." HPOS="629" VPOS="3906" WIDTH="2972" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-231_l26" HPOS="624" VPOS="4011" WIDTH="2982" HEIGHT="123" BASELINE="624 4133 3606 4133">
            <Shape>
              <Polygon POINTS="624 4011 3606 4011 3606 4134 624 4134"/>
            </Shape>
            <String CONTENT="И на что мнѣ жена?» — «Нѣтъ», говоритъ, «я пойду; довольно, перестань" HPOS="624" VPOS="4011" WIDTH="2982" HEIGHT="123"/>
          </TextLine>
          <TextLine ID="mz_1-231_l27" HPOS="627" VPOS="4160" WIDTH="2981" HEIGHT="100" BASELINE="627 4259 3608 4259">
            <Shape>
              <Polygon POINTS="627 4160 3608 4160 3608 4260 627 4260"/>
            </Shape>
            <String CONTENT="спать!» Пошла и нашла, приходитъ къ нему, говоритъ: «Пойди, приведи" HPOS="627" VPOS="4160" WIDTH="2981" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-231_l28" HPOS="629" VPOS="4278" WIDTH="2974" HEIGHT="103" BASELINE="629 4380 3603 4380">
            <Shape>
              <Polygon POINTS="629 4278 3603 4278 3603 4381 629 4381"/>
            </Shape>
            <String CONTENT="сюда жену!» Пошелъ и привелъ; стали жить трое. Стали жить, стали со-" HPOS="629" VPOS="4278" WIDTH="2974" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-231_l29" HPOS="624" VPOS="4406" WIDTH="2983" HEIGHT="102" BASELINE="624 4508 3607 4508">
            <Shape>
              <Polygon POINTS="624 4406 3607 4406 3607 4508 624 4508"/>
            </Shape>
            <String CONTENT="вѣтоваться. Пищи у нихъ нѣтъ; сосѣдей нѣтъ, одно жительство. Гово-" HPOS="624" VPOS="4406" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-231_l30" HPOS="625" VPOS="4534" WIDTH="2985" HEIGHT="95" BASELINE="625 4629 3610 4629">
            <Shape>
              <Polygon POINTS="625 4534 3610 4534 3610 4629 625 4629"/>
            </Shape>
            <String CONTENT="ритъ ему сестра: «Пойди на озеро; тамъ въ водѣ пасется стадо дикихъ" HPOS="625" VPOS="4534" WIDTH="2985" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-231_l31" HPOS="630" VPOS="4659" WIDTH="2976" HEIGHT="96" BASELINE="630 4755 3606 4755">
            <Shape>
              <Polygon POINTS="630 4659 3606 4659 3606 4755 630 4755"/>
            </Shape>
            <String CONTENT="оленей, приведи его сюда!» Сдѣлала ему оленя такого большаго да тяже-" HPOS="630" VPOS="4659" WIDTH="2976" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-231_l32" HPOS="627" VPOS="4772" WIDTH="2979" HEIGHT="107" BASELINE="627 4878 3606 4878">
            <Shape>
              <Polygon POINTS="627 4772 3606 4772 3606 4879 627 4879"/>
            </Shape>
            <String CONTENT="лаго, что онъ въ землю увязалъ по колѣно. «На этомъ оленѣ пойди», гово-" HPOS="627" VPOS="4772" WIDTH="2979" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-231_l33" HPOS="629" VPOS="4908" WIDTH="2975" HEIGHT="97" BASELINE="629 5005 3604 5005">
            <Shape>
              <Polygon POINTS="629 4908 3604 4908 3604 5005 629 5005"/>
            </Shape>
            <String CONTENT="ритъ, «дойдешь до озера, тамъ кругомъ трава, ее рви и бросай на землю," HPOS="629" VPOS="4908" WIDTH="2975" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-231_l34" HPOS="631" VPOS="5024" WIDTH="2979" HEIGHT="103" BASELINE="631 5127 3610 5127">
            <Shape>
              <Polygon POINTS="631 5024 3610 5024 3610 5127 631 5127"/>
            </Shape>
            <String CONTENT="станутъ тебѣ люди!» Пошелъ онъ, сталъ у озера рвать траву, стали ему" HPOS="631" VPOS="5024" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-231_l35" HPOS="631" VPOS="5152" WIDTH="2980" HEIGHT="92" BASELINE="631 5243 3611 5243">
            <Shape>
              <Polygon POINTS="631 5152 3611 5152 3611 5244 631 5244"/>
            </Shape>
            <String CONTENT="люди; а въ озерѣ подъ водою дѣйствительно ходитъ стадо дикихъ оленей." HPOS="631" VPOS="5152" WIDTH="2980" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-231_l36" HPOS="629" VPOS="5278" WIDTH="2985" HEIGHT="98" BASELINE="629 5375 3614 5375">
            <Shape>
              <Polygon POINTS="629 5278 3614 5278 3614 5376 629 5376"/>
            </Shape>
            <String CONTENT="Погналъ онъ этихъ людей въ озеро, выгнали ему стадо на берегъ, а дикіе" HPOS="629" VPOS="5278" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-231_l37" HPOS="633" VPOS="5402" WIDTH="2980" HEIGHT="100" BASELINE="633 5501 3613 5501">
            <Shape>
              <Polygon POINTS="633 5402 3613 5402 3613 5502 633 5502"/>
            </Shape>
            <String CONTENT="олени обступили ихъ большаго быка и назадъ не идутъ. Стали они его" HPOS="633" VPOS="5402" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-231_l38" HPOS="632" VPOS="5488" WIDTH="2984" HEIGHT="136" BASELINE="632 5624 3616 5624">
            <Shape>
              <Polygon POINTS="632 5488 3616 5488 3616 5624 632 5624"/>
            </Shape>
            <String CONTENT="драть, чтобы онъ велъ домой стадо. Долго драли, — сталъ вязнуть только" HPOS="632" VPOS="5488" WIDTH="2984" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-231_l39" HPOS="641" VPOS="5608" WIDTH="2977" HEIGHT="142" BASELINE="641 5750 3618 5750">
            <Shape>
              <Polygon POINTS="641 5608 3618 5608 3618 5750 641 5750"/>
            </Shape>
            <String CONTENT="по щиколотку; еще стали драть, — копытами по землѣ пошелъ. Привелъ" HPOS="641" VPOS="5608" WIDTH="2977" HEIGHT="142"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
