        <TextBlock ID="text_1-386" HPOS="1178" VPOS="610" WIDTH="3017" HEIGHT="5173">
          <TextLine ID="mz_1-386_l1" HPOS="1185" VPOS="610" WIDTH="2996" HEIGHT="109" BASELINE="1185 710 4181 710">
            <Shape>
              <Polygon POINTS="1185 610 4181 610 4181 719 1185 719"/>
            </Shape>
            <String CONTENT="330 В. Г. БОГОРАЗЪ, II,126." HPOS="1185" VPOS="610" WIDTH="2996" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-386_l2" HPOS="1198" VPOS="824" WIDTH="2988" HEIGHT="105" BASELINE="1198 928 4186 928">
            <Shape>
              <Polygon POINTS="1198 824 4186 824 4186 929 1198 929"/>
            </Shape>
            <String CONTENT="сказалъ ей: «Прильни къ небу!» Она прильнула къ небу. По ниткѣ поднялся" HPOS="1198" VPOS="824" WIDTH="2988" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-386_l3" HPOS="1195" VPOS="925" WIDTH="3000" HEIGHT="111" BASELINE="1195 1035 4195 1035">
            <Shape>
              <Polygon POINTS="1195 925 4195 925 4195 1036 1195 1036"/>
            </Shape>
            <String CONTENT="вверхъ, дошелъ до передняго жительства. Говорятъ: «Ты зачѣмъ?» — «За" HPOS="1195" VPOS="925" WIDTH="3000" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-386_l4" HPOS="1194" VPOS="1041" WIDTH="2989" HEIGHT="144" BASELINE="1194 1185 4183 1185">
            <Shape>
              <Polygon POINTS="1194 1041 4183 1041 4183 1185 1194 1185"/>
            </Shape>
            <String CONTENT="судномъ На́рђынен’а.» — «Ну, такъ иди дальше!» Пошелъ дальше. Дошелъ" HPOS="1194" VPOS="1041" WIDTH="2989" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-386_l5" HPOS="1192" VPOS="1206" WIDTH="2994" HEIGHT="103" BASELINE="1192 1308 4186 1308">
            <Shape>
              <Polygon POINTS="1192 1206 4186 1206 4186 1309 1192 1309"/>
            </Shape>
            <String CONTENT="до второй межи. Тамъ жилъ духъ, поглощавшій путниковъ, его миновалъ" HPOS="1192" VPOS="1206" WIDTH="2994" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-386_l6" HPOS="1197" VPOS="1329" WIDTH="2988" HEIGHT="103" BASELINE="1197 1431 4185 1431">
            <Shape>
              <Polygon POINTS="1197 1329 4185 1329 4185 1432 1197 1432"/>
            </Shape>
            <String CONTENT="ночью. Пошелъ дальше. Лежитъ поперекъ дороги пестробокая¹); хотѣлъ" HPOS="1197" VPOS="1329" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-386_l7" HPOS="1195" VPOS="1460" WIDTH="2988" HEIGHT="98" BASELINE="1195 1557 4183 1557">
            <Shape>
              <Polygon POINTS="1195 1460 4183 1460 4183 1558 1195 1558"/>
            </Shape>
            <String CONTENT="обойти, а она удлиняется; онъ разбѣжался и перескочилъ черезъ нее." HPOS="1195" VPOS="1460" WIDTH="2988" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-386_l8" HPOS="1184" VPOS="1583" WIDTH="3004" HEIGHT="104" BASELINE="1184 1686 4188 1686">
            <Shape>
              <Polygon POINTS="1184 1583 4188 1583 4188 1687 1184 1687"/>
            </Shape>
            <String CONTENT="Пошелъ дальше. Поперекъ дороги лежитъ мохнатка²). Хотѣлъ обойти и не" HPOS="1184" VPOS="1583" WIDTH="3004" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-386_l9" HPOS="1185" VPOS="1715" WIDTH="2994" HEIGHT="98" BASELINE="1185 1812 4179 1812">
            <Shape>
              <Polygon POINTS="1185 1715 4179 1715 4179 1813 1185 1813"/>
            </Shape>
            <String CONTENT="могъ, ибо она удлинилась. Тогда разбѣжалси и перескочилъ черезъ нее." HPOS="1185" VPOS="1715" WIDTH="2994" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-386_l10" HPOS="1185" VPOS="1775" WIDTH="3002" HEIGHT="144" BASELINE="1185 1918 4187 1918">
            <Shape>
              <Polygon POINTS="1185 1775 4187 1775 4187 1919 1185 1919"/>
            </Shape>
            <String CONTENT="Пришелъ къ На́рђынен’у. «Кто ты?» — «Я нижней земли человѣкъ.» —" HPOS="1185" VPOS="1775" WIDTH="3002" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-386_l11" HPOS="1189" VPOS="1922" WIDTH="2994" HEIGHT="144" BASELINE="1189 2065 4183 2065">
            <Shape>
              <Polygon POINTS="1189 1922 4183 1922 4183 2066 1189 2066"/>
            </Shape>
            <String CONTENT="«Зачѣмъ ты?» — «За твоимъ судномъ.» На́рђынен живетъ въ шатрѣ изъ" HPOS="1189" VPOS="1922" WIDTH="2994" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-386_l12" HPOS="1188" VPOS="2047" WIDTH="2995" HEIGHT="125" BASELINE="1188 2171 4183 2171">
            <Shape>
              <Polygon POINTS="1188 2047 4183 2047 4183 2172 1188 2172"/>
            </Shape>
            <String CONTENT="краснаго сукна, а пологъ у него стеклянный, — сквозь его стѣны онъ" HPOS="1188" VPOS="2047" WIDTH="2995" HEIGHT="125"/>
          </TextLine>
          <TextLine ID="mz_1-386_l13" HPOS="1185" VPOS="2211" WIDTH="2996" HEIGHT="104" BASELINE="1185 2315 4181 2315">
            <Shape>
              <Polygon POINTS="1185 2211 4181 2211 4181 2315 1185 2315"/>
            </Shape>
            <String CONTENT="смотритъ на все, что дѣлается на свѣтѣ. Онъ далъ ему судно, нагрузилъ" HPOS="1185" VPOS="2211" WIDTH="2996" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-386_l14" HPOS="1186" VPOS="2347" WIDTH="2994" HEIGHT="92" BASELINE="1186 2438 4180 2438">
            <Shape>
              <Polygon POINTS="1186 2347 4180 2347 4180 2439 1186 2439"/>
            </Shape>
            <String CONTENT="его ѣдой и всякими припасами: ремни свитками, лахтаки десятками, табакъ" HPOS="1186" VPOS="2347" WIDTH="2994" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-386_l15" HPOS="1185" VPOS="2456" WIDTH="2998" HEIGHT="110" BASELINE="1185 2565 4183 2565">
            <Shape>
              <Polygon POINTS="1185 2456 4183 2456 4183 2566 1185 2566"/>
            </Shape>
            <String CONTENT="сумами, чай побочнями³). На этомъ суднѣ скользнулъ внизъ, пришелъ въ" HPOS="1185" VPOS="2456" WIDTH="2998" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-386_l16" HPOS="1184" VPOS="2594" WIDTH="2801" HEIGHT="98" BASELINE="1184 2691 3985 2691">
            <Shape>
              <Polygon POINTS="1184 2594 3985 2594 3985 2692 1184 2692"/>
            </Shape>
            <String CONTENT="домъ отца невѣсты, женился на ней. Остальныхъ жениховъ прогнали." HPOS="1184" VPOS="2594" WIDTH="2801" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-386_l17" HPOS="1405" VPOS="2739" WIDTH="1743" HEIGHT="92" BASELINE="1405 2830 3148 2830">
            <Shape>
              <Polygon POINTS="1405 2739 3148 2739 3148 2831 1405 2831"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Чэ́ӈэ на Анюйской ярмаркѣ." HPOS="1405" VPOS="2739" WIDTH="1743" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-386_l18" HPOS="2588" VPOS="3089" WIDTH="181" HEIGHT="100" BASELINE="2588 3188 2769 3188">
            <Shape>
              <Polygon POINTS="2588 3089 2769 3089 2769 3189 2588 3189"/>
            </Shape>
            <String CONTENT="127." HPOS="2588" VPOS="3089" WIDTH="181" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-386_l19" HPOS="1831" VPOS="3282" WIDTH="1705" HEIGHT="112" BASELINE="1831 3394 3536 3394">
            <Shape>
              <Polygon POINTS="1831 3282 3536 3282 3536 3394 1831 3394"/>
            </Shape>
            <String CONTENT="Јако́нне-lѵ́мӈыl. О Јӓку́ннін’ѣ сказка." HPOS="1831" VPOS="3282" WIDTH="1705" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-386_l20" HPOS="1404" VPOS="3487" WIDTH="2779" HEIGHT="111" BASELINE="1404 3598 4183 3598">
            <Shape>
              <Polygon POINTS="1404 3487 4183 3487 4183 3598 1404 3598"/>
            </Shape>
            <String CONTENT="Была дѣвочка, имя Ђы́нкы-ӈэ́ўт. Собрались въ шатрѣ совершающіе" HPOS="1404" VPOS="3487" WIDTH="2779" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-386_l21" HPOS="1189" VPOS="3614" WIDTH="2990" HEIGHT="100" BASELINE="1189 3714 4179 3714">
            <Shape>
              <Polygon POINTS="1189 3614 4179 3614 4179 3714 1189 3714"/>
            </Shape>
            <String CONTENT="служеніе, закрыли дымовое отверстіе, поютъ, а между тѣмъ это собаки." HPOS="1189" VPOS="3614" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-386_l22" HPOS="1184" VPOS="3745" WIDTH="2996" HEIGHT="98" BASELINE="1184 3843 4180 3843">
            <Shape>
              <Polygon POINTS="1184 3745 4180 3745 4180 3843 1184 3843"/>
            </Shape>
            <String CONTENT="Одни поютъ: «кооо, кооо!» воютъ дружечки, другіе: «коон, коон, коон!»" HPOS="1184" VPOS="3745" WIDTH="2996" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-386_l23" HPOS="1187" VPOS="3868" WIDTH="2993" HEIGHT="103" BASELINE="1187 3970 4180 3970">
            <Shape>
              <Polygon POINTS="1187 3868 4180 3868 4180 3971 1187 3971"/>
            </Shape>
            <String CONTENT="третьи, стоящіе: «ооо, нооо⁴)!» Наконецъ хозяйка говоритъ дѣвушкѣ: «По-" HPOS="1187" VPOS="3868" WIDTH="2993" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-386_l24" HPOS="1184" VPOS="3997" WIDTH="2994" HEIGHT="100" BASELINE="1184 4096 4178 4096">
            <Shape>
              <Polygon POINTS="1184 3997 4178 3997 4178 4097 1184 4097"/>
            </Shape>
            <String CONTENT="смотри-ка что за поющіе, зачѣмъ они закрыли дверь и дымовое отвер-" HPOS="1184" VPOS="3997" WIDTH="2994" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-386_l25" HPOS="1180" VPOS="4119" WIDTH="3000" HEIGHT="104" BASELINE="1180 4223 4180 4223">
            <Shape>
              <Polygon POINTS="1180 4119 4180 4119 4180 4223 1180 4223"/>
            </Shape>
            <String CONTENT="стіе?» Нашла щель, заглянула. Все собаки воютъ. Люди прибѣжали и" HPOS="1180" VPOS="4119" WIDTH="3000" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-386_l26" HPOS="1185" VPOS="4250" WIDTH="2992" HEIGHT="102" BASELINE="1185 4351 4177 4351">
            <Shape>
              <Polygon POINTS="1185 4250 4177 4250 4177 4352 1185 4352"/>
            </Shape>
            <String CONTENT="стали колотить. Убѣжали собаки на западную сторону, стали русскимъ" HPOS="1185" VPOS="4250" WIDTH="2992" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-386_l27" HPOS="1178" VPOS="4379" WIDTH="2996" HEIGHT="100" BASELINE="1178 4478 4174 4478">
            <Shape>
              <Polygon POINTS="1178 4379 4174 4379 4174 4479 1178 4479"/>
            </Shape>
            <String CONTENT="народомъ. Часть осталась собаками, сдѣлалась ихъ упряжкой. Прежніе" HPOS="1178" VPOS="4379" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-386_l28" HPOS="1187" VPOS="4485" WIDTH="2986" HEIGHT="126" BASELINE="1187 4610 4173 4610">
            <Shape>
              <Polygon POINTS="1187 4485 4173 4485 4173 4611 1187 4611"/>
            </Shape>
            <String CONTENT="битые стали гнѣваться за удары, начали войну. «Ђу́к! Мы не знали! Наши" HPOS="1187" VPOS="4485" WIDTH="2986" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-386_l29" HPOS="1182" VPOS="4630" WIDTH="2991" HEIGHT="103" BASELINE="1182 4732 4173 4732">
            <Shape>
              <Polygon POINTS="1182 4630 4173 4630 4173 4733 1182 4733"/>
            </Shape>
            <String CONTENT="били собакъ, а онѣ стали народомъ!» Стали воевать. Пошелъ Јӓку́ннін," HPOS="1182" VPOS="4630" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-386_l30" HPOS="1408" VPOS="4820" WIDTH="1891" HEIGHT="119" BASELINE="1408 4938 3299 4938">
            <Shape>
              <Polygon POINTS="1408 4820 3299 4820 3299 4939 1408 4939"/>
            </Shape>
            <String CONTENT="1) Ђыто̀-каlе́lы — насѣкомое вродѣ Божьей коровки." HPOS="1408" VPOS="4820" WIDTH="1891" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-386_l31" HPOS="1398" VPOS="4929" WIDTH="995" HEIGHT="109" BASELINE="1398 5037 2393 5037">
            <Shape>
              <Polygon POINTS="1398 4929 2393 4929 2393 5038 1398 5038"/>
            </Shape>
            <String CONTENT="2) Ке́рђыlын — насѣкомое." HPOS="1398" VPOS="4929" WIDTH="995" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-386_l32" HPOS="1395" VPOS="5039" WIDTH="2202" HEIGHT="102" BASELINE="1395 5140 3597 5140">
            <Shape>
              <Polygon POINTS="1395 5039 3597 5039 3597 5141 1395 5141"/>
            </Shape>
            <String CONTENT="3) Емте́-ӄаl т. е. побочень (парный вьюкъ) вѣситъ три пуда." HPOS="1395" VPOS="5039" WIDTH="2202" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-386_l33" HPOS="1395" VPOS="5148" WIDTH="2778" HEIGHT="103" BASELINE="1395 5250 4173 5250">
            <Shape>
              <Polygon POINTS="1395 5148 4173 5148 4173 5251 1395 5251"/>
            </Shape>
            <String CONTENT="4) Здѣсь изображается праздникъ мӈе́ырђын, который будто-бы справляли" HPOS="1395" VPOS="5148" WIDTH="2778" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-386_l34" HPOS="1188" VPOS="5259" WIDTH="2986" HEIGHT="92" BASELINE="1188 5350 4174 5350">
            <Shape>
              <Polygon POINTS="1188 5259 4174 5259 4174 5351 1188 5351"/>
            </Shape>
            <String CONTENT="собаки. При этомъ праздникѣ совершается торжественное служеніе надъ добычею" HPOS="1188" VPOS="5259" WIDTH="2986" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-386_l35" HPOS="1183" VPOS="5369" WIDTH="2987" HEIGHT="93" BASELINE="1183 5461 4170 5461">
            <Shape>
              <Polygon POINTS="1183 5369 4170 5369 4170 5462 1183 5462"/>
            </Shape>
            <String CONTENT="охоты, причемъ мужчины шаманятъ, стуча въ бубенъ, а женщины становясь передъ" HPOS="1183" VPOS="5369" WIDTH="2987" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-386_l36" HPOS="1181" VPOS="5477" WIDTH="2985" HEIGHT="90" BASELINE="1181 5566 4166 5566">
            <Shape>
              <Polygon POINTS="1181 5477 4166 5477 4166 5567 1181 5567"/>
            </Shape>
            <String CONTENT="ними выражаютъ свой религіозный экстазъ различными странными тѣлодвиженіями" HPOS="1181" VPOS="5477" WIDTH="2985" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-386_l37" HPOS="1181" VPOS="5580" WIDTH="2985" HEIGHT="93" BASELINE="1181 5673 4166 5673">
            <Shape>
              <Polygon POINTS="1181 5580 4166 5580 4166 5673 1181 5673"/>
            </Shape>
            <String CONTENT="и пляской. Между прочимъ собакамъ, волкамъ и другимъ хищнымъ животнымъ при-" HPOS="1181" VPOS="5580" WIDTH="2985" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-386_l38" HPOS="1185" VPOS="5695" WIDTH="2436" HEIGHT="88" BASELINE="1185 5782 3621 5782">
            <Shape>
              <Polygon POINTS="1185 5695 3621 5695 3621 5783 1185 5783"/>
            </Shape>
            <String CONTENT="писывается также совершеніе такихъ служеній послѣ удачной охоты." HPOS="1185" VPOS="5695" WIDTH="2436" HEIGHT="88"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
