          <TextLine ID="mz_1-422_l4" HPOS="1364" VPOS="1502" WIDTH="2766" HEIGHT="103" BASELINE="1364 1604 4130 1604">
            <Shape>
              <Polygon POINTS="1364 1502 4130 1502 4130 1605 1364 1605"/>
            </Shape>
            <String CONTENT="Сирота ребенокъ, отца убили таньги, жилъ съ людьми. Пошли таньги" HPOS="1364" VPOS="1502" WIDTH="2766" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-422_l5" HPOS="1147" VPOS="1630" WIDTH="2981" HEIGHT="99" BASELINE="1147 1728 4128 1728">
            <Shape>
              <Polygon POINTS="1147 1630 4128 1630 4128 1729 1147 1729"/>
            </Shape>
            <String CONTENT="нападать на чукотское стойбище. Убѣгаетъ народъ: ѣдущіе на оленяхъ," HPOS="1147" VPOS="1630" WIDTH="2981" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l6" HPOS="1145" VPOS="1751" WIDTH="2990" HEIGHT="101" BASELINE="1145 1851 4135 1851">
            <Shape>
              <Polygon POINTS="1145 1751 4135 1751 4135 1852 1145 1852"/>
            </Shape>
            <String CONTENT="мальчикъ впереди идетъ пѣшкомъ. Догоняютъ передніе; говоритъ: «Гдѣ-же" HPOS="1145" VPOS="1751" WIDTH="2990" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-422_l7" HPOS="1145" VPOS="1880" WIDTH="2985" HEIGHT="103" BASELINE="1145 1982 4130 1982">
            <Shape>
              <Polygon POINTS="1145 1880 4130 1880 4130 1983 1145 1983"/>
            </Shape>
            <String CONTENT="я сяду?» Говорятъ: «Пусть у заднихъ!» Задніе проѣзжаютъ, говоритъ:" HPOS="1145" VPOS="1880" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-422_l8" HPOS="1149" VPOS="1999" WIDTH="2982" HEIGHT="105" BASELINE="1149 2103 4131 2103">
            <Shape>
              <Polygon POINTS="1149 1999 4131 1999 4131 2104 1149 2104"/>
            </Shape>
            <String CONTENT="«Гдѣ-же я сяду?» Говорятъ: «Пусть у заднихъ!» Догоняютъ самые задніе;" HPOS="1149" VPOS="1999" WIDTH="2982" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-422_l9" HPOS="1146" VPOS="2103" WIDTH="2986" HEIGHT="129" BASELINE="1146 2231 4132 2231">
            <Shape>
              <Polygon POINTS="1146 2103 4132 2103 4132 2232 1146 2232"/>
            </Shape>
            <String CONTENT="говоритъ: «Гдѣ-же я сяду?» — «Пусть у самыхъ послѣднихъ!» Наконецъ" HPOS="1146" VPOS="2103" WIDTH="2986" HEIGHT="129"/>
          </TextLine>
          <TextLine ID="mz_1-422_l10" HPOS="1145" VPOS="2220" WIDTH="2983" HEIGHT="138" BASELINE="1145 2357 4128 2357">
            <Shape>
              <Polygon POINTS="1145 2220 4128 2220 4128 2358 1145 2358"/>
            </Shape>
            <String CONTENT="остался одинъ ѣдущій. Говоритъ: «Пусть у тебя сяду!» — «Нѣтъ», гово-" HPOS="1145" VPOS="2220" WIDTH="2983" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-422_l11" HPOS="1145" VPOS="2335" WIDTH="2983" HEIGHT="147" BASELINE="1145 2481 4128 2481">
            <Shape>
              <Polygon POINTS="1145 2335 4128 2335 4128 2482 1145 2482"/>
            </Shape>
            <String CONTENT="ритъ, «пусть у заднихъ!» — «А́ны¹)! Вѣдь нѣтъ больше никого!» Тотъ угналъ" HPOS="1145" VPOS="2335" WIDTH="2983" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-422_l12" HPOS="1147" VPOS="2507" WIDTH="2977" HEIGHT="101" BASELINE="1147 2607 4124 2607">
            <Shape>
              <Polygon POINTS="1147 2507 4124 2507 4124 2608 1147 2608"/>
            </Shape>
            <String CONTENT="оленей, остался мальчикъ одинъ. Идетъ по слѣду ѣдущихъ. Маленькій маль-" HPOS="1147" VPOS="2507" WIDTH="2977" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-422_l13" HPOS="1143" VPOS="2634" WIDTH="2983" HEIGHT="102" BASELINE="1143 2735 4126 2735">
            <Shape>
              <Polygon POINTS="1143 2634 4126 2634 4126 2736 1143 2736"/>
            </Shape>
            <String CONTENT="чикъ, но умный. Держитъ въ рукахъ дѣтскій лукъ, стрѣла съ наконечни-" HPOS="1143" VPOS="2634" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-422_l14" HPOS="1143" VPOS="2760" WIDTH="2979" HEIGHT="99" BASELINE="1143 2859 4122 2859">
            <Shape>
              <Polygon POINTS="1143 2760 4122 2760 4122 2859 1143 2859"/>
            </Shape>
            <String CONTENT="комъ изъ красной мѣди. Идетъ по дорогѣ. Наѣзжаетъ сзади вереница тань-" HPOS="1143" VPOS="2760" WIDTH="2979" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l15" HPOS="1139" VPOS="2884" WIDTH="2990" HEIGHT="99" BASELINE="1139 2982 4129 2982">
            <Shape>
              <Polygon POINTS="1139 2884 4129 2884 4129 2983 1139 2983"/>
            </Shape>
            <String CONTENT="говъ. Впереди самый сильный воинъ. Оглянулся мальчикъ, хочетъ его" HPOS="1139" VPOS="2884" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l16" HPOS="1141" VPOS="3008" WIDTH="2988" HEIGHT="103" BASELINE="1141 3110 4129 3110">
            <Shape>
              <Polygon POINTS="1141 3008 4129 3008 4129 3111 1141 3111"/>
            </Shape>
            <String CONTENT="догнать. Думаетъ, что буду дѣлать. Бѣжитъ, падаетъ, встаетъ и опять" HPOS="1141" VPOS="3008" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-422_l17" HPOS="1142" VPOS="3140" WIDTH="2984" HEIGHT="100" BASELINE="1142 3239 4126 3239">
            <Shape>
              <Polygon POINTS="1142 3140 4126 3140 4126 3240 1142 3240"/>
            </Shape>
            <String CONTENT="бѣжитъ. Таньгинъ увидѣлъ бѣгущаго, всталъ съ нарты, снялъ панцырь," HPOS="1142" VPOS="3140" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-422_l18" HPOS="1143" VPOS="3264" WIDTH="2981" HEIGHT="95" BASELINE="1143 3358 4124 3358">
            <Shape>
              <Polygon POINTS="1143 3264 4124 3264 4124 3359 1143 3359"/>
            </Shape>
            <String CONTENT="положилъ на нарту, положилъ и копье. Копье толстое, ратовье толще руки." HPOS="1143" VPOS="3264" WIDTH="2981" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-422_l19" HPOS="1149" VPOS="3385" WIDTH="2983" HEIGHT="98" BASELINE="1149 3482 4132 3482">
            <Shape>
              <Polygon POINTS="1149 3385 4132 3385 4132 3483 1149 3483"/>
            </Shape>
            <String CONTENT="Бѣжитъ, ведя за собой оленей. Думаетъ мальчикъ: такой силачъ раздавитъ" HPOS="1149" VPOS="3385" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-422_l20" HPOS="1140" VPOS="3510" WIDTH="2983" HEIGHT="102" BASELINE="1140 3612 4123 3612">
            <Shape>
              <Polygon POINTS="1140 3510 4123 3510 4123 3612 1140 3612"/>
            </Shape>
            <String CONTENT="меня однимъ ногтемъ, какъ вошку. Бѣжитъ, спотыкается, опять бѣжитъ." HPOS="1140" VPOS="3510" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-422_l21" HPOS="1140" VPOS="3624" WIDTH="2985" HEIGHT="114" BASELINE="1140 3737 4125 3737">
            <Shape>
              <Polygon POINTS="1140 3624 4125 3624 4125 3738 1140 3738"/>
            </Shape>
            <String CONTENT="Оглянулся, еще ближе сталъ таньгинскій витязь, скоро догонитъ. У него" HPOS="1140" VPOS="3624" WIDTH="2985" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-422_l22" HPOS="1144" VPOS="3765" WIDTH="2979" HEIGHT="100" BASELINE="1144 3862 4123 3862">
            <Shape>
              <Polygon POINTS="1144 3765 4123 3765 4123 3865 1144 3865"/>
            </Shape>
            <String CONTENT="платье короткое, почти не покрываетъ живота; выстрѣлилъ изъ лука," HPOS="1144" VPOS="3765" WIDTH="2979" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-422_l23" HPOS="1144" VPOS="3887" WIDTH="2980" HEIGHT="102" BASELINE="1144 3989 4124 3989">
            <Shape>
              <Polygon POINTS="1144 3887 4124 3887 4124 3989 1144 3989"/>
            </Shape>
            <String CONTENT="попалъ ему въ брюхо. Сѣлъ на землю богатырь. «Стой, мальчикъ!» гово-" HPOS="1144" VPOS="3887" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-422_l24" HPOS="1141" VPOS="4016" WIDTH="2986" HEIGHT="97" BASELINE="1141 4112 4127 4112">
            <Shape>
              <Polygon POINTS="1141 4016 4127 4016 4127 4113 1141 4113"/>
            </Shape>
            <String CONTENT="ритъ ему богатырь. «Подойди сюда!» Боится, глядитъ издали. «Подойди" HPOS="1141" VPOS="4016" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-422_l25" HPOS="1140" VPOS="4140" WIDTH="2983" HEIGHT="99" BASELINE="1140 4238 4123 4238">
            <Shape>
              <Polygon POINTS="1140 4140 4123 4140 4123 4239 1140 4239"/>
            </Shape>
            <String CONTENT="сюда, не бойся! Теперь ничего тебѣ дѣлать не стану!» Мальчикъ боится." HPOS="1140" VPOS="4140" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l26" HPOS="1142" VPOS="4269" WIDTH="2990" HEIGHT="100" BASELINE="1142 4368 4132 4368">
            <Shape>
              <Polygon POINTS="1142 4269 4132 4269 4132 4369 1142 4369"/>
            </Shape>
            <String CONTENT="Всталъ таньгинъ, снялъ съ нарты копье, положилъ на землю; снялъ и" HPOS="1142" VPOS="4269" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-422_l27" HPOS="1140" VPOS="4381" WIDTH="2982" HEIGHT="107" BASELINE="1140 4487 4122 4487">
            <Shape>
              <Polygon POINTS="1140 4381 4122 4381 4122 4488 1140 4488"/>
            </Shape>
            <String CONTENT="панцырь и латы. Мальчикъ бросился бѣжать, но тотъ кричитъ: «Не бѣги," HPOS="1140" VPOS="4381" WIDTH="2982" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-422_l28" HPOS="1139" VPOS="4509" WIDTH="2985" HEIGHT="103" BASELINE="1139 4611 4124 4611">
            <Shape>
              <Polygon POINTS="1139 4509 4124 4509 4124 4612 1139 4612"/>
            </Shape>
            <String CONTENT="не бѣги! Тебѣ ничего не сдѣлаю. Лучше подойди сюда!» Подошелъ на-" HPOS="1139" VPOS="4509" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-422_l29" HPOS="1140" VPOS="4634" WIDTH="2986" HEIGHT="107" BASELINE="1140 4740 4126 4740">
            <Shape>
              <Polygon POINTS="1140 4634 4126 4634 4126 4741 1140 4741"/>
            </Shape>
            <String CONTENT="конецъ. «Ну, говоритъ, «вотъ копье, вотъ лукъ, вотъ вся сбруя. Надѣнь" HPOS="1140" VPOS="4634" WIDTH="2986" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-422_l30" HPOS="1135" VPOS="4768" WIDTH="2989" HEIGHT="99" BASELINE="1135 4866 4124 4866">
            <Shape>
              <Polygon POINTS="1135 4768 4124 4768 4124 4867 1135 4867"/>
            </Shape>
            <String CONTENT="на себя это все, сядь на нарту и поѣзжай! Станешь проѣзжать оленныхъ," HPOS="1135" VPOS="4768" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l31" HPOS="1137" VPOS="4892" WIDTH="2987" HEIGHT="99" BASELINE="1137 4990 4124 4990">
            <Shape>
              <Polygon POINTS="1137 4892 4124 4892 4124 4991 1137 4991"/>
            </Shape>
            <String CONTENT="станутъ они кричать: что за быки и откуда взялъ, не отвѣчай, проѣзжай" HPOS="1137" VPOS="4892" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-422_l32" HPOS="1135" VPOS="4995" WIDTH="2991" HEIGHT="118" BASELINE="1135 5112 4126 5112">
            <Shape>
              <Polygon POINTS="1135 4995 4126 4995 4126 5113 1135 5113"/>
            </Shape>
            <String CONTENT="прямо къ дядѣ!» А дядя у него жилъ впереди на жительствѣ. «А нашихъ," HPOS="1135" VPOS="4995" WIDTH="2991" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-422_l33" HPOS="1135" VPOS="5146" WIDTH="2989" HEIGHT="96" BASELINE="1135 5241 4124 5241">
            <Shape>
              <Polygon POINTS="1135 5146 4124 5146 4124 5242 1135 5242"/>
            </Shape>
            <String CONTENT="не бойся; ибо они какъ только доѣдутъ до моего трупа, то повернутъ" HPOS="1135" VPOS="5146" WIDTH="2989" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-422_l34" HPOS="1135" VPOS="5268" WIDTH="2995" HEIGHT="100" BASELINE="1135 5366 4130 5366">
            <Shape>
              <Polygon POINTS="1135 5268 4130 5268 4130 5368 1135 5368"/>
            </Shape>
            <String CONTENT="назадъ, ибо я самый сильный изо всѣхъ!» Дѣйствительно пришли таньги" HPOS="1135" VPOS="5268" WIDTH="2995" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-422_l35" HPOS="1135" VPOS="5400" WIDTH="2986" HEIGHT="97" BASELINE="1135 5496 4121 5496">
            <Shape>
              <Polygon POINTS="1135 5400 4121 5400 4121 5497 1135 5497"/>
            </Shape>
            <String CONTENT="къ убитому. «Ого», говорятъ, «вотъ кого отправили [на тотъ свѣтъ]²)!" HPOS="1135" VPOS="5400" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-422_l36" HPOS="1359" VPOS="5606" WIDTH="692" HEIGHT="84" BASELINE="1359 5690 2051 5690">
            <Shape>
              <Polygon POINTS="1359 5606 2051 5606 2051 5690 1359 5690"/>
            </Shape>
            <String CONTENT="1) Слово обращенія." HPOS="1359" VPOS="5606" WIDTH="692" HEIGHT="84"/>
          </TextLine>
          <TextLine ID="mz_1-422_l37" HPOS="1354" VPOS="5645" WIDTH="2004" HEIGHT="160" BASELINE="1354 5804 3358 5804">
            <Shape>
              <Polygon POINTS="1354 5645 3358 5645 3358 5805 1354 5805"/>
            </Shape>
            <String CONTENT="2) Ка́ко! ніўӄӓэт, — wотӄана́јӈын ѵм нэнэwкэ́wкӓ̂н." HPOS="1354" VPOS="5645" WIDTH="2004" HEIGHT="160"/>
          </TextLine>
