        <TextBlock ID="text_1-429" HPOS="555" VPOS="552" WIDTH="3008" HEIGHT="5227">
          <TextLine ID="mz_1-429_l1" HPOS="555" VPOS="552" WIDTH="2991" HEIGHT="111" BASELINE="555 641 3546 641">
            <Shape>
              <Polygon POINTS="555 552 3546 552 3546 663 555 663"/>
            </Shape>
            <String CONTENT="II,139. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 373" HPOS="555" VPOS="552" WIDTH="2991" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-429_l2" HPOS="559" VPOS="759" WIDTH="2995" HEIGHT="100" BASELINE="559 858 3554 858">
            <Shape>
              <Polygon POINTS="559 759 3554 759 3554 859 559 859"/>
            </Shape>
            <String CONTENT="Принесли десять моржей, одного за другимъ съѣдаютъ они вдвоемъ, гость" HPOS="559" VPOS="759" WIDTH="2995" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-429_l3" HPOS="560" VPOS="868" WIDTH="2990" HEIGHT="116" BASELINE="560 983 3550 983">
            <Shape>
              <Polygon POINTS="560 868 3550 868 3550 984 560 984"/>
            </Shape>
            <String CONTENT="и хозяинъ. Съѣли всѣхъ десять. «А что, еще немножко?» говоритъ Одѣтый" HPOS="560" VPOS="868" WIDTH="2990" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-429_l4" HPOS="565" VPOS="965" WIDTH="2989" HEIGHT="130" BASELINE="565 1094 3554 1094">
            <Shape>
              <Polygon POINTS="565 965 3554 965 3554 1095 565 1095"/>
            </Shape>
            <String CONTENT="въ дѣтское платье. «Внесите китовый хвостъ!» Съѣли хвостъ. «А что?» —" HPOS="565" VPOS="965" WIDTH="2989" HEIGHT="130"/>
          </TextLine>
          <TextLine ID="mz_1-429_l5" HPOS="565" VPOS="1127" WIDTH="2983" HEIGHT="104" BASELINE="565 1231 3548 1231">
            <Shape>
              <Polygon POINTS="565 1127 3548 1127 3548 1231 565 1231"/>
            </Shape>
            <String CONTENT="«Твой умъ, конечно, а мнѣ-бы еще немножко!» — «Внесите китовое звено!»" HPOS="565" VPOS="1127" WIDTH="2983" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-429_l6" HPOS="560" VPOS="1240" WIDTH="2993" HEIGHT="122" BASELINE="560 1362 3553 1362">
            <Shape>
              <Polygon POINTS="560 1240 3553 1240 3553 1362 560 1362"/>
            </Shape>
            <String CONTENT="Внесли. Поѣлъ немного хозяинъ, говоритъ: «Мнѣ довольно.» — «А я это" HPOS="560" VPOS="1240" WIDTH="2993" HEIGHT="122"/>
          </TextLine>
          <TextLine ID="mz_1-429_l7" HPOS="558" VPOS="1387" WIDTH="2996" HEIGHT="100" BASELINE="558 1487 3554 1487">
            <Shape>
              <Polygon POINTS="558 1387 3554 1387 3554 1487 558 1487"/>
            </Shape>
            <String CONTENT="доѣмъ!» говоритъ Одѣтый въ дѣтское платье. Доѣлъ. Потупился, задумался" HPOS="558" VPOS="1387" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-429_l8" HPOS="559" VPOS="1503" WIDTH="2989" HEIGHT="109" BASELINE="559 1612 3548 1612">
            <Shape>
              <Polygon POINTS="559 1503 3548 1503 3548 1612 559 1612"/>
            </Shape>
            <String CONTENT="хозяинъ. «Ну чтожъ», говоритъ, «ты вѣдь за моей женой пришелъ? Давай" HPOS="559" VPOS="1503" WIDTH="2989" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-429_l9" HPOS="565" VPOS="1638" WIDTH="2990" HEIGHT="101" BASELINE="565 1738 3555 1738">
            <Shape>
              <Polygon POINTS="565 1638 3555 1638 3555 1739 565 1739"/>
            </Shape>
            <String CONTENT="бороться!» Принесли моржовую шкуру, утыкали ее ножами по краю, стали" HPOS="565" VPOS="1638" WIDTH="2990" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-429_l10" HPOS="568" VPOS="1725" WIDTH="2985" HEIGHT="136" BASELINE="568 1861 3553 1861">
            <Shape>
              <Polygon POINTS="568 1725 3553 1725 3553 1861 568 1861"/>
            </Shape>
            <String CONTENT="по срединѣ. Сперва схватился хозяинъ, — не можетъ сдвинуть съ мѣста" HPOS="568" VPOS="1725" WIDTH="2985" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-429_l11" HPOS="565" VPOS="1887" WIDTH="2984" HEIGHT="99" BASELINE="565 1986 3549 1986">
            <Shape>
              <Polygon POINTS="565 1887 3549 1887 3549 1986 565 1986"/>
            </Shape>
            <String CONTENT="Одѣтаго въ дѣтское платье. Тотъ твердъ какъ камень. Потомъ схватился" HPOS="565" VPOS="1887" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-429_l12" HPOS="574" VPOS="2016" WIDTH="2984" HEIGHT="101" BASELINE="574 2117 3558 2117">
            <Shape>
              <Polygon POINTS="574 2016 3558 2016 3558 2117 574 2117"/>
            </Shape>
            <String CONTENT="Одѣтый въ дѣтсткое платье, кинулъ хозяина объ землю и убилъ его на" HPOS="574" VPOS="2016" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-429_l13" HPOS="571" VPOS="2143" WIDTH="2980" HEIGHT="99" BASELINE="571 2242 3551 2242">
            <Shape>
              <Polygon POINTS="571 2143 3551 2143 3551 2242 571 2242"/>
            </Shape>
            <String CONTENT="пожахъ. Всѣ сосѣди обрадовались, жалѣя своихъ дѣтей. «Теперь», говорятъ," HPOS="571" VPOS="2143" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-429_l14" HPOS="574" VPOS="2270" WIDTH="2976" HEIGHT="97" BASELINE="574 2367 3550 2367">
            <Shape>
              <Polygon POINTS="574 2270 3550 2270 3550 2367 574 2367"/>
            </Shape>
            <String CONTENT="«потомки наши начнутъ выростать!» Потомъ забралъ жену начальника," HPOS="574" VPOS="2270" WIDTH="2976" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-429_l15" HPOS="570" VPOS="2398" WIDTH="2991" HEIGHT="98" BASELINE="570 2496 3561 2496">
            <Shape>
              <Polygon POINTS="570 2398 3561 2398 3561 2496 570 2496"/>
            </Shape>
            <String CONTENT="всѣмъ товарищамъ взялъ по судну, нагрузилъ всѣмъ добромъ и уѣхали" HPOS="570" VPOS="2398" WIDTH="2991" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-429_l16" HPOS="565" VPOS="2521" WIDTH="239" HEIGHT="86" BASELINE="565 2607 804 2607">
            <Shape>
              <Polygon POINTS="565 2521 804 2521 804 2607 565 2607"/>
            </Shape>
            <String CONTENT="домой." HPOS="565" VPOS="2521" WIDTH="239" HEIGHT="86"/>
          </TextLine>
          <TextLine ID="mz_1-429_l17" HPOS="778" VPOS="2692" WIDTH="1818" HEIGHT="99" BASELINE="778 2790 2596 2790">
            <Shape>
              <Polygon POINTS="778 2692 2596 2692 2596 2791 778 2791"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи А́јван’а на урочищѣ Акона́јке." HPOS="778" VPOS="2692" WIDTH="1818" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-429_l18" HPOS="1965" VPOS="3054" WIDTH="174" HEIGHT="101" BASELINE="1965 3154 2139 3154">
            <Shape>
              <Polygon POINTS="1965 3054 2139 3054 2139 3155 1965 3155"/>
            </Shape>
            <String CONTENT="140" HPOS="1965" VPOS="3054" WIDTH="174" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-429_l19" HPOS="1208" VPOS="3327" WIDTH="1703" HEIGHT="121" BASELINE="1208 3447 2911 3447">
            <Shape>
              <Polygon POINTS="1208 3327 2911 3327 2911 3448 1208 3448"/>
            </Shape>
            <String CONTENT="Э́рмэчын ты́мјо. Насильникъ убитый." HPOS="1208" VPOS="3327" WIDTH="1703" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-429_l20" HPOS="778" VPOS="3556" WIDTH="2779" HEIGHT="103" BASELINE="778 3658 3557 3658">
            <Shape>
              <Polygon POINTS="778 3556 3557 3556 3557 3659 778 3659"/>
            </Shape>
            <String CONTENT="Морской (житель) силачъ¹), многихъ сосѣдей рядомъ жилища; большое" HPOS="778" VPOS="3556" WIDTH="2779" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-429_l21" HPOS="565" VPOS="3684" WIDTH="2989" HEIGHT="100" BASELINE="565 3783 3554 3783">
            <Shape>
              <Polygon POINTS="565 3684 3554 3684 3554 3784 565 3784"/>
            </Shape>
            <String CONTENT="жительство, а онъ (живетъ) особо. Постоянно сосѣди за тюленями ходятъ," HPOS="565" VPOS="3684" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-429_l22" HPOS="565" VPOS="3806" WIDTH="2991" HEIGHT="104" BASELINE="565 3909 3556 3909">
            <Shape>
              <Polygon POINTS="565 3806 3556 3806 3556 3910 565 3910"/>
            </Shape>
            <String CONTENT="удаляются. Постоянно возвращаются, а силачъ отнимаетъ у нихъ. Самъ-же" HPOS="565" VPOS="3806" WIDTH="2991" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-429_l23" HPOS="569" VPOS="3930" WIDTH="2988" HEIGHT="106" BASELINE="569 4036 3557 4036">
            <Shape>
              <Polygon POINTS="569 3930 3557 3930 3557 4036 569 4036"/>
            </Shape>
            <String CONTENT="недвижно пребываетъ. Одна у него собака, величиной съ быка. Въ одинъ" HPOS="569" VPOS="3930" WIDTH="2988" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-429_l24" HPOS="564" VPOS="4060" WIDTH="2989" HEIGHT="100" BASELINE="564 4159 3553 4159">
            <Shape>
              <Polygon POINTS="564 4060 3553 4060 3553 4160 564 4160"/>
            </Shape>
            <String CONTENT="день отнимаетъ двадцать, шестьдесять, сто тюленей. Всѣ тѣ люди говорятъ:" HPOS="564" VPOS="4060" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-429_l25" HPOS="568" VPOS="4164" WIDTH="2986" HEIGHT="121" BASELINE="568 4284 3554 4284">
            <Shape>
              <Polygon POINTS="568 4164 3554 4164 3554 4285 568 4285"/>
            </Shape>
            <String CONTENT="«О, вѣдь мы изсохнемъ!» У силача двѣ жены, двоеженецъ. Одна брюхатая." HPOS="568" VPOS="4164" WIDTH="2986" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-429_l26" HPOS="565" VPOS="4302" WIDTH="2996" HEIGHT="106" BASELINE="565 4408 3561 4408">
            <Shape>
              <Polygon POINTS="565 4302 3561 4302 3561 4408 565 4408"/>
            </Shape>
            <String CONTENT="Эти многіе люди сказали: «Два дня половимъ сѣтями, вѣдь мы изсохнуть" HPOS="565" VPOS="4302" WIDTH="2996" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-429_l27" HPOS="564" VPOS="4435" WIDTH="2999" HEIGHT="98" BASELINE="564 4533 3563 4533">
            <Shape>
              <Polygon POINTS="564 4435 3563 4435 3563 4533 564 4533"/>
            </Shape>
            <String CONTENT="хотимъ!» Одинъ на собакахъ ѣдущій²) вернулся, десять тюленей увезъ, не" HPOS="564" VPOS="4435" WIDTH="2999" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-429_l28" HPOS="561" VPOS="4539" WIDTH="2873" HEIGHT="116" BASELINE="561 4655 3434 4655">
            <Shape>
              <Polygon POINTS="561 4539 3434 4539 3434 4655 561 4655"/>
            </Shape>
            <String CONTENT="можетъ (вести). Снова на встрѣчу силачъ пошелъ. Говоритъ: «А что?» —" HPOS="561" VPOS="4539" WIDTH="2873" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-429_l29" HPOS="570" VPOS="4676" WIDTH="2985" HEIGHT="107" BASELINE="570 4782 3555 4782">
            <Shape>
              <Polygon POINTS="570 4676 3555 4676 3555 4783 570 4783"/>
            </Shape>
            <String CONTENT="«О», говоритъ, «худо! Вѣдь всѣ хорошо добыли. Послали тебѣ сказать," HPOS="570" VPOS="4676" WIDTH="2985" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-429_l30" HPOS="566" VPOS="4802" WIDTH="2993" HEIGHT="103" BASELINE="566 4905 3559 4905">
            <Shape>
              <Polygon POINTS="566 4802 3559 4802 3559 4905 566 4905"/>
            </Shape>
            <String CONTENT="выйди на встрѣчу, а то валяются на морѣ (на льду) тюлени. Пусть ты" HPOS="566" VPOS="4802" WIDTH="2993" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-429_l31" HPOS="568" VPOS="4937" WIDTH="2993" HEIGHT="102" BASELINE="568 5038 3561 5038">
            <Shape>
              <Polygon POINTS="568 4937 3561 4937 3561 5039 568 5039"/>
            </Shape>
            <String CONTENT="пойдешь!» Говоритъ насильникъ: «Эђэ́ј! Твоихъ тюленей около моего дома" HPOS="568" VPOS="4937" WIDTH="2993" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-429_l32" HPOS="565" VPOS="5059" WIDTH="2998" HEIGHT="105" BASELINE="565 5163 3563 5163">
            <Shape>
              <Polygon POINTS="565 5059 3563 5059 3563 5164 565 5164"/>
            </Shape>
            <String CONTENT="оставь!» Другой говоритъ: «Эђэ́ј!» Ибо боится. Тамошніе люди, всѣ на" HPOS="565" VPOS="5059" WIDTH="2998" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-429_l33" HPOS="565" VPOS="5171" WIDTH="2990" HEIGHT="111" BASELINE="565 5281 3555 5281">
            <Shape>
              <Polygon POINTS="565 5171 3555 5171 3555 5282 565 5282"/>
            </Shape>
            <String CONTENT="морѣ бывшіе, говорятъ: «О, убьемъ его! Вѣдь мы изсохнемъ!» По старой" HPOS="565" VPOS="5171" WIDTH="2990" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-429_l34" HPOS="560" VPOS="5311" WIDTH="2996" HEIGHT="100" BASELINE="560 5410 3556 5410">
            <Shape>
              <Polygon POINTS="560 5311 3556 5311 3556 5411 560 5411"/>
            </Shape>
            <String CONTENT="дорогѣ идетъ силачъ. Собака, величиной съ быка, вмѣстѣ съ нимъ, его" HPOS="560" VPOS="5311" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
