            </Shape>
            <String CONTENT="менѣе другихъ чуждаются человѣка и нерѣдко даже доходятъ до того, что прибѣгаютъ" HPOS="630" VPOS="5054" WIDTH="2984" HEIGHT="83"/>
          </TextLine>
          <TextLine ID="mz_1-145_l42" HPOS="629" VPOS="5157" WIDTH="2986" HEIGHT="90" BASELINE="629 5246 3615 5246">
