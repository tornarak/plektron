            </Shape>
            <String CONTENT="или желѣзными молотками, придавая имъ форму га́тки. ӄо̀р-ачо́оlђын «мочепріем-" HPOS="629" VPOS="4728" WIDTH="2985" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-145_l39" HPOS="635" VPOS="4833" WIDTH="2981" HEIGHT="87" BASELINE="635 4920 3616 4920">
            <Shape>
              <Polygon POINTS="635 4833 3616 4833 3616 4920 635 4920"/>
            </Shape>
            <String CONTENT="никъ для оленей». Многіе (но не всѣ) олени любятъ мочу. Чукчи основали на этомъ" HPOS="635" VPOS="4833" WIDTH="2981" HEIGHT="87"/>
          </TextLine>
          <TextLine ID="mz_1-145_l40" HPOS="633" VPOS="4935" WIDTH="2984" HEIGHT="104" BASELINE="633 5038 3617 5038">
