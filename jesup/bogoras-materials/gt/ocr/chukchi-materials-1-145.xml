            </Shape>
            <String CONTENT="пить изъ рукъ. Это относится разумѣется къ упряжнымъ оленямъ, которыхъ чукчи" HPOS="629" VPOS="5157" WIDTH="2986" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-145_l43" HPOS="629" VPOS="5259" WIDTH="2986" HEIGHT="92" BASELINE="629 5350 3615 5350">
