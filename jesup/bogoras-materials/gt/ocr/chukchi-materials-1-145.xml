              <Polygon POINTS="629 5259 3615 5259 3615 5351 629 5351"/>
            </Shape>
            <String CONTENT="упорно стараются пріучать къ потребленію мочи съ перваго года упряжки. Каждый" HPOS="629" VPOS="5259" WIDTH="2986" HEIGHT="92"/>
          </TextLine>
