              <Polygon POINTS="625 4295 3601 4295 3601 4385 625 4385"/>
            </Shape>
            <String CONTENT="привозныхъ желѣзныхъ издѣлій. Однако чукчи сами не умѣютъ выковывать га́токъ," HPOS="625" VPOS="4295" WIDTH="2976" HEIGHT="90"/>
