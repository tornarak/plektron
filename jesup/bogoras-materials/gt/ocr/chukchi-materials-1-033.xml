          </TextLine>
          <TextLine ID="mz_1-033_l2" HPOS="470" VPOS="797" WIDTH="2983" HEIGHT="98" BASELINE="470 894 3453 894">
            <Shape>
              <Polygon POINTS="470 797 3453 797 3453 895 470 895"/>
            </Shape>
            <String CONTENT="ныхъ оленей съ собою вверхъ. Черные и коричневые олени считаются" HPOS="470" VPOS="797" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-033_l3" HPOS="470" VPOS="917" WIDTH="2987" HEIGHT="103" BASELINE="470 1019 3457 1019">
            <Shape>
              <Polygon POINTS="470 917 3457 917 3457 1020 470 1020"/>
            </Shape>
            <String CONTENT="имѣющими земное и даже подземное происхожденіе. Поэтому напр. при" HPOS="470" VPOS="917" WIDTH="2987" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-033_l4" HPOS="472" VPOS="1051" WIDTH="2985" HEIGHT="99" BASELINE="472 1149 3457 1149">
            <Shape>
              <Polygon POINTS="472 1051 3457 1051 3457 1150 472 1150"/>
            </Shape>
            <String CONTENT="жертвахъ вечеру и тьмѣ (Wу́с̧ӄуус̧) выбираются олени потемнѣе. Солнце" HPOS="472" VPOS="1051" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-033_l5" HPOS="474" VPOS="1170" WIDTH="2724" HEIGHT="102" BASELINE="474 1272 3198 1272">
            <Shape>
              <Polygon POINTS="474 1170 3198 1170 3198 1272 474 1272"/>
            </Shape>
            <String CONTENT="живеть со своей женой въ шатрѣ, носить одежду изъ шкуръ и т. п." HPOS="474" VPOS="1170" WIDTH="2724" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-033_l6" HPOS="679" VPOS="1283" WIDTH="2772" HEIGHT="121" BASELINE="679 1403 3451 1403">
            <Shape>
              <Polygon POINTS="679 1283 3451 1283 3451 1404 679 1404"/>
            </Shape>
            <String CONTENT="Въ сказкѣ объ Аттыђы́ткы (№ 86) оно шаманить въ пологѣ съ цѣлью" HPOS="679" VPOS="1283" WIDTH="2772" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-033_l7" HPOS="475" VPOS="1426" WIDTH="2975" HEIGHT="103" BASELINE="475 1528 3450 1528">
            <Shape>
              <Polygon POINTS="475 1426 3450 1426 3450 1529 475 1529"/>
            </Shape>
            <String CONTENT="соисканія невѣсты, но шаманъ Аттыђы́ткы побѣждаетъ его, какъ и всѣхъ" HPOS="475" VPOS="1426" WIDTH="2975" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-033_l8" HPOS="463" VPOS="1566" WIDTH="947" HEIGHT="84" BASELINE="463 1649 1410 1649">
            <Shape>
              <Polygon POINTS="463 1566 1410 1566 1410 1650 463 1650"/>
            </Shape>
            <String CONTENT="другихъ претендентовъ." HPOS="463" VPOS="1566" WIDTH="947" HEIGHT="84"/>
          </TextLine>
          <TextLine ID="mz_1-033_l9" HPOS="681" VPOS="1678" WIDTH="2771" HEIGHT="102" BASELINE="681 1779 3452 1779">
            <Shape>
              <Polygon POINTS="681 1678 3452 1678 3452 1780 681 1780"/>
            </Shape>
            <String CONTENT="Мѣсяцъ составляетъ солнцу нѣкоторую противоположность. Покушеніе" HPOS="681" VPOS="1678" WIDTH="2771" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-033_l10" HPOS="477" VPOS="1803" WIDTH="2973" HEIGHT="101" BASELINE="477 1903 3450 1903">
            <Shape>
              <Polygon POINTS="477 1803 3450 1803 3450 1904 477 1904"/>
            </Shape>
            <String CONTENT="его похитить дѣвушку кончается неудачно. Лежать въ шатрѣ ему душно," HPOS="477" VPOS="1803" WIDTH="2973" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-033_l11" HPOS="477" VPOS="1941" WIDTH="2978" HEIGHT="86" BASELINE="477 2026 3455 2026">
            <Shape>
              <Polygon POINTS="477 1941 3455 1941 3455 2027 477 2027"/>
            </Shape>
            <String CONTENT="его тянетъ наружу и онъ просить отпустить его на волю, такъ какъ онъ" HPOS="477" VPOS="1941" WIDTH="2978" HEIGHT="86"/>
          </TextLine>
          <TextLine ID="mz_1-033_l12" HPOS="474" VPOS="2053" WIDTH="2978" HEIGHT="100" BASELINE="474 2152 3452 2152">
            <Shape>
              <Polygon POINTS="474 2053 3452 2053 3452 2153 474 2153"/>
            </Shape>
            <String CONTENT="не привыкъ къ кровлѣ. Чукчи иногда называютъ мѣсяцъ также солнцемъ" HPOS="474" VPOS="2053" WIDTH="2978" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-033_l13" HPOS="464" VPOS="2185" WIDTH="2987" HEIGHT="98" BASELINE="464 2282 3451 2282">
            <Shape>
              <Polygon POINTS="464 2185 3451 2185 3451 2283 464 2283"/>
            </Shape>
            <String CONTENT="Кэ́lє (кэ́lє-ті́ркіір) и говорять, что въ подземной вселенной свѣтитъ именно" HPOS="464" VPOS="2185" WIDTH="2987" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-033_l14" HPOS="474" VPOS="2306" WIDTH="2980" HEIGHT="101" BASELINE="474 2406 3454 2406">
            <Shape>
              <Polygon POINTS="474 2306 3454 2306 3454 2407 474 2407"/>
            </Shape>
            <String CONTENT="мѣсяцъ, или солнце, подобное мѣсяцу. Въ сказкахъ кромѣ того дефилируютъ" HPOS="474" VPOS="2306" WIDTH="2980" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-033_l15" HPOS="471" VPOS="2434" WIDTH="2980" HEIGHT="99" BASELINE="471 2532 3451 2532">
            <Shape>
              <Polygon POINTS="471 2434 3451 2434 3451 2533 471 2533"/>
            </Shape>
            <String CONTENT="звѣзды Передняя Голова и Задняя Голова (ја́нөт-lа́ўт и ја́аl-lа́ўт). Первая" HPOS="471" VPOS="2434" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-033_l16" HPOS="472" VPOS="2555" WIDTH="2978" HEIGHT="102" BASELINE="472 2656 3450 2656">
            <Shape>
              <Polygon POINTS="472 2555 3450 2555 3450 2657 472 2657"/>
            </Shape>
            <String CONTENT="есть Arcturus, вторая Вега. Обѣ эти звѣзды считаются братьями и началь-" HPOS="472" VPOS="2555" WIDTH="2978" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-033_l17" HPOS="471" VPOS="2684" WIDTH="2978" HEIGHT="97" BASELINE="471 2781 3449 2781">
            <Shape>
              <Polygon POINTS="471 2684 3449 2684 3449 2781 471 2781"/>
            </Shape>
            <String CONTENT="никами другихъ звѣздъ (аӈа̀р-очо́тте). Оріонъ есть стрѣлокъ Руlтэ́ннін," HPOS="471" VPOS="2684" WIDTH="2978" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-033_l18" HPOS="470" VPOS="2806" WIDTH="2983" HEIGHT="98" BASELINE="470 2904 3453 2904">
            <Shape>
              <Polygon POINTS="470 2806 3453 2806 3453 2904 470 2904"/>
            </Shape>
            <String CONTENT="который поссорился съ своей женой (созвѣздіемъ Льва) и получилъ отъ нея" HPOS="470" VPOS="2806" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-033_l19" HPOS="465" VPOS="2935" WIDTH="2986" HEIGHT="98" BASELINE="465 3032 3451 3032">
            <Shape>
              <Polygon POINTS="465 2935 3451 2935 3451 3033 465 3033"/>
            </Shape>
            <String CONTENT="ударъ скобельной доской по спинѣ. Спина его отъ этого искривилась (поясъ" HPOS="465" VPOS="2935" WIDTH="2986" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-033_l20" HPOS="466" VPOS="3057" WIDTH="2982" HEIGHT="100" BASELINE="466 3156 3448 3156">
            <Shape>
              <Polygon POINTS="466 3057 3448 3057 3448 3157 466 3157"/>
            </Shape>
            <String CONTENT="Оріона), но за то онъ отвергъ свою жену, которая теперь спить на небѣ," HPOS="466" VPOS="3057" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-033_l21" HPOS="471" VPOS="3178" WIDTH="2980" HEIGHT="105" BASELINE="471 3282 3451 3282">
            <Shape>
              <Polygon POINTS="471 3178 3451 3178 3451 3283 471 3283"/>
            </Shape>
            <String CONTENT="подложивъ руку подъ голову. Руlтэ́ннін же сталъ свататься на «Группѣ" HPOS="471" VPOS="3178" WIDTH="2980" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-033_l22" HPOS="464" VPOS="3307" WIDTH="2987" HEIGHT="104" BASELINE="464 3410 3451 3410">
            <Shape>
              <Polygon POINTS="464 3307 3451 3307 3451 3411 464 3411"/>
            </Shape>
            <String CONTENT="женщинъ, ожидающихъ жениха» (ӈаўс̧ӄађо́мкын т. е. Плеяды). Но они от-" HPOS="464" VPOS="3307" WIDTH="2987" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-033_l23" HPOS="472" VPOS="3440" WIDTH="2982" HEIGHT="94" BASELINE="472 3533 3454 3533">
            <Shape>
              <Polygon POINTS="472 3440 3454 3440 3454 3534 472 3534"/>
            </Shape>
            <String CONTENT="вергли его искательство, такъ какъ онъ слишкомъ великъ для нихъ. Тогда" HPOS="472" VPOS="3440" WIDTH="2982" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-033_l24" HPOS="471" VPOS="3565" WIDTH="2981" HEIGHT="97" BASELINE="471 3661 3452 3661">
            <Shape>
              <Polygon POINTS="471 3565 3452 3565 3452 3662 471 3662"/>
            </Shape>
            <String CONTENT="раздраженный претендентъ сталъ стрѣлять въ нихъ изъ лука и его Стрѣла" HPOS="471" VPOS="3565" WIDTH="2981" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-033_l25" HPOS="469" VPOS="3689" WIDTH="2982" HEIGHT="101" BASELINE="469 3790 3451 3790">
            <Shape>
              <Polygon POINTS="469 3689 3451 3689 3451 3790 469 3790"/>
            </Shape>
            <String CONTENT="съ мѣднымъ оконечникомъ (че́lђө-ма́ӄом т. е. Альдебаран) вонзилась въ почву" HPOS="469" VPOS="3689" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-033_l26" HPOS="474" VPOS="3816" WIDTH="2975" HEIGHT="97" BASELINE="474 3913 3449 3913">
            <Shape>
              <Polygon POINTS="474 3816 3449 3816 3449 3913 474 3913"/>
            </Shape>
            <String CONTENT="моховища, истоптаннаго оленями, гдѣ и торчитъ до сихъ поръ. Поперекъ" HPOS="474" VPOS="3816" WIDTH="2975" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-033_l27" HPOS="474" VPOS="3946" WIDTH="2977" HEIGHT="97" BASELINE="474 4043 3451 4043">
            <Shape>
              <Polygon POINTS="474 3946 3451 3946 3451 4043 474 4043"/>
            </Shape>
            <String CONTENT="неба тянется Песчаная рѣка (чіђэ̀ј-вэ́эм), со многими островами, на одномъ" HPOS="474" VPOS="3946" WIDTH="2977" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-033_l28" HPOS="472" VPOS="4062" WIDTH="2982" HEIGHT="104" BASELINE="472 4165 3454 4165">
            <Shape>
              <Polygon POINTS="472 4062 3454 4062 3454 4166 472 4166"/>
            </Shape>
            <String CONTENT="изъ которыхъ пасется группа оленей (ыlвэ́мкын т. е. Кассіопея¹). Имена" HPOS="472" VPOS="4062" WIDTH="2982" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-033_l29" HPOS="467" VPOS="4193" WIDTH="2980" HEIGHT="99" BASELINE="467 4291 3447 4291">
            <Shape>
              <Polygon POINTS="467 4193 3447 4193 3447 4292 467 4292"/>
            </Shape>
            <String CONTENT="другихъ созвѣздій я не упоминаю, ибо они въ преданіяхъ не встрѣчаются." HPOS="467" VPOS="4193" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-033_l30" HPOS="466" VPOS="4315" WIDTH="2991" HEIGHT="103" BASELINE="466 4417 3457 4417">
            <Shape>
              <Polygon POINTS="466 4315 3457 4315 3457 4418 466 4418"/>
            </Shape>
            <String CONTENT="Кромѣ настоящихъ звѣздъ есть еще «звѣзды, катающіяся съ горы» (ра́lе" HPOS="466" VPOS="4315" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-033_l31" HPOS="474" VPOS="4438" WIDTH="2979" HEIGHT="105" BASELINE="474 4543 3453 4543">
            <Shape>
              <Polygon POINTS="474 4438 3453 4438 3453 4543 474 4543"/>
            </Shape>
            <String CONTENT="-ана́тте т. е. падающія звѣзды), «звѣзды, ходящія въ сторону» (руlт-эӈэ́тті" HPOS="474" VPOS="4438" WIDTH="2979" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-033_l32" HPOS="476" VPOS="4564" WIDTH="2972" HEIGHT="102" BASELINE="476 4665 3448 4665">
            <Shape>
              <Polygon POINTS="476 4564 3448 4564 3448 4666 476 4666"/>
            </Shape>
            <String CONTENT="т. е. планеты) и «звѣзды дымящіяся» (ӈыł-аӈа́тте т. е. кометы). Изъ звѣздъ," HPOS="476" VPOS="4564" WIDTH="2972" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-033_l33" HPOS="469" VPOS="4701" WIDTH="2978" HEIGHT="104" BASELINE="469 4804 3447 4804">
            <Shape>
              <Polygon POINTS="469 4701 3447 4701 3447 4805 469 4805"/>
            </Shape>
            <String CONTENT="ходящихъ въ сторону, Венера называется Ђыто́łап (прозрачныя ребра)." HPOS="469" VPOS="4701" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-033_l34" HPOS="676" VPOS="4817" WIDTH="2774" HEIGHT="102" BASELINE="676 4918 3450 4918">
            <Shape>
              <Polygon POINTS="676 4817 3450 4817 3450 4919 676 4919"/>
            </Shape>
            <String CONTENT="Разсвѣтъ и Вечерній свѣтъ, играющіе важную роль при жертвопри-" HPOS="676" VPOS="4817" WIDTH="2774" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-033_l35" HPOS="685" VPOS="5057" WIDTH="2762" HEIGHT="90" BASELINE="685 5147 3447 5147">
            <Shape>
              <Polygon POINTS="685 5057 3447 5057 3447 5147 685 5147"/>
            </Shape>
            <String CONTENT="1) Нордквистъ, довольно вѣрно передающій имена многихъ чукотскихъ со-" HPOS="685" VPOS="5057" WIDTH="2762" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-033_l36" HPOS="465" VPOS="5156" WIDTH="2985" HEIGHT="91" BASELINE="465 5246 3450 5246">
            <Shape>
              <Polygon POINTS="465 5156 3450 5156 3450 5247 465 5247"/>
            </Shape>
            <String CONTENT="звѣздій, хотя и безъ объясненія значенія именъ, называетъ Кассіопею Melutankin" HPOS="465" VPOS="5156" WIDTH="2985" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-033_l37" HPOS="461" VPOS="5260" WIDTH="2982" HEIGHT="105" BASELINE="461 5364 3443 5364">
            <Shape>
              <Polygon POINTS="461 5260 3443 5260 3443 5365 461 5365"/>
            </Shape>
            <String CONTENT="очевидно міlутэ́мкын — «группа зайцевъ». Поясъ Оріона онъ называетъ раў, т. е." HPOS="461" VPOS="5260" WIDTH="2982" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-033_l38" HPOS="464" VPOS="5358" WIDTH="2978" HEIGHT="112" BASELINE="464 5469 3442 5469">
            <Shape>
              <Polygon POINTS="464 5358 3442 5358 3442 5470 464 5470"/>
            </Shape>
            <String CONTENT="рэ́ў — «китъ». Разница въ звукахъ происходить оттого, что онъ вездѣ беретъ слабую" HPOS="464" VPOS="5358" WIDTH="2978" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-033_l39" HPOS="461" VPOS="5488" WIDTH="2982" HEIGHT="87" BASELINE="461 5574 3443 5574">
            <Shape>
              <Polygon POINTS="461 5488 3443 5488 3443 5575 461 5575"/>
            </Shape>
            <String CONTENT="основу косвенныхъ падежей, а не сильную основу именительнаго падежа. Остальныя" HPOS="461" VPOS="5488" WIDTH="2982" HEIGHT="87"/>
          </TextLine>
          <TextLine ID="mz_1-033_l40" HPOS="464" VPOS="5594" WIDTH="2977" HEIGHT="95" BASELINE="464 5688 3441 5688">
            <Shape>
              <Polygon POINTS="464 5594 3441 5594 3441 5689 464 5689"/>
            </Shape>
            <String CONTENT="названія, приведенныя у него, совпадаютъ съ моими, см. Nordquist Tschuktschisk" HPOS="464" VPOS="5594" WIDTH="2977" HEIGHT="95"/>
          </TextLine>
