            </Shape>
            <String CONTENT="бѣжалъ и таньги вмѣстѣ. Запасъ взяли. Съ тѣхъ поръ перестали худо" HPOS="599" VPOS="2005" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-149_l12" HPOS="599" VPOS="2134" WIDTH="993" HEIGHT="95" BASELINE="599 2229 1592 2229">
