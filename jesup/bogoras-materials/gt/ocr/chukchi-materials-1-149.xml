            <Shape>
              <Polygon POINTS="606 2827 3594 2827 3594 2929 606 2929"/>
            </Shape>
            <String CONTENT="21-го марта 1747 г. Разсказъ о смерти Јӓку́ннін’а существуетъ въ различныхъ" HPOS="606" VPOS="2827" WIDTH="2988" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-149_l17" HPOS="603" VPOS="2950" WIDTH="2989" HEIGHT="86" BASELINE="603 3035 3592 3035">
