            </Shape>
            <String CONTENT="ный вздохъ. Набѣжали вдвоемъ. Чы́мкыl бѣлый панцырь снялъ, самъ на" HPOS="604" VPOS="1751" WIDTH="2984" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-149_l10" HPOS="601" VPOS="1889" WIDTH="3090" HEIGHT="92" BASELINE="601 1981 3691 1981">
