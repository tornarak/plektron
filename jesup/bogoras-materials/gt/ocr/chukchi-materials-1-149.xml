              <Polygon POINTS="603 2950 3592 2950 3592 3036 603 3036"/>
            </Shape>
            <String CONTENT="варіантахъ, которые до извѣстной степени совпадаютъ и съ русско-юкагирскими" HPOS="603" VPOS="2950" WIDTH="2989" HEIGHT="86"/>
          </TextLine>
