            <Shape>
              <Polygon POINTS="605 3261 3593 3261 3593 3359 605 3359"/>
            </Shape>
            <String CONTENT="кость въ обращеніи съ плѣнными чукчами. Здѣсь Јӓку́ннін названъ а̂ӄа̀-тэі́ӈ̀ыlын" HPOS="605" VPOS="3261" WIDTH="2988" HEIGHT="98"/>
          </TextLine>
