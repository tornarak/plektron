            <Shape>
              <Polygon POINTS="603 3048 3590 3048 3590 3142 603 3142"/>
            </Shape>
            <String CONTENT="преданіями. Большая часть варіантовъ говоритъ, что раненный Јӓку́ннін былъ взятъ" HPOS="603" VPOS="3048" WIDTH="2987" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-149_l19" HPOS="605" VPOS="3159" WIDTH="2983" HEIGHT="89" BASELINE="605 3247 3588 3247">
            <Shape>
              <Polygon POINTS="605 3159 3588 3159 3588 3248 605 3248"/>
            </Shape>
            <String CONTENT="въ плѣнъ и замученъ на медленной пыткѣ для того, чтобы отомстить за его жесто-" HPOS="605" VPOS="3159" WIDTH="2983" HEIGHT="89"/>
          </TextLine>
