            <Shape>
              <Polygon POINTS="609 3376 3588 3376 3588 3465 609 3465"/>
            </Shape>
            <String CONTENT="«худо убивающій», именно по поводу такой жестокости (см. разсказы о Якуннинѣ," HPOS="609" VPOS="3376" WIDTH="2979" HEIGHT="89"/>
          </TextLine>
