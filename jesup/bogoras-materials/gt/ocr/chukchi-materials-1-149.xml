            </Shape>
            <String CONTENT="дальше плеча. Трахъ! ... Упалъ Јӓку́ннін, тотчасъ же испустилъ смерт-" HPOS="604" VPOS="1631" WIDTH="2979" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-149_l9" HPOS="604" VPOS="1751" WIDTH="2984" HEIGHT="110" BASELINE="604 1861 3588 1861">
