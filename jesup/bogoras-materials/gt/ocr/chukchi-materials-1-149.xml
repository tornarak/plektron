            </Shape>
            <String CONTENT="2 (стр. 4). Lаwтыlыwа́lын, Чукэ́ђрэђ и Чы́мкыl обыкновенно пріуро-" HPOS="821" VPOS="3585" WIDTH="2772" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-149_l24" HPOS="604" VPOS="3708" WIDTH="2986" HEIGHT="90" BASELINE="604 3797 3590 3797">
            <Shape>
              <Polygon POINTS="604 3708 3590 3708 3590 3798 604 3798"/>
            </Shape>
            <String CONTENT="чиваются къ борьбѣ съ «настоящими таньгами», т. е. коряками и чуванцами. Суще-" HPOS="604" VPOS="3708" WIDTH="2986" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-149_l25" HPOS="607" VPOS="3819" WIDTH="2978" HEIGHT="90" BASELINE="607 3909 3585 3909">
            <Shape>
              <Polygon POINTS="607 3819 3585 3819 3585 3909 607 3909"/>
            </Shape>
            <String CONTENT="ствуютъ многочисленныя преданія о различныхъ эпизодахъ этой борьбы (см. отд. II)." HPOS="607" VPOS="3819" WIDTH="2978" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-149_l26" HPOS="604" VPOS="3910" WIDTH="2982" HEIGHT="109" BASELINE="604 4018 3586 4018">
            <Shape>
              <Polygon POINTS="604 3910 3586 3910 3586 4019 604 4019"/>
            </Shape>
            <String CONTENT="Lаwтыlыwа́lын, — «Кивающій головой», постоянно является главнымъ э́рмэчын’омъ," HPOS="604" VPOS="3910" WIDTH="2982" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-149_l27" HPOS="605" VPOS="4034" WIDTH="2983" HEIGHT="88" BASELINE="605 4121 3588 4121">
            <Shape>
              <Polygon POINTS="605 4034 3588 4034 3588 4122 605 4122"/>
            </Shape>
            <String CONTENT="предводителемъ чукочъ. Кивая головой, онъ даетъ указанія воинамъ, отправляетъ ихъ" HPOS="605" VPOS="4034" WIDTH="2983" HEIGHT="88"/>
          </TextLine>
          <TextLine ID="mz_1-149_l28" HPOS="607" VPOS="4143" WIDTH="2224" HEIGHT="91" BASELINE="607 4233 2831 4233">
            <Shape>
              <Polygon POINTS="607 4143 2831 4143 2831 4234 607 4234"/>
            </Shape>
            <String CONTENT="въ обходъ непріятелю или на приступъ укрѣпленныхъ жилищъ." HPOS="607" VPOS="4143" WIDTH="2224" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-149_l29" HPOS="818" VPOS="4246" WIDTH="2771" HEIGHT="101" BASELINE="818 4345 3589 4345">
            <Shape>
              <Polygon POINTS="818 4246 3589 4246 3589 4347 818 4347"/>
            </Shape>
            <String CONTENT="3 (стр. 9). та̀канlата́тыlыт «несущіе запасъ». Чукотскіе витязи, разъ-" HPOS="818" VPOS="4246" WIDTH="2771" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-149_l30" HPOS="604" VPOS="4364" WIDTH="2985" HEIGHT="82" BASELINE="604 4445 3589 4445">
            <Shape>
              <Polygon POINTS="604 4364 3589 4364 3589 4446 604 4446"/>
            </Shape>
            <String CONTENT="ѣзжавшіе на легкихъ санкахъ, не могли брать съ собой никакого запаса, такъ какъ" HPOS="604" VPOS="4364" WIDTH="2985" HEIGHT="82"/>
          </TextLine>
          <TextLine ID="mz_1-149_l31" HPOS="602" VPOS="4471" WIDTH="2983" HEIGHT="89" BASELINE="602 4560 3585 4560">
            <Shape>
              <Polygon POINTS="602 4471 3585 4471 3585 4560 602 4560"/>
            </Shape>
            <String CONTENT="чукотскія ѣздовыя санки не приспособлены даже для самого малаго груза. Всѣ запасы" HPOS="602" VPOS="4471" WIDTH="2983" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-149_l32" HPOS="600" VPOS="4576" WIDTH="2692" HEIGHT="96" BASELINE="600 4671 3292 4671">
            <Shape>
              <Polygon POINTS="600 4576 3292 4576 3292 4672 600 4672"/>
            </Shape>
            <String CONTENT="должны были перевозиться обозомъ (му́утӓ) и сравнительно очень медленно." HPOS="600" VPOS="4576" WIDTH="2692" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-149_l33" HPOS="814" VPOS="4680" WIDTH="2775" HEIGHT="107" BASELINE="814 4786 3589 4786">
            <Shape>
              <Polygon POINTS="814 4680 3589 4680 3589 4787 814 4787"/>
            </Shape>
            <String CONTENT="4 (стр. 11). э́ккэlӄӓl «пріемный сынъ, пасынокъ». Русскіе разсказы ничего" HPOS="814" VPOS="4680" WIDTH="2775" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-149_l34" HPOS="604" VPOS="4793" WIDTH="2986" HEIGHT="97" BASELINE="604 4889 3590 4889">
            <Shape>
              <Polygon POINTS="604 4793 3590 4793 3590 4890 604 4890"/>
            </Shape>
            <String CONTENT="не знаютъ о пріемномъ сынѣ Павлуцкаго. Но вообще казаки постоянно имѣли при" HPOS="604" VPOS="4793" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-149_l35" HPOS="607" VPOS="4905" WIDTH="2979" HEIGHT="92" BASELINE="607 4996 3586 4996">
            <Shape>
              <Polygon POINTS="607 4905 3586 4905 3586 4997 607 4997"/>
            </Shape>
            <String CONTENT="себѣ юкагирскихъ, якутскихъ и чуванскихъ женщинъ. Съ другой стороны въ отрядѣ" HPOS="607" VPOS="4905" WIDTH="2979" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-149_l36" HPOS="597" VPOS="5018" WIDTH="2990" HEIGHT="88" BASELINE="597 5105 3587 5105">
            <Shape>
              <Polygon POINTS="597 5018 3587 5018 3587 5106 597 5106"/>
            </Shape>
            <String CONTENT="Павлуцкаго былъ вспомогательный чуванско-юкагирскій контингентъ, составлявшій" HPOS="597" VPOS="5018" WIDTH="2990" HEIGHT="88"/>
          </TextLine>
          <TextLine ID="mz_1-149_l37" HPOS="604" VPOS="5140" WIDTH="1472" HEIGHT="73" BASELINE="604 5212 2076 5212">
            <Shape>
              <Polygon POINTS="604 5140 2076 5140 2076 5213 604 5213"/>
            </Shape>
            <String CONTENT="почти половину всего количества воиновъ." HPOS="604" VPOS="5140" WIDTH="1472" HEIGHT="73"/>
          </TextLine>
          <TextLine ID="mz_1-149_l38" HPOS="815" VPOS="5229" WIDTH="2769" HEIGHT="104" BASELINE="815 5332 3584 5332">
            <Shape>
              <Polygon POINTS="815 5229 3584 5229 3584 5333 815 5333"/>
            </Shape>
            <String CONTENT="5 (стр. 11). мы́рђэw «панцырь». У чукотскихъ воиновъ были въ употре-" HPOS="815" VPOS="5229" WIDTH="2769" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-149_l39" HPOS="604" VPOS="5348" WIDTH="2980" HEIGHT="89" BASELINE="604 5436 3584 5436">
            <Shape>
              <Polygon POINTS="604 5348 3584 5348 3584 5437 604 5437"/>
            </Shape>
            <String CONTENT="бленіи панцыри изъ полосъ жесткой кожи лахтака, связанныхъ вмѣстѣ ремешками," HPOS="604" VPOS="5348" WIDTH="2980" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-149_l40" HPOS="600" VPOS="5460" WIDTH="2987" HEIGHT="89" BASELINE="600 5549 3587 5549">
            <Shape>
              <Polygon POINTS="600 5460 3587 5460 3587 5549 600 5549"/>
            </Shape>
            <String CONTENT="или изъ тонкихъ желѣзныхъ пластинокъ, тоже связанныхъ. Эти пластинки вѣроятно" HPOS="600" VPOS="5460" WIDTH="2987" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-149_l41" HPOS="599" VPOS="5557" WIDTH="2988" HEIGHT="108" BASELINE="599 5665 3587 5665">
            <Shape>
              <Polygon POINTS="599 5557 3587 5557 3587 5665 599 5665"/>
            </Shape>
            <String CONTENT="выковывались кузнецами сидячихъ коряковъ (По́ђтыlыт). Трудно сказать, были" HPOS="599" VPOS="5557" WIDTH="2988" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-149_l42" HPOS="596" VPOS="5679" WIDTH="2988" HEIGHT="86" BASELINE="596 5765 3584 5765">
            <Shape>
              <Polygon POINTS="596 5679 3584 5679 3584 5765 596 5765"/>
            </Shape>
            <String CONTENT="ли онѣ въ употребленіи до прихода русскихъ. Чукотскія преданія, приписывающія" HPOS="596" VPOS="5679" WIDTH="2988" HEIGHT="86"/>
          </TextLine>
