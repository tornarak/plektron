          </TextLine>
          <TextLine ID="mz_1-052_l2" HPOS="1250" VPOS="806" WIDTH="2983" HEIGHT="100" BASELINE="1250 906 4233 906">
            <Shape>
              <Polygon POINTS="1250 806 4233 806 4233 906 1250 906"/>
            </Shape>
            <String CONTENT="сторону пролива, противъ конца земли, въ морской губѣ, между двумя" HPOS="1250" VPOS="806" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-052_l3" HPOS="1244" VPOS="934" WIDTH="2990" HEIGHT="101" BASELINE="1244 1033 4234 1033">
            <Shape>
              <Polygon POINTS="1244 934 4234 934 4234 1035 1244 1035"/>
            </Shape>
            <String CONTENT="мысами, въ недвижныхъ домахъ. Накупивъ чукотскихъ оленей, ставитъ на" HPOS="1244" VPOS="934" WIDTH="2990" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-052_l4" HPOS="1247" VPOS="1072" WIDTH="2987" HEIGHT="87" BASELINE="1247 1157 4234 1157">
            <Shape>
              <Polygon POINTS="1247 1072 4234 1072 4234 1159 1247 1159"/>
            </Shape>
            <String CONTENT="судно, сдираетъ мохъ съ чукотскихъ скалъ, кормитъ всю дорогу, потомъ" HPOS="1247" VPOS="1072" WIDTH="2987" HEIGHT="87"/>
          </TextLine>
          <TextLine ID="mz_1-052_l5" HPOS="1249" VPOS="1182" WIDTH="2984" HEIGHT="99" BASELINE="1249 1279 4233 1279">
            <Shape>
              <Polygon POINTS="1249 1182 4233 1182 4233 1281 1249 1281"/>
            </Shape>
            <String CONTENT="выпускаетъ на своемъ берегу, творя обиду жителямъ этой земли. Создалъ" HPOS="1249" VPOS="1182" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-052_l6" HPOS="1249" VPOS="1313" WIDTH="2985" HEIGHT="98" BASELINE="1249 1408 4234 1408">
            <Shape>
              <Polygon POINTS="1249 1313 4234 1313 4234 1411 1249 1411"/>
            </Shape>
            <String CONTENT="стадо, соблазняетъ нашихъ пастуховъ стеречь своихъ оленей за высокую" HPOS="1249" VPOS="1313" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-052_l7" HPOS="1249" VPOS="1446" WIDTH="2985" HEIGHT="92" BASELINE="1249 1536 4234 1536">
            <Shape>
              <Polygon POINTS="1249 1446 4234 1446 4234 1538 1249 1538"/>
            </Shape>
            <String CONTENT="плату, размножаетъ скотъ, желая вести торгъ собственными шкурами." HPOS="1249" VPOS="1446" WIDTH="2985" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-052_l8" HPOS="1241" VPOS="1561" WIDTH="2992" HEIGHT="101" BASELINE="1241 1660 4233 1660">
            <Shape>
              <Polygon POINTS="1241 1561 4233 1561 4233 1662 1241 1662"/>
            </Shape>
            <String CONTENT="Пошелъ Или по морю и вышелъ на открытую воду. Встрѣтилъ его Маньо," HPOS="1241" VPOS="1561" WIDTH="2992" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-052_l9" HPOS="1249" VPOS="1686" WIDTH="2982" HEIGHT="100" BASELINE="1249 1783 4231 1783">
            <Shape>
              <Polygon POINTS="1249 1686 4231 1686 4231 1786 1249 1786"/>
            </Shape>
            <String CONTENT="посланный Солнечнымъ Владыкой русскій бородачъ¹), на большомъ суднѣ" HPOS="1249" VPOS="1686" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-052_l10" HPOS="1252" VPOS="1802" WIDTH="2983" HEIGHT="114" BASELINE="1252 1915 4235 1915">
            <Shape>
              <Polygon POINTS="1252 1802 4235 1802 4235 1916 1252 1916"/>
            </Shape>
            <String CONTENT="съ тремя стоячими деревьями (мачтами). Или пьянъ, говоритъ: «Я началь-" HPOS="1252" VPOS="1802" WIDTH="2983" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-052_l11" HPOS="1248" VPOS="1891" WIDTH="2982" HEIGHT="145" BASELINE="1248 2035 4230 2035">
            <Shape>
              <Polygon POINTS="1248 1891 4230 1891 4230 2036 1248 2036"/>
            </Shape>
            <String CONTENT="никъ, я силачъ, я великій, я пьяница!» — «Ага», говоритъ Маньо²)," HPOS="1248" VPOS="1891" WIDTH="2982" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-052_l12" HPOS="1250" VPOS="2059" WIDTH="2984" HEIGHT="104" BASELINE="1250 2162 4234 2162">
            <Shape>
              <Polygon POINTS="1250 2059 4234 2059 4234 2163 1250 2163"/>
            </Shape>
            <String CONTENT="«приди-же ко мнѣ въ гости!» Какъ только пришелъ, связалъ ему руки и" HPOS="1250" VPOS="2059" WIDTH="2984" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-052_l13" HPOS="1251" VPOS="2178" WIDTH="2981" HEIGHT="110" BASELINE="1251 2287 4232 2287">
            <Shape>
              <Polygon POINTS="1251 2178 4232 2178 4232 2288 1251 2288"/>
            </Shape>
            <String CONTENT="ноги, повѣсилъ на мачтѣ внизъ головой. Говоритъ Маньо: «Ты богачъ, ты" HPOS="1251" VPOS="2178" WIDTH="2981" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-052_l14" HPOS="1249" VPOS="2300" WIDTH="2983" HEIGHT="114" BASELINE="1249 2413 4232 2413">
            <Shape>
              <Polygon POINTS="1249 2300 4232 2300 4232 2414 1249 2414"/>
            </Shape>
            <String CONTENT="начальникъ, ты пьяница? А что?» Или только головой крутитъ: «Ухъ!»" HPOS="1249" VPOS="2300" WIDTH="2983" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-052_l15" HPOS="1249" VPOS="2388" WIDTH="2982" HEIGHT="147" BASELINE="1249 2534 4231 2534">
            <Shape>
              <Polygon POINTS="1249 2388 4231 2388 4231 2535 1249 2535"/>
            </Shape>
            <String CONTENT="Говоритъ Маньо: «Ты завелъ стадо?» — «Завелъ!» — «Зачѣмъ-же ты завелъ" HPOS="1249" VPOS="2388" WIDTH="2982" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-052_l16" HPOS="1248" VPOS="2562" WIDTH="2988" HEIGHT="105" BASELINE="1248 2667 4236 2667">
            <Shape>
              <Polygon POINTS="1248 2562 4236 2562 4236 2667 1248 2667"/>
            </Shape>
            <String CONTENT="стадо? Какъ ты пріобрѣлъ его?» Говоритъ Или: «Отчасти, конечно, я" HPOS="1248" VPOS="2562" WIDTH="2988" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-052_l17" HPOS="1244" VPOS="2650" WIDTH="2990" HEIGHT="139" BASELINE="1244 2788 4234 2788">
            <Shape>
              <Polygon POINTS="1244 2650 4234 2650 4234 2789 1244 2789"/>
            </Shape>
            <String CONTENT="купилъ его.» — «Ага! Чѣмъ-же ты купилъ его?» Говоритъ Или: «Частью" HPOS="1244" VPOS="2650" WIDTH="2990" HEIGHT="139"/>
          </TextLine>
          <TextLine ID="mz_1-052_l18" HPOS="1245" VPOS="2779" WIDTH="2987" HEIGHT="117" BASELINE="1245 2895 4232 2895">
            <Shape>
              <Polygon POINTS="1245 2779 4232 2779 4232 2896 1245 2896"/>
            </Shape>
            <String CONTENT="ружьями.» — «А еще чѣмъ?» — «Также сердитой водой.» — «А еще," HPOS="1245" VPOS="2779" WIDTH="2987" HEIGHT="117"/>
          </TextLine>
          <TextLine ID="mz_1-052_l19" HPOS="1244" VPOS="2899" WIDTH="2985" HEIGHT="138" BASELINE="1244 3035 4229 3035">
            <Shape>
              <Polygon POINTS="1244 2899 4229 2899 4229 3037 1244 3037"/>
            </Shape>
            <String CONTENT="чѣмъ?» — «Иныхъ по правдѣ взялъ грабежемъ.» — «Ага», говоритъ Маньо," HPOS="1244" VPOS="2899" WIDTH="2985" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-052_l20" HPOS="1248" VPOS="3012" WIDTH="2983" HEIGHT="141" BASELINE="1248 3151 4231 3151">
            <Shape>
              <Polygon POINTS="1248 3012 4231 3012 4231 3153 1248 3153"/>
            </Shape>
            <String CONTENT="«зачѣмъ-же ты завелъ стадо?» — «Хотѣлъ продавать пыжики острови-" HPOS="1248" VPOS="3012" WIDTH="2983" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-052_l21" HPOS="1247" VPOS="3185" WIDTH="2986" HEIGHT="107" BASELINE="1247 3289 4233 3289">
            <Shape>
              <Polygon POINTS="1247 3185 4233 3185 4233 3292 1247 3292"/>
            </Shape>
            <String CONTENT="тянамъ.» Говоритъ его людямъ: «На четвертый день придите взять его!»" HPOS="1247" VPOS="3185" WIDTH="2986" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-052_l22" HPOS="1248" VPOS="3316" WIDTH="2986" HEIGHT="103" BASELINE="1248 3418 4234 3418">
            <Shape>
              <Polygon POINTS="1248 3316 4234 3316 4234 3419 1248 3419"/>
            </Shape>
            <String CONTENT="Пришли его люди на четвертый день. «Скорѣе уходи на свою землю, не" HPOS="1248" VPOS="3316" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-052_l23" HPOS="1249" VPOS="3436" WIDTH="2977" HEIGHT="99" BASELINE="1249 3535 4226 3535">
            <Shape>
              <Polygon POINTS="1249 3436 4226 3436 4226 3535 1249 3535"/>
            </Shape>
            <String CONTENT="нужно тебя! Оставь здѣсь оленей! Если Творящій создалъ тебя безъ стада," HPOS="1249" VPOS="3436" WIDTH="2977" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-052_l24" HPOS="1247" VPOS="3566" WIDTH="2983" HEIGHT="101" BASELINE="1247 3666 4230 3666">
            <Shape>
              <Polygon POINTS="1247 3566 4230 3566 4230 3667 1247 3667"/>
            </Shape>
            <String CONTENT="зачѣмъ противишься, творя оскорбленіе жителямъ этой страны? Уйди" HPOS="1247" VPOS="3566" WIDTH="2983" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-052_l25" HPOS="1246" VPOS="3693" WIDTH="2980" HEIGHT="101" BASELINE="1246 3793 4226 3793">
            <Shape>
              <Polygon POINTS="1246 3693 4226 3693 4226 3794 1246 3794"/>
            </Shape>
            <String CONTENT="скорѣе домой! Если снова придешь, будешь убитъ до смерти!» Тотъ ушелъ," HPOS="1246" VPOS="3693" WIDTH="2980" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-052_l26" HPOS="1251" VPOS="3817" WIDTH="2978" HEIGHT="104" BASELINE="1251 3918 4229 3918">
            <Shape>
              <Polygon POINTS="1251 3817 4229 3817 4229 3921 1251 3921"/>
            </Shape>
            <String CONTENT="скрылся. Маньо пошелъ по морю, снова встрѣчаетъ заморскаго бородача³)." HPOS="1251" VPOS="3817" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-052_l27" HPOS="1252" VPOS="3928" WIDTH="2981" HEIGHT="111" BASELINE="1252 4038 4233 4038">
            <Shape>
              <Polygon POINTS="1252 3928 4233 3928 4233 4039 1252 4039"/>
            </Shape>
            <String CONTENT="«Ты зачѣмъ идешь? Не нужно тебя! Вернись!» — «Меня послалъ Владыка" HPOS="1252" VPOS="3928" WIDTH="2981" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-052_l28" HPOS="1254" VPOS="4017" WIDTH="2983" HEIGHT="143" BASELINE="1254 4158 4237 4158">
            <Shape>
              <Polygon POINTS="1254 4017 4237 4017 4237 4160 1254 4160"/>
            </Shape>
            <String CONTENT="земли бородатыхъ.» — «Вернись!» — «Не хочу!» — «А-а! Давай-же сра-" HPOS="1254" VPOS="4017" WIDTH="2983" HEIGHT="143"/>
          </TextLine>
          <TextLine ID="mz_1-052_l29" HPOS="1248" VPOS="4192" WIDTH="2983" HEIGHT="102" BASELINE="1248 4292 4231 4292">
            <Shape>
              <Polygon POINTS="1248 4192 4231 4192 4231 4294 1248 4294"/>
            </Shape>
            <String CONTENT="жаться!» Сразились. Маньо сильнѣе. Сталъ убѣгать заморскій бородачъ." HPOS="1248" VPOS="4192" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-052_l30" HPOS="1248" VPOS="4318" WIDTH="2984" HEIGHT="101" BASELINE="1248 4419 4232 4419">
            <Shape>
              <Polygon POINTS="1248 4318 4232 4318 4232 4419 1248 4419"/>
            </Shape>
            <String CONTENT="Маньо смотритъ на большую бумагу, видитъ весь путь бѣглеца, спустился" HPOS="1248" VPOS="4318" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-052_l31" HPOS="1253" VPOS="4444" WIDTH="2977" HEIGHT="102" BASELINE="1253 4544 4230 4544">
            <Shape>
              <Polygon POINTS="1253 4444 4230 4444 4230 4546 1253 4546"/>
            </Shape>
            <String CONTENT="подъ воду, нырнулъ, какъ гагара, вмѣстѣ съ судномъ, вынырнулъ впереди" HPOS="1253" VPOS="4444" WIDTH="2977" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-052_l32" HPOS="1249" VPOS="4573" WIDTH="2986" HEIGHT="100" BASELINE="1249 4672 4235 4672">
            <Shape>
              <Polygon POINTS="1249 4573 4235 4573 4235 4673 1249 4673"/>
            </Shape>
            <String CONTENT="чужого судна. Говоритъ бородатый: «Пристанемъ къ берегу, испытаемъ" HPOS="1249" VPOS="4573" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-052_l33" HPOS="1252" VPOS="4656" WIDTH="2980" HEIGHT="137" BASELINE="1252 4792 4232 4792">
            <Shape>
              <Polygon POINTS="1252 4656 4232 4656 4232 4793 1252 4793"/>
            </Shape>
            <String CONTENT="изъ насъ двоихъ, кто лучше!» — «Согласенъ!» Вышли на берегъ. Маньо-" HPOS="1252" VPOS="4656" WIDTH="2980" HEIGHT="137"/>
          </TextLine>
          <TextLine ID="mz_1-052_l34" HPOS="1249" VPOS="4819" WIDTH="2987" HEIGHT="99" BASELINE="1249 4917 4236 4917">
            <Shape>
              <Polygon POINTS="1249 4819 4236 4819 4236 4918 1249 4918"/>
            </Shape>
            <String CONTENT="дружокъ весьма проворенъ, съ легкими членами. Сталъ на собачью нарту," HPOS="1249" VPOS="4819" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-052_l35" HPOS="1474" VPOS="5066" WIDTH="2765" HEIGHT="91" BASELINE="1474 5156 4239 5156">
            <Shape>
              <Polygon POINTS="1474 5066 4239 5066 4239 5157 1474 5157"/>
            </Shape>
            <String CONTENT="1) Русскихъ корабельщиковъ чукчи называютъ, какъ и американцевъ, боро-" HPOS="1474" VPOS="5066" WIDTH="2765" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-052_l36" HPOS="1256" VPOS="5170" WIDTH="2982" HEIGHT="99" BASELINE="1256 5268 4238 5268">
            <Shape>
              <Polygon POINTS="1256 5170 4238 5170 4238 5269 1256 5269"/>
            </Shape>
            <String CONTENT="дачами, въ отличіе отъ русскихъ жителей Колымы и Анадыра, которые развитіемъ" HPOS="1256" VPOS="5170" WIDTH="2982" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-052_l37" HPOS="1255" VPOS="5284" WIDTH="2089" HEIGHT="84" BASELINE="1255 5368 3344 5368">
            <Shape>
              <Polygon POINTS="1255 5284 3344 5284 3344 5368 1255 5368"/>
            </Shape>
            <String CONTENT="растительности на лицѣ мало превосходятъ самыхъ чукчей." HPOS="1255" VPOS="5284" WIDTH="2089" HEIGHT="84"/>
          </TextLine>
          <TextLine ID="mz_1-052_l38" HPOS="1475" VPOS="5380" WIDTH="2764" HEIGHT="97" BASELINE="1475 5476 4239 5476">
            <Shape>
              <Polygon POINTS="1475 5380 4239 5380 4239 5477 1475 5477"/>
            </Shape>
            <String CONTENT="2) Именемъ Маньо чукчи называютъ вообще русскихъ начальниковъ, при-" HPOS="1475" VPOS="5380" WIDTH="2764" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-052_l39" HPOS="1256" VPOS="5491" WIDTH="2983" HEIGHT="90" BASELINE="1256 5580 4239 5580">
            <Shape>
              <Polygon POINTS="1256 5491 4239 5491 4239 5581 1256 5581"/>
            </Shape>
            <String CONTENT="ходящихъ на корабляхъ со стороны Тихаго океана, въ частности также анадырскаго" HPOS="1256" VPOS="5491" WIDTH="2983" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-052_l40" HPOS="1260" VPOS="5612" WIDTH="796" HEIGHT="73" BASELINE="1260 5685 2056 5685">
            <Shape>
              <Polygon POINTS="1260 5612 2056 5612 2056 5685 1260 5685"/>
            </Shape>
            <String CONTENT="окружного начальника." HPOS="1260" VPOS="5612" WIDTH="796" HEIGHT="73"/>
          </TextLine>
