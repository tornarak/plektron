          <TextLine ID="mz_1-280_l1" HPOS="1241" VPOS="558" WIDTH="2988" HEIGHT="103" BASELINE="1241 659 4229 659">
            <Shape>
              <Polygon POINTS="1241 558 4229 558 4229 661 1241 661"/>
            </Shape>
            <String CONTENT="224 В. Г. БОГОРАЗЪ, II,82." HPOS="1241" VPOS="558" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-280_l2" HPOS="1240" VPOS="782" WIDTH="2989" HEIGHT="100" BASELINE="1240 881 4229 881">
            <Shape>
              <Polygon POINTS="1240 782 4229 782 4229 882 1240 882"/>
            </Shape>
            <String CONTENT="знаетъ. Полетѣлъ Кукульпынъ домой, выпустилъ изо рта обоихъ. Гово-" HPOS="1240" VPOS="782" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-280_l3" HPOS="1242" VPOS="899" WIDTH="2988" HEIGHT="106" BASELINE="1242 1005 4230 1005">
            <Shape>
              <Polygon POINTS="1242 899 4230 899 4230 1005 1242 1005"/>
            </Shape>
            <String CONTENT="ритъ товарищу: «Такъ какъ мы теперь смѣнные товарищи въ бракѣ, ты" HPOS="1242" VPOS="899" WIDTH="2988" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-280_l4" HPOS="1243" VPOS="1000" WIDTH="2979" HEIGHT="130" BASELINE="1243 1130 4222 1130">
            <Shape>
              <Polygon POINTS="1243 1000 4222 1000 4222 1130 1243 1130"/>
            </Shape>
            <String CONTENT="спи сегодня со старой, я съ молодой, завтра ты съ молодой, я — со старой!»" HPOS="1243" VPOS="1000" WIDTH="2979" HEIGHT="130"/>
          </TextLine>
          <TextLine ID="mz_1-280_l5" HPOS="1237" VPOS="1115" WIDTH="2993" HEIGHT="136" BASELINE="1237 1251 4230 1251">
            <Shape>
              <Polygon POINTS="1237 1115 4230 1115 4230 1251 1237 1251"/>
            </Shape>
            <String CONTENT="Дѣвка красивая. Говоритъ Тяпкинецъ: «Ы!» понуривъ голову. Въ душѣ" HPOS="1237" VPOS="1115" WIDTH="2993" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-280_l6" HPOS="1239" VPOS="1276" WIDTH="2991" HEIGHT="100" BASELINE="1239 1375 4230 1375">
            <Shape>
              <Polygon POINTS="1239 1276 4230 1276 4230 1376 1239 1376"/>
            </Shape>
            <String CONTENT="думаетъ: «Этакій негодяй!» ... Легли. Кукульпынъ обнялъ дѣвку руками и" HPOS="1239" VPOS="1276" WIDTH="2991" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-280_l7" HPOS="1241" VPOS="1405" WIDTH="2990" HEIGHT="98" BASELINE="1241 1502 4231 1502">
            <Shape>
              <Polygon POINTS="1241 1405 4231 1405 4231 1503 1241 1503"/>
            </Shape>
            <String CONTENT="ногами, потомъ заснулъ. Старая баба подвигается къ Тяпкинцу, ударилъ" HPOS="1241" VPOS="1405" WIDTH="2990" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-280_l8" HPOS="1242" VPOS="1519" WIDTH="2986" HEIGHT="105" BASELINE="1242 1623 4228 1623">
            <Shape>
              <Polygon POINTS="1242 1519 4228 1519 4228 1624 1242 1624"/>
            </Shape>
            <String CONTENT="ее локтемъ. Смотритъ на Кукульпына: тотъ спитъ. «Пусть же я сегодня," HPOS="1242" VPOS="1519" WIDTH="2986" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-280_l9" HPOS="1245" VPOS="1651" WIDTH="2978" HEIGHT="99" BASELINE="1245 1750 4223 1750">
            <Shape>
              <Polygon POINTS="1245 1651 4223 1651 4223 1750 1245 1750"/>
            </Shape>
            <String CONTENT="а не завтра!» Дунулъ на Кукульпына, унесло его сквозь палогъ на высокій" HPOS="1245" VPOS="1651" WIDTH="2978" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l10" HPOS="1236" VPOS="1764" WIDTH="2988" HEIGHT="110" BASELINE="1236 1873 4224 1873">
            <Shape>
              <Polygon POINTS="1236 1764 4224 1764 4224 1874 1236 1874"/>
            </Shape>
            <String CONTENT="утесь надъ морскими валами. Еще немножко, упадетъ въ воду! Проснулся," HPOS="1236" VPOS="1764" WIDTH="2988" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-280_l11" HPOS="1244" VPOS="1903" WIDTH="2983" HEIGHT="97" BASELINE="1244 2000 4227 2000">
            <Shape>
              <Polygon POINTS="1244 1903 4227 1903 4227 2000 1244 2000"/>
            </Shape>
            <String CONTENT="говоритъ: «Убиваетъ меня!» Позвалъ своего главнаго Кэ́lє, тотъ перенесъ" HPOS="1244" VPOS="1903" WIDTH="2983" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-280_l12" HPOS="1244" VPOS="2020" WIDTH="2981" HEIGHT="104" BASELINE="1244 2123 4225 2123">
            <Shape>
              <Polygon POINTS="1244 2020 4225 2020 4225 2124 1244 2124"/>
            </Shape>
            <String CONTENT="его назадъ въ домъ. Спитъ Тяпкинецъ, обнявъ дѣвку. Толкаетъ его. «Мэй," HPOS="1244" VPOS="2020" WIDTH="2981" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-280_l13" HPOS="1244" VPOS="2134" WIDTH="2986" HEIGHT="109" BASELINE="1244 2242 4230 2242">
            <Shape>
              <Polygon POINTS="1244 2134 4230 2134 4230 2243 1244 2243"/>
            </Shape>
            <String CONTENT="мэй! Пробудись! Ты завтра съ молодой, сегодня со старой!» Опять обнялъ" HPOS="1244" VPOS="2134" WIDTH="2986" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-280_l14" HPOS="1247" VPOS="2274" WIDTH="2984" HEIGHT="98" BASELINE="1247 2371 4231 2371">
            <Shape>
              <Polygon POINTS="1247 2274 4231 2274 4231 2372 1247 2372"/>
            </Shape>
            <String CONTENT="Американскую дѣвку руками и ногами, опять заснулъ. Опять посмотрѣлъ" HPOS="1247" VPOS="2274" WIDTH="2984" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-280_l15" HPOS="1248" VPOS="2394" WIDTH="2989" HEIGHT="99" BASELINE="1248 2492 4237 2492">
            <Shape>
              <Polygon POINTS="1248 2394 4237 2394 4237 2493 1248 2493"/>
            </Shape>
            <String CONTENT="на нихъ Тяпкинецъ. «Этакій негодяй!» Дунулъ на него, — унесло его на" HPOS="1248" VPOS="2394" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l16" HPOS="1248" VPOS="2519" WIDTH="2985" HEIGHT="99" BASELINE="1248 2617 4233 2617">
            <Shape>
              <Polygon POINTS="1248 2519 4233 2519 4233 2618 1248 2618"/>
            </Shape>
            <String CONTENT="средину моря, на свѣже-замороженный ледъ; колеблется отъ вѣтра и волнъ" HPOS="1248" VPOS="2519" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l17" HPOS="1252" VPOS="2635" WIDTH="2981" HEIGHT="104" BASELINE="1252 2738 4233 2738">
            <Shape>
              <Polygon POINTS="1252 2635 4233 2635 4233 2739 1252 2739"/>
            </Shape>
            <String CONTENT="вверхъ и внизъ. «О-о! Убиваетъ меня!» Позвалъ главнаго Кэ́lє. «Вынеси," HPOS="1252" VPOS="2635" WIDTH="2981" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-280_l18" HPOS="1248" VPOS="2765" WIDTH="2985" HEIGHT="103" BASELINE="1248 2867 4233 2867">
            <Shape>
              <Polygon POINTS="1248 2765 4233 2765 4233 2868 1248 2868"/>
            </Shape>
            <String CONTENT="меня отсюда! Перестану владѣть тобой». Принесъ его домой. «Пусть же»," HPOS="1248" VPOS="2765" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-280_l19" HPOS="1252" VPOS="2894" WIDTH="2983" HEIGHT="99" BASELINE="1252 2992 4235 2992">
            <Shape>
              <Polygon POINTS="1252 2894 4235 2894 4235 2993 1252 2993"/>
            </Shape>
            <String CONTENT="говоритъ, «и я попробую!» Дунулъ на Тяпкинца; унесло его вверхъ, одну" HPOS="1252" VPOS="2894" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l20" HPOS="1252" VPOS="3025" WIDTH="2984" HEIGHT="95" BASELINE="1252 3119 4236 3119">
            <Shape>
              <Polygon POINTS="1252 3025 4236 3025 4236 3120 1252 3120"/>
            </Shape>
            <String CONTENT="вселенную пробилъ головой, другую ногами, на четвертую попалъ, тамъ" HPOS="1252" VPOS="3025" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-280_l21" HPOS="1253" VPOS="3146" WIDTH="1797" HEIGHT="97" BASELINE="1253 3242 3050 3242">
            <Shape>
              <Polygon POINTS="1253 3146 3050 3146 3050 3243 1253 3243"/>
            </Shape>
            <String CONTENT="застрялъ. Кукульпынъ легъ спать съ дѣвкой." HPOS="1253" VPOS="3146" WIDTH="1797" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-280_l22" HPOS="1459" VPOS="3332" WIDTH="1628" HEIGHT="98" BASELINE="1459 3429 3087 3429">
            <Shape>
              <Polygon POINTS="1459 3332 3087 3332 3087 3430 1459 3430"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Чэ́ӈэ на р. Россомашьей." HPOS="1459" VPOS="3332" WIDTH="1628" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-280_l23" HPOS="2668" VPOS="3690" WIDTH="137" HEIGHT="105" BASELINE="2668 3794 2805 3794">
            <Shape>
              <Polygon POINTS="2668 3690 2805 3690 2805 3795 2668 3795"/>
            </Shape>
            <String CONTENT="83." HPOS="2668" VPOS="3690" WIDTH="137" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-280_l24" HPOS="2254" VPOS="3879" WIDTH="962" HEIGHT="110" BASELINE="2254 3988 3216 3988">
            <Shape>
              <Polygon POINTS="2254 3879 3216 3879 3216 3989 2254 3989"/>
            </Shape>
            <String CONTENT="Нэнэ́нэӄӓј. Малютка." HPOS="2254" VPOS="3879" WIDTH="962" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-280_l25" HPOS="1458" VPOS="4080" WIDTH="2772" HEIGHT="106" BASELINE="1458 4185 4230 4185">
            <Shape>
              <Polygon POINTS="1458 4080 4230 4080 4230 4186 1458 4186"/>
            </Shape>
            <String CONTENT="Былъ Нэнэнэкай (малютка) въ Нэтэнѣ¹), жилъ вдвоемъ съ бабушкой" HPOS="1458" VPOS="4080" WIDTH="2772" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-280_l26" HPOS="1249" VPOS="4172" WIDTH="2976" HEIGHT="141" BASELINE="1249 4312 4225 4312">
            <Shape>
              <Polygon POINTS="1249 4172 4225 4172 4225 4313 1249 4313"/>
            </Shape>
            <String CONTENT="въ пологу, лежитъ на спинѣ, смотритъ на потолокъ. «Мэй!» — «Вуй!» —" HPOS="1249" VPOS="4172" WIDTH="2976" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-280_l27" HPOS="1246" VPOS="4299" WIDTH="2973" HEIGHT="135" BASELINE="1246 4433 4219 4433">
            <Shape>
              <Polygon POINTS="1246 4299 4219 4299 4219 4434 1246 4434"/>
            </Shape>
            <String CONTENT="«Поди въ Нэтэкэнгычвынъ¹), — единственная дочь у отца, — приведи мнѣ" HPOS="1246" VPOS="4299" WIDTH="2973" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-280_l28" HPOS="1244" VPOS="4424" WIDTH="2977" HEIGHT="143" BASELINE="1244 4566 4221 4566">
            <Shape>
              <Polygon POINTS="1244 4424 4221 4424 4221 4567 1244 4567"/>
            </Shape>
            <String CONTENT="въ жены!» — «Эђэ́й!» Вышла старуха на дворъ, ее тащутъ скороходы Ма-" HPOS="1244" VPOS="4424" WIDTH="2977" HEIGHT="143"/>
          </TextLine>
          <TextLine ID="mz_1-280_l29" HPOS="1245" VPOS="4587" WIDTH="2975" HEIGHT="101" BASELINE="1245 4687 4220 4687">
            <Shape>
              <Polygon POINTS="1245 4587 4220 4587 4220 4688 1245 4688"/>
            </Shape>
            <String CONTENT="лютки, два бѣгуна самыхъ быстрыхъ въ Нэтэнѣ. Прибыли въ Нэтэкэнгыч-" HPOS="1245" VPOS="4587" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-280_l30" HPOS="1244" VPOS="4674" WIDTH="2979" HEIGHT="147" BASELINE="1244 4820 4223 4820">
            <Shape>
              <Polygon POINTS="1244 4674 4223 4674 4223 4821 1244 4821"/>
            </Shape>
            <String CONTENT="вынъ. Сошла съ нарты. «Ђо́!» — «Еlо́²)!» — «Кто ты?» — «Старушка изъ" HPOS="1244" VPOS="4674" WIDTH="2979" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-280_l31" HPOS="1244" VPOS="4839" WIDTH="2975" HEIGHT="101" BASELINE="1244 4939 4219 4939">
            <Shape>
              <Polygon POINTS="1244 4839 4219 4839 4219 4940 1244 4940"/>
            </Shape>
            <String CONTENT="Нэтэна! Малютка говоритъ: ‚Поди, посватай мнѣ дѣвку изъ Нэтэкэнгыч-" HPOS="1244" VPOS="4839" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-280_l32" HPOS="1242" VPOS="4936" WIDTH="2982" HEIGHT="108" BASELINE="1242 5043 4224 5043">
            <Shape>
              <Polygon POINTS="1242 4936 4224 4936 4224 5044 1242 5044"/>
            </Shape>
            <String CONTENT="вына!‘» — «Ӄо! Какъ скажетъ дѣвка!» Дѣвка только услышала, лежа" HPOS="1242" VPOS="4936" WIDTH="2982" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-280_l33" HPOS="1241" VPOS="5101" WIDTH="2980" HEIGHT="94" BASELINE="1241 5194 4221 5194">
            <Shape>
              <Polygon POINTS="1241 5101 4221 5101 4221 5195 1241 5195"/>
            </Shape>
            <String CONTENT="рядомъ съ отцомъ, подвязываетъ оборы, выскочила на дворъ, схватила" HPOS="1241" VPOS="5101" WIDTH="2980" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-280_l34" HPOS="1243" VPOS="5221" WIDTH="2976" HEIGHT="99" BASELINE="1243 5319 4219 5319">
            <Shape>
              <Polygon POINTS="1243 5221 4219 5221 4219 5320 1243 5320"/>
            </Shape>
            <String CONTENT="ремни отъ нарты, побѣжала вскачь, потащила старуху въ Нэтэнъ, скоро-" HPOS="1243" VPOS="5221" WIDTH="2976" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l35" HPOS="1239" VPOS="5326" WIDTH="2978" HEIGHT="118" BASELINE="1239 5443 4217 5443">
            <Shape>
              <Polygon POINTS="1239 5326 4217 5326 4217 5444 1239 5444"/>
            </Shape>
            <String CONTENT="ходы остаются сзади. У спуска къ подгорью остановились. Пришли скоро-" HPOS="1239" VPOS="5326" WIDTH="2978" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-280_l36" HPOS="1459" VPOS="5555" WIDTH="2146" HEIGHT="99" BASELINE="1459 5653 3605 5653">
            <Shape>
              <Polygon POINTS="1459 5555 3605 5555 3605 5654 1459 5654"/>
            </Shape>
            <String CONTENT="1) Приморскіе чукотскіе поселки Нэ́тэн и Нэ́тэ-ӄэ́ӈычвын." HPOS="1459" VPOS="5555" WIDTH="2146" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-280_l37" HPOS="1461" VPOS="5664" WIDTH="2500" HEIGHT="97" BASELINE="1461 5760 3961 5760">
            <Shape>
              <Polygon POINTS="1461 5664 3961 5664 3961 5761 1461 5761"/>
            </Shape>
            <String CONTENT="2) Обычные окрики при пріѣздѣ гостя, если хозяева сидятъ въ пологу." HPOS="1461" VPOS="5664" WIDTH="2500" HEIGHT="97"/>
          </TextLine>
