        <TextBlock ID="text_1-301" HPOS="639" VPOS="562" WIDTH="3017" HEIGHT="5221">
          <TextLine ID="mz_1-301_l1" HPOS="659" VPOS="562" WIDTH="2991" HEIGHT="123" BASELINE="659 662 3650 662">
            <Shape>
              <Polygon POINTS="659 562 3650 562 3650 685 659 685"/>
            </Shape>
            <String CONTENT="II,90. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 245" HPOS="659" VPOS="562" WIDTH="2991" HEIGHT="123"/>
          </TextLine>
          <TextLine ID="mz_1-301_l2" HPOS="665" VPOS="789" WIDTH="2986" HEIGHT="97" BASELINE="665 885 3651 885">
            <Shape>
              <Polygon POINTS="665 789 3651 789 3651 886 665 886"/>
            </Shape>
            <String CONTENT="за носъ рукой, тотъ и таскаетъ его во всѣ стороны, ибо это недавній со-" HPOS="665" VPOS="789" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-301_l3" HPOS="665" VPOS="913" WIDTH="2984" HEIGHT="95" BASELINE="665 1007 3649 1007">
            <Shape>
              <Polygon POINTS="665 913 3649 913 3649 1008 665 1008"/>
            </Shape>
            <String CONTENT="бирающійся убить. Сталъ ослабѣвать. Человѣкъ держитъ по прежнему." HPOS="665" VPOS="913" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-301_l4" HPOS="664" VPOS="1035" WIDTH="2983" HEIGHT="100" BASELINE="664 1134 3647 1134">
            <Shape>
              <Polygon POINTS="664 1035 3647 1035 3647 1135 664 1135"/>
            </Shape>
            <String CONTENT="Полетѣлъ на средину земли, какъ птица, человѣкъ тащитъ его въ воду," HPOS="664" VPOS="1035" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-301_l5" HPOS="666" VPOS="1159" WIDTH="2984" HEIGHT="100" BASELINE="666 1258 3650 1258">
            <Shape>
              <Polygon POINTS="666 1159 3650 1159 3650 1259 666 1259"/>
            </Shape>
            <String CONTENT="говоритъ: «пойдемъ въ воду!» Тогда тотъ тюлень сталъ недвижимъ. Чело-" HPOS="666" VPOS="1159" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-301_l6" HPOS="665" VPOS="1290" WIDTH="2984" HEIGHT="99" BASELINE="665 1388 3649 1388">
            <Shape>
              <Polygon POINTS="665 1290 3649 1290 3649 1389 665 1389"/>
            </Shape>
            <String CONTENT="вѣкъ вернулся на берегъ, взялъ кукашку, развязалъ всѣ ремни, всю одежду" HPOS="665" VPOS="1290" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-301_l7" HPOS="659" VPOS="1408" WIDTH="2989" HEIGHT="104" BASELINE="659 1511 3648 1511">
            <Shape>
              <Polygon POINTS="659 1408 3648 1408 3648 1512 659 1512"/>
            </Shape>
            <String CONTENT="надѣлъ. Ушелъ. Увидѣлъ селеніе. Сѣлъ снаружи (у шатра). Дѣвушка" HPOS="659" VPOS="1408" WIDTH="2989" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-301_l8" HPOS="665" VPOS="1533" WIDTH="2980" HEIGHT="105" BASELINE="665 1637 3645 1637">
            <Shape>
              <Polygon POINTS="665 1533 3645 1533 3645 1638 665 1638"/>
            </Shape>
            <String CONTENT="вышла, опять вошла. Отцу говоритъ: «Съ этой стороны человѣкъ при-" HPOS="665" VPOS="1533" WIDTH="2980" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-301_l9" HPOS="656" VPOS="1603" WIDTH="2987" HEIGHT="141" BASELINE="656 1743 3643 1743">
            <Shape>
              <Polygon POINTS="656 1603 3643 1603 3643 1744 656 1744"/>
            </Shape>
            <String CONTENT="шелъ.» — «Какъ-же онъ пришелъ? Пусть войдетъ! Како! Пришелъ?» —" HPOS="656" VPOS="1603" WIDTH="2987" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-301_l10" HPOS="665" VPOS="1744" WIDTH="2976" HEIGHT="145" BASELINE="665 1889 3641 1889">
            <Shape>
              <Polygon POINTS="665 1744 3641 1744 3641 1889 665 1889"/>
            </Shape>
            <String CONTENT="«Да.» — «Ну, ладно! Возьми дѣвушку!» Будущій тесть говоритъ: «По какой" HPOS="665" VPOS="1744" WIDTH="2976" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-301_l11" HPOS="656" VPOS="1841" WIDTH="2981" HEIGHT="148" BASELINE="656 1989 3637 1989">
            <Shape>
              <Polygon POINTS="656 1841 3637 1841 3637 1989 656 1989"/>
            </Shape>
            <String CONTENT="дорогѣ пришелъ?» — «Вонъ тамъ!» — «Видѣлъ?» — «Видѣлъ.» — «Како!»" HPOS="656" VPOS="1841" WIDTH="2981" HEIGHT="148"/>
          </TextLine>
          <TextLine ID="mz_1-301_l12" HPOS="653" VPOS="2037" WIDTH="2987" HEIGHT="102" BASELINE="653 2139 3640 2139">
            <Shape>
              <Polygon POINTS="653 2037 3640 2037 3640 2139 653 2139"/>
            </Shape>
            <String CONTENT="Дѣвушка унесла одинъ мѣшокъ въ другой шатеръ. Тесть говоритъ: «До-" HPOS="653" VPOS="2037" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-301_l13" HPOS="657" VPOS="2116" WIDTH="2984" HEIGHT="147" BASELINE="657 2262 3641 2262">
            <Shape>
              <Polygon POINTS="657 2116 3641 2116 3641 2263 657 2263"/>
            </Shape>
            <String CONTENT="стань оттуда!» — «Сейчасъ принесу!» Онъ поставилъ полу и въ полѣ у него" HPOS="657" VPOS="2116" WIDTH="2984" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-301_l14" HPOS="658" VPOS="2289" WIDTH="2982" HEIGHT="101" BASELINE="658 2389 3640 2389">
            <Shape>
              <Polygon POINTS="658 2289 3640 2289 3640 2390 658 2390"/>
            </Shape>
            <String CONTENT="очутились дикіе олени, бараны, всякая дичь. Кинулъ все это въ шатеръ." HPOS="658" VPOS="2289" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l15" HPOS="655" VPOS="2408" WIDTH="2988" HEIGHT="104" BASELINE="655 2511 3643 2511">
            <Shape>
              <Polygon POINTS="655 2408 3643 2408 3643 2512 655 2512"/>
            </Shape>
            <String CONTENT="Тамъ духи стали хвататься и драться. Онъ мѣшокъ вытащилъ, принесъ" HPOS="655" VPOS="2408" WIDTH="2988" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-301_l16" HPOS="654" VPOS="2539" WIDTH="2988" HEIGHT="99" BASELINE="654 2637 3642 2637">
            <Shape>
              <Polygon POINTS="654 2539 3642 2539 3642 2638 654 2638"/>
            </Shape>
            <String CONTENT="домой, положилъ на старое мѣсто. Старикъ говоритъ дочери: «Другой мой" HPOS="654" VPOS="2539" WIDTH="2988" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-301_l17" HPOS="657" VPOS="2664" WIDTH="2985" HEIGHT="101" BASELINE="657 2764 3642 2764">
            <Shape>
              <Polygon POINTS="657 2664 3642 2664 3642 2765 657 2765"/>
            </Shape>
            <String CONTENT="мѣшокъ съ инструментами отнеси въ другой шатеръ!» Она унесла. Гово-" HPOS="657" VPOS="2664" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l18" HPOS="649" VPOS="2785" WIDTH="2995" HEIGHT="104" BASELINE="649 2888 3644 2888">
            <Shape>
              <Polygon POINTS="649 2785 3644 2785 3644 2889 649 2889"/>
            </Shape>
            <String CONTENT="ритъ парню: «Достань мой мѣшокъ!» Пришелъ къ морю, пришелъ, полу" HPOS="649" VPOS="2785" WIDTH="2995" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-301_l19" HPOS="657" VPOS="2914" WIDTH="2984" HEIGHT="100" BASELINE="657 3014 3641 3014">
            <Shape>
              <Polygon POINTS="657 2914 3641 2914 3641 3014 657 3014"/>
            </Shape>
            <String CONTENT="наставилъ, нападали нерпы; бросилъ въ тотъ шатеръ. Духи стали драться;" HPOS="657" VPOS="2914" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-301_l20" HPOS="656" VPOS="3038" WIDTH="2993" HEIGHT="102" BASELINE="656 3139 3649 3139">
            <Shape>
              <Polygon POINTS="656 3038 3649 3038 3649 3140 656 3140"/>
            </Shape>
            <String CONTENT="онъ взялъ мѣшокъ и унесъ. Переступилъ черезъ дѣвушку; положилъ на" HPOS="656" VPOS="3038" WIDTH="2993" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-301_l21" HPOS="652" VPOS="3162" WIDTH="2991" HEIGHT="98" BASELINE="652 3259 3643 3259">
            <Shape>
              <Polygon POINTS="652 3162 3643 3162 3643 3260 652 3260"/>
            </Shape>
            <String CONTENT="старое мѣсто. Говоритъ отецъ дочери: «Гдѣ?» — «Тамъ лежитъ, на ста-" HPOS="652" VPOS="3162" WIDTH="2991" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-301_l22" HPOS="652" VPOS="3241" WIDTH="2988" HEIGHT="141" BASELINE="652 3381 3640 3381">
            <Shape>
              <Polygon POINTS="652 3241 3640 3241 3640 3382 652 3382"/>
            </Shape>
            <String CONTENT="ромъ мѣстѣ.» — «А они видѣли его?» — «Видѣли.» — «Ка-ка! Ну, что-же!" HPOS="652" VPOS="3241" WIDTH="2988" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-301_l23" HPOS="653" VPOS="3414" WIDTH="2987" HEIGHT="101" BASELINE="653 3514 3640 3514">
            <Shape>
              <Polygon POINTS="653 3414 3640 3414 3640 3515 653 3515"/>
            </Shape>
            <String CONTENT="Согласенъ!» Долго жили, потомъ вернулись домой. Пока тамъ пребывалъ," HPOS="653" VPOS="3414" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l24" HPOS="655" VPOS="3538" WIDTH="2987" HEIGHT="101" BASELINE="655 3638 3642 3638">
            <Shape>
              <Polygon POINTS="655 3538 3642 3538 3642 3639 655 3639"/>
            </Shape>
            <String CONTENT="она забеременѣла отъ того еще, какъ онъ переступилъ черезъ нее; родила" HPOS="655" VPOS="3538" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l25" HPOS="655" VPOS="3667" WIDTH="2988" HEIGHT="93" BASELINE="655 3759 3643 3759">
            <Shape>
              <Polygon POINTS="655 3667 3643 3667 3643 3760 655 3760"/>
            </Shape>
            <String CONTENT="ребенка. Сдѣлалъ кибитку. Говоритъ тесть: «Есть олени; одинъ весьма" HPOS="655" VPOS="3667" WIDTH="2988" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-301_l26" HPOS="658" VPOS="3790" WIDTH="2981" HEIGHT="100" BASELINE="658 3889 3639 3889">
            <Shape>
              <Polygon POINTS="658 3790 3639 3790 3639 3890 658 3890"/>
            </Shape>
            <String CONTENT="старый быкъ, рядомъ съ нимъ важенка неплодная¹), хорошо выученная," HPOS="658" VPOS="3790" WIDTH="2981" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-301_l27" HPOS="653" VPOS="3909" WIDTH="2989" HEIGHT="105" BASELINE="653 4013 3642 4013">
            <Shape>
              <Polygon POINTS="653 3909 3642 3909 3642 4014 653 4014"/>
            </Shape>
            <String CONTENT="не умѣющая биться. Собравъ стадо, ихъ найди!» Онъ говоритъ: «Ладно!»" HPOS="653" VPOS="3909" WIDTH="2989" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-301_l28" HPOS="644" VPOS="4035" WIDTH="3002" HEIGHT="106" BASELINE="644 4140 3646 4140">
            <Shape>
              <Polygon POINTS="644 4035 3646 4035 3646 4141 644 4141"/>
            </Shape>
            <String CONTENT="Ушелъ на сѣндуху. Взошелъ на самую высокую скалу, взобрался на" HPOS="644" VPOS="4035" WIDTH="3002" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-301_l29" HPOS="655" VPOS="4161" WIDTH="2979" HEIGHT="102" BASELINE="655 4262 3634 4262">
            <Shape>
              <Polygon POINTS="655 4161 3634 4161 3634 4263 655 4263"/>
            </Shape>
            <String CONTENT="самый верхъ. Заснулъ. Двѣ ночи провелъ во снѣ и три дня. Проснулся," HPOS="655" VPOS="4161" WIDTH="2979" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-301_l30" HPOS="651" VPOS="4289" WIDTH="2984" HEIGHT="101" BASELINE="651 4389 3635 4389">
            <Shape>
              <Polygon POINTS="651 4289 3635 4289 3635 4390 651 4390"/>
            </Shape>
            <String CONTENT="надѣлъ обувь, ибо вчера заснулъ босой. Есть ложбинка вверху. Побѣжалъ" HPOS="651" VPOS="4289" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l31" HPOS="646" VPOS="4415" WIDTH="2988" HEIGHT="101" BASELINE="646 4515 3634 4515">
            <Shape>
              <Polygon POINTS="646 4415 3634 4415 3634 4516 646 4516"/>
            </Shape>
            <String CONTENT="по ложбинкѣ. Внизъ кричитъ: «Го-го! Стадо собираю!» Со всей земли" HPOS="646" VPOS="4415" WIDTH="2988" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-301_l32" HPOS="654" VPOS="4540" WIDTH="2975" HEIGHT="98" BASELINE="654 4637 3629 4637">
            <Shape>
              <Polygon POINTS="654 4540 3629 4540 3629 4638 654 4638"/>
            </Shape>
            <String CONTENT="валежникъ поднялся, со всѣхъ сторонъ эти сучья и палки погнали стадо." HPOS="654" VPOS="4540" WIDTH="2975" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-301_l33" HPOS="644" VPOS="4656" WIDTH="2985" HEIGHT="109" BASELINE="644 4764 3629 4764">
            <Shape>
              <Polygon POINTS="644 4656 3629 4656 3629 4765 644 4765"/>
            </Shape>
            <String CONTENT="Пригнали стадо къ дому. Онъ имъ говоритъ: «Ну, довольно! Го-го!» Не-" HPOS="644" VPOS="4656" WIDTH="2985" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-301_l34" HPOS="644" VPOS="4794" WIDTH="2984" HEIGHT="95" BASELINE="644 4888 3628 4888">
            <Shape>
              <Polygon POINTS="644 4794 3628 4794 3628 4889 644 4889"/>
            </Shape>
            <String CONTENT="давнія палки погонщики-помощники опять по прежнему дровами стали." HPOS="644" VPOS="4794" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-301_l35" HPOS="639" VPOS="4849" WIDTH="3004" HEIGHT="141" BASELINE="639 4989 3643 4989">
            <Shape>
              <Polygon POINTS="639 4849 3643 4849 3643 4990 639 4990"/>
            </Shape>
            <String CONTENT="Пригналъ. Спрашиваетъ у дѣвушки: «Гдѣ-же важенка?» — «Вотъ она.» —" HPOS="639" VPOS="4849" WIDTH="3004" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-301_l36" HPOS="648" VPOS="4977" WIDTH="2994" HEIGHT="139" BASELINE="648 5115 3642 5115">
            <Shape>
              <Polygon POINTS="648 4977 3642 4977 3642 5116 648 5116"/>
            </Shape>
            <String CONTENT="«Гдѣ-же быкъ ученый?» — «Вотъ онъ.» — «Ага! Ну, теперь сдѣлаемъ" HPOS="648" VPOS="4977" WIDTH="2994" HEIGHT="139"/>
          </TextLine>
          <TextLine ID="mz_1-301_l37" HPOS="641" VPOS="5167" WIDTH="3003" HEIGHT="97" BASELINE="641 5263 3644 5263">
            <Shape>
              <Polygon POINTS="641 5167 3644 5167 3644 5264 641 5264"/>
            </Shape>
            <String CONTENT="прэ́рэм²)!» Убили оленя, сдѣлали прэ́рэм. Спрашиваетъ отецъ у дочери:" HPOS="641" VPOS="5167" WIDTH="3003" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-301_l38" HPOS="879" VPOS="5468" WIDTH="374" HEIGHT="95" BASELINE="879 5563 1253 5563">
            <Shape>
              <Polygon POINTS="879 5468 1253 5468 1253 5563 879 5563"/>
            </Shape>
            <String CONTENT="1) ӓ̂с̧ӄэ́ку." HPOS="879" VPOS="5468" WIDTH="374" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-301_l39" HPOS="874" VPOS="5576" WIDTH="2782" HEIGHT="100" BASELINE="874 5675 3656 5675">
            <Shape>
              <Polygon POINTS="874 5576 3656 5576 3656 5676 874 5676"/>
            </Shape>
            <String CONTENT="2) прэ́рэм — родъ котлетъ изъ толченаго мяса, смѣшаннаго съ жиромъ со-" HPOS="874" VPOS="5576" WIDTH="2782" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-301_l40" HPOS="661" VPOS="5698" WIDTH="2010" HEIGHT="85" BASELINE="661 5783 2671 5783">
            <Shape>
              <Polygon POINTS="661 5698 2671 5698 2671 5783 661 5783"/>
            </Shape>
            <String CONTENT="ставляетъ обрядовое угощеніе при брачномъ празднествѣ." HPOS="661" VPOS="5698" WIDTH="2010" HEIGHT="85"/>
          </TextLine>
        </TextBlock>
