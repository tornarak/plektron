          <TextLine ID="mz_1-244_l1" HPOS="1190" VPOS="532" WIDTH="2977" HEIGHT="106" BASELINE="1190 637 4167 637">
            <Shape>
              <Polygon POINTS="1190 532 4167 532 4167 638 1190 638"/>
            </Shape>
            <String CONTENT="188 Г. БОГОРАЗЪ, II,70." HPOS="1190" VPOS="532" WIDTH="2977" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-244_l2" HPOS="2324" VPOS="577" WIDTH="55" HEIGHT="61" BASELINE="2324 637 2379 637">
            <Shape>
              <Polygon POINTS="2324 577 2379 577 2379 638 2324 638"/>
            </Shape>
            <String CONTENT="В." HPOS="2324" VPOS="577" WIDTH="55" HEIGHT="61"/>
          </TextLine>
          <TextLine ID="mz_1-244_l3" HPOS="2608" VPOS="1068" WIDTH="137" HEIGHT="103" BASELINE="2608 1170 2745 1170">
            <Shape>
              <Polygon POINTS="2608 1068 2745 1068 2745 1171 2608 1171"/>
            </Shape>
            <String CONTENT="70" HPOS="2608" VPOS="1068" WIDTH="137" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-244_l4" HPOS="2038" VPOS="1233" WIDTH="1284" HEIGHT="113" BASELINE="2038 1345 3322 1345">
            <Shape>
              <Polygon POINTS="2038 1233 3322 1233 3322 1346 2038 1346"/>
            </Shape>
            <String CONTENT="Ка́lа-lѵ́мӈыl. О Кэ́lє сказка." HPOS="2038" VPOS="1233" WIDTH="1284" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-244_l5" HPOS="1400" VPOS="1383" WIDTH="2775" HEIGHT="141" BASELINE="1400 1523 4175 1523">
            <Shape>
              <Polygon POINTS="1400 1383 4175 1383 4175 1524 1400 1524"/>
            </Shape>
            <String CONTENT="Жили пять братьевъ. Пошелъ одинъ на сѣндуху — пропалъ, пошелъ" HPOS="1400" VPOS="1383" WIDTH="2775" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-244_l6" HPOS="1186" VPOS="1518" WIDTH="2990" HEIGHT="130" BASELINE="1186 1647 4176 1647">
            <Shape>
              <Polygon POINTS="1186 1518 4176 1518 4176 1648 1186 1648"/>
            </Shape>
            <String CONTENT="другой искать его — тоже пропалъ. Они на стрѣлкѣ проваливались сквозь" HPOS="1186" VPOS="1518" WIDTH="2990" HEIGHT="130"/>
          </TextLine>
          <TextLine ID="mz_1-244_l7" HPOS="1191" VPOS="1675" WIDTH="2982" HEIGHT="99" BASELINE="1191 1773 4173 1773">
            <Shape>
              <Polygon POINTS="1191 1675 4173 1675 4173 1774 1191 1774"/>
            </Shape>
            <String CONTENT="песокъ, а Кэ́lє ихъ ловилъ и закалывалъ. Пропали трое, остались только" HPOS="1191" VPOS="1675" WIDTH="2982" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-244_l8" HPOS="1190" VPOS="1800" WIDTH="2986" HEIGHT="97" BASELINE="1190 1896 4176 1896">
            <Shape>
              <Polygon POINTS="1190 1800 4176 1800 4176 1897 1190 1897"/>
            </Shape>
            <String CONTENT="двое. Сталъ большой вѣтеръ, два мѣсяца дуло. Говоритъ старшій братъ" HPOS="1190" VPOS="1800" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-244_l9" HPOS="1189" VPOS="1924" WIDTH="2990" HEIGHT="100" BASELINE="1189 2023 4179 2023">
            <Shape>
              <Polygon POINTS="1189 1924 4179 1924 4179 2024 1189 2024"/>
            </Shape>
            <String CONTENT="младшему: «Пойдемъ, хоть поищемъ чего-нибудь на сѣндухѣ, не то умремъ" HPOS="1189" VPOS="1924" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-244_l10" HPOS="1194" VPOS="2048" WIDTH="2986" HEIGHT="95" BASELINE="1194 2143 4180 2143">
            <Shape>
              <Polygon POINTS="1194 2048 4180 2048 4180 2143 1194 2143"/>
            </Shape>
            <String CONTENT="съ голоду!» Связались они ремнемъ и пошли вдвоемъ. Вѣтеръ на встрѣчу;" HPOS="1194" VPOS="2048" WIDTH="2986" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-244_l11" HPOS="1197" VPOS="2173" WIDTH="2980" HEIGHT="99" BASELINE="1197 2271 4177 2271">
            <Shape>
              <Polygon POINTS="1197 2173 4177 2173 4177 2272 1197 2272"/>
            </Shape>
            <String CONTENT="ничего не видно. Темно. Вдругъ толкнулись обо что-то; посмотрѣли: это" HPOS="1197" VPOS="2173" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-244_l12" HPOS="1192" VPOS="2297" WIDTH="2985" HEIGHT="99" BASELINE="1192 2395 4177 2395">
            <Shape>
              <Polygon POINTS="1192 2297 4177 2297 4177 2396 1192 2396"/>
            </Shape>
            <String CONTENT="желѣзный домъ на краю моря. Рядомъ съ домомъ пасется стадо, у оленей" HPOS="1192" VPOS="2297" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-244_l13" HPOS="1194" VPOS="2425" WIDTH="2989" HEIGHT="96" BASELINE="1194 2520 4183 2520">
            <Shape>
              <Polygon POINTS="1194 2425 4183 2425 4183 2521 1194 2521"/>
            </Shape>
            <String CONTENT="ноги не гнутся на суставахъ. Пасутся, а когда хотятъ спать, тутъ вездѣ" HPOS="1194" VPOS="2425" WIDTH="2989" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-244_l14" HPOS="1195" VPOS="2548" WIDTH="2982" HEIGHT="97" BASELINE="1195 2644 4177 2644">
            <Shape>
              <Polygon POINTS="1195 2548 4177 2548 4177 2645 1195 2645"/>
            </Shape>
            <String CONTENT="натыканы палки, вышиной съ оленей; они опираются на нихъ плечами и" HPOS="1195" VPOS="2548" WIDTH="2982" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-244_l15" HPOS="1196" VPOS="2654" WIDTH="2984" HEIGHT="118" BASELINE="1196 2771 4180 2771">
            <Shape>
              <Polygon POINTS="1196 2654 4180 2654 4180 2772 1196 2772"/>
            </Shape>
            <String CONTENT="спятъ. Младшій говоритъ старшему: «Я добуду одного!» Подошелъ, одно" HPOS="1196" VPOS="2654" WIDTH="2984" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-244_l16" HPOS="1197" VPOS="2795" WIDTH="2980" HEIGHT="101" BASELINE="1197 2895 4177 2895">
            <Shape>
              <Polygon POINTS="1197 2795 4177 2795 4177 2896 1197 2896"/>
            </Shape>
            <String CONTENT="дерево подрѣзалъ ножемъ. Олень пересталъ пастись, захотѣлъ заснуть," HPOS="1197" VPOS="2795" WIDTH="2980" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-244_l17" HPOS="1200" VPOS="2922" WIDTH="2983" HEIGHT="100" BASELINE="1200 3021 4183 3021">
            <Shape>
              <Polygon POINTS="1200 2922 4183 2922 4183 3022 1200 3022"/>
            </Shape>
            <String CONTENT="подошелъ къ дереву, оперся и покатился. Они его убили, приготовили ѣду" HPOS="1200" VPOS="2922" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-244_l18" HPOS="1198" VPOS="3042" WIDTH="2981" HEIGHT="106" BASELINE="1198 3147 4179 3147">
            <Shape>
              <Polygon POINTS="1198 3042 4179 3042 4179 3148 1198 3148"/>
            </Shape>
            <String CONTENT="и у полога въ шатрѣ сѣли. Вышло изъ глубины воды чудовище, человѣкъ" HPOS="1198" VPOS="3042" WIDTH="2981" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-244_l19" HPOS="1200" VPOS="3177" WIDTH="2981" HEIGHT="97" BASELINE="1200 3273 4181 3273">
            <Shape>
              <Polygon POINTS="1200 3177 4181 3177 4181 3274 1200 3274"/>
            </Shape>
            <String CONTENT="съ однимъ глазомъ на лбу, посмотрѣлъ въ темноту и говоритъ: «Стадо вы-" HPOS="1200" VPOS="3177" WIDTH="2981" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-244_l20" HPOS="1198" VPOS="3294" WIDTH="2985" HEIGHT="102" BASELINE="1198 3396 4183 3396">
            <Shape>
              <Polygon POINTS="1198 3294 4183 3294 4183 3396 1198 3396"/>
            </Shape>
            <String CONTENT="глядитъ уменьшившимся. Что за диво! Кто же укралъ?» Пошелъ въ глу-" HPOS="1198" VPOS="3294" WIDTH="2985" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-244_l21" HPOS="1198" VPOS="3418" WIDTH="2987" HEIGHT="105" BASELINE="1198 3522 4185 3522">
            <Shape>
              <Polygon POINTS="1198 3418 4185 3418 4185 3523 1198 3523"/>
            </Shape>
            <String CONTENT="бину моря, привелъ своихъ товарищей. Между ними одинъ шаманъ. Гости" HPOS="1198" VPOS="3418" WIDTH="2987" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-244_l22" HPOS="1202" VPOS="3545" WIDTH="2986" HEIGHT="102" BASELINE="1202 3646 4188 3646">
            <Shape>
              <Polygon POINTS="1202 3545 4188 3545 4188 3647 1202 3647"/>
            </Shape>
            <String CONTENT="спрятались подъ полою шатра. Шаманъ зашелъ въ желѣзный шатеръ и" HPOS="1202" VPOS="3545" WIDTH="2986" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-244_l23" HPOS="1203" VPOS="3676" WIDTH="2978" HEIGHT="96" BASELINE="1203 3772 4181 3772">
            <Shape>
              <Polygon POINTS="1203 3676 4181 3676 4181 3772 1203 3772"/>
            </Shape>
            <String CONTENT="двери закрылъ, какъ будто заперъ на замокъ. Потомъ вошелъ въ пологъ," HPOS="1203" VPOS="3676" WIDTH="2978" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-244_l24" HPOS="1204" VPOS="3799" WIDTH="2981" HEIGHT="100" BASELINE="1204 3898 4185 3898">
            <Shape>
              <Polygon POINTS="1204 3799 4185 3799 4185 3899 1204 3899"/>
            </Shape>
            <String CONTENT="сталъ шаманить. Куда бѣжать? Вверху только одна дырочка, какъ про-" HPOS="1204" VPOS="3799" WIDTH="2981" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-244_l25" HPOS="1204" VPOS="3927" WIDTH="2985" HEIGHT="98" BASELINE="1204 4025 4189 4025">
            <Shape>
              <Polygon POINTS="1204 3927 4189 3927 4189 4025 1204 4025"/>
            </Shape>
            <String CONTENT="ѣденная червякомъ оленьяго овода¹). Сталъ шарить старшій братъ, нашелъ" HPOS="1204" VPOS="3927" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-244_l26" HPOS="1202" VPOS="4054" WIDTH="2989" HEIGHT="95" BASELINE="1202 4149 4191 4149">
            <Shape>
              <Polygon POINTS="1202 4054 4191 4054 4191 4149 1202 4149"/>
            </Shape>
            <String CONTENT="пару перьевъ изъ крыла трясогузки. «Вотъ», говоритъ, «тебѣ перо и мнѣ" HPOS="1202" VPOS="4054" WIDTH="2989" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-244_l27" HPOS="1198" VPOS="4173" WIDTH="2992" HEIGHT="103" BASELINE="1198 4275 4190 4275">
            <Shape>
              <Polygon POINTS="1198 4173 4190 4173 4190 4276 1198 4276"/>
            </Shape>
            <String CONTENT="перо!» Шаманилъ, шаманилъ шаманъ и наконецъ вороній духъ увидѣлъ" HPOS="1198" VPOS="4173" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-244_l28" HPOS="1199" VPOS="4307" WIDTH="2989" HEIGHT="94" BASELINE="1199 4401 4188 4401">
            <Shape>
              <Polygon POINTS="1199 4307 4188 4307 4188 4401 1199 4401"/>
            </Shape>
            <String CONTENT="гостей. «Вотъ они! Берите ихъ!» Вдругъ братья вспорхнули трясогузками" HPOS="1199" VPOS="4307" WIDTH="2989" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-244_l29" HPOS="1197" VPOS="4432" WIDTH="2991" HEIGHT="99" BASELINE="1197 4530 4188 4530">
            <Shape>
              <Polygon POINTS="1197 4432 4188 4432 4188 4531 1197 4531"/>
            </Shape>
            <String CONTENT="и улетѣли сквозь дырку; и вороній духъ не могъ ихъ догнать. Прилетѣли" HPOS="1197" VPOS="4432" WIDTH="2991" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-244_l30" HPOS="1197" VPOS="4544" WIDTH="2987" HEIGHT="110" BASELINE="1197 4653 4184 4653">
            <Shape>
              <Polygon POINTS="1197 4544 4184 4544 4184 4654 1197 4654"/>
            </Shape>
            <String CONTENT="на берегъ моря; стали людьми. Старичекъ на берегу рубитъ дрова. «Ты" HPOS="1197" VPOS="4544" WIDTH="2987" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-244_l31" HPOS="1200" VPOS="4625" WIDTH="2986" HEIGHT="135" BASELINE="1200 4759 4186 4759">
            <Shape>
              <Polygon POINTS="1200 4625 4186 4625 4186 4760 1200 4760"/>
            </Shape>
            <String CONTENT="кто такой?» — «Да мой отецъ съ братомъ когда-то ушли на сѣндуху во" HPOS="1200" VPOS="4625" WIDTH="2986" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-244_l32" HPOS="1205" VPOS="4773" WIDTH="2982" HEIGHT="129" BASELINE="1205 4902 4187 4902">
            <Shape>
              <Polygon POINTS="1205 4773 4187 4773 4187 4902 1205 4902"/>
            </Shape>
            <String CONTENT="время вѣтра и пропали». — «Это твой сынъ!» говоритъ младшій братъ стар-" HPOS="1205" VPOS="4773" WIDTH="2982" HEIGHT="129"/>
          </TextLine>
          <TextLine ID="mz_1-244_l33" HPOS="1205" VPOS="4929" WIDTH="2984" HEIGHT="101" BASELINE="1205 5029 4189 5029">
            <Shape>
              <Polygon POINTS="1205 4929 4189 4929 4189 5030 1205 5030"/>
            </Shape>
            <String CONTENT="шему. Ибо когда ушли, у старшаго беременная жена. Взглянули другъ на" HPOS="1205" VPOS="4929" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-244_l34" HPOS="1196" VPOS="5037" WIDTH="2995" HEIGHT="119" BASELINE="1196 5155 4191 5155">
            <Shape>
              <Polygon POINTS="1196 5037 4191 5037 4191 5156 1196 5156"/>
            </Shape>
            <String CONTENT="друга и умерли. А съ труповъ вспорхнули двѣ трясогузки и улетѣли на" HPOS="1196" VPOS="5037" WIDTH="2995" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-244_l35" HPOS="1205" VPOS="5187" WIDTH="333" HEIGHT="93" BASELINE="1205 5278 1538 5278">
            <Shape>
              <Polygon POINTS="1205 5187 1538 5187 1538 5280 1205 5280"/>
            </Shape>
            <String CONTENT="сѣндуху." HPOS="1205" VPOS="5187" WIDTH="333" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-244_l36" HPOS="1404" VPOS="5288" WIDTH="2450" HEIGHT="101" BASELINE="1404 5388 3854 5388">
            <Shape>
              <Polygon POINTS="1404 5288 3854 5288 3854 5389 1404 5389"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Ваатту́wђе на урочищѣ Сухарномъ въ 1897 г." HPOS="1404" VPOS="5288" WIDTH="2450" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-244_l37" HPOS="1411" VPOS="5512" WIDTH="2774" HEIGHT="109" BASELINE="1411 5620 4185 5620">
            <Shape>
              <Polygon POINTS="1411 5512 4185 5512 4185 5621 1411 5621"/>
            </Shape>
            <String CONTENT="1) рычва́lђын — крупная личинка оленьяго овода. Такія личинки выводятся" HPOS="1411" VPOS="5512" WIDTH="2774" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-244_l38" HPOS="1195" VPOS="5632" WIDTH="786" HEIGHT="70" BASELINE="1195 5702 1981 5702">
            <Shape>
              <Polygon POINTS="1195 5632 1981 5632 1981 5702 1195 5702"/>
            </Shape>
            <String CONTENT="въ кожѣ живого оленя." HPOS="1195" VPOS="5632" WIDTH="786" HEIGHT="70"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
