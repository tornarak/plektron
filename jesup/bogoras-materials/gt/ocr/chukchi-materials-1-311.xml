        <TextBlock ID="text_1-311" HPOS="579" VPOS="564" WIDTH="3039" HEIGHT="5215">
          <TextLine ID="mz_1-311_l1" HPOS="579" VPOS="564" WIDTH="2988" HEIGHT="100" BASELINE="579 662 3567 662">
            <Shape>
              <Polygon POINTS="579 564 3567 564 3567 664 579 664"/>
            </Shape>
            <String CONTENT="II,93. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 255" HPOS="579" VPOS="564" WIDTH="2988" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l2" HPOS="591" VPOS="734" WIDTH="2974" HEIGHT="145" BASELINE="591 878 3565 878">
            <Shape>
              <Polygon POINTS="591 734 3565 734 3565 879 591 879"/>
            </Shape>
            <String CONTENT="пойду за нимъ!» — «Нѣтъ, ужъ лучше я!» говоритъ младшій. Пошли" HPOS="591" VPOS="734" WIDTH="2974" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-311_l3" HPOS="594" VPOS="873" WIDTH="2978" HEIGHT="138" BASELINE="594 1011 3572 1011">
            <Shape>
              <Polygon POINTS="594 873 3572 873 3572 1011 594 1011"/>
            </Shape>
            <String CONTENT="вдвоемъ. Старику пошли на встрѣчу Таньги. Сѣлъ старичекъ. Пришли, —" HPOS="594" VPOS="873" WIDTH="2978" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-311_l4" HPOS="593" VPOS="1040" WIDTH="2980" HEIGHT="108" BASELINE="593 1147 3573 1147">
            <Shape>
              <Polygon POINTS="593 1040 3573 1040 3573 1148 593 1148"/>
            </Shape>
            <String CONTENT="онъ еще сидитъ. Окружили его со всѣхъ сторонъ. «Ђо-ђо́!» гаркнули. Онъ" HPOS="593" VPOS="1040" WIDTH="2980" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-311_l5" HPOS="592" VPOS="1169" WIDTH="2978" HEIGHT="96" BASELINE="592 1264 3570 1264">
            <Shape>
              <Polygon POINTS="592 1169 3570 1169 3570 1265 592 1265"/>
            </Shape>
            <String CONTENT="и не смотритъ, сидитъ, опустивъ голову, завязки обуви разсматриваетъ." HPOS="592" VPOS="1169" WIDTH="2978" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-311_l6" HPOS="595" VPOS="1285" WIDTH="2974" HEIGHT="104" BASELINE="595 1388 3569 1388">
            <Shape>
              <Polygon POINTS="595 1285 3569 1285 3569 1389 595 1389"/>
            </Shape>
            <String CONTENT="«Како́! смирный бычекъ!» Всталъ. Иные стояли даже тройнымъ рядомъ," HPOS="595" VPOS="1285" WIDTH="2974" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-311_l7" HPOS="594" VPOS="1416" WIDTH="2976" HEIGHT="100" BASELINE="594 1515 3570 1515">
            <Shape>
              <Polygon POINTS="594 1416 3570 1416 3570 1516 594 1516"/>
            </Shape>
            <String CONTENT="такъ много, иные двойнымъ, иные однимъ рядомъ. Старикъ вскочилъ, бро-" HPOS="594" VPOS="1416" WIDTH="2976" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l8" HPOS="595" VPOS="1541" WIDTH="2978" HEIGHT="101" BASELINE="595 1642 3573 1642">
            <Shape>
              <Polygon POINTS="595 1541 3573 1541 3573 1642 595 1642"/>
            </Shape>
            <String CONTENT="сился на стоящихъ тройнымъ рядомъ, прорѣзалъ путь. Они въ него стрѣ-" HPOS="595" VPOS="1541" WIDTH="2978" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-311_l9" HPOS="591" VPOS="1662" WIDTH="2978" HEIGHT="103" BASELINE="591 1764 3569 1764">
            <Shape>
              <Polygon POINTS="591 1662 3569 1662 3569 1765 591 1765"/>
            </Shape>
            <String CONTENT="лами. Онъ стрѣлы между пальцевъ пускаетъ, другія отбиваетъ копьемъ." HPOS="591" VPOS="1662" WIDTH="2978" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-311_l10" HPOS="595" VPOS="1791" WIDTH="2978" HEIGHT="98" BASELINE="595 1888 3573 1888">
            <Shape>
              <Polygon POINTS="595 1791 3573 1791 3573 1889 595 1889"/>
            </Shape>
            <String CONTENT="Опять стали стрѣлять; опять отбиваетъ; потомъ ихъ всѣхъ перебилъ" HPOS="595" VPOS="1791" WIDTH="2978" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-311_l11" HPOS="592" VPOS="1917" WIDTH="2982" HEIGHT="100" BASELINE="592 2017 3574 2017">
            <Shape>
              <Polygon POINTS="592 1917 3574 1917 3574 2017 592 2017"/>
            </Shape>
            <String CONTENT="копьемъ. Вернулъ домой стадо. Пригнавши, покочевали. Опять старикъ" HPOS="592" VPOS="1917" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l12" HPOS="593" VPOS="2045" WIDTH="2786" HEIGHT="101" BASELINE="593 2145 3379 2145">
            <Shape>
              <Polygon POINTS="593 2045 3379 2045 3379 2146 593 2146"/>
            </Shape>
            <String CONTENT="лежитъ, какъ будто не можетъ ходить, по прежнему сталъ безсиленъ." HPOS="593" VPOS="2045" WIDTH="2786" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-311_l13" HPOS="809" VPOS="2184" WIDTH="1632" HEIGHT="97" BASELINE="809 2281 2441 2281">
            <Shape>
              <Polygon POINTS="809 2184 2441 2184 2441 2281 809 2281"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Чэ́ӈэ на р. Россомашьей." HPOS="809" VPOS="2184" WIDTH="1632" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-311_l14" HPOS="2021" VPOS="2524" WIDTH="129" HEIGHT="104" BASELINE="2021 2627 2150 2627">
            <Shape>
              <Polygon POINTS="2021 2524 2150 2524 2150 2628 2021 2628"/>
            </Shape>
            <String CONTENT="94." HPOS="2021" VPOS="2524" WIDTH="129" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-311_l15" HPOS="1228" VPOS="2690" WIDTH="1743" HEIGHT="119" BASELINE="1228 2808 2971 2808">
            <Shape>
              <Polygon POINTS="1228 2690 2971 2690 2971 2809 1228 2809"/>
            </Shape>
            <String CONTENT="Lы́мыlы-lѵ́мӈыl. О двоеженцѣ сказка." HPOS="1228" VPOS="2690" WIDTH="1743" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-311_l16" HPOS="815" VPOS="2889" WIDTH="2770" HEIGHT="112" BASELINE="815 3001 3585 3001">
            <Shape>
              <Polygon POINTS="815 2889 3585 2889 3585 3001 815 3001"/>
            </Shape>
            <String CONTENT="Жилъ человѣкъ съ двумя женами: старой и молодой. Когда молодую" HPOS="815" VPOS="2889" WIDTH="2770" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-311_l17" HPOS="605" VPOS="3029" WIDTH="2979" HEIGHT="96" BASELINE="605 3124 3584 3124">
            <Shape>
              <Polygon POINTS="605 3029 3584 3029 3584 3125 605 3125"/>
            </Shape>
            <String CONTENT="взялъ, старую бросилъ и пересталъ ее любить и спать съ нею. Она отъ" HPOS="605" VPOS="3029" WIDTH="2979" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-311_l18" HPOS="609" VPOS="3159" WIDTH="2980" HEIGHT="100" BASELINE="609 3258 3589 3258">
            <Shape>
              <Polygon POINTS="609 3159 3589 3159 3589 3259 609 3259"/>
            </Shape>
            <String CONTENT="великой печали на сѣндуху бродитъ. Думаетъ: «Пусть я лучше погибну," HPOS="609" VPOS="3159" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l19" HPOS="604" VPOS="3281" WIDTH="2985" HEIGHT="104" BASELINE="604 3384 3589 3384">
            <Shape>
              <Polygon POINTS="604 3281 3589 3281 3589 3385 604 3385"/>
            </Shape>
            <String CONTENT="чѣмъ такъ жить.» Ходила, вся иззябла; видно: берлога; думаетъ: «дай," HPOS="604" VPOS="3281" WIDTH="2985" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-311_l20" HPOS="608" VPOS="3400" WIDTH="2985" HEIGHT="109" BASELINE="608 3508 3593 3508">
            <Shape>
              <Polygon POINTS="608 3400 3593 3400 3593 3509 608 3509"/>
            </Shape>
            <String CONTENT="зайду хоть сюда!» Зашла. Въ темнотѣ стала руками щупать, нащупала" HPOS="608" VPOS="3400" WIDTH="2985" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-311_l21" HPOS="610" VPOS="3526" WIDTH="2981" HEIGHT="103" BASELINE="610 3629 3591 3629">
            <Shape>
              <Polygon POINTS="610 3526 3591 3526 3591 3629 610 3629"/>
            </Shape>
            <String CONTENT="шерсть; думаетъ про себя: «что это?» Слышитъ, говоритъ ей человѣческій" HPOS="610" VPOS="3526" WIDTH="2981" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-311_l22" HPOS="611" VPOS="3639" WIDTH="2984" HEIGHT="119" BASELINE="611 3758 3595 3758">
            <Shape>
              <Polygon POINTS="611 3639 3595 3639 3595 3758 611 3758"/>
            </Shape>
            <String CONTENT="голосъ: «Ты зачѣмъ ко мнѣ пришла? Я медвѣдь, это медвѣжье жилище; я" HPOS="611" VPOS="3639" WIDTH="2984" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-311_l23" HPOS="608" VPOS="3728" WIDTH="2983" HEIGHT="157" BASELINE="608 3884 3591 3884">
            <Shape>
              <Polygon POINTS="608 3728 3591 3728 3591 3885 608 3885"/>
            </Shape>
            <String CONTENT="тебя съѣмъ!» — «Я ушла отъ великой печали; если хочешь, съѣшь ме-" HPOS="608" VPOS="3728" WIDTH="2983" HEIGHT="157"/>
          </TextLine>
          <TextLine ID="mz_1-311_l24" HPOS="615" VPOS="3868" WIDTH="2983" HEIGHT="147" BASELINE="615 4014 3598 4014">
            <Shape>
              <Polygon POINTS="615 3868 3598 3868 3598 4015 615 4015"/>
            </Shape>
            <String CONTENT="ня!» — «Довольно», говоритъ медвѣдь, «я ѣсть не стану; но какъ ты будешь" HPOS="615" VPOS="3868" WIDTH="2983" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-311_l25" HPOS="615" VPOS="4020" WIDTH="2977" HEIGHT="116" BASELINE="615 4135 3592 4135">
            <Shape>
              <Polygon POINTS="615 4020 3592 4020 3592 4136 615 4136"/>
            </Shape>
            <String CONTENT="жить? У меня ѣды нѣтъ, я ѣмъ землю, сплю всю зиму. Только когда ста-" HPOS="615" VPOS="4020" WIDTH="2977" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-311_l26" HPOS="619" VPOS="4177" WIDTH="2980" HEIGHT="85" BASELINE="619 4262 3599 4262">
            <Shape>
              <Polygon POINTS="619 4177 3599 4177 3599 4262 619 4262"/>
            </Shape>
            <String CONTENT="нетъ слишкомъ жарко, птица прилетитъ, и важенки начнутъ телиться," HPOS="619" VPOS="4177" WIDTH="2980" HEIGHT="85"/>
          </TextLine>
          <TextLine ID="mz_1-311_l27" HPOS="616" VPOS="4270" WIDTH="2981" HEIGHT="120" BASELINE="616 4389 3597 4389">
            <Shape>
              <Polygon POINTS="616 4270 3597 4270 3597 4390 616 4390"/>
            </Shape>
            <String CONTENT="тогда я выхожу. А ты что дѣлать станешь? Вотъ въ углу навалено сырое" HPOS="616" VPOS="4270" WIDTH="2981" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-311_l28" HPOS="622" VPOS="4370" WIDTH="2980" HEIGHT="146" BASELINE="622 4515 3602 4515">
            <Shape>
              <Polygon POINTS="622 4370 3602 4370 3602 4516 622 4516"/>
            </Shape>
            <String CONTENT="оленье мясо: хочешь ѣсть — ѣшь и живи, или спи, или такъ ходи; если" HPOS="622" VPOS="4370" WIDTH="2980" HEIGHT="146"/>
          </TextLine>
          <TextLine ID="mz_1-311_l29" HPOS="621" VPOS="4543" WIDTH="2983" HEIGHT="105" BASELINE="621 4647 3604 4647">
            <Shape>
              <Polygon POINTS="621 4543 3604 4543 3604 4648 621 4648"/>
            </Shape>
            <String CONTENT="отказываешься спать, твой умъ. Если станешь жить, ты меня разбуди, какъ" HPOS="621" VPOS="4543" WIDTH="2983" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-311_l30" HPOS="621" VPOS="4631" WIDTH="2980" HEIGHT="136" BASELINE="621 4766 3601 4766">
            <Shape>
              <Polygon POINTS="621 4631 3601 4631 3601 4767 621 4767"/>
            </Shape>
            <String CONTENT="тепло станетъ; вотъ камень, имъ будешь меня колотить по носу.» — «Какъ»," HPOS="621" VPOS="4631" WIDTH="2980" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-311_l31" HPOS="622" VPOS="4760" WIDTH="2982" HEIGHT="137" BASELINE="622 4896 3604 4896">
            <Shape>
              <Polygon POINTS="622 4760 3604 4760 3604 4897 622 4897"/>
            </Shape>
            <String CONTENT="говоритъ, «я тебя стану колотить, быть можетъ, я тебя убью.» — «Не бойся" HPOS="622" VPOS="4760" WIDTH="2982" HEIGHT="137"/>
          </TextLine>
          <TextLine ID="mz_1-311_l32" HPOS="627" VPOS="4924" WIDTH="2980" HEIGHT="100" BASELINE="627 5024 3607 5024">
            <Shape>
              <Polygon POINTS="627 4924 3607 4924 3607 5024 627 5024"/>
            </Shape>
            <String CONTENT="ничего», говоритъ, «колоти!» Сказалъ и заснулъ. Она и стала жить. Сырое" HPOS="627" VPOS="4924" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l33" HPOS="626" VPOS="5045" WIDTH="2986" HEIGHT="100" BASELINE="626 5144 3612 5144">
            <Shape>
              <Polygon POINTS="626 5045 3612 5045 3612 5145 626 5145"/>
            </Shape>
            <String CONTENT="мясо ѣстъ; когда спитъ, когда не спитъ. Наконецъ зима прошла, стала" HPOS="626" VPOS="5045" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-311_l34" HPOS="631" VPOS="5173" WIDTH="2979" HEIGHT="102" BASELINE="631 5274 3610 5274">
            <Shape>
              <Polygon POINTS="631 5173 3610 5173 3610 5275 631 5275"/>
            </Shape>
            <String CONTENT="птица прилетать. Она его будитъ, камнемъ по носу колотитъ, отъ этого" HPOS="631" VPOS="5173" WIDTH="2979" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-311_l35" HPOS="634" VPOS="5299" WIDTH="2974" HEIGHT="102" BASELINE="634 5400 3608 5400">
            <Shape>
              <Polygon POINTS="634 5299 3608 5299 3608 5401 634 5401"/>
            </Shape>
            <String CONTENT="онъ пробудился, вышелъ изъ берлоги, говоритъ: «Иди теперь въ свой домъ," HPOS="634" VPOS="5299" WIDTH="2974" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-311_l36" HPOS="631" VPOS="5423" WIDTH="2987" HEIGHT="105" BASELINE="631 5528 3618 5528">
            <Shape>
              <Polygon POINTS="631 5423 3618 5423 3618 5528 631 5528"/>
            </Shape>
            <String CONTENT="я тебѣ дамъ вдохновеніе; мужъ будетъ любить тебя по прежнему и всѣ" HPOS="631" VPOS="5423" WIDTH="2987" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-311_l37" HPOS="633" VPOS="5551" WIDTH="2977" HEIGHT="104" BASELINE="633 5654 3610 5654">
            <Shape>
              <Polygon POINTS="633 5551 3610 5551 3610 5655 633 5655"/>
            </Shape>
            <String CONTENT="люди станутъ тебя любить и дарить (подарки)!» Пошла она, приходитъ къ" HPOS="633" VPOS="5551" WIDTH="2977" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-311_l38" HPOS="637" VPOS="5666" WIDTH="2976" HEIGHT="113" BASELINE="637 5778 3613 5778">
            <Shape>
              <Polygon POINTS="637 5666 3613 5666 3613 5779 637 5779"/>
            </Shape>
            <String CONTENT="мужу, говоритъ: «Ты гдѣ была? Ты должно-быть гдѣ-нибудь шаманству" HPOS="637" VPOS="5666" WIDTH="2976" HEIGHT="113"/>
          </TextLine>
        </TextBlock>
