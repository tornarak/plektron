        <TextBlock ID="text_1-303" HPOS="620" VPOS="548" WIDTH="3021" HEIGHT="5197">
          <TextLine ID="mz_1-303_l1" HPOS="620" VPOS="548" WIDTH="2988" HEIGHT="112" BASELINE="620 639 3608 639">
            <Shape>
              <Polygon POINTS="620 548 3608 548 3608 660 620 660"/>
            </Shape>
            <String CONTENT="II,90. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 247" HPOS="620" VPOS="548" WIDTH="2988" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-303_l2" HPOS="625" VPOS="746" WIDTH="2986" HEIGHT="104" BASELINE="625 849 3611 849">
            <Shape>
              <Polygon POINTS="625 746 3611 746 3611 850 625 850"/>
            </Shape>
            <String CONTENT="Онъ лежитъ на прежнемъ мѣстѣ. Убили и ему на пищу. Пришли къ тестю." HPOS="625" VPOS="746" WIDTH="2986" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-303_l3" HPOS="628" VPOS="874" WIDTH="2983" HEIGHT="104" BASELINE="628 978 3611 978">
            <Shape>
              <Polygon POINTS="628 874 3611 874 3611 978 628 978"/>
            </Shape>
            <String CONTENT="Онъ весьма состарился. Дали и тѣмъ духамъ, откуда носилъ мѣшки, убили" HPOS="628" VPOS="874" WIDTH="2983" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-303_l4" HPOS="624" VPOS="998" WIDTH="2987" HEIGHT="103" BASELINE="624 1100 3611 1100">
            <Shape>
              <Polygon POINTS="624 998 3611 998 3611 1101 624 1101"/>
            </Shape>
            <String CONTENT="и имъ на жертву. Пока они ѣли, онъ ихъ перебилъ, шатры изломавъ. Тестя" HPOS="624" VPOS="998" WIDTH="2987" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-303_l5" HPOS="626" VPOS="1134" WIDTH="2983" HEIGHT="99" BASELINE="626 1232 3609 1232">
            <Shape>
              <Polygon POINTS="626 1134 3609 1134 3609 1233 626 1233"/>
            </Shape>
            <String CONTENT="накормили жилами и мозгомъ, убили жирнаго (оленя). Захотѣлъ умереть." HPOS="626" VPOS="1134" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-303_l6" HPOS="626" VPOS="1217" WIDTH="2993" HEIGHT="138" BASELINE="626 1355 3619 1355">
            <Shape>
              <Polygon POINTS="626 1217 3619 1217 3619 1355 626 1355"/>
            </Shape>
            <String CONTENT="Говоритъ: «Давайте драться¹)! Не могу больше. На другой день уйдете!» —" HPOS="626" VPOS="1217" WIDTH="2993" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-303_l7" HPOS="629" VPOS="1371" WIDTH="2986" HEIGHT="114" BASELINE="629 1484 3615 1484">
            <Shape>
              <Polygon POINTS="629 1371 3615 1371 3615 1485 629 1485"/>
            </Shape>
            <String CONTENT="«Ну, ладно!» Убили и его, и жену, умертвили, унесли на сѣндуху, на скалу." HPOS="629" VPOS="1371" WIDTH="2986" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-303_l8" HPOS="630" VPOS="1510" WIDTH="2991" HEIGHT="101" BASELINE="630 1611 3621 1611">
            <Shape>
              <Polygon POINTS="630 1510 3621 1510 3621 1611 630 1611"/>
            </Shape>
            <String CONTENT="Тамъ убили оленей и сдѣлали надгробный знакъ²). Опять стали убивать" HPOS="630" VPOS="1510" WIDTH="2991" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-303_l9" HPOS="632" VPOS="1631" WIDTH="2989" HEIGHT="104" BASELINE="632 1734 3621 1734">
            <Shape>
              <Polygon POINTS="632 1631 3621 1631 3621 1735 632 1735"/>
            </Shape>
            <String CONTENT="(оленей). Стадо погнали на пастбище, убивши на ѣду жирныхъ. Сдѣлали" HPOS="632" VPOS="1631" WIDTH="2989" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-303_l10" HPOS="634" VPOS="1768" WIDTH="2981" HEIGHT="101" BASELINE="634 1868 3615 1868">
            <Shape>
              <Polygon POINTS="634 1768 3615 1768 3615 1869 634 1869"/>
            </Shape>
            <String CONTENT="снова ты́нмај. Покончили. Покончивъ ушли. Опять онъ закричалъ: «Тођо́!" HPOS="634" VPOS="1768" WIDTH="2981" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-303_l11" HPOS="632" VPOS="1890" WIDTH="2991" HEIGHT="98" BASELINE="632 1988 3623 1988">
            <Shape>
              <Polygon POINTS="632 1890 3623 1890 3623 1988 632 1988"/>
            </Shape>
            <String CONTENT="гоните!» Опять сучья и палки, бывшіе погонщиками, встали. Пригнали" HPOS="632" VPOS="1890" WIDTH="2991" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-303_l12" HPOS="644" VPOS="2011" WIDTH="2980" HEIGHT="94" BASELINE="644 2104 3624 2104">
            <Shape>
              <Polygon POINTS="644 2011 3624 2011 3624 2105 644 2105"/>
            </Shape>
            <String CONTENT="стадо къ дому. Стало многочисленно. Погнали домой. Стали объѣзжать" HPOS="644" VPOS="2011" WIDTH="2980" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-303_l13" HPOS="635" VPOS="2125" WIDTH="2251" HEIGHT="108" BASELINE="635 2233 2886 2233">
            <Shape>
              <Polygon POINTS="635 2125 2886 2125 2886 2233 635 2233"/>
            </Shape>
            <String CONTENT="стадо. Въ одинъ день не могутъ объѣхать, такъ велико." HPOS="635" VPOS="2125" WIDTH="2251" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-303_l14" HPOS="851" VPOS="2294" WIDTH="2275" HEIGHT="103" BASELINE="851 2396 3126 2396">
            <Shape>
              <Polygon POINTS="851 2294 3126 2294 3126 2397 851 2397"/>
            </Shape>
            <String CONTENT="Записано отъ чукчанки Кутјэ́ўт на р. Молондѣ въ 1895 году." HPOS="851" VPOS="2294" WIDTH="2275" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-303_l15" HPOS="2011" VPOS="2621" WIDTH="179" HEIGHT="108" BASELINE="2011 2729 2190 2729">
            <Shape>
              <Polygon POINTS="2011 2621 2190 2621 2190 2729 2011 2729"/>
            </Shape>
            <String CONTENT="91." HPOS="2011" VPOS="2621" WIDTH="179" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-303_l16" HPOS="1219" VPOS="2825" WIDTH="1819" HEIGHT="115" BASELINE="1219 2940 3038 2940">
            <Shape>
              <Polygon POINTS="1219 2825 3038 2825 3038 2940 1219 2940"/>
            </Shape>
            <String CONTENT="А́пӄаlы-ја́јвалӄај. Приморскій сиротка." HPOS="1219" VPOS="2825" WIDTH="1819" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-303_l17" HPOS="854" VPOS="3046" WIDTH="2772" HEIGHT="98" BASELINE="854 3143 3626 3143">
            <Shape>
              <Polygon POINTS="854 3046 3626 3046 3626 3144 854 3144"/>
            </Shape>
            <String CONTENT="Сиротка, мачихой только собачьимъ пометомъ питаемый, говоритъ:" HPOS="854" VPOS="3046" WIDTH="2772" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-303_l18" HPOS="640" VPOS="3163" WIDTH="2992" HEIGHT="102" BASELINE="640 3264 3632 3264">
            <Shape>
              <Polygon POINTS="640 3163 3632 3163 3632 3265 640 3265"/>
            </Shape>
            <String CONTENT="«Что за дѣло! Пусть посватаюсь у разсвѣтнаго народа³)!» Сдѣлалъ санки" HPOS="640" VPOS="3163" WIDTH="2992" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-303_l19" HPOS="640" VPOS="3292" WIDTH="2985" HEIGHT="98" BASELINE="640 3389 3625 3389">
            <Shape>
              <Polygon POINTS="640 3292 3625 3292 3625 3390 640 3390"/>
            </Shape>
            <String CONTENT="изъ китовыхъ реберъ и веревку изъ жилъ, пошелъ въ путь. Ростомъ великъ," HPOS="640" VPOS="3292" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-303_l20" HPOS="640" VPOS="3412" WIDTH="2991" HEIGHT="101" BASELINE="640 3512 3631 3512">
            <Shape>
              <Polygon POINTS="640 3412 3631 3412 3631 3513 640 3513"/>
            </Shape>
            <String CONTENT="плечи широкія, но весь въ чесоткѣ, самый бѣдный во всей землѣ. Ибо мать" HPOS="640" VPOS="3412" WIDTH="2991" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-303_l21" HPOS="640" VPOS="3549" WIDTH="2983" HEIGHT="89" BASELINE="640 3637 3623 3637">
            <Shape>
              <Polygon POINTS="640 3549 3623 3549 3623 3638 640 3638"/>
            </Shape>
            <String CONTENT="его умерла, отецъ взялъ другую жену, худую женщину и прежняя внутрен-" HPOS="640" VPOS="3549" WIDTH="2983" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-303_l22" HPOS="638" VPOS="3657" WIDTH="2989" HEIGHT="106" BASELINE="638 3762 3627 3762">
            <Shape>
              <Polygon POINTS="638 3657 3627 3657 3627 3763 638 3763"/>
            </Shape>
            <String CONTENT="ность у него исчезла и стала какъ-бы чужая⁴). Стадо его было все истре-" HPOS="638" VPOS="3657" WIDTH="2989" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-303_l23" HPOS="638" VPOS="3784" WIDTH="2995" HEIGHT="102" BASELINE="638 3886 3633 3886">
            <Shape>
              <Polygon POINTS="638 3784 3633 3784 3633 3886 638 3886"/>
            </Shape>
            <String CONTENT="блено и не было оленьихъ шкуръ и онъ одѣтъ былъ въ собачьи шкуры, а" HPOS="638" VPOS="3784" WIDTH="2995" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-303_l24" HPOS="645" VPOS="3905" WIDTH="2991" HEIGHT="89" BASELINE="645 3993 3636 3993">
            <Shape>
              <Polygon POINTS="645 3905 3636 3905 3636 3994 645 3994"/>
            </Shape>
            <String CONTENT="питался остатками отъ собакъ и собачьимъ пометомъ. Пошелъ онъ въ" HPOS="645" VPOS="3905" WIDTH="2991" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-303_l25" HPOS="653" VPOS="4037" WIDTH="2979" HEIGHT="100" BASELINE="653 4136 3632 4136">
            <Shape>
              <Polygon POINTS="653 4037 3632 4037 3632 4137 653 4137"/>
            </Shape>
            <String CONTENT="страну разсвѣта, шелъ до тѣхъ поръ, пока протопталъ свои ноги до костей" HPOS="653" VPOS="4037" WIDTH="2979" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-303_l26" HPOS="647" VPOS="4159" WIDTH="2984" HEIGHT="100" BASELINE="647 4258 3631 4258">
            <Shape>
              <Polygon POINTS="647 4159 3631 4159 3631 4259 647 4259"/>
            </Shape>
            <String CONTENT="и протеръ полозья китово-реберной нарты и встрѣтилъ двухъ россомахъ." HPOS="647" VPOS="4159" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-303_l27" HPOS="652" VPOS="4279" WIDTH="2983" HEIGHT="103" BASELINE="652 4381 3635 4381">
            <Shape>
              <Polygon POINTS="652 4279 3635 4279 3635 4382 652 4382"/>
            </Shape>
            <String CONTENT="Онѣ ему говорятъ: «Пойдешь на сторону разсвѣта, станешь подниматься" HPOS="652" VPOS="4279" WIDTH="2983" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-303_l28" HPOS="654" VPOS="4415" WIDTH="2980" HEIGHT="95" BASELINE="654 4509 3634 4509">
            <Shape>
              <Polygon POINTS="654 4415 3634 4415 3634 4510 654 4510"/>
            </Shape>
            <String CONTENT="по крутому подъему, дойдешь до верхней страны; тамъ увидишь на краю" HPOS="654" VPOS="4415" WIDTH="2980" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-303_l29" HPOS="653" VPOS="4528" WIDTH="2980" HEIGHT="99" BASELINE="653 4626 3633 4626">
            <Shape>
              <Polygon POINTS="653 4528 3633 4528 3633 4627 653 4627"/>
            </Shape>
            <String CONTENT="страны селеніе изъ десяти домовъ; тѣ дѣвушки очень худыя, насмѣшливыя." HPOS="653" VPOS="4528" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-303_l30" HPOS="648" VPOS="4655" WIDTH="2989" HEIGHT="100" BASELINE="648 4754 3637 4754">
            <Shape>
              <Polygon POINTS="648 4655 3637 4655 3637 4755 648 4755"/>
            </Shape>
            <String CONTENT="Пройдешь то селеніе, найдешь одиноко-стоящее жилище; въ томъ жилищѣ" HPOS="648" VPOS="4655" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-303_l31" HPOS="656" VPOS="4781" WIDTH="2982" HEIGHT="101" BASELINE="656 4881 3638 4881">
            <Shape>
              <Polygon POINTS="656 4781 3638 4781 3638 4882 656 4882"/>
            </Shape>
            <String CONTENT="три дѣвушки. Одна изъ нихъ будетъ твоя жена. Тамъ хорошо живи!»" HPOS="656" VPOS="4781" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-303_l32" HPOS="653" VPOS="4904" WIDTH="2988" HEIGHT="103" BASELINE="653 5006 3641 5006">
            <Shape>
              <Polygon POINTS="653 4904 3641 4904 3641 5007 653 5007"/>
            </Shape>
            <String CONTENT="Пошелъ дальше, встрѣтилъ волковъ, они сказали то-же самое, встрѣтилъ" HPOS="653" VPOS="4904" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-303_l33" HPOS="651" VPOS="4984" WIDTH="2988" HEIGHT="142" BASELINE="651 5126 3639 5126">
            <Shape>
              <Polygon POINTS="651 4984 3639 4984 3639 5126 651 5126"/>
            </Shape>
            <String CONTENT="медвѣдей — то-же самое; бѣлыхъ медвѣдей, дикихъ оленей, лосей, всѣхъ" HPOS="651" VPOS="4984" WIDTH="2988" HEIGHT="142"/>
          </TextLine>
          <TextLine ID="mz_1-303_l34" HPOS="879" VPOS="5210" WIDTH="2762" HEIGHT="98" BASELINE="879 5308 3641 5308">
            <Shape>
              <Polygon POINTS="879 5210 3641 5210 3641 5308 879 5308"/>
            </Shape>
            <String CONTENT="1) мынмара́wмык — «давайте драться!» составляетъ формулу предложенія" HPOS="879" VPOS="5210" WIDTH="2762" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-303_l35" HPOS="665" VPOS="5334" WIDTH="729" HEIGHT="81" BASELINE="665 5414 1394 5414">
            <Shape>
              <Polygon POINTS="665 5334 1394 5334 1394 5415 665 5415"/>
            </Shape>
            <String CONTENT="добровольной смерти." HPOS="665" VPOS="5334" WIDTH="729" HEIGHT="81"/>
          </TextLine>
          <TextLine ID="mz_1-303_l36" HPOS="875" VPOS="5403" WIDTH="2202" HEIGHT="120" BASELINE="875 5522 3077 5522">
            <Shape>
              <Polygon POINTS="875 5403 3077 5403 3077 5523 875 5523"/>
            </Shape>
            <String CONTENT="2) ты́нмај — груда оленьихъ роговъ, оставленныхъ на могилѣ." HPOS="875" VPOS="5403" WIDTH="2202" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-303_l37" HPOS="879" VPOS="5535" WIDTH="809" HEIGHT="102" BASELINE="879 5636 1688 5636">
            <Shape>
              <Polygon POINTS="879 5535 1688 5535 1688 5637 879 5637"/>
            </Shape>
            <String CONTENT="3) тӈа́ырђы-ра́мкын." HPOS="879" VPOS="5535" WIDTH="809" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-303_l38" HPOS="874" VPOS="5638" WIDTH="1953" HEIGHT="107" BASELINE="874 5744 2827 5744">
            <Shape>
              <Polygon POINTS="874 5638 2827 5638 2827 5745 874 5745"/>
            </Shape>
            <String CONTENT="4) пэ́нін ӄӓlэ́lвын у́јӈӓ нэ́lјі, ӄӓну́р тумукэ́ну нэ́lјі." HPOS="874" VPOS="5638" WIDTH="1953" HEIGHT="107"/>
          </TextLine>
