              <Polygon POINTS="1224 805 4211 805 4211 906 1224 906"/>
            </Shape>
            <String CONTENT="волка, онъ скрываетъ въ своемъ шатрѣ солнце и выпускаетъ его только" HPOS="1224" VPOS="805" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-040_l3" HPOS="1222" VPOS="923" WIDTH="2986" HEIGHT="105" BASELINE="1222 1027 4208 1027">
            <Shape>
              <Polygon POINTS="1222 923 4208 923 4208 1028 1222 1028"/>
            </Shape>
            <String CONTENT="въ обмѣнъ за двухъ сестеръ волка, взятыхъ имъ въ жены. Но жены свя-" HPOS="1222" VPOS="923" WIDTH="2986" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-040_l4" HPOS="1223" VPOS="1045" WIDTH="2983" HEIGHT="102" BASELINE="1223 1146 4206 1146">
