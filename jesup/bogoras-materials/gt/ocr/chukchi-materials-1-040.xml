              <Polygon POINTS="1223 1045 4206 1045 4206 1147 1223 1147"/>
            </Shape>
            <String CONTENT="зываютъ ворону языкъ и лишаютъ его дара слова. Быть можетъ, въ этой" HPOS="1223" VPOS="1045" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-040_l5" HPOS="1224" VPOS="1175" WIDTH="2986" HEIGHT="97" BASELINE="1224 1270 4210 1270">
            <Shape>
              <Polygon POINTS="1224 1175 4210 1175 4210 1272 1224 1272"/>
            </Shape>
            <String CONTENT="сказкѣ тоже отразилась рознь оленеводовъ и приморскихъ охотниковъ, съ" HPOS="1224" VPOS="1175" WIDTH="2986" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-040_l6" HPOS="1225" VPOS="1295" WIDTH="2978" HEIGHT="106" BASELINE="1225 1399 4203 1399">
            <Shape>
              <Polygon POINTS="1225 1295 4203 1295 4203 1401 1225 1401"/>
            </Shape>
            <String CONTENT="сочувствіемъ, склоняющимся въ сторону послѣднихъ. Въ другихъ сказкахъ" HPOS="1225" VPOS="1295" WIDTH="2978" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-040_l7" HPOS="1225" VPOS="1421" WIDTH="2981" HEIGHT="101" BASELINE="1225 1521 4206 1521">
            <Shape>
              <Polygon POINTS="1225 1421 4206 1421 4206 1522 1225 1522"/>
            </Shape>
            <String CONTENT="воронъ представляется мертвымъ для того, чтобы выманить у своей жены" HPOS="1225" VPOS="1421" WIDTH="2981" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-040_l8" HPOS="1223" VPOS="1545" WIDTH="2985" HEIGHT="103" BASELINE="1223 1647 4208 1647">
            <Shape>
              <Polygon POINTS="1223 1545 4208 1545 4208 1648 1223 1648"/>
            </Shape>
            <String CONTENT="весь запасъ пищи въ свою пользу, но она, узнавъ объ обманѣ, пугаетъ" HPOS="1223" VPOS="1545" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-040_l9" HPOS="1225" VPOS="1672" WIDTH="2980" HEIGHT="99" BASELINE="1225 1769 4205 1769">
            <Shape>
              <Polygon POINTS="1225 1672 4205 1672 4205 1771 1225 1771"/>
            </Shape>
            <String CONTENT="его посредствомъ полуощипанной живой куропатки. Послѣ этого воронъ" HPOS="1225" VPOS="1672" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-040_l10" HPOS="1212" VPOS="1796" WIDTH="2990" HEIGHT="99" BASELINE="1212 1894 4202 1894">
            <Shape>
              <Polygon POINTS="1212 1796 4202 1796 4202 1895 1212 1895"/>
            </Shape>
            <String CONTENT="уѣзжаеть на двухъ зайцахъ въ сторону разсвѣта къ великанамъ, дѣлаю-" HPOS="1212" VPOS="1796" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-040_l11" HPOS="1222" VPOS="1913" WIDTH="2981" HEIGHT="106" BASELINE="1222 2017 4203 2017">
            <Shape>
              <Polygon POINTS="1222 1913 4203 1913 4203 2019 1222 2019"/>
            </Shape>
            <String CONTENT="щимъ вѣтеръ, употребляя лодку вмѣсто саней и при помощи счастливаго" HPOS="1222" VPOS="1913" WIDTH="2981" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-040_l12" HPOS="1223" VPOS="2043" WIDTH="2982" HEIGHT="103" BASELINE="1223 2146 4205 2146">
            <Shape>
              <Polygon POINTS="1223 2043 4205 2043 4205 2146 1223 2146"/>
            </Shape>
            <String CONTENT="обмана увозитъ отъ нихъ весь запасъ пищи, одежду и орудія. Онъ является" HPOS="1223" VPOS="2043" WIDTH="2982" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-040_l13" HPOS="1220" VPOS="2168" WIDTH="2982" HEIGHT="101" BASELINE="1220 2267 4202 2267">
            <Shape>
              <Polygon POINTS="1220 2168 4202 2168 4202 2269 1220 2269"/>
            </Shape>
            <String CONTENT="великимъ шаманомъ, гораздо болѣе сильнымъ, чѣмъ соперничающій съ" HPOS="1220" VPOS="2168" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-040_l14" HPOS="1220" VPOS="2272" WIDTH="2982" HEIGHT="116" BASELINE="1220 2387 4202 2387">
            <Shape>
              <Polygon POINTS="1220 2272 4202 2272 4202 2388 1220 2388"/>
            </Shape>
            <String CONTENT="нимъ заморскій шаманъ-человѣкъ. Въ сказкѣ № 111 воронъ представленъ" HPOS="1220" VPOS="2272" WIDTH="2982" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-040_l15" HPOS="1219" VPOS="2415" WIDTH="2983" HEIGHT="98" BASELINE="1219 2511 4202 2511">
            <Shape>
              <Polygon POINTS="1219 2415 4202 2415 4202 2513 1219 2513"/>
            </Shape>
            <String CONTENT="быстрымъ въ полетѣ и смѣлымъ, превосходящимъ этими качествами своего" HPOS="1219" VPOS="2415" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-040_l16" HPOS="1215" VPOS="2537" WIDTH="2986" HEIGHT="104" BASELINE="1215 2638 4201 2638">
            <Shape>
              <Polygon POINTS="1215 2537 4201 2537 4201 2641 1215 2641"/>
            </Shape>
            <String CONTENT="товарища въ смѣнномъ бракѣ орла, и побѣждающемъ заморскаго орла-" HPOS="1215" VPOS="2537" WIDTH="2986" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-040_l17" HPOS="1222" VPOS="2660" WIDTH="2978" HEIGHT="104" BASELINE="1222 2761 4200 2761">
            <Shape>
              <Polygon POINTS="1222 2660 4200 2660 4200 2764 1222 2764"/>
            </Shape>
            <String CONTENT="шамана. Но въ другой сказкѣ воронъ влюбляется въ собственное изобра-" HPOS="1222" VPOS="2660" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-040_l18" HPOS="1215" VPOS="2792" WIDTH="2985" HEIGHT="99" BASELINE="1215 2889 4200 2889">
            <Shape>
              <Polygon POINTS="1215 2792 4200 2792 4200 2891 1215 2891"/>
            </Shape>
            <String CONTENT="женіе, отраженное изъ ручья, и тонеть, желая съ нимъ ближе по-" HPOS="1215" VPOS="2792" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-040_l19" HPOS="1214" VPOS="2952" WIDTH="493" HEIGHT="67" BASELINE="1214 3018 1707 3018">
            <Shape>
              <Polygon POINTS="1214 2952 1707 2952 1707 3019 1214 3019"/>
            </Shape>
            <String CONTENT="знакомиться." HPOS="1214" VPOS="2952" WIDTH="493" HEIGHT="67"/>
          </TextLine>
          <TextLine ID="mz_1-040_l20" HPOS="1430" VPOS="3062" WIDTH="2770" HEIGHT="101" BASELINE="1430 3162 4200 3162">
            <Shape>
              <Polygon POINTS="1430 3062 4200 3062 4200 3163 1430 3163"/>
            </Shape>
            <String CONTENT="Лисица, которая постоянно смѣшивается съ одноименнымъ ей песцомъ," HPOS="1430" VPOS="3062" WIDTH="2770" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-040_l21" HPOS="1210" VPOS="3143" WIDTH="2993" HEIGHT="144" BASELINE="1210 3286 4203 3286">
            <Shape>
              <Polygon POINTS="1210 3143 4203 3143 4203 3287 1210 3287"/>
            </Shape>
            <String CONTENT="носитъ сказочное имя Ну́тэ-ӈэ́ўт — «Полевая женщина». Но сказка № 103" HPOS="1210" VPOS="3143" WIDTH="2993" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-040_l22" HPOS="1213" VPOS="3315" WIDTH="2988" HEIGHT="103" BASELINE="1213 3417 4201 3417">
            <Shape>
              <Polygon POINTS="1213 3315 4201 3315 4201 3418 1213 3418"/>
            </Shape>
            <String CONTENT="разсказываетъ, что лисица нѣкогда была человѣкомъ и притомъ мужчиной" HPOS="1213" VPOS="3315" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-040_l23" HPOS="1210" VPOS="3433" WIDTH="2986" HEIGHT="109" BASELINE="1210 3541 4196 3541">
            <Shape>
              <Polygon POINTS="1210 3433 4196 3433 4196 3542 1210 3542"/>
            </Shape>
            <String CONTENT="и обратилась въ звѣря впослѣдствіе испуга. Въ чукотскихъ сказкахъ лисица" HPOS="1210" VPOS="3433" WIDTH="2986" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-040_l24" HPOS="1207" VPOS="3565" WIDTH="2993" HEIGHT="105" BASELINE="1207 3669 4200 3669">
            <Shape>
              <Polygon POINTS="1207 3565 4200 3565 4200 3670 1207 3670"/>
            </Shape>
            <String CONTENT="изображается столь-же хитрою, какъ и въ сказкахъ арійскихъ народовъ," HPOS="1207" VPOS="3565" WIDTH="2993" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-040_l25" HPOS="1215" VPOS="3698" WIDTH="2983" HEIGHT="98" BASELINE="1215 3796 4198 3796">
            <Shape>
              <Polygon POINTS="1215 3698 4198 3698 4198 3796 1215 3796"/>
            </Shape>
            <String CONTENT="она убиваетъ медвѣдя подъ видомъ леченія, заставляетъ волка приморозить" HPOS="1215" VPOS="3698" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-040_l26" HPOS="1207" VPOS="3822" WIDTH="2993" HEIGHT="99" BASELINE="1207 3920 4200 3920">
            <Shape>
              <Polygon POINTS="1207 3822 4200 3822 4200 3921 1207 3921"/>
            </Shape>
            <String CONTENT="и оторвать хвость, обманываетъ звѣрей и людей и перекрасивъ свою" HPOS="1207" VPOS="3822" WIDTH="2993" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-040_l27" HPOS="1211" VPOS="3945" WIDTH="2984" HEIGHT="96" BASELINE="1211 4040 4195 4040">
            <Shape>
              <Polygon POINTS="1211 3945 4195 3945 4195 4041 1211 4041"/>
            </Shape>
            <String CONTENT="шерсть выдаетъ себя за новое лицо. Иногда впрочемъ и она попадаетъ въ" HPOS="1211" VPOS="3945" WIDTH="2984" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-040_l28" HPOS="1206" VPOS="4045" WIDTH="2988" HEIGHT="126" BASELINE="1206 4171 4194 4171">
            <Shape>
              <Polygon POINTS="1206 4045 4194 4045 4194 4171 1206 4171"/>
            </Shape>
            <String CONTENT="несчастье, какъ въ № 158, и вся ея хитрость не можетъ помочь ей освобо-" HPOS="1206" VPOS="4045" WIDTH="2988" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-040_l29" HPOS="1205" VPOS="4202" WIDTH="2992" HEIGHT="104" BASELINE="1205 4306 4197 4306">
            <Shape>
              <Polygon POINTS="1205 4202 4197 4202 4197 4306 1205 4306"/>
            </Shape>
            <String CONTENT="диться. Чукчи считаютъ песца не менѣе хитрымъ, чѣмъ настоящая лисица," HPOS="1205" VPOS="4202" WIDTH="2992" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-040_l30" HPOS="1206" VPOS="4297" WIDTH="2986" HEIGHT="126" BASELINE="1206 4422 4192 4422">
            <Shape>
              <Polygon POINTS="1206 4297 4192 4297 4192 4423 1206 4423"/>
            </Shape>
            <String CONTENT="напр. герой сказки № 119, восхваляя свою собственную хитрость назы-" HPOS="1206" VPOS="4297" WIDTH="2986" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-040_l31" HPOS="1214" VPOS="4445" WIDTH="1352" HEIGHT="101" BASELINE="1214 4545 2566 4545">
            <Shape>
              <Polygon POINTS="1214 4445 2566 4445 2566 4546 1214 4546"/>
            </Shape>
            <String CONTENT="ваетъ самъ себя песцово-умнымъ." HPOS="1214" VPOS="4445" WIDTH="1352" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-040_l32" HPOS="1414" VPOS="4568" WIDTH="2780" HEIGHT="98" BASELINE="1414 4666 4194 4666">
            <Shape>
              <Polygon POINTS="1414 4568 4194 4568 4194 4666 1414 4666"/>
            </Shape>
            <String CONTENT="Черный медвѣдь называется въ сказкахъ своимъ настоящимъ именемъ" HPOS="1414" VPOS="4568" WIDTH="2780" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-040_l33" HPOS="1200" VPOS="4698" WIDTH="2994" HEIGHT="102" BASELINE="1200 4799 4194 4799">
            <Shape>
              <Polygon POINTS="1200 4698 4194 4698 4194 4800 1200 4800"/>
            </Shape>
            <String CONTENT="Кэ́јӈын, но въ шаманскомъ обиходѣ его называютъ чэ́јвуlыӄӓј «ходящій" HPOS="1200" VPOS="4698" WIDTH="2994" HEIGHT="102"/>
          </TextLine>
