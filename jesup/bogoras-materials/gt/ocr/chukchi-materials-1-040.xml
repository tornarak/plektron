            <Shape>
              <Polygon POINTS="1203 4820 4189 4820 4189 4924 1203 4924"/>
            </Shape>
            <String CONTENT="пѣшкомъ», уwэ́lӓӄӓј «черненькій», также мэwэ́тчы «живущій подъ яромъ»." HPOS="1203" VPOS="4820" WIDTH="2986" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-040_l35" HPOS="1200" VPOS="4923" WIDTH="2992" HEIGHT="123" BASELINE="1200 5045 4192 5045">
            <Shape>
              <Polygon POINTS="1200 4923 4192 4923 4192 5046 1200 5046"/>
            </Shape>
            <String CONTENT="Въ №№ 104 и 105 онъ изображенъ глупымъ и поддающимся всякому" HPOS="1200" VPOS="4923" WIDTH="2992" HEIGHT="123"/>
          </TextLine>
          <TextLine ID="mz_1-040_l36" HPOS="1205" VPOS="5058" WIDTH="2987" HEIGHT="118" BASELINE="1205 5175 4192 5175">
            <Shape>
              <Polygon POINTS="1205 5058 4192 5058 4192 5176 1205 5176"/>
            </Shape>
            <String CONTENT="обману. Человѣка, которому онъ даетъ имя кошечной головы (ты́мкыlђы" HPOS="1205" VPOS="5058" WIDTH="2987" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-040_l37" HPOS="1205" VPOS="5189" WIDTH="2982" HEIGHT="106" BASELINE="1205 5294 4187 5294">
            <Shape>
              <Polygon POINTS="1205 5189 4187 5189 4187 5295 1205 5295"/>
            </Shape>
            <String CONTENT="-lэ́ўт), онъ не боится, но иногда за излишнюю храбрость платится жизнью." HPOS="1205" VPOS="5189" WIDTH="2982" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-040_l38" HPOS="1202" VPOS="5317" WIDTH="2433" HEIGHT="102" BASELINE="1202 5418 3635 5418">
            <Shape>
              <Polygon POINTS="1202 5317 3635 5317 3635 5419 1202 5419"/>
            </Shape>
            <String CONTENT="За то медвѣдь очень боится внезапно взлетающей куропатки." HPOS="1202" VPOS="5317" WIDTH="2433" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-040_l39" HPOS="1414" VPOS="5439" WIDTH="2771" HEIGHT="107" BASELINE="1414 5546 4185 5546">
            <Shape>
              <Polygon POINTS="1414 5439 4185 5439 4185 5546 1414 5546"/>
            </Shape>
            <String CONTENT="Въ другихъ сказкахъ напротивъ того черный медвѣдь изображенъ" HPOS="1414" VPOS="5439" WIDTH="2771" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-040_l40" HPOS="1200" VPOS="5569" WIDTH="2987" HEIGHT="102" BASELINE="1200 5671 4187 5671">
            <Shape>
              <Polygon POINTS="1200 5569 4187 5569 4187 5671 1200 5671"/>
            </Shape>
            <String CONTENT="могущественнымъ шаманомъ, который въ состояніи облагодѣтельствовать" HPOS="1200" VPOS="5569" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
