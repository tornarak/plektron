            </Shape>
            <String CONTENT="тѣмъ какъ между собою чукчи ихъ никогда не употребляютъ. Я склоненъ считать" HPOS="1240" VPOS="5135" WIDTH="2994" HEIGHT="92"/>
          </TextLine>
