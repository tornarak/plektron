            </Shape>
            <String CONTENT="«Богъ». Эти слова употребляются исключительно въ чукотско-русскомъ жаргонѣ, между" HPOS="1245" VPOS="5021" WIDTH="2983" HEIGHT="92"/>
          </TextLine>
