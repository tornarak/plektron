              <Polygon POINTS="771 5184 3550 5184 3550 5286 771 5286"/>
            </Shape>
            <String CONTENT="Рядомъ съ этими частными заимствованіями, существуетъ цѣлый" HPOS="771" VPOS="5184" WIDTH="2779" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-043_l38" HPOS="560" VPOS="5312" WIDTH="2986" HEIGHT="98" BASELINE="560 5408 3546 5408">
