              <Polygon POINTS="560 5312 3546 5312 3546 5410 560 5410"/>
            </Shape>
            <String CONTENT="отдѣлъ сказокъ, прямо переведенныхъ съ русскаго и только слегка измѣ-" HPOS="560" VPOS="5312" WIDTH="2986" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-043_l39" HPOS="563" VPOS="5432" WIDTH="2989" HEIGHT="103" BASELINE="563 5530 3552 5530">
            <Shape>
              <Polygon POINTS="563 5432 3552 5432 3552 5535 563 5535"/>
            </Shape>
            <String CONTENT="ненныхъ въ тѣхъ мѣстахъ, которыя чукчамъ были непонятны. Эти сказки" HPOS="563" VPOS="5432" WIDTH="2989" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-043_l40" HPOS="563" VPOS="5562" WIDTH="2991" HEIGHT="102" BASELINE="563 5661 3554 5661">
            <Shape>
              <Polygon POINTS="563 5562 3554 5562 3554 5664 563 5664"/>
            </Shape>
            <String CONTENT="такъ и называются «русскими» (та́н̀ӈен-lѵ́мӈыl)." HPOS="563" VPOS="5562" WIDTH="2991" HEIGHT="102"/>
          </TextLine>
