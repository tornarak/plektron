            <String CONTENT="МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. XXIII" HPOS="1028" VPOS="607" WIDTH="2493" HEIGHT="71"/>
          </TextLine>
          <TextLine ID="mz_1-043_l2" HPOS="534" VPOS="785" WIDTH="2989" HEIGHT="109" BASELINE="534 893 3523 893">
            <Shape>
              <Polygon POINTS="534 785 3523 785 3523 894 534 894"/>
            </Shape>
            <String CONTENT="противниками. Женщина, изъ-за которой идетъ споръ, тоже птичья жен-" HPOS="534" VPOS="785" WIDTH="2989" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-043_l3" HPOS="534" VPOS="914" WIDTH="2996" HEIGHT="102" BASELINE="534 1016 3530 1016">
            <Shape>
              <Polygon POINTS="534 914 3530 914 3530 1016 534 1016"/>
            </Shape>
            <String CONTENT="щина. Человѣкъ захватилъ ее во время купанія на озерѣ, захвативъ ея" HPOS="534" VPOS="914" WIDTH="2996" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-043_l4" HPOS="535" VPOS="1039" WIDTH="2994" HEIGHT="102" BASELINE="535 1140 3529 1140">
            <Shape>
              <Polygon POINTS="535 1039 3529 1039 3529 1141 535 1141"/>
            </Shape>
            <String CONTENT="одежду изъ бѣлыхъ перьевъ. Но поживъ съ нимъ нѣкоторое время она" HPOS="535" VPOS="1039" WIDTH="2994" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-043_l5" HPOS="532" VPOS="1167" WIDTH="2992" HEIGHT="98" BASELINE="532 1264 3524 1264">
            <Shape>
              <Polygon POINTS="532 1167 3524 1167 3524 1265 532 1265"/>
            </Shape>
            <String CONTENT="улетаетъ обратно на птичью землю вмѣстѣ со стаей перелетныхъ гусей," HPOS="532" VPOS="1167" WIDTH="2992" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-043_l6" HPOS="539" VPOS="1296" WIDTH="2987" HEIGHT="97" BASELINE="539 1392 3526 1392">
            <Shape>
              <Polygon POINTS="539 1296 3526 1296 3526 1393 539 1393"/>
            </Shape>
            <String CONTENT="которые бросаютъ ей по перу. Весь этотъ эпизодъ вѣроятно заимствованъ" HPOS="539" VPOS="1296" WIDTH="2987" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-043_l7" HPOS="531" VPOS="1409" WIDTH="2997" HEIGHT="108" BASELINE="531 1517 3528 1517">
            <Shape>
              <Polygon POINTS="531 1409 3528 1409 3528 1517 531 1517"/>
            </Shape>
            <String CONTENT="у русскихъ сказочниковъ. Въ замѣчательномъ разсказѣ о Ме́тыӈо описы-" HPOS="531" VPOS="1409" WIDTH="2997" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-043_l8" HPOS="541" VPOS="1543" WIDTH="2992" HEIGHT="105" BASELINE="541 1647 3533 1647">
            <Shape>
              <Polygon POINTS="541 1543 3533 1543 3533 1648 541 1648"/>
            </Shape>
            <String CONTENT="вается, какъ Ме́тыӈо жилъ съ оленями, лисицами, волками и потомъ былъ" HPOS="541" VPOS="1543" WIDTH="2992" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-043_l9" HPOS="538" VPOS="1675" WIDTH="2992" HEIGHT="94" BASELINE="538 1768 3530 1768">
            <Shape>
              <Polygon POINTS="538 1675 3530 1675 3530 1769 538 1769"/>
            </Shape>
            <String CONTENT="возвращенъ въ общество людей. Подробности разсказа довольно реальны" HPOS="538" VPOS="1675" WIDTH="2992" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-043_l10" HPOS="537" VPOS="1800" WIDTH="2997" HEIGHT="100" BASELINE="537 1899 3534 1899">
            <Shape>
              <Polygon POINTS="537 1800 3534 1800 3534 1900 537 1900"/>
            </Shape>
            <String CONTENT="и заставляютъ думать, что въ основѣ его можетъ лежать примѣръ болѣз-" HPOS="537" VPOS="1800" WIDTH="2997" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-043_l11" HPOS="543" VPOS="1905" WIDTH="2988" HEIGHT="121" BASELINE="543 2026 3531 2026">
            <Shape>
              <Polygon POINTS="543 1905 3531 1905 3531 2026 543 2026"/>
            </Shape>
            <String CONTENT="неннаго состоянія вродѣ ликантропіи. Я слышалъ нѣсколько другихъ раз-" HPOS="543" VPOS="1905" WIDTH="2988" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-043_l12" HPOS="544" VPOS="2050" WIDTH="2989" HEIGHT="105" BASELINE="544 2154 3533 2154">
            <Shape>
              <Polygon POINTS="544 2050 3533 2050 3533 2155 544 2155"/>
            </Shape>
            <String CONTENT="сказовъ такого же содержанія, которые выдавались за случаи изъ дѣйстви-" HPOS="544" VPOS="2050" WIDTH="2989" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-043_l13" HPOS="546" VPOS="2170" WIDTH="2987" HEIGHT="109" BASELINE="546 2278 3533 2278">
            <Shape>
              <Polygon POINTS="546 2170 3533 2170 3533 2279 546 2279"/>
            </Shape>
            <String CONTENT="тельной жизни. Въ чукотскомъ языкѣ для такого состоянія существуетъ" HPOS="546" VPOS="2170" WIDTH="2987" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-043_l14" HPOS="544" VPOS="2270" WIDTH="2991" HEIGHT="136" BASELINE="544 2405 3535 2405">
            <Shape>
              <Polygon POINTS="544 2270 3535 2270 3535 2406 544 2406"/>
            </Shape>
            <String CONTENT="особый глаголъ ђеркыча́ўркын — «уподобляться звѣрю». Въ сказкѣ № 120" HPOS="544" VPOS="2270" WIDTH="2991" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-043_l15" HPOS="539" VPOS="2423" WIDTH="2991" HEIGHT="107" BASELINE="539 2529 3530 2529">
            <Shape>
              <Polygon POINTS="539 2423 3530 2423 3530 2530 539 2530"/>
            </Shape>
            <String CONTENT="двѣ морскія рыбы превращаются въ молодыхъ людей. Сказка, очевидно," HPOS="539" VPOS="2423" WIDTH="2991" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-043_l16" HPOS="544" VPOS="2555" WIDTH="2989" HEIGHT="97" BASELINE="544 2652 3533 2652">
            <Shape>
              <Polygon POINTS="544 2555 3533 2555 3533 2652 544 2652"/>
            </Shape>
            <String CONTENT="скомкана, такъ какъ въ ней разсказаны только приключенія одного изъ" HPOS="544" VPOS="2555" WIDTH="2989" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-043_l17" HPOS="542" VPOS="2679" WIDTH="2991" HEIGHT="104" BASELINE="542 2782 3533 2782">
            <Shape>
              <Polygon POINTS="542 2679 3533 2679 3533 2783 542 2783"/>
            </Shape>
            <String CONTENT="«рыбныхъ товарищей», вэ́ӄӓн’а. Описаніе ихъ сбивается уже на разсказъ" HPOS="542" VPOS="2679" WIDTH="2991" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-043_l18" HPOS="544" VPOS="2811" WIDTH="960" HEIGHT="95" BASELINE="544 2905 1504 2905">
            <Shape>
              <Polygon POINTS="544 2811 1504 2811 1504 2906 544 2906"/>
            </Shape>
            <String CONTENT="изъ разряда а̂ӄӓlыlэ́тӄін." HPOS="544" VPOS="2811" WIDTH="960" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-043_l19" HPOS="755" VPOS="2906" WIDTH="2783" HEIGHT="120" BASELINE="755 3025 3538 3025">
            <Shape>
              <Polygon POINTS="755 2906 3538 2906 3538 3026 755 3026"/>
            </Shape>
            <String CONTENT="Я уже нѣсколько разъ указывалъ на заимствованія изъ русскаго и" HPOS="755" VPOS="2906" WIDTH="2783" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-043_l20" HPOS="548" VPOS="3050" WIDTH="2988" HEIGHT="98" BASELINE="548 3147 3536 3147">
            <Shape>
              <Polygon POINTS="548 3050 3536 3050 3536 3148 548 3148"/>
            </Shape>
            <String CONTENT="юкагирскаго сказочнаго круга; нѣкоторыя изъ нихъ передѣланы такъ" HPOS="548" VPOS="3050" WIDTH="2988" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-043_l21" HPOS="547" VPOS="3178" WIDTH="2990" HEIGHT="99" BASELINE="547 3277 3537 3277">
            <Shape>
              <Polygon POINTS="547 3178 3537 3178 3537 3277 547 3277"/>
            </Shape>
            <String CONTENT="искусно, что даже нельзя сказать съ увѣренностью, являются-ли они дѣй-" HPOS="547" VPOS="3178" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-043_l22" HPOS="548" VPOS="3297" WIDTH="2988" HEIGHT="105" BASELINE="548 3402 3536 3402">
            <Shape>
              <Polygon POINTS="548 3297 3536 3297 3536 3402 548 3402"/>
            </Shape>
            <String CONTENT="ствительно заимствованными. Въ видѣ примѣра можно указать изъ сказки" HPOS="548" VPOS="3297" WIDTH="2988" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-043_l23" HPOS="553" VPOS="3433" WIDTH="2982" HEIGHT="96" BASELINE="553 3528 3535 3528">
            <Shape>
              <Polygon POINTS="553 3433 3535 3433 3535 3529 553 3529"/>
            </Shape>
            <String CONTENT="о Чесоточномъ шаманѣ, эпизодъ встрѣчи Ры́нтеў съ ворономъ и филиномъ," HPOS="553" VPOS="3433" WIDTH="2982" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-043_l24" HPOS="549" VPOS="3561" WIDTH="2987" HEIGHT="95" BASELINE="549 3655 3536 3655">
            <Shape>
              <Polygon POINTS="549 3561 3536 3561 3536 3656 549 3656"/>
            </Shape>
            <String CONTENT="которые просятъ, чтобы онъ не толкалъ ихъ ногою. Повидимому это пере-" HPOS="549" VPOS="3561" WIDTH="2987" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-043_l25" HPOS="549" VPOS="3684" WIDTH="2992" HEIGHT="94" BASELINE="549 3778 3541 3778">
            <Shape>
              <Polygon POINTS="549 3684 3541 3684 3541 3778 549 3778"/>
            </Shape>
            <String CONTENT="дѣлка извѣстнаго эпизода русской сказки о встрѣчѣ царевича съ разными" HPOS="549" VPOS="3684" WIDTH="2992" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-043_l26" HPOS="549" VPOS="3811" WIDTH="2991" HEIGHT="96" BASELINE="549 3906 3540 3906">
            <Shape>
              <Polygon POINTS="549 3811 3540 3811 3540 3907 549 3907"/>
            </Shape>
            <String CONTENT="животными, которые сначала просятъ не убивать ихъ, а потомъ помогаютъ" HPOS="549" VPOS="3811" WIDTH="2991" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-043_l27" HPOS="551" VPOS="3933" WIDTH="2995" HEIGHT="100" BASELINE="551 4033 3546 4033">
            <Shape>
              <Polygon POINTS="551 3933 3546 3933 3546 4033 551 4033"/>
            </Shape>
            <String CONTENT="герою въ его предпріятіи, тѣмъ болѣе, что этотъ эпизодъ чукчамъ извѣ-" HPOS="551" VPOS="3933" WIDTH="2995" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-043_l28" HPOS="557" VPOS="4034" WIDTH="2987" HEIGHT="126" BASELINE="557 4159 3544 4159">
            <Shape>
              <Polygon POINTS="557 4034 3544 4034 3544 4160 557 4160"/>
            </Shape>
            <String CONTENT="стенъ и въ сказкѣ № 124 воспроизведенъ почти неприкосновенно. Однако," HPOS="557" VPOS="4034" WIDTH="2987" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-043_l29" HPOS="557" VPOS="4192" WIDTH="2993" HEIGHT="95" BASELINE="557 4286 3550 4286">
            <Shape>
              <Polygon POINTS="557 4192 3550 4192 3550 4287 557 4287"/>
            </Shape>
            <String CONTENT="заявленіе ворона о томъ, что онъ тоже житель и что его нельзя тревожить" HPOS="557" VPOS="4192" WIDTH="2993" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-043_l30" HPOS="557" VPOS="4310" WIDTH="2989" HEIGHT="103" BASELINE="557 4413 3546 4413">
            <Shape>
              <Polygon POINTS="557 4310 3546 4310 3546 4413 557 4413"/>
            </Shape>
            <String CONTENT="на его жительствѣ, носитъ чисто чукотскій характеръ; такъ у Чаунскихъ" HPOS="557" VPOS="4310" WIDTH="2989" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-043_l31" HPOS="559" VPOS="4441" WIDTH="2987" HEIGHT="99" BASELINE="559 4539 3546 4539">
            <Shape>
              <Polygon POINTS="559 4441 3546 4441 3546 4540 559 4540"/>
            </Shape>
            <String CONTENT="чукочъ считается грѣхомъ выкапывать песцовыхъ щенятъ, потому что это" HPOS="559" VPOS="4441" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-043_l32" HPOS="560" VPOS="4559" WIDTH="2985" HEIGHT="103" BASELINE="560 4662 3545 4662">
            <Shape>
              <Polygon POINTS="560 4559 3545 4559 3545 4662 560 4662"/>
            </Shape>
            <String CONTENT="есть оскорбленіе жилища. Точно также весьма распространенный эпизодъ," HPOS="560" VPOS="4559" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-043_l33" HPOS="558" VPOS="4691" WIDTH="2987" HEIGHT="100" BASELINE="558 4790 3545 4790">
            <Shape>
              <Polygon POINTS="558 4691 3545 4691 3545 4791 558 4791"/>
            </Shape>
            <String CONTENT="гдѣ молодой человѣкъ, собираясь въ дорогу, проситъ мать или жену при-" HPOS="558" VPOS="4691" WIDTH="2987" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-043_l34" HPOS="558" VPOS="4821" WIDTH="2989" HEIGHT="95" BASELINE="558 4915 3547 4915">
            <Shape>
              <Polygon POINTS="558 4821 3547 4821 3547 4916 558 4916"/>
            </Shape>
            <String CONTENT="готовить ему пять или десять паръ обуви и наполнить ее запасомъ, и до-" HPOS="558" VPOS="4821" WIDTH="2989" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-043_l35" HPOS="562" VPOS="4945" WIDTH="2990" HEIGHT="99" BASELINE="562 5043 3552 5043">
            <Shape>
              <Polygon POINTS="562 4945 3552 4945 3552 5044 562 5044"/>
            </Shape>
            <String CONTENT="стигаетъ свой цѣли, только износивъ всю обувь, повидимому, тоже заим-" HPOS="562" VPOS="4945" WIDTH="2990" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-043_l36" HPOS="564" VPOS="5089" WIDTH="870" HEIGHT="80" BASELINE="564 5168 1434 5168">
            <Shape>
              <Polygon POINTS="564 5089 1434 5089 1434 5169 564 5169"/>
            </Shape>
