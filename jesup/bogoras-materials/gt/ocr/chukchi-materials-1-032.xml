              <Polygon POINTS="1195 3792 4188 3792 4188 3898 1195 3898"/>
            </Shape>
            <String CONTENT="кострѣ, поднимаютъ вверхъ въ струѣ дыма и попадаютъ въ страну ђырђо̀р" HPOS="1195" VPOS="3792" WIDTH="2993" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-032_l27" HPOS="1197" VPOS="3922" WIDTH="2991" HEIGHT="100" BASELINE="1197 4022 4188 4022">
            <Shape>
              <Polygon POINTS="1197 3922 4188 3922 4188 4022 1197 4022"/>
            </Shape>
            <String CONTENT="-ра́мкын. Такова сказка о Кітыlку́т’ѣ № 66 и слѣдующая о Мертвой Го-" HPOS="1197" VPOS="3922" WIDTH="2991" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-032_l28" HPOS="1190" VPOS="4044" WIDTH="2996" HEIGHT="103" BASELINE="1190 4146 4186 4146">
            <Shape>
              <Polygon POINTS="1190 4044 4186 4044 4186 4147 1190 4147"/>
            </Shape>
            <String CONTENT="ловѣ № 67. Кромѣ этихъ вселенныхъ, координированныхъ между собой," HPOS="1190" VPOS="4044" WIDTH="2996" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-032_l29" HPOS="1199" VPOS="4170" WIDTH="2990" HEIGHT="101" BASELINE="1199 4270 4189 4270">
            <Shape>
              <Polygon POINTS="1199 4170 4189 4170 4189 4271 1199 4271"/>
            </Shape>
            <String CONTENT="есть еще особыя небольшія вселенныя, напр. небольшая темная вселенная" HPOS="1199" VPOS="4170" WIDTH="2990" HEIGHT="101"/>
          </TextLine>
