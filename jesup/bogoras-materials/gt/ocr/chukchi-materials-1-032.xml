            </Shape>
            <String CONTENT="крышкой. Дыра эта расположена въ зенитѣ подъ самой Полярной Звѣздой." HPOS="1202" VPOS="1527" WIDTH="2982" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-032_l9" HPOS="1199" VPOS="1657" WIDTH="2991" HEIGHT="104" BASELINE="1199 1760 4190 1760">
