            </Shape>
            <String CONTENT="находящаяся въ зенитѣ и вѣчно неподвижная, — во всѣхъ мірахъ одна и" HPOS="1194" VPOS="5169" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
