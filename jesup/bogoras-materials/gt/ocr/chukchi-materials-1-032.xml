              <Polygon POINTS="1195 4292 4186 4292 4186 4397 1195 4397"/>
            </Shape>
            <String CONTENT="Птичьей женщины Кэ́lє, которая уносить туда души, похищенныя ею при" HPOS="1195" VPOS="4292" WIDTH="2991" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-032_l31" HPOS="1195" VPOS="4417" WIDTH="2153" HEIGHT="104" BASELINE="1195 4520 3348 4520">
            <Shape>
              <Polygon POINTS="1195 4417 3348 4417 3348 4521 1195 4521"/>
            </Shape>
