              <Polygon POINTS="1203 1780 4186 1780 4186 1882 1203 1882"/>
            </Shape>
            <String CONTENT="«верхній народъ» или тӈа́ырђы-ра́мкын «разсвѣтный народъ»; оба эти опре-" HPOS="1203" VPOS="1780" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-032_l11" HPOS="1199" VPOS="1913" WIDTH="2991" HEIGHT="93" BASELINE="1199 2006 4190 2006">
            <Shape>
              <Polygon POINTS="1199 1913 4190 1913 4190 2006 1199 2006"/>
            </Shape>
            <String CONTENT="дѣленія совершенно совпадають. Добраться къ нимъ такъ легко, что многіе" HPOS="1199" VPOS="1913" WIDTH="2991" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-032_l12" HPOS="1191" VPOS="2030" WIDTH="2992" HEIGHT="101" BASELINE="1191 2130 4183 2130">
            <Shape>
              <Polygon POINTS="1191 2030 4183 2030 4183 2131 1191 2131"/>
            </Shape>
            <String CONTENT="молодые люди отправляются туда пѣшкомъ и достигнувъ земленебеснаго" HPOS="1191" VPOS="2030" WIDTH="2992" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-032_l13" HPOS="1199" VPOS="2156" WIDTH="2990" HEIGHT="103" BASELINE="1199 2258 4189 2258">
            <Shape>
              <Polygon POINTS="1199 2156 4189 2156 4189 2259 1199 2259"/>
            </Shape>
            <String CONTENT="рубежа (је̂̀-пкіт-тэ́ђын) просто поднимаются вверхъ по крутому подъему и" HPOS="1199" VPOS="2156" WIDTH="2990" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-032_l14" HPOS="1200" VPOS="2269" WIDTH="2996" HEIGHT="116" BASELINE="1200 2384 4196 2384">
            <Shape>
              <Polygon POINTS="1200 2269 4196 2269 4196 2385 1200 2385"/>
            </Shape>
            <String CONTENT="попадаютъ къ верхнему народу. Впрочемъ въ сказкѣ о Куніӈӓ (№ 79) герой" HPOS="1200" VPOS="2269" WIDTH="2996" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-032_l15" HPOS="1199" VPOS="2416" WIDTH="2993" HEIGHT="93" BASELINE="1199 2508 4192 2508">
            <Shape>
              <Polygon POINTS="1199 2416 4192 2416 4192 2509 1199 2509"/>
            </Shape>
            <String CONTENT="и его спутники напротивъ спускаются внизъ въ глубину водоворота, а въ" HPOS="1199" VPOS="2416" WIDTH="2993" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-032_l16" HPOS="1200" VPOS="2525" WIDTH="2991" HEIGHT="112" BASELINE="1200 2637 4191 2637">
