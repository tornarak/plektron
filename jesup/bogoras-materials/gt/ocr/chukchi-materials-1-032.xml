          </TextLine>
          <TextLine ID="mz_1-032_l19" HPOS="1204" VPOS="2914" WIDTH="2986" HEIGHT="96" BASELINE="1204 3009 4190 3009">
            <Shape>
              <Polygon POINTS="1204 2914 4190 2914 4190 3010 1204 3010"/>
            </Shape>
            <String CONTENT="-ра́мкын «нижній народъ», они спускаются оттуда съ женой и новопріобрѣ-" HPOS="1204" VPOS="2914" WIDTH="2986" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-032_l20" HPOS="1199" VPOS="3037" WIDTH="2990" HEIGHT="94" BASELINE="1199 3131 4189 3131">
