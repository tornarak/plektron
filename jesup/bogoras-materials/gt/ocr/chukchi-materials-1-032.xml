            </Shape>
            <String CONTENT="по лучу на землю, похищаетъ дѣвушку, а потомъ приводить за нее на" HPOS="1199" VPOS="5558" WIDTH="2991" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-032_l41" HPOS="1201" VPOS="5681" WIDTH="2982" HEIGHT="105" BASELINE="1201 5785 4183 5785">
