            </Shape>
            <String CONTENT="Солнце это пастухъ, имѣющій мѣднорогихъ оленей. Оно спускается" HPOS="1411" VPOS="5429" WIDTH="2774" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-032_l40" HPOS="1199" VPOS="5558" WIDTH="2991" HEIGHT="99" BASELINE="1199 5657 4190 5657">
