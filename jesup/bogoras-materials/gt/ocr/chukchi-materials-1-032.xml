              <Polygon POINTS="1200 3546 4193 3546 4193 3647 1200 3647"/>
            </Shape>
            <String CONTENT="вверхъ, чтобы сдѣлать жену для Кука́lђон’а, между тѣмъ, какъ мертвое" HPOS="1200" VPOS="3546" WIDTH="2993" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-032_l25" HPOS="1192" VPOS="3664" WIDTH="2999" HEIGHT="106" BASELINE="1192 3769 4191 3769">
            <Shape>
              <Polygon POINTS="1192 3664 4191 3664 4191 3770 1192 3770"/>
            </Shape>
            <String CONTENT="тѣло остается внизу. Съ другой стороны души умершихъ, сжигаемыхъ на" HPOS="1192" VPOS="3664" WIDTH="2999" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-032_l26" HPOS="1195" VPOS="3792" WIDTH="2993" HEIGHT="106" BASELINE="1195 3897 4188 3897">
