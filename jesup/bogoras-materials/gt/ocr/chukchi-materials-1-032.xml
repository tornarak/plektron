            </Shape>
            <String CONTENT="верхняго народа живуть также души (уwі́ріт) съ нашей земли. Такъ въ" HPOS="1198" VPOS="3163" WIDTH="2991" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-032_l22" HPOS="1196" VPOS="3285" WIDTH="2994" HEIGHT="106" BASELINE="1196 3391 4190 3391">
