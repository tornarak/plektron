            </Shape>
            <String CONTENT="теннымъ стадомъ обыкновеннымъ кочевымъ обозомъ. Впрочемъ въ землѣ" HPOS="1199" VPOS="3037" WIDTH="2990" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-032_l21" HPOS="1198" VPOS="3163" WIDTH="2991" HEIGHT="100" BASELINE="1198 3262 4189 3262">
