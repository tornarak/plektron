              <Polygon POINTS="1196 3285 4190 3285 4190 3391 1196 3391"/>
            </Shape>
            <String CONTENT="сказкѣ о Кука́lђон’ѣ (№ 69) верхній человѣкъ ловить душу дѣвушки при" HPOS="1196" VPOS="3285" WIDTH="2994" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-032_l23" HPOS="1197" VPOS="3428" WIDTH="2991" HEIGHT="88" BASELINE="1197 3515 4188 3515">
            <Shape>
              <Polygon POINTS="1197 3428 4188 3428 4188 3516 1197 3516"/>
            </Shape>
            <String CONTENT="помощи крючка, привязаннаго на лесу изъ жильныхъ нитокъ, и уносить ее" HPOS="1197" VPOS="3428" WIDTH="2991" HEIGHT="88"/>
          </TextLine>
          <TextLine ID="mz_1-032_l24" HPOS="1200" VPOS="3546" WIDTH="2993" HEIGHT="101" BASELINE="1200 3646 4193 3646">
