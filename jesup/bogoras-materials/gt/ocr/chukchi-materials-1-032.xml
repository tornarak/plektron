              <Polygon POINTS="1202 1410 4189 1410 4189 1507 1202 1507"/>
            </Shape>
            <String CONTENT="изъ одной вселенной можно заглядывать черезъ особую дыру, закрытую" HPOS="1202" VPOS="1410" WIDTH="2987" HEIGHT="97"/>
