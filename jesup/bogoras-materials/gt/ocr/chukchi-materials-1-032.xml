            </Shape>
            <String CONTENT="вляетъ изнанку нижняго неба. На нашемъ небѣ живуть различныя группы" HPOS="1239" VPOS="4785" WIDTH="2951" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-032_l35" HPOS="1197" VPOS="4920" WIDTH="2991" HEIGHT="99" BASELINE="1197 5018 4188 5018">
