              <Polygon POINTS="1401 4543 4187 4543 4187 4642 1401 4642"/>
            </Shape>
            <String CONTENT="Небо нашей собственной вселенной составляетъ землю для верхняго" HPOS="1401" VPOS="4543" WIDTH="2786" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-032_l33" HPOS="1195" VPOS="4663" WIDTH="2992" HEIGHT="106" BASELINE="1195 4768 4187 4768">
            <Shape>
              <Polygon POINTS="1195 4663 4187 4663 4187 4769 1195 4769"/>
            </Shape>
            <String CONTENT="народа, который ходить по его изнанкѣ, точно также и наша земля соста-" HPOS="1195" VPOS="4663" WIDTH="2992" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-032_l34" HPOS="1239" VPOS="4785" WIDTH="2951" HEIGHT="110" BASELINE="1239 4894 4190 4894">
