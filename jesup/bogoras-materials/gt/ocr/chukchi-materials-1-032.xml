            </Shape>
            <String CONTENT="сказкѣ объ А̂ттыђы́ткы (№ 86) дѣйствующія лица спускаются въ глубину" HPOS="1200" VPOS="2525" WIDTH="2991" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-032_l17" HPOS="1192" VPOS="2662" WIDTH="2999" HEIGHT="99" BASELINE="1192 2761 4191 2761">
            <Shape>
              <Polygon POINTS="1192 2662 4191 2662 4191 2761 1192 2761"/>
            </Shape>
            <String CONTENT="моря, потомъ поднимаются вверхъ по длинной иглѣ. Жители земли, когда" HPOS="1192" VPOS="2662" WIDTH="2999" HEIGHT="99"/>
          </TextLine>
