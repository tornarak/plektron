            </Shape>
            <String CONTENT="сливаются еты́нвыт. Примѣры такихъ еты́нвыт: маленькій карликъ, хозяинъ" HPOS="449" VPOS="1924" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
