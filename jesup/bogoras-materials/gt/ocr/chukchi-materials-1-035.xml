            </Shape>
            <String CONTENT="откармливать на убой, рубить на части, жарить и ѣсть. Кромѣ этихъ" HPOS="439" VPOS="4929" WIDTH="2992" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-035_l36" HPOS="428" VPOS="5050" WIDTH="3001" HEIGHT="107" BASELINE="428 5156 3429 5156">
