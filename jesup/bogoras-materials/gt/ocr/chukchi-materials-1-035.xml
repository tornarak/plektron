            </Shape>
            <String CONTENT="какъ будто онѣ списаны съ дѣйствительности. Напр. въ № 73 жена Кэ́lє" HPOS="438" VPOS="5400" WIDTH="2993" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-035_l40" HPOS="442" VPOS="5556" WIDTH="2988" HEIGHT="100" BASELINE="442 5655 3430 5655">
