            </Shape>
            <String CONTENT="Ја́нөт-lа̀ўтен ӈэ́экык. Передней Головы дочь." HPOS="1680" VPOS="1323" WIDTH="2065" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-236_l5" HPOS="1431" VPOS="1551" WIDTH="2768" HEIGHT="96" BASELINE="1431 1646 4199 1646">
            <Shape>
              <Polygon POINTS="1431 1551 4199 1551 4199 1647 1431 1647"/>
            </Shape>
            <String CONTENT="Отецъ умеръ, также и мать. Остался единственный сынъ. Постоянно" HPOS="1431" VPOS="1551" WIDTH="2768" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-236_l6" HPOS="1220" VPOS="1664" WIDTH="2977" HEIGHT="111" BASELINE="1220 1775 4197 1775">
            <Shape>
              <Polygon POINTS="1220 1664 4197 1664 4197 1775 1220 1775"/>
            </Shape>
            <String CONTENT="плачетъ этотъ мальчикъ. Одна только тетка у него есть. Женъ ему по-" HPOS="1220" VPOS="1664" WIDTH="2977" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-236_l7" HPOS="1214" VPOS="1799" WIDTH="2987" HEIGHT="102" BASELINE="1214 1901 4201 1901">
            <Shape>
              <Polygon POINTS="1214 1799 4201 1799 4201 1901 1214 1901"/>
            </Shape>
            <String CONTENT="стоянно беретъ. Всѣхъ отвергаетъ. Говоритъ: «Дѣвушекъ и женщинъ не" HPOS="1214" VPOS="1799" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l8" HPOS="1214" VPOS="1925" WIDTH="2984" HEIGHT="102" BASELINE="1214 2026 4198 2026">
            <Shape>
              <Polygon POINTS="1214 1925 4198 1925 4198 2027 1214 2027"/>
            </Shape>
            <String CONTENT="нужно!» Говоритъ: «Пусть я самъ пойду, самъ поищу жену!» Тамъ, гдѣ" HPOS="1214" VPOS="1925" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l9" HPOS="1215" VPOS="2050" WIDTH="2986" HEIGHT="103" BASELINE="1215 2152 4201 2152">
            <Shape>
              <Polygon POINTS="1215 2050 4201 2050 4201 2153 1215 2153"/>
            </Shape>
            <String CONTENT="звѣзда Передняя Голова¹), къ ней туда ушелъ. Увидѣлъ ея домъ. Пришелъ" HPOS="1215" VPOS="2050" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-236_l10" HPOS="1214" VPOS="2176" WIDTH="2986" HEIGHT="107" BASELINE="1214 2282 4200 2282">
            <Shape>
              <Polygon POINTS="1214 2176 4200 2176 4200 2283 1214 2283"/>
            </Shape>
            <String CONTENT="туда, вошелъ въ пологъ. Хозяинъ снаружи говоритъ тамъ живущему Кэ́lє:" HPOS="1214" VPOS="2176" WIDTH="2986" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-236_l11" HPOS="1213" VPOS="2292" WIDTH="2992" HEIGHT="111" BASELINE="1213 2402 4205 2402">
            <Shape>
              <Polygon POINTS="1213 2292 4205 2292 4205 2403 1213 2403"/>
            </Shape>
            <String CONTENT="«Не видѣлъ ли ты человѣка?» Кэ́lє говоритъ: «Да, видѣлъ». Вошелъ въ" HPOS="1213" VPOS="2292" WIDTH="2992" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-236_l12" HPOS="1219" VPOS="2422" WIDTH="2984" HEIGHT="111" BASELINE="1219 2532 4203 2532">
            <Shape>
              <Polygon POINTS="1219 2422 4203 2422 4203 2533 1219 2533"/>
            </Shape>
            <String CONTENT="пологъ. Говоритъ Передняя Голова къ Кэ́lє: «Ну-ка, войди за нимъ!»" HPOS="1219" VPOS="2422" WIDTH="2984" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-236_l13" HPOS="1212" VPOS="2552" WIDTH="2988" HEIGHT="103" BASELINE="1212 2654 4200 2654">
            <Shape>
              <Polygon POINTS="1212 2552 4200 2552 4200 2655 1212 2655"/>
            </Shape>
            <String CONTENT="Парень спрятался у задней стѣны. Кэ́lє туда вошелъ огнемъ. Огонь бѣ-" HPOS="1212" VPOS="2552" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-236_l14" HPOS="1214" VPOS="2673" WIDTH="2989" HEIGHT="100" BASELINE="1214 2772 4203 2772">
            <Shape>
              <Polygon POINTS="1214 2673 4203 2673 4203 2773 1214 2773"/>
            </Shape>
            <String CONTENT="гаетъ по пологу взадъ и впередъ. Найти не можетъ его, человѣка найти" HPOS="1214" VPOS="2673" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-236_l15" HPOS="1216" VPOS="2789" WIDTH="2982" HEIGHT="114" BASELINE="1216 2902 4198 2902">
            <Shape>
              <Polygon POINTS="1216 2789 4198 2789 4198 2903 1216 2903"/>
            </Shape>
            <String CONTENT="не можетъ; вышелъ наружу. Спрашиваетъ Передняя Голова: «А что, ви-" HPOS="1216" VPOS="2789" WIDTH="2982" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-236_l16" HPOS="1213" VPOS="2923" WIDTH="2985" HEIGHT="106" BASELINE="1213 3028 4198 3028">
            <Shape>
              <Polygon POINTS="1213 2923 4198 2923 4198 3029 1213 3029"/>
            </Shape>
            <String CONTENT="дѣлъ человѣка?» Говоритъ: «Нѣтъ! (не могъ)». Вошелъ Передняя Голова," HPOS="1213" VPOS="2923" WIDTH="2985" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-236_l17" HPOS="1217" VPOS="3041" WIDTH="2988" HEIGHT="102" BASELINE="1217 3142 4205 3142">
            <Shape>
              <Polygon POINTS="1217 3041 4205 3041 4205 3143 1217 3143"/>
            </Shape>
            <String CONTENT="спрашиваетъ: «Гдѣ ты?» — «Вотъ я!» говоритъ парень. «Развѣ ты видѣлъ" HPOS="1217" VPOS="3041" WIDTH="2988" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l18" HPOS="1214" VPOS="3134" WIDTH="2989" HEIGHT="145" BASELINE="1214 3278 4203 3278">
            <Shape>
              <Polygon POINTS="1214 3134 4203 3134 4203 3279 1214 3279"/>
            </Shape>
            <String CONTENT="теперешняго Кэ́lє и еще живъ?» — «Нѣтъ, не видѣлъ!» Вышелъ тотъ," HPOS="1214" VPOS="3134" WIDTH="2989" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-236_l19" HPOS="1212" VPOS="3295" WIDTH="2989" HEIGHT="110" BASELINE="1212 3404 4201 3404">
            <Shape>
              <Polygon POINTS="1212 3295 4201 3295 4201 3405 1212 3405"/>
            </Shape>
            <String CONTENT="чтобы снова позвать Кэ́lє. Кэ́lє явился, грудой камней ринулся въ пологъ;" HPOS="1212" VPOS="3295" WIDTH="2989" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-236_l20" HPOS="1216" VPOS="3428" WIDTH="2985" HEIGHT="102" BASELINE="1216 3530 4201 3530">
            <Shape>
              <Polygon POINTS="1216 3428 4201 3428 4201 3530 1216 3530"/>
            </Shape>
            <String CONTENT="камни катаются по пологу, ищутъ парня, не могутъ найти. Спрятался." HPOS="1216" VPOS="3428" WIDTH="2985" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l21" HPOS="1216" VPOS="3530" WIDTH="2990" HEIGHT="122" BASELINE="1216 3651 4206 3651">
            <Shape>
              <Polygon POINTS="1216 3530 4206 3530 4206 3652 1216 3652"/>
            </Shape>
            <String CONTENT="Потомъ говоритъ хозяинъ: «Гдѣ же парень?» — «Нѣту». Потомъ вошелъ" HPOS="1216" VPOS="3530" WIDTH="2990" HEIGHT="122"/>
          </TextLine>
          <TextLine ID="mz_1-236_l22" HPOS="1220" VPOS="3656" WIDTH="2989" HEIGHT="119" BASELINE="1220 3756 4209 3756">
            <Shape>
              <Polygon POINTS="1220 3656 4209 3656 4209 3775 1220 3775"/>
            </Shape>
            <String CONTENT="хозяинъ, говоритъ: «Гдѣ ты?» — «Вотъ я!» — «А гдѣ же тотъ, который" HPOS="1220" VPOS="3656" WIDTH="2989" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-236_l23" HPOS="1229" VPOS="3798" WIDTH="2973" HEIGHT="103" BASELINE="1229 3900 4202 3900">
            <Shape>
              <Polygon POINTS="1229 3798 4202 3798 4202 3901 1229 3901"/>
            </Shape>
            <String CONTENT="приходилъ?» — «Не знаю! Найти не могъ». Говоритъ Передняя Голова:" HPOS="1229" VPOS="3798" WIDTH="2973" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-236_l24" HPOS="1225" VPOS="3929" WIDTH="2984" HEIGHT="102" BASELINE="1225 4030 4209 4030">
            <Shape>
              <Polygon POINTS="1225 3929 4209 3929 4209 4031 1225 4031"/>
            </Shape>
            <String CONTENT="«Есть тамъ еще!» Другой духъ пришелъ въ пологъ, не можетъ найти, ибо" HPOS="1225" VPOS="3929" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l25" HPOS="1224" VPOS="4057" WIDTH="2980" HEIGHT="100" BASELINE="1224 4156 4204 4156">
            <Shape>
              <Polygon POINTS="1224 4057 4204 4057 4204 4157 1224 4157"/>
            </Shape>
            <String CONTENT="спрятался; хорошо прячущійся парень, шаманъ, знающій парень. Есть у" HPOS="1224" VPOS="4057" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-236_l26" HPOS="1221" VPOS="4184" WIDTH="2983" HEIGHT="95" BASELINE="1221 4278 4204 4278">
            <Shape>
              <Polygon POINTS="1221 4184 4204 4184 4204 4279 1221 4279"/>
            </Shape>
            <String CONTENT="Передней Головы дочь, никѣмъ не видимая, никому не показываемая. Парень" HPOS="1221" VPOS="4184" WIDTH="2983" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-236_l27" HPOS="1221" VPOS="4304" WIDTH="2983" HEIGHT="99" BASELINE="1221 4402 4204 4402">
            <Shape>
              <Polygon POINTS="1221 4304 4204 4304 4204 4403 1221 4403"/>
            </Shape>
            <String CONTENT="ее увидѣлъ во снѣ и захотѣлъ имѣть. Поэтому другихъ отвергаетъ, при-" HPOS="1221" VPOS="4304" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-236_l28" HPOS="1225" VPOS="4424" WIDTH="2984" HEIGHT="103" BASELINE="1225 4526 4209 4526">
            <Shape>
              <Polygon POINTS="1225 4424 4209 4424 4209 4527 1225 4527"/>
            </Shape>
            <String CONTENT="шелъ ее искать. Пришелъ сонъ къ Передней Головѣ. Найти не могли парня" HPOS="1225" VPOS="4424" WIDTH="2984" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-236_l29" HPOS="1230" VPOS="4554" WIDTH="2975" HEIGHT="101" BASELINE="1230 4654 4205 4654">
            <Shape>
              <Polygon POINTS="1230 4554 4205 4554 4205 4655 1230 4655"/>
            </Shape>
            <String CONTENT="и заснули. Пока спали, до дѣвушки парень достигъ, дошелъ. Передъ ней" HPOS="1230" VPOS="4554" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-236_l30" HPOS="1224" VPOS="4683" WIDTH="2981" HEIGHT="98" BASELINE="1224 4780 4205 4780">
            <Shape>
              <Polygon POINTS="1224 4683 4205 4683 4205 4781 1224 4781"/>
            </Shape>
            <String CONTENT="стоитъ бѣлоогненная лампада. Смотритъ: она работаетъ, дѣлаетъ самую" HPOS="1224" VPOS="4683" WIDTH="2981" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-236_l31" HPOS="1226" VPOS="4805" WIDTH="2980" HEIGHT="102" BASELINE="1226 4906 4206 4906">
            <Shape>
              <Polygon POINTS="1226 4805 4206 4805 4206 4907 1226 4907"/>
            </Shape>
            <String CONTENT="лучшую одежду. Тамъ сидитъ рядомъ съ дѣвушкой. Утромъ увидѣлъ ихъ" HPOS="1226" VPOS="4805" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l32" HPOS="1221" VPOS="4932" WIDTH="2985" HEIGHT="99" BASELINE="1221 5030 4206 5030">
            <Shape>
              <Polygon POINTS="1221 4932 4206 4932 4206 5031 1221 5031"/>
            </Shape>
            <String CONTENT="Передняя Голова, говоритъ: «Зачѣмъ онъ сидитъ около дѣвушки?» Гово-" HPOS="1221" VPOS="4932" WIDTH="2985" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-236_l33" HPOS="1224" VPOS="5057" WIDTH="2982" HEIGHT="100" BASELINE="1224 5156 4206 5156">
            <Shape>
              <Polygon POINTS="1224 5057 4206 5057 4206 5157 1224 5157"/>
            </Shape>
            <String CONTENT="ритъ дочери Передняя Голова: «Почему онъ женился на тебѣ?» Говоритъ" HPOS="1224" VPOS="5057" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-236_l34" HPOS="1225" VPOS="5169" WIDTH="2983" HEIGHT="114" BASELINE="1225 5282 4208 5282">
            <Shape>
              <Polygon POINTS="1225 5169 4208 5169 4208 5283 1225 5283"/>
            </Shape>
            <String CONTENT="дѣвушка: «Я думала, тобой посланъ». Говоритъ отецъ: «Что дѣлать! Со-" HPOS="1225" VPOS="5169" WIDTH="2983" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-236_l35" HPOS="1229" VPOS="5307" WIDTH="2981" HEIGHT="104" BASELINE="1229 5410 4210 5410">
            <Shape>
              <Polygon POINTS="1229 5307 4210 5307 4210 5411 1229 5411"/>
            </Shape>
            <String CONTENT="гласенъ, возьми за себя, уведи, если ты уже взялъ ее!» Покочевали обо-" HPOS="1229" VPOS="5307" WIDTH="2981" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-236_l36" HPOS="1229" VPOS="5433" WIDTH="2984" HEIGHT="102" BASELINE="1229 5535 4213 5535">
            <Shape>
              <Polygon POINTS="1229 5433 4213 5433 4213 5535 1229 5535"/>
            </Shape>
            <String CONTENT="зомъ. Парень ушелъ домой, увезъ дѣвушку. Надѣли хорошую одежду и" HPOS="1229" VPOS="5433" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-236_l37" HPOS="1450" VPOS="5661" WIDTH="1739" HEIGHT="123" BASELINE="1450 5783 3189 5783">
            <Shape>
