          <TextLine ID="mz_1-222_l6" HPOS="1435" VPOS="1478" WIDTH="2774" HEIGHT="104" BASELINE="1435 1582 4209 1582">
            <Shape>
              <Polygon POINTS="1435 1478 4209 1478 4209 1582 1435 1582"/>
            </Shape>
            <String CONTENT="Былъ человѣкъ, было у него стадо, олени всегда уходили на сѣнтуху;" HPOS="1435" VPOS="1478" WIDTH="2774" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-222_l7" HPOS="1224" VPOS="1612" WIDTH="2985" HEIGHT="101" BASELINE="1224 1712 4209 1712">
            <Shape>
              <Polygon POINTS="1224 1612 4209 1612 4209 1713 1224 1713"/>
            </Shape>
            <String CONTENT="худо ему стало. Ходили двое, пришли въ его пологъ, ногъ у нихъ нѣтъ," HPOS="1224" VPOS="1612" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-222_l8" HPOS="1225" VPOS="1734" WIDTH="2984" HEIGHT="98" BASELINE="1225 1831 4209 1831">
            <Shape>
              <Polygon POINTS="1225 1734 4209 1734 4209 1832 1225 1832"/>
            </Shape>
            <String CONTENT="сами деревянные, головы, какъ у деревянныхъ огнивъ. Пришли въ его" HPOS="1225" VPOS="1734" WIDTH="2984" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-222_l9" HPOS="1222" VPOS="1861" WIDTH="2992" HEIGHT="98" BASELINE="1222 1958 4214 1958">
            <Shape>
              <Polygon POINTS="1222 1861 4214 1861 4214 1959 1222 1959"/>
            </Shape>
            <String CONTENT="домъ, покормилъ ихъ саломъ, легли спать. Говорятъ: «Ночью стадо испу-" HPOS="1222" VPOS="1861" WIDTH="2992" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-222_l10" HPOS="1227" VPOS="1982" WIDTH="2985" HEIGHT="100" BASELINE="1227 2081 4212 2081">
            <Shape>
              <Polygon POINTS="1227 1982 4212 1982 4212 2082 1227 2082"/>
            </Shape>
            <String CONTENT="гается, разбуди насъ!» — «Какъ стану будить?» — «Возьми лучекъ, верти" HPOS="1227" VPOS="1982" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-222_l11" HPOS="1230" VPOS="2114" WIDTH="2984" HEIGHT="96" BASELINE="1230 2209 4214 2209">
            <Shape>
              <Polygon POINTS="1230 2114 4214 2114 4214 2210 1230 2210"/>
            </Shape>
            <String CONTENT="въ нашихъ дыркахъ, огонь добудешь и насъ разбудишь!» Испугалось ночью" HPOS="1230" VPOS="2114" WIDTH="2984" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-222_l12" HPOS="1225" VPOS="2242" WIDTH="2987" HEIGHT="96" BASELINE="1225 2338 4212 2338">
            <Shape>
              <Polygon POINTS="1225 2242 4212 2242 4212 2338 1225 2338"/>
            </Shape>
            <String CONTENT="стадо, всталъ человѣкъ, взялъ лучекъ, закрутилъ лучекъ, запѣлъ лучекъ" HPOS="1225" VPOS="2242" WIDTH="2987" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-222_l13" HPOS="1228" VPOS="2359" WIDTH="2982" HEIGHT="100" BASELINE="1228 2458 4210 2458">
            <Shape>
              <Polygon POINTS="1228 2359 4210 2359 4210 2459 1228 2459"/>
            </Shape>
            <String CONTENT="пѣсню, услышали олени, остановились на мѣстѣ. Поэтому ихъ мажутъ са-" HPOS="1228" VPOS="2359" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-222_l14" HPOS="1230" VPOS="2485" WIDTH="2978" HEIGHT="91" BASELINE="1230 2575 4208 2575">
            <Shape>
              <Polygon POINTS="1230 2485 4208 2485 4208 2576 1230 2576"/>
            </Shape>
            <String CONTENT="ломъ и добываютъ изъ нихъ огонь. Потомъ сдѣлали они многихъ людей." HPOS="1230" VPOS="2485" WIDTH="2978" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-222_l15" HPOS="1227" VPOS="2607" WIDTH="2990" HEIGHT="104" BASELINE="1227 2710 4217 2710">
            <Shape>
              <Polygon POINTS="1227 2607 4217 2607 4217 2711 1227 2711"/>
            </Shape>
            <String CONTENT="Двое они легли спать. «Эти люди пойдутъ сторожить стадо». Пошли эти" HPOS="1227" VPOS="2607" WIDTH="2990" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-222_l16" HPOS="1230" VPOS="2734" WIDTH="2982" HEIGHT="101" BASELINE="1230 2834 4212 2834">
            <Shape>
              <Polygon POINTS="1230 2734 4212 2734 4212 2835 1230 2835"/>
            </Shape>
            <String CONTENT="люди сторожить стадо. Встали на утро (чукчи), говорятъ: «Гдѣ пастухи?»" HPOS="1230" VPOS="2734" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-222_l17" HPOS="1224" VPOS="2856" WIDTH="2991" HEIGHT="105" BASELINE="1224 2960 4215 2960">
            <Shape>
              <Polygon POINTS="1224 2856 4215 2856 4215 2961 1224 2961"/>
            </Shape>
            <String CONTENT="Нѣтъ пастуховъ, только въ домѣ вмѣсто нихъ связка та́јӈыкут’овъ. Сколько" HPOS="1224" VPOS="2856" WIDTH="2991" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-222_l18" HPOS="1231" VPOS="2995" WIDTH="2984" HEIGHT="97" BASELINE="1231 3091 4215 3091">
            <Shape>
              <Polygon POINTS="1231 2995 4215 2995 4215 3092 1231 3092"/>
            </Shape>
            <String CONTENT="было пастуховъ, столько та́јӈыкуlђын’овъ. Поэтому, если потеряется какой" HPOS="1231" VPOS="2995" WIDTH="2984" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-222_l19" HPOS="1232" VPOS="3118" WIDTH="1631" HEIGHT="98" BASELINE="1232 3215 2863 3215">
            <Shape>
              <Polygon POINTS="1232 3118 2863 3118 2863 3216 1232 3216"/>
            </Shape>
            <String CONTENT="нибудь, то вмѣсто него дѣлаютъ другого." HPOS="1232" VPOS="3118" WIDTH="1631" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-222_l20" HPOS="1440" VPOS="3273" WIDTH="1636" HEIGHT="101" BASELINE="1440 3374 3076 3374">
