          <TextLine ID="mz_1-222_l24" HPOS="1438" VPOS="4012" WIDTH="2770" HEIGHT="105" BASELINE="1438 4116 4208 4116">
            <Shape>
              <Polygon POINTS="1438 4012 4208 4012 4208 4117 1438 4117"/>
            </Shape>
            <String CONTENT="Былъ на землѣ олень быстрый, получеловѣкъ, полуолень, бѣгалъ по" HPOS="1438" VPOS="4012" WIDTH="2770" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-222_l25" HPOS="1221" VPOS="4147" WIDTH="2988" HEIGHT="96" BASELINE="1221 4242 4209 4242">
            <Shape>
              <Polygon POINTS="1221 4147 4209 4147 4209 4243 1221 4243"/>
            </Shape>
            <String CONTENT="землѣ быстро, все, оленя, лося, зайца настигалъ, охраненіемъ стада не за-" HPOS="1221" VPOS="4147" WIDTH="2988" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-222_l26" HPOS="1223" VPOS="4256" WIDTH="2987" HEIGHT="110" BASELINE="1223 4365 4210 4365">
            <Shape>
              <Polygon POINTS="1223 4256 4210 4256 4210 4366 1223 4366"/>
            </Shape>
            <String CONTENT="нимался и дома не строилъ, бѣгалъ одинъ. Шла по землѣ женщина, вся" HPOS="1223" VPOS="4256" WIDTH="2987" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-222_l27" HPOS="1225" VPOS="4398" WIDTH="2981" HEIGHT="100" BASELINE="1225 4497 4206 4497">
            <Shape>
              <Polygon POINTS="1225 4398 4206 4398 4206 4498 1225 4498"/>
            </Shape>
            <String CONTENT="оружіемъ обвѣшана, копьями, ножами, луками, одѣта, какъ мужчина," HPOS="1225" VPOS="4398" WIDTH="2981" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-222_l28" HPOS="1225" VPOS="4523" WIDTH="2992" HEIGHT="97" BASELINE="1225 4619 4217 4619">
            <Shape>
              <Polygon POINTS="1225 4523 4217 4523 4217 4620 1225 4620"/>
            </Shape>
            <String CONTENT="встрѣтились они, стали драться, никто верхъ не беретъ. Разсердился Аӈаӈ" HPOS="1225" VPOS="4523" WIDTH="2992" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-222_l29" HPOS="1232" VPOS="4649" WIDTH="2977" HEIGHT="100" BASELINE="1232 4747 4209 4747">
            <Shape>
              <Polygon POINTS="1232 4649 4209 4649 4209 4749 1232 4749"/>
            </Shape>
            <String CONTENT="-ва́ырђын (божественное бытіе), пришли двое, говорятъ: «Полно вамъ" HPOS="1232" VPOS="4649" WIDTH="2977" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-222_l30" HPOS="1224" VPOS="4761" WIDTH="2985" HEIGHT="106" BASELINE="1224 4866 4209 4866">
            <Shape>
              <Polygon POINTS="1224 4761 4209 4761 4209 4867 1224 4867"/>
            </Shape>
            <String CONTENT="драться!» Говорятъ женщинѣ: «А ты какъ долго по этой землѣ ходишь?" HPOS="1224" VPOS="4761" WIDTH="2985" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-222_l31" HPOS="1224" VPOS="4855" WIDTH="2986" HEIGHT="121" BASELINE="1224 4975 4210 4975">
            <Shape>
              <Polygon POINTS="1224 4855 4210 4855 4210 4976 1224 4976"/>
            </Shape>
            <String CONTENT="Отъ чего людей мало? Не нужно тебя! Уходи на другую землю!» — «А ты" HPOS="1224" VPOS="4855" WIDTH="2986" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-222_l32" HPOS="1224" VPOS="5025" WIDTH="2987" HEIGHT="99" BASELINE="1224 5123 4211 5123">
            <Shape>
              <Polygon POINTS="1224 5025 4211 5025 4211 5124 1224 5124"/>
            </Shape>
            <String CONTENT="зачѣмъ двойной?» Взяли его, раздѣлили пополамъ. «Вотъ твоя половина" HPOS="1224" VPOS="5025" WIDTH="2987" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-222_l33" HPOS="1222" VPOS="5158" WIDTH="2987" HEIGHT="93" BASELINE="1222 5251 4209 5251">
            <Shape>
              <Polygon POINTS="1222 5158 4209 5158 4209 5251 1222 5251"/>
            </Shape>
            <String CONTENT="другая, это домашній олень, твое мясо, твоя жизнь. Полно тебѣ бѣгать по" HPOS="1222" VPOS="5158" WIDTH="2987" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-222_l34" HPOS="1222" VPOS="5276" WIDTH="2984" HEIGHT="104" BASELINE="1222 5380 4206 5380">
            <Shape>
              <Polygon POINTS="1222 5276 4206 5276 4206 5380 1222 5380"/>
            </Shape>
            <String CONTENT="землѣ, паси стадо!» Пошли тѣ двое еще дальше, видятъ: ходитъ человѣкъ," HPOS="1222" VPOS="5276" WIDTH="2984" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-222_l35" HPOS="1228" VPOS="5409" WIDTH="2985" HEIGHT="101" BASELINE="1228 5510 4213 5510">
            <Shape>
              <Polygon POINTS="1228 5409 4213 5409 4213 5510 1228 5510"/>
            </Shape>
            <String CONTENT="ӄаара́мкын (ламутъ), еще онъ не оконченъ, на рукахъ и ногахъ только" HPOS="1228" VPOS="5409" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-222_l36" HPOS="1230" VPOS="5538" WIDTH="2985" HEIGHT="95" BASELINE="1230 5633 4215 5633">
            <Shape>
              <Polygon POINTS="1230 5538 4215 5538 4215 5633 1230 5633"/>
            </Shape>
            <String CONTENT="обнаженныя кости; все-таки очень быстрый, ловитъ дикихъ оленей и зубами" HPOS="1230" VPOS="5538" WIDTH="2985" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-222_l37" HPOS="1232" VPOS="5662" WIDTH="2981" HEIGHT="101" BASELINE="1232 5763 4213 5763">
            <Shape>
              <Polygon POINTS="1232 5662 4213 5662 4213 5763 1232 5763"/>
            </Shape>
            <String CONTENT="ихъ обдираетъ, содралъ съ дикаго оленя шкуру, разрѣзалъ ее, сдѣлалъ себѣ" HPOS="1232" VPOS="5662" WIDTH="2981" HEIGHT="101"/>
          </TextLine>
