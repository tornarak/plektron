            </Shape>
            <String CONTENT="А̂ттымlө̂́-lѵ́мӈыl. Сказка объ А̂́ттымlу̂." HPOS="1168" VPOS="1976" WIDTH="1761" HEIGHT="124"/>
          </TextLine>
