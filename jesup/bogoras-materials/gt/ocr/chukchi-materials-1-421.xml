            </Shape>
            <String CONTENT="Записано отъ чукчи кривого Кэўтэ́ђын’а въ Нижнеколымскѣ." HPOS="771" VPOS="1333" WIDTH="2213" HEIGHT="97"/>
          </TextLine>
