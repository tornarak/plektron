            <String CONTENT="II,135. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 365" HPOS="555" VPOS="570" WIDTH="2983" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-421_l2" HPOS="559" VPOS="812" WIDTH="2983" HEIGHT="90" BASELINE="559 901 3542 901">
            <Shape>
              <Polygon POINTS="559 812 3542 812 3542 902 559 902"/>
            </Shape>
            <String CONTENT="стадо мимо чукотскихъ шатровъ, не останавливаясь ни на минуту; отъ" HPOS="559" VPOS="812" WIDTH="2983" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-421_l3" HPOS="559" VPOS="922" WIDTH="2985" HEIGHT="100" BASELINE="559 1022 3544 1022">
            <Shape>
              <Polygon POINTS="559 922 3544 922 3544 1022 559 1022"/>
            </Shape>
            <String CONTENT="стука копытъ не было слышно человѣческаго слова. Только на пятый день" HPOS="559" VPOS="922" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-421_l4" HPOS="561" VPOS="1050" WIDTH="2981" HEIGHT="96" BASELINE="561 1146 3542 1146">
            <Shape>
              <Polygon POINTS="561 1050 3542 1050 3542 1146 561 1146"/>
            </Shape>
            <String CONTENT="къ вечеру показались задніе олени. Такъ велико было стадо. Такъ стали" HPOS="561" VPOS="1050" WIDTH="2981" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-421_l5" HPOS="555" VPOS="1173" WIDTH="2876" HEIGHT="99" BASELINE="555 1271 3431 1271">
            <Shape>
              <Polygon POINTS="555 1173 3431 1173 3431 1272 555 1272"/>
            </Shape>
            <String CONTENT="Та́lо и братья его богаты и сильны, и зажили¹) на жительствѣ. Только." HPOS="555" VPOS="1173" WIDTH="2876" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-421_l6" HPOS="771" VPOS="1333" WIDTH="2213" HEIGHT="97" BASELINE="771 1429 2984 1429">
