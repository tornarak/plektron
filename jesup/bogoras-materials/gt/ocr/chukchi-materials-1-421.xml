          </TextLine>
          <TextLine ID="mz_1-421_l10" HPOS="771" VPOS="2234" WIDTH="2773" HEIGHT="108" BASELINE="771 2341 3544 2341">
            <Shape>
              <Polygon POINTS="771 2234 3544 2234 3544 2342 771 2342"/>
            </Shape>
            <String CONTENT="Нѣкогда А̂́ттымlу̂²) настоящій силачъ, прозвище дали ему таньги," HPOS="771" VPOS="2234" WIDTH="2773" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-421_l11" HPOS="565" VPOS="2369" WIDTH="2975" HEIGHT="101" BASELINE="565 2469 3540 2469">
            <Shape>
              <Polygon POINTS="565 2369 3540 2369 3540 2470 565 2470"/>
            </Shape>
            <String CONTENT="ибо у него словно костяное лицо: какъ ни стрѣляютъ, не могутъ ранить." HPOS="565" VPOS="2369" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-421_l12" HPOS="557" VPOS="2495" WIDTH="2988" HEIGHT="102" BASELINE="557 2596 3545 2596">
            <Shape>
              <Polygon POINTS="557 2495 3545 2495 3545 2597 557 2597"/>
            </Shape>
            <String CONTENT="Постоянно ходитъ въ панцырѣ. Съ нимъ вмѣстѣ живетъ Эlэ́ннут, смѣнный" HPOS="557" VPOS="2495" WIDTH="2988" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-421_l13" HPOS="564" VPOS="2620" WIDTH="2980" HEIGHT="104" BASELINE="564 2724 3544 2724">
            <Shape>
              <Polygon POINTS="564 2620 3544 2620 3544 2724 564 2724"/>
            </Shape>
            <String CONTENT="его товарищъ по женѣ. Онъ поссорился съ силачемъ Кивающимъ головою³)," HPOS="564" VPOS="2620" WIDTH="2980" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-421_l14" HPOS="561" VPOS="2749" WIDTH="2989" HEIGHT="100" BASELINE="561 2848 3550 2848">
            <Shape>
              <Polygon POINTS="561 2749 3550 2749 3550 2849 561 2849"/>
            </Shape>
            <String CONTENT="и ударилъ его ладонью по головѣ; тотъ хворалъ цѣлое лѣто. Потомъ онъ" HPOS="561" VPOS="2749" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-421_l15" HPOS="564" VPOS="2884" WIDTH="2979" HEIGHT="96" BASELINE="564 2980 3543 2980">
            <Shape>
              <Polygon POINTS="564 2884 3543 2884 3543 2980 564 2980"/>
            </Shape>
            <String CONTENT="поправился, сталъ упражняться: бѣгаетъ, фехтуетъ копьемъ, таскаетъ" HPOS="564" VPOS="2884" WIDTH="2979" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-421_l16" HPOS="566" VPOS="3003" WIDTH="2982" HEIGHT="101" BASELINE="566 3104 3548 3104">
            <Shape>
              <Polygon POINTS="566 3003 3548 3003 3548 3104 566 3104"/>
            </Shape>
            <String CONTENT="тяжести. Два года упражнялся. Потомъ съ братомъ поѣхали они къ" HPOS="566" VPOS="3003" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-421_l17" HPOS="567" VPOS="3127" WIDTH="2980" HEIGHT="102" BASELINE="567 3228 3547 3228">
            <Shape>
              <Polygon POINTS="567 3127 3547 3127 3547 3229 567 3229"/>
            </Shape>
            <String CONTENT="силачу. Пріѣхали къ нему, вошли, пообѣдали. «Какъ дорога?» говоритъ." HPOS="567" VPOS="3127" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-421_l18" HPOS="566" VPOS="3222" WIDTH="2978" HEIGHT="132" BASELINE="566 3353 3544 3353">
            <Shape>
              <Polygon POINTS="566 3222 3544 3222 3544 3354 566 3354"/>
            </Shape>
            <String CONTENT="«Ничего себѣ.» Потомъ говорятъ: «А знаешь-ли, зачѣмъ мы пріѣхали?» —" HPOS="566" VPOS="3222" WIDTH="2978" HEIGHT="132"/>
          </TextLine>
          <TextLine ID="mz_1-421_l19" HPOS="570" VPOS="3343" WIDTH="2982" HEIGHT="140" BASELINE="570 3482 3552 3482">
            <Shape>
              <Polygon POINTS="570 3343 3552 3343 3552 3483 570 3483"/>
            </Shape>
            <String CONTENT="«Да. Ну чтожъ, хотите, я вамъ дамъ два лахтака⁴)?» — «Зачѣмъ, развѣ" HPOS="570" VPOS="3343" WIDTH="2982" HEIGHT="140"/>
          </TextLine>
          <TextLine ID="mz_1-421_l20" HPOS="567" VPOS="3442" WIDTH="2982" HEIGHT="142" BASELINE="567 3584 3549 3584">
            <Shape>
              <Polygon POINTS="567 3442 3549 3442 3549 3584 567 3584"/>
            </Shape>
            <String CONTENT="мы пріѣхали за имуществомъ?» — «Ну, дамъ два бобра!» — «Развѣ" HPOS="567" VPOS="3442" WIDTH="2982" HEIGHT="142"/>
          </TextLine>
          <TextLine ID="mz_1-421_l21" HPOS="569" VPOS="3589" WIDTH="2984" HEIGHT="141" BASELINE="569 3729 3553 3729">
            <Shape>
              <Polygon POINTS="569 3589 3553 3589 3553 3730 569 3730"/>
            </Shape>
            <String CONTENT="ты безуменъ? Мы пріѣхали не для того.» — «Для чего-же вы прі-" HPOS="569" VPOS="3589" WIDTH="2984" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-421_l22" HPOS="564" VPOS="3732" WIDTH="2985" HEIGHT="107" BASELINE="564 3838 3549 3838">
            <Shape>
              <Polygon POINTS="564 3732 3549 3732 3549 3839 564 3839"/>
            </Shape>
            <String CONTENT="ѣхали?» — «Подумай! Собери свои мысли (угадай, для чего мы прі-" HPOS="564" VPOS="3732" WIDTH="2985" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-421_l23" HPOS="570" VPOS="3843" WIDTH="2979" HEIGHT="142" BASELINE="570 3984 3549 3984">
            <Shape>
              <Polygon POINTS="570 3843 3549 3843 3549 3985 570 3985"/>
            </Shape>
            <String CONTENT="ѣхали)!» — «А, ну ладно, выйдемъ!» Lаwтыlыwа́lын силачъ, другой Јыр-" HPOS="570" VPOS="3843" WIDTH="2979" HEIGHT="142"/>
          </TextLine>
          <TextLine ID="mz_1-421_l24" HPOS="566" VPOS="4006" WIDTH="2986" HEIGHT="103" BASELINE="566 4108 3552 4108">
            <Shape>
              <Polygon POINTS="566 4006 3552 4006 3552 4109 566 4109"/>
            </Shape>
            <String CONTENT="кытоwа́łа̂н⁵) вышли. Эlэ́ннут сѣлъ на санки и смотритъ. Засучилъ ру-" HPOS="566" VPOS="4006" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-421_l25" HPOS="571" VPOS="4138" WIDTH="2980" HEIGHT="99" BASELINE="571 4236 3551 4236">
            <Shape>
              <Polygon POINTS="571 4138 3551 4138 3551 4237 571 4237"/>
            </Shape>
            <String CONTENT="кава Костянолицый. Налетѣлъ на его одинъ, протянулъ только руку," HPOS="571" VPOS="4138" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-421_l26" HPOS="575" VPOS="4220" WIDTH="2857" HEIGHT="144" BASELINE="575 4363 3432 4363">
            <Shape>
              <Polygon POINTS="575 4220 3432 4220 3432 4364 575 4364"/>
            </Shape>
            <String CONTENT="смотритъ — сзади другой. «Какъ?» говоритъ. «Двое?» — «Да, вдвоемъ!» —" HPOS="575" VPOS="4220" WIDTH="2857" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-421_l27" HPOS="573" VPOS="4373" WIDTH="2985" HEIGHT="114" BASELINE="573 4486 3558 4486">
            <Shape>
              <Polygon POINTS="573 4373 3558 4373 3558 4487 573 4487"/>
            </Shape>
            <String CONTENT="«Ну ладно, пусть!» Схватилъ ихъ за шивороты, тряхнулъ, стукнулъ" HPOS="573" VPOS="4373" WIDTH="2985" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-421_l28" HPOS="575" VPOS="4503" WIDTH="2985" HEIGHT="108" BASELINE="575 4610 3560 4610">
            <Shape>
              <Polygon POINTS="575 4503 3560 4503 3560 4611 575 4611"/>
            </Shape>
            <String CONTENT="разъ-другой лицами и бросилъ на землю. На землѣ кровь, какъ отъ" HPOS="575" VPOS="4503" WIDTH="2985" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-421_l29" HPOS="575" VPOS="4626" WIDTH="2988" HEIGHT="116" BASELINE="575 4741 3563 4741">
            <Shape>
              <Polygon POINTS="575 4626 3563 4626 3563 4742 575 4742"/>
            </Shape>
            <String CONTENT="убоя оленя. Тогда вошелъ А̂́ттымlу̂ въ пологъ и сѣлъ тамъ, не глядя" HPOS="575" VPOS="4626" WIDTH="2988" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-421_l30" HPOS="564" VPOS="4727" WIDTH="727" HEIGHT="91" BASELINE="564 4817 1291 4817">
            <Shape>
              <Polygon POINTS="564 4727 1291 4727 1291 4818 564 4818"/>
            </Shape>
            <String CONTENT="на побѣжденныхъ." HPOS="564" VPOS="4727" WIDTH="727" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-421_l31" HPOS="775" VPOS="4919" WIDTH="1820" HEIGHT="102" BASELINE="775 5020 2595 5020">
