            </Shape>
            <String CONTENT="Теперь только, убой и потребленіе окончивъ, послѣдъ при сжиганіи костей" HPOS="463" VPOS="4879" WIDTH="2993" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-059_l35" HPOS="467" VPOS="5002" WIDTH="2989" HEIGHT="99" BASELINE="467 5100 3456 5100">
