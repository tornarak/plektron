          </TextLine>
          <TextLine ID="mz_1-059_l33" HPOS="464" VPOS="4752" WIDTH="3098" HEIGHT="100" BASELINE="464 4851 3562 4851">
            <Shape>
              <Polygon POINTS="464 4752 3562 4752 3562 4852 464 4852"/>
            </Shape>
            <String CONTENT="говоря: «моего дыма запахъ понюхай, моего логовища (запахъ) понюхай!» 25" HPOS="464" VPOS="4752" WIDTH="3098" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-059_l34" HPOS="463" VPOS="4879" WIDTH="2993" HEIGHT="96" BASELINE="463 4974 3456 4974">
