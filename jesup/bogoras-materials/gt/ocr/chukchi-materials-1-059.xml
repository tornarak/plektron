            </Shape>
            <String CONTENT="скалѣ помѣстилъ тебя! Что за диво, что за диво! на великой горѣ помѣ- 15" HPOS="458" VPOS="3249" WIDTH="3105" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-059_l22" HPOS="458" VPOS="3372" WIDTH="2994" HEIGHT="98" BASELINE="458 3469 3452 3469">
            <Shape>
              <Polygon POINTS="458 3372 3452 3372 3452 3470 458 3470"/>
            </Shape>
            <String CONTENT="стилъ тебя. Что за диво, что за диво! въ большой ложбинѣ помѣстилъ" HPOS="458" VPOS="3372" WIDTH="2994" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-059_l23" HPOS="457" VPOS="3503" WIDTH="2994" HEIGHT="96" BASELINE="457 3598 3451 3598">
            <Shape>
              <Polygon POINTS="457 3503 3451 3503 3451 3599 457 3599"/>
            </Shape>
            <String CONTENT="тебя! Что за диво, что за диво! съ обѣихъ сторонъ падающими камнями, съ" HPOS="457" VPOS="3503" WIDTH="2994" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-059_l24" HPOS="458" VPOS="3623" WIDTH="2997" HEIGHT="100" BASELINE="458 3722 3455 3722">
            <Shape>
              <Polygon POINTS="458 3623 3455 3623 3455 3723 458 3723"/>
            </Shape>
            <String CONTENT="невидящими глазами сдѣлалъ тебя! Что за диво, что за диво! съ обѣихъ" HPOS="458" VPOS="3623" WIDTH="2997" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-059_l25" HPOS="464" VPOS="3743" WIDTH="2987" HEIGHT="102" BASELINE="464 3844 3451 3844">
            <Shape>
              <Polygon POINTS="464 3743 3451 3743 3451 3845 464 3845"/>
            </Shape>
            <String CONTENT="сторонъ падающими камнями, съ неслышащими ушами сдѣлалъ тебя! Что-" HPOS="464" VPOS="3743" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-059_l26" HPOS="462" VPOS="3870" WIDTH="2980" HEIGHT="103" BASELINE="462 3973 3442 3973">
            <Shape>
              <Polygon POINTS="462 3870 3442 3870 3442 3973 462 3973"/>
            </Shape>
            <String CONTENT="же! камнями обложилъ твою шерсть! Что-же! макушка (средина) зенита!" HPOS="462" VPOS="3870" WIDTH="2980" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-059_l27" HPOS="459" VPOS="3993" WIDTH="3103" HEIGHT="105" BASELINE="459 4097 3562 4097">
            <Shape>
              <Polygon POINTS="459 3993 3562 3993 3562 4098 459 4098"/>
            </Shape>
            <String CONTENT="ударяющій камень дай мнѣ! (берутъ лѣвой рукой). Ему между роговъ на 20" HPOS="459" VPOS="3993" WIDTH="3103" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-059_l28" HPOS="464" VPOS="4116" WIDTH="2982" HEIGHT="105" BASELINE="464 4220 3446 4220">
            <Shape>
              <Polygon POINTS="464 4116 3446 4116 3446 4221 464 4221"/>
            </Shape>
            <String CONTENT="темя положу! Что-же! на большое озеро помѣстилъ тебя! Что за диво," HPOS="464" VPOS="4116" WIDTH="2982" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-059_l29" HPOS="460" VPOS="4247" WIDTH="2991" HEIGHT="101" BASELINE="460 4347 3451 4347">
            <Shape>
              <Polygon POINTS="460 4247 3451 4247 3451 4348 460 4348"/>
            </Shape>
            <String CONTENT="что за диво! на шумно колющемся ледникѣ съ невидящими глазами помѣ-" HPOS="460" VPOS="4247" WIDTH="2991" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-059_l30" HPOS="464" VPOS="4364" WIDTH="2985" HEIGHT="107" BASELINE="464 4470 3449 4470">
            <Shape>
              <Polygon POINTS="464 4364 3449 4364 3449 4471 464 4471"/>
            </Shape>
            <String CONTENT="стилъ тебя! Что-же! макушка зенита, развилокъ дай! Этому на шею по-" HPOS="464" VPOS="4364" WIDTH="2985" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-059_l31" HPOS="464" VPOS="4495" WIDTH="2988" HEIGHT="103" BASELINE="464 4597 3452 4597">
            <Shape>
              <Polygon POINTS="464 4495 3452 4495 3452 4598 464 4598"/>
            </Shape>
            <String CONTENT="вѣшу. Съ обѣихъ сторонъ концами стада затаптываемый!... Какъ разъ" HPOS="464" VPOS="4495" WIDTH="2988" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-059_l32" HPOS="467" VPOS="4626" WIDTH="2981" HEIGHT="98" BASELINE="467 4723 3448 4723">
