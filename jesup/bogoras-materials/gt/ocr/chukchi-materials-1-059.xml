              <Polygon POINTS="467 5002 3456 5002 3456 5101 467 5101"/>
            </Shape>
            <String CONTENT="сжигаютъ. Передъ убоемъ, передъ бросаніемъ аркана, чумъ разстилаютъ" HPOS="467" VPOS="5002" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-059_l36" HPOS="469" VPOS="5116" WIDTH="2986" HEIGHT="109" BASELINE="469 5224 3455 5224">
            <Shape>
              <Polygon POINTS="469 5116 3455 5116 3455 5225 469 5225"/>
            </Shape>
            <String CONTENT="сзади шатра. На этомъ долженъ быть убитымъ, также ободраннымъ на" HPOS="469" VPOS="5116" WIDTH="2986" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-059_l37" HPOS="464" VPOS="5248" WIDTH="2992" HEIGHT="109" BASELINE="464 5356 3456 5356">
