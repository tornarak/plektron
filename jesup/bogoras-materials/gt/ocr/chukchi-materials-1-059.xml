            </Shape>
            <String CONTENT="чумѣ. Недавно заговоръ кончивъ, намѣтили важенку въ жены, въ умѣ, въ" HPOS="464" VPOS="5248" WIDTH="2992" HEIGHT="109"/>
          </TextLine>
