        <TextBlock ID="text_1-360" HPOS="1175" VPOS="580" WIDTH="2995" HEIGHT="5223">
          <TextLine ID="mz_1-360_l1" HPOS="1181" VPOS="580" WIDTH="2987" HEIGHT="111" BASELINE="1181 690 4168 690">
            <Shape>
              <Polygon POINTS="1181 580 4168 580 4168 691 1181 691"/>
            </Shape>
            <String CONTENT="304 Г. БОГОРАЗЪ, II,117." HPOS="1181" VPOS="580" WIDTH="2987" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-360_l2" HPOS="2330" VPOS="629" WIDTH="56" HEIGHT="62" BASELINE="2330 690 2386 690">
            <Shape>
              <Polygon POINTS="2330 629 2386 629 2386 691 2330 691"/>
            </Shape>
            <String CONTENT="В." HPOS="2330" VPOS="629" WIDTH="56" HEIGHT="62"/>
          </TextLine>
          <TextLine ID="mz_1-360_l3" HPOS="1180" VPOS="783" WIDTH="2986" HEIGHT="135" BASELINE="1180 915 4166 915">
            <Shape>
              <Polygon POINTS="1180 783 4166 783 4166 918 1180 918"/>
            </Shape>
            <String CONTENT="убѣжалъ.» — «Иди-же! Они тебя прослѣдятъ. Иди скорѣй!» Полетѣлъ," HPOS="1180" VPOS="783" WIDTH="2986" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-360_l4" HPOS="1180" VPOS="908" WIDTH="2990" HEIGHT="115" BASELINE="1180 1020 4170 1020">
            <Shape>
              <Polygon POINTS="1180 908 4170 908 4170 1023 1180 1023"/>
            </Shape>
            <String CONTENT="дальше. Увидѣлъ гонящихся. «Вы», говоритъ, «зачѣмъ?» — «Гонимся за" HPOS="1180" VPOS="908" WIDTH="2990" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-360_l5" HPOS="1181" VPOS="1024" WIDTH="2985" HEIGHT="126" BASELINE="1181 1148 4166 1148">
            <Shape>
              <Polygon POINTS="1181 1024 4166 1024 4166 1150 1181 1150"/>
            </Shape>
            <String CONTENT="зятемъ.» — «Э-э-э! Онъ уже пришелъ на землю, на свою родину. Его люди" HPOS="1181" VPOS="1024" WIDTH="2985" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-360_l6" HPOS="1185" VPOS="1193" WIDTH="2979" HEIGHT="103" BASELINE="1185 1291 4164 1291">
            <Shape>
              <Polygon POINTS="1185 1193 4164 1193 4164 1296 1185 1296"/>
            </Shape>
            <String CONTENT="его встрѣтили, много народа съ собаками, идутъ къ вамъ, ищутъ васъ," HPOS="1185" VPOS="1193" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-360_l7" HPOS="1187" VPOS="1322" WIDTH="2973" HEIGHT="100" BASELINE="1187 1417 4160 1417">
            <Shape>
              <Polygon POINTS="1187 1322 4160 1322 4160 1422 1187 1422"/>
            </Shape>
            <String CONTENT="слѣдятъ медвѣдей. Скорѣе разойдитесь, а то васъ перебьютъ!» Вернулись." HPOS="1187" VPOS="1322" WIDTH="2973" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-360_l8" HPOS="1189" VPOS="1433" WIDTH="2979" HEIGHT="113" BASELINE="1189 1541 4168 1541">
            <Shape>
              <Polygon POINTS="1189 1433 4168 1433 4168 1546 1189 1546"/>
            </Shape>
            <String CONTENT="«О», говорятъ, «вправду убьютъ!» Вернулись домой. Тотъ вернулся въ" HPOS="1189" VPOS="1433" WIDTH="2979" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-360_l9" HPOS="1189" VPOS="1575" WIDTH="403" HEIGHT="84" BASELINE="1189 1658 1592 1658">
            <Shape>
              <Polygon POINTS="1189 1575 1592 1575 1592 1659 1189 1659"/>
            </Shape>
            <String CONTENT="свой домъ." HPOS="1189" VPOS="1575" WIDTH="403" HEIGHT="84"/>
          </TextLine>
          <TextLine ID="mz_1-360_l10" HPOS="1408" VPOS="1710" WIDTH="1879" HEIGHT="93" BASELINE="1408 1803 3287 1803">
            <Shape>
              <Polygon POINTS="1408 1710 3287 1710 3287 1803 1408 1803"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи Ајнан̀ва́т’а въ Нижнеколымскѣ." HPOS="1408" VPOS="1710" WIDTH="1879" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-360_l11" HPOS="2585" VPOS="2058" WIDTH="153" HEIGHT="92" BASELINE="2585 2150 2738 2150">
            <Shape>
              <Polygon POINTS="2585 2058 2738 2058 2738 2150 2585 2150"/>
            </Shape>
            <String CONTENT="118." HPOS="2585" VPOS="2058" WIDTH="153" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-360_l12" HPOS="1771" VPOS="2224" WIDTH="1809" HEIGHT="110" BASELINE="1771 2333 3580 2333">
            <Shape>
              <Polygon POINTS="1771 2224 3580 2224 3580 2334 1771 2334"/>
            </Shape>
            <String CONTENT="Амамко̀т-lѵ́мӈыl. Объ Эмэмку́тѣ сказка." HPOS="1771" VPOS="2224" WIDTH="1809" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-360_l13" HPOS="1395" VPOS="2415" WIDTH="2759" HEIGHT="125" BASELINE="1395 2539 4154 2539">
            <Shape>
              <Polygon POINTS="1395 2415 4154 2415 4154 2540 1395 2540"/>
            </Shape>
            <String CONTENT="У Эмэмку́та много родственниковъ, но все дальніе; братьевъ нѣтъ." HPOS="1395" VPOS="2415" WIDTH="2759" HEIGHT="125"/>
          </TextLine>
          <TextLine ID="mz_1-360_l14" HPOS="1190" VPOS="2560" WIDTH="2969" HEIGHT="105" BASELINE="1190 2665 4159 2665">
            <Shape>
              <Polygon POINTS="1190 2560 4159 2560 4159 2665 1190 2665"/>
            </Shape>
            <String CONTENT="Особо его домъ стоитъ. Двѣ жены у него: одна жена куропатка, другая" HPOS="1190" VPOS="2560" WIDTH="2969" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-360_l15" HPOS="1186" VPOS="2683" WIDTH="2971" HEIGHT="105" BASELINE="1186 2787 4157 2787">
            <Shape>
              <Polygon POINTS="1186 2683 4157 2683 4157 2788 1186 2788"/>
            </Shape>
            <String CONTENT="евражка; но все-таки хорошія женщины. Родственникъ его убилъ и женъ" HPOS="1186" VPOS="2683" WIDTH="2971" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-360_l16" HPOS="1186" VPOS="2810" WIDTH="2975" HEIGHT="101" BASELINE="1186 2910 4161 2910">
            <Shape>
              <Polygon POINTS="1186 2810 4161 2810 4161 2911 1186 2911"/>
            </Shape>
            <String CONTENT="забралъ. Говоритъ ему: «Завтра пойдемъ на ладьѣ въ море.» Тамъ въ" HPOS="1186" VPOS="2810" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-360_l17" HPOS="1182" VPOS="2943" WIDTH="2975" HEIGHT="101" BASELINE="1182 3043 4157 3043">
            <Shape>
              <Polygon POINTS="1182 2943 4157 2943 4157 3044 1182 3044"/>
            </Shape>
            <String CONTENT="моржа метнулъ копьемъ, а его связали и бросили вмѣсто пузыря въ море," HPOS="1182" VPOS="2943" WIDTH="2975" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-360_l18" HPOS="1184" VPOS="3062" WIDTH="2975" HEIGHT="103" BASELINE="1184 3164 4159 3164">
            <Shape>
              <Polygon POINTS="1184 3062 4159 3062 4159 3165 1184 3165"/>
            </Shape>
            <String CONTENT="на самое открытое море, — его моржъ унесъ. Домой всѣ люди уплыли." HPOS="1184" VPOS="3062" WIDTH="2975" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-360_l19" HPOS="1176" VPOS="3187" WIDTH="2985" HEIGHT="105" BASELINE="1176 3291 4161 3291">
            <Shape>
              <Polygon POINTS="1176 3187 4161 3187 4161 3292 1176 3292"/>
            </Shape>
            <String CONTENT="Погнались за тѣми женами, кто первый схватитъ. Тѣ бѣгутъ впереди," HPOS="1176" VPOS="3187" WIDTH="2985" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-360_l20" HPOS="1180" VPOS="3315" WIDTH="2977" HEIGHT="104" BASELINE="1180 3418 4157 3418">
            <Shape>
              <Polygon POINTS="1180 3315 4157 3315 4157 3419 1180 3419"/>
            </Shape>
            <String CONTENT="какъ на бѣгу взапуски. Пришли, а онъ тамъ сидитъ въ пологѣ, шаманитъ." HPOS="1180" VPOS="3315" WIDTH="2977" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-360_l21" HPOS="1176" VPOS="3408" WIDTH="2984" HEIGHT="135" BASELINE="1176 3543 4160 3543">
            <Shape>
              <Polygon POINTS="1176 3408 4160 3408 4160 3543 1176 3543"/>
            </Shape>
            <String CONTENT="«Ну что, пришелъ?» — «Да!» Ѣду варятъ. «Развѣ вы не подождете? Идите" HPOS="1176" VPOS="3408" WIDTH="2984" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-360_l22" HPOS="1181" VPOS="3559" WIDTH="2983" HEIGHT="107" BASELINE="1181 3666 4164 3666">
            <Shape>
              <Polygon POINTS="1181 3559 4164 3559 4164 3666 1181 3666"/>
            </Shape>
            <String CONTENT="въ пологъ! На завтра по сушѣ на сѣндуху пойдемъ.» Увидѣли медвѣдя," HPOS="1181" VPOS="3559" WIDTH="2983" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-360_l23" HPOS="1181" VPOS="3699" WIDTH="2982" HEIGHT="98" BASELINE="1181 3797 4163 3797">
            <Shape>
              <Polygon POINTS="1181 3699 4163 3699 4163 3797 1181 3797"/>
            </Shape>
            <String CONTENT="погнали, бросили арканомъ, поймали, привязали Эмэмку́та, пошли домой." HPOS="1181" VPOS="3699" WIDTH="2982" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-360_l24" HPOS="1184" VPOS="3816" WIDTH="2980" HEIGHT="101" BASELINE="1184 3916 4164 3916">
            <Shape>
              <Polygon POINTS="1184 3816 4164 3816 4164 3917 1184 3917"/>
            </Shape>
            <String CONTENT="Опять какъ на бѣгу гонятся за женами. Люди пришли домой, а онъ ужъ" HPOS="1184" VPOS="3816" WIDTH="2980" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-360_l25" HPOS="1183" VPOS="3945" WIDTH="2981" HEIGHT="95" BASELINE="1183 4039 4164 4039">
            <Shape>
              <Polygon POINTS="1183 3945 4164 3945 4164 4040 1183 4040"/>
            </Shape>
            <String CONTENT="напередъ ихъ дошелъ и бьетъ въ бубенъ. Опять заставили его уйти на" HPOS="1183" VPOS="3945" WIDTH="2981" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-360_l26" HPOS="1175" VPOS="4072" WIDTH="2983" HEIGHT="99" BASELINE="1175 4170 4158 4170">
            <Shape>
              <Polygon POINTS="1175 4072 4158 4072 4158 4171 1175 4171"/>
            </Shape>
            <String CONTENT="море. Опять къ бѣлому медвѣдю привязали. Опять пошли домой, побѣжали," HPOS="1175" VPOS="4072" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-360_l27" HPOS="1187" VPOS="4190" WIDTH="2973" HEIGHT="102" BASELINE="1187 4291 4160 4291">
            <Shape>
              <Polygon POINTS="1187 4190 4160 4190 4160 4292 1187 4292"/>
            </Shape>
            <String CONTENT="а онъ ужъ сидитъ и шаманитъ. Землю выкопали, туда положили всякихъ" HPOS="1187" VPOS="4190" WIDTH="2973" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-360_l28" HPOS="1180" VPOS="4319" WIDTH="2984" HEIGHT="104" BASELINE="1180 4423 4164 4423">
            <Shape>
              <Polygon POINTS="1180 4319 4164 4319 4164 4423 1180 4423"/>
            </Shape>
            <String CONTENT="червей. Все время даютъ имъ мясо; они большіе стали. Моржовый жиръ," HPOS="1180" VPOS="4319" WIDTH="2984" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-360_l29" HPOS="1185" VPOS="4412" WIDTH="2979" HEIGHT="134" BASELINE="1185 4545 4164 4545">
            <Shape>
              <Polygon POINTS="1185 4412 4164 4412 4164 4546 1185 4546"/>
            </Shape>
            <String CONTENT="туда набросали, — они все ѣдятъ. Куски величиной съ человѣка бросаютъ" HPOS="1185" VPOS="4412" WIDTH="2979" HEIGHT="134"/>
          </TextLine>
          <TextLine ID="mz_1-360_l30" HPOS="1186" VPOS="4565" WIDTH="2974" HEIGHT="108" BASELINE="1186 4673 4160 4673">
            <Shape>
              <Polygon POINTS="1186 4565 4160 4565 4160 4673 1186 4673"/>
            </Shape>
            <String CONTENT="туда, сразу исчезаютъ. Говоритъ женѣ: «Ну, теперь они убьютъ меня, по-" HPOS="1186" VPOS="4565" WIDTH="2974" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-360_l31" HPOS="1184" VPOS="4692" WIDTH="2973" HEIGHT="104" BASELINE="1184 4795 4157 4795">
            <Shape>
              <Polygon POINTS="1184 4692 4157 4692 4157 4796 1184 4796"/>
            </Shape>
            <String CONTENT="тому что весьма худую вещь сдѣлали. Если убьютъ, то вы станьте съ" HPOS="1184" VPOS="4692" WIDTH="2973" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-360_l32" HPOS="1188" VPOS="4789" WIDTH="2969" HEIGHT="130" BASELINE="1188 4918 4157 4918">
            <Shape>
              <Polygon POINTS="1188 4789 4157 4789 4157 4919 1188 4919"/>
            </Shape>
            <String CONTENT="прежнимъ своимъ тѣломъ, — пусть-же возьмутъ васъ. Выйдите изъ дымо-" HPOS="1188" VPOS="4789" WIDTH="2969" HEIGHT="130"/>
          </TextLine>
          <TextLine ID="mz_1-360_l33" HPOS="1184" VPOS="4944" WIDTH="2979" HEIGHT="107" BASELINE="1184 5051 4163 5051">
            <Shape>
              <Polygon POINTS="1184 4944 4163 4944 4163 5051 1184 5051"/>
            </Shape>
            <String CONTENT="ваго отверстія или подъ полой шатра. Но только по прежнему уйдите на" HPOS="1184" VPOS="4944" WIDTH="2979" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-360_l34" HPOS="1188" VPOS="5075" WIDTH="2966" HEIGHT="98" BASELINE="1188 5172 4154 5172">
            <Shape>
              <Polygon POINTS="1188 5075 4154 5075 4154 5173 1188 5173"/>
            </Shape>
            <String CONTENT="сѣндуху!» Опять позвали его родственники. Наварили много хорошаго мяса." HPOS="1188" VPOS="5075" WIDTH="2966" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-360_l35" HPOS="1187" VPOS="5190" WIDTH="2974" HEIGHT="110" BASELINE="1187 5299 4161 5299">
            <Shape>
              <Polygon POINTS="1187 5190 4161 5190 4161 5300 1187 5300"/>
            </Shape>
            <String CONTENT="«Ну-ка», говорятъ, «мы поѣдимъ на дворѣ; теперь хорошо снаружи!» Ѣли" HPOS="1187" VPOS="5190" WIDTH="2974" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-360_l36" HPOS="1184" VPOS="5326" WIDTH="2979" HEIGHT="100" BASELINE="1184 5426 4163 5426">
            <Shape>
              <Polygon POINTS="1184 5326 4163 5326 4163 5426 1184 5426"/>
            </Shape>
            <String CONTENT="тамъ близко къ погребу. Поѣли они, открыли погребъ и кинули его въ" HPOS="1184" VPOS="5326" WIDTH="2979" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-360_l37" HPOS="1184" VPOS="5447" WIDTH="2978" HEIGHT="102" BASELINE="1184 5549 4162 5549">
            <Shape>
              <Polygon POINTS="1184 5447 4162 5447 4162 5549 1184 5549"/>
            </Shape>
            <String CONTENT="погребъ. Сразу его истребили черви. Всѣ люди побѣжали къ дому. Вошли" HPOS="1184" VPOS="5447" WIDTH="2978" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-360_l38" HPOS="1186" VPOS="5548" WIDTH="2967" HEIGHT="126" BASELINE="1186 5673 4153 5673">
            <Shape>
              <Polygon POINTS="1186 5548 4153 5548 4153 5674 1186 5674"/>
            </Shape>
            <String CONTENT="въ домъ: одна жена скользнула изъ-подъ полы — чик! другая вспорхнула —" HPOS="1186" VPOS="5548" WIDTH="2967" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-360_l39" HPOS="1184" VPOS="5695" WIDTH="2976" HEIGHT="108" BASELINE="1184 5803 4160 5803">
            <Shape>
              <Polygon POINTS="1184 5695 4160 5695 4160 5803 1184 5803"/>
            </Shape>
            <String CONTENT="райа́! «О», говорятъ, «мы думали: хорошія женщины; понапрасну убили" HPOS="1184" VPOS="5695" WIDTH="2976" HEIGHT="108"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
  </Layout>
