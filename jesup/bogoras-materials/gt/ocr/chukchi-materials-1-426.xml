        <TextBlock ID="text_1-426" HPOS="1128" VPOS="548" WIDTH="3004" HEIGHT="5222">
          <TextLine ID="mz_1-426_l1" HPOS="1141" VPOS="548" WIDTH="2988" HEIGHT="109" BASELINE="1141 652 4129 652">
            <Shape>
              <Polygon POINTS="1141 548 4129 548 4129 657 1141 657"/>
            </Shape>
            <String CONTENT="370 В. БОГОРАЗЪ, II,138." HPOS="1141" VPOS="548" WIDTH="2988" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-426_l2" HPOS="2416" VPOS="595" WIDTH="49" HEIGHT="58" BASELINE="2416 652 2465 652">
            <Shape>
              <Polygon POINTS="2416 595 2465 595 2465 653 2416 653"/>
            </Shape>
            <String CONTENT="Г." HPOS="2416" VPOS="595" WIDTH="49" HEIGHT="58"/>
          </TextLine>
          <TextLine ID="mz_1-426_l3" HPOS="1141" VPOS="778" WIDTH="2991" HEIGHT="96" BASELINE="1141 873 4132 873">
            <Shape>
              <Polygon POINTS="1141 778 4132 778 4132 874 1141 874"/>
            </Shape>
            <String CONTENT="братьямъ: «Послѣзавтра привезите много оленьихъ боковъ на запасъ, не" HPOS="1141" VPOS="778" WIDTH="2991" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-426_l4" HPOS="1141" VPOS="861" WIDTH="2985" HEIGHT="138" BASELINE="1141 999 4126 999">
            <Shape>
              <Polygon POINTS="1141 861 4126 861 4126 999 1141 999"/>
            </Shape>
            <String CONTENT="то проучу васъ!» — «Эђэ́ј!» Они вдвоемъ смастерили большое судно, об-" HPOS="1141" VPOS="861" WIDTH="2985" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-426_l5" HPOS="1139" VPOS="1021" WIDTH="2986" HEIGHT="100" BASELINE="1139 1120 4125 1120">
            <Shape>
              <Polygon POINTS="1139 1021 4125 1021 4125 1121 1139 1121"/>
            </Shape>
            <String CONTENT="тянули моржовой шкурой. Покончивъ испытали. Далекоходное судно. При-" HPOS="1139" VPOS="1021" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-426_l6" HPOS="1138" VPOS="1137" WIDTH="2988" HEIGHT="110" BASELINE="1138 1246 4126 1246">
            <Shape>
              <Polygon POINTS="1138 1137 4126 1137 4126 1247 1138 1247"/>
            </Shape>
            <String CONTENT="стали къ берегу, говоритъ Мыткакай: «Еще тяжело, въ два раза тяжело!»" HPOS="1138" VPOS="1137" WIDTH="2988" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-426_l7" HPOS="1137" VPOS="1274" WIDTH="2985" HEIGHT="103" BASELINE="1137 1376 4122 1376">
            <Shape>
              <Polygon POINTS="1137 1274 4122 1274 4122 1377 1137 1377"/>
            </Shape>
            <String CONTENT="Снова перетянули, снова испытали. По берегу летятъ птицы; они плывутъ," HPOS="1137" VPOS="1274" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-426_l8" HPOS="1137" VPOS="1397" WIDTH="2987" HEIGHT="102" BASELINE="1137 1498 4124 1498">
            <Shape>
              <Polygon POINTS="1137 1397 4124 1397 4124 1499 1137 1499"/>
            </Shape>
            <String CONTENT="не отстаютъ. Женокрадущее судно они дѣлаютъ. Опять пристали къ" HPOS="1137" VPOS="1397" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-426_l9" HPOS="1135" VPOS="1534" WIDTH="2986" HEIGHT="100" BASELINE="1135 1633 4121 1633">
            <Shape>
              <Polygon POINTS="1135 1534 4121 1534 4121 1634 1135 1634"/>
            </Shape>
            <String CONTENT="берегу, опять перетянули, опять испытали. Сѣли въ судно. Теперь судно" HPOS="1135" VPOS="1534" WIDTH="2986" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-426_l10" HPOS="1136" VPOS="1660" WIDTH="2979" HEIGHT="98" BASELINE="1136 1757 4115 1757">
            <Shape>
              <Polygon POINTS="1136 1660 4115 1660 4115 1758 1136 1758"/>
            </Shape>
            <String CONTENT="летитъ, почти не касаясь воды, весьма далекоходное. «Довольно; теперь," HPOS="1136" VPOS="1660" WIDTH="2979" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-426_l11" HPOS="1139" VPOS="1775" WIDTH="2987" HEIGHT="103" BASELINE="1139 1877 4126 1877">
            <Shape>
              <Polygon POINTS="1139 1775 4126 1775 4126 1878 1139 1878"/>
            </Shape>
            <String CONTENT="кажется, хорошо!» Силачи принесли боковъ, желудковъ¹), жиръ. Опять" HPOS="1139" VPOS="1775" WIDTH="2987" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-426_l12" HPOS="1137" VPOS="1881" WIDTH="2985" HEIGHT="101" BASELINE="1137 1981 4122 1981">
            <Shape>
              <Polygon POINTS="1137 1881 4122 1881 4122 1982 1137 1982"/>
            </Shape>
            <String CONTENT="сѣли въ судно, жену повезли съ собой; всѣ сѣли на судно, — восемь ихъ" HPOS="1137" VPOS="1881" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-426_l13" HPOS="1135" VPOS="2028" WIDTH="2988" HEIGHT="102" BASELINE="1135 2129 4123 2129">
            <Shape>
              <Polygon POINTS="1135 2028 4123 2028 4123 2130 1135 2130"/>
            </Shape>
            <String CONTENT="человѣкъ. Запасовъ набрали, оленей на дорогу убили. Мыткакай пріятель" HPOS="1135" VPOS="2028" WIDTH="2988" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-426_l14" HPOS="1136" VPOS="2148" WIDTH="2989" HEIGHT="103" BASELINE="1136 2250 4125 2250">
            <Shape>
              <Polygon POINTS="1136 2148 4125 2148 4125 2251 1136 2251"/>
            </Shape>
            <String CONTENT="все еще спитъ на суднѣ. Онъ дремлетъ. Они гребутъ. Мыткакаева жена" HPOS="1136" VPOS="2148" WIDTH="2989" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-426_l15" HPOS="1134" VPOS="2276" WIDTH="2986" HEIGHT="101" BASELINE="1134 2376 4120 2376">
            <Shape>
              <Polygon POINTS="1134 2276 4120 2276 4120 2377 1134 2377"/>
            </Shape>
            <String CONTENT="накрошила мяса, ѣдятъ во время гребли не переставая. Мыткакай про-" HPOS="1134" VPOS="2276" WIDTH="2986" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-426_l16" HPOS="1139" VPOS="2406" WIDTH="2983" HEIGHT="100" BASELINE="1139 2505 4122 2505">
            <Shape>
              <Polygon POINTS="1139 2406 4122 2406 4122 2506 1139 2506"/>
            </Shape>
            <String CONTENT="снулся. Говоритъ: «Поспите, я погребу, немного подремлите!» Опять жена" HPOS="1139" VPOS="2406" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-426_l17" HPOS="1137" VPOS="2529" WIDTH="2981" HEIGHT="101" BASELINE="1137 2629 4118 2629">
            <Shape>
              <Polygon POINTS="1137 2529 4118 2529 4118 2630 1137 2630"/>
            </Shape>
            <String CONTENT="не спитъ, крошитъ мясо теперь ему. Мыткакай сталъ грести; идетъ судно," HPOS="1137" VPOS="2529" WIDTH="2981" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-426_l18" HPOS="1135" VPOS="2650" WIDTH="2987" HEIGHT="101" BASELINE="1135 2751 4122 2751">
            <Shape>
              <Polygon POINTS="1135 2650 4122 2650 4122 2751 1135 2751"/>
            </Shape>
            <String CONTENT="не касаясь воды, скользитъ сверху. Пробудились. Земля видна ужъ совсѣмъ" HPOS="1135" VPOS="2650" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-426_l19" HPOS="1137" VPOS="2780" WIDTH="2988" HEIGHT="99" BASELINE="1137 2878 4125 2878">
            <Shape>
              <Polygon POINTS="1137 2780 4125 2780 4125 2879 1137 2879"/>
            </Shape>
            <String CONTENT="близко. Видѣнъ сталъ домъ Lо́lђыlын’а близко, на самомъ берегу. Вдоль" HPOS="1137" VPOS="2780" WIDTH="2988" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-426_l20" HPOS="1135" VPOS="2905" WIDTH="2980" HEIGHT="100" BASELINE="1135 3004 4115 3004">
            <Shape>
              <Polygon POINTS="1135 2905 4115 2905 4115 3005 1135 3005"/>
            </Shape>
            <String CONTENT="берега протянулось нѣчто, какъ оставка, лежитъ человѣкъ. Говорятъ:" HPOS="1135" VPOS="2905" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-426_l21" HPOS="1135" VPOS="3029" WIDTH="2982" HEIGHT="106" BASELINE="1135 3134 4117 3134">
            <Shape>
              <Polygon POINTS="1135 3029 4117 3029 4117 3135 1135 3135"/>
            </Shape>
            <String CONTENT="«Это что такое?» Говоритъ первый братъ: «Да, это Lо́lђыlын-богатырь" HPOS="1135" VPOS="3029" WIDTH="2982" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-426_l22" HPOS="1136" VPOS="3114" WIDTH="2980" HEIGHT="141" BASELINE="1136 3254 4116 3254">
            <Shape>
              <Polygon POINTS="1136 3114 4116 3114 4116 3255 1136 3255"/>
            </Shape>
            <String CONTENT="спитъ!» — «Тише, тише! Мы пристанемъ!» Сѣтища у него заметано въ" HPOS="1136" VPOS="3114" WIDTH="2980" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-426_l23" HPOS="1135" VPOS="3279" WIDTH="2980" HEIGHT="102" BASELINE="1135 3380 4115 3380">
            <Shape>
              <Polygon POINTS="1135 3279 4115 3279 4115 3381 1135 3381"/>
            </Shape>
            <String CONTENT="водѣ. Держитъ Мыткакай весло въ рукѣ; зашелъ сзади, сталъ подкрады-" HPOS="1135" VPOS="3279" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-426_l24" HPOS="1135" VPOS="3409" WIDTH="2984" HEIGHT="98" BASELINE="1135 3507 4119 3507">
            <Shape>
              <Polygon POINTS="1135 3409 4119 3409 4119 3507 1135 3507"/>
            </Shape>
            <String CONTENT="ваться. Спитъ Lо́lђыlын на землѣ. Подсунулъ подъ него весло, поднимаетъ" HPOS="1135" VPOS="3409" WIDTH="2984" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-426_l25" HPOS="1135" VPOS="3535" WIDTH="2980" HEIGHT="100" BASELINE="1135 3634 4115 3634">
            <Shape>
              <Polygon POINTS="1135 3535 4115 3535 4115 3635 1135 3635"/>
            </Shape>
            <String CONTENT="его полегоньку на веслѣ то вверхъ, то внизъ. Тотъ во снѣ ворочается," HPOS="1135" VPOS="3535" WIDTH="2980" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-426_l26" HPOS="1136" VPOS="3610" WIDTH="2983" HEIGHT="147" BASELINE="1136 3756 4119 3756">
            <Shape>
              <Polygon POINTS="1136 3610 4119 3610 4119 3757 1136 3757"/>
            </Shape>
            <String CONTENT="потомъ проснулся, посмотрѣлъ. «Ка́ко мэ́ј²)! Что ты дѣлаешь?» — «Да тебя" HPOS="1136" VPOS="3610" WIDTH="2983" HEIGHT="147"/>
          </TextLine>
          <TextLine ID="mz_1-426_l27" HPOS="1130" VPOS="3736" WIDTH="2993" HEIGHT="146" BASELINE="1130 3882 4123 3882">
            <Shape>
              <Polygon POINTS="1130 3736 4123 3736 4123 3882 1130 3882"/>
            </Shape>
            <String CONTENT="толкаю, тебя бужу!» — «Э-э! Ну, войдемъ въ домъ!» Вошли въ домъ. Придя" HPOS="1130" VPOS="3736" WIDTH="2993" HEIGHT="146"/>
          </TextLine>
          <TextLine ID="mz_1-426_l28" HPOS="1136" VPOS="3908" WIDTH="2984" HEIGHT="102" BASELINE="1136 4009 4120 4009">
            <Shape>
              <Polygon POINTS="1136 3908 4120 3908 4120 4010 1136 4010"/>
            </Shape>
            <String CONTENT="въ домъ, варенаго поѣли. Поѣвъ говорятъ: «Выйдемъ-ка, гостей поза-" HPOS="1136" VPOS="3908" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-426_l29" HPOS="1134" VPOS="4033" WIDTH="2985" HEIGHT="107" BASELINE="1134 4139 4119 4139">
            <Shape>
              <Polygon POINTS="1134 4033 4119 4033 4119 4140 1134 4140"/>
            </Shape>
            <String CONTENT="бавимъ и себя испытаемъ!» Дѣйствительно вышли. Lо́lђыlын, готовясь къ" HPOS="1134" VPOS="4033" WIDTH="2985" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-426_l30" HPOS="1134" VPOS="4162" WIDTH="2989" HEIGHT="98" BASELINE="1134 4259 4123 4259">
            <Shape>
              <Polygon POINTS="1134 4162 4123 4162 4123 4260 1134 4260"/>
            </Shape>
            <String CONTENT="борьбѣ, сталъ въ позу. Старшій братъ (изъ силачей братьевъ) схватилъ" HPOS="1134" VPOS="4162" WIDTH="2989" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-426_l31" HPOS="1140" VPOS="4278" WIDTH="2980" HEIGHT="109" BASELINE="1140 4386 4120 4386">
            <Shape>
              <Polygon POINTS="1140 4278 4120 4278 4120 4387 1140 4387"/>
            </Shape>
            <String CONTENT="его, не можетъ. «Ну, ты теперь, ты!» кричитъ великанъ. Мыткакай кри-" HPOS="1140" VPOS="4278" WIDTH="2980" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-426_l32" HPOS="1134" VPOS="4402" WIDTH="2988" HEIGHT="112" BASELINE="1134 4513 4122 4513">
            <Shape>
              <Polygon POINTS="1134 4402 4122 4402 4122 4514 1134 4514"/>
            </Shape>
            <String CONTENT="читъ: «Эђэ́ј! Я теперь!» Мыткакай его схватилъ; схватилъ его и поднялъ," HPOS="1134" VPOS="4402" WIDTH="2988" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-426_l33" HPOS="1135" VPOS="4534" WIDTH="2983" HEIGHT="98" BASELINE="1135 4631 4118 4631">
            <Shape>
              <Polygon POINTS="1135 4534 4118 4534 4118 4632 1135 4632"/>
            </Shape>
            <String CONTENT="держитъ его въ боковомъ положеніи, какъ будто тяжести въ немъ нѣтъ." HPOS="1135" VPOS="4534" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-426_l34" HPOS="1135" VPOS="4661" WIDTH="2991" HEIGHT="101" BASELINE="1135 4761 4126 4761">
            <Shape>
              <Polygon POINTS="1135 4661 4126 4661 4126 4762 1135 4762"/>
            </Shape>
            <String CONTENT="Потомъ Lо́lђыlын силачъ его схватилъ. Тянетъ его; онъ стоитъ какъ" HPOS="1135" VPOS="4661" WIDTH="2991" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-426_l35" HPOS="1137" VPOS="4778" WIDTH="2987" HEIGHT="110" BASELINE="1137 4887 4124 4887">
            <Shape>
              <Polygon POINTS="1137 4778 4124 4778 4124 4888 1137 4888"/>
            </Shape>
            <String CONTENT="прежде, даже не пошатнется. Не можетъ. «Ну, не могу! Нѣтъ, лучше на" HPOS="1137" VPOS="4778" WIDTH="2987" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-426_l36" HPOS="1139" VPOS="4911" WIDTH="2982" HEIGHT="98" BASELINE="1139 5008 4121 5008">
            <Shape>
              <Polygon POINTS="1139 4911 4121 4911 4121 5009 1139 5009"/>
            </Shape>
            <String CONTENT="суднѣ перегоняться станемъ!» Дѣйствительно снарядила суда. Говоритъ" HPOS="1139" VPOS="4911" WIDTH="2982" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-426_l37" HPOS="1128" VPOS="5015" WIDTH="2989" HEIGHT="120" BASELINE="1128 5134 4117 5134">
            <Shape>
              <Polygon POINTS="1128 5015 4117 5015 4117 5135 1128 5135"/>
            </Shape>
            <String CONTENT="Мыткакай: «Ђы, увеземъ и женъ, — пусть на суднѣ сидятъ!» Подвинули" HPOS="1128" VPOS="5015" WIDTH="2989" HEIGHT="120"/>
          </TextLine>
          <TextLine ID="mz_1-426_l38" HPOS="1135" VPOS="5160" WIDTH="2985" HEIGHT="103" BASELINE="1135 5262 4120 5262">
            <Shape>
              <Polygon POINTS="1135 5160 4120 5160 4120 5263 1135 5263"/>
            </Shape>
            <String CONTENT="суда къ берегу, оба усѣлись. Поровнялись суда, а у бортовъ поставили" HPOS="1135" VPOS="5160" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-426_l39" HPOS="1358" VPOS="5460" WIDTH="2767" HEIGHT="94" BASELINE="1358 5554 4125 5554">
            <Shape>
              <Polygon POINTS="1358 5460 4125 5460 4125 5554 1358 5554"/>
            </Shape>
            <String CONTENT="1) Третій желудокъ оленя чукчанки начиняютъ рубленнымъ жиромъ и потомъ" HPOS="1358" VPOS="5460" WIDTH="2767" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-426_l40" HPOS="1136" VPOS="5571" WIDTH="643" HEIGHT="79" BASELINE="1136 5649 1779 5649">
            <Shape>
              <Polygon POINTS="1136 5571 1779 5571 1779 5650 1136 5650"/>
            </Shape>
            <String CONTENT="сушатъ на солнцѣ." HPOS="1136" VPOS="5571" WIDTH="643" HEIGHT="79"/>
          </TextLine>
          <TextLine ID="mz_1-426_l41" HPOS="1354" VPOS="5675" WIDTH="865" HEIGHT="95" BASELINE="1354 5769 2219 5769">
            <Shape>
              <Polygon POINTS="1354 5675 2219 5675 2219 5770 1354 5770"/>
            </Shape>
            <String CONTENT="2) Выраженіе изумленія." HPOS="1354" VPOS="5675" WIDTH="865" HEIGHT="95"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
