        <TextBlock ID="text_1-225" HPOS="630" VPOS="557" WIDTH="3004" HEIGHT="5265">
          <TextLine ID="mz_1-225_l1" HPOS="635" VPOS="557" WIDTH="2998" HEIGHT="122" BASELINE="635 656 3633 656">
            <Shape>
              <Polygon POINTS="635 557 3633 557 3633 679 635 679"/>
            </Shape>
            <String CONTENT="II,58. МАТЕРІАЛЫ ПО ИЗУЧЕНІЮ ЧУКОТСКАГО ЯЗЫКА И ФОЛЬКЛОРА. 169" HPOS="635" VPOS="557" WIDTH="2998" HEIGHT="122"/>
          </TextLine>
          <TextLine ID="mz_1-225_l2" HPOS="641" VPOS="778" WIDTH="2990" HEIGHT="103" BASELINE="641 880 3631 880">
            <Shape>
              <Polygon POINTS="641 778 3631 778 3631 881 641 881"/>
            </Shape>
            <String CONTENT="говоритъ, не открывая рта. «Обыщите меня всего сейчасъ!» Спустился" HPOS="641" VPOS="778" WIDTH="2990" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-225_l3" HPOS="638" VPOS="914" WIDTH="2991" HEIGHT="94" BASELINE="638 1008 3629 1008">
            <Shape>
              <Polygon POINTS="638 914 3629 914 3629 1008 638 1008"/>
            </Shape>
            <String CONTENT="Творецъ на землю, пошелъ по берегу моря, а по другую сторону земли по-" HPOS="638" VPOS="914" WIDTH="2991" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-225_l4" HPOS="640" VPOS="1022" WIDTH="2988" HEIGHT="110" BASELINE="640 1131 3628 1131">
            <Shape>
              <Polygon POINTS="640 1022 3628 1022 3628 1132 640 1132"/>
            </Shape>
            <String CONTENT="шелъ его сынъ. На той землѣ, по ту сторону, гдѣ живетъ Солнечный Вла-" HPOS="640" VPOS="1022" WIDTH="2988" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-225_l5" HPOS="641" VPOS="1131" WIDTH="2987" HEIGHT="124" BASELINE="641 1254 3628 1254">
            <Shape>
              <Polygon POINTS="641 1131 3628 1131 3628 1255 641 1255"/>
            </Shape>
            <String CONTENT="дыка, стало темно — солнца нѣтъ. Посланы два та́ньга, разыскивать вора." HPOS="641" VPOS="1131" WIDTH="2987" HEIGHT="124"/>
          </TextLine>
          <TextLine ID="mz_1-225_l6" HPOS="633" VPOS="1274" WIDTH="2997" HEIGHT="101" BASELINE="633 1374 3630 1374">
            <Shape>
              <Polygon POINTS="633 1274 3630 1274 3630 1375 633 1375"/>
            </Shape>
            <String CONTENT="Встрѣтили они вдвоемъ Творца. «Зачѣмъ же солнце ты забралъ? Сколько" HPOS="633" VPOS="1274" WIDTH="2997" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-225_l7" HPOS="644" VPOS="1378" WIDTH="2986" HEIGHT="124" BASELINE="644 1502 3630 1502">
            <Shape>
              <Polygon POINTS="644 1378 3630 1378 3630 1502 644 1502"/>
            </Shape>
            <String CONTENT="людей живетъ отъ той земли до этой,—неужели всѣ въ темнотѣ будутъ?»—" HPOS="644" VPOS="1378" WIDTH="2986" HEIGHT="124"/>
          </TextLine>
          <TextLine ID="mz_1-225_l8" HPOS="643" VPOS="1524" WIDTH="2988" HEIGHT="106" BASELINE="643 1629 3631 1629">
            <Shape>
              <Polygon POINTS="643 1524 3631 1524 3631 1630 643 1630"/>
            </Shape>
            <String CONTENT="«Нѣтъ солнца у меня», говоритъ Творецъ глухимъ голосомъ, говоритъ, не" HPOS="643" VPOS="1524" WIDTH="2988" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-225_l9" HPOS="639" VPOS="1641" WIDTH="2986" HEIGHT="106" BASELINE="639 1747 3625 1747">
            <Shape>
              <Polygon POINTS="639 1641 3625 1641 3625 1747 639 1747"/>
            </Shape>
            <String CONTENT="разжимая рта. «Обыщите теперь всего!» Стали искать подъ одеждой, стали" HPOS="639" VPOS="1641" WIDTH="2986" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-225_l10" HPOS="642" VPOS="1772" WIDTH="2986" HEIGHT="103" BASELINE="642 1874 3628 1874">
            <Shape>
              <Polygon POINTS="642 1772 3628 1772 3628 1875 642 1875"/>
            </Shape>
            <String CONTENT="щупать подъ мышками, засмѣялся Творецъ, засмѣялся дважды, засмѣялся" HPOS="642" VPOS="1772" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-225_l11" HPOS="641" VPOS="1900" WIDTH="2986" HEIGHT="98" BASELINE="641 1997 3627 1997">
            <Shape>
              <Polygon POINTS="641 1900 3627 1900 3627 1998 641 1998"/>
            </Shape>
            <String CONTENT="трижды, выпустилъ солнце, выскочило солнце на небо, сталъ свѣтъ. Пошли" HPOS="641" VPOS="1900" WIDTH="2986" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-225_l12" HPOS="644" VPOS="2032" WIDTH="2982" HEIGHT="94" BASELINE="644 2125 3626 2125">
            <Shape>
              <Polygon POINTS="644 2032 3626 2032 3626 2126 644 2126"/>
            </Shape>
            <String CONTENT="они трое по берегу, дошли до средины земли, тамъ хребетъ, на хребтѣ" HPOS="644" VPOS="2032" WIDTH="2982" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-225_l13" HPOS="644" VPOS="2142" WIDTH="2985" HEIGHT="105" BASELINE="644 2247 3629 2247">
            <Shape>
              <Polygon POINTS="644 2142 3629 2142 3629 2247 644 2247"/>
            </Shape>
            <String CONTENT="сынъ Творца, вся у него ѣда вышла дорогой, безъ пищи онъ сталъ, слова" HPOS="644" VPOS="2142" WIDTH="2985" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-225_l14" HPOS="638" VPOS="2279" WIDTH="2984" HEIGHT="94" BASELINE="638 2372 3622 2372">
            <Shape>
              <Polygon POINTS="638 2279 3622 2279 3622 2373 638 2373"/>
            </Shape>
            <String CONTENT="всѣ забылъ, одежду избилъ, обросъ волосами, сталъ походить на медвѣдя." HPOS="638" VPOS="2279" WIDTH="2984" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-225_l15" HPOS="637" VPOS="2397" WIDTH="2983" HEIGHT="106" BASELINE="637 2502 3620 2502">
            <Shape>
              <Polygon POINTS="637 2397 3620 2397 3620 2503 637 2503"/>
            </Shape>
            <String CONTENT="«Это Кэ́lє!» сказали тѣ оба. «Нѣтъ», сказалъ Творецъ, «не будь ты Кэ́lє," HPOS="637" VPOS="2397" WIDTH="2983" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-225_l16" HPOS="641" VPOS="2520" WIDTH="2985" HEIGHT="105" BASELINE="641 2624 3626 2624">
            <Shape>
              <Polygon POINTS="641 2520 3626 2520 3626 2625 641 2625"/>
            </Shape>
            <String CONTENT="а будь ты тоже человѣкъ!» Сталъ ламутъ. Тѣ взяли бумагу, начертили всю" HPOS="641" VPOS="2520" WIDTH="2985" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-225_l17" HPOS="635" VPOS="2656" WIDTH="2984" HEIGHT="95" BASELINE="635 2750 3619 2750">
            <Shape>
              <Polygon POINTS="635 2656 3619 2656 3619 2751 635 2751"/>
            </Shape>
            <String CONTENT="землю, написали всѣхъ людей, все выписали хорошо, подаютъ они Творцу:" HPOS="635" VPOS="2656" WIDTH="2984" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-225_l18" HPOS="638" VPOS="2759" WIDTH="2982" HEIGHT="118" BASELINE="638 2876 3620 2876">
            <Shape>
              <Polygon POINTS="638 2759 3620 2759 3620 2877 638 2877"/>
            </Shape>
            <String CONTENT="«А что?» Взялъ старикъ бумагу, посмотрѣлъ, разорвалъ на мелкія части." HPOS="638" VPOS="2759" WIDTH="2982" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-225_l19" HPOS="635" VPOS="2905" WIDTH="2985" HEIGHT="95" BASELINE="635 2999 3620 2999">
            <Shape>
              <Polygon POINTS="635 2905 3620 2905 3620 3000 635 3000"/>
            </Shape>
            <String CONTENT="Разсердились они, изрубили его на мелкіе куски: сколько бумажекъ, столько" HPOS="635" VPOS="2905" WIDTH="2985" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-225_l20" HPOS="634" VPOS="3020" WIDTH="2987" HEIGHT="103" BASELINE="634 3122 3621 3122">
            <Shape>
              <Polygon POINTS="634 3020 3621 3020 3621 3123 634 3123"/>
            </Shape>
            <String CONTENT="и кусковъ. Слышно стукъ и грохотъ, пришелъ бубенъ съ поля, самъ гре-" HPOS="634" VPOS="3020" WIDTH="2987" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-225_l21" HPOS="630" VPOS="3148" WIDTH="2989" HEIGHT="99" BASELINE="630 3246 3619 3246">
            <Shape>
              <Polygon POINTS="630 3148 3619 3148 3619 3247 630 3247"/>
            </Shape>
            <String CONTENT="митъ, колотушка стукаетъ, срослись всѣ куски вмѣстѣ. Разсердились оба они," HPOS="630" VPOS="3148" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-225_l22" HPOS="636" VPOS="3273" WIDTH="2987" HEIGHT="97" BASELINE="636 3369 3623 3369">
            <Shape>
              <Polygon POINTS="636 3273 3623 3273 3623 3370 636 3370"/>
            </Shape>
            <String CONTENT="изрубили его на мелкіе куски, разложили большой огонь, положили его на" HPOS="636" VPOS="3273" WIDTH="2987" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-225_l23" HPOS="638" VPOS="3394" WIDTH="2984" HEIGHT="103" BASELINE="638 3497 3622 3497">
            <Shape>
              <Polygon POINTS="638 3394 3622 3394 3622 3497 638 3497"/>
            </Shape>
            <String CONTENT="огонь, стали жечь. «Каръ, каръ, каръ!» закаркалъ надъ ихъ головой. Обер-" HPOS="638" VPOS="3394" WIDTH="2984" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-225_l24" HPOS="636" VPOS="3527" WIDTH="1307" HEIGHT="92" BASELINE="636 3618 1943 3618">
            <Shape>
              <Polygon POINTS="636 3527 1943 3527 1943 3619 636 3619"/>
            </Shape>
            <String CONTENT="нулся ворономъ, улетѣлъ вверхъ." HPOS="636" VPOS="3527" WIDTH="1307" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-225_l25" HPOS="854" VPOS="3693" WIDTH="2182" HEIGHT="107" BASELINE="854 3799 3036 3799">
            <Shape>
              <Polygon POINTS="854 3693 3036 3693 3036 3800 854 3800"/>
            </Shape>
            <String CONTENT="Записано отъ чукчанки Ӈэ́ўс̧ӄат въ 1895 г. на р. Молондѣ." HPOS="854" VPOS="3693" WIDTH="2182" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-225_l26" HPOS="2061" VPOS="3953" WIDTH="133" HEIGHT="101" BASELINE="2061 4053 2194 4053">
            <Shape>
              <Polygon POINTS="2061 3953 2194 3953 2194 4054 2061 4054"/>
            </Shape>
            <String CONTENT="58." HPOS="2061" VPOS="3953" WIDTH="133" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-225_l27" HPOS="1615" VPOS="4197" WIDTH="1039" HEIGHT="102" BASELINE="1615 4298 2654 4298">
            <Shape>
              <Polygon POINTS="1615 4197 2654 4197 2654 4299 1615 4299"/>
            </Shape>
            <String CONTENT="Тот-төмwа́ткен пы́ӈыl." HPOS="1615" VPOS="4197" WIDTH="1039" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-225_l28" HPOS="854" VPOS="4393" WIDTH="2767" HEIGHT="108" BASELINE="854 4500 3621 4500">
            <Shape>
              <Polygon POINTS="854 4393 3621 4393 3621 4501 854 4501"/>
            </Shape>
            <String CONTENT="Въ самое первое время былъ на всей землѣ единственный человѣкъ," HPOS="854" VPOS="4393" WIDTH="2767" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-225_l29" HPOS="640" VPOS="4529" WIDTH="2986" HEIGHT="98" BASELINE="640 4626 3626 4626">
            <Shape>
              <Polygon POINTS="640 4529 3626 4529 3626 4627 640 4627"/>
            </Shape>
            <String CONTENT="ничего не зная, совершенно нагой лежалъ на боку. Посѣтилъ его Творецъ" HPOS="640" VPOS="4529" WIDTH="2986" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-225_l30" HPOS="639" VPOS="4646" WIDTH="2855" HEIGHT="109" BASELINE="639 4754 3494 4754">
            <Shape>
              <Polygon POINTS="639 4646 3494 4646 3494 4755 639 4755"/>
            </Shape>
            <String CONTENT="(кто? что? незнаю!) и говоритъ: «Ты зябнешь?» «Нѣтъ, нисколько!» —" HPOS="639" VPOS="4646" WIDTH="2855" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-225_l31" HPOS="644" VPOS="4758" WIDTH="2984" HEIGHT="112" BASELINE="644 4870 3628 4870">
            <Shape>
              <Polygon POINTS="644 4758 3628 4758 3628 4870 644 4870"/>
            </Shape>
            <String CONTENT="«Что ты ѣшь?» — «Ѣшь?... Что такое ѣда?» — «Ѣда — это жизнь. Твоя жизнь," HPOS="644" VPOS="4758" WIDTH="2984" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-225_l32" HPOS="640" VPOS="4893" WIDTH="2991" HEIGHT="114" BASELINE="640 5006 3631 5006">
            <Shape>
              <Polygon POINTS="640 4893 3631 4893 3631 5007 640 5007"/>
            </Shape>
            <String CONTENT="въ чемъ?» — «Я не знаю». Пошелъ на море, поймалъ рыбу, принесъ. «На" HPOS="640" VPOS="4893" WIDTH="2991" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-225_l33" HPOS="642" VPOS="4977" WIDTH="2986" HEIGHT="148" BASELINE="642 5124 3628 5124">
            <Shape>
              <Polygon POINTS="642 4977 3628 4977 3628 5125 642 5125"/>
            </Shape>
            <String CONTENT="вотъ, съѣшь!» — «Какъ стану дѣлать?» — «Жуй, жуй! вотъ такъ!» Поже-" HPOS="642" VPOS="4977" WIDTH="2986" HEIGHT="148"/>
          </TextLine>
          <TextLine ID="mz_1-225_l34" HPOS="644" VPOS="5127" WIDTH="2982" HEIGHT="132" BASELINE="644 5259 3626 5259">
            <Shape>
              <Polygon POINTS="644 5127 3626 5127 3626 5259 644 5259"/>
            </Shape>
            <String CONTENT="валъ, пожевалъ. — «Теперь что стану (дѣлать)?» — «Теперь проглоти! От-" HPOS="644" VPOS="5127" WIDTH="2982" HEIGHT="132"/>
          </TextLine>
          <TextLine ID="mz_1-225_l35" HPOS="639" VPOS="5260" WIDTH="2988" HEIGHT="113" BASELINE="639 5372 3627 5372">
            <Shape>
              <Polygon POINTS="639 5260 3627 5260 3627 5373 639 5373"/>
            </Shape>
            <String CONTENT="чего ты все лежишь? Сядь! (посиди) немного!» — «Какъ сядь? Я не по-" HPOS="639" VPOS="5260" WIDTH="2988" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-225_l36" HPOS="642" VPOS="5416" WIDTH="2991" HEIGHT="94" BASELINE="642 5509 3633 5509">
            <Shape>
              <Polygon POINTS="642 5416 3633 5416 3633 5510 642 5510"/>
            </Shape>
            <String CONTENT="нимаю». Посадилъ его на задницу. Черезъ нѣсколько дней опять посѣтилъ" HPOS="642" VPOS="5416" WIDTH="2991" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-225_l37" HPOS="643" VPOS="5491" WIDTH="2989" HEIGHT="140" BASELINE="643 5630 3632 5630">
            <Shape>
              <Polygon POINTS="643 5491 3632 5491 3632 5631 643 5631"/>
            </Shape>
            <String CONTENT="его. «Ты испражнялся?» — «Испражнялся? Это что?» — «А ну, повернись!»" HPOS="643" VPOS="5491" WIDTH="2989" HEIGHT="140"/>
          </TextLine>
          <TextLine ID="mz_1-225_l38" HPOS="637" VPOS="5661" WIDTH="2997" HEIGHT="102" BASELINE="637 5763 3634 5763">
            <Shape>
              <Polygon POINTS="637 5661 3634 5661 3634 5763 637 5763"/>
            </Shape>
            <String CONTENT="Провернулъ ему дыру талинкой, вышелъ калъ наружу. «Опять ѣсть ста-" HPOS="637" VPOS="5661" WIDTH="2997" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-225_l39" HPOS="3125" VPOS="5760" WIDTH="91" HEIGHT="62" BASELINE="3125 5822 3216 5822">
            <Shape>
              <Polygon POINTS="3125 5760 3216 5760 3216 5822 3125 5822"/>
            </Shape>
            <String CONTENT="22" HPOS="3125" VPOS="5760" WIDTH="91" HEIGHT="62"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
