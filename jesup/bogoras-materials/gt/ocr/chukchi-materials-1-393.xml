            </Shape>
            <String CONTENT="стой!» кричитъ Кивающій головой: «что за споры, если одно племя. Лучше" HPOS="576" VPOS="1879" WIDTH="2991" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-393_l14" HPOS="578" VPOS="1999" WIDTH="2986" HEIGHT="102" BASELINE="578 2101 3564 2101">
            <Shape>
              <Polygon POINTS="578 1999 3564 1999 3564 2101 578 2101"/>
            </Shape>
            <String CONTENT="пойдемъ, пусть на другихъ покажемъ гнѣвъ! Какъ будетъ? Надо попро-" HPOS="578" VPOS="1999" WIDTH="2986" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-393_l15" HPOS="577" VPOS="2125" WIDTH="2988" HEIGHT="98" BASELINE="577 2222 3565 2222">
            <Shape>
              <Polygon POINTS="577 2125 3565 2125 3565 2223 577 2223"/>
            </Shape>
            <String CONTENT="бовать! Перестаньте!» Помирили ихъ и пошли вмѣстѣ на таньговъ. Пришли" HPOS="577" VPOS="2125" WIDTH="2988" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-393_l16" HPOS="574" VPOS="2251" WIDTH="2992" HEIGHT="101" BASELINE="574 2351 3566 2351">
            <Shape>
              <Polygon POINTS="574 2251 3566 2251 3566 2352 574 2352"/>
            </Shape>
            <String CONTENT="къ одному жительству, на встрѣчу таньгинскій строй. «Кто, кто первый" HPOS="574" VPOS="2251" WIDTH="2992" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-393_l17" HPOS="576" VPOS="2380" WIDTH="2987" HEIGHT="98" BASELINE="576 2477 3563 2477">
            <Shape>
              <Polygon POINTS="576 2380 3563 2380 3563 2478 576 2478"/>
            </Shape>
            <String CONTENT="начнетъ борьбу? Стойте, стойте! Пусть сперва выдвинутся впередъ острые" HPOS="576" VPOS="2380" WIDTH="2987" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-393_l18" HPOS="574" VPOS="2497" WIDTH="2992" HEIGHT="103" BASELINE="574 2599 3566 2599">
            <Shape>
              <Polygon POINTS="574 2497 3566 2497 3566 2600 574 2600"/>
            </Shape>
            <String CONTENT="рожки. «Та́ве на лыжахъ забѣгаетъ справа, Эlэ́ннут слѣва. Посмотрѣли" HPOS="574" VPOS="2497" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-393_l19" HPOS="576" VPOS="2630" WIDTH="2992" HEIGHT="97" BASELINE="576 2727 3568 2727">
