              <Polygon POINTS="576 2630 3568 2630 3568 2727 576 2727"/>
            </Shape>
            <String CONTENT="таньги по сторонамъ и отступили къ домамъ. Два жилища, но большое" HPOS="576" VPOS="2630" WIDTH="2992" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-393_l20" HPOS="579" VPOS="2754" WIDTH="2985" HEIGHT="100" BASELINE="579 2854 3564 2854">
            <Shape>
              <Polygon POINTS="579 2754 3564 2754 3564 2854 579 2854"/>
            </Shape>
            <String CONTENT="собраніе народа. Дома укрѣплены, какъ русская крѣпость. Стало вечерѣть." HPOS="579" VPOS="2754" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-393_l21" HPOS="579" VPOS="2874" WIDTH="2990" HEIGHT="102" BASELINE="579 2975 3569 2975">
            <Shape>
              <Polygon POINTS="579 2874 3569 2874 3569 2976 579 2976"/>
            </Shape>
            <String CONTENT="Люди ждутъ зари. Подъ вечеръ пріѣзжаетъ таньгинскій старикъ. Оружія" HPOS="579" VPOS="2874" WIDTH="2990" HEIGHT="102"/>
          </TextLine>
