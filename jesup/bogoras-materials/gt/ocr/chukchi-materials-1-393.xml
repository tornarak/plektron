            </Shape>
            <String CONTENT="Подошелъ къ проруби: «Ступай прочь!» — «Ӄаре́м, ӄаре́м!» Подошелъ въ" HPOS="564" VPOS="1338" WIDTH="3002" HEIGHT="148"/>
          </TextLine>
