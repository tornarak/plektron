            </Shape>
            <String CONTENT="воды?» кричитъ Эlэ́ннут. «Та́ве не даетъ!... Теперь пойди самъ!» — «Стой," HPOS="568" VPOS="1090" WIDTH="2987" HEIGHT="140"/>
          </TextLine>
