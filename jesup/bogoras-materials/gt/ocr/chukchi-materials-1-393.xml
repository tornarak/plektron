            </Shape>
            <String CONTENT="Чы́мкыl, Ајӈа́ырђын, Та́ве!»... — «О, худо!» заплакалъ старичекъ..." HPOS="576" VPOS="3072" WIDTH="2987" HEIGHT="153"/>
          </TextLine>
