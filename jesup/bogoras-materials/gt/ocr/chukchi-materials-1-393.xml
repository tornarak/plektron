            <Shape>
              <Polygon POINTS="586 3213 3570 3213 3570 3353 586 3353"/>
            </Shape>
            <String CONTENT="«Когда?» — «На вашу волю. Если вы еще не готовы, снаряжайтесь! Мы" HPOS="586" VPOS="3213" WIDTH="2984" HEIGHT="140"/>
          </TextLine>
          <TextLine ID="mz_1-393_l25" HPOS="927" VPOS="3321" WIDTH="2645" HEIGHT="145" BASELINE="927 3465 3572 3465">
            <Shape>
              <Polygon POINTS="927 3321 3572 3321 3572 3466 927 3466"/>
            </Shape>
            <String CONTENT="станемъ ждать»... — «Эђэ́ј! Если такъ, въ три дня будемъ готовы!» Прошли" HPOS="927" VPOS="3321" WIDTH="2645" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-393_l26" HPOS="583" VPOS="3366" WIDTH="773" HEIGHT="100" BASELINE="583 3465 1356 3465">
            <Shape>
