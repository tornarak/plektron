            </Shape>
            <String CONTENT="котелъ и понесъ домой. «Го-го!» схватились А́јваłан’ы за копья. «Стой," HPOS="579" VPOS="1749" WIDTH="2986" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-393_l13" HPOS="576" VPOS="1879" WIDTH="2991" HEIGHT="99" BASELINE="576 1977 3567 1977">
            <Shape>
