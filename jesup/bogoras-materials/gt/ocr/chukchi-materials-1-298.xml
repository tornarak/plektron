            </Shape>
            <String CONTENT="«Напрасной смертью убьютъ тебя!»—«Ко! У Јэјэ́мђуна тугой лукъ, остры" HPOS="1212" VPOS="1334" WIDTH="2982" HEIGHT="144"/>
          </TextLine>
