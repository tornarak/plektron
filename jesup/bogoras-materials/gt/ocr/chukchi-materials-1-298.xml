            </Shape>
            <String CONTENT="подолъ. Подошелъ къ жилищу Кэ́lє, швырнулъ сквозь двери. «Ы!» Напали" HPOS="1206" VPOS="3594" WIDTH="2989" HEIGHT="136"/>
          </TextLine>
