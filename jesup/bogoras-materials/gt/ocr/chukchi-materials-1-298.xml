              <Polygon POINTS="1210 2126 4188 2126 4188 2230 1210 2230"/>
            </Shape>
            <String CONTENT="«Развѣ ты безсильна», говоритъ Аӈӄа́lө, «сколько убила, еще можешь" HPOS="1210" VPOS="2126" WIDTH="2978" HEIGHT="104"/>
          </TextLine>
