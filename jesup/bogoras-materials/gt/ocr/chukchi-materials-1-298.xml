              <Polygon POINTS="1209 1755 4190 1755 4190 1854 1209 1854"/>
            </Shape>
            <String CONTENT="перешейкѣ. Выстрѣлилъ изъ лука, попалъ въ глазъ, убилъ, пошелъ мимо." HPOS="1209" VPOS="1755" WIDTH="2981" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-298_l12" HPOS="1200" VPOS="1870" WIDTH="2989" HEIGHT="112" BASELINE="1200 1981 4189 1981">
