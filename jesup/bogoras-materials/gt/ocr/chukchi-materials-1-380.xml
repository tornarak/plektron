            </Shape>
            <String CONTENT="вушка черпала воду. Она зачерпнула стрѣлу. Парень раздѣлся и побрелъ" HPOS="1153" VPOS="4139" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
