            </Shape>
            <String CONTENT="ритъ: «А гдѣ стрѣла?» Говоритъ она: «Я спрятала.» Вернулся домой. Опять" HPOS="1150" VPOS="3743" WIDTH="2994" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-380_l26" HPOS="1149" VPOS="3890" WIDTH="2995" HEIGHT="95" BASELINE="1149 3984 4144 3984">
