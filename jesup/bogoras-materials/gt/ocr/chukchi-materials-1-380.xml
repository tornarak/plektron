            </Shape>
            <String CONTENT="дѣлъ штаны, вернулся. Ушла дѣвушка, вернулась домой. Парень проситъ" HPOS="1146" VPOS="4388" WIDTH="2999" HEIGHT="107"/>
          </TextLine>
