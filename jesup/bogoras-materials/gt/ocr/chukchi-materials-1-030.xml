            </Shape>
            <String CONTENT="ихъ мяса. Эти представленія можно впрочемъ относить и къ заморскимъ" HPOS="1215" VPOS="793" WIDTH="2988" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l3" HPOS="1220" VPOS="921" WIDTH="2985" HEIGHT="104" BASELINE="1220 1024 4205 1024">
            <Shape>
              <Polygon POINTS="1220 921 4205 921 4205 1025 1220 1025"/>
            </Shape>
            <String CONTENT="племенамъ, живущимъ на противоположномъ материкѣ, но сказка о Роро-" HPOS="1220" VPOS="921" WIDTH="2985" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-030_l4" HPOS="1214" VPOS="1049" WIDTH="2992" HEIGHT="103" BASELINE="1214 1152 4206 1152">
            <Shape>
              <Polygon POINTS="1214 1049 4206 1049 4206 1152 1214 1152"/>
            </Shape>
            <String CONTENT="вальгинѣ (№ 167) прямо говорить о нашествіи такого племени, которое" HPOS="1214" VPOS="1049" WIDTH="2992" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l5" HPOS="1217" VPOS="1152" WIDTH="2987" HEIGHT="118" BASELINE="1217 1269 4204 1269">
            <Shape>
              <Polygon POINTS="1217 1152 4204 1152 4204 1270 1217 1270"/>
            </Shape>
            <String CONTENT="имѣетъ только собакъ и травить ими людей. Племя это называется Кэ́lэт —" HPOS="1217" VPOS="1152" WIDTH="2987" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-030_l6" HPOS="1215" VPOS="1299" WIDTH="2983" HEIGHT="98" BASELINE="1215 1396 4198 1396">
            <Shape>
              <Polygon POINTS="1215 1299 4198 1299 4198 1397 1215 1397"/>
            </Shape>
            <String CONTENT="злые духи, въ чемъ выражается только сознаніе различія въ происхожденіи," HPOS="1215" VPOS="1299" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-030_l7" HPOS="1213" VPOS="1426" WIDTH="2990" HEIGHT="100" BASELINE="1213 1526 4203 1526">
            <Shape>
              <Polygon POINTS="1213 1426 4203 1426 4203 1526 1213 1526"/>
            </Shape>
            <String CONTENT="тѣмъ болѣе, что чукчи вообще людьми (ора́wеðат) называютъ только самихъ" HPOS="1213" VPOS="1426" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l8" HPOS="1216" VPOS="1551" WIDTH="2983" HEIGHT="103" BASELINE="1216 1653 4199 1653">
            <Shape>
              <Polygon POINTS="1216 1551 4199 1551 4199 1654 1216 1654"/>
            </Shape>
            <String CONTENT="себя. Такой-же Кэ́lє съ охотничьей собакой, истребляющей людей, упоми-" HPOS="1216" VPOS="1551" WIDTH="2983" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l9" HPOS="1214" VPOS="1674" WIDTH="2983" HEIGHT="105" BASELINE="1214 1778 4197 1778">
            <Shape>
              <Polygon POINTS="1214 1674 4197 1674 4197 1779 1214 1779"/>
            </Shape>
            <String CONTENT="нается въ сказкѣ о сынѣ Муłу́wђі (№ 84). Тунгусы (ламуты) созданы изъ" HPOS="1214" VPOS="1674" WIDTH="2983" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-030_l10" HPOS="1212" VPOS="1798" WIDTH="2988" HEIGHT="100" BASELINE="1212 1897 4200 1897">
            <Shape>
              <Polygon POINTS="1212 1798 4200 1798 4200 1898 1212 1898"/>
            </Shape>
            <String CONTENT="рукавицъ, забытыхъ на землѣ, сидячіе коряки изъ собачьяго кала, русскіе" HPOS="1212" VPOS="1798" WIDTH="2988" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l11" HPOS="1211" VPOS="1924" WIDTH="2989" HEIGHT="97" BASELINE="1211 2020 4200 2020">
            <Shape>
              <Polygon POINTS="1211 1924 4200 1924 4200 2021 1211 2021"/>
            </Shape>
            <String CONTENT="изъ деревяннаго огнива, забытаго на ночевьѣ. Этотъ разсказъ повторяется" HPOS="1211" VPOS="1924" WIDTH="2989" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-030_l12" HPOS="1211" VPOS="2049" WIDTH="2985" HEIGHT="100" BASELINE="1211 2148 4196 2148">
            <Shape>
              <Polygon POINTS="1211 2049 4196 2049 4196 2149 1211 2149"/>
            </Shape>
            <String CONTENT="нѣсколько разъ. Сколько можно судить, онъ возникъ вслѣдствіе соединенія" HPOS="1211" VPOS="2049" WIDTH="2985" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l13" HPOS="1210" VPOS="2180" WIDTH="2987" HEIGHT="98" BASELINE="1210 2277 4197 2277">
            <Shape>
              <Polygon POINTS="1210 2180 4197 2180 4197 2278 1210 2278"/>
            </Shape>
            <String CONTENT="двухъ различныхъ разсказовъ. Русскіе, принесшіе съ собой стальное кре-" HPOS="1210" VPOS="2180" WIDTH="2987" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-030_l14" HPOS="1208" VPOS="2298" WIDTH="2988" HEIGHT="106" BASELINE="1208 2403 4196 2403">
            <Shape>
              <Polygon POINTS="1208 2298 4196 2298 4196 2404 1208 2404"/>
            </Shape>
            <String CONTENT="сало и кремневое ружье, получили у чукочъ названіе огнивныхъ таньговъ —" HPOS="1208" VPOS="2298" WIDTH="2988" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-030_l15" HPOS="1200" VPOS="2416" WIDTH="2996" HEIGHT="114" BASELINE="1200 2529 4196 2529">
            <Shape>
              <Polygon POINTS="1200 2416 4196 2416 4196 2530 1200 2530"/>
            </Shape>
            <String CONTENT="ме́lђы-та́н̀ӈыт. Съ другой стороны ђы́рђыр или өкка́мак, составляющіе" HPOS="1200" VPOS="2416" WIDTH="2996" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-030_l16" HPOS="1172" VPOS="2549" WIDTH="3029" HEIGHT="103" BASELINE="1172 2651 4201 2651">
            <Shape>
              <Polygon POINTS="1172 2549 4201 2549 4201 2652 1172 2652"/>
            </Shape>
            <String CONTENT="видоизмѣненія деревяннаго огнива, являются у чукочъ идолами и боже-" HPOS="1172" VPOS="2549" WIDTH="3029" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l17" HPOS="1202" VPOS="2669" WIDTH="2997" HEIGHT="105" BASELINE="1202 2773 4199 2773">
            <Shape>
              <Polygon POINTS="1202 2669 4199 2669 4199 2774 1202 2774"/>
            </Shape>
            <String CONTENT="ствами. См. напр. №№ 54 и 55, гдѣ два өкка́мак представлены ходящими" HPOS="1202" VPOS="2669" WIDTH="2997" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-030_l18" HPOS="1205" VPOS="2799" WIDTH="2993" HEIGHT="100" BASELINE="1205 2899 4198 2899">
            <Shape>
              <Polygon POINTS="1205 2799 4198 2799 4198 2899 1205 2899"/>
            </Shape>
            <String CONTENT="по землѣ и участвующими въ созданіи оленьихъ пастуховъ и охраненіи" HPOS="1205" VPOS="2799" WIDTH="2993" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l19" HPOS="1203" VPOS="2922" WIDTH="2991" HEIGHT="103" BASELINE="1203 3024 4194 3024">
            <Shape>
              <Polygon POINTS="1203 2922 4194 2922 4194 3025 1203 3025"/>
            </Shape>
            <String CONTENT="стадъ. Изъ смѣшенія этихъ различныхъ представленій получился разсказъ" HPOS="1203" VPOS="2922" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l20" HPOS="1194" VPOS="3025" WIDTH="3005" HEIGHT="128" BASELINE="1194 3152 4199 3152">
            <Shape>
              <Polygon POINTS="1194 3025 4199 3025 4199 3153 1194 3153"/>
            </Shape>
            <String CONTENT="№ 58, гдѣ огнивный человѣкъ, т. е. русскій, придаетъ землѣ ея настоящій" HPOS="1194" VPOS="3025" WIDTH="3005" HEIGHT="128"/>
          </TextLine>
          <TextLine ID="mz_1-030_l21" HPOS="1202" VPOS="3180" WIDTH="2774" HEIGHT="100" BASELINE="1202 3279 3976 3279">
            <Shape>
              <Polygon POINTS="1202 3180 3976 3180 3976 3280 1202 3280"/>
            </Shape>
            <String CONTENT="видъ, выдавливаетъ озера, прочерпиваетъ рѣки, ставитъ горы и т. п." HPOS="1202" VPOS="3180" WIDTH="2774" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l22" HPOS="1418" VPOS="3310" WIDTH="2764" HEIGHT="101" BASELINE="1418 3410 4182 3410">
            <Shape>
              <Polygon POINTS="1418 3310 4182 3310 4182 3411 1418 3411"/>
            </Shape>
            <String CONTENT="Люди, которыхъ создаетъ Тенантө́мӈы, сначала очень безпомощны." HPOS="1418" VPOS="3310" WIDTH="2764" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-030_l23" HPOS="1194" VPOS="3436" WIDTH="2995" HEIGHT="103" BASELINE="1194 3539 4189 3539">
            <Shape>
              <Polygon POINTS="1194 3436 4189 3436 4189 3539 1194 3539"/>
            </Shape>
            <String CONTENT="Они стоять, опасаясь присѣсть, или лежать на боку, ничего не зная." HPOS="1194" VPOS="3436" WIDTH="2995" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l24" HPOS="1194" VPOS="3569" WIDTH="2996" HEIGHT="100" BASELINE="1194 3669 4190 3669">
            <Shape>
              <Polygon POINTS="1194 3569 4190 3569 4190 3669 1194 3669"/>
            </Shape>
            <String CONTENT="Творецъ долженъ ихъ обучать всѣмъ отправленіямъ жизни, начиная отъ" HPOS="1194" VPOS="3569" WIDTH="2996" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l25" HPOS="1200" VPOS="3688" WIDTH="1189" HEIGHT="101" BASELINE="1200 3789 2389 3789">
            <Shape>
              <Polygon POINTS="1200 3688 2389 3688 2389 3789 1200 3789"/>
            </Shape>
            <String CONTENT="ѣды и кончая совокупленіемъ." HPOS="1200" VPOS="3688" WIDTH="1189" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-030_l26" HPOS="1400" VPOS="3812" WIDTH="2787" HEIGHT="101" BASELINE="1400 3913 4187 3913">
            <Shape>
              <Polygon POINTS="1400 3812 4187 3812 4187 3913 1400 3913"/>
            </Shape>
            <String CONTENT="Нѣсколько разсказовъ занимаются также сотвореніемъ оленя, при" HPOS="1400" VPOS="3812" WIDTH="2787" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-030_l27" HPOS="1188" VPOS="3917" WIDTH="2999" HEIGHT="119" BASELINE="1188 4035 4187 4035">
            <Shape>
              <Polygon POINTS="1188 3917 4187 3917 4187 4036 1188 4036"/>
            </Shape>
            <String CONTENT="чемъ по однимъ онъ принесенъ людямъ Творцомъ съ неба, а въ № 60 данъ" HPOS="1188" VPOS="3917" WIDTH="2999" HEIGHT="119"/>
          </TextLine>
          <TextLine ID="mz_1-030_l28" HPOS="1192" VPOS="4058" WIDTH="2991" HEIGHT="112" BASELINE="1192 4169 4183 4169">
            <Shape>
              <Polygon POINTS="1192 4058 4183 4058 4183 4170 1192 4170"/>
            </Shape>
            <String CONTENT="имъ волшебной женщиной въ обмѣнъ за украденнаго ребенка. Въ № 56" HPOS="1192" VPOS="4058" WIDTH="2991" HEIGHT="112"/>
          </TextLine>
          <TextLine ID="mz_1-030_l29" HPOS="1185" VPOS="4197" WIDTH="3002" HEIGHT="100" BASELINE="1185 4296 4187 4296">
            <Shape>
              <Polygon POINTS="1185 4197 4187 4197 4187 4297 1185 4297"/>
            </Shape>
            <String CONTENT="описывается получеловѣкъ-полуолень, который догонялъ и истреблялъ все" HPOS="1185" VPOS="4197" WIDTH="3002" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-030_l30" HPOS="1178" VPOS="4316" WIDTH="3006" HEIGHT="103" BASELINE="1178 4418 4184 4418">
            <Shape>
              <Polygon POINTS="1178 4316 4184 4316 4184 4419 1178 4419"/>
            </Shape>
            <String CONTENT="живущее и по жалобѣ животныхъ былъ раздѣленъ пополамъ, при чемъ" HPOS="1178" VPOS="4316" WIDTH="3006" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l31" HPOS="1183" VPOS="4437" WIDTH="2999" HEIGHT="105" BASELINE="1183 4541 4182 4541">
            <Shape>
              <Polygon POINTS="1183 4437 4182 4437 4182 4542 1183 4542"/>
            </Shape>
            <String CONTENT="одна половина стала пасти другую. Тутъ-же разсказывается о созданіи" HPOS="1183" VPOS="4437" WIDTH="2999" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-030_l32" HPOS="1180" VPOS="4564" WIDTH="2996" HEIGHT="108" BASELINE="1180 4672 4176 4672">
            <Shape>
              <Polygon POINTS="1180 4564 4176 4564 4176 4672 1180 4672"/>
            </Shape>
            <String CONTENT="ламута (тунгуса), который еще не оконченъ, но все-таки очень быстръ," HPOS="1180" VPOS="4564" WIDTH="2996" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-030_l33" HPOS="1181" VPOS="4698" WIDTH="2994" HEIGHT="104" BASELINE="1181 4802 4175 4802">
            <Shape>
              <Polygon POINTS="1181 4698 4175 4698 4175 4802 1181 4802"/>
            </Shape>
            <String CONTENT="догоняетъ оленей и зубами раздираетъ ихъ. Быть можетъ, что получело-" HPOS="1181" VPOS="4698" WIDTH="2994" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-030_l34" HPOS="1176" VPOS="4825" WIDTH="3003" HEIGHT="99" BASELINE="1176 4923 4179 4923">
            <Shape>
              <Polygon POINTS="1176 4825 4179 4825 4179 4924 1176 4924"/>
            </Shape>
            <String CONTENT="вѣкъ-полуолень есть просто оленный всадникъ, подобно тому какъ греческій" HPOS="1176" VPOS="4825" WIDTH="3003" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-030_l35" HPOS="1175" VPOS="4948" WIDTH="3002" HEIGHT="104" BASELINE="1175 5051 4177 5051">
            <Shape>
              <Polygon POINTS="1175 4948 4177 4948 4177 5052 1175 5052"/>
            </Shape>
            <String CONTENT="центавръ соотвѣтствуетъ степному конному всаднику. Ламутъ-тунгусъ по" HPOS="1175" VPOS="4948" WIDTH="3002" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-030_l36" HPOS="1175" VPOS="5079" WIDTH="3004" HEIGHT="101" BASELINE="1175 5179 4179 5179">
            <Shape>
              <Polygon POINTS="1175 5079 4179 5079 4179 5180 1175 5180"/>
            </Shape>
            <String CONTENT="чукотски ӄа́а-ра́мкын «оленный человѣкъ», и въ частности ламутъ ӄор-емте́" HPOS="1175" VPOS="5079" WIDTH="3004" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-030_l37" HPOS="1176" VPOS="5194" WIDTH="2998" HEIGHT="102" BASELINE="1176 5295 4174 5295">
            <Shape>
              <Polygon POINTS="1176 5194 4174 5194 4174 5296 1176 5296"/>
            </Shape>
            <String CONTENT="-ӄа́а-ра́мкын «несомый оленемъ оленный человѣкъ». Оленные чукчи въ на-" HPOS="1176" VPOS="5194" WIDTH="2998" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-030_l38" HPOS="1174" VPOS="5335" WIDTH="3000" HEIGHT="92" BASELINE="1174 5423 4174 5423">
            <Shape>
              <Polygon POINTS="1174 5335 4174 5335 4174 5427 1174 5427"/>
            </Shape>
            <String CONTENT="стоящее время значительно превосходять ламутовъ своими стадами, но" HPOS="1174" VPOS="5335" WIDTH="3000" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-030_l39" HPOS="1170" VPOS="5453" WIDTH="3002" HEIGHT="102" BASELINE="1170 5554 4172 5554">
            <Shape>
              <Polygon POINTS="1170 5453 4172 5453 4172 5555 1170 5555"/>
            </Shape>
            <String CONTENT="можно предположить, что когда чукчи впервые встрѣтились съ ламутами и" HPOS="1170" VPOS="5453" WIDTH="3002" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-030_l40" HPOS="1169" VPOS="5580" WIDTH="3005" HEIGHT="103" BASELINE="1169 5682 4174 5682">
            <Shape>
              <Polygon POINTS="1169 5580 4174 5580 4174 5683 1169 5683"/>
            </Shape>
            <String CONTENT="дали имъ имя оленныхъ людей, они не имѣли собственныхъ оленей. Вообще" HPOS="1169" VPOS="5580" WIDTH="3005" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-030_l41" HPOS="1165" VPOS="5704" WIDTH="2999" HEIGHT="103" BASELINE="1165 5806 4164 5806">
            <Shape>
              <Polygon POINTS="1165 5704 4164 5704 4164 5807 1165 5807"/>
            </Shape>
            <String CONTENT="въ чукотскихъ преданіяхъ и легендахъ страннымъ образомъ чередуются" HPOS="1165" VPOS="5704" WIDTH="2999" HEIGHT="103"/>
          </TextLine>
