          <TextLine ID="mz_1-292_l3" HPOS="1221" VPOS="776" WIDTH="2989" HEIGHT="108" BASELINE="1221 884 4210 884">
            <Shape>
              <Polygon POINTS="1221 776 4210 776 4210 884 1221 884"/>
            </Shape>
            <String CONTENT="Небо, Море, Разсвѣтъ, Тьма, Вселенная¹). Смотритъ Аттыђы́ткы на ихъ" HPOS="1221" VPOS="776" WIDTH="2989" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-292_l4" HPOS="1221" VPOS="905" WIDTH="2989" HEIGHT="100" BASELINE="1221 1004 4210 1004">
            <Shape>
              <Polygon POINTS="1221 905 4210 905 4210 1005 1221 1005"/>
            </Shape>
            <String CONTENT="руки, а онѣ всѣ въ шрамахъ. Внесли корыто съ мерзлымъ мясомъ; стали" HPOS="1221" VPOS="905" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-292_l5" HPOS="1227" VPOS="1028" WIDTH="2979" HEIGHT="103" BASELINE="1227 1130 4206 1130">
            <Shape>
              <Polygon POINTS="1227 1028 4206 1028 4206 1131 1227 1131"/>
            </Shape>
            <String CONTENT="ѣсть женихи, протягиваютъ руки и тотчасъ-же отхватываютъ, ибо Ну́тэ-" HPOS="1227" VPOS="1028" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-292_l6" HPOS="1223" VPOS="1152" WIDTH="2990" HEIGHT="105" BASELINE="1223 1256 4213 1256">
            <Shape>
              <Polygon POINTS="1223 1152 4213 1152 4213 1257 1223 1257"/>
            </Shape>
            <String CONTENT="нутъ такъ и колотитъ ножемъ по рукамъ. Но такъ какъ всѣ они великіе," HPOS="1223" VPOS="1152" WIDTH="2990" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-292_l7" HPOS="1226" VPOS="1281" WIDTH="2985" HEIGHT="103" BASELINE="1226 1383 4211 1383">
            <Shape>
              <Polygon POINTS="1226 1281 4211 1281 4211 1384 1226 1384"/>
            </Shape>
            <String CONTENT="шаманы, то какую руку не пробьетъ, только подуетъ на руку, рана исцѣ-" HPOS="1226" VPOS="1281" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-292_l8" HPOS="1222" VPOS="1408" WIDTH="2993" HEIGHT="104" BASELINE="1222 1512 4215 1512">
            <Shape>
              <Polygon POINTS="1222 1408 4215 1408 4215 1512 1222 1512"/>
            </Shape>
            <String CONTENT="лится, останется только шрамъ. Сѣлъ Аттыђы́ткы въ сторону, положилъ" HPOS="1222" VPOS="1408" WIDTH="2993" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-292_l9" HPOS="1226" VPOS="1532" WIDTH="2991" HEIGHT="100" BASELINE="1226 1631 4217 1631">
            <Shape>
              <Polygon POINTS="1226 1532 4217 1532 4217 1632 1226 1632"/>
            </Shape>
            <String CONTENT="на колѣни шапку, потянулъ ртомъ, засопѣлъ носомъ, ѣда сама вскочила" HPOS="1226" VPOS="1532" WIDTH="2991" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-292_l10" HPOS="1225" VPOS="1658" WIDTH="2993" HEIGHT="101" BASELINE="1225 1758 4218 1758">
            <Shape>
              <Polygon POINTS="1225 1658 4218 1658 4218 1759 1225 1759"/>
            </Shape>
            <String CONTENT="ему въ шапку и онъ съ братомъ сталъ ѣсть въ сторонѣ. Ну́тэнуту не воз-" HPOS="1225" VPOS="1658" WIDTH="2993" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-292_l11" HPOS="1225" VPOS="1779" WIDTH="2992" HEIGHT="100" BASELINE="1225 1878 4217 1878">
            <Shape>
              <Polygon POINTS="1225 1779 4217 1779 4217 1879 1225 1879"/>
            </Shape>
            <String CONTENT="можно вмѣшаться. Потомъ внесли котелъ съ мясомъ. Колотитъ по рукамъ" HPOS="1225" VPOS="1779" WIDTH="2992" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-292_l12" HPOS="1220" VPOS="1911" WIDTH="2999" HEIGHT="104" BASELINE="1220 2014 4219 2014">
            <Shape>
              <Polygon POINTS="1220 1911 4219 1911 4219 2015 1220 2015"/>
            </Shape>
            <String CONTENT="Ну́тэнутъ жениховъ, а Аттыђы́ткы потянулъ носомъ воздухъ и вдругъ у" HPOS="1220" VPOS="1911" WIDTH="2999" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-292_l13" HPOS="1231" VPOS="2032" WIDTH="2991" HEIGHT="102" BASELINE="1231 2134 4222 2134">
            <Shape>
              <Polygon POINTS="1231 2032 4222 2032 4222 2134 1231 2134"/>
            </Shape>
            <String CONTENT="него полная шапка, жиръ такъ и течетъ черезъ край. Сѣли съ братомъ въ" HPOS="1231" VPOS="2032" WIDTH="2991" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-292_l14" HPOS="1230" VPOS="2160" WIDTH="2994" HEIGHT="101" BASELINE="1230 2260 4224 2260">
            <Shape>
              <Polygon POINTS="1230 2160 4224 2160 4224 2261 1230 2261"/>
            </Shape>
            <String CONTENT="сторонѣ и стали ѣсть. Послѣ ѣды говоритъ Ну́тэнутъ: «Пойдите женихи по" HPOS="1230" VPOS="2160" WIDTH="2994" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-292_l15" HPOS="1229" VPOS="2271" WIDTH="2986" HEIGHT="114" BASELINE="1229 2384 4215 2384">
            <Shape>
              <Polygon POINTS="1229 2271 4215 2271 4215 2385 1229 2385"/>
            </Shape>
            <String CONTENT="дрова! Ибо дровъ не стало!» А съ дровами худо. Выйдетъ дерево изъ" HPOS="1229" VPOS="2271" WIDTH="2986" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-292_l16" HPOS="1232" VPOS="2372" WIDTH="2988" HEIGHT="135" BASELINE="1232 2506 4220 2506">
            <Shape>
              <Polygon POINTS="1232 2372 4220 2372 4220 2507 1232 2507"/>
            </Shape>
            <String CONTENT="земли, подойдетъ дровосѣкъ и оно спрячется подъ землю. Пошло Солнце —" HPOS="1232" VPOS="2372" WIDTH="2988" HEIGHT="135"/>
          </TextLine>
          <TextLine ID="mz_1-292_l17" HPOS="1235" VPOS="2489" WIDTH="2988" HEIGHT="126" BASELINE="1235 2614 4223 2614">
            <Shape>
              <Polygon POINTS="1235 2489 4223 2489 4223 2615 1235 2615"/>
            </Shape>
            <String CONTENT="не могло. Пошелъ Мѣсяцъ — не могъ. Пошло Небо — не могло. Пошло" HPOS="1235" VPOS="2489" WIDTH="2988" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-292_l18" HPOS="1228" VPOS="2616" WIDTH="2992" HEIGHT="141" BASELINE="1228 2756 4220 2756">
            <Shape>
              <Polygon POINTS="1228 2616 4220 2616 4220 2757 1228 2757"/>
            </Shape>
            <String CONTENT="Море — не могло. Пошелъ Разсвѣтъ — не могъ. Пошелъ Мракъ — не могъ." HPOS="1228" VPOS="2616" WIDTH="2992" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-292_l19" HPOS="1225" VPOS="2757" WIDTH="2990" HEIGHT="131" BASELINE="1225 2887 4215 2887">
            <Shape>
              <Polygon POINTS="1225 2757 4215 2757 4215 2888 1225 2888"/>
            </Shape>
            <String CONTENT="Пошелъ Ӈа́рђыненъ — не могъ. Пошли Аттыђы́ткы съ братомъ. Посмотрѣли:" HPOS="1225" VPOS="2757" WIDTH="2990" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-292_l20" HPOS="1234" VPOS="2910" WIDTH="2978" HEIGHT="99" BASELINE="1234 3008 4212 3008">
            <Shape>
              <Polygon POINTS="1234 2910 4212 2910 4212 3009 1234 3009"/>
            </Shape>
            <String CONTENT="среди моря дерево, величиной во всю землю отъ Пильгина до Ванкарэма²)." HPOS="1234" VPOS="2910" WIDTH="2978" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-292_l21" HPOS="1229" VPOS="3013" WIDTH="2996" HEIGHT="129" BASELINE="1229 3142 4225 3142">
            <Shape>
              <Polygon POINTS="1229 3013 4225 3013 4225 3142 1229 3142"/>
            </Shape>
            <String CONTENT="А въ деревѣ сидитъ Кэ́lє и какъ только женихъ начнетъ рубить, Кэ́lє" HPOS="1229" VPOS="3013" WIDTH="2996" HEIGHT="129"/>
          </TextLine>
          <TextLine ID="mz_1-292_l22" HPOS="1236" VPOS="3158" WIDTH="2989" HEIGHT="101" BASELINE="1236 3258 4225 3258">
            <Shape>
              <Polygon POINTS="1236 3158 4225 3158 4225 3259 1236 3259"/>
            </Shape>
            <String CONTENT="встряхнетъ дерево, упадетъ женихъ въ воду, утонетъ. Но такъ какъ всѣ" HPOS="1236" VPOS="3158" WIDTH="2989" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-292_l23" HPOS="1238" VPOS="3282" WIDTH="2984" HEIGHT="102" BASELINE="1238 3384 4222 3384">
            <Shape>
              <Polygon POINTS="1238 3282 4222 3282 4222 3384 1238 3384"/>
            </Shape>
            <String CONTENT="великіе шаманы, то на другомъ берегу вынырнетъ и пойдетъ по берегу." HPOS="1238" VPOS="3282" WIDTH="2984" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-292_l24" HPOS="1233" VPOS="3411" WIDTH="2994" HEIGHT="104" BASELINE="1233 3514 4227 3514">
            <Shape>
              <Polygon POINTS="1233 3411 4227 3411 4227 3515 1233 3515"/>
            </Shape>
            <String CONTENT="Превратились Аттыђы́ткыны³) въ комаровъ, полетѣли на другую все-" HPOS="1233" VPOS="3411" WIDTH="2994" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-292_l25" HPOS="1236" VPOS="3537" WIDTH="2989" HEIGHT="98" BASELINE="1236 3634 4225 3634">
            <Shape>
              <Polygon POINTS="1236 3537 4225 3537 4225 3635 1236 3635"/>
            </Shape>
            <String CONTENT="ленную, накрали тамъ жиру и сушеныхъ боковъ и уронили внизъ, какъ-" HPOS="1236" VPOS="3537" WIDTH="2989" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-292_l26" HPOS="1236" VPOS="3670" WIDTH="2996" HEIGHT="95" BASELINE="1236 3765 4232 3765">
            <Shape>
              <Polygon POINTS="1236 3670 4232 3670 4232 3765 1236 3765"/>
            </Shape>
            <String CONTENT="разъ туда, гдѣ сидѣлъ Кэ́lє; схватилъ онъ мясо, сталъ ѣсть, а въ это время" HPOS="1236" VPOS="3670" WIDTH="2996" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-292_l27" HPOS="1235" VPOS="3783" WIDTH="2995" HEIGHT="104" BASELINE="1235 3886 4230 3886">
            <Shape>
              <Polygon POINTS="1235 3783 4230 3783 4230 3887 1235 3887"/>
            </Shape>
            <String CONTENT="Аттыђы́ткы отрубилъ кусокъ дерева величиной съ домъ и вмѣстѣ съ бра-" HPOS="1235" VPOS="3783" WIDTH="2995" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-292_l28" HPOS="1237" VPOS="3909" WIDTH="2988" HEIGHT="100" BASELINE="1237 4008 4225 4008">
            <Shape>
              <Polygon POINTS="1237 3909 4225 3909 4225 4009 1237 4009"/>
            </Shape>
            <String CONTENT="томъ унесли его. Понесли дерево въ домъ тестя. «Како́! Принесли? От-" HPOS="1237" VPOS="3909" WIDTH="2988" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-292_l29" HPOS="1236" VPOS="3961" WIDTH="2993" HEIGHT="153" BASELINE="1236 4113 4229 4113">
            <Shape>
              <Polygon POINTS="1236 3961 4229 3961 4229 4114 1236 4114"/>
            </Shape>
            <String CONTENT="куда?» — «Изъ средины моря.» — «А Кэ́lє что?» «Ничего!» — «Ну, по-" HPOS="1236" VPOS="3961" WIDTH="2993" HEIGHT="153"/>
          </TextLine>
          <TextLine ID="mz_1-292_l30" HPOS="1234" VPOS="4165" WIDTH="2995" HEIGHT="99" BASELINE="1234 4263 4229 4263">
            <Shape>
              <Polygon POINTS="1234 4165 4229 4165 4229 4264 1234 4264"/>
            </Shape>
            <String CONTENT="скорѣе отнесите это дерево на прежнее мѣсто, прикрѣпите такъ, чтобы не" HPOS="1234" VPOS="4165" WIDTH="2995" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-292_l31" HPOS="1238" VPOS="4287" WIDTH="2985" HEIGHT="104" BASELINE="1238 4390 4223 4390">
            <Shape>
              <Polygon POINTS="1238 4287 4223 4287 4223 4391 1238 4391"/>
            </Shape>
            <String CONTENT="осталось слѣда!» Полетѣли Аттыђы́ткыны съ братомъ и поднялись надъ" HPOS="1238" VPOS="4287" WIDTH="2985" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-292_l32" HPOS="1236" VPOS="4410" WIDTH="2991" HEIGHT="103" BASELINE="1236 4512 4227 4512">
            <Shape>
              <Polygon POINTS="1236 4410 4227 4410 4227 4513 1236 4513"/>
            </Shape>
            <String CONTENT="дьявольскимъ деревомъ въ вышину, уронили свой кусокъ внизъ и онъ" HPOS="1236" VPOS="4410" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-292_l33" HPOS="1238" VPOS="4536" WIDTH="2990" HEIGHT="102" BASELINE="1238 4637 4228 4637">
            <Shape>
              <Polygon POINTS="1238 4536 4228 4536 4228 4638 1238 4638"/>
            </Shape>
            <String CONTENT="приросъ по прежнему къ дереву. «Како́!» говоритъ Ну́тэнутъ, «ты великій" HPOS="1238" VPOS="4536" WIDTH="2990" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-292_l34" HPOS="1235" VPOS="4657" WIDTH="2985" HEIGHT="108" BASELINE="1235 4764 4220 4764">
            <Shape>
              <Polygon POINTS="1235 4657 4220 4657 4220 4765 1235 4765"/>
            </Shape>
            <String CONTENT="шаманъ! Ну, чтожъ, пусть пошаманятъ всѣ женихи!» Вошли въ пологъ;" HPOS="1235" VPOS="4657" WIDTH="2985" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-292_l35" HPOS="1231" VPOS="4747" WIDTH="2997" HEIGHT="126" BASELINE="1231 4872 4228 4872">
            <Shape>
              <Polygon POINTS="1231 4747 4228 4747 4228 4873 1231 4873"/>
            </Shape>
            <String CONTENT="всѣ стали шаманить. Зашаманило Солнце — явилось великое солнце и" HPOS="1231" VPOS="4747" WIDTH="2997" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-292_l36" HPOS="1235" VPOS="4910" WIDTH="2991" HEIGHT="99" BASELINE="1235 5008 4226 5008">
            <Shape>
              <Polygon POINTS="1235 4910 4226 4910 4226 5009 1235 5009"/>
            </Shape>
            <String CONTENT="сожгло всѣхъ жениховъ. Но такъ какъ они великіе шаманы, то, какъ" HPOS="1235" VPOS="4910" WIDTH="2991" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-292_l37" HPOS="1230" VPOS="5039" WIDTH="2995" HEIGHT="105" BASELINE="1230 5143 4225 5143">
            <Shape>
              <Polygon POINTS="1230 5039 4225 5039 4225 5144 1230 5144"/>
            </Shape>
            <String CONTENT="только ушло Солнце, всѣ ожили. Но Аттыђы́ткы съ братомъ превратились" HPOS="1230" VPOS="5039" WIDTH="2995" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-292_l38" HPOS="1234" VPOS="5165" WIDTH="2993" HEIGHT="100" BASELINE="1234 5264 4227 5264">
            <Shape>
              <Polygon POINTS="1234 5165 4227 5165 4227 5265 1234 5265"/>
            </Shape>
            <String CONTENT="въ красныхъ червей и скользнули подъ землю, и ихъ не обожгло. Потомъ" HPOS="1234" VPOS="5165" WIDTH="2993" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-292_l39" HPOS="1454" VPOS="5444" WIDTH="2606" HEIGHT="113" BASELINE="1454 5556 4060 5556">
            <Shape>
              <Polygon POINTS="1454 5444 4060 5444 4060 5557 1454 5557"/>
            </Shape>
            <String CONTENT="1) Ті́ркіір, Јі́lђын, Јэ́јэӄ, А́ӈӄы, Тӈа́ырђын, Wу́с̧ӄуус̧, Ӈа́рђынен." HPOS="1454" VPOS="5444" WIDTH="2606" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-292_l40" HPOS="1445" VPOS="5556" WIDTH="2148" HEIGHT="97" BASELINE="1445 5652 3593 5652">
            <Shape>
              <Polygon POINTS="1445 5556 3593 5556 3593 5653 1445 5653"/>
            </Shape>
            <String CONTENT="2) Мѣстности на Ледовитомъ побережьѣ у Чукотскаго Носа." HPOS="1445" VPOS="5556" WIDTH="2148" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-292_l41" HPOS="1448" VPOS="5667" WIDTH="2769" HEIGHT="101" BASELINE="1448 5767 4217 5767">
            <Shape>
              <Polygon POINTS="1448 5667 4217 5667 4217 5768 1448 5768"/>
            </Shape>
            <String CONTENT="3) Аттыђы́ткынте множ. число, какъ у насъ Ивановы отъ фамиліи Ивановъ." HPOS="1448" VPOS="5667" WIDTH="2769" HEIGHT="101"/>
          </TextLine>
