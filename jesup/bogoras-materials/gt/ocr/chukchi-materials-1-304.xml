        <TextBlock ID="text_1-304" HPOS="1124" VPOS="534" WIDTH="2999" HEIGHT="5232">
          <TextLine ID="mz_1-304_l1" HPOS="1124" VPOS="534" WIDTH="2989" HEIGHT="111" BASELINE="1124 644 4113 644">
            <Shape>
              <Polygon POINTS="1124 534 4113 534 4113 645 1124 645"/>
            </Shape>
            <String CONTENT="248 В. Г. БОГОРАЗЪ, II,91." HPOS="1124" VPOS="534" WIDTH="2989" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-304_l2" HPOS="1130" VPOS="775" WIDTH="2989" HEIGHT="100" BASELINE="1130 874 4119 874">
            <Shape>
              <Polygon POINTS="1130 775 4119 775 4119 875 1130 875"/>
            </Shape>
            <String CONTENT="встрѣчалъ. Встрѣтилъ тоже и орловъ, и вороновъ, лебедей и утокъ, и" HPOS="1130" VPOS="775" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l3" HPOS="1132" VPOS="901" WIDTH="2984" HEIGHT="105" BASELINE="1132 1005 4116 1005">
            <Shape>
              <Polygon POINTS="1132 901 4116 901 4116 1006 1132 1006"/>
            </Shape>
            <String CONTENT="гусей, и лисицу, и зайца, и всю живущую дичь и мелкую пташку ва̂ђ-пче-" HPOS="1132" VPOS="901" WIDTH="2984" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-304_l4" HPOS="1131" VPOS="1032" WIDTH="2989" HEIGHT="99" BASELINE="1131 1130 4120 1130">
            <Shape>
              <Polygon POINTS="1131 1032 4120 1032 4120 1131 1131 1131"/>
            </Shape>
            <String CONTENT="ка́lђын¹), и всѣ ему говорили одно. Тогда онъ ободрился и пошелъ быстрѣе," HPOS="1131" VPOS="1032" WIDTH="2989" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-304_l5" HPOS="1134" VPOS="1150" WIDTH="2983" HEIGHT="100" BASELINE="1134 1249 4117 1249">
            <Shape>
              <Polygon POINTS="1134 1150 4117 1150 4117 1250 1134 1250"/>
            </Shape>
            <String CONTENT="поднялся по подъему на землю разсвѣта и нашелъ селеніе изъ десяти" HPOS="1134" VPOS="1150" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l6" HPOS="1130" VPOS="1275" WIDTH="2982" HEIGHT="100" BASELINE="1130 1374 4112 1374">
            <Shape>
              <Polygon POINTS="1130 1275 4112 1275 4112 1375 1130 1375"/>
            </Shape>
            <String CONTENT="домовъ и зашелъ въ передній домъ. Старичекъ закричалъ: «Гость, гость!" HPOS="1130" VPOS="1275" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l7" HPOS="1129" VPOS="1402" WIDTH="2987" HEIGHT="105" BASELINE="1129 1507 4116 1507">
            <Shape>
              <Polygon POINTS="1129 1402 4116 1402 4116 1507 1129 1507"/>
            </Shape>
            <String CONTENT="Покормите его, скорѣе приготовьте (ѣду)!» Выскочили дѣвки: «О», говорятъ," HPOS="1129" VPOS="1402" WIDTH="2987" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-304_l8" HPOS="1135" VPOS="1525" WIDTH="2981" HEIGHT="107" BASELINE="1135 1632 4116 1632">
            <Shape>
              <Polygon POINTS="1135 1525 4116 1525 4116 1632 1135 1632"/>
            </Shape>
            <String CONTENT="«какой умирающій отъ сухотки пришелъ! Въ собачьей одеждѣ, покрытый" HPOS="1135" VPOS="1525" WIDTH="2981" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-304_l9" HPOS="1133" VPOS="1619" WIDTH="2985" HEIGHT="138" BASELINE="1133 1757 4118 1757">
            <Shape>
              <Polygon POINTS="1133 1619 4118 1619 4118 1757 1133 1757"/>
            </Shape>
            <String CONTENT="паршами, — не нужно его!» Напихали ему ротъ каломъ и въ суму вмѣсто" HPOS="1133" VPOS="1619" WIDTH="2985" HEIGHT="138"/>
          </TextLine>
          <TextLine ID="mz_1-304_l10" HPOS="1135" VPOS="1781" WIDTH="2983" HEIGHT="93" BASELINE="1135 1873 4118 1873">
            <Shape>
              <Polygon POINTS="1135 1781 4118 1781 4118 1874 1135 1874"/>
            </Shape>
            <String CONTENT="запаса наложили помета. Онъ пошелъ съ плачемъ дальше и дошелъ до" HPOS="1135" VPOS="1781" WIDTH="2983" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-304_l11" HPOS="1134" VPOS="1909" WIDTH="2978" HEIGHT="94" BASELINE="1134 2003 4112 2003">
            <Shape>
              <Polygon POINTS="1134 1909 4112 1909 4112 2003 1134 2003"/>
            </Shape>
            <String CONTENT="крайняго дома. Особо отъ селенія стоялъ отдѣльный домъ; въ немъ ста-" HPOS="1134" VPOS="1909" WIDTH="2978" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-304_l12" HPOS="1125" VPOS="2029" WIDTH="2992" HEIGHT="105" BASELINE="1125 2133 4117 2133">
            <Shape>
              <Polygon POINTS="1125 2029 4117 2029 4117 2134 1125 2134"/>
            </Shape>
            <String CONTENT="рикъ, — у него три дочери, сыновей нѣтъ. Младшая варитъ ѣду, старшая" HPOS="1125" VPOS="2029" WIDTH="2992" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-304_l13" HPOS="1130" VPOS="2164" WIDTH="2981" HEIGHT="87" BASELINE="1130 2250 4111 2250">
            <Shape>
              <Polygon POINTS="1130 2164 4111 2164 4111 2251 1130 2251"/>
            </Shape>
            <String CONTENT="сидитъ въ пологу, умытая и чистая, ни въ чемъ грязномъ не копается, по-" HPOS="1130" VPOS="2164" WIDTH="2981" HEIGHT="87"/>
          </TextLine>
          <TextLine ID="mz_1-304_l14" HPOS="1130" VPOS="2288" WIDTH="2987" HEIGHT="89" BASELINE="1130 2376 4117 2376">
            <Shape>
              <Polygon POINTS="1130 2288 4117 2288 4117 2377 1130 2377"/>
            </Shape>
            <String CONTENT="стоянно шьетъ самую лучшую одежду, шьетъ утромъ рано и вечеромъ на" HPOS="1130" VPOS="2288" WIDTH="2987" HEIGHT="89"/>
          </TextLine>
          <TextLine ID="mz_1-304_l15" HPOS="1128" VPOS="2401" WIDTH="2989" HEIGHT="101" BASELINE="1128 2502 4117 2502">
            <Shape>
              <Polygon POINTS="1128 2401 4117 2401 4117 2502 1128 2502"/>
            </Shape>
            <String CONTENT="закатѣ солнца, не покладывая иглы. Стадо велико. Варящая ѣду закричала" HPOS="1128" VPOS="2401" WIDTH="2989" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-304_l16" HPOS="1129" VPOS="2531" WIDTH="2982" HEIGHT="99" BASELINE="1129 2629 4111 2629">
            <Shape>
              <Polygon POINTS="1129 2531 4111 2531 4111 2630 1129 2630"/>
            </Shape>
            <String CONTENT="на дворѣ: «Гость, гость! Скорѣе разстелите въ пологу постелей получше," HPOS="1129" VPOS="2531" WIDTH="2982" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-304_l17" HPOS="1132" VPOS="2650" WIDTH="2979" HEIGHT="102" BASELINE="1132 2751 4111 2751">
            <Shape>
              <Polygon POINTS="1132 2650 4111 2650 4111 2752 1132 2752"/>
            </Shape>
            <String CONTENT="скорѣе приготовьте!» Старикъ кричитъ: «Принесите жиръ и лучшее мясо," HPOS="1132" VPOS="2650" WIDTH="2979" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-304_l18" HPOS="1128" VPOS="2770" WIDTH="2986" HEIGHT="106" BASELINE="1128 2875 4114 2875">
            <Shape>
              <Polygon POINTS="1128 2770 4114 2770 4114 2876 1128 2876"/>
            </Shape>
            <String CONTENT="желудокъ и кишки покормить гостя!» Накормивши, спрашиваетъ: «Ты от-" HPOS="1128" VPOS="2770" WIDTH="2986" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-304_l19" HPOS="1134" VPOS="2876" WIDTH="2984" HEIGHT="126" BASELINE="1134 3001 4118 3001">
            <Shape>
              <Polygon POINTS="1134 2876 4118 2876 4118 3002 1134 3002"/>
            </Shape>
            <String CONTENT="куда пришелъ?» — «Пришелъ я съ морскаго берега искать хозяйства;" HPOS="1134" VPOS="2876" WIDTH="2984" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-304_l20" HPOS="1135" VPOS="3028" WIDTH="2979" HEIGHT="101" BASELINE="1135 3128 4114 3128">
            <Shape>
              <Polygon POINTS="1135 3028 4114 3028 4114 3129 1135 3129"/>
            </Shape>
            <String CONTENT="родомъ я оленный, но внутренность отца стала мнѣ чужой и я потому по-" HPOS="1135" VPOS="3028" WIDTH="2979" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-304_l21" HPOS="1135" VPOS="3138" WIDTH="2984" HEIGHT="99" BASELINE="1135 3236 4119 3236">
            <Shape>
              <Polygon POINTS="1135 3138 4119 3138 4119 3237 1135 3237"/>
            </Shape>
            <String CONTENT="кинулъ свою страну и пришелъ въ другую область.» — «Зачѣмъ-же" HPOS="1135" VPOS="3138" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-304_l22" HPOS="1132" VPOS="3202" WIDTH="2986" HEIGHT="150" BASELINE="1132 3352 4118 3352">
            <Shape>
              <Polygon POINTS="1132 3202 4118 3202 4118 3352 1132 3352"/>
            </Shape>
            <String CONTENT="ты?» — «Жену ищу.» — «Хорошо», говоритъ отецъ, «если ты женихъ," HPOS="1132" VPOS="3202" WIDTH="2986" HEIGHT="150"/>
          </TextLine>
          <TextLine ID="mz_1-304_l23" HPOS="1133" VPOS="3401" WIDTH="2990" HEIGHT="103" BASELINE="1133 3503 4123 3503">
            <Shape>
              <Polygon POINTS="1133 3401 4123 3401 4123 3504 1133 3504"/>
            </Shape>
            <String CONTENT="пойди въ стадо!» Пошелъ въ стадо; по дорогѣ заснулъ. Предъ сномъ" HPOS="1133" VPOS="3401" WIDTH="2990" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-304_l24" HPOS="1132" VPOS="3529" WIDTH="2987" HEIGHT="101" BASELINE="1132 3629 4119 3629">
            <Shape>
              <Polygon POINTS="1132 3529 4119 3529 4119 3630 1132 3630"/>
            </Shape>
            <String CONTENT="вскричалъ: «Духи, боящіеся меня, пригоните домой стадо!» Духи отпра-" HPOS="1132" VPOS="3529" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-304_l25" HPOS="1131" VPOS="3651" WIDTH="2990" HEIGHT="105" BASELINE="1131 3755 4121 3755">
            <Shape>
              <Polygon POINTS="1131 3651 4121 3651 4121 3756 1131 3756"/>
            </Shape>
            <String CONTENT="вились и на утро все стадо пришло. Пришли къ дому олени. Говоритъ" HPOS="1131" VPOS="3651" WIDTH="2990" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-304_l26" HPOS="1138" VPOS="3780" WIDTH="2982" HEIGHT="100" BASELINE="1138 3879 4120 3879">
            <Shape>
              <Polygon POINTS="1138 3780 4120 3780 4120 3880 1138 3880"/>
            </Shape>
            <String CONTENT="отецъ: «Станемъ убивать!» Кинулъ арканомъ женихъ, поймалъ теленка." HPOS="1138" VPOS="3780" WIDTH="2982" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l27" HPOS="1124" VPOS="3908" WIDTH="2997" HEIGHT="99" BASELINE="1124 4007 4121 4007">
            <Shape>
              <Polygon POINTS="1124 3908 4121 3908 4121 4007 1124 4007"/>
            </Shape>
            <String CONTENT="Худой теленокъ, но таскаетъ его во всѣ стороны. Наконецъ закричалъ" HPOS="1124" VPOS="3908" WIDTH="2997" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-304_l28" HPOS="1132" VPOS="4029" WIDTH="2989" HEIGHT="100" BASELINE="1132 4128 4121 4128">
            <Shape>
              <Polygon POINTS="1132 4029 4121 4029 4121 4129 1132 4129"/>
            </Shape>
            <String CONTENT="дѣвушкамъ: «Придавите его!» Насилу придавили. Потомъ кинулъ арканомъ" HPOS="1132" VPOS="4029" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l29" HPOS="1132" VPOS="4150" WIDTH="2979" HEIGHT="103" BASELINE="1132 4252 4111 4252">
            <Shape>
              <Polygon POINTS="1132 4150 4111 4150 4111 4253 1132 4253"/>
            </Shape>
            <String CONTENT="и поймалъ большаго быка, притащилъ его однимъ пальцемъ. «Ну», гово-" HPOS="1132" VPOS="4150" WIDTH="2979" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-304_l30" HPOS="1130" VPOS="4275" WIDTH="2980" HEIGHT="104" BASELINE="1130 4378 4110 4378">
            <Shape>
              <Polygon POINTS="1130 4275 4110 4275 4110 4379 1130 4379"/>
            </Shape>
            <String CONTENT="ритъ (отецъ). «Что-же? Кто изъ васъ возьметъ его въ мужья? Пусть ты," HPOS="1130" VPOS="4275" WIDTH="2980" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-304_l31" HPOS="1129" VPOS="4370" WIDTH="2980" HEIGHT="131" BASELINE="1129 4500 4109 4500">
            <Shape>
              <Polygon POINTS="1129 4370 4109 4370 4109 4501 1129 4501"/>
            </Shape>
            <String CONTENT="младшая, если ты варишь пищу!» — «Не нужно, не нужно! Нищій!" HPOS="1129" VPOS="4370" WIDTH="2980" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-304_l32" HPOS="1132" VPOS="4487" WIDTH="2978" HEIGHT="144" BASELINE="1132 4630 4110 4630">
            <Shape>
              <Polygon POINTS="1132 4487 4110 4487 4110 4631 1132 4631"/>
            </Shape>
            <String CONTENT="Собакоодѣтый, весь въ чесоткѣ! Кому такой мужъ достанется?» — «Ну," HPOS="1132" VPOS="4487" WIDTH="2978" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-304_l33" HPOS="1133" VPOS="4622" WIDTH="2979" HEIGHT="130" BASELINE="1133 4752 4112 4752">
            <Shape>
              <Polygon POINTS="1133 4622 4112 4622 4112 4752 1133 4752"/>
            </Shape>
            <String CONTENT="пусть средней онъ пойдетъ въ мужья!» — «Не нужно, не нужно! Весь въ" HPOS="1133" VPOS="4622" WIDTH="2979" HEIGHT="130"/>
          </TextLine>
          <TextLine ID="mz_1-304_l34" HPOS="1128" VPOS="4743" WIDTH="2978" HEIGHT="139" BASELINE="1128 4882 4106 4882">
            <Shape>
              <Polygon POINTS="1128 4743 4106 4743 4106 4882 1128 4882"/>
            </Shape>
            <String CONTENT="чесоткѣ, въ собачьей одеждѣ. Кому нуженъ такой мужъ?» — «Ну ты," HPOS="1128" VPOS="4743" WIDTH="2978" HEIGHT="139"/>
          </TextLine>
          <TextLine ID="mz_1-304_l35" HPOS="1135" VPOS="4896" WIDTH="2977" HEIGHT="102" BASELINE="1135 4997 4112 4997">
            <Shape>
              <Polygon POINTS="1135 4896 4112 4896 4112 4998 1135 4998"/>
            </Shape>
            <String CONTENT="старшая! Пусть хоть тебѣ!» — «Эђэ́ј!» Вошли въ пологъ. «Разстели новыя" HPOS="1135" VPOS="4896" WIDTH="2977" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-304_l36" HPOS="1133" VPOS="5028" WIDTH="2982" HEIGHT="104" BASELINE="1133 5132 4115 5132">
            <Shape>
              <Polygon POINTS="1133 5028 4115 5028 4115 5132 1133 5132"/>
            </Shape>
            <String CONTENT="шкуры жениху для постели!» Разостлала. Вынула платье, которое она" HPOS="1133" VPOS="5028" WIDTH="2982" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-304_l37" HPOS="1128" VPOS="5162" WIDTH="2984" HEIGHT="100" BASELINE="1128 5262 4112 5262">
            <Shape>
              <Polygon POINTS="1128 5162 4112 5162 4112 5262 1128 5262"/>
            </Shape>
            <String CONTENT="сдѣлала въ прежнее время. Сняла съ него его одежду, старую, худую, изъ" HPOS="1128" VPOS="5162" WIDTH="2984" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-304_l38" HPOS="1133" VPOS="5286" WIDTH="2978" HEIGHT="96" BASELINE="1133 5382 4111 5382">
            <Shape>
              <Polygon POINTS="1133 5286 4111 5286 4111 5382 1133 5382"/>
            </Shape>
            <String CONTENT="собачины и отскоблила ножомъ грязь и чесотку; надѣла на него все новое:" HPOS="1133" VPOS="5286" WIDTH="2978" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-304_l39" HPOS="1130" VPOS="5416" WIDTH="2975" HEIGHT="94" BASELINE="1130 5509 4105 5509">
            <Shape>
              <Polygon POINTS="1130 5416 4105 5416 4105 5510 1130 5510"/>
            </Shape>
            <String CONTENT="платье и обувь со вставками, кукашку съ тройной обшивкой изъ россомахи" HPOS="1130" VPOS="5416" WIDTH="2975" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-304_l40" HPOS="1334" VPOS="5681" WIDTH="742" HEIGHT="85" BASELINE="1334 5766 2076 5766">
            <Shape>
              <Polygon POINTS="1334 5681 2076 5681 2076 5766 1334 5766"/>
            </Shape>
            <String CONTENT="1) «Травяная птица»." HPOS="1334" VPOS="5681" WIDTH="742" HEIGHT="85"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
