        <TextBlock ID="text_1-322" HPOS="1144" VPOS="540" WIDTH="3017" HEIGHT="5197">
          <TextLine ID="mz_1-322_l1" HPOS="1150" VPOS="540" WIDTH="2989" HEIGHT="111" BASELINE="1150 646 4139 646">
            <Shape>
              <Polygon POINTS="1150 540 4139 540 4139 651 1150 651"/>
            </Shape>
            <String CONTENT="266 В. Г. БОГОРАЗЪ, II,98." HPOS="1150" VPOS="540" WIDTH="2989" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-322_l2" HPOS="1150" VPOS="758" WIDTH="3005" HEIGHT="106" BASELINE="1150 864 4155 864">
            <Shape>
              <Polygon POINTS="1150 758 4155 758 4155 864 1150 864"/>
            </Shape>
            <String CONTENT="Но около половины ночи задремали. Спятъ, храпятъ. Какъ вдругъ старуха" HPOS="1150" VPOS="758" WIDTH="3005" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-322_l3" HPOS="1150" VPOS="888" WIDTH="2997" HEIGHT="106" BASELINE="1150 993 4147 993">
            <Shape>
              <Polygon POINTS="1150 888 4147 888 4147 994 1150 994"/>
            </Shape>
            <String CONTENT="услышала шорохъ полозьевъ на дворѣ. Будитъ старика, не можетъ про-" HPOS="1150" VPOS="888" WIDTH="2997" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-322_l4" HPOS="1152" VPOS="1016" WIDTH="2993" HEIGHT="101" BASELINE="1152 1115 4145 1115">
            <Shape>
              <Polygon POINTS="1152 1016 4145 1016 4145 1117 1152 1117"/>
            </Shape>
            <String CONTENT="будить. Опять шорохъ полозьевъ и быстрый топотъ копытъ. Будитъ," HPOS="1152" VPOS="1016" WIDTH="2993" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-322_l5" HPOS="1154" VPOS="1130" WIDTH="2993" HEIGHT="110" BASELINE="1154 1240 4147 1240">
            <Shape>
              <Polygon POINTS="1154 1130 4147 1130 4147 1240 1154 1240"/>
            </Shape>
            <String CONTENT="будитъ, пробудить не можетъ. Въ третій разъ топотъ еще быстрѣе и уже" HPOS="1154" VPOS="1130" WIDTH="2993" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-322_l6" HPOS="1146" VPOS="1261" WIDTH="3004" HEIGHT="100" BASELINE="1146 1360 4150 1360">
            <Shape>
              <Polygon POINTS="1146 1261 4150 1261 4150 1361 1146 1361"/>
            </Shape>
            <String CONTENT="у самой двери. Вотъ, вотъ минетъ. Припала къ старику и укусила его за" HPOS="1146" VPOS="1261" WIDTH="3004" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-322_l7" HPOS="1150" VPOS="1389" WIDTH="2998" HEIGHT="103" BASELINE="1150 1491 4148 1491">
            <Shape>
              <Polygon POINTS="1150 1389 4148 1389 4148 1492 1150 1492"/>
            </Shape>
            <String CONTENT="ухо до крови. «Скорѣй, скорѣй!» Ринулся старикъ изъ шатра, а правый" HPOS="1150" VPOS="1389" WIDTH="2998" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-322_l8" HPOS="1155" VPOS="1512" WIDTH="2991" HEIGHT="102" BASELINE="1155 1614 4146 1614">
            <Shape>
              <Polygon POINTS="1155 1512 4146 1512 4146 1614 1155 1614"/>
            </Shape>
            <String CONTENT="олень уже мимо самого входа пробѣгаетъ. Схватилъ оленей подъ узды." HPOS="1155" VPOS="1512" WIDTH="2991" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-322_l9" HPOS="1158" VPOS="1640" WIDTH="2992" HEIGHT="108" BASELINE="1158 1747 4150 1747">
            <Shape>
              <Polygon POINTS="1158 1640 4150 1640 4150 1748 1158 1748"/>
            </Shape>
            <String CONTENT="Такъ вернулся А́йђынто и привезъ увезеннаго сына. Такъ кончилась первая" HPOS="1158" VPOS="1640" WIDTH="2992" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-322_l10" HPOS="1158" VPOS="1764" WIDTH="2993" HEIGHT="97" BASELINE="1158 1860 4151 1860">
            <Shape>
              <Polygon POINTS="1158 1764 4151 1764 4151 1861 1158 1861"/>
            </Shape>
            <String CONTENT="порча старухи изъ моря. Черезъ нѣсколько времени опять ходятъ ребята" HPOS="1158" VPOS="1764" WIDTH="2993" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-322_l11" HPOS="1165" VPOS="1880" WIDTH="2984" HEIGHT="109" BASELINE="1165 1988 4149 1988">
            <Shape>
              <Polygon POINTS="1165 1880 4149 1880 4149 1989 1165 1989"/>
            </Shape>
            <String CONTENT="около стада, перегоняютъ его съ мѣста на мѣсто. Нашли озерко; на немъ" HPOS="1165" VPOS="1880" WIDTH="2984" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-322_l12" HPOS="1160" VPOS="2002" WIDTH="2987" HEIGHT="109" BASELINE="1160 2110 4147 2110">
            <Shape>
              <Polygon POINTS="1160 2002 4147 2002 4147 2111 1160 2111"/>
            </Shape>
            <String CONTENT="привязанъ челнокъ. «Покатаемся въ этомъ челнокѣ!» говоритъ сынъ А́й-" HPOS="1160" VPOS="2002" WIDTH="2987" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-322_l13" HPOS="1159" VPOS="2098" WIDTH="2990" HEIGHT="145" BASELINE="1159 2242 4149 2242">
            <Shape>
              <Polygon POINTS="1159 2098 4149 2098 4149 2243 1159 2243"/>
            </Shape>
            <String CONTENT="ђынто. «Нѣтъ, нѣтъ, не нужно! Опять, опять! Не нужно!» — «Нѣтъ, я по-" HPOS="1159" VPOS="2098" WIDTH="2990" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-322_l14" HPOS="1160" VPOS="2262" WIDTH="2996" HEIGHT="102" BASELINE="1160 2364 4156 2364">
            <Shape>
              <Polygon POINTS="1160 2262 4156 2262 4156 2364 1160 2364"/>
            </Shape>
            <String CONTENT="катаюсь въ челнокѣ!» Отъѣхалъ отъ берега, опрокинулся, утонулъ. Опять" HPOS="1160" VPOS="2262" WIDTH="2996" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-322_l15" HPOS="1163" VPOS="2383" WIDTH="2985" HEIGHT="106" BASELINE="1163 2488 4148 2488">
            <Shape>
              <Polygon POINTS="1163 2383 4148 2383 4148 2489 1163 2489"/>
            </Shape>
            <String CONTENT="не были три дня дома. Пришли домой, потупивъ голову. «Гдѣ товарищъ?»" HPOS="1163" VPOS="2383" WIDTH="2985" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-322_l16" HPOS="1157" VPOS="2509" WIDTH="2996" HEIGHT="108" BASELINE="1157 2616 4153 2616">
            <Shape>
              <Polygon POINTS="1157 2509 4153 2509 4153 2617 1157 2617"/>
            </Shape>
            <String CONTENT="Какъ прежде разсказываютъ: «Поѣхалъ на челнѣ по озеру, утонулъ.» А́й-" HPOS="1157" VPOS="2509" WIDTH="2996" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-322_l17" HPOS="1159" VPOS="2636" WIDTH="2993" HEIGHT="104" BASELINE="1159 2740 4152 2740">
            <Shape>
              <Polygon POINTS="1159 2636 4152 2636 4152 2740 1159 2740"/>
            </Shape>
            <String CONTENT="ђынто велѣлъ разложить костеръ. Когда разгорѣлся, прыгнулъ въ пламя." HPOS="1159" VPOS="2636" WIDTH="2993" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-322_l18" HPOS="1159" VPOS="2761" WIDTH="3002" HEIGHT="106" BASELINE="1159 2866 4161 2866">
            <Shape>
              <Polygon POINTS="1159 2761 4161 2761 4161 2867 1159 2867"/>
            </Shape>
            <String CONTENT="Ввв! Взвился въ пламени костра. Идетъ, идетъ, идетъ пѣшкомъ, все" HPOS="1159" VPOS="2761" WIDTH="3002" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-322_l19" HPOS="1169" VPOS="2884" WIDTH="2988" HEIGHT="105" BASELINE="1169 2988 4157 2988">
            <Shape>
              <Polygon POINTS="1169 2884 4157 2884 4157 2989 1169 2989"/>
            </Shape>
            <String CONTENT="пѣшкомъ идетъ; въ подземной вселенной. Приходитъ: огромный шатеръ" HPOS="1169" VPOS="2884" WIDTH="2988" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-322_l20" HPOS="1166" VPOS="3004" WIDTH="2987" HEIGHT="110" BASELINE="1166 3114 4153 3114">
            <Shape>
              <Polygon POINTS="1166 3004 4153 3004 4153 3114 1166 3114"/>
            </Shape>
            <String CONTENT="наполненъ людьми. О, страшно дерутся между собой. Трахъ, трахъ, кула-" HPOS="1166" VPOS="3004" WIDTH="2987" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-322_l21" HPOS="1166" VPOS="3136" WIDTH="2987" HEIGHT="102" BASELINE="1166 3237 4153 3237">
            <Shape>
              <Polygon POINTS="1166 3136 4153 3136 4153 3238 1166 3238"/>
            </Shape>
            <String CONTENT="ками по лицу, по головѣ. Кровь течетъ. Грызутся зубами, царапаются" HPOS="1166" VPOS="3136" WIDTH="2987" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-322_l22" HPOS="1166" VPOS="3252" WIDTH="2985" HEIGHT="116" BASELINE="1166 3367 4151 3367">
            <Shape>
              <Polygon POINTS="1166 3252 4151 3252 4151 3368 1166 3368"/>
            </Shape>
            <String CONTENT="когтями. Сынъ привязанъ у стѣны желѣзными узами. Вошелъ А́йђынто." HPOS="1166" VPOS="3252" WIDTH="2985" HEIGHT="116"/>
          </TextLine>
          <TextLine ID="mz_1-322_l23" HPOS="1163" VPOS="3379" WIDTH="2994" HEIGHT="104" BASELINE="1163 3482 4157 3482">
            <Shape>
              <Polygon POINTS="1163 3379 4157 3379 4157 3483 1163 3483"/>
            </Shape>
            <String CONTENT="Его никто не замѣчаетъ. Дерутся люди между собой, — кулаками по го-" HPOS="1163" VPOS="3379" WIDTH="2994" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-322_l24" HPOS="1163" VPOS="3504" WIDTH="2994" HEIGHT="105" BASELINE="1163 3608 4157 3608">
            <Shape>
              <Polygon POINTS="1163 3504 4157 3504 4157 3609 1163 3609"/>
            </Shape>
            <String CONTENT="ловѣ, по лицу. Развязалъ сына, унесъ. Они не замѣтили. Много времени" HPOS="1163" VPOS="3504" WIDTH="2994" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-322_l25" HPOS="1168" VPOS="3623" WIDTH="2987" HEIGHT="111" BASELINE="1168 3734 4155 3734">
            <Shape>
              <Polygon POINTS="1168 3623 4155 3623 4155 3734 1168 3734"/>
            </Shape>
            <String CONTENT="спустя, одинъ замѣтилъ. «А гдѣ парень? Ахъ вы негодные! Упустили" HPOS="1168" VPOS="3623" WIDTH="2987" HEIGHT="111"/>
          </TextLine>
          <TextLine ID="mz_1-322_l26" HPOS="1166" VPOS="3752" WIDTH="2988" HEIGHT="107" BASELINE="1166 3858 4154 3858">
            <Shape>
              <Polygon POINTS="1166 3752 4154 3752 4154 3859 1166 3859"/>
            </Shape>
            <String CONTENT="изъ-за васъ парня!» Еще пуще стали драться. Привезъ опять сына домой." HPOS="1166" VPOS="3752" WIDTH="2988" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-322_l27" HPOS="1157" VPOS="3875" WIDTH="486" HEIGHT="88" BASELINE="1157 3962 1643 3962">
            <Shape>
              <Polygon POINTS="1157 3875 1643 3875 1643 3963 1157 3963"/>
            </Shape>
            <String CONTENT="Стали жить." HPOS="1157" VPOS="3875" WIDTH="486" HEIGHT="88"/>
          </TextLine>
          <TextLine ID="mz_1-322_l28" HPOS="1371" VPOS="4026" WIDTH="2771" HEIGHT="102" BASELINE="1371 4128 4142 4128">
            <Shape>
              <Polygon POINTS="1371 4026 4142 4026 4142 4128 1371 4128"/>
            </Shape>
            <String CONTENT="Записано отъ чукчи кривого Кэўтэ́ђын’а въ деревнѣ Походской въ 1896 г." HPOS="1371" VPOS="4026" WIDTH="2771" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-322_l29" HPOS="2581" VPOS="4352" WIDTH="137" HEIGHT="99" BASELINE="2581 4450 2718 4450">
            <Shape>
              <Polygon POINTS="2581 4352 2718 4352 2718 4451 2581 4451"/>
            </Shape>
            <String CONTENT="99." HPOS="2581" VPOS="4352" WIDTH="137" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-322_l30" HPOS="1755" VPOS="4545" WIDTH="1841" HEIGHT="118" BASELINE="1755 4662 3596 4662">
            <Shape>
              <Polygon POINTS="1755 4545 3596 4545 3596 4663 1755 4663"/>
            </Shape>
            <String CONTENT="У́јwэl-ынпыӈэ́wӄӓј. Старушка съ порчею." HPOS="1755" VPOS="4545" WIDTH="1841" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-322_l31" HPOS="2351" VPOS="4554" WIDTH="81" HEIGHT="83" BASELINE="2351 4636 2432 4636">
            <Shape>
              <Polygon POINTS="2351 4554 2432 4554 2432 4637 2351 4637"/>
            </Shape>
            <String CONTENT="" HPOS="2351" VPOS="4554" WIDTH="81" HEIGHT="83"/>
          </TextLine>
          <TextLine ID="mz_1-322_l32" HPOS="1369" VPOS="4752" WIDTH="2769" HEIGHT="105" BASELINE="1369 4857 4138 4857">
            <Shape>
              <Polygon POINTS="1369 4752 4138 4752 4138 4857 1369 4857"/>
            </Shape>
            <String CONTENT="Былъ человѣкъ съ младшимъ братомъ, у нихъ мать. Жениться со-" HPOS="1369" VPOS="4752" WIDTH="2769" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-322_l33" HPOS="1155" VPOS="4886" WIDTH="2984" HEIGHT="105" BASELINE="1155 4990 4139 4990">
            <Shape>
              <Polygon POINTS="1155 4886 4139 4886 4139 4991 1155 4991"/>
            </Shape>
            <String CONTENT="вершенно отказывается. Приведутъ ему женщину, поспитъ съ ней ночь," HPOS="1155" VPOS="4886" WIDTH="2984" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-322_l34" HPOS="1158" VPOS="5007" WIDTH="2984" HEIGHT="101" BASELINE="1158 5107 4142 5107">
            <Shape>
              <Polygon POINTS="1158 5007 4142 5007 4142 5108 1158 5108"/>
            </Shape>
            <String CONTENT="потомъ отвергаетъ ее, ибо всѣ женщины некрасивы, одноглазы, одинъ" HPOS="1158" VPOS="5007" WIDTH="2984" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-322_l35" HPOS="1153" VPOS="5123" WIDTH="2986" HEIGHT="117" BASELINE="1153 5239 4139 5239">
            <Shape>
              <Polygon POINTS="1153 5123 4139 5123 4139 5240 1153 5240"/>
            </Shape>
            <String CONTENT="глазъ среди лба. Живетъ на полуостровѣ, на землѣ Кӓра́wђэlэн, на краю" HPOS="1153" VPOS="5123" WIDTH="2986" HEIGHT="117"/>
          </TextLine>
          <TextLine ID="mz_1-322_l36" HPOS="1144" VPOS="5252" WIDTH="2996" HEIGHT="107" BASELINE="1144 5357 4140 5357">
            <Shape>
              <Polygon POINTS="1144 5252 4140 5252 4140 5359 1144 5359"/>
            </Shape>
            <String CONTENT="моря, напротивъ многихъ острововъ. Говоритъ ему мать: «Что-же, я" HPOS="1144" VPOS="5252" WIDTH="2996" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-322_l37" HPOS="1155" VPOS="5380" WIDTH="2983" HEIGHT="107" BASELINE="1155 5486 4138 5486">
            <Shape>
              <Polygon POINTS="1155 5380 4138 5380 4138 5487 1155 5487"/>
            </Shape>
            <String CONTENT="старѣюсь, дѣтей у тебя нѣтъ. Или ты совсѣмъ не хочешь жениться, прямо" HPOS="1155" VPOS="5380" WIDTH="2983" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-322_l38" HPOS="1154" VPOS="5467" WIDTH="2982" HEIGHT="145" BASELINE="1154 5611 4136 5611">
            <Shape>
              <Polygon POINTS="1154 5467 4136 5467 4136 5612 1154 5612"/>
            </Shape>
            <String CONTENT="скажи, перестану тебѣ искать.» — «Нѣтъ, я хочу жениться, могу самъ себѣ" HPOS="1154" VPOS="5467" WIDTH="2982" HEIGHT="145"/>
          </TextLine>
          <TextLine ID="mz_1-322_l39" HPOS="1153" VPOS="5626" WIDTH="2989" HEIGHT="111" BASELINE="1153 5737 4142 5737">
            <Shape>
              <Polygon POINTS="1153 5626 4142 5626 4142 5737 1153 5737"/>
            </Shape>
            <String CONTENT="найти. Къ чорту этихъ одноглазыхъ! Ну! десять паръ обуви сдѣлай, туда" HPOS="1153" VPOS="5626" WIDTH="2989" HEIGHT="111"/>
          </TextLine>
        </TextBlock>
      </PrintSpace>
    </Page>
