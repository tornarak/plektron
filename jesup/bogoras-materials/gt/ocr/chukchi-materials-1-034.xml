              <Polygon POINTS="1214 770 4199 770 4199 873 1214 873"/>
            </Shape>
            <String CONTENT="ношеніяхъ, считаются смѣнными товарищами въ бракѣ: Ӈі́тһіlын э́ррі" HPOS="1214" VPOS="770" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-034_l3" HPOS="1215" VPOS="883" WIDTH="2985" HEIGHT="113" BASELINE="1215 995 4200 995">
            <Shape>
              <Polygon POINTS="1215 883 4200 883 4200 996 1215 996"/>
            </Shape>
            <String CONTENT="Тӈа́ырђын ђэӈэ́wту́мђӓ. Въ сказкѣ о сынѣ Муłу́wђі (№ 84) эти товарищи" HPOS="1215" VPOS="883" WIDTH="2985" HEIGHT="113"/>
          </TextLine>
          <TextLine ID="mz_1-034_l4" HPOS="1221" VPOS="1013" WIDTH="2979" HEIGHT="101" BASELINE="1221 1113 4200 1113">
            <Shape>
              <Polygon POINTS="1221 1013 4200 1013 4200 1114 1221 1114"/>
            </Shape>
            <String CONTENT="въ бракѣ изображены въ удивительно грубомъ видѣ. Взявъ въ общія жены" HPOS="1221" VPOS="1013" WIDTH="2979" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-034_l5" HPOS="1217" VPOS="1146" WIDTH="2979" HEIGHT="95" BASELINE="1217 1240 4196 1240">
            <Shape>
              <Polygon POINTS="1217 1146 4196 1146 4196 1241 1217 1241"/>
            </Shape>
            <String CONTENT="дѣвушку они оба ложатся съ нею спать и обнимаютъ ее съ обѣихъ сторонъ." HPOS="1217" VPOS="1146" WIDTH="2979" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-034_l6" HPOS="1219" VPOS="1272" WIDTH="2983" HEIGHT="99" BASELINE="1219 1370 4202 1370">
            <Shape>
              <Polygon POINTS="1219 1272 4202 1272 4202 1371 1219 1371"/>
            </Shape>
            <String CONTENT="Впрочемъ даже и теперь, когда товарищи по смѣшанному браку живутъ" HPOS="1219" VPOS="1272" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-034_l7" HPOS="1217" VPOS="1402" WIDTH="2984" HEIGHT="98" BASELINE="1217 1499 4201 1499">
            <Shape>
              <Polygon POINTS="1217 1402 4201 1402 4201 1500 1217 1500"/>
            </Shape>
            <String CONTENT="на одномъ стойбищѣ, ихъ бракъ принимаетъ форму настоящаго двумуже-" HPOS="1217" VPOS="1402" WIDTH="2984" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-034_l8" HPOS="1219" VPOS="1532" WIDTH="2979" HEIGHT="92" BASELINE="1219 1623 4198 1623">
            <Shape>
              <Polygon POINTS="1219 1532 4198 1532 4198 1624 1219 1624"/>
            </Shape>
            <String CONTENT="ства, хотя такое постоянное сожительство встрѣчается рѣдко и большей" HPOS="1219" VPOS="1532" WIDTH="2979" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-034_l9" HPOS="1219" VPOS="1655" WIDTH="2979" HEIGHT="100" BASELINE="1219 1754 4198 1754">
            <Shape>
              <Polygon POINTS="1219 1655 4198 1655 4198 1755 1219 1755"/>
            </Shape>
            <String CONTENT="частью смѣнный бракъ состоитъ въ томъ, что женатые люди, живущіе на" HPOS="1219" VPOS="1655" WIDTH="2979" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-034_l10" HPOS="1227" VPOS="1782" WIDTH="2969" HEIGHT="97" BASELINE="1227 1878 4196 1878">
            <Shape>
              <Polygon POINTS="1227 1782 4196 1782 4196 1879 1227 1879"/>
            </Shape>
            <String CONTENT="разныхъ стойбищахъ, даютъ другъ другу взаимное право на своихъ женъ," HPOS="1227" VPOS="1782" WIDTH="2969" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-034_l11" HPOS="1223" VPOS="1908" WIDTH="2978" HEIGHT="98" BASELINE="1223 2005 4201 2005">
            <Shape>
              <Polygon POINTS="1223 1908 4201 1908 4201 2006 1223 2006"/>
            </Shape>
            <String CONTENT="которое осуществляется однако не очень часто, только при пріѣздѣ въ" HPOS="1223" VPOS="1908" WIDTH="2978" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-034_l12" HPOS="1216" VPOS="2038" WIDTH="2982" HEIGHT="97" BASELINE="1216 2134 4198 2134">
            <Shape>
              <Polygon POINTS="1216 2038 4198 2038 4198 2135 1216 2135"/>
            </Shape>
            <String CONTENT="гости, при встрѣчахъ на праздникахъ и т. п. Такой бракъ по чукот-" HPOS="1216" VPOS="2038" WIDTH="2982" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-034_l13" HPOS="1215" VPOS="2165" WIDTH="2983" HEIGHT="94" BASELINE="1215 2258 4198 2258">
            <Shape>
              <Polygon POINTS="1215 2165 4198 2165 4198 2259 1215 2259"/>
            </Shape>
            <String CONTENT="скимъ понятіямъ требуетъ прежде всего взаимности и отказъ въ ней счи-" HPOS="1215" VPOS="2165" WIDTH="2983" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-034_l14" HPOS="1213" VPOS="2273" WIDTH="2988" HEIGHT="115" BASELINE="1213 2387 4201 2387">
            <Shape>
              <Polygon POINTS="1213 2273 4201 2273 4201 2388 1213 2388"/>
            </Shape>
            <String CONTENT="тается тяжелымъ оскорбленіемъ. Такъ въ № 119 человѣкъ, пришедшій въ" HPOS="1213" VPOS="2273" WIDTH="2988" HEIGHT="115"/>
          </TextLine>
          <TextLine ID="mz_1-034_l15" HPOS="1214" VPOS="2421" WIDTH="2990" HEIGHT="94" BASELINE="1214 2514 4204 2514">
            <Shape>
              <Polygon POINTS="1214 2421 4204 2421 4204 2515 1214 2515"/>
            </Shape>
            <String CONTENT="гости къ волкамъ и вступившій съ ними въ такую брачную связь, потомъ" HPOS="1214" VPOS="2421" WIDTH="2990" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-034_l16" HPOS="1213" VPOS="2540" WIDTH="2987" HEIGHT="101" BASELINE="1213 2640 4200 2640">
            <Shape>
              <Polygon POINTS="1213 2540 4200 2540 4200 2641 1213 2641"/>
            </Shape>
            <String CONTENT="убиваетъ свою жену, чтобы не быть принужденнымъ допустить къ ней" HPOS="1213" VPOS="2540" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-034_l17" HPOS="1217" VPOS="2673" WIDTH="2983" HEIGHT="97" BASELINE="1217 2769 4200 2769">
            <Shape>
              <Polygon POINTS="1217 2673 4200 2673 4200 2770 1217 2770"/>
            </Shape>
            <String CONTENT="волка, и оскорбленные волки изгоняютъ его. Двоемужество кромѣ сказокъ" HPOS="1217" VPOS="2673" WIDTH="2983" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-034_l18" HPOS="1214" VPOS="2763" WIDTH="2988" HEIGHT="131" BASELINE="1214 2893 4202 2893">
            <Shape>
              <Polygon POINTS="1214 2763 4202 2763 4202 2894 1214 2894"/>
            </Shape>
            <String CONTENT="встрѣчается также и въ преданіяхъ. Напр. въ № 136 А̂́ттымlу̂ живетъ на" HPOS="1214" VPOS="2763" WIDTH="2988" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-034_l19" HPOS="1214" VPOS="2894" WIDTH="2987" HEIGHT="131" BASELINE="1214 3024 4201 3024">
            <Shape>
              <Polygon POINTS="1214 2894 4201 2894 4201 3025 1214 3025"/>
            </Shape>
            <String CONTENT="одномъ стойбищѣ вмѣстѣ со своимъ ӈэw-ту́мђын’омъ Эlэ́ннут. Въ № 138" HPOS="1214" VPOS="2894" WIDTH="2987" HEIGHT="131"/>
          </TextLine>
          <TextLine ID="mz_1-034_l20" HPOS="1219" VPOS="3053" WIDTH="2981" HEIGHT="98" BASELINE="1219 3150 4200 3150">
            <Shape>
              <Polygon POINTS="1219 3053 4200 3053 4200 3151 1219 3151"/>
            </Shape>
            <String CONTENT="пять братьевъ женоотнимателей являются похищать одну женщину и, судя" HPOS="1219" VPOS="3053" WIDTH="2981" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-034_l21" HPOS="1221" VPOS="3174" WIDTH="2366" HEIGHT="96" BASELINE="1221 3269 3587 3269">
            <Shape>
              <Polygon POINTS="1221 3174 3587 3174 3587 3270 1221 3270"/>
            </Shape>
            <String CONTENT="по ихъ поведенію, желаютъ сдѣлать ее своей общей женой." HPOS="1221" VPOS="3174" WIDTH="2366" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-034_l22" HPOS="1425" VPOS="3253" WIDTH="2774" HEIGHT="118" BASELINE="1425 3370 4199 3370">
            <Shape>
              <Polygon POINTS="1425 3253 4199 3253 4199 3371 1425 3371"/>
            </Shape>
            <String CONTENT="Въ вышеупомянутой сказкѣ № 84 Разсвѣтъ и Вечерній Свѣтъ кромѣ" HPOS="1425" VPOS="3253" WIDTH="2774" HEIGHT="118"/>
          </TextLine>
          <TextLine ID="mz_1-034_l23" HPOS="1212" VPOS="3396" WIDTH="2984" HEIGHT="105" BASELINE="1212 3500 4196 3500">
            <Shape>
              <Polygon POINTS="1212 3396 4196 3396 4196 3501 1212 3501"/>
            </Shape>
            <String CONTENT="того не изображены могущественными. Молодой шаманъ, сынъ Муłу́wђі," HPOS="1212" VPOS="3396" WIDTH="2984" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-034_l24" HPOS="1217" VPOS="3523" WIDTH="2981" HEIGHT="90" BASELINE="1217 3612 4198 3612">
            <Shape>
              <Polygon POINTS="1217 3523 4198 3523 4198 3613 1217 3613"/>
            </Shape>
            <String CONTENT="легко обманываетъ и побѣждаетъ ихъ обоихъ. Точно также въ сказкѣ объ" HPOS="1217" VPOS="3523" WIDTH="2981" HEIGHT="90"/>
          </TextLine>
          <TextLine ID="mz_1-034_l25" HPOS="1215" VPOS="3651" WIDTH="2985" HEIGHT="103" BASELINE="1215 3754 4200 3754">
            <Shape>
              <Polygon POINTS="1215 3651 4200 3651 4200 3754 1215 3754"/>
            </Shape>
            <String CONTENT="Аттыђы́ткы молодой шаманъ побѣждаетъ цѣлую серію противниковъ:" HPOS="1215" VPOS="3651" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-034_l26" HPOS="1219" VPOS="3777" WIDTH="2981" HEIGHT="103" BASELINE="1219 3880 4200 3880">
            <Shape>
              <Polygon POINTS="1219 3777 4200 3777 4200 3880 1219 3880"/>
            </Shape>
            <String CONTENT="Солнце, Мѣсяцъ, Небо, Море, Разсвѣтъ, Тьму, Вселенную и беретъ въ" HPOS="1219" VPOS="3777" WIDTH="2981" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-034_l27" HPOS="1214" VPOS="3897" WIDTH="1191" HEIGHT="105" BASELINE="1214 4001 2405 4001">
            <Shape>
              <Polygon POINTS="1214 3897 2405 3897 2405 4002 1214 4002"/>
            </Shape>
            <String CONTENT="жены дочь Ну́тэнут’а (Земли)." HPOS="1214" VPOS="3897" WIDTH="1191" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-034_l28" HPOS="1424" VPOS="4028" WIDTH="2779" HEIGHT="106" BASELINE="1424 4134 4203 4134">
            <Shape>
              <Polygon POINTS="1424 4028 4203 4028 4203 4134 1424 4134"/>
            </Shape>
            <String CONTENT="Помимо общихъ представленій о Ӈа́рђынен и Ја́јвач-ва́ырђын вся" HPOS="1424" VPOS="4028" WIDTH="2779" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-034_l29" HPOS="1218" VPOS="4153" WIDTH="2980" HEIGHT="99" BASELINE="1218 4251 4198 4251">
            <Shape>
              <Polygon POINTS="1218 4153 4198 4153 4198 4252 1218 4252"/>
            </Shape>
            <String CONTENT="внѣшняя природа представляется чукчамъ живою и олицетворенной, при-" HPOS="1218" VPOS="4153" WIDTH="2980" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-034_l30" HPOS="1215" VPOS="4281" WIDTH="2983" HEIGHT="99" BASELINE="1215 4379 4198 4379">
            <Shape>
              <Polygon POINTS="1215 4281 4198 4281 4198 4380 1215 4380"/>
            </Shape>
            <String CONTENT="чемъ отдѣльные предметы олицетворяясь не теряютъ связи съ свой на-" HPOS="1215" VPOS="4281" WIDTH="2983" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-034_l31" HPOS="1217" VPOS="4406" WIDTH="2985" HEIGHT="103" BASELINE="1217 4509 4202 4509">
            <Shape>
              <Polygon POINTS="1217 4406 4202 4406 4202 4509 1217 4509"/>
            </Shape>
            <String CONTENT="стоящей матеріальной природой. Напр. «люди лѣса» (у́тты-рэ́мкын) боятся" HPOS="1217" VPOS="4406" WIDTH="2985" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-034_l32" HPOS="1219" VPOS="4534" WIDTH="2979" HEIGHT="105" BASELINE="1219 4639 4198 4639">
            <Shape>
              <Polygon POINTS="1219 4534 4198 4534 4198 4639 1219 4639"/>
            </Shape>
            <String CONTENT="огня, который можетъ ихъ сжечь. Шаманъ Кора́wђе такъ опредѣлялъ мнѣ" HPOS="1219" VPOS="4534" WIDTH="2979" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-034_l33" HPOS="1217" VPOS="4663" WIDTH="2979" HEIGHT="102" BASELINE="1217 4765 4196 4765">
            <Shape>
              <Polygon POINTS="1217 4663 4196 4663 4196 4765 1217 4765"/>
            </Shape>
            <String CONTENT="эту жизнь природы: «Въ рѣчномъ яру живетъ человѣкъ, голосъ тамъ суще-" HPOS="1217" VPOS="4663" WIDTH="2979" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-034_l34" HPOS="1217" VPOS="4796" WIDTH="2981" HEIGHT="93" BASELINE="1217 4889 4198 4889">
            <Shape>
              <Polygon POINTS="1217 4796 4198 4796 4198 4889 1217 4889"/>
            </Shape>
            <String CONTENT="ствуетъ и говоритъ. Маленькая сѣрая плиска съ синей грудью шаманитъ," HPOS="1217" VPOS="4796" WIDTH="2981" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-034_l35" HPOS="1217" VPOS="4921" WIDTH="2982" HEIGHT="95" BASELINE="1217 5015 4199 5015">
            <Shape>
              <Polygon POINTS="1217 4921 4199 4921 4199 5016 1217 5016"/>
            </Shape>
            <String CONTENT="сидя въ углу между сукомъ и стволомъ. Дерево дрожитъ и плачетъ подъ" HPOS="1217" VPOS="4921" WIDTH="2982" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-034_l36" HPOS="1214" VPOS="5052" WIDTH="2985" HEIGHT="94" BASELINE="1214 5145 4199 5145">
            <Shape>
              <Polygon POINTS="1214 5052 4199 5052 4199 5146 1214 5146"/>
            </Shape>
            <String CONTENT="ударами топора, какъ бубенъ подъ колотушкой ... Все сущее живетъ;" HPOS="1214" VPOS="5052" WIDTH="2985" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-034_l37" HPOS="1219" VPOS="5173" WIDTH="2981" HEIGHT="101" BASELINE="1219 5274 4200 5274">
            <Shape>
              <Polygon POINTS="1219 5173 4200 5173 4200 5274 1219 5274"/>
            </Shape>
            <String CONTENT="лампа ходитъ, стѣны дома имѣютъ свой голосъ, и даже урильникъ имѣетъ" HPOS="1219" VPOS="5173" WIDTH="2981" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-034_l38" HPOS="1221" VPOS="5299" WIDTH="2980" HEIGHT="104" BASELINE="1221 5402 4201 5402">
            <Shape>
              <Polygon POINTS="1221 5299 4201 5299 4201 5403 1221 5403"/>
            </Shape>
            <String CONTENT="свою собственную страну, и шатеръ и жену и дѣтей; шкуры, лежащія въ" HPOS="1221" VPOS="5299" WIDTH="2980" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-034_l39" HPOS="1218" VPOS="5429" WIDTH="2983" HEIGHT="96" BASELINE="1218 5525 4201 5525">
            <Shape>
              <Polygon POINTS="1218 5429 4201 5429 4201 5525 1218 5525"/>
            </Shape>
            <String CONTENT="мѣшкахъ, разговариваютъ по ночамъ. Рога на могилахъ ходятъ обозомъ" HPOS="1218" VPOS="5429" WIDTH="2983" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-034_l40" HPOS="1219" VPOS="5554" WIDTH="2983" HEIGHT="105" BASELINE="1219 5658 4202 5658">
            <Shape>
              <Polygon POINTS="1219 5554 4202 5554 4202 5659 1219 5659"/>
            </Shape>
            <String CONTENT="вокругъ могилъ и сами покойники встаютъ и приходятъ къ живымъ» (№ 144;" HPOS="1219" VPOS="5554" WIDTH="2983" HEIGHT="105"/>
          </TextLine>
