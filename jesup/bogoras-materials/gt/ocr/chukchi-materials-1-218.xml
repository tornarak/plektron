            <Shape>
              <Polygon POINTS="1166 876 4157 876 4157 978 1166 978"/>
            </Shape>
            <String CONTENT="въ темнотѣ всѣ вселенныя. Ибо всѣ свѣтила обобралъ воронъ. Стадо раз-" HPOS="1166" VPOS="876" WIDTH="2991" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-218_l5" HPOS="1170" VPOS="1005" WIDTH="2987" HEIGHT="100" BASELINE="1170 1104 4157 1104">
            <Shape>
              <Polygon POINTS="1170 1005 4157 1005 4157 1105 1170 1105"/>
            </Shape>
            <String CONTENT="билось въ стороны; волкъ, ходя при стадѣ, пришелъ къ дому, входъ кото-" HPOS="1170" VPOS="1005" WIDTH="2987" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-218_l6" HPOS="1170" VPOS="1127" WIDTH="2983" HEIGHT="101" BASELINE="1170 1227 4153 1227">
            <Shape>
              <Polygon POINTS="1170 1127 4153 1127 4153 1228 1170 1228"/>
            </Shape>
            <String CONTENT="раго былъ плотно закрытъ; но сквозь дырочку немножко свѣтится. Гово-" HPOS="1170" VPOS="1127" WIDTH="2983" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-218_l7" HPOS="1170" VPOS="1250" WIDTH="2989" HEIGHT="105" BASELINE="1170 1354 4159 1354">
            <Shape>
              <Polygon POINTS="1170 1250 4159 1250 4159 1355 1170 1355"/>
            </Shape>
            <String CONTENT="ритъ Ку́ркыl: «Да ты шутишь! Но вѣдь получше (меня) ты живешь; у" HPOS="1170" VPOS="1250" WIDTH="2989" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-218_l8" HPOS="1172" VPOS="1379" WIDTH="2985" HEIGHT="91" BASELINE="1172 1469 4157 1469">
            <Shape>
              <Polygon POINTS="1172 1379 4157 1379 4157 1470 1172 1470"/>
            </Shape>
            <String CONTENT="тебя есть стадо! Вселенныя — мои издѣлія. Зачѣмъ обо мнѣ такъ сказалъ," HPOS="1172" VPOS="1379" WIDTH="2985" HEIGHT="91"/>
          </TextLine>
          <TextLine ID="mz_1-218_l9" HPOS="1172" VPOS="1502" WIDTH="2989" HEIGHT="108" BASELINE="1172 1610 4161 1610">
            <Shape>
              <Polygon POINTS="1172 1502 4161 1502 4161 1610 1172 1610"/>
            </Shape>
            <String CONTENT="ты?» Говоритъ волкъ: «Ну, когда-же тебѣ убить оленей? Освѣти вселен-" HPOS="1172" VPOS="1502" WIDTH="2989" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-218_l10" HPOS="1172" VPOS="1585" WIDTH="2986" HEIGHT="146" BASELINE="1172 1730 4158 1730">
            <Shape>
              <Polygon POINTS="1172 1585 4158 1585 4158 1731 1172 1731"/>
            </Shape>
            <String CONTENT="ныя!» — «Не надо!» — «Освѣти вселенныя; пополамъ разобью стадо!» — «Не" HPOS="1172" VPOS="1585" WIDTH="2986" HEIGHT="146"/>
          </TextLine>
          <TextLine ID="mz_1-218_l11" HPOS="1171" VPOS="1746" WIDTH="2892" HEIGHT="114" BASELINE="1171 1860 4063 1860">
            <Shape>
              <Polygon POINTS="1171 1746 4063 1746 4063 1860 1171 1860"/>
            </Shape>
            <String CONTENT="надо!» — «Черносережныя двѣ сестры (у меня), возьми за себя замужъ!»" HPOS="1171" VPOS="1746" WIDTH="2892" HEIGHT="114"/>
          </TextLine>
          <TextLine ID="mz_1-218_l12" HPOS="1169" VPOS="1875" WIDTH="2997" HEIGHT="109" BASELINE="1169 1983 4166 1983">
            <Shape>
              <Polygon POINTS="1169 1875 4166 1875 4166 1984 1169 1984"/>
            </Shape>
            <String CONTENT="«Ну», говоритъ, «ладно; такъ согласенъ!» Всѣ звѣзды, и солнце, и луну" HPOS="1169" VPOS="1875" WIDTH="2997" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-218_l13" HPOS="1171" VPOS="2010" WIDTH="2993" HEIGHT="99" BASELINE="1171 2108 4164 2108">
            <Shape>
              <Polygon POINTS="1171 2010 4164 2010 4164 2109 1171 2109"/>
            </Shape>
            <String CONTENT="отнесъ на старое мѣсто. Домой вернулся. Говоритъ сестра сестрѣ: «Если" HPOS="1171" VPOS="2010" WIDTH="2993" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-218_l14" HPOS="1173" VPOS="2133" WIDTH="2990" HEIGHT="102" BASELINE="1173 2235 4163 2235">
            <Shape>
              <Polygon POINTS="1173 2133 4163 2133 4163 2235 1173 2235"/>
            </Shape>
            <String CONTENT="воронъ пріѣдетъ, завяжемъ ему языкъ!» Пришелъ воронъ. «Выходите," HPOS="1173" VPOS="2133" WIDTH="2990" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-218_l15" HPOS="1166" VPOS="2253" WIDTH="2996" HEIGHT="106" BASELINE="1166 2358 4162 2358">
            <Shape>
              <Polygon POINTS="1166 2253 4162 2253 4162 2359 1166 2359"/>
            </Shape>
            <String CONTENT="дѣвки, пришелъ я!» Вышли, говорятъ: «Ку́ркыl! покажи языкъ!» Только" HPOS="1166" VPOS="2253" WIDTH="2996" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-218_l16" HPOS="1170" VPOS="2388" WIDTH="2989" HEIGHT="100" BASELINE="1170 2487 4159 2487">
            <Shape>
              <Polygon POINTS="1170 2388 4159 2388 4159 2488 1170 2488"/>
            </Shape>
            <String CONTENT="высунулъ, ниткой обернули и обвязали. Говорятъ: «Втяни языкъ!» Втянулъ," HPOS="1170" VPOS="2388" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-218_l17" HPOS="1176" VPOS="2513" WIDTH="2984" HEIGHT="104" BASELINE="1176 2616 4160 2616">
            <Shape>
              <Polygon POINTS="1176 2513 4160 2513 4160 2617 1176 2617"/>
            </Shape>
            <String CONTENT="но ниткой завязано. Говорятъ: «Войди, Ку́ркыl, въ пологъ!» Легъ вмѣстѣ," HPOS="1176" VPOS="2513" WIDTH="2984" HEIGHT="104"/>
          </TextLine>
          <TextLine ID="mz_1-218_l18" HPOS="1173" VPOS="2635" WIDTH="2986" HEIGHT="107" BASELINE="1173 2741 4159 2741">
            <Shape>
              <Polygon POINTS="1173 2635 4159 2635 4159 2742 1173 2742"/>
            </Shape>
            <String CONTENT="легли и дѣвушки. На завтра дѣвушекъ покинулъ, вернулся къ первой женѣ." HPOS="1173" VPOS="2635" WIDTH="2986" HEIGHT="107"/>
          </TextLine>
          <TextLine ID="mz_1-218_l19" HPOS="1170" VPOS="2764" WIDTH="2738" HEIGHT="99" BASELINE="1170 2862 3908 2862">
            <Shape>
              <Polygon POINTS="1170 2764 3908 2764 3908 2863 1170 2863"/>
            </Shape>
            <String CONTENT="Языкъ развязать не могъ и совсѣмъ потерялъ способность говорить." HPOS="1170" VPOS="2764" WIDTH="2738" HEIGHT="99"/>
          </TextLine>
