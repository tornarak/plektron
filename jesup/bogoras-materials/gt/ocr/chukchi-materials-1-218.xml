          <TextLine ID="mz_1-218_l24" HPOS="1384" VPOS="3693" WIDTH="2785" HEIGHT="99" BASELINE="1384 3791 4169 3791">
            <Shape>
              <Polygon POINTS="1384 3693 4169 3693 4169 3792 1384 3792"/>
            </Shape>
            <String CONTENT="Нѣкогда солнца и звѣздъ не было и разсвѣта не было. Кэ́lє спряталъ" HPOS="1384" VPOS="3693" WIDTH="2785" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-218_l25" HPOS="1181" VPOS="3817" WIDTH="2984" HEIGHT="99" BASELINE="1181 3915 4165 3915">
            <Shape>
              <Polygon POINTS="1181 3817 4165 3817 4165 3916 1181 3916"/>
            </Shape>
            <String CONTENT="и солнце и звѣзды. Одна ребячья мака¹) висѣла вверху. Воронъ унесъ ее." HPOS="1181" VPOS="3817" WIDTH="2984" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-218_l26" HPOS="1189" VPOS="3935" WIDTH="2984" HEIGHT="106" BASELINE="1189 4041 4173 4041">
            <Shape>
              <Polygon POINTS="1189 3935 4173 3935 4173 4041 1189 4041"/>
            </Shape>
            <String CONTENT="Женщина сказала: «Почему этотъ воронъ не дѣлаетъ вселенной, а уноситъ" HPOS="1189" VPOS="3935" WIDTH="2984" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-218_l27" HPOS="1186" VPOS="4070" WIDTH="2983" HEIGHT="95" BASELINE="1186 4164 4169 4164">
            <Shape>
              <Polygon POINTS="1186 4070 4169 4070 4169 4165 1186 4165"/>
            </Shape>
            <String CONTENT="развѣшанныя вещи, негодный?» Куропатка и зимушка сказали ворону:" HPOS="1186" VPOS="4070" WIDTH="2983" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-218_l28" HPOS="1188" VPOS="4184" WIDTH="2986" HEIGHT="108" BASELINE="1188 4291 4174 4291">
            <Shape>
              <Polygon POINTS="1188 4184 4174 4184 4174 4292 1188 4292"/>
            </Shape>
            <String CONTENT="«Ну, отправимся!» Сдѣлали зарю, куропатка и зимушка. Носъ куропатки" HPOS="1188" VPOS="4184" WIDTH="2986" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-218_l29" HPOS="1187" VPOS="4315" WIDTH="2984" HEIGHT="96" BASELINE="1187 4410 4171 4410">
            <Shape>
              <Polygon POINTS="1187 4315 4171 4315 4171 4411 1187 4411"/>
            </Shape>
            <String CONTENT="на срединѣ работы изломался. Отъ того ея носъ сталъ очень коротокъ;" HPOS="1187" VPOS="4315" WIDTH="2984" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-218_l30" HPOS="1184" VPOS="4428" WIDTH="2985" HEIGHT="108" BASELINE="1184 4535 4169 4535">
            <Shape>
              <Polygon POINTS="1184 4428 4169 4428 4169 4536 1184 4536"/>
            </Shape>
            <String CONTENT="раньше былъ довольно длинный. Потомъ сказалъ воронъ зимушкѣ: «Ну, ты" HPOS="1184" VPOS="4428" WIDTH="2985" HEIGHT="108"/>
          </TextLine>
          <TextLine ID="mz_1-218_l31" HPOS="1186" VPOS="4563" WIDTH="2987" HEIGHT="93" BASELINE="1186 4655 4173 4655">
            <Shape>
              <Polygon POINTS="1186 4563 4173 4563 4173 4656 1186 4656"/>
            </Shape>
            <String CONTENT="теперь!» Стала долбить; тоже изломала носъ; сталъ весьма коротенькій" HPOS="1186" VPOS="4563" WIDTH="2987" HEIGHT="93"/>
          </TextLine>
          <TextLine ID="mz_1-218_l32" HPOS="1189" VPOS="4680" WIDTH="2987" HEIGHT="101" BASELINE="1189 4780 4176 4780">
            <Shape>
              <Polygon POINTS="1189 4680 4176 4680 4176 4781 1189 4781"/>
            </Shape>
            <String CONTENT="носикъ. Воронъ сказалъ: «Ну, я теперь!» Дважды клюнулъ, пробилъ. Раз-" HPOS="1189" VPOS="4680" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-218_l33" HPOS="1191" VPOS="4804" WIDTH="2987" HEIGHT="101" BASELINE="1191 4904 4178 4904">
            <Shape>
              <Polygon POINTS="1191 4804 4178 4804 4178 4905 1191 4905"/>
            </Shape>
            <String CONTENT="свѣтъ брызнулъ; воронъ ушелъ впередъ. Увидѣлъ домъ Кэ́lє, качающійся" HPOS="1191" VPOS="4804" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-218_l34" HPOS="1191" VPOS="4926" WIDTH="2991" HEIGHT="103" BASELINE="1191 5028 4182 5028">
            <Shape>
              <Polygon POINTS="1191 4926 4182 4926 4182 5029 1191 5029"/>
            </Shape>
            <String CONTENT="домъ; дымъ высится надъ трубой. Говоритъ дому: «Почему качаешься?" HPOS="1191" VPOS="4926" WIDTH="2991" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-218_l35" HPOS="1191" VPOS="5058" WIDTH="2989" HEIGHT="100" BASELINE="1191 5157 4180 5157">
            <Shape>
              <Polygon POINTS="1191 5058 4180 5058 4180 5158 1191 5158"/>
            </Shape>
            <String CONTENT="Будь неподвиженъ!» Сталъ неподвиженъ. Дѣвочка въ шатрѣ играетъ въ" HPOS="1191" VPOS="5058" WIDTH="2989" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-218_l36" HPOS="1408" VPOS="5297" WIDTH="2772" HEIGHT="109" BASELINE="1408 5405 4180 5405">
            <Shape>
              <Polygon POINTS="1408 5297 4180 5297 4180 5406 1408 5406"/>
            </Shape>
            <String CONTENT="1) Ма́кы, у русскихъ колымчанъ «ма́ка» — клапанъ дѣтской одежды, подвя-" HPOS="1408" VPOS="5297" WIDTH="2772" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-218_l37" HPOS="1193" VPOS="5434" WIDTH="2986" HEIGHT="94" BASELINE="1193 5527 4179 5527">
            <Shape>
              <Polygon POINTS="1193 5434 4179 5434 4179 5528 1193 5528"/>
            </Shape>
            <String CONTENT="зываемый снизу. Въ неисправномъ состояніи концы его волочатся сзади по землѣ." HPOS="1193" VPOS="5434" WIDTH="2986" HEIGHT="94"/>
          </TextLine>
          <TextLine ID="mz_1-218_l38" HPOS="1195" VPOS="5549" WIDTH="2987" HEIGHT="86" BASELINE="1195 5635 4182 5635">
            <Shape>
              <Polygon POINTS="1195 5549 4182 5549 4182 5635 1195 5635"/>
            </Shape>
            <String CONTENT="Поэтому о маленькихъ дѣтяхъ для опредѣленія возраста русскіе и чукчи говорятъ," HPOS="1195" VPOS="5549" WIDTH="2987" HEIGHT="86"/>
          </TextLine>
          <TextLine ID="mz_1-218_l39" HPOS="1191" VPOS="5668" WIDTH="1050" HEIGHT="76" BASELINE="1191 5743 2241 5743">
            <Shape>
              <Polygon POINTS="1191 5668 2241 5668 2241 5744 1191 5744"/>
            </Shape>
