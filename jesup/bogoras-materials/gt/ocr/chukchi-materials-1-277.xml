            </Shape>
            <String CONTENT="пыну шаману, пусть придетъ завтра; увидимся, станемъ что-нибудь" HPOS="635" VPOS="1659" WIDTH="2980" HEIGHT="96"/>
          </TextLine>
          <TextLine ID="mz_1-277_l10" HPOS="631" VPOS="1727" WIDTH="2981" HEIGHT="153" BASELINE="631 1879 3612 1879">
            <Shape>
              <Polygon POINTS="631 1727 3612 1727 3612 1880 631 1880"/>
            </Shape>
            <String CONTENT="дѣлать!» — «Скажу, скажу! А куда придти?» — «Пусть сюда!» Полетѣлъ къ" HPOS="631" VPOS="1727" WIDTH="2981" HEIGHT="153"/>
          </TextLine>
