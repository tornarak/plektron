            </Shape>
            <String CONTENT="женѣ, до вечера долетѣлъ домой. Говоритъ женѣ: «Видѣлъ сожителя Ку-" HPOS="631" VPOS="1903" WIDTH="2983" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-277_l13" HPOS="639" VPOS="1986" WIDTH="2976" HEIGHT="146" BASELINE="639 2131 3615 2131">
