            </Shape>
            <String CONTENT="всталъ до свѣту, обернулся мышеловкой, полетѣлъ до Поутына, сѣлъ на" HPOS="636" VPOS="2156" WIDTH="2980" HEIGHT="102"/>
          </TextLine>
          <TextLine ID="mz_1-277_l15" HPOS="629" VPOS="2271" WIDTH="2984" HEIGHT="112" BASELINE="629 2383 3613 2383">
