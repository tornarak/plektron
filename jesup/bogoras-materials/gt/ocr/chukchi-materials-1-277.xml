            </Shape>
            <String CONTENT="Кукульпынъ, говоритъ неправду, обманываетъ. «Э-э! Скажи же Кукуль-" HPOS="627" VPOS="1525" WIDTH="2985" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-277_l9" HPOS="635" VPOS="1659" WIDTH="2980" HEIGHT="96" BASELINE="635 1754 3615 1754">
