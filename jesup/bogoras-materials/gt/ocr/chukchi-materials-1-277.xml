            </Shape>
            <String CONTENT="кекуръ. Кукульпынъ пришелъ изъ-подъ земли, говоритъ: «Ты хотѣлъ" HPOS="629" VPOS="2271" WIDTH="2984" HEIGHT="112"/>
          </TextLine>
