            </Shape>
            <String CONTENT="дѣлать? Попробуемъ!»... — «Э-эй!» — «Ну, хочешь пробовать, поборись съ" HPOS="624" VPOS="2496" WIDTH="2988" HEIGHT="138"/>
          </TextLine>
