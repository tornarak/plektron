            <Shape>
              <Polygon POINTS="634 3747 3494 3747 3494 3875 634 3875"/>
            </Shape>
            <String CONTENT="«А гдѣ твой домъ?» — «На Тяпкѣ». — «Отсюда ты когда доходишь?» —" HPOS="634" VPOS="3747" WIDTH="2860" HEIGHT="128"/>
          </TextLine>
          <TextLine ID="mz_1-277_l28" HPOS="634" VPOS="3881" WIDTH="2985" HEIGHT="141" BASELINE="634 4021 3619 4021">
            <Shape>
              <Polygon POINTS="634 3881 3619 3881 3619 4022 634 4022"/>
            </Shape>
            <String CONTENT="«Около полудня дохожу.» — «А! А! Мой все-таки ближе, — лучше пойдемъ" HPOS="634" VPOS="3881" WIDTH="2985" HEIGHT="141"/>
          </TextLine>
          <TextLine ID="mz_1-277_l29" HPOS="634" VPOS="4021" WIDTH="2990" HEIGHT="126" BASELINE="634 4146 3624 4146">
            <Shape>
              <Polygon POINTS="634 4021 3624 4021 3624 4147 634 4147"/>
            </Shape>
            <String CONTENT="ко мнѣ!» — «Согласенъ.» — «Мои двѣ жены дома; пустимся въ запуски: кто" HPOS="634" VPOS="4021" WIDTH="2990" HEIGHT="126"/>
          </TextLine>
          <TextLine ID="mz_1-277_l30" HPOS="639" VPOS="4147" WIDTH="2983" HEIGHT="136" BASELINE="639 4283 3622 4283">
            <Shape>
              <Polygon POINTS="639 4147 3622 4147 3622 4283 639 4283"/>
            </Shape>
            <String CONTENT="прежде дойдетъ, тотъ пусть спитъ съ ними.» — «Эђэ́й!» — «Ты какого-же" HPOS="639" VPOS="4147" WIDTH="2983" HEIGHT="136"/>
          </TextLine>
          <TextLine ID="mz_1-277_l31" HPOS="631" VPOS="4253" WIDTH="2994" HEIGHT="151" BASELINE="631 4403 3625 4403">
            <Shape>
              <Polygon POINTS="631 4253 3625 4253 3625 4404 631 4404"/>
            </Shape>
            <String CONTENT="Кэ́lє употребишь на путешествіе ко мнѣ?» — «Духа-Мышеловку³).» — «Да?" HPOS="631" VPOS="4253" WIDTH="2994" HEIGHT="151"/>
          </TextLine>
          <TextLine ID="mz_1-277_l32" HPOS="634" VPOS="4421" WIDTH="2989" HEIGHT="110" BASELINE="634 4530 3623 4530">
            <Shape>
              <Polygon POINTS="634 4421 3623 4421 3623 4531 634 4531"/>
            </Shape>
            <String CONTENT="Ну!» Стали рядомъ. «Тоок!» Обернулся мышеловкой; взвился, полетѣлъ." HPOS="634" VPOS="4421" WIDTH="2989" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-277_l33" HPOS="638" VPOS="4556" WIDTH="2988" HEIGHT="101" BASELINE="638 4657 3626 4657">
            <Shape>
              <Polygon POINTS="638 4556 3626 4556 3626 4657 638 4657"/>
            </Shape>
            <String CONTENT="Кукульпынъ стоитъ на скалѣ, только приговариваетъ: «Како́, како́, како́!»" HPOS="638" VPOS="4556" WIDTH="2988" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-277_l34" HPOS="637" VPOS="4681" WIDTH="2989" HEIGHT="97" BASELINE="637 4778 3626 4778">
            <Shape>
              <Polygon POINTS="637 4681 3626 4681 3626 4778 637 4778"/>
            </Shape>
            <String CONTENT="Потомъ говоритъ самъ съ собой: «Если полечу по воздуху, не догоню." HPOS="637" VPOS="4681" WIDTH="2989" HEIGHT="97"/>
          </TextLine>
          <TextLine ID="mz_1-277_l35" HPOS="640" VPOS="4808" WIDTH="2993" HEIGHT="99" BASELINE="640 4906 3633 4906">
