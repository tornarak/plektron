              <Polygon POINTS="632 2348 3613 2348 3613 2492 632 2492"/>
            </Shape>
            <String CONTENT="видѣть Кукульпына?» — «Э-э!» — «Ну, я Кукульпынъ; чтоже станемъ" HPOS="632" VPOS="2348" WIDTH="2981" HEIGHT="144"/>
          </TextLine>
          <TextLine ID="mz_1-277_l17" HPOS="624" VPOS="2496" WIDTH="2988" HEIGHT="138" BASELINE="624 2633 3612 2633">
