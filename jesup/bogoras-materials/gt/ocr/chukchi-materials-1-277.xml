            </Shape>
            <String CONTENT="кульпына, говоритъ: „Скажу, пусть завтра придетъ‘». — «Э-эй!» На завтра" HPOS="639" VPOS="1986" WIDTH="2976" HEIGHT="146"/>
          </TextLine>
