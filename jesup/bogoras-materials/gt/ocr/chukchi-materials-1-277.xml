          </TextLine>
          <TextLine ID="mz_1-277_l19" HPOS="623" VPOS="2792" WIDTH="2985" HEIGHT="98" BASELINE="623 2889 3608 2889">
            <Shape>
              <Polygon POINTS="623 2792 3608 2792 3608 2890 623 2890"/>
            </Shape>
            <String CONTENT="тянетъ, тянетъ, кровь брызнула изъ носа, не смогъ, отошелъ; надѣлъ ку-" HPOS="623" VPOS="2792" WIDTH="2985" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-277_l20" HPOS="629" VPOS="2916" WIDTH="2985" HEIGHT="101" BASELINE="629 3016 3614 3016">
            <Shape>
              <Polygon POINTS="629 2916 3614 2916 3614 3017 629 3017"/>
            </Shape>
            <String CONTENT="кашку. «Теперь я!» Кукульпынъ снялъ кукашку. Только сталъ подходить" HPOS="629" VPOS="2916" WIDTH="2985" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-277_l21" HPOS="631" VPOS="3045" WIDTH="2982" HEIGHT="98" BASELINE="631 3143 3613 3143">
            <Shape>
              <Polygon POINTS="631 3045 3613 3045 3613 3143 631 3143"/>
            </Shape>
            <String CONTENT="къ кекуру, кекуръ уже сталъ шататься; подошелъ ближе, кекуръ выско-" HPOS="631" VPOS="3045" WIDTH="2982" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-277_l22" HPOS="634" VPOS="3172" WIDTH="2979" HEIGHT="100" BASELINE="634 3271 3613 3271">
            <Shape>
              <Polygon POINTS="634 3172 3613 3172 3613 3272 634 3272"/>
            </Shape>
            <String CONTENT="чилъ изъ гнѣзда въ скалѣ, побѣжааъ въ сторону, опередилъ его съ боку," HPOS="634" VPOS="3172" WIDTH="2979" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-277_l23" HPOS="632" VPOS="3285" WIDTH="2982" HEIGHT="109" BASELINE="632 3393 3614 3393">
            <Shape>
              <Polygon POINTS="632 3285 3614 3285 3614 3394 632 3394"/>
            </Shape>
            <String CONTENT="кекуръ убѣжалъ въ другую сторону, — боится, убѣгаетъ. «А! А!» Надѣлъ" HPOS="632" VPOS="3285" WIDTH="2982" HEIGHT="109"/>
          </TextLine>
          <TextLine ID="mz_1-277_l24" HPOS="631" VPOS="3417" WIDTH="2986" HEIGHT="106" BASELINE="631 3523 3617 3523">
            <Shape>
              <Polygon POINTS="631 3417 3617 3417 3617 3523 631 3523"/>
            </Shape>
            <String CONTENT="кукашку. «Однако ты хотѣлъ увидѣть Кукульпына! Какой-же ты, право²)!»" HPOS="631" VPOS="3417" WIDTH="2986" HEIGHT="106"/>
          </TextLine>
          <TextLine ID="mz_1-277_l25" HPOS="629" VPOS="3539" WIDTH="2986" HEIGHT="103" BASELINE="629 3641 3615 3641">
            <Shape>
              <Polygon POINTS="629 3539 3615 3539 3615 3642 629 3642"/>
            </Shape>
            <String CONTENT="Говоритъ Тянкинскій шаманъ: «Станемъ же хоть смѣнными товарищами по" HPOS="629" VPOS="3539" WIDTH="2986" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-277_l26" HPOS="629" VPOS="3626" WIDTH="2859" HEIGHT="144" BASELINE="629 3769 3488 3769">
            <Shape>
              <Polygon POINTS="629 3626 3488 3626 3488 3770 629 3770"/>
            </Shape>
            <String CONTENT="женѣ!» — «Хорошо!» — «Къ кому-же прежде пойдемъ? Развѣ къ тебѣ?» —" HPOS="629" VPOS="3626" WIDTH="2859" HEIGHT="144"/>
          </TextLine>
