            </Shape>
            <String CONTENT="кинскій шаманъ!» — «Зачѣмъ же ты (пришелъ)?» — «Хочу увидѣть Кукуль-" HPOS="634" VPOS="1233" WIDTH="2978" HEIGHT="146"/>
          </TextLine>
          <TextLine ID="mz_1-277_l7" HPOS="630" VPOS="1361" WIDTH="2980" HEIGHT="141" BASELINE="630 1501 3610 1501">
