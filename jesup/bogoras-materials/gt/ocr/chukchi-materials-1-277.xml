              <Polygon POINTS="640 4808 3633 4808 3633 4907 640 4907"/>
            </Shape>
            <String CONTENT="Пусть подъ землей.» Пошелъ подъ землей; вышелъ на своемъ берегу, по-" HPOS="640" VPOS="4808" WIDTH="2993" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-277_l36" HPOS="640" VPOS="4891" WIDTH="2997" HEIGHT="141" BASELINE="640 5031 3637 5031">
            <Shape>
              <Polygon POINTS="640 4891 3637 4891 3637 5032 640 5032"/>
            </Shape>
            <String CONTENT="дошелъ къ дому. «Эй! Гдѣ гость?» — «Нѣту?» — «Э-э! Варите ѣду!» Два" HPOS="640" VPOS="4891" WIDTH="2997" HEIGHT="141"/>
          </TextLine>
