            </Shape>
            <String CONTENT="10 (стр. 44). мајӈ-арма́ђты lа́wты-таӄаӈӈо́а̂т «великому начальнику стали" HPOS="805" VPOS="1194" WIDTH="2765" HEIGHT="108"/>
