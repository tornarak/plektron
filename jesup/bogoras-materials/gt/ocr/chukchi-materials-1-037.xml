              <Polygon POINTS="419 5434 3409 5434 3409 5532 419 5532"/>
            </Shape>
            <String CONTENT="Фродитизмъ. Дѣйствительно по сообщеніямъ чукочъ нѣкоторые жено-" HPOS="419" VPOS="5434" WIDTH="2990" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-037_l40" HPOS="424" VPOS="5555" WIDTH="2986" HEIGHT="101" BASELINE="424 5655 3410 5655">
