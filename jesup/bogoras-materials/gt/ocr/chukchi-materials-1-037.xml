              <Polygon POINTS="424 5555 3410 5555 3410 5656 424 5656"/>
            </Shape>
            <String CONTENT="подобные подъ конецъ мѣняютъ и тѣло и пріобрѣтаютъ женскіе органы," HPOS="424" VPOS="5555" WIDTH="2986" HEIGHT="101"/>
