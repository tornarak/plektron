            <Shape>
              <Polygon POINTS="425 5176 3410 5176 3410 5281 425 5281"/>
            </Shape>
            <String CONTENT="шихъ околоткахъ не было ни однаго такого случая. Въ основѣ такого пре-" HPOS="425" VPOS="5176" WIDTH="2985" HEIGHT="105"/>
          </TextLine>
          <TextLine ID="mz_1-037_l38" HPOS="423" VPOS="5310" WIDTH="2989" HEIGHT="95" BASELINE="423 5404 3412 5404">
