          </TextLine>
          <TextLine ID="mz_1-037_l33" HPOS="430" VPOS="4677" WIDTH="2982" HEIGHT="101" BASELINE="430 4778 3412 4778">
            <Shape>
              <Polygon POINTS="430 4677 3412 4677 3412 4778 430 4778"/>
            </Shape>
            <String CONTENT="оленьей икры, привязанной на поясѣ къ брюху, что замѣняетъ penis, а для" HPOS="430" VPOS="4677" WIDTH="2982" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-037_l34" HPOS="425" VPOS="4806" WIDTH="2988" HEIGHT="99" BASELINE="425 4904 3413 4904">
            <Shape>
              <Polygon POINTS="425 4806 3413 4806 3413 4905 425 4905"/>
            </Shape>
            <String CONTENT="того, чтобы имѣть также и дѣтей, выбираетъ себѣ товарища въ смѣнномъ" HPOS="425" VPOS="4806" WIDTH="2988" HEIGHT="99"/>
          </TextLine>
          <TextLine ID="mz_1-037_l35" HPOS="425" VPOS="4926" WIDTH="2983" HEIGHT="100" BASELINE="425 5025 3408 5025">
