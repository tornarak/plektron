            </Shape>
            <String CONTENT="бракѣ. Впрочемъ о ка́чыкычһеча я знаю только по разсказамъ, такъ какъ" HPOS="425" VPOS="4926" WIDTH="2983" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-037_l36" HPOS="425" VPOS="5055" WIDTH="2985" HEIGHT="99" BASELINE="425 5154 3410 5154">
