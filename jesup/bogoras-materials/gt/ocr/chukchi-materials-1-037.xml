            <Shape>
              <Polygon POINTS="434 3286 3428 3286 3428 3381 434 3381"/>
            </Shape>
            <String CONTENT="часто уничтожаютъ его. Особенно опасна для шаманскаго вдохновенія" HPOS="434" VPOS="3286" WIDTH="2994" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-037_l23" HPOS="431" VPOS="3392" WIDTH="2987" HEIGHT="121" BASELINE="431 3513 3418 3513">
            <Shape>
              <Polygon POINTS="431 3392 3418 3392 3418 3513 431 3513"/>
            </Shape>
            <String CONTENT="послѣродовая жидкость собаки; смотрѣть №№ 142, 144. Самыми сильными" HPOS="431" VPOS="3392" WIDTH="2987" HEIGHT="121"/>
          </TextLine>
          <TextLine ID="mz_1-037_l24" HPOS="435" VPOS="3533" WIDTH="2983" HEIGHT="103" BASELINE="435 3635 3418 3635">
            <Shape>
              <Polygon POINTS="435 3533 3418 3533 3418 3636 435 3636"/>
            </Shape>
            <String CONTENT="шаманами считаются однако превращенные шаманы, измѣнившіе свой полъ" HPOS="435" VPOS="3533" WIDTH="2983" HEIGHT="103"/>
          </TextLine>
          <TextLine ID="mz_1-037_l25" HPOS="431" VPOS="3666" WIDTH="2987" HEIGHT="101" BASELINE="431 3766 3418 3766">
            <Shape>
              <Polygon POINTS="431 3666 3418 3666 3418 3767 431 3767"/>
            </Shape>
            <String CONTENT="т. е. јырка̀-lа́ўl «женоподобный мужчина» и ӄа́чыкычһеча «подобная муж-" HPOS="431" VPOS="3666" WIDTH="2987" HEIGHT="101"/>
          </TextLine>
          <TextLine ID="mz_1-037_l26" HPOS="431" VPOS="3781" WIDTH="2985" HEIGHT="110" BASELINE="431 3890 3416 3890">
            <Shape>
              <Polygon POINTS="431 3781 3416 3781 3416 3891 431 3891"/>
            </Shape>
            <String CONTENT="чинѣ (женщина)». Въ томъ и въ другомъ случаѣ превращенный принимаетъ" HPOS="431" VPOS="3781" WIDTH="2985" HEIGHT="110"/>
          </TextLine>
          <TextLine ID="mz_1-037_l27" HPOS="435" VPOS="3921" WIDTH="2983" HEIGHT="98" BASELINE="435 4019 3418 4019">
            <Shape>
              <Polygon POINTS="435 3921 3418 3921 3418 4019 435 4019"/>
            </Shape>
            <String CONTENT="одежду чужаго пола, его произношеніе (женское произношеніе сильно раз-" HPOS="435" VPOS="3921" WIDTH="2983" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-037_l28" HPOS="433" VPOS="4048" WIDTH="2981" HEIGHT="98" BASELINE="433 4145 3414 4145">
            <Shape>
              <Polygon POINTS="433 4048 3414 4048 3414 4146 433 4146"/>
            </Shape>
            <String CONTENT="нится отъ мужскаго), всѣ его занятія и привычки, и усваиваетъ ихъ съ по-" HPOS="433" VPOS="4048" WIDTH="2981" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-037_l29" HPOS="435" VPOS="4176" WIDTH="2983" HEIGHT="92" BASELINE="435 4268 3418 4268">
            <Shape>
              <Polygon POINTS="435 4176 3418 4176 3418 4268 435 4268"/>
            </Shape>
            <String CONTENT="разительной быстротой и легкостью. Иногда превращеніе на этомъ остана-" HPOS="435" VPOS="4176" WIDTH="2983" HEIGHT="92"/>
          </TextLine>
          <TextLine ID="mz_1-037_l30" HPOS="429" VPOS="4299" WIDTH="2990" HEIGHT="100" BASELINE="429 4399 3419 4399">
            <Shape>
              <Polygon POINTS="429 4299 3419 4299 3419 4399 429 4399"/>
            </Shape>
            <String CONTENT="вливается, но часто оно заходить дальше. Јырка̀-lа́ўl выходить замужъ, и" HPOS="429" VPOS="4299" WIDTH="2990" HEIGHT="100"/>
          </TextLine>
          <TextLine ID="mz_1-037_l31" HPOS="430" VPOS="4425" WIDTH="2992" HEIGHT="98" BASELINE="430 4523 3422 4523">
