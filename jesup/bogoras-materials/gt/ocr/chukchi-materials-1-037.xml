            </Shape>
            <String CONTENT="вращенія конечно лежить извращенное половое чувство или даже герма-" HPOS="423" VPOS="5310" WIDTH="2989" HEIGHT="95"/>
          </TextLine>
          <TextLine ID="mz_1-037_l39" HPOS="419" VPOS="5434" WIDTH="2990" HEIGHT="98" BASELINE="419 5531 3409 5531">
