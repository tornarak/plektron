            </Shape>
            <String CONTENT="живеть со своимъ мужемъ modo Socratis, занимая притомъ страдательное" HPOS="430" VPOS="4425" WIDTH="2992" HEIGHT="98"/>
          </TextLine>
          <TextLine ID="mz_1-037_l32" HPOS="433" VPOS="4548" WIDTH="2987" HEIGHT="102" BASELINE="433 4649 3420 4649">
            <Shape>
              <Polygon POINTS="433 4548 3420 4548 3420 4650 433 4650"/>
            </Shape>
