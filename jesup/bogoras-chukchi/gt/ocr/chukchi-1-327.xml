                        </Shape>
                        <String CONTENT="thus protects himself from the spirits of contagious diseases, or a murderer"/>
                    </TextLine>

                    <TextLine ID="mz_1-327_l41" HPOS="405" VPOS="2994" WIDTH="1778" HEIGHT="71" BASELINE="407 3041 2183 3026" TAGREFS="TYPE_4">
