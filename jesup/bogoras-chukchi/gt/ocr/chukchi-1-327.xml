                        </Shape>
                        <String CONTENT="The tonsure and fringe are resorted to whenever it is thought necessary,"/>
                    </TextLine>

                    <TextLine ID="mz_1-327_l39" HPOS="405" VPOS="2877" WIDTH="1776" HEIGHT="61" BASELINE="407 2920 2181 2905" TAGREFS="TYPE_4">
                        <Shape>
