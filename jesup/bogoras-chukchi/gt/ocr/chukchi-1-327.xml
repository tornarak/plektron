                        </Shape>
                        <String CONTENT="for superstitious reasons, to change one’s appearance. For instance, a person"/>
                    </TextLine>

                    <TextLine ID="mz_1-327_l40" HPOS="405" VPOS="2938" WIDTH="1776" HEIGHT="58" BASELINE="407 2979 2181 2966" TAGREFS="TYPE_4">
