                        </Shape>
                        <String CONTENT="conceals his identity from the revengeful soul of his victim. From the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-327_l42" HPOS="407" VPOS="3046" WIDTH="1774" HEIGHT="71" BASELINE="409 3102 2181 3087" TAGREFS="TYPE_4">
