                        <Shape>
                            <Polygon POINTS="421 1876 421 1889 2187 1889 2189 1872 2183 1836 419 1840 421 1876"/>
                        </Shape>
                        <String CONTENT="bor’s house, or at least rub against his body a small pup, which, as said"/>
                    </TextLine>

                    <TextLine ID="mz_2-241_l25" HPOS="419" VPOS="1893" WIDTH="1770" HEIGHT="57" BASELINE="421 1934 2189 1930" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="421 1934 421 1950 2187 1946 2189 1930 2185 1905 2107 1893 2105 1893 2103 1893 2076 1905 1860 1905 1844 1893 1842 1893 1841 1893 1839 1893 1837 1893 1809 1905 1560 1905 1527 1893 1525 1893 1523 1893 1278 1905 1186 1895 1184 1895 1045 1905 963 1895 961 1895 959 1895 926 1905 691 1895 689 1895 419 1901 421 1934"/>
                        </Shape>
                        <String CONTENT="before,² will overcome the evil influence. After the ceremony, these precautions"/>
