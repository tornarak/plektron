                    </TextLine>
<TextLine ID="mz_2-241_l21" HPOS="528" VPOS="1654" WIDTH="1663" HEIGHT="57" BASELINE="530 1697 2191 1693" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="530 1697 530 1711 2189 1707 2191 1693 2189 1666 2162 1654 2160 1654 2158 1654 2156 1654 2134 1664 2101 1654 2099 1654 2097 1654 1997 1666 1884 1666 1868 1654 1866 1654 1864 1654 1862 1654 1860 1654 1833 1664 1754 1654 1752 1654 1700 1664 528 1664 530 1697"/>
                        </Shape>
                        <String CONTENT="Before the ceremony is performed, no person coming from outside is"/>
                    </TextLine>

                    <TextLine ID="mz_2-241_l22" HPOS="417" VPOS="1715" WIDTH="1776" HEIGHT="63" BASELINE="419 1754 2193 1750" TAGREFS="TYPE_5">
