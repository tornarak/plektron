                        </Shape>
                        <String CONTENT="skin, however, to spread on the ground under her feet while she is dancing."/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l5" HPOS="415" VPOS="708" WIDTH="1768" HEIGHT="65" BASELINE="417 750 2183 746" TAGREFS="TYPE_5">
