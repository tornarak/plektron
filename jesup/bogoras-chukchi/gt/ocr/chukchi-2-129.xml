                        </Shape>
                        <String CONTENT="the next day, the husband of the woman, and the wife of the man, perform a"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l10" HPOS="409" VPOS="1004" WIDTH="1772" HEIGHT="59" BASELINE="411 1049 2181 1043" TAGREFS="TYPE_5">
