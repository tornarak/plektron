                        <Shape>
                            <Polygon POINTS="411 928 411 943 2179 943 2181 924 2177 896 409 893 411 928"/>
                        </Shape>
                        <String CONTENT="leaving their respective mates to arrange matters between themselves. On"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l9" HPOS="409" VPOS="945" WIDTH="1772" HEIGHT="59" BASELINE="411 988 2181 985" TAGREFS="TYPE_5">
