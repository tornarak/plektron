                        </Shape>
                        <String CONTENT="look on together with the spectators. After the dance, the man must give"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l7" HPOS="411" VPOS="830" WIDTH="1770" HEIGHT="63" BASELINE="411 869 2181 869" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 869 411 883 536 883 552 893 554 893 556 893 558 893 728 883 2179 891 2181 869 2181 842 2113 830 2111 830 1974 840 1886 830 1884 830 1882 830 1842 840 1613 830 1611 830 1558 840 1367 830 1365 830 1363 830 1325 840 1271 830 1269 830 1267 830 1243 840 1206 830 1204 830 1202 830 902 840 844 830 842 830 840 830 838 830 822 842 726 842 575 830 573 830 571 830 569 830 554 842 411 842 411 869"/>
                        </Shape>
                        <String CONTENT="some present to the woman; and the following night they sleep together,"/>
                    </TextLine>

