                        <Shape>
                            <Polygon POINTS="417 2066 417 2081 2179 2075 2181 2060 2177 2032 2130 2021 2128 2021 2126 2021 2105 2030 1835 2021 1833 2021 1831 2021 1805 2030 1752 2021 1750 2021 1703 2030 1641 2021 1639 2021 1637 2021 1588 2034 1410 2034 1394 2022 1392 2022 1390 2022 1388 2022 1386 2022 1359 2034 987 2034 953 2024 951 2024 949 2024 947 2024 918 2034 415 2026 417 2066"/>
                        </Shape>
                        <String CONTENT="Wuteˊen and Iˊwtun, however, connect the ceremonial with Kereˊtkun, who"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l28" HPOS="411" VPOS="2079" WIDTH="1772" HEIGHT="61" BASELINE="413 2126 2183 2122" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2126 413 2140 2181 2138 2183 2122 2179 2093 2123 2093 2105 2079 2103 2079 2101 2079 2099 2079 2097 2079 2052 2091 1882 2079 1880 2079 1878 2079 1829 2091 1809 2079 1807 2079 1805 2079 1803 2079 1801 2079 1770 2091 1754 2079 1752 2079 1750 2079 1748 2079 1696 2091 1641 2079 1639 2079 1637 2079 1635 2079 1615 2093 1543 2093 1517 2079 1515 2079 1513 2079 1511 2079 1486 2091 1470 2079 1468 2079 1466 2079 1464 2079 1463 2079 1441 2089 1357 2079 1355 2079 1292 2095 1135 2095 1116 2081 1114 2081 1112 2081 1110 2081 1051 2093 983 2081 981 2081 979 2081 949 2093 930 2081 928 2081 926 2081 924 2081 922 2081 900 2091 851 2081 850 2081 848 2081 846 2081 830 2093 744 2081 742 2081 740 2081 708 2093 650 2081 534 2081 532 2081 530 2081 491 2093 411 2083 413 2126"/>
                        </Shape>
                        <String CONTENT="is called by them Kaˊcak. The name of Kaˊcak as identical with Kereˊtkun"/>
                    </TextLine>

