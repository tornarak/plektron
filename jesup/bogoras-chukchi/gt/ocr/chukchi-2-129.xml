                        </Shape>
                        <String CONTENT="a rule, to the lasting bond of compound marriage, or to what is so called."/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l18" HPOS="413" VPOS="1486" WIDTH="1768" HEIGHT="57" BASELINE="413 1527 2181 1527" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1527 413 1543 2179 1543 2181 1527 2179 1500 2097 1486 2095 1486 2093 1486 2058 1498 1991 1486 1989 1486 1919 1498 1862 1486 1860 1486 1858 1486 1823 1498 1795 1486 1794 1486 1792 1486 1715 1498 1676 1486 1674 1486 1672 1486 1615 1498 1555 1486 1553 1486 1551 1486 1504 1500 1306 1500 1271 1486 1269 1486 1267 1486 1265 1486 1229 1498 1032 1486 1030 1486 1028 1486 991 1500 859 1500 824 1486 822 1486 820 1486 818 1486 785 1498 750 1486 748 1486 746 1486 683 1498 646 1486 644 1486 642 1486 640 1486 611 1498 548 1486 546 1486 544 1486 501 1498 456 1486 454 1486 452 1486 413 1494 413 1527"/>
                        </Shape>
                        <String CONTENT="So often is this the case, that even the women who mix with the sailors from"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l19" HPOS="413" VPOS="1545" WIDTH="1766" HEIGHT="62" BASELINE="415 1588 2179 1584" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1588 415 1601 2175 1607 2179 1584 2175 1554 2027 1545 2025 1545 2023 1545 2021 1545 2005 1556 1888 1556 1858 1545 1856 1545 1854 1545 1747 1554 1713 1545 1711 1545 1709 1545 1486 1554 1427 1545 1425 1545 1423 1545 1402 1554 1370 1545 1369 1545 1367 1545 1259 1554 1096 1547 1094 1547 1092 1547 1090 1547 1075 1556 614 1547 613 1547 611 1547 609 1547 593 1556 450 1547 448 1547 446 1547 413 1558 415 1588"/>
                        </Shape>
                        <String CONTENT="whaling-ships consider them their husbands by compound marriage. Among"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l20" HPOS="411" VPOS="1603" WIDTH="1770" HEIGHT="59" BASELINE="413 1646 2181 1643" TAGREFS="TYPE_5">
                        <Shape>
