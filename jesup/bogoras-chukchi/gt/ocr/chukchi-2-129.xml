                            <Polygon POINTS="417 750 417 763 1296 773 1298 773 1300 773 1302 773 1322 761 1935 761 1950 771 1952 771 1954 771 1956 771 2181 761 2183 746 2177 708 415 710 417 750"/>
                        </Shape>
                        <String CONTENT="While the dance is being performed, the other dancers remain quiet, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l6" HPOS="411" VPOS="769" WIDTH="1772" HEIGHT="53" BASELINE="411 808 2183 808" TAGREFS="TYPE_5">
