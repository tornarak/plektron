                        </Shape>
                        <String CONTENT="the Chukchee, clandestine intercourse with another man’s wife is called by the"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l21" HPOS="411" VPOS="1662" WIDTH="1770" HEIGHT="69" BASELINE="413 1707 2181 1701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1707 413 1721 748 1721 808 1731 810 1731 1247 1719 1312 1729 1314 1729 1390 1719 1784 1727 1786 1727 1884 1717 1952 1727 1954 1727 1956 1727 1958 1727 1972 1717 1985 1727 1987 1727 1989 1727 1991 1729 2179 1729 2181 1701 2179 1672 2162 1662 2160 1662 2158 1662 2156 1662 2154 1662 2128 1672 2064 1662 2062 1662 2060 1662 2038 1672 1997 1662 1995 1662 1993 1662 1991 1662 1968 1672 1917 1662 1915 1662 1829 1672 1574 1664 1572 1664 1570 1664 1568 1664 1555 1674 1506 1664 1504 1664 1502 1664 1472 1676 1200 1676 1153 1664 1151 1664 1149 1664 1116 1674 1038 1664 1036 1664 1034 1664 996 1676 744 1666 742 1666 740 1666 738 1666 722 1678 411 1678 413 1707"/>
                        </Shape>
                        <String CONTENT="same name. When the affair first comes to the knowledge of the husband,"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l22" HPOS="411" VPOS="1725" WIDTH="1770" HEIGHT="59" BASELINE="413 1768 2181 1762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1768 413 1784 2179 1784 2181 1762 2177 1735 1598 1725 1596 1725 1594 1725 1592 1725 1578 1735 1014 1727 1012 1727 932 1737 613 1729 611 1729 411 1739 413 1768"/>
                        </Shape>
                        <String CONTENT="a quarrel may ensue; but an amicable adjustment is soon brought about by"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l23" HPOS="413" VPOS="1797" WIDTH="717" HEIGHT="43" BASELINE="413 1825 1130 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1825 413 1840 1130 1840 1130 1825 1130 1797 413 1797 413 1825"/>
