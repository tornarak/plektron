                        </Shape>
                        <String CONTENT="similar dance, in which the man gives an equivalent of the present of the"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l11" HPOS="409" VPOS="1067" WIDTH="1772" HEIGHT="57" BASELINE="411 1110 2181 1106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1110 411 1124 2179 1120 2181 1106 2177 1079 2130 1067 2128 1067 2050 1077 1674 1067 1672 1067 1472 1077 1433 1067 1431 1067 1429 1067 1427 1067 1388 1077 1349 1067 1347 1067 1345 1067 1255 1079 1229 1069 1227 1069 1226 1069 667 1079 526 1069 524 1069 522 1069 503 1079 428 1069 426 1069 425 1069 423 1069 409 1077 411 1110"/>
                        </Shape>
                        <String CONTENT="day before; and each newly-mated couple sleeps together for another night."/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l12" HPOS="413" VPOS="1135" WIDTH="1766" HEIGHT="55" BASELINE="413 1167 2179 1167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1167 413 1182 2177 1190 2179 1167 2179 1137 413 1135 413 1167"/>
                        </Shape>
                        <String CONTENT="Such dances are arranged chiefly among cousins or other relatives, who, among"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l13" HPOS="409" VPOS="1198" WIDTH="1770" HEIGHT="51" BASELINE="409 1229 2179 1229" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1229 409 1241 2177 1249 2179 1229 2179 1198 409 1198 409 1229"/>
                        </Shape>
                        <String CONTENT="the Chukchee, frequently assume the bond of compound marriage. Conversely,"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l14" HPOS="409" VPOS="1251" WIDTH="1770" HEIGHT="61" BASELINE="411 1290 2179 1282" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1290 411 1302 918 1312 920 1312 1061 1300 1235 1312 1237 1312 1239 1312 1271 1300 1374 1310 1376 1310 1378 1310 1380 1310 1398 1298 1457 1308 1459 1308 1461 1308 1463 1308 1476 1298 1513 1308 1515 1308 1517 1310 1709 1310 1709 1308 1711 1308 1739 1296 1852 1308 1854 1308 1931 1296 1956 1308 1958 1308 1960 1308 1962 1308 1987 1296 2013 1308 2015 1308 2017 1308 2177 1300 2179 1282 2175 1255 432 1251 430 1251 428 1251 409 1259 411 1290"/>
                        </Shape>
                        <String CONTENT="a new bond of compound marriage may be concluded through a trading-"/>
                    </TextLine>

