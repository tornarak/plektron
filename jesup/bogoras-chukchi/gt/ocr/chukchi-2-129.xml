                    </TextLine>
<TextLine ID="mz_2-129_l24" HPOS="515" VPOS="1842" WIDTH="1666" HEIGHT="65" BASELINE="517 1887 2181 1883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="517 1887 517 1897 1296 1907 1298 1907 1300 1907 1349 1895 1369 1905 1370 1905 1372 1905 1999 1895 2013 1905 2015 1905 2017 1905 2019 1907 2179 1907 2181 1883 2177 1854 2056 1854 2040 1842 2038 1842 2036 1842 2034 1842 2032 1842 2009 1852 1727 1842 1725 1842 1723 1842 1721 1842 1707 1852 1676 1842 1674 1842 1672 1842 1625 1852 1551 1842 1549 1842 1441 1852 1374 1842 1372 1842 1370 1842 1343 1854 536 1844 534 1844 532 1844 530 1844 515 1852 517 1887"/>
                        </Shape>
                        <String CONTENT="CEREMONIALS OF ASIATIC ESKIMO. Ceremonial of Kaˊcak. — Among"/>
                    </TextLine>

                    <TextLine ID="mz_2-129_l25" HPOS="409" VPOS="1903" WIDTH="1770" HEIGHT="63" BASELINE="411 1944 2179 1948" TAGREFS="TYPE_5">
