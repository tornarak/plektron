                        </Shape>
                        <String CONTENT="Aiˊwan (pl. Aiwaˊnat). This name is also applied to every Maritime Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l4" HPOS="685" VPOS="770" WIDTH="1773" HEIGHT="61" BASELINE="687 816 2458 807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="687 816 687 831 2456 822 2458 807 2447 777 1570 770 1568 770 1085 783 710 775 708 775 706 775 685 783 687 816"/>
                        </Shape>
                        <String CONTENT="chee who does not own a single reindeer. Many of the Maritime Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l5" HPOS="682" VPOS="829" WIDTH="1774" HEIGHT="65" BASELINE="685 876 2456 870" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 876 685 894 2454 894 2456 870 2454 840 2437 829 2434 829 2432 829 2430 829 2378 840 2343 829 2341 829 2339 829 2337 829 2309 840 2114 829 2112 829 2109 829 2066 840 2012 829 2010 829 1954 840 1923 829 1921 829 1919 829 1804 844 1679 844 1663 831 1661 831 1659 831 1657 831 1655 831 1616 842 1572 831 1570 831 1473 831 1471 831 1468 831 1466 831 1453 842 1412 831 1410 831 1408 831 1239 844 1215 833 1213 833 1211 833 1209 833 1178 844 1107 833 1105 833 682 840 685 876"/>
                        </Shape>
                        <String CONTENT="have a few reindeer-does in the herds of some friend. On the other hand,"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l6" HPOS="685" VPOS="887" WIDTH="1773" HEIGHT="67" BASELINE="687 937 2458 926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="687 937 687 954 2456 944 2458 926 2447 896 2103 887 2101 887 2099 887 2060 898 1068 894 1066 894 685 907 687 937"/>
                        </Shape>
                        <String CONTENT="not only on the Pacific coast in the immediate vicinity of the Eskimo, but also"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l7" HPOS="682" VPOS="948" WIDTH="1776" HEIGHT="65" BASELINE="685 998 2458 989" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 998 685 1013 2456 1004 2458 989 2445 957 2023 948 2021 948 2019 948 2016 948 2003 959 1588 950 1585 950 1507 961 1228 952 1226 952 682 965 685 998"/>
                        </Shape>
                        <String CONTENT="even in the language of the Chaun Reindeer-men, aiˊwan čɪmčeˊkin means “a"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l8" HPOS="685" VPOS="1004" WIDTH="1775" HEIGHT="76" BASELINE="687 1058 2460 1048" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="687 1058 687 1071 1087 1080 1089 1080 1144 1069 1232 1080 1235 1080 1360 1069 1391 1080 1393 1080 1395 1080 1577 1078 1579 1078 1581 1078 1594 1067 1629 1078 1631 1078 1633 1078 1806 1065 1932 1076 1934 1076 1993 1065 2014 1076 2016 1076 2019 1076 2153 1073 2155 1073 2157 1073 2172 1063 2185 1073 2187 1073 2190 1073 2192 1073 2458 1065 2460 1048 2456 1015 2192 1004 2190 1004 2187 1004 2151 1015 2135 1004 2133 1004 2131 1004 2129 1004 2127 1004 2103 1017 2081 1006 2079 1006 2077 1006 1954 1017 1902 1006 1899 1006 1897 1006 1858 1017 1804 1006 1802 1006 1800 1006 1798 1006 1782 1017 1670 1009 1668 1009 1666 1009 1663 1009 1648 1022 1546 1022 1523 1009 1520 1009 1395 1009 1393 1009 1391 1009 1388 1009 1369 1022 1150 1011 1148 1011 1146 1011 1124 1022 1094 1011 1092 1011 1089 1011 860 1024 778 1013 775 1013 685 1026 687 1058"/>
                        </Shape>
                        <String CONTENT="maritime relative,” čɪmčeˊkin signifying “relative.”¹ The Asiatic Eskimo call"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l9" HPOS="687" VPOS="1067" WIDTH="1771" HEIGHT="67" BASELINE="689 1117 2458 1108" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="689 1117 689 1134 2456 1125 2458 1108 2450 1078 2372 1067 2369 1067 2281 1078 2259 1067 2257 1067 2255 1067 2196 1078 2170 1067 2168 1067 2166 1067 2164 1067 2161 1067 2142 1080 1808 1080 1778 1069 1776 1069 1774 1069 1772 1069 1735 1080 1646 1069 1644 1069 1642 1069 1614 1080 1224 1071 1222 1071 1172 1082 1131 1071 1128 1071 1126 1071 1124 1071 1079 1084 1040 1073 1038 1073 1035 1073 929 1084 708 1073 706 1073 704 1073 702 1073 687 1082 689 1117"/>
                        </Shape>
                        <String CONTENT="themselves Yuˊɪt (the plural of yuk, “man”) in the same way as the American"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l10" HPOS="689" VPOS="1128" WIDTH="1520" HEIGHT="62" BASELINE="691 1177 2209 1171" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1177 691 1190 2207 1188 2209 1171 2207 1141 2172 1128 2170 1128 2168 1128 1908 1138 1873 1128 1871 1128 1869 1128 1867 1128 1865 1128 1852 1141 1774 1141 1748 1128 1746 1128 1744 1128 1618 1141 1588 1130 1585 1130 1583 1130 1416 1141 1369 1130 1367 1130 1365 1130 1362 1130 1334 1141 1235 1130 1232 1130 1230 1130 1187 1143 1172 1132 1170 1132 1167 1132 1165 1132 1107 1143 1068 1132 1066 1132 1063 1132 1061 1132 1031 1143 1016 1132 1014 1132 1012 1132 1009 1132 1007 1132 981 1143 960 1132 957 1132 955 1132 689 1141 691 1177"/>
                        </Shape>
                        <String CONTENT="Eskimo call their tribe Inuit (the plural of inuk or inung, “man”)."/>
                    </TextLine>
<TextLine ID="mz_1-040_l11" HPOS="799" VPOS="1184" WIDTH="1661" HEIGHT="69" BASELINE="801 1238 2460 1227" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="801 1238 801 1253 2458 1242 2460 1227 2456 1197 2393 1184 2391 1184 2291 1195 2274 1184 2272 1184 2270 1184 2268 1184 2265 1184 2263 1184 2248 1195 2097 1186 2094 1186 2092 1186 2090 1186 2077 1197 1990 1186 1988 1186 1986 1186 1951 1197 1676 1188 1674 1188 1596 1199 1536 1188 1533 1188 1462 1201 1425 1190 1423 1190 1330 1190 1328 1190 1326 1190 1323 1190 1310 1201 1269 1190 1267 1190 1265 1190 1089 1203 1053 1193 1050 1193 1048 1193 799 1199 801 1238"/>
                        </Shape>
                        <String CONTENT="The inhabitants of the Eskimo village Nɵˊɵkan, on East Cape, who differ"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l12" HPOS="685" VPOS="1247" WIDTH="1775" HEIGHT="62" BASELINE="687 1299 2460 1290" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="687 1299 687 1309 2460 1303 2460 1290 2458 1260 2432 1247 2430 1247 2428 1247 2244 1258 2203 1247 2200 1247 2198 1247 2196 1247 2170 1258 2047 1247 2045 1247 2042 1247 2014 1260 1997 1249 1995 1249 1993 1249 1990 1249 1871 1260 1847 1249 1845 1249 1843 1249 1841 1249 1839 1249 1826 1260 1780 1249 1778 1249 1776 1249 1774 1249 1772 1249 1752 1260 1488 1251 1486 1251 1484 1251 1481 1251 1466 1262 1326 1251 1323 1251 1321 1251 1319 1251 1302 1264 1176 1264 1133 1251 1131 1251 1128 1251 1126 1251 1100 1264 760 1253 758 1253 756 1253 734 1264 700 1253 697 1253 695 1253 693 1253 691 1253 691 1255 685 1260 687 1299"/>
                        </Shape>
                        <String CONTENT="in language from those on Indian Point, are called simply Nɵˊɵkalɪt, or, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l13" HPOS="689" VPOS="1307" WIDTH="1771" HEIGHT="63" BASELINE="691 1355 2460 1351" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1355 691 1370 2458 1366 2460 1351 2456 1320 2045 1307 2042 1307 1973 1318 1943 1307 1941 1307 1938 1307 1889 1318 1863 1307 1860 1307 1858 1307 1776 1318 1752 1307 1750 1307 1748 1307 1746 1307 1720 1318 1624 1307 1622 1307 1620 1307 1618 1307 1605 1318 1583 1307 1581 1307 1579 1307 1577 1307 1549 1320 921 1309 918 1309 832 1320 773 1309 771 1309 769 1309 745 1320 719 1309 717 1309 715 1309 713 1309 689 1320 691 1355"/>
                        </Shape>
                        <String CONTENT="derision, Peˊekit.² The inhabitants of Wuteˊen, the last Eskimo village on"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l14" HPOS="689" VPOS="1372" WIDTH="1771" HEIGHT="59" BASELINE="691 1416 2460 1411" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1416 691 1431 2458 1426 2460 1411 2456 1381 706 1372 704 1372 702 1372 700 1372 689 1379 691 1416"/>
                        </Shape>
                        <String CONTENT="Cape Ulakhpen, to the northwest of Plover Bay, also differing in language"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l15" HPOS="689" VPOS="1431" WIDTH="1771" HEIGHT="60" BASELINE="691 1474 2460 1470" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1474 691 1491 2458 1487 2460 1470 2456 1437 706 1431 704 1431 702 1431 700 1431 689 1437 691 1474"/>
                        </Shape>
                        <String CONTENT="from those on Indian Point, are called in a similar way Wuteˊelɪt. Mr. Gondatti"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l16" HPOS="689" VPOS="1489" WIDTH="1773" HEIGHT="63" BASELINE="691 1535 2462 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1535 691 1552 2460 1548 2462 1530 2452 1498 1575 1489 1572 1489 1570 1489 1540 1500 765 1491 762 1491 689 1502 691 1535"/>
                        </Shape>
                        <String CONTENT="maintains the opinion that the Nɵˊɵkalɪt and the Wuteˊelɪt cannot understand"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l17" HPOS="691" VPOS="1552" WIDTH="1769" HEIGHT="61" BASELINE="691 1595 2460 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1595 691 1608 2458 1613 2460 1595 2460 1565 2395 1552 2393 1552 2304 1563 2211 1552 2209 1552 2207 1552 2177 1563 1973 1552 1971 1552 1969 1552 1967 1552 1951 1565 1787 1565 1642 1552 1640 1552 1542 1563 1429 1552 1427 1552 1369 1563 1267 1552 1265 1552 1263 1552 1261 1552 1245 1565 1115 1565 1087 1552 1085 1552 1083 1552 1081 1552 1057 1565 825 1565 795 1552 793 1552 791 1552 788 1552 745 1563 719 1552 717 1552 715 1552 713 1552 691 1563 691 1595"/>
                        </Shape>
                        <String CONTENT="the language spoken on Indian Point, and have to use Chukchee in speaking"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l18" HPOS="689" VPOS="1608" WIDTH="1773" HEIGHT="63" BASELINE="691 1656 2462 1652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1656 691 1671 2460 1667 2462 1652 2450 1619 2339 1608 2337 1608 2220 1619 2198 1608 2196 1608 2194 1608 2192 1608 2190 1608 2172 1619 2146 1608 2144 1608 2142 1608 2055 1619 2032 1608 2029 1608 2027 1608 2025 1608 1980 1619 1925 1608 1923 1608 1921 1608 1889 1619 1828 1608 1826 1608 1824 1608 1821 1608 1806 1621 1640 1621 1616 1608 1614 1608 1611 1608 1501 1621 1464 1610 1462 1610 1460 1610 1458 1610 1436 1621 1367 1610 1365 1610 1362 1610 1336 1621 1213 1610 1211 1610 1209 1610 1176 1621 1146 1610 1144 1610 1141 1610 1139 1610 1137 1610 1120 1621 892 1610 890 1610 888 1610 862 1621 821 1610 819 1610 817 1610 814 1610 788 1621 734 1610 732 1610 730 1610 689 1623 691 1656"/>
                        </Shape>
                        <String CONTENT="with its inhabitants.³ Following in his footsteps, Mr. Bogdanovitch speaks of"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l19" HPOS="689" VPOS="1671" WIDTH="1765" HEIGHT="65" BASELINE="691 1717 2454 1708" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1717 691 1732 2010 1736 2012 1736 2452 1723 2454 1708 2447 1671 1031 1684 706 1675 704 1675 702 1675 700 1675 689 1682 691 1717"/>
                        </Shape>
                        <String CONTENT="the extensive mixing of peoples on the coast of the Chukchee Peninsula.⁴"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l20" HPOS="689" VPOS="1729" WIDTH="1771" HEIGHT="63" BASELINE="691 1777 2460 1771" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1777 691 1792 2458 1786 2460 1771 2456 1740 2003 1729 2001 1729 1865 1742 689 1742 691 1777"/>
                        </Shape>
                        <String CONTENT="However, from comparative texts in all three dialects, which I brought with"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l21" HPOS="689" VPOS="1794" WIDTH="1771" HEIGHT="59" BASELINE="691 1838 2460 1829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1838 691 1853 2458 1846 2460 1829 2456 1797 799 1794 797 1794 689 1805 691 1838"/>
                        </Shape>
                        <String CONTENT="me, it is evident that the dialectic differences are not so great as Mr. Gondatti"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l22" HPOS="689" VPOS="1853" WIDTH="1771" HEIGHT="69" BASELINE="691 1896 2460 1888" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1896 691 1911 1115 1922 1118 1922 1120 1922 1122 1922 1137 1909 1473 1918 1475 1918 1813 1907 1828 1918 1830 1918 1832 1918 1834 1918 1891 1907 1995 1918 1997 1918 1999 1918 2049 1905 2077 1916 2079 1916 2081 1916 2458 1905 2460 1888 2456 1857 1146 1853 1144 1853 1141 1853 1139 1853 1126 1864 955 1855 953 1855 689 1866 691 1896"/>
                        </Shape>
                        <String CONTENT="supposes. Indeed, I had occasion several times to witness the people of all"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l23" HPOS="689" VPOS="1907" WIDTH="1773" HEIGHT="65" BASELINE="691 1957 2462 1948" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 1957 691 1972 2460 1963 2462 1948 2452 1916 2207 1907 2205 1907 2203 1907 2200 1907 2185 1920 2060 1920 2036 1907 2034 1907 2032 1907 2029 1907 1984 1920 1915 1909 1912 1909 1910 1909 1908 1909 1893 1920 1261 1911 1258 1911 1176 1922 1137 1911 1135 1911 1133 1911 1131 1911 1096 1922 864 1914 862 1914 810 1924 710 1914 708 1914 706 1914 704 1914 689 1922 691 1957"/>
                        </Shape>
                        <String CONTENT="three tribes conversing without difficulty, every one using his own dialect. Of"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l24" HPOS="689" VPOS="1970" WIDTH="1773" HEIGHT="60" BASELINE="691 2017 2462 2011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 2017 691 2030 2460 2024 2462 2011 2452 1978 2434 1970 2432 1970 2430 1970 2428 1970 2404 1981 2010 1970 2008 1970 2006 1970 2003 1970 1986 1983 1826 1983 1772 1972 1769 1972 1767 1972 1737 1983 1436 1972 1434 1972 1432 1972 1393 1983 1332 1972 1330 1972 1328 1972 1274 1985 877 1974 875 1974 873 1974 871 1974 856 1987 689 1987 691 2017"/>
                        </Shape>
                        <String CONTENT="course, being conversant with the Chukchee language, they can also use it"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l25" HPOS="689" VPOS="2035" WIDTH="1773" HEIGHT="56" BASELINE="691 2076 2462 2069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 2076 691 2091 2460 2085 2462 2069 2452 2039 1278 2035 1276 2035 689 2046 691 2076"/>
                        </Shape>
                        <String CONTENT="for the same purpose. In any case, it is not necessary to assume for these"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l26" HPOS="693" VPOS="2102" WIDTH="1769" HEIGHT="52" BASELINE="693 2132 2462 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2132 693 2154 2462 2154 2462 2132 2454 2102 693 2102 693 2132"/>
                        </Shape>
                        <String CONTENT="two villages an origin from an independent and unknown stock, as Mr. Gondatti"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l27" HPOS="691" VPOS="2152" WIDTH="635" HEIGHT="65" BASELINE="693 2188 1326 2193" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2188 691 2212 693 2214 695 2214 695 2217 697 2217 700 2217 702 2217 1323 2210 1326 2193 1323 2165 1035 2165 1012 2152 1009 2152 1007 2152 693 2158 693 2188"/>
                        </Shape>
                        <String CONTENT="is somewhat inclined to do."/>
                    </TextLine>
<TextLine ID="mz_1-040_l28" HPOS="804" VPOS="2217" WIDTH="1661" HEIGHT="56" BASELINE="804 2251 2465 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="804 2251 804 2273 2465 2273 2465 2251 2465 2221 804 2217 804 2251"/>
                        </Shape>
                        <String CONTENT="The language of the Nɵˊɵkalɪt is intermediary between that of the Aiwaˊnat"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l29" HPOS="691" VPOS="2273" WIDTH="1771" HEIGHT="58" BASELINE="691 2314 2462 2314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 2314 691 2331 2462 2331 2462 2314 2454 2284 2045 2273 2042 2273 2040 2273 2003 2284 1967 2273 1964 2273 1962 2273 1960 2273 1936 2284 1882 2273 1880 2273 1813 2284 1778 2273 1776 2273 1774 2273 1772 2273 1735 2284 1663 2273 1661 2273 1659 2273 1635 2284 1601 2273 1598 2273 1596 2273 1594 2273 1562 2284 1447 2273 1445 2273 1442 2273 1416 2284 1319 2273 1317 2273 1254 2284 1174 2273 1172 2273 1074 2284 1020 2273 1018 2273 1016 2273 1014 2273 999 2284 970 2273 968 2273 966 2273 903 2284 832 2273 830 2273 827 2273 797 2284 769 2273 767 2273 765 2273 691 2284 691 2314"/>
                        </Shape>
                        <String CONTENT="and that of the natives of the Diomede Islands, who in their turn are con-"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l30" HPOS="693" VPOS="2331" WIDTH="771" HEIGHT="61" BASELINE="693 2375 1464 2375" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2375 693 2392 1464 2392 1464 2375 1464 2344 1282 2331 1280 2331 1224 2342 1178 2331 1176 2331 1174 2331 1172 2331 1150 2342 1092 2331 1089 2331 1025 2342 1001 2331 999 2331 996 2331 994 2331 953 2342 901 2331 899 2331 897 2331 851 2342 830 2331 827 2331 825 2331 823 2331 821 2331 821 2334 810 2344 693 2344 693 2375"/>
                        </Shape>
                        <String CONTENT="nected with the Alaskan Eskimo."/>
                    </TextLine>
<TextLine ID="mz_1-040_l31" HPOS="801" VPOS="2392" WIDTH="1664" HEIGHT="56" BASELINE="801 2433 2465 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="801 2433 801 2448 2465 2448 2465 2433 2465 2405 2328 2392 2244 2392 2242 2392 2239 2392 2237 2392 2224 2403 2164 2392 2161 2392 2159 2392 2118 2403 2049 2392 2047 2392 2045 2392 2010 2403 1841 2392 1839 2392 1837 2392 1806 2403 1724 2392 1722 2392 1720 2392 1685 2405 1497 2405 1479 2392 1477 2392 1475 2392 1473 2392 1471 2392 1440 2403 1408 2392 1406 2392 1232 2392 1230 2392 1228 2392 1226 2392 1213 2403 1161 2392 1159 2392 1157 2392 1124 2403 1107 2392 1105 2392 1102 2392 1100 2392 1098 2392 1057 2403 801 2398 801 2433"/>
                        </Shape>
                        <String CONTENT="The case of the Wuteˊelɪt is not so clear, because they live farther to"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l32" HPOS="689" VPOS="2453" WIDTH="1776" HEIGHT="67" BASELINE="691 2496 2465 2492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="691 2496 691 2509 1092 2520 1094 2520 1096 2520 1098 2520 1115 2509 1562 2518 1564 2518 1566 2518 1568 2518 1581 2507 1705 2507 1850 2518 1852 2518 1854 2518 1856 2518 1871 2507 2174 2518 2177 2518 2179 2518 2203 2507 2296 2518 2298 2518 2300 2518 2302 2518 2320 2507 2443 2518 2445 2518 2447 2518 2450 2518 2465 2505 2465 2492 2460 2461 715 2453 713 2453 710 2453 689 2461 691 2496"/>
                        </Shape>
                        <String CONTENT="the south. They are so seaman-like and hardy, however, that they might"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l33" HPOS="693" VPOS="2526" WIDTH="1449" HEIGHT="44" BASELINE="693 2554 2142 2554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2554 693 2570 2142 2570 2142 2554 2142 2526 693 2526 693 2554"/>
                        </Shape>
                        <String CONTENT="easily have come over from some place on the opposite shore."/>
                    </TextLine>
<TextLine ID="mz_1-040_l34" HPOS="804" VPOS="2567" WIDTH="1661" HEIGHT="63" BASELINE="806 2615 2465 2611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="806 2615 806 2630 2462 2626 2465 2611 2460 2580 2408 2567 2406 2567 2404 2567 2382 2578 2356 2567 2354 2567 2352 2567 2350 2567 2328 2578 2198 2567 2196 2567 2194 2567 2166 2578 2109 2567 2107 2567 2105 2567 2103 2567 2086 2578 2066 2567 2064 2567 1917 2567 1915 2567 1912 2567 1889 2580 1748 2580 1733 2567 1731 2567 1728 2567 1726 2567 1724 2567 1698 2578 1605 2570 1603 2570 1601 2570 1598 2570 1583 2583 1399 2583 1384 2570 1382 2570 1380 2570 1378 2570 1375 2570 1345 2580 1306 2570 1304 2570 1302 2570 1300 2570 1265 2580 1252 2570 1250 2570 1248 2570 1245 2570 1243 2570 1202 2580 1061 2570 1059 2570 804 2576 806 2615"/>
                        </Shape>
                        <String CONTENT="The inhabitants of St. Lawrence Island are called Eiwhueˊlɪt; and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l35" HPOS="691" VPOS="2628" WIDTH="1771" HEIGHT="63" BASELINE="693 2676 2462 2671" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2676 693 2691 2460 2686 2462 2671 2452 2637 2428 2628 2426 2628 2424 2628 2421 2628 2398 2639 2320 2628 2317 2628 2257 2639 2233 2628 2231 2628 2229 2628 2226 2628 2224 2628 2211 2639 2190 2628 2187 2628 2185 2628 2086 2639 2071 2628 2068 2628 2066 2628 2064 2628 2062 2628 2060 2628 2040 2641 1928 2641 1830 2628 1828 2628 1761 2639 1735 2628 1733 2628 1731 2628 1653 2639 1622 2628 1620 2628 1618 2628 1540 2641 1410 2630 1408 2630 1406 2630 1380 2641 1354 2630 1352 2630 1349 2630 1347 2630 1319 2641 1306 2630 1304 2630 1302 2630 1300 2630 1237 2641 1163 2630 1161 2630 691 2639 693 2676"/>
                        </Shape>
                        <String CONTENT="island itself, Eiwhueˊn. Their language is quite similar to that of the Asiatic"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l36" HPOS="695" VPOS="2693" WIDTH="1767" HEIGHT="58" BASELINE="697 2736 2462 2732" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="697 2736 697 2751 2460 2747 2462 2732 2454 2699 715 2693 713 2693 710 2693 708 2693 695 2699 697 2736"/>
                        </Shape>
                        <String CONTENT="Aiwaˊnat; and they are plainly a colony from the nearest shore, probably from"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l37" HPOS="697" VPOS="2756" WIDTH="1765" HEIGHT="56" BASELINE="697 2793 2462 2793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="697 2793 697 2812 2462 2812 2462 2793 2456 2760 697 2756 697 2793"/>
                        </Shape>
                        <String CONTENT="Indian Point. Tradition clearly points that way; and the immigration from the"/>
                    </TextLine>
<TextLine ID="mz_1-040_l38" HPOS="799" VPOS="2853" WIDTH="1670" HEIGHT="43" BASELINE="799 2879 2469 2879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="799 2879 799 2896 2469 2896 2469 2879 2469 2853 799 2853 799 2879"/>
                        </Shape>
                        <String CONTENT="¹ The Maritime Chukchee and the Asiatic Eskimo apply the name Aiwaˊnat to the inhabitants of"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l39" HPOS="695" VPOS="2890" WIDTH="1767" HEIGHT="50" BASELINE="697 2918 2462 2925" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="697 2918 695 2933 2458 2940 2462 2925 2454 2894 697 2890 697 2918"/>
                        </Shape>
                        <String CONTENT="St. Lawrence Island, because the latter are comparatively poorer in reindeer-skins and other products of reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l40" HPOS="695" VPOS="2940" WIDTH="1133" HEIGHT="43" BASELINE="695 2966 1828 2966" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="695 2966 695 2983 1828 2983 1828 2966 1828 2940 695 2940 695 2966"/>
                        </Shape>
                        <String CONTENT="breeding, and can get them only from the natives of the Asiatic coast."/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l41" HPOS="801" VPOS="2972" WIDTH="1666" HEIGHT="50" BASELINE="804 3000 2467 3007" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="804 3000 801 3016 2462 3022 2467 3007 2465 2979 804 2972 804 3000"/>
                        </Shape>
                        <String CONTENT="² East Cape is also commonly called Peˊek. The origin of this name is doubtful. The Chukchee consider"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l42" HPOS="693" VPOS="3018" WIDTH="1767" HEIGHT="52" BASELINE="695 3046 2460 3050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="695 3046 693 3061 2456 3070 2460 3050 2458 3022 695 3018 695 3046"/>
                        </Shape>
                        <String CONTENT="it to be derived from nɪpêˊwhaqên (“envious”); but according to Maydell, Cape Roˊwtɪn, on the Arctic Sea,"/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l43" HPOS="695" VPOS="3059" WIDTH="1763" HEIGHT="47" BASELINE="697 3087 2458 3091" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="697 3087 695 3102 2454 3106 2458 3091 2452 3061 697 3059 697 3087"/>
                        </Shape>
                        <String CONTENT="was in former times also called Peˊek. The Chukchee call Cape Roˊwtɪn at present also Peeˊkiñei (“Mount Peˊek”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-040_l44" HPOS="801" VPOS="3100" WIDTH="1659" HEIGHT="52" BASELINE="804 3128 2460 3135" TAGREFS="TYPE_5">
