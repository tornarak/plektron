                        </Shape>
                        <String CONTENT="that among those who visited the Russian ship was one man of forty, repulsive"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l29" HPOS="350" VPOS="2138" WIDTH="1771" HEIGHT="57" BASELINE="352 2183 2121 2177" TAGREFS="TYPE_5">
                        <Shape>
