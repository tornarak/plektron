                        </Shape>
                        <String CONTENT="same word as the Kamchadal koiach. The memory of persons of the trans-"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l24" HPOS="350" VPOS="1838" WIDTH="1773" HEIGHT="57" BASELINE="352 1881 2123 1876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1881 352 1895 2121 1895 2123 1876 2117 1838 350 1850 352 1881"/>
                        </Shape>
                        <String CONTENT="formed sex, as well as both terms mentioned, still lingers in the minds of"/>
                    </TextLine>

