                        </Shape>
                        <String CONTENT="the Kamchadal and the Koryak, but the custom as described has long since"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l26" HPOS="352" VPOS="1968" WIDTH="286" HEIGHT="56" BASELINE="354 1997 638 2001" TAGREFS="TYPE_5">
                        <Shape>
