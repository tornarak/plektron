                        </Shape>
                        <String CONTENT="Sarytcheff mentions the same habit among the Kadyak-islanders. He says"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l28" HPOS="348" VPOS="2077" WIDTH="1771" HEIGHT="59" BASELINE="350 2122 2119 2116" TAGREFS="TYPE_5">
