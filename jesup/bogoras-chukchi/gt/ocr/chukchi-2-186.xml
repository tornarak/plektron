                        </Shape>
                        <String CONTENT="Steller calls such men koiach or kojachtschitsch. He says that in former"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l20" HPOS="348" VPOS="1598" WIDTH="1771" HEIGHT="60" BASELINE="350 1645 2119 1641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1645 350 1658 2117 1658 2119 1641 2117 1609 2087 1598 2085 1598 2083 1598 2038 1607 1991 1598 1989 1598 1987 1598 1985 1598 1972 1607 1940 1598 1938 1598 1936 1598 1935 1598 1933 1598 1917 1607 1827 1598 1825 1598 1735 1607 1713 1598 1711 1598 1709 1598 1604 1607 1551 1598 1549 1598 1482 1607 1423 1598 1421 1598 1365 1607 1306 1598 1304 1598 1302 1598 1300 1598 1286 1607 1237 1598 1235 1598 1233 1598 1231 1598 1218 1609 1188 1599 1186 1599 1184 1599 585 1609 530 1599 528 1599 426 1609 377 1599 376 1599 374 1599 348 1609 350 1645"/>
                        </Shape>
                        <String CONTENT="times almost every Kamchadal had, besides his wife, such a koiach in his"/>
