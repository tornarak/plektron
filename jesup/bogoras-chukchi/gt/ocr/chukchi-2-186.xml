                        </Shape>
                        <String CONTENT="house.² The Koryak had also similar concubines, which in their language"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l22" HPOS="352" VPOS="1721" WIDTH="1767" HEIGHT="63" BASELINE="352 1762 2119 1762" TAGREFS="TYPE_5">
                        <Shape>
