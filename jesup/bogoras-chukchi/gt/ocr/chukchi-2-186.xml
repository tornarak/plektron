                        </Shape>
                        <String CONTENT="were called keiew or kewew. This, with proper phonetic change, is the"/>
                    </TextLine>

                    <TextLine ID="mz_2-186_l23" HPOS="348" VPOS="1778" WIDTH="1773" HEIGHT="56" BASELINE="350 1821 2121 1817" TAGREFS="TYPE_5">
