                            <Polygon POINTS="376 3033 376 3045 2135 3047 2137 3033 2137 3004 376 3002 376 3033"/>
                        </Shape>
                        <String CONTENT="Tatk-Omruˊwg̣ê asked us, ‘Where is Rultuˊwg̣i?’ We said, ‘He has gone to herd.’ Tatk-Omruˊwg̣ê"/>
                    </TextLine>

                    <TextLine ID="mz_3-092_l48" HPOS="372" VPOS="3053" WIDTH="1763" HEIGHT="46" BASELINE="372 3080 2135 3080" TAGREFS="TYPE_5">
                        <Shape>
