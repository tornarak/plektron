                        </Shape>
                        <String CONTENT="useful!’, The old man cried, ‘Oh, oh, oh! Stop beating me! I will assist you.’ He put on his"/>
                    </TextLine>

                    <TextLine ID="mz_3-092_l46" HPOS="372" VPOS="2959" WIDTH="1765" HEIGHT="47" BASELINE="372 2986 2137 2986" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 2986 372 2998 2134 3006 2137 2986 2135 2959 372 2959 372 2986"/>
                        </Shape>
                        <String CONTENT="shirt, took the lasso and the walking-staff, and ran to the reindeer. A little time after that,"/>
