                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_3-092_l2" HPOS="350" VPOS="468" WIDTH="109" HEIGHT="65" BASELINE="352 507 459 511" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="455 476 446 468 444 468 442 468 440 468 352 476 352 507 350 523 362 533 364 533 366 533 368 533 457 523 459 511 459 480 455 476"/>
