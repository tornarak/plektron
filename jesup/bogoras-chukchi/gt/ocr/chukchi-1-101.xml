                        </Shape>
                        <String CONTENT="The reindeer begins to shed its hair in the spring, and finishes in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l45" HPOS="383" VPOS="2578" WIDTH="1776" HEIGHT="56" BASELINE="386 2619 2159 2611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 2619 386 2634 2157 2626 2159 2611 2155 2578 429 2578 427 2578 425 2578 383 2589 386 2619"/>
                        </Shape>
                        <String CONTENT="middle of summer. Well-fed animals start shedding before lean ones, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l46" HPOS="386" VPOS="2637" WIDTH="1771" HEIGHT="67" BASELINE="388 2680 2157 2671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2680 388 2704 2155 2689 2157 2671 2153 2643 830 2637 827 2637 386 2650 388 2680"/>
                        </Shape>
                        <String CONTENT="grown animals before younger ones. A herd in good condition will finish"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l47" HPOS="386" VPOS="2695" WIDTH="1773" HEIGHT="59" BASELINE="388 2738 2159 2734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2738 388 2754 2157 2749 2159 2734 2155 2706 1274 2695 1271 2695 1269 2695 1226 2706 576 2697 574 2697 386 2708 388 2738"/>
                        </Shape>
                        <String CONTENT="two weeks earlier than a lean one. The new hair is short and sleek, but it"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l48" HPOS="386" VPOS="2751" WIDTH="1771" HEIGHT="67" BASELINE="388 2799 2157 2793" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2799 388 2818 2155 2818 2157 2793 2153 2764 2092 2751 2090 2751 1947 2762 1917 2751 1915 2751 1912 2751 1910 2751 1882 2762 1869 2751 1867 2751 1865 2751 1769 2751 1767 2751 1765 2751 1722 2762 1460 2754 1458 2754 1384 2764 1321 2754 1319 2754 1258 2764 1228 2754 1226 2754 1224 2754 1222 2754 1191 2764 1120 2754 1118 2754 1016 2764 979 2754 977 2754 975 2754 973 2754 947 2767 912 2756 910 2756 908 2756 522 2767 412 2756 409 2756 407 2756 405 2756 386 2764 388 2799"/>
                        </Shape>
                        <String CONTENT="thickens rapidly; and in September the skins of fawns are suitable for making"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l49" HPOS="388" VPOS="2816" WIDTH="1769" HEIGHT="61" BASELINE="390 2860 2157 2853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="390 2860 390 2877 2155 2870 2157 2853 2153 2825 979 2816 977 2816 912 2827 429 2818 427 2818 425 2818 388 2829 390 2860"/>
                        </Shape>
                        <String CONTENT="winter garments. For this purpose skins of fawns are used almost exclusively."/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l50" HPOS="388" VPOS="2877" WIDTH="1771" HEIGHT="58" BASELINE="390 2920 2159 2912" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2151 2877 388 2883 390 2920 390 2935 2157 2927 2159 2912 2153 2879 2151 2877"/>
                        </Shape>
                        <String CONTENT="The fawns are killed at two set periods in early fall, according to the kind"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l51" HPOS="383" VPOS="2931" WIDTH="1776" HEIGHT="65" BASELINE="386 2981 2159 2974" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 2981 386 2996 2157 2996 2159 2974 2155 2944 1802 2944 1774 2931 1772 2931 1769 2931 1767 2931 1765 2931 1748 2942 1696 2931 1694 2931 1692 2931 1663 2942 1622 2931 1620 2931 1618 2931 1616 2931 1564 2944 1546 2933 1544 2933 1542 2933 1540 2933 1304 2944 1239 2933 1237 2933 1235 2933 1204 2944 1025 2933 1022 2933 1020 2933 1018 2933 1003 2944 578 2935 576 2935 574 2935 531 2946 427 2935 425 2935 422 2935 383 2946 386 2981"/>
                        </Shape>
                        <String CONTENT="of fur desired. The late fall fawn-skins are used only for heavy overcoats;"/>
                    </TextLine>

                    <TextLine ID="mz_1-101_l52" HPOS="386" VPOS="2996" WIDTH="1775" HEIGHT="61" BASELINE="388 3041 2161 3031" TAGREFS="TYPE_4">
