                <TextBlock ID="text_2-176" HPOS="379" VPOS="460" WIDTH="1781" HEIGHT="2622"><TextLine ID="mz_2-176_l1" HPOS="387" VPOS="460" WIDTH="100" HEIGHT="68" BASELINE="387 503 487 503" TAGREFS="TYPE_3">
