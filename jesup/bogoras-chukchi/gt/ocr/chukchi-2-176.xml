                        </Shape>
                        <String CONTENT="448"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l2" HPOS="963" VPOS="471" WIDTH="607" HEIGHT="49" BASELINE="965 503 1570 507" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="1259 471 1239 471 1220 471 1200 471 1180 471 1161 471 1141 471 1122 471 1102 471 1083 471 1063 471 1043 471 1024 471 1004 471 985 471 965 471 965 503 963 517 1566 520 1570 507 1568 473 1267 471 1259 471"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-176_l3" HPOS="466" VPOS="565" WIDTH="1688" HEIGHT="59" BASELINE="466 609 2154 609" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2111 567 2091 567 2072 567 2052 565 2032 565 2015 565 2013 565 2011 565 2009 565 1993 577 1966 565 1964 565 1962 565 1960 565 1913 577 1886 565 1884 565 1882 565 1778 577 1709 565 1707 565 1705 565 1666 577 1607 565 1605 565 1604 565 1564 577 1549 565 1547 565 1545 565 1474 565 1472 565 1470 565 1439 579 1265 579 1208 565 1206 565 1204 565 1155 577 1098 565 1096 565 1094 565 1051 577 949 565 947 565 945 565 898 577 834 565 832 565 546 577 501 565 499 565 497 565 495 565 466 577 466 609 466 618 2150 624 2154 609 2154 579 2119 567 2111 567"/>
                        </Shape>
                        <String CONTENT="In a manuscript diary for the year 1898, by Mr. W. F. Dody,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l4" HPOS="381" VPOS="626" WIDTH="1777" HEIGHT="69" BASELINE="383 665 2158 659" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 665 383 695 464 685 601 693 603 693 605 693 607 693 628 679 750 687 752 687 1047 677 1190 691 1192 691 1194 691 1196 691 1218 677 1400 677 1416 687 1417 687 1419 687 1421 687 1600 675 1909 689 1911 689 2042 675 2062 687 2064 687 2066 687 2068 687 2156 679 2158 659 2154 632 428 626 426 626 381 636 383 665"/>
                        </Shape>
                        <String CONTENT="missionary on St. Lawrence Island, I found a rather curious description of a"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l5" HPOS="379" VPOS="681" WIDTH="1777" HEIGHT="69" BASELINE="381 728 2156 722" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 728 381 740 771 740 844 750 846 750 1390 738 1508 748 1510 748 1511 748 1513 748 1529 738 2052 746 2054 746 2056 746 2077 736 2134 746 2136 746 2138 746 2140 746 2156 734 2156 722 2154 695 2107 681 2105 681 2103 681 2101 681 2076 695 1860 695 1803 681 1801 681 1799 681 1766 695 1641 695 1613 681 1611 681 1609 681 1537 695 1490 683 1488 683 1486 683 1361 695 1296 683 1294 683 1292 683 1290 683 1275 695 1257 683 1255 683 1253 683 1180 683 1179 683 1124 695 1081 683 1079 683 1077 683 1075 683 1038 695 998 683 996 683 994 683 934 695 918 685 916 685 914 685 912 685 812 695 730 685 728 685 726 685 699 697 669 685 667 685 567 685 566 685 564 685 562 685 546 697 530 685 528 685 526 685 411 685 409 685 407 685 379 697 381 728"/>
                        </Shape>
                        <String CONTENT="similar kind of legerdemain, in which Mr. Dody took an active part, so far"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l6" HPOS="383" VPOS="755" WIDTH="1773" HEIGHT="49" BASELINE="383 785 2156 785" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 785 383 804 2156 797 2156 785 2156 755 383 755 383 785"/>
                        </Shape>
                        <String CONTENT="as to keep his hands on the head of the performer. Mr. Dody says that the"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l7" HPOS="379" VPOS="802" WIDTH="1777" HEIGHT="57" BASELINE="381 846 2156 842" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 846 381 859 2154 855 2156 842 2152 814 2058 802 2056 802 2003 812 1919 802 1917 802 1915 802 1880 814 1768 814 1752 802 1750 802 1748 802 1747 802 1745 802 1719 812 1652 802 1651 802 1649 802 1621 812 1594 802 1592 802 1384 802 1382 802 1380 802 1378 802 1363 814 1233 814 1024 804 1022 804 1020 804 991 814 963 804 961 804 959 804 902 814 379 808 381 846"/>
                        </Shape>
                        <String CONTENT="head of the shaman really began to move downward; but he ascribes this to"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l8" HPOS="379" VPOS="863" WIDTH="1773" HEIGHT="57" BASELINE="381 906 2152 902" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 906 381 918 2148 920 2152 902 2150 875 2121 863 2119 863 2117 863 2115 863 2089 873 2062 863 2060 863 2058 863 2056 863 2015 873 1233 865 1231 865 1229 865 1227 865 1214 875 1145 865 1143 865 1141 865 1108 875 1094 865 1092 865 1090 865 1088 865 797 875 732 865 730 865 728 865 687 875 642 865 640 865 638 865 607 875 473 865 472 865 379 877 381 906"/>
                        </Shape>
                        <String CONTENT="a change in the position of the shaman, which he adroitly executed in"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l9" HPOS="381" VPOS="922" WIDTH="245" HEIGHT="61" BASELINE="383 961 626 967" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 961 381 973 389 981 389 983 391 983 393 983 395 983 624 975 626 967 626 940 517 924 515 924 513 924 481 936 436 936 425 924 425 922 423 922 421 922 419 922 417 922 383 932 383 961"/>
                        </Shape>
                        <String CONTENT="the dark."/>
                    </TextLine>
<TextLine ID="mz_2-176_l10" HPOS="491" VPOS="979" WIDTH="1667" HEIGHT="64" BASELINE="493 1024 2158 1020" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="493 1024 493 1035 2140 1043 2142 1043 2144 1043 2146 1043 2158 1034 2158 1020 2156 992 2107 979 2105 979 2103 979 2101 979 2076 990 2011 979 2009 979 2007 979 1982 992 1821 992 1803 979 1801 979 1799 979 1797 979 1795 979 1762 992 1654 992 1637 979 1635 979 1633 979 1631 979 1629 979 1582 990 1478 979 1476 979 1421 990 1388 979 1386 979 1384 979 1382 979 1380 979 1363 990 1333 979 1331 979 1329 979 1327 979 1292 992 1269 981 1267 981 1265 981 1196 994 1039 994 1006 981 1004 981 1002 981 1000 981 965 992 930 981 928 981 926 981 924 981 879 994 703 994 685 981 683 981 681 981 679 981 677 981 640 992 609 981 607 981 605 981 491 987 493 1024"/>
                        </Shape>
                        <String CONTENT="While I was on St. Lawrence Island, I witnessed a performance by the"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l11" HPOS="379" VPOS="1041" WIDTH="1775" HEIGHT="57" BASELINE="381 1084 2154 1081" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 1084 381 1096 2150 1098 2154 1081 2152 1053 2123 1041 2121 1041 2119 1041 2117 1041 2077 1051 2038 1041 2036 1041 2034 1041 2032 1041 2005 1051 1647 1041 1645 1041 1643 1041 1611 1051 1508 1041 1506 1041 1400 1051 1372 1041 1370 1041 1369 1041 1304 1051 1269 1041 1267 1041 1265 1041 1157 1053 556 1043 554 1043 552 1043 550 1043 534 1055 379 1055 381 1084"/>
                        </Shape>
                        <String CONTENT="same shaman. His name was Assuˊnaṛak, and he belonged to a family"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l12" HPOS="383" VPOS="1104" WIDTH="1771" HEIGHT="53" BASELINE="383 1143 2154 1143" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 1143 383 1157 2154 1157 2154 1143 2154 1116 2093 1104 2091 1104 2036 1114 1674 1104 1672 1104 1508 1114 1466 1104 1464 1104 1463 1104 1308 1114 1292 1104 1290 1104 1288 1104 1147 1104 1145 1104 1143 1104 1116 1114 1026 1104 1024 1104 973 1114 885 1104 883 1104 799 1114 746 1104 744 1104 697 1114 640 1104 638 1104 636 1104 616 1114 585 1104 583 1104 581 1104 383 1114 383 1143"/>
                        </Shape>
                        <String CONTENT="renowned for shamanistic skill through several generations. Among other"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l13" HPOS="381" VPOS="1159" WIDTH="1775" HEIGHT="59" BASELINE="383 1206 2156 1198" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 1206 383 1218 2154 1214 2156 1198 2152 1171 2105 1159 2103 1159 2101 1159 2099 1159 2081 1169 1829 1159 1827 1159 1778 1169 1750 1159 1748 1159 1747 1159 1745 1159 1707 1171 1527 1161 1525 1161 1523 1161 1521 1161 1506 1173 1382 1173 1320 1161 1318 1161 1253 1173 902 1163 900 1163 791 1175 738 1165 736 1165 513 1175 401 1165 399 1165 397 1165 395 1165 381 1173 383 1206"/>
                        </Shape>
                        <String CONTENT="tricks, he made me throw a skin coverlet over his bare shoulders while he"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l14" HPOS="385" VPOS="1225" WIDTH="1771" HEIGHT="51" BASELINE="385 1261 2156 1261" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1261 385 1276 2156 1276 2156 1261 2154 1225 385 1225 385 1261"/>
                        </Shape>
                        <String CONTENT="kept his arms tightly crossed over his breast. This was done by the full"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l15" HPOS="383" VPOS="1284" WIDTH="1771" HEIGHT="51" BASELINE="385 1323 2154 1319" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1323 385 1335 2152 1333 2154 1319 2148 1284 383 1284 385 1323"/>
                        </Shape>
                        <String CONTENT="light of the lamp. The coverlet immediately stuck fast to his back, while I"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l16" HPOS="383" VPOS="1339" WIDTH="1771" HEIGHT="63" BASELINE="385 1384 2154 1380" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1384 385 1398 2150 1402 2154 1380 2150 1351 2021 1351 2005 1339 2003 1339 2001 1339 1999 1339 1997 1339 1972 1351 1805 1351 1784 1339 1782 1339 1780 1339 1778 1339 1739 1349 1645 1339 1643 1339 1531 1349 1443 1339 1441 1339 1267 1351 1128 1341 1126 1341 1124 1341 1096 1351 1039 1341 1038 1341 973 1351 900 1341 898 1341 850 1351 748 1341 746 1341 744 1341 708 1351 667 1341 665 1341 663 1341 661 1341 628 1351 573 1341 571 1341 383 1347 385 1384"/>
                        </Shape>
                        <String CONTENT="held it by the free ends. The shaman was able, notwithstanding my resistance,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l17" HPOS="383" VPOS="1400" WIDTH="1773" HEIGHT="55" BASELINE="385 1443 2156 1439" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1443 385 1455 2154 1453 2156 1439 2154 1411 2111 1400 2109 1400 2107 1400 2105 1400 2077 1410 2017 1400 2015 1400 2013 1400 1980 1410 1686 1400 1684 1400 1617 1410 1551 1400 1549 1400 1480 1410 1363 1400 1361 1400 1359 1400 1333 1410 1282 1400 1280 1400 1204 1413 879 1413 824 1402 822 1402 775 1411 695 1402 693 1402 691 1402 689 1402 673 1413 585 1413 569 1402 567 1402 566 1402 468 1402 466 1402 383 1413 385 1443"/>
                        </Shape>
                        <String CONTENT="to haul me into the outer room of the house. He said, however, that he"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l18" HPOS="383" VPOS="1458" WIDTH="1771" HEIGHT="63" BASELINE="385 1504 2154 1498" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1504 385 1517 2150 1521 2154 1498 2152 1470 2115 1458 2113 1458 2111 1458 2109 1458 2077 1468 1927 1458 1925 1458 1923 1458 1921 1458 1905 1470 1809 1470 1752 1458 1750 1458 1547 1470 1372 1460 1370 1460 1210 1470 1157 1460 1155 1460 1153 1460 1114 1470 1034 1460 1032 1460 1030 1460 1028 1460 1012 1470 979 1460 977 1460 975 1460 920 1472 571 1462 569 1462 567 1462 566 1462 550 1474 383 1474 385 1504"/>
                        </Shape>
                        <String CONTENT="was no longer able to sink into the ground, because, according to his words,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l19" HPOS="389" VPOS="1521" WIDTH="1060" HEIGHT="63" BASELINE="391 1558 1449 1556" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="391 1558 391 1572 912 1572 961 1584 963 1584 965 1584 1041 1582 1043 1582 1045 1582 1045 1580 1053 1572 1071 1582 1073 1582 1075 1584 1308 1584 1308 1582 1310 1582 1312 1582 1312 1580 1322 1572 1425 1582 1427 1582 1429 1582 1431 1582 1449 1570 1449 1556 1445 1521 399 1521 397 1521 395 1521 393 1521 393 1523 391 1523 389 1523 391 1558"/>
                        </Shape>
                        <String CONTENT="“this is not a time for great shamanistic acts.”"/>
                    </TextLine>
<TextLine ID="mz_2-176_l20" HPOS="495" VPOS="1580" WIDTH="1663" HEIGHT="57" BASELINE="495 1621 2158 1621" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="495 1621 495 1637 2158 1637 2158 1621 2158 1592 1929 1592 1915 1580 1913 1580 1911 1580 1909 1580 1907 1580 1878 1590 1811 1580 1809 1580 1747 1590 1686 1580 1684 1580 1604 1592 1494 1592 1478 1580 1476 1580 1474 1580 1472 1580 1396 1592 1316 1592 1302 1580 1300 1580 1298 1580 1296 1580 1218 1590 1180 1580 1179 1580 1177 1580 1126 1590 1088 1580 1086 1580 1085 1580 1083 1580 1057 1590 1018 1580 1016 1580 1014 1580 1012 1580 983 1590 910 1580 908 1580 840 1590 777 1580 775 1580 773 1580 734 1590 693 1580 691 1580 689 1580 624 1590 495 1586 495 1621"/>
                        </Shape>
                        <String CONTENT="The trick of undoing the hands tied up with a cord is said to be common"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l21" HPOS="379" VPOS="1648" WIDTH="1775" HEIGHT="51" BASELINE="381 1684 2154 1678" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 1684 381 1697 2150 1699 2154 1678 2148 1648 379 1652 381 1684"/>
                        </Shape>
                        <String CONTENT="among shamans, but all the performances I witnessed were rather clumsy,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l22" HPOS="383" VPOS="1697" WIDTH="1773" HEIGHT="59" BASELINE="385 1742 2156 1737" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1742 385 1756 2154 1752 2156 1737 2152 1709 1784 1697 1782 1697 1780 1697 1778 1697 1760 1709 1643 1709 1615 1697 1613 1697 1611 1697 1609 1697 1560 1709 1515 1699 1513 1699 1511 1699 1468 1711 1141 1711 1088 1699 1086 1699 1085 1699 1053 1709 996 1699 994 1699 912 1711 454 1701 452 1701 383 1713 385 1742"/>
                        </Shape>
                        <String CONTENT="and the leather line used for the purpose seemed to be capable of extension."/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l23" HPOS="383" VPOS="1770" WIDTH="1775" HEIGHT="45" BASELINE="385 1801 2158 1797" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1801 385 1815 2158 1811 2158 1797 2154 1770 383 1770 385 1801"/>
                        </Shape>
                        <String CONTENT="Such tricks were performed in the inner room, in total darkness, as an extra"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l24" HPOS="385" VPOS="1833" WIDTH="672" HEIGHT="50" BASELINE="385 1860 1057 1860" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 1860 385 1874 710 1874 750 1883 752 1883 754 1883 1057 1872 1057 1860 1057 1833 385 1833 385 1860"/>
                        </Shape>
                        <String CONTENT="feat after the regular séance."/>
                    </TextLine>
<TextLine ID="mz_2-176_l25" HPOS="495" VPOS="1880" WIDTH="1661" HEIGHT="56" BASELINE="495 1921 2156 1921" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="495 1921 495 1932 2154 1936 2156 1921 2156 1891 1974 1891 1960 1880 1958 1880 1956 1880 1954 1880 1870 1891 1639 1891 1617 1880 1615 1880 1613 1880 1553 1889 1463 1880 1461 1880 1384 1891 1284 1891 1271 1880 1269 1880 1267 1880 1265 1880 1165 1889 1073 1880 1071 1880 1069 1880 1043 1889 1014 1880 1012 1880 1010 1880 893 1889 877 1880 875 1880 873 1880 871 1880 822 1889 495 1883 495 1921"/>
                        </Shape>
                        <String CONTENT="The pretence of suicide is carried out with a rifle, or even with a rope,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l26" HPOS="381" VPOS="1936" WIDTH="1775" HEIGHT="59" BASELINE="383 1981 2156 1975" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 1981 383 1995 2154 1991 2156 1975 2152 1948 1819 1936 1817 1936 1815 1936 1784 1946 1750 1936 1748 1936 1747 1936 1690 1946 1658 1936 1656 1936 1654 1936 1551 1948 1531 1938 1529 1938 1527 1938 1525 1938 1498 1948 1472 1938 1470 1938 1468 1938 1231 1948 1198 1938 1196 1938 1194 1938 1108 1948 1057 1938 1055 1938 1053 1938 1012 1948 977 1938 975 1938 973 1938 971 1938 940 1950 924 1940 922 1940 920 1940 918 1940 581 1950 544 1940 542 1940 540 1940 538 1940 536 1940 520 1950 423 1940 421 1940 419 1940 381 1952 383 1981"/>
                        </Shape>
                        <String CONTENT="which is wound around the shaman’s neck, and the ends of which are drawn"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l27" HPOS="381" VPOS="1997" WIDTH="1775" HEIGHT="59" BASELINE="383 2042 2156 2034" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 2042 383 2056 2154 2052 2156 2034 2154 2007 2136 1997 2134 1997 2132 1997 2130 1997 2128 1997 2085 2007 1982 1997 1980 1997 1978 1997 1956 2009 1705 2009 1688 1999 1686 1999 1684 1999 1682 1999 1500 2009 1449 1999 1447 1999 1445 1999 1406 2009 1320 1999 1318 1999 1316 1999 1265 2011 728 2003 726 2003 724 2003 701 2013 399 2003 397 2003 395 2003 393 2003 381 2011 383 2042"/>
                        </Shape>
                        <String CONTENT="tight by two of the spectators present. The shaman, of course, remains safe"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l28" HPOS="383" VPOS="2060" WIDTH="1769" HEIGHT="58" BASELINE="383 2101 2152 2101" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="383 2101 383 2113 2148 2118 2152 2101 2150 2071 1805 2060 1803 2060 1750 2069 1719 2060 1717 2060 1715 2060 1519 2069 1484 2060 1482 2060 1480 2060 1478 2060 1453 2069 1372 2060 1370 2060 1369 2060 1331 2069 1302 2060 1300 2060 1298 2060 1233 2069 1198 2060 1196 2060 1194 2060 1039 2069 1006 2060 1004 2060 1002 2060 924 2069 875 2060 873 2060 871 2060 850 2069 781 2060 779 2060 693 2069 618 2060 616 2060 526 2069 497 2060 495 2060 493 2060 491 2060 460 2069 415 2060 413 2060 411 2060 383 2069 383 2101"/>
                        </Shape>
                        <String CONTENT="all the while. Of these last-mentioned tricks I can speak only by hearsay,"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l29" HPOS="381" VPOS="2132" WIDTH="798" HEIGHT="51" BASELINE="381 2160 1179 2160" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="381 2160 381 2173 395 2183 397 2183 399 2183 401 2183 403 2183 444 2173 548 2183 550 2183 630 2173 928 2183 930 2183 932 2183 965 2173 998 2183 1000 2183 1002 2183 1004 2183 1036 2173 1108 2183 1110 2183 1179 2173 1179 2160 1179 2132 381 2132 381 2160"/>
                        </Shape>
                        <String CONTENT="as I never witnessed any of them."/>
                    </TextLine>
<TextLine ID="mz_2-176_l30" HPOS="493" VPOS="2187" WIDTH="1663" HEIGHT="57" BASELINE="495 2222 2156 2216" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="495 2222 495 2234 987 2244 989 2244 1049 2232 1251 2242 1253 2242 2154 2230 2156 2216 2152 2187 493 2187 495 2222"/>
                        </Shape>
                        <String CONTENT="I have gone at length into the preceding details in order to show that"/>
                    </TextLine>

                    <TextLine ID="mz_2-176_l31" HPOS="383" VPOS="2236" WIDTH="1771" HEIGHT="57" BASELINE="385 2279 2154 2275" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="385 2279 385 2293 2152 2291 2154 2275 2150 2248 2068 2236 2066 2236 1709 2246 1576 2236 1574 2236 1572 2236 1549 2246 1533 2236 1531 2236 1529 2236 1419 2236 1417 2236 1347 2246 1320 2236 1318 2236 1316 2236 1206 2248 951 2238 949 2238 887 2248 859 2238 857 2238 855 2238 853 2238 832 2248 797 2238 795 2238 793 2238 726 2248 656 2238 654 2238 566 2248 515 2238 513 2238 460 2248 409 2238 407 2238 405 2238 383 2248 385 2279"/>
                        </Shape>
                        <String CONTENT="the shamanism of the Chukchee and the Asiatic Eskimo, though still in a"/>
                    </TextLine>

