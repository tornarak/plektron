                <TextBlock ID="text_1-298" HPOS="589" VPOS="892" WIDTH="1778" HEIGHT="2422"><TextLine ID="mz_1-298_l1" HPOS="1232" VPOS="892" WIDTH="488" HEIGHT="71" BASELINE="1232 937 1720 937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1232 922 1232 937 1232 954 1245 963 1248 963 1250 963 1252 963 1308 952 1702 963 1705 963 1707 963 1709 963 1720 952 1720 937 1720 905 1687 892 1685 892 1683 892 1300 905 1254 892 1252 892 1250 892 1232 922"/>
                        </Shape>
                        <String CONTENT="X. — CLOTHING."/>
                    </TextLine>
<TextLine ID="mz_1-298_l2" HPOS="702" VPOS="1011" WIDTH="1665" HEIGHT="50" BASELINE="704 1048 2367 1043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="704 1048 704 1061 2365 1056 2367 1043 2363 1011 702 1011 704 1048"/>
                        </Shape>
                        <String CONTENT="There is no particular difference between the clothes of Reindeer and"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l3" HPOS="594" VPOS="1069" WIDTH="1773" HEIGHT="52" BASELINE="596 1102 2367 1106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1102 594 1117 2363 1121 2367 1106 2365 1073 596 1069 596 1102"/>
                        </Shape>
                        <String CONTENT="those of Maritime Chukchee, except that the former use better reindeer-skins,"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l4" HPOS="596" VPOS="1130" WIDTH="1771" HEIGHT="56" BASELINE="598 1160 2367 1164" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="598 1160 596 1177 609 1186 611 1186 613 1186 615 1186 2365 1177 2367 1164 2365 1134 598 1130 598 1160"/>
                        </Shape>
                        <String CONTENT="while the latter use seal-skins more frequently. Skins of reindeer-fawns are"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l5" HPOS="594" VPOS="1190" WIDTH="1773" HEIGHT="52" BASELINE="596 1225 2367 1221" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1225 596 1242 2365 1238 2367 1221 2363 1193 594 1190 596 1225"/>
                        </Shape>
                        <String CONTENT="highly prized as material for clothing, because they are very warm and at the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l6" HPOS="596" VPOS="1255" WIDTH="1771" HEIGHT="46" BASELINE="596 1286 2367 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1286 596 1301 2367 1301 2367 1286 2367 1255 596 1255 596 1286"/>
                        </Shape>
                        <String CONTENT="same time so light that a man clad in double garments is able to bustle"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l7" HPOS="594" VPOS="1314" WIDTH="1773" HEIGHT="47" BASELINE="594 1344 2367 1344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1344 594 1361 2367 1361 2367 1344 2367 1314 594 1314 594 1344"/>
                        </Shape>
                        <String CONTENT="around in the open quite freely. When Middendorff¹ says that in his opinion"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l8" HPOS="591" VPOS="1361" WIDTH="1774" HEIGHT="70" BASELINE="594 1405 2365 1400" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1405 594 1420 914 1431 916 1431 918 1431 921 1431 938 1420 1313 1420 1419 1431 1421 1431 1603 1418 1821 1429 1824 1429 1826 1429 1856 1418 2003 1429 2006 1429 2008 1429 2010 1429 2027 1418 2079 1429 2081 1429 2084 1429 2086 1429 2099 1418 2112 1429 2114 1429 2116 1429 2118 1431 2281 1431 2281 1429 2283 1429 2304 1418 2339 1429 2341 1429 2343 1429 2346 1429 2348 1429 2365 1416 2365 1400 2361 1372 1479 1361 1477 1361 1475 1361 1427 1372 749 1364 747 1364 591 1374 594 1405"/>
                        </Shape>
                        <String CONTENT="a good sheep-skin coat is to be preferred for travel, it may be ascribed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l9" HPOS="594" VPOS="1420" WIDTH="1769" HEIGHT="65" BASELINE="596 1463 2363 1468" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1463 594 1476 2359 1485 2363 1468 2361 1435 2302 1422 2300 1422 1865 1433 1834 1422 1832 1422 1830 1422 1828 1422 1785 1433 1726 1422 1724 1422 1722 1422 1720 1422 1705 1435 1557 1435 1499 1422 1497 1422 1494 1422 1492 1422 1479 1433 1438 1420 1436 1420 1434 1420 1432 1420 1401 1431 1371 1420 1369 1420 1367 1420 1293 1431 1250 1420 1248 1420 1245 1420 1243 1420 1209 1431 1163 1420 1161 1420 1159 1420 1061 1433 931 1433 916 1420 914 1420 912 1420 910 1420 908 1420 886 1431 825 1420 823 1420 821 1420 793 1431 719 1420 717 1420 596 1429 596 1463"/>
                        </Shape>
                        <String CONTENT="the fact that he travelled only with the Tungus. The latter select for clothing"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l10" HPOS="591" VPOS="1491" WIDTH="1774" HEIGHT="57" BASELINE="594 1522 2365 1526" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1522 591 1535 613 1548 615 1548 617 1548 2363 1539 2365 1526 2363 1496 594 1491 594 1522"/>
                        </Shape>
                        <String CONTENT="either the thinnest summer skins for making their holiday garments, or the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l11" HPOS="591" VPOS="1541" WIDTH="1776" HEIGHT="61" BASELINE="594 1587 2367 1582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1587 594 1602 2365 1597 2367 1582 2365 1554 2315 1541 2313 1541 2311 1541 2309 1541 2283 1554 1878 1554 1863 1541 1860 1541 1858 1541 1856 1541 1748 1552 591 1550 594 1587"/>
                        </Shape>
                        <String CONTENT="heaviest winter skins for making short overcoats, which are put on over the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l12" HPOS="594" VPOS="1600" WIDTH="1773" HEIGHT="60" BASELINE="596 1645 2367 1641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1645 596 1660 2365 1656 2367 1641 2363 1613 2198 1600 2196 1600 2142 1610 2127 1600 2125 1600 2122 1600 2120 1600 2118 1600 2116 1600 2097 1613 1923 1613 1856 1600 1854 1600 1852 1600 1850 1600 1834 1613 1748 1613 1692 1600 1689 1600 1687 1600 1653 1610 1624 1600 1622 1600 1620 1600 1559 1610 1484 1600 1481 1600 1421 1613 1358 1602 1356 1602 1354 1602 1319 1613 1176 1602 1174 1602 1098 1613 1020 1602 1018 1602 1016 1602 983 1613 923 1602 921 1602 918 1602 916 1602 899 1613 767 1602 765 1602 762 1602 732 1613 697 1602 695 1602 693 1602 594 1615 596 1645"/>
                        </Shape>
                        <String CONTENT="usual clothes for riding-trips in the middle of winter. Moreover, the Tungus"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l13" HPOS="596" VPOS="1675" WIDTH="1771" HEIGHT="48" BASELINE="596 1706 2367 1706" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1706 596 1723 2367 1723 2367 1706 2367 1675 596 1675 596 1706"/>
                        </Shape>
                        <String CONTENT="usually have only small herds of reindeer, and cannot very well choose their"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l14" HPOS="596" VPOS="1723" WIDTH="1771" HEIGHT="58" BASELINE="596 1766 2367 1766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 1766 596 1781 2367 1781 2367 1766 2367 1736 2315 1723 2313 1723 2311 1723 2287 1734 2274 1723 2272 1723 2270 1723 2168 1723 2166 1723 2164 1723 2161 1723 2146 1734 1843 1723 1841 1723 1754 1734 1698 1723 1696 1723 1631 1734 1601 1723 1598 1723 1596 1723 1594 1723 1572 1734 1523 1723 1520 1723 1393 1734 1339 1723 1336 1723 1334 1723 1293 1734 1230 1723 1228 1723 1059 1734 1038 1723 1035 1723 843 1723 840 1723 838 1723 793 1734 736 1723 734 1723 732 1723 695 1734 617 1723 615 1723 613 1723 611 1723 596 1732 596 1766"/>
                        </Shape>
                        <String CONTENT="time for slaughtering or pick those animals whose skins are best fitted for"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l15" HPOS="594" VPOS="1794" WIDTH="1771" HEIGHT="48" BASELINE="594 1825 2365 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1825 594 1842 2365 1842 2365 1825 2365 1794 594 1794 594 1825"/>
                        </Shape>
                        <String CONTENT="clothing, as the wealthy reindeer-breeders of the extreme northeast do. Skins"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l16" HPOS="591" VPOS="1849" WIDTH="1776" HEIGHT="58" BASELINE="594 1879 2367 1885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 1879 591 1896 604 1905 607 1905 609 1905 611 1905 1003 1896 1187 1907 1189 1907 2365 1898 2367 1885 2365 1855 594 1849 594 1879"/>
                        </Shape>
                        <String CONTENT="of the wolf, and perhaps also those of the wild sheep, surpass those of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l17" HPOS="589" VPOS="1909" WIDTH="1778" HEIGHT="52" BASELINE="591 1939 2367 1946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 1939 589 1955 2363 1961 2367 1946 2365 1916 591 1909 591 1939"/>
                        </Shape>
                        <String CONTENT="reindeer in their wearing and protecting qualities, but both are too rare to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l18" HPOS="594" VPOS="1959" WIDTH="892" HEIGHT="71" BASELINE="596 2000 1486 2004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2000 594 2017 604 2026 607 2026 609 2026 611 2026 715 2017 756 2028 758 2028 760 2030 905 2030 905 2028 908 2028 910 2028 910 2026 921 2017 1436 2030 1438 2030 1484 2020 1486 2004 1484 1974 1416 1961 1317 1961 1315 1961 1313 1961 1310 1961 1297 1972 1237 1961 1235 1961 1232 1961 1206 1972 1191 1961 1189 1961 1187 1961 1185 1961 905 1970 895 1961 895 1959 892 1959 890 1959 888 1959 886 1959 858 1970 840 1959 838 1959 836 1959 834 1959 832 1959 795 1972 710 1972 697 1959 695 1959 693 1959 691 1959 596 1968 596 2000"/>
                        </Shape>
                        <String CONTENT="used regularly as material for clothing."/>
                    </TextLine>
<TextLine ID="mz_1-298_l19" HPOS="702" VPOS="2020" WIDTH="1665" HEIGHT="60" BASELINE="704 2061 2367 2065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="704 2061 702 2076 2363 2080 2367 2065 2365 2035 2181 2022 2084 2022 2081 2022 2079 2022 2077 2022 2062 2033 1988 2022 1986 2022 1932 2033 1876 2022 1873 2022 1871 2022 1845 2033 1785 2022 1782 2022 1780 2022 1748 2033 1650 2022 1648 2022 1542 2033 1494 2020 1492 2020 1490 2020 1488 2020 1451 2033 1321 2033 1306 2020 1304 2020 1302 2020 1300 2020 1297 2020 1267 2030 1224 2020 1222 2020 1219 2020 1217 2020 1191 2030 1163 2020 1161 2020 1159 2020 1157 2020 1115 2030 704 2024 704 2061"/>
                        </Shape>
                        <String CONTENT="The Maritime people in these regions, unlike the American Eskimo, use"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l20" HPOS="589" VPOS="2089" WIDTH="1776" HEIGHT="58" BASELINE="591 2121 2365 2126" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2121 589 2134 630 2147 633 2147 635 2147 2363 2139 2365 2126 2363 2093 591 2089 591 2121"/>
                        </Shape>
                        <String CONTENT="seal-skin but little for coats. This is because seal gives but slight protection"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l21" HPOS="591" VPOS="2150" WIDTH="1772" HEIGHT="49" BASELINE="594 2182 2363 2186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2182 591 2195 2359 2199 2363 2186 2361 2154 594 2150 594 2182"/>
                        </Shape>
                        <String CONTENT="against the cold, while, on the other hand, it brings a much better price in"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l22" HPOS="591" VPOS="2199" WIDTH="1772" HEIGHT="61" BASELINE="594 2245 2363 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2245 594 2260 2361 2258 2363 2240 2361 2212 2324 2199 2322 2199 2320 2199 2317 2199 2272 2212 2148 2212 2133 2199 2131 2199 2129 2199 2127 2199 2045 2210 2021 2199 2019 2199 2016 2199 1917 2210 1871 2199 1869 2199 1867 2199 1865 2199 1841 2210 1817 2199 1815 2199 1813 2199 1811 2199 1808 2199 1793 2210 1756 2199 1754 2199 1752 2199 1750 2199 1748 2199 1733 2212 1477 2212 1458 2201 1455 2201 1453 2201 1451 2201 1391 2212 970 2201 968 2201 903 2212 840 2201 838 2201 836 2201 804 2212 669 2201 667 2201 591 2214 594 2245"/>
                        </Shape>
                        <String CONTENT="exchange for reindeer-skins. For this reason we find that only reindeer-skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l23" HPOS="594" VPOS="2271" WIDTH="1771" HEIGHT="50" BASELINE="594 2305 2365 2305" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2305 594 2321 2365 2321 2365 2305 2365 2275 594 2271 594 2305"/>
                        </Shape>
                        <String CONTENT="is used for winter coats. Seal-skin is more useful for trousers, because it"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l24" HPOS="596" VPOS="2334" WIDTH="1769" HEIGHT="47" BASELINE="596 2364 2365 2364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2364 596 2381 2365 2381 2365 2364 2365 2334 596 2334 596 2364"/>
                        </Shape>
                        <String CONTENT="wears better, especially in the damp weather of spring. For spring and summer"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l25" HPOS="594" VPOS="2385" WIDTH="1771" HEIGHT="61" BASELINE="596 2422 2365 2427" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2422 594 2433 715 2446 717 2446 2363 2437 2365 2427 2363 2390 596 2385 596 2422"/>
                        </Shape>
                        <String CONTENT="boots, seal-skin is most serviceable. It is tough, wears extremely well, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l26" HPOS="591" VPOS="2444" WIDTH="1774" HEIGHT="58" BASELINE="594 2485 2365 2481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2485 594 2502 2363 2498 2365 2481 2361 2453 628 2444 626 2444 624 2444 591 2455 594 2485"/>
                        </Shape>
                        <String CONTENT="affords better protection against dampness and water than any other hide known"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l27" HPOS="594" VPOS="2509" WIDTH="387" HEIGHT="48" BASELINE="596 2539 981 2544" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2539 594 2552 977 2557 981 2544 979 2513 596 2509 596 2539"/>
                        </Shape>
                        <String CONTENT="to these natives."/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l28" HPOS="702" VPOS="2563" WIDTH="1665" HEIGHT="56" BASELINE="704 2598 2367 2604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="704 2598 702 2613 2363 2619 2367 2604 2367 2572 704 2563 704 2598"/>
                        </Shape>
                        <String CONTENT="While the Maritime Chukchee depend on reindeer-breeders for their winter"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l29" HPOS="591" VPOS="2628" WIDTH="1774" HEIGHT="52" BASELINE="594 2660 2365 2667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2660 591 2673 2361 2680 2365 2667 2363 2634 594 2628 594 2660"/>
                        </Shape>
                        <String CONTENT="clothes, the latter obtain boots and sole leather from the coast tribes. Late"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l30" HPOS="591" VPOS="2684" WIDTH="1774" HEIGHT="63" BASELINE="594 2719 2365 2725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 2719 591 2732 676 2745 678 2745 1061 2736 1215 2747 1217 2747 2363 2738 2365 2725 2365 2695 2341 2684 2339 2684 2337 2684 594 2684 594 2719"/>
                        </Shape>
                        <String CONTENT="in the spring, when short of seal-skin, the herdsmen will use it only to patch"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l31" HPOS="594" VPOS="2749" WIDTH="1769" HEIGHT="50" BASELINE="596 2780 2363 2784" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2780 594 2795 2359 2799 2363 2784 2361 2754 596 2749 596 2780"/>
                        </Shape>
                        <String CONTENT="out the uppers of a pair of ordinary reindeer-skin boots, so that they will wear"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l32" HPOS="596" VPOS="2808" WIDTH="589" HEIGHT="49" BASELINE="596 2842 1185 2842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 2842 596 2857 1185 2857 1185 2842 1185 2812 596 2808 596 2842"/>
                        </Shape>
                        <String CONTENT="better in the damp snow."/>
                    </TextLine>
<TextLine ID="mz_1-298_l33" HPOS="704" VPOS="2855" WIDTH="1661" HEIGHT="70" BASELINE="706 2899 2365 2905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="706 2899 704 2909 726 2922 728 2922 730 2922 1241 2914 1256 2925 1258 2925 1261 2925 1263 2925 2363 2916 2365 2905 2363 2873 2291 2860 2289 2860 2287 2860 2261 2870 2246 2860 2244 2860 2242 2860 2239 2860 2118 2870 2066 2860 2064 2860 2062 2860 2060 2860 2047 2870 2027 2860 2025 2860 2023 2860 2021 2860 2019 2860 2003 2873 1876 2873 1850 2860 1847 2860 1845 2860 1843 2860 1841 2860 1828 2870 1811 2857 1808 2857 1806 2857 1804 2857 1802 2857 1772 2868 1754 2857 1752 2857 1750 2857 1748 2857 1746 2857 1707 2868 1653 2857 1650 2857 1581 2868 1514 2857 1512 2857 1453 2868 1261 2855 1258 2855 1256 2855 1235 2866 706 2860 706 2899"/>
                        </Shape>
                        <String CONTENT="WINTER CLOTHING FOR MEN. — The style of clothes used by Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l34" HPOS="591" VPOS="2920" WIDTH="1774" HEIGHT="59" BASELINE="591 2964 2365 2964" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 2964 591 2979 2365 2979 2365 2964 2365 2933 2289 2920 2287 2920 2285 2920 2252 2931 2190 2920 2187 2920 2185 2920 2157 2931 2125 2920 2122 2920 2120 2920 2118 2920 2088 2933 1843 2933 1802 2920 1800 2920 1798 2920 1718 2931 1692 2920 1689 2920 1687 2920 1605 2931 1570 2920 1568 2920 1566 2920 1510 2931 1486 2920 1484 2920 1332 2920 1330 2920 1269 2931 1239 2920 1237 2920 1235 2920 1232 2920 1230 2920 1215 2931 1111 2920 1109 2920 1050 2931 1016 2920 1014 2920 1012 2920 1009 2920 1007 2920 992 2933 879 2933 864 2920 862 2920 860 2920 665 2920 663 2920 591 2931 591 2964"/>
                        </Shape>
                        <String CONTENT="and Koryak men in winter is admirably adapted to its purpose. It therefore"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l35" HPOS="594" VPOS="2992" WIDTH="1769" HEIGHT="49" BASELINE="594 3024 2363 3024" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="594 3024 594 3041 2363 3039 2363 3024 2363 2992 594 2992 594 3024"/>
                        </Shape>
                        <String CONTENT="prevails among most of the tribes of northeastern Asia, including the Russians."/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l36" HPOS="596" VPOS="3044" WIDTH="1769" HEIGHT="56" BASELINE="596 3083 2365 3083" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 3083 596 3100 2365 3100 2365 3083 2365 3052 596 3044 596 3083"/>
                        </Shape>
                        <String CONTENT="Even the northern Lamut, who in ordinary life wear narrow coats, and aprons"/>
                    </TextLine>

                    <TextLine ID="mz_1-298_l37" HPOS="594" VPOS="3102" WIDTH="1765" HEIGHT="65" BASELINE="596 3137 2359 3145" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="596 3137 594 3154 2354 3167 2359 3145 2356 3115 1917 3102 1915 3102 596 3104 596 3137"/>
                        </Shape>
                        <String CONTENT="of a peculiar cut common among the Tungus tribes throughout eastern Siberia,"/>
                    </TextLine>
<TextLine ID="mz_1-298_l38" HPOS="1187" VPOS="3191" WIDTH="576" HEIGHT="50" BASELINE="1189 3219 1763 3223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1189 3219 1187 3236 1759 3241 1763 3223 1761 3195 1189 3191 1189 3219"/>
                        </Shape>
                        <String CONTENT="¹ Middendorff, IV, Part 2, p. 1105."/>
                    </TextLine>
<TextLine ID="mz_1-298_l39" HPOS="1419" VPOS="3247" WIDTH="121" HEIGHT="67" BASELINE="1419 3290 1540 3290" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1419 3290 1419 3314 1540 3314 1540 3290 1540 3247 1419 3247 1419 3290"/>
                        </Shape>
                        <String CONTENT="[234]"/>
                    </TextLine>
