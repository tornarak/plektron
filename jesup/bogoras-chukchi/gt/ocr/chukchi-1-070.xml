            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-070" HPOS="708" VPOS="630" WIDTH="1780" HEIGHT="2617"><TextLine ID="mz_1-070_l1" HPOS="1293" VPOS="634" WIDTH="622" HEIGHT="52" BASELINE="1293 666 1915 666" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="1899 634 1302 634 1293 640 1293 666 1293 686 1915 686 1915 666 1915 638 1899 634"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l2" HPOS="721" VPOS="630" WIDTH="65" HEIGHT="56" BASELINE="726 675 786 671" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="778 630 721 638 726 675 726 686 784 684 786 671 780 630 778 630"/>
                        </Shape>
                        <String CONTENT="48"/>
                    </TextLine>
<TextLine ID="mz_1-070_l3" HPOS="819" VPOS="744" WIDTH="1665" HEIGHT="52" BASELINE="819 775 2484 775" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="819 775 819 792 2482 796 2484 775 2484 744 819 744 819 775"/>
                        </Shape>
                        <String CONTENT="I heard of no cases of cannibalism among the Chukchee, notwithstanding"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l4" HPOS="715" VPOS="801" WIDTH="1769" HEIGHT="52" BASELINE="715 835 2484 835" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 835 715 853 2484 853 2484 835 2482 801 715 803 715 835"/>
                        </Shape>
                        <String CONTENT="the fact that several cases of famine which wiped out whole villages were still"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l5" HPOS="713" VPOS="851" WIDTH="1771" HEIGHT="71" BASELINE="715 892 2484 896" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 892 713 905 767 920 769 920 771 920 838 909 992 920 994 920 996 920 999 920 1014 909 1085 920 1087 920 1592 909 1605 920 1607 920 1609 920 1611 920 2151 911 2259 922 2261 922 2339 911 2462 922 2465 922 2467 922 2469 922 2482 909 2484 896 2484 866 2452 853 2450 853 2350 853 2348 853 2346 853 2343 853 2330 863 2302 853 2300 853 2298 853 2235 863 2196 853 2194 853 2192 853 2097 863 2021 853 2019 853 2016 853 1995 863 1932 853 1930 853 1928 853 1904 863 1834 853 1832 853 1830 853 1802 863 1720 853 1718 853 1715 853 1685 863 1629 853 1627 853 1531 861 1510 851 1507 851 1505 851 1503 851 1464 863 1347 863 1332 851 1330 851 1328 851 1326 851 1232 863 983 863 968 851 966 851 964 851 962 851 960 851 934 861 871 851 869 851 866 851 864 851 847 861 812 851 810 851 808 851 715 859 715 892"/>
                        </Shape>
                        <String CONTENT="fresh in the memory of the people. On the other hand, a Yukaghir family"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l6" HPOS="715" VPOS="920" WIDTH="1767" HEIGHT="52" BASELINE="717 950 2482 957" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 950 715 965 2478 972 2482 957 2480 926 717 920 717 950"/>
                        </Shape>
                        <String CONTENT="which was starved in 1895 on the Middle Omolon had recourse to the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l7" HPOS="717" VPOS="974" WIDTH="1767" HEIGHT="58" BASELINE="717 1015 2484 1015" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1015 717 1032 2482 1032 2484 1015 2482 987 2387 974 2385 974 2307 985 2261 974 2259 974 2257 974 2255 974 2213 987 1999 987 1984 974 1982 974 1980 974 1977 974 1975 974 1934 987 1696 987 1681 974 1679 974 1676 974 1674 974 1672 974 1627 987 1473 987 1455 974 1453 974 1451 974 1449 974 1447 974 1412 985 1274 974 1271 974 1209 985 1105 974 1102 974 957 985 717 978 717 1015"/>
                        </Shape>
                        <String CONTENT="horrible cannibalism. Nor am I aware of any cases of exposure of new-born"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l8" HPOS="715" VPOS="1032" WIDTH="1771" HEIGHT="65" BASELINE="717 1078 2486 1071" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1078 717 1097 2484 1089 2486 1071 2482 1041 1306 1032 1304 1032 1248 1043 749 1035 747 1035 745 1035 715 1045 717 1078"/>
                        </Shape>
                        <String CONTENT="girls, as among the American Eskimo. New-born babes, indeed, after the death"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l9" HPOS="717" VPOS="1106" WIDTH="1771" HEIGHT="45" BASELINE="717 1134 2488 1134" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1134 717 1151 2488 1151 2488 1134 2488 1106 717 1106 717 1134"/>
                        </Shape>
                        <String CONTENT="of their mothers, are frequently smothered, and carried out with them to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l10" HPOS="717" VPOS="1151" WIDTH="1771" HEIGHT="61" BASELINE="717 1195 2488 1195" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1195 717 1212 2488 1212 2488 1195 2488 1164 2385 1151 2382 1151 2317 1164 2207 1164 2190 1151 2187 1151 2185 1151 2183 1151 2181 1151 2155 1162 2079 1151 2077 1151 2019 1162 1982 1151 1980 1151 1977 1151 1975 1151 1936 1162 1867 1151 1865 1151 1776 1162 1663 1151 1661 1151 1659 1151 1631 1162 1592 1151 1590 1151 1588 1151 1503 1162 1321 1151 1319 1151 1317 1151 1291 1162 1265 1151 1263 1151 1261 1151 1258 1151 1232 1162 1204 1151 1202 1151 1200 1151 1141 1162 1063 1151 1061 1151 1059 1151 1033 1162 925 1151 923 1151 717 1160 717 1195"/>
                        </Shape>
                        <String CONTENT="funeral-places, but this is because of the impossibility of raising them. I have"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l11" HPOS="715" VPOS="1216" WIDTH="1771" HEIGHT="55" BASELINE="717 1251 2486 1255" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1251 715 1266 2482 1271 2486 1255 2484 1225 717 1216 717 1251"/>
                        </Shape>
                        <String CONTENT="heard, too, of women just delivered, who, when feeling very ill, would smother"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l12" HPOS="717" VPOS="1284" WIDTH="953" HEIGHT="45" BASELINE="717 1312 1670 1312" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1312 717 1327 1668 1329 1670 1312 1670 1284 717 1284 717 1312"/>
                        </Shape>
                        <String CONTENT="their children as a sacrifice to the spirits."/>
                    </TextLine>
<TextLine ID="mz_1-070_l13" HPOS="823" VPOS="1329" WIDTH="1663" HEIGHT="61" BASELINE="825 1370 2486 1374" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="825 1370 823 1385 2482 1390 2486 1374 2486 1344 2450 1331 2447 1331 2352 1331 2350 1331 2348 1331 2346 1331 2330 1342 2261 1331 2259 1331 2200 1342 2185 1331 2183 1331 2181 1331 2179 1331 2116 1342 2075 1331 2073 1331 2071 1331 2068 1331 2038 1344 1869 1344 1856 1331 1854 1331 1852 1331 1850 1331 1795 1342 1759 1331 1756 1331 1754 1331 1562 1340 1549 1329 1546 1329 1544 1329 1542 1329 1540 1329 1512 1340 1399 1329 1397 1329 1395 1329 1367 1340 1297 1329 1295 1329 1235 1340 825 1338 825 1370"/>
                        </Shape>
                        <String CONTENT="Hospitality to travellers is much more liberal among the Maritime Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l14" HPOS="713" VPOS="1400" WIDTH="1773" HEIGHT="57" BASELINE="715 1429 2486 1433" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1429 713 1446 728 1457 730 1457 732 1457 734 1457 2484 1448 2486 1433 2484 1405 715 1400 715 1429"/>
                        </Shape>
                        <String CONTENT="chee than among the reindeer-breeders. The Arctic people say, that, even"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l15" HPOS="713" VPOS="1457" WIDTH="1769" HEIGHT="52" BASELINE="715 1491 2482 1496" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1491 713 1504 2478 1509 2482 1496 2480 1463 715 1457 715 1491"/>
                        </Shape>
                        <String CONTENT="if a guest wants to strike his host, the latter must continue to be friendly."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l16" HPOS="715" VPOS="1517" WIDTH="1771" HEIGHT="59" BASELINE="717 1550 2486 1554" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1550 715 1563 741 1576 743 1576 745 1576 2484 1567 2486 1554 2484 1524 717 1517 717 1550"/>
                        </Shape>
                        <String CONTENT="During my last journey along the Pacific coast, when we were several times"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l17" HPOS="713" VPOS="1578" WIDTH="1771" HEIGHT="61" BASELINE="715 1610 2484 1615" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1610 713 1623 797 1636 799 1636 1486 1628 1627 1639 1629 1639 2482 1628 2484 1615 2482 1582 715 1578 715 1610"/>
                        </Shape>
                        <String CONTENT="detained in Chukchee or Eskimo dwellings by a storm, it would often happen"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l18" HPOS="715" VPOS="1643" WIDTH="1771" HEIGHT="45" BASELINE="715 1673 2486 1673" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1673 715 1688 2486 1688 2486 1673 2486 1643 715 1643 715 1673"/>
                        </Shape>
                        <String CONTENT="that the master of the house, having little blubber and no wood to feed the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l19" HPOS="715" VPOS="1704" WIDTH="1771" HEIGHT="45" BASELINE="715 1734 2486 1734" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1734 715 1749 2486 1749 2486 1734 2486 1704 715 1704 715 1734"/>
                        </Shape>
                        <String CONTENT="fire, would break up his sleds, and even tear out one by one the wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l20" HPOS="715" VPOS="1758" WIDTH="1152" HEIGHT="60" BASELINE="717 1788 1867 1792" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1788 715 1801 758 1816 760 1816 762 1816 910 1805 1213 1816 1215 1816 1217 1816 1241 1805 1834 1818 1837 1818 1839 1818 1865 1805 1867 1792 1865 1762 717 1758 717 1788"/>
                        </Shape>
                        <String CONTENT="supports of his house, thus endangering its safety."/>
                    </TextLine>
<TextLine ID="mz_1-070_l21" HPOS="827" VPOS="1810" WIDTH="1661" HEIGHT="58" BASELINE="827 1853 2488 1853" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="827 1853 827 1868 2488 1868 2488 1853 2488 1820 2462 1810 2460 1810 2458 1810 2456 1810 2430 1823 2196 1823 2181 1810 2179 1810 2177 1810 2174 1810 2172 1810 2144 1820 2109 1810 2107 1810 2105 1810 2103 1810 2062 1820 2040 1810 2038 1810 2036 1810 2034 1810 1995 1820 1908 1810 1906 1810 1845 1820 1754 1810 1752 1810 1689 1820 1653 1810 1650 1810 1648 1810 1598 1820 1553 1810 1551 1810 1549 1810 1546 1810 1518 1820 1490 1810 1488 1810 1486 1810 1484 1810 1458 1820 1423 1810 1421 1810 1419 1810 1354 1820 827 1812 827 1853"/>
                        </Shape>
                        <String CONTENT="With the Reindeer people it is otherwise. First of all, they are much"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l22" HPOS="713" VPOS="1877" WIDTH="1773" HEIGHT="50" BASELINE="715 1909 2486 1914" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 1909 713 1922 2482 1927 2486 1914 2484 1881 715 1877 715 1909"/>
                        </Shape>
                        <String CONTENT="more superstitious about the “shunning” of diseases. In times of disease, even"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l23" HPOS="715" VPOS="1937" WIDTH="1769" HEIGHT="50" BASELINE="717 1968 2484 1972" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 1968 715 1983 2480 1987 2484 1972 2482 1942 717 1937 717 1968"/>
                        </Shape>
                        <String CONTENT="a healthy traveller, when he comes to a Chukchee camp from afar, especially"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l24" HPOS="713" VPOS="1994" WIDTH="1771" HEIGHT="54" BASELINE="715 2028 2484 2035" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2028 713 2041 2480 2048 2484 2035 2482 2002 715 1994 715 2028"/>
                        </Shape>
                        <String CONTENT="if he arrives at night, runs the risk of not being admitted to any of the tents."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l25" HPOS="717" VPOS="2046" WIDTH="1769" HEIGHT="71" BASELINE="719 2087 2486 2093" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="719 2087 717 2102 732 2113 734 2113 736 2113 739 2113 830 2102 864 2113 866 2113 869 2113 1345 2104 1360 2115 1362 2115 1365 2115 1367 2115 1369 2115 1412 2104 1440 2115 1442 2115 1445 2115 1447 2115 1473 2104 1501 2115 1503 2115 1505 2115 1696 2104 1845 2115 1847 2115 1850 2115 1895 2104 1947 2117 1949 2117 1951 2117 2484 2104 2486 2093 2486 2063 2439 2050 2437 2050 2434 2050 2432 2050 2400 2061 2382 2050 2380 2050 2378 2050 2376 2050 2374 2050 2330 2061 2203 2050 2200 2050 2010 2061 1945 2050 1943 2050 1941 2050 1897 2061 1793 2048 1791 2048 1720 2059 1627 2048 1624 2048 1568 2059 1546 2048 1544 2048 1542 2048 1481 2059 1375 2048 1373 2048 1371 2048 1345 2059 1185 2046 1183 2046 1180 2046 1154 2056 719 2050 719 2087"/>
                        </Shape>
                        <String CONTENT="This would never happen in a Maritime village. Many travellers of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l26" HPOS="715" VPOS="2113" WIDTH="1767" HEIGHT="58" BASELINE="717 2147 2482 2154" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="717 2147 715 2162 2478 2171 2482 2154 2480 2121 717 2113 717 2147"/>
                        </Shape>
                        <String CONTENT="Reindeer tribe are themselves averse to entering strange houses at such times,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l27" HPOS="713" VPOS="2175" WIDTH="1769" HEIGHT="59" BASELINE="715 2208 2482 2214" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2208 713 2221 752 2234 754 2234 756 2234 2480 2232 2482 2214 2480 2182 715 2175 715 2208"/>
                        </Shape>
                        <String CONTENT="and prefer to sleep in the open, content with an incantation against the spirits,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l28" HPOS="710" VPOS="2234" WIDTH="1774" HEIGHT="61" BASELINE="713 2269 2484 2273" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="713 2269 710 2282 834 2295 836 2295 2482 2286 2484 2273 2482 2243 713 2234 713 2269"/>
                        </Shape>
                        <String CONTENT="in lieu of supper. Even at ordinary times a guest arriving at the camp is"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l29" HPOS="713" VPOS="2299" WIDTH="1771" HEIGHT="50" BASELINE="713 2331 2484 2331" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="713 2331 713 2349 2484 2349 2484 2331 2482 2299 713 2299 713 2331"/>
                        </Shape>
                        <String CONTENT="considered as having no more rights than the inmates of the house. He will"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l30" HPOS="710" VPOS="2347" WIDTH="1772" HEIGHT="69" BASELINE="713 2388 2482 2392" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="713 2388 710 2401 1074 2414 1076 2414 1577 2405 1594 2416 1596 2416 1598 2416 1601 2416 2480 2405 2482 2392 2480 2362 2406 2349 2404 2349 2341 2360 2326 2349 2324 2349 2322 2349 2320 2349 2317 2349 2285 2360 2224 2349 2222 2349 2220 2349 2183 2360 2107 2349 2105 2349 2049 2360 1962 2349 1960 2349 1958 2349 1921 2360 1705 2349 1702 2349 1598 2360 1523 2347 1520 2347 1466 2357 1401 2347 1399 2347 1397 2347 1367 2357 1328 2347 1326 2347 1323 2347 1243 2357 1189 2347 1187 2347 1085 2357 1009 2347 1007 2347 934 2357 713 2353 713 2388"/>
                        </Shape>
                        <String CONTENT="have to wait outside with the other people till evening, when the sleeping-"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l31" HPOS="715" VPOS="2416" WIDTH="1773" HEIGHT="50" BASELINE="715 2450 2488 2450" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2450 715 2466 2488 2466 2488 2450 2486 2416 715 2418 715 2450"/>
                        </Shape>
                        <String CONTENT="room is made ready. Sometimes he will be given no food until the time of"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l32" HPOS="713" VPOS="2474" WIDTH="1773" HEIGHT="57" BASELINE="715 2507 2486 2513" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2507 713 2522 726 2531 728 2531 730 2531 732 2531 2484 2524 2486 2513 2484 2481 715 2474 715 2507"/>
                        </Shape>
                        <String CONTENT="the principal meal, which is eaten in the evening. At the time of the great"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l33" HPOS="713" VPOS="2535" WIDTH="1769" HEIGHT="58" BASELINE="715 2565 2482 2572" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2565 713 2578 771 2591 773 2591 1219 2583 1306 2593 1308 2593 2480 2585 2482 2572 2480 2541 715 2535 715 2565"/>
                        </Shape>
                        <String CONTENT="reindeer races, scores of people come to take part in the races or to look on."/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l34" HPOS="713" VPOS="2593" WIDTH="1769" HEIGHT="59" BASELINE="715 2624 2482 2630" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2624 713 2639 892 2652 895 2652 2480 2650 2482 2630 2480 2600 715 2593 715 2624"/>
                        </Shape>
                        <String CONTENT="Often they are given no food at all, and, after a whole day spent in the open,"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l35" HPOS="710" VPOS="2652" WIDTH="1778" HEIGHT="56" BASELINE="713 2682 2488 2691" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="713 2682 710 2699 2484 2708 2488 2691 2486 2660 713 2652 713 2682"/>
                        </Shape>
                        <String CONTENT="return in the evening to their respective camps, scattered around at a distance"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l36" HPOS="715" VPOS="2706" WIDTH="682" HEIGHT="67" BASELINE="715 2747 1397 2747" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="715 2747 715 2760 1012 2773 1014 2773 1016 2773 1050 2762 1085 2773 1087 2773 1089 2773 1092 2773 1118 2762 1211 2773 1213 2773 1397 2762 1397 2747 1397 2719 1336 2706 1334 2706 1050 2717 944 2706 942 2706 940 2706 938 2706 923 2719 788 2719 758 2706 756 2706 754 2706 752 2706 715 2717 715 2747"/>
                        </Shape>
                        <String CONTENT="of some thirty or forty miles."/>
                    </TextLine>
<TextLine ID="mz_1-070_l37" HPOS="823" VPOS="2769" WIDTH="1665" HEIGHT="65" BASELINE="825 2805 2488 2812" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="825 2805 823 2818 838 2829 840 2829 843 2829 845 2829 973 2821 1059 2831 1061 2831 1146 2821 1384 2831 1386 2831 1490 2823 1503 2834 1505 2834 1507 2834 1510 2834 2486 2823 2488 2812 2486 2777 825 2769 825 2805"/>
                        </Shape>
                        <String CONTENT="Theft among the Maritime Chukchee is comparatively rare. To steal"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l38" HPOS="708" VPOS="2836" WIDTH="1778" HEIGHT="58" BASELINE="710 2866 2486 2870" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="710 2866 708 2881 721 2890 723 2890 726 2890 728 2890 1419 2881 1540 2892 1542 2892 1544 2892 1575 2881 1603 2892 1605 2892 1607 2892 1609 2892 1642 2883 1830 2894 1832 2894 1834 2894 1882 2883 1934 2894 1936 2894 1999 2883 2016 2894 2019 2894 2021 2894 2023 2894 2484 2881 2486 2870 2484 2840 710 2836 710 2866"/>
                        </Shape>
                        <String CONTENT="from a neighbor in the same village is considered very improper. It is cus-"/>
                    </TextLine>

                    <TextLine ID="mz_1-070_l39" HPOS="710" VPOS="2892" WIDTH="1774" HEIGHT="61" BASELINE="713 2922 2484 2929" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="713 2922 710 2938 810 2951 812 2951 1291 2942 1304 2953 1306 2953 1308 2953 1310 2953 2482 2944 2484 2929 2482 2899 713 2892 713 2922"/>
                        </Shape>
