                <TextBlock ID="text_2-146" HPOS="346" VPOS="466" WIDTH="1775" HEIGHT="2637"><TextLine ID="mz_2-146_l1" HPOS="926" VPOS="473" WIDTH="615" HEIGHT="51" BASELINE="926 507 1541 507" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1533 479 1517 473 940 473 926 479 926 507 926 524 1541 524 1541 507 1539 491 1533 479"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l2" HPOS="350" VPOS="466" WIDTH="102" HEIGHT="68" BASELINE="354 515 452 509" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 466 350 481 354 515 354 524 381 534 383 534 385 534 452 518 452 509 448 475 426 466 415 466"/>
                        </Shape>
                        <String CONTENT="418"/>
                    </TextLine>
<TextLine ID="mz_2-146_l3" HPOS="348" VPOS="569" WIDTH="1773" HEIGHT="53" BASELINE="350 607 2121 603" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2111 577 2091 577 2072 577 2052 577 2032 575 2013 575 1993 575 1974 575 1954 575 1935 573 1915 573 1895 573 1876 573 1856 571 1837 571 1817 571 1797 571 1778 571 1774 569 372 569 370 569 368 569 348 577 350 607 350 622 2119 620 2121 603 2117 577 2111 577"/>
                        </Shape>
                        <String CONTENT="though he (being a shaman) stood up, with what could he fight them, except with his teeth and"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l4" HPOS="350" VPOS="614" WIDTH="1769" HEIGHT="55" BASELINE="352 656 2119 652" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 656 352 669 2117 667 2119 652 2115 624 1235 614 1233 614 1231 614 1229 614 1216 624 399 616 397 616 350 626 352 656"/>
                        </Shape>
                        <String CONTENT="nails? Thus they stabbed him; but his wounds immediately healed and he was as before. For a"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l5" HPOS="352" VPOS="673" WIDTH="1769" HEIGHT="47" BASELINE="352 701 2121 701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 701 352 714 2117 720 2121 701 2119 673 352 673 352 701"/>
                        </Shape>
                        <String CONTENT="very long time they could not kill him. At last they fell upon him from both sides, and, throwing"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l6" HPOS="350" VPOS="714" WIDTH="1765" HEIGHT="47" BASELINE="352 744 2115 748" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 744 350 757 2111 761 2115 748 2113 720 352 714 352 744"/>
                        </Shape>
                        <String CONTENT="him down, scooped out his eyes, pierced the eyeballs with a knife and flung them far away."/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l7" HPOS="354" VPOS="761" WIDTH="1765" HEIGHT="47" BASELINE="354 793 2119 793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="354 793 354 808 2119 808 2119 793 2117 761 354 761 354 793"/>
                        </Shape>
                        <String CONTENT="Then they cut his body here and there; also the heart they tore away and cut to pieces. All"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l8" HPOS="352" VPOS="812" WIDTH="1765" HEIGHT="45" BASELINE="352 840 2117 840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 840 352 855 2115 857 2117 840 2117 812 352 812 352 840"/>
                        </Shape>
                        <String CONTENT="these pieces they buried in the ground in separate places, because they were afraid to bury them"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l9" HPOS="350" VPOS="847" WIDTH="594" HEIGHT="53" BASELINE="352 885 944 879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 885 352 900 942 896 944 879 938 847 350 857 352 885"/>
                        </Shape>
                        <String CONTENT="together, lest he should revive.”¹"/>
                    </TextLine>
<TextLine ID="mz_2-146_l10" HPOS="456" VPOS="924" WIDTH="948" HEIGHT="57" BASELINE="458 969 1404 965" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="458 969 458 981 1402 977 1404 965 1400 938 1200 938 1175 924 1173 924 1171 924 1169 924 1167 924 1167 926 1155 936 1092 924 1090 924 1088 924 1047 936 1030 924 1028 924 1026 924 945 924 944 924 942 924 940 924 926 936 914 926 912 926 910 926 908 926 906 926 861 938 826 928 824 928 822 928 652 938 477 926 475 926 473 926 472 926 456 936 458 969"/>
                        </Shape>
                        <String CONTENT="Another account of similar kind says, —"/>
                    </TextLine>
<TextLine ID="mz_2-146_l11" HPOS="472" VPOS="1012" WIDTH="1647" HEIGHT="53" BASELINE="473 1039 2119 1045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="473 1039 472 1053 505 1065 507 1065 509 1065 2117 1061 2119 1045 2117 1018 473 1012 473 1039"/>
                        </Shape>
                        <String CONTENT="“She [the murderer] came to her neighbor, a woman, who was busy with her fireboard,"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l12" HPOS="350" VPOS="1065" WIDTH="1769" HEIGHT="49" BASELINE="350 1092 2119 1092" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1092 350 1106 2115 1114 2119 1092 2117 1065 350 1065 350 1092"/>
                        </Shape>
                        <String CONTENT="trying to make a fire. She stabbed her from behind. But the girl continued to work on the fire,"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l13" HPOS="350" VPOS="1110" WIDTH="1767" HEIGHT="45" BASELINE="352 1139 2117 1135" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1139 352 1155 2115 1151 2117 1135 2113 1110 350 1110 352 1139"/>
                        </Shape>
                        <String CONTENT="because she was a shaman-girl, a woman able to stab herself (in shamanistic performance). There-"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l14" HPOS="350" VPOS="1147" WIDTH="1451" HEIGHT="55" BASELINE="352 1184 1801 1178" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1184 352 1202 1799 1196 1801 1178 1795 1147 350 1159 352 1184"/>
                        </Shape>
                        <String CONTENT="fore she could not kill her, but only severed the tendons of her arms and legs.”²"/>
                    </TextLine>
<TextLine ID="mz_2-146_l15" HPOS="458" VPOS="1231" WIDTH="1661" HEIGHT="67" BASELINE="458 1274 2119 1274" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="458 1274 458 1286 675 1286 689 1296 691 1296 693 1296 695 1298 861 1298 861 1296 863 1296 865 1296 879 1286 967 1296 969 1298 1085 1298 1085 1296 1086 1296 1088 1296 1102 1286 1124 1296 1126 1296 1128 1296 1130 1296 1165 1286 1410 1296 1412 1296 1508 1286 1543 1296 1545 1296 1547 1296 2119 1286 2119 1274 2119 1243 2076 1231 2074 1231 2072 1231 2070 1231 2036 1243 1991 1231 1989 1231 1987 1231 1985 1231 1956 1243 1913 1231 1911 1231 1909 1231 1835 1243 1807 1231 1805 1231 1803 1231 1801 1231 1750 1243 1586 1231 1584 1231 1447 1243 1382 1231 1380 1231 1263 1243 1212 1231 1210 1231 1208 1231 1206 1231 1204 1231 1186 1245 1055 1245 1030 1231 1028 1231 1026 1231 977 1241 949 1231 947 1231 945 1231 944 1231 895 1245 671 1245 654 1231 652 1231 650 1231 566 1231 564 1231 562 1231 515 1243 483 1231 481 1231 479 1231 477 1231 475 1231 458 1241 458 1274"/>
                        </Shape>
                        <String CONTENT="A third account, referring to the small-pox epidemic of 1884 in the"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l16" HPOS="346" VPOS="1292" WIDTH="946" HEIGHT="65" BASELINE="348 1329 1292 1333" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="348 1329 346 1345 362 1355 364 1355 366 1355 368 1355 707 1345 1202 1357 1204 1357 1206 1357 1208 1357 1208 1355 1218 1347 1290 1347 1292 1333 1290 1306 891 1294 889 1294 887 1294 865 1304 789 1292 787 1292 348 1300 348 1329"/>
                        </Shape>
                        <String CONTENT="country of the western Kolyma, says, —"/>
                    </TextLine>
<TextLine ID="mz_2-146_l17" HPOS="473" VPOS="1376" WIDTH="1646" HEIGHT="47" BASELINE="475 1404 2119 1408" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="475 1404 473 1419 2115 1423 2119 1408 2117 1380 475 1376 475 1404"/>
                        </Shape>
                        <String CONTENT="“Then Aˊmčê began to think about his son-in-law, because his daughter left him ill in the"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l18" HPOS="354" VPOS="1429" WIDTH="1763" HEIGHT="47" BASELINE="354 1457 2117 1457" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="354 1457 354 1470 2115 1476 2117 1457 2117 1429 354 1429 354 1457"/>
                        </Shape>
                        <String CONTENT="vacant camp. Aˊmčê said, ‘Let us go and visit him.’ He said, ‘He is one able to resist death,"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l19" HPOS="350" VPOS="1462" WIDTH="349" HEIGHT="61" BASELINE="352 1504 699 1496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1504 352 1515 609 1523 611 1523 699 1507 699 1496 693 1462 350 1476 352 1504"/>
                        </Shape>
                        <String CONTENT="he is a shaman.’”³"/>
                    </TextLine>
<TextLine ID="mz_2-146_l20" HPOS="460" VPOS="1535" WIDTH="1657" HEIGHT="57" BASELINE="460 1578 2117 1578" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="460 1578 460 1592 2117 1592 2117 1578 2117 1547 2089 1535 2087 1535 2085 1535 2083 1535 2060 1547 2034 1535 2032 1535 2030 1535 2029 1535 2001 1547 1911 1535 1909 1535 1907 1535 1860 1547 1794 1535 1792 1535 1790 1535 1748 1549 1523 1549 1502 1535 1500 1535 1498 1535 1496 1535 1494 1535 1464 1549 1380 1549 1355 1535 1353 1535 1276 1535 1275 1535 1273 1535 1271 1535 1255 1547 1220 1535 1218 1535 1216 1535 1214 1535 1186 1547 1100 1535 1098 1535 1038 1549 961 1549 944 1535 942 1535 940 1535 938 1535 871 1547 810 1535 808 1535 722 1547 622 1535 620 1535 618 1535 589 1547 460 1541 460 1578"/>
                        </Shape>
                        <String CONTENT="The shamanistic call manifests itself in various ways. Sometimes it is"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l21" HPOS="350" VPOS="1598" WIDTH="1761" HEIGHT="54" BASELINE="350 1637 2111 1637" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1637 350 1652 2111 1652 2111 1637 2109 1598 350 1605 350 1637"/>
                        </Shape>
                        <String CONTENT="an inner voice, which bids the person enter into intercourse with the “spirits.”"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l22" HPOS="348" VPOS="1654" WIDTH="1771" HEIGHT="59" BASELINE="350 1699 2119 1695" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1699 350 1713 2117 1709 2119 1695 2115 1668 1976 1668 1958 1654 1956 1654 1954 1654 1952 1654 1950 1654 1913 1668 1631 1668 1613 1654 1611 1654 1609 1654 1607 1654 1506 1664 1474 1654 1472 1654 1470 1654 1468 1654 1466 1654 1447 1666 1378 1654 1376 1654 1292 1666 1214 1656 1212 1656 1210 1656 1208 1656 1190 1668 1108 1656 1106 1656 1049 1666 1018 1656 1016 1656 1014 1656 1012 1656 1010 1656 994 1668 942 1656 940 1656 938 1656 904 1668 795 1656 793 1656 728 1668 697 1656 695 1656 693 1656 691 1656 656 1670 489 1670 456 1656 454 1656 452 1656 348 1662 350 1699"/>
                        </Shape>
                        <String CONTENT="If the person is dilatory in obeying, the calling “spirit” soon appears in some"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l23" HPOS="352" VPOS="1719" WIDTH="1765" HEIGHT="53" BASELINE="352 1758 2117 1758" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1758 352 1772 2117 1772 2117 1758 2117 1731 1510 1719 1508 1719 1433 1729 1374 1719 1372 1719 1370 1719 1331 1729 1210 1719 1208 1719 1018 1729 983 1719 981 1719 979 1719 848 1729 763 1719 761 1719 716 1729 703 1719 701 1719 699 1719 605 1719 603 1719 552 1729 515 1719 513 1719 511 1719 352 1729 352 1758"/>
                        </Shape>
                        <String CONTENT="outward, visible shape, and communicates the call in a more explicit way."/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l24" HPOS="352" VPOS="1776" WIDTH="1767" HEIGHT="57" BASELINE="352 1817 2119 1817" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 1817 352 1833 2119 1833 2119 1817 2119 1787 1901 1787 1886 1776 1884 1776 1882 1776 1880 1776 1878 1776 1848 1787 1654 1787 1639 1776 1637 1776 1635 1776 1633 1776 1482 1786 1429 1776 1427 1776 1369 1786 1186 1776 1184 1776 1086 1786 1004 1776 1002 1776 953 1786 897 1776 895 1776 789 1786 765 1776 763 1776 761 1776 685 1786 352 1780 352 1817"/>
                        </Shape>
                        <String CONTENT="For instance, Aiñanwaˊt, whom I have mentioned before, says that at one"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l25" HPOS="348" VPOS="1834" WIDTH="1767" HEIGHT="67" BASELINE="350 1878 2115 1872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1878 350 1891 462 1901 464 1901 466 1901 468 1901 483 1891 996 1899 998 1899 1000 1899 1002 1899 1018 1889 1482 1889 1521 1899 1523 1899 1525 1899 1588 1887 1735 1897 1737 1899 1995 1899 1995 1897 1997 1897 1999 1897 2013 1887 2093 1897 2095 1897 2097 1897 2099 1897 2115 1885 2115 1872 2111 1846 1952 1834 1950 1834 1876 1844 1848 1834 1846 1834 1844 1834 1842 1834 1821 1844 1774 1834 1772 1834 1727 1844 1690 1834 1688 1834 1686 1834 1684 1834 1682 1834 1666 1844 1609 1834 1607 1834 1551 1844 1529 1834 1527 1834 1525 1834 1523 1834 1490 1846 1067 1836 1065 1836 1063 1836 1034 1846 859 1838 857 1838 855 1838 853 1838 838 1850 609 1850 524 1838 522 1838 454 1848 368 1838 366 1838 364 1838 362 1838 348 1846 350 1878"/>
                        </Shape>
                        <String CONTENT="time, after a severe illness, when his soul was ripe for inspiration, he saw"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l26" HPOS="350" VPOS="1895" WIDTH="1763" HEIGHT="57" BASELINE="350 1938 2113 1938" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="350 1938 350 1952 2113 1952 2113 1938 2113 1907 2030 1895 2029 1895 2027 1895 1987 1905 1566 1895 1564 1895 1515 1905 1486 1895 1484 1895 1482 1895 1398 1905 1370 1895 1369 1895 1367 1895 1314 1905 1282 1895 1280 1895 1278 1895 1276 1895 1275 1895 1261 1905 1235 1895 1233 1895 1231 1895 1229 1895 1227 1895 1212 1907 1098 1907 1059 1895 1057 1895 1055 1895 926 1905 855 1895 853 1895 785 1905 611 1895 609 1895 607 1895 579 1905 548 1895 546 1895 544 1895 542 1895 540 1895 524 1905 495 1895 493 1895 491 1895 350 1905 350 1938"/>
                        </Shape>
                        <String CONTENT="several “spirits,” but did not give much heed to the fulfilment of their orders."/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l27" HPOS="352" VPOS="1958" WIDTH="1765" HEIGHT="55" BASELINE="354 1997 2117 1993" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="354 1997 354 2013 2115 2013 2117 1993 2111 1958 352 1960 354 1997"/>
                        </Shape>
                        <String CONTENT="Then a “spirit” came to him. He was gaunt, and black of color, and said"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l28" HPOS="350" VPOS="2013" WIDTH="1767" HEIGHT="58" BASELINE="352 2058 2117 2054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2058 352 2069 2113 2071 2117 2054 2115 2024 2091 2013 2089 2013 2087 2013 2085 2013 2064 2022 1823 2013 1821 2013 1752 2022 1701 2013 1700 2013 1698 2013 1674 2022 1613 2013 1611 2013 1609 2013 1584 2022 1557 2013 1555 2013 1553 2013 1461 2022 1376 2013 1374 2013 1323 2022 1255 2013 1253 2013 1251 2013 1249 2013 1227 2024 832 2015 830 2015 828 2015 802 2024 765 2015 763 2015 761 2015 759 2015 726 2024 675 2015 673 2015 671 2015 669 2015 654 2026 511 2026 481 2015 479 2015 477 2015 475 2015 448 2024 376 2015 374 2015 372 2015 350 2024 352 2058"/>
                        </Shape>
                        <String CONTENT="that he was the “spirit” of reindeer-scab.⁴ Aiñanwaˊt felt himself very much"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l29" HPOS="352" VPOS="2087" WIDTH="1767" HEIGHT="45" BASELINE="352 2116 2119 2116" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2116 352 2132 2119 2132 2119 2116 2119 2087 352 2087 352 2116"/>
                        </Shape>
                        <String CONTENT="drawn toward that “spirit,” and wanted him to stay and become his constant"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l30" HPOS="350" VPOS="2134" WIDTH="1767" HEIGHT="65" BASELINE="352 2173 2117 2177" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2173 350 2187 364 2197 366 2197 368 2197 370 2199 599 2199 599 2197 601 2197 603 2197 616 2187 671 2197 673 2197 755 2187 812 2197 814 2197 1180 2187 1343 2199 1345 2199 1347 2199 1380 2189 1882 2189 1940 2199 1942 2199 2115 2189 2117 2177 2117 2148 2091 2136 2089 2136 2087 2136 2023 2146 1684 2136 1682 2136 1578 2146 1525 2136 1523 2136 1521 2136 1492 2146 1463 2136 1461 2136 1459 2136 1355 2146 1275 2136 1273 2136 1271 2136 1233 2146 1157 2134 1155 2134 352 2142 352 2173"/>
                        </Shape>
                        <String CONTENT="companion. The “spirit” hesitated at first, and then refused to stay. He"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l31" HPOS="350" VPOS="2195" WIDTH="1767" HEIGHT="64" BASELINE="352 2238 2117 2234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2238 352 2250 1120 2259 1122 2259 1190 2250 1229 2259 1231 2259 1233 2259 1316 2248 1590 2248 1627 2257 1629 2257 1631 2257 1676 2248 1709 2257 1711 2257 1713 2259 1942 2259 1942 2257 1944 2257 1964 2248 1980 2257 1982 2257 1983 2257 1985 2259 2115 2259 2117 2234 2113 2207 1948 2207 1921 2195 1919 2195 1917 2195 1915 2195 1913 2195 1897 2207 1570 2207 1511 2195 1510 2195 1508 2195 1470 2205 1359 2195 1357 2195 1355 2195 1353 2195 1337 2205 493 2197 491 2197 489 2197 466 2207 403 2197 401 2197 399 2197 350 2209 352 2238"/>
                        </Shape>
                        <String CONTENT="said, however, “I may consent, if your desire for my company is strong"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l32" HPOS="350" VPOS="2256" WIDTH="1769" HEIGHT="56" BASELINE="352 2297 2119 2293" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2297 352 2312 2117 2312 2119 2293 2115 2265 1269 2256 1267 2256 1265 2256 1229 2265 485 2257 483 2257 350 2267 352 2297"/>
                        </Shape>
                        <String CONTENT="enough, — if you wish me enough to take the drum, to handle it for three"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l33" HPOS="352" VPOS="2316" WIDTH="1765" HEIGHT="61" BASELINE="352 2357 2117 2357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2357 352 2369 2115 2377 2117 2357 2117 2328 1615 2316 1613 2316 1568 2326 1529 2316 1527 2316 1525 2316 1425 2326 1372 2316 1370 2316 1369 2316 1367 2316 1351 2328 1169 2328 1116 2316 1114 2316 1028 2326 991 2316 989 2316 987 2316 881 2326 775 2316 773 2316 714 2326 618 2316 616 2316 614 2316 591 2326 556 2316 554 2316 552 2316 460 2326 376 2316 374 2316 372 2316 352 2326 352 2357"/>
                        </Shape>
                        <String CONTENT="days and three nights, and to become a shaman.” Aiñanwaˊt, in his turn,"/>
                    </TextLine>

                    <TextLine ID="mz_2-146_l34" HPOS="350" VPOS="2371" WIDTH="1081" HEIGHT="67" BASELINE="352 2416 1431 2412" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="352 2416 352 2428 522 2438 524 2438 526 2438 528 2438 528 2436 538 2428 769 2428 818 2438 820 2438 891 2426 1149 2436 1151 2436 1206 2426 1216 2434 1216 2436 1218 2436 1220 2436 1222 2438 1406 2438 1406 2436 1408 2436 1431 2424 1431 2412 1425 2375 1171 2381 1147 2371 1145 2371 1143 2371 1141 2371 1100 2381 1059 2371 1057 2371 1055 2371 1053 2371 1051 2371 1051 2373 1041 2383 977 2383 930 2371 928 2371 926 2371 924 2371 912 2381 891 2371 889 2371 887 2371 697 2383 675 2373 673 2373 671 2373 669 2373 640 2383 618 2373 616 2373 614 2373 613 2373 611 2373 611 2375 601 2385 524 2385 501 2373 499 2373 497 2373 442 2383 411 2373 409 2373 407 2373 350 2385 352 2416"/>
                        </Shape>
                        <String CONTENT="refused, and the “spirit” immediately vanished.⁵"/>
                    </TextLine>
