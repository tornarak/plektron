                        </Shape>
                        <String CONTENT="least is not considered as one of the virtues of war."/>
                    </TextLine>
<TextLine ID="mz_3-112_l9" HPOS="621" VPOS="913" WIDTH="1665" HEIGHT="60" BASELINE="623 958 2286 952" TAGREFS="TYPE_4">
