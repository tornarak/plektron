                        </Shape>
                        <String CONTENT="Therefore a party of warriors, when stopping for a night on the open tundra,"/>
                    </TextLine>

                    <TextLine ID="mz_3-112_l14" HPOS="514" VPOS="1215" WIDTH="1713" HEIGHT="66" BASELINE="516 1254 2227 1258" TAGREFS="TYPE_4">
                        <Shape>
