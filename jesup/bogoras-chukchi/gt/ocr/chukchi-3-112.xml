                        </Shape>
                        <String CONTENT="their enemies, than the other tribes; so that it would seem that treachery at"/>
                    </TextLine>

                    <TextLine ID="mz_3-112_l8" HPOS="514" VPOS="858" WIDTH="1202" HEIGHT="53" BASELINE="514 897 1716 897" TAGREFS="TYPE_4">
                        <Shape>
