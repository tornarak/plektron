                        </Shape>
                        <String CONTENT="least.” The episode is repeated in other tales. I must mention also that the"/>
                    </TextLine>

                    <TextLine ID="mz_3-112_l6" HPOS="512" VPOS="733" WIDTH="1772" HEIGHT="61" BASELINE="514 776 2284 772" TAGREFS="TYPE_4">
