                <TextBlock ID="text_2-021" HPOS="407" VPOS="493" WIDTH="1780" HEIGHT="2630"><TextLine ID="mz_2-021_l1" HPOS="985" VPOS="493" WIDTH="619" HEIGHT="49" BASELINE="987 524 1604 528" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1594 493 1004 493 989 505 987 524 985 538 1600 542 1604 528 1602 505 1594 493"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l2" HPOS="2087" VPOS="497" WIDTH="86" HEIGHT="53" BASELINE="2089 532 2173 536" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2168 499 2148 497 2089 497 2089 532 2087 544 2170 550 2173 536 2173 499 2168 499"/>
                        </Shape>
                        <String CONTENT="295"/>
                    </TextLine>
<TextLine ID="mz_2-021_l3" HPOS="513" VPOS="593" WIDTH="1670" HEIGHT="70" BASELINE="515 638 2183 632" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="515 638 515 663 640 652 1034 661 1036 661 1038 661 1071 650 1132 659 1133 659 1135 659 1175 650 1265 659 1267 659 1269 659 1310 650 1457 659 1459 661 1607 661 1607 659 1609 659 1611 659 1629 648 1921 648 1936 658 1938 658 1940 658 1942 658 2181 648 2183 632 2177 597 1854 603 1817 593 1815 593 1813 593 1811 593 1792 603 1762 593 1760 593 1758 593 1756 593 1754 593 1739 603 1707 593 1705 593 1703 593 1701 593 1700 593 1682 605 1529 605 1492 595 1490 595 1488 595 1369 605 1333 595 1331 595 1329 595 1273 605 1216 595 1214 595 1212 595 1169 605 1085 595 1083 595 1081 595 1079 595 1063 607 1006 597 1004 597 824 607 722 597 720 597 646 607 534 597 532 597 530 597 528 597 513 605 515 638"/>
                        </Shape>
                        <String CONTENT="After catching a soul, they chop it to pieces, cook it in a kettle, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l4" HPOS="409" VPOS="656" WIDTH="1271" HEIGHT="54" BASELINE="409 697 1680 697" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 697 409 710 1680 710 1680 697 1680 669 1433 669 1378 656 1376 656 1374 656 1329 669 1192 669 1167 656 1165 656 1163 656 1161 656 1122 667 1094 656 1092 656 1090 656 1088 656 1043 667 1030 656 1028 656 1026 656 969 656 967 656 965 656 963 656 945 665 936 658 936 656 934 656 932 656 887 656 885 656 826 667 679 656 677 656 675 656 634 667 603 656 601 656 599 656 597 656 595 656 575 667 552 656 550 656 548 656 546 656 520 667 495 656 493 656 491 656 489 656 456 667 426 656 425 656 423 656 421 656 419 656 409 663 409 697"/>
                        </Shape>
                        <String CONTENT="feed their children with it.¹ A shaman said to me, —"/>
                    </TextLine>
<TextLine ID="mz_2-021_l5" HPOS="509" VPOS="746" WIDTH="1672" HEIGHT="54" BASELINE="511 773 2181 779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="511 773 509 789 552 800 554 800 556 800 2179 795 2181 779 2179 752 511 746 511 773"/>
                        </Shape>
                        <String CONTENT="“We are surrounded by enemies. ‘Spirits’ always walk about invisibly with gaping mouths."/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l6" HPOS="411" VPOS="799" WIDTH="1770" HEIGHT="45" BASELINE="413 828 2181 824" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 828 413 844 2179 840 2181 824 2177 799 411 799 413 828"/>
                        </Shape>
                        <String CONTENT="We are always cringing, and distributing gifts on all sides, asking protection of one, giving ransom"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l7" HPOS="409" VPOS="838" WIDTH="1206" HEIGHT="55" BASELINE="411 877 1615 869" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 877 411 893 1613 885 1615 869 1609 838 409 849 411 877"/>
                        </Shape>
                        <String CONTENT="to another, and unable to obtain anything whatsoever gratuitously.”"/>
                    </TextLine>
<TextLine ID="mz_2-021_l8" HPOS="517" VPOS="916" WIDTH="1666" HEIGHT="61" BASELINE="519 963 2183 957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="519 963 519 977 2181 971 2183 957 2179 928 1966 916 1964 916 1878 926 1846 916 1844 916 1842 916 1841 916 1819 928 1664 928 1639 916 1637 916 1635 916 1633 916 1631 916 1617 928 1586 918 1584 918 1582 918 1580 918 1537 928 1233 918 1231 918 1179 928 1141 918 1139 918 1137 918 1053 930 1034 920 1032 920 1030 920 971 930 718 920 716 920 630 930 540 920 538 920 536 920 534 920 517 928 519 963"/>
                        </Shape>
                        <String CONTENT="Aiñanwaˊt,² in his curious description of the “bad years of small-pox” on"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l9" HPOS="407" VPOS="977" WIDTH="1269" HEIGHT="60" BASELINE="409 1024 1676 1016" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="409 1024 409 1037 1674 1030 1676 1016 1672 988 1427 977 1425 977 1423 977 1421 977 1421 979 1410 990 1169 990 1041 979 1039 979 1038 979 1008 992 965 981 963 981 961 981 840 992 779 981 777 981 691 994 597 985 595 985 491 994 430 983 428 983 426 983 425 983 407 990 409 1024"/>
                        </Shape>
                        <String CONTENT="the western tundra of the Kolyma, says as follows: —"/>
                    </TextLine>
<TextLine ID="mz_2-021_l10" HPOS="515" VPOS="1079" WIDTH="1668" HEIGHT="43" BASELINE="515 1104 2183 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="515 1104 515 1122 2183 1122 2183 1104 2183 1079 515 1079 515 1104"/>
                        </Shape>
                        <String CONTENT="“Then I had a dream. A cloud came from above, like darkness. It approached slowly, like"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l11" HPOS="409" VPOS="1124" WIDTH="1774" HEIGHT="49" BASELINE="411 1157 2183 1151" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1157 411 1169 2179 1173 2183 1151 2177 1124 409 1128 411 1157"/>
                        </Shape>
                        <String CONTENT="a thick fog. I saw it approaching, and all grew dark around me. It was a black crowd, a gathering"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l12" HPOS="411" VPOS="1169" WIDTH="1770" HEIGHT="47" BASELINE="413 1200 2181 1194" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1200 413 1216 2179 1212 2181 1194 2175 1169 411 1173 413 1200"/>
                        </Shape>
                        <String CONTENT="of men clad in black. In the bright mid-day they darkened the sun completely. I asked those"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l13" HPOS="415" VPOS="1220" WIDTH="1766" HEIGHT="45" BASELINE="415 1245 2181 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1245 415 1261 2179 1265 2181 1245 2181 1220 415 1220 415 1245"/>
                        </Shape>
                        <String CONTENT="nearest, ‘What are you coming for?’ They answered, ‘We came to devour you!’ — ‘Oh,’ I said,"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l14" HPOS="411" VPOS="1263" WIDTH="1772" HEIGHT="45" BASELINE="413 1292 2183 1288" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1292 413 1308 2181 1304 2183 1288 2177 1263 411 1265 413 1292"/>
                        </Shape>
                        <String CONTENT="‘let me help you at first.’ I picked up from the ground a piece of wood, and suddenly I saw"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l15" HPOS="411" VPOS="1310" WIDTH="1772" HEIGHT="47" BASELINE="413 1341 2183 1335" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1341 413 1357 2181 1353 2183 1335 2177 1310 411 1314 413 1341"/>
                        </Shape>
                        <String CONTENT="myself soaring upwards. Then I began moving to and fro, and struck with the stick upon the top"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l16" HPOS="411" VPOS="1357" WIDTH="1770" HEIGHT="45" BASELINE="413 1386 2181 1382" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1386 413 1402 2179 1402 2181 1382 2175 1357 411 1359 413 1386"/>
                        </Shape>
                        <String CONTENT="of all tents of my camp. I struck down all the tents, but these were in reality the souls of my"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l17" HPOS="413" VPOS="1394" WIDTH="1770" HEIGHT="55" BASELINE="415 1433 2183 1429" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1433 415 1449 2181 1445 2183 1429 2179 1404 1302 1394 1300 1394 1298 1394 1255 1404 448 1396 446 1396 444 1396 413 1406 415 1433"/>
                        </Shape>
                        <String CONTENT="wife and children whom I struck down. Thus I killed all of mine with my own hand. And from"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l18" HPOS="409" VPOS="1443" WIDTH="1196" HEIGHT="51" BASELINE="411 1480 1605 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1480 411 1494 1604 1488 1605 1474 1600 1443 409 1453 411 1480"/>
                        </Shape>
                        <String CONTENT="the time of that dream the disease could seize all of my family.”³"/>
                    </TextLine>
<TextLine ID="mz_2-021_l19" HPOS="536" VPOS="1523" WIDTH="1651" HEIGHT="65" BASELINE="538 1562 2187 1566" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="538 1562 536 1572 560 1586 562 1586 564 1586 1349 1576 1361 1586 1363 1586 1365 1586 1367 1586 1950 1578 2079 1588 2081 1588 2185 1576 2187 1566 2187 1537 2146 1525 2144 1525 2142 1525 2140 1525 2099 1535 1976 1525 1974 1525 1972 1525 1936 1535 1901 1525 1899 1525 1897 1525 1895 1525 1856 1535 1721 1525 1719 1525 1672 1535 1658 1525 1656 1525 1654 1525 1652 1525 1651 1525 1619 1535 1476 1525 1474 1525 1351 1533 1337 1523 1335 1523 1333 1523 1331 1523 1284 1533 538 1527 538 1562"/>
                        </Shape>
                        <String CONTENT="“Spirits” like the inner organs of the human body, — the heart, the"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l20" HPOS="409" VPOS="1582" WIDTH="1776" HEIGHT="63" BASELINE="411 1627 2185 1623" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="411 1627 411 1641 2181 1645 2185 1623 2183 1594 2154 1582 2152 1582 2150 1582 2148 1582 2146 1582 2130 1592 2113 1582 2111 1582 2109 1582 1842 1592 1821 1582 1819 1582 1680 1582 1678 1582 1676 1582 1637 1592 1555 1582 1553 1582 1551 1582 1519 1592 1492 1582 1490 1582 1488 1582 1486 1582 1449 1592 1417 1582 1416 1582 1414 1582 1412 1582 1386 1592 1359 1582 1357 1582 1355 1582 1353 1582 1331 1592 1300 1582 1298 1582 1296 1582 1184 1594 834 1584 832 1584 830 1584 828 1584 812 1596 716 1596 685 1584 683 1584 681 1584 515 1594 426 1584 425 1584 423 1584 421 1584 409 1592 411 1627"/>
                        </Shape>
                        <String CONTENT="kidneys, and especially the liver. “Keˊlᴇ is fond of liver” (Keˊlᴇ pontaˊɪrɪnkên),"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l21" HPOS="411" VPOS="1643" WIDTH="1774" HEIGHT="66" BASELINE="413 1688 2185 1682" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1688 413 1701 1139 1709 1141 1709 1143 1709 1145 1709 1161 1699 1263 1699 1357 1709 1359 1709 1872 1697 1888 1707 1889 1707 1891 1707 1893 1709 2166 1709 2166 1707 2168 1707 2170 1707 2185 1695 2185 1682 2181 1654 2132 1643 2130 1643 2083 1652 1954 1643 1952 1643 1950 1643 1929 1652 1907 1643 1905 1643 1903 1643 1841 1652 1809 1643 1807 1643 1805 1643 1803 1643 1801 1643 1786 1654 1590 1654 1574 1645 1572 1645 1570 1645 1568 1645 1566 1645 1537 1654 1355 1645 1353 1645 1302 1654 1271 1645 1269 1645 1267 1645 1265 1645 1243 1654 1204 1645 1202 1645 1200 1645 1108 1654 1004 1645 1002 1645 930 1656 726 1646 724 1646 411 1658 413 1688"/>
                        </Shape>
                        <String CONTENT="says a proverb. The following tale is given as the reason for their peculiar"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l22" HPOS="413" VPOS="1705" WIDTH="662" HEIGHT="65" BASELINE="415 1746 1075 1742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1746 415 1758 585 1770 587 1770 589 1770 591 1770 591 1768 601 1760 609 1768 611 1768 613 1768 614 1768 673 1758 736 1768 738 1768 859 1756 949 1768 951 1768 953 1768 955 1768 955 1766 967 1756 1073 1756 1075 1742 1071 1717 920 1717 898 1705 897 1705 895 1705 893 1705 850 1715 413 1715 415 1746"/>
                        </Shape>
                        <String CONTENT="longing for human liver: —"/>
                    </TextLine>
<TextLine ID="mz_2-021_l23" HPOS="519" VPOS="1801" WIDTH="1666" HEIGHT="43" BASELINE="519 1827 2185 1827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="519 1827 519 1844 2185 1844 2185 1827 2185 1801 519 1801 519 1827"/>
                        </Shape>
                        <String CONTENT="“Once upon a time an old woman keˊlᴇ lived with her little son near a village of men. She"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l24" HPOS="413" VPOS="1846" WIDTH="1770" HEIGHT="47" BASELINE="415 1880 2183 1874" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 1880 415 1893 2181 1889 2183 1874 2177 1846 413 1850 415 1880"/>
                        </Shape>
                        <String CONTENT="had nothing to eat, and every time the villagers happened to kill a seal or a walrus, she asked for"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l25" HPOS="415" VPOS="1885" WIDTH="1770" HEIGHT="53" BASELINE="417 1925 2185 1921" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1925 417 1938 2183 1936 2185 1921 2181 1895 1414 1885 1412 1885 1296 1897 415 1897 417 1925"/>
                        </Shape>
                        <String CONTENT="its liver, and she and her child lived on that. At last the villagers got weary of the tribute."/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l26" HPOS="417" VPOS="1944" WIDTH="1768" HEIGHT="45" BASELINE="417 1972 2185 1972" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 1972 417 1983 2181 1989 2185 1972 2183 1944 417 1944 417 1972"/>
                        </Shape>
                        <String CONTENT="They enticed her son to accompany them for a drive across the ice, and killed him. Then,"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l27" HPOS="415" VPOS="1985" WIDTH="1768" HEIGHT="49" BASELINE="417 2021 2183 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2021 417 2034 2181 2032 2183 2013 2177 1985 415 1987 417 2021"/>
                        </Shape>
                        <String CONTENT="bringing back his liver, they gave it to the keˊlᴇ-woman. She did not recognize it, and, taking it"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l28" HPOS="415" VPOS="2034" WIDTH="1766" HEIGHT="47" BASELINE="417 2066 2181 2060" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2066 417 2081 2179 2081 2181 2060 2175 2034 415 2034 417 2066"/>
                        </Shape>
                        <String CONTENT="home, roasted a portion over her lamp. The remaining portion she laid down near by. Suddenly"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l29" HPOS="415" VPOS="2081" WIDTH="1768" HEIGHT="49" BASELINE="417 2113 2183 2109" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2113 417 2126 2179 2130 2183 2109 2177 2081 415 2081 417 2113"/>
                        </Shape>
                        <String CONTENT="it turned into live lice, which crawled away in all directions. After that, the keˊlet, in revenge,"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l30" HPOS="415" VPOS="2118" WIDTH="574" HEIGHT="53" BASELINE="417 2158 989 2152" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2158 417 2171 987 2167 989 2152 983 2118 415 2130 417 2158"/>
                        </Shape>
                        <String CONTENT="began to seek for human liver.”"/>
                    </TextLine>
<TextLine ID="mz_2-021_l31" HPOS="522" VPOS="2203" WIDTH="1548" HEIGHT="54" BASELINE="524 2246 2070 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="524 2246 524 2257 2068 2252 2070 2240 2064 2203 522 2209 524 2246"/>
                        </Shape>
                        <String CONTENT="The same taste for liver is ascribed by the Koryak to their kaˊla.⁴"/>
                    </TextLine>
<TextLine ID="mz_2-021_l32" HPOS="522" VPOS="2267" WIDTH="1665" HEIGHT="51" BASELINE="522 2304 2187 2304" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="522 2304 522 2318 2185 2318 2187 2304 2183 2267 522 2269 522 2304"/>
                        </Shape>
                        <String CONTENT="The keˊlet are not exempt from the attacks of shamans, who can deal"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l33" HPOS="413" VPOS="2322" WIDTH="1774" HEIGHT="55" BASELINE="415 2365 2187 2361" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2365 415 2377 2185 2373 2187 2361 2183 2332 1901 2322 1899 2322 1897 2322 1876 2332 1850 2322 1848 2322 1846 2322 1844 2322 1815 2332 1733 2322 1731 2322 1729 2322 1727 2322 1711 2334 1555 2334 1490 2322 1488 2322 1441 2332 1345 2322 1343 2322 1341 2322 1339 2322 1323 2332 1222 2324 1220 2324 1218 2324 1196 2336 838 2336 775 2324 773 2324 771 2324 732 2334 691 2324 689 2324 687 2324 685 2324 656 2334 560 2324 558 2324 556 2324 519 2334 456 2324 454 2324 452 2324 413 2336 415 2365"/>
                        </Shape>
                        <String CONTENT="with them in the same way as they deal with men. The keˊlet, on their"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l34" HPOS="413" VPOS="2379" WIDTH="1772" HEIGHT="66" BASELINE="415 2428 2185 2420" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2428 415 2445 2183 2438 2185 2420 2181 2391 2117 2379 2115 2379 2113 2379 2111 2379 2093 2393 1864 2393 1774 2379 1772 2379 1770 2379 1731 2393 1406 2381 1404 2381 1402 2381 1378 2393 1363 2381 1361 2381 1359 2381 1296 2381 1294 2381 1292 2381 1253 2393 1218 2383 1216 2383 1214 2383 1212 2383 1210 2383 1194 2395 1118 2383 1116 2383 1012 2395 998 2385 996 2385 994 2385 883 2383 881 2383 879 2383 877 2383 857 2395 685 2385 683 2385 681 2385 679 2385 660 2397 599 2385 597 2385 522 2397 505 2385 503 2385 501 2385 499 2385 413 2397 415 2428"/>
                        </Shape>
                        <String CONTENT="part, call shamans keˊlet. If a “spirit” drives with a reindeer-team and a"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l35" HPOS="413" VPOS="2444" WIDTH="1772" HEIGHT="56" BASELINE="415 2487 2185 2479" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="415 2487 415 2500 2183 2500 2185 2479 2179 2444 413 2455 415 2487"/>
                        </Shape>
                        <String CONTENT="shaman steps on the rear part of the runners of his sledge, the team will"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l36" HPOS="411" VPOS="2502" WIDTH="1776" HEIGHT="55" BASELINE="413 2545 2187 2541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2545 413 2557 2185 2555 2187 2541 2185 2514 2142 2502 2140 2502 2138 2502 2136 2502 2105 2512 2072 2502 2070 2502 2068 2502 2066 2502 2038 2514 1780 2514 1725 2502 1723 2502 1721 2502 1719 2502 1705 2512 1668 2502 1666 2502 1664 2502 1662 2502 1639 2514 411 2514 413 2545"/>
                        </Shape>
                        <String CONTENT="immediately stop, because the reindeer are aware of the presence of the"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l37" HPOS="413" VPOS="2561" WIDTH="1774" HEIGHT="65" BASELINE="415 2606 2187 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 2577 415 2606 415 2616 938 2626 940 2626 2187 2614 2187 2602 2185 2573 2160 2561 2158 2561 2156 2561 2154 2561 2134 2571 2019 2561 2017 2561 1956 2571 1933 2561 1931 2561 1929 2561 1768 2571 1737 2561 1735 2561 1733 2561 1682 2571 1631 2561 1629 2561 1627 2561 1605 2571 1531 2561 1529 2561 1527 2561 1488 2571 1472 2561 1470 2561 1468 2561 1300 2561 1298 2561 1296 2561 1261 2573 779 2563 777 2563 775 2563 738 2573 652 2563 650 2563 648 2563 646 2563 630 2575 491 2575 442 2563 440 2563 438 2563 413 2573 413 2577"/>
                        </Shape>
                        <String CONTENT="shaman. The “spirits,” unable to understand what has happened, will seek"/>
                    </TextLine>

                    <TextLine ID="mz_2-021_l38" HPOS="413" VPOS="2624" WIDTH="1770" HEIGHT="56" BASELINE="415 2665 2183 2661" TAGREFS="TYPE_5">
                        <Shape>
