                        </Shape>
                        <String CONTENT="were all masculine. He refused obstinately, however, to permit himself to be"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l25" HPOS="446" VPOS="1872" WIDTH="1771" HEIGHT="58" BASELINE="448 1915 2217 1911" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1915 448 1928 2213 1930 2217 1911 2211 1878 2038 1881 2023 1872 2021 1872 2019 1872 2017 1872 1952 1881 1933 1872 1931 1872 1929 1872 1868 1881 1833 1872 1831 1872 1829 1872 1748 1881 1721 1872 1719 1872 1717 1872 1664 1881 1586 1872 1584 1872 1582 1872 1580 1872 1564 1883 1320 1883 1196 1874 1194 1874 1192 1874 1165 1883 1139 1874 1137 1874 1135 1874 1133 1874 1092 1883 1045 1874 1043 1874 1041 1874 1039 1874 1026 1883 975 1874 973 1874 971 1874 936 1883 861 1874 859 1874 804 1883 771 1874 769 1874 767 1874 675 1883 587 1874 585 1874 583 1874 556 1883 460 1874 458 1874 456 1874 454 1874 446 1878 448 1915"/>
                        </Shape>
                        <String CONTENT="fully inspected. His husband, Yaˊtirg̣ɪn, tempted by the offered price, tried"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l26" HPOS="446" VPOS="1942" WIDTH="1771" HEIGHT="47" BASELINE="448 1972 2217 1975" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1972 446 1985 2213 1989 2217 1975 2215 1946 448 1942 448 1972"/>
                        </Shape>
                        <String CONTENT="to persuade him, but, after some useless attempts, was at last silenced by one"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l27" HPOS="446" VPOS="1999" WIDTH="1771" HEIGHT="57" BASELINE="448 2030 2217 2036" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2030 446 2046 458 2054 460 2054 462 2054 464 2054 922 2046 1039 2056 1041 2056 2215 2048 2217 2036 2213 1999 448 1999 448 2030"/>
                        </Shape>
                        <String CONTENT="scowling look from his peculiar “wife.” He felt sorry, however, that I had"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l28" HPOS="448" VPOS="2054" WIDTH="1769" HEIGHT="57" BASELINE="448 2093 2217 2093" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2093 448 2111 2215 2111 2217 2093 2217 2066 2187 2054 2185 2054 2183 2054 2130 2066 1870 2066 1854 2054 1852 2054 1850 2054 1848 2054 1846 2054 1821 2064 1770 2054 1768 2054 1713 2064 1623 2054 1621 2054 1619 2054 1580 2064 1523 2054 1521 2054 1519 2054 1488 2064 1466 2054 1464 2054 1463 2054 1412 2064 1308 2054 1306 2054 1304 2054 1275 2064 1251 2054 1249 2054 1247 2054 1171 2066 1022 2066 1000 2054 998 2054 996 2054 846 2064 781 2054 779 2054 777 2054 752 2064 736 2054 734 2054 732 2054 730 2054 448 2058 448 2093"/>
                        </Shape>
                        <String CONTENT="been baffled in gratifying my curiosity, and therefore offered me, to use his"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l29" HPOS="448" VPOS="2126" WIDTH="958" HEIGHT="41" BASELINE="448 2154 1406 2154" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2154 448 2165 1404 2167 1406 2154 1406 2126 448 2126 448 2154"/>
                        </Shape>
                        <String CONTENT="own words, his eyes in place of my own."/>
                    </TextLine>
<TextLine ID="mz_2-183_l30" HPOS="554" VPOS="2169" WIDTH="1665" HEIGHT="69" BASELINE="556 2214 2219 2210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="556 2214 556 2228 1151 2238 1153 2238 1200 2228 2217 2228 2219 2210 2217 2181 2189 2169 2187 2169 2185 2169 2183 2169 2181 2169 2166 2181 2085 2171 2083 2171 2081 2171 2079 2171 2064 2183 1938 2183 1907 2169 1905 2169 1903 2169 1901 2169 1899 2169 1882 2183 1727 2183 1688 2169 1686 2169 1684 2169 1682 2169 1660 2181 1641 2169 1639 2169 1637 2169 1635 2169 1633 2169 1598 2183 1500 2183 1474 2169 1472 2169 1470 2169 1468 2169 1441 2181 1400 2169 1398 2169 1396 2169 1394 2169 1392 2169 1380 2179 1369 2171 1367 2171 1365 2171 1363 2171 1290 2181 1265 2171 1263 2171 1261 2171 1259 2171 1229 2183 1112 2171 1110 2171 1059 2181 1034 2171 1032 2171 1030 2171 1028 2171 1002 2183 932 2171 930 2171 928 2171 895 2183 867 2171 865 2171 863 2171 554 2179 556 2214"/>
                        </Shape>
                        <String CONTENT="He described the physique of Tiluˊwg̣i as wholly masculine, and well"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l31" HPOS="444" VPOS="2238" WIDTH="1771" HEIGHT="55" BASELINE="446 2269 2215 2275" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="446 2269 444 2283 458 2293 460 2293 462 2293 464 2293 2213 2287 2215 2275 2211 2238 450 2238 446 2269"/>
                        </Shape>
                        <String CONTENT="developed besides. He confessed that he was sorry for it, but he hoped"/>
                    </TextLine>

