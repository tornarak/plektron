                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l2" HPOS="2123" VPOS="456" WIDTH="94" HEIGHT="57" BASELINE="2123 501 2217 501" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2201 466 2181 462 2162 458 2156 456 2130 464 2123 473 2123 501 2123 513 2217 513 2217 501 2217 470 2201 466"/>
                        </Shape>
                        <String CONTENT="453"/>
                    </TextLine>
<TextLine ID="mz_2-183_l3" HPOS="448" VPOS="556" WIDTH="1769" HEIGHT="62" BASELINE="450 597 2217 601" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 597 448 609 462 618 464 618 466 618 468 618 2215 612 2217 601 2215 569 2156 558 2154 558 2087 567 1933 558 1931 558 1752 567 1670 558 1668 558 1666 558 1664 558 1649 567 1600 558 1598 558 1596 558 1594 558 1576 569 1361 569 1282 556 1280 556 1278 556 1247 565 1194 556 1192 556 1190 556 1159 565 1090 556 1088 556 450 564 450 597"/>
                        </Shape>
                        <String CONTENT="the other wife of Kukuˊlpin, the human one, asks him reproachfully, “Are"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l4" HPOS="450" VPOS="616" WIDTH="1265" HEIGHT="65" BASELINE="452 658 1715 654" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="452 658 452 677 675 671 806 681 808 681 887 671 920 681 922 681 924 681 983 671 1081 681 1083 681 1085 681 1086 681 1108 669 1325 669 1414 679 1416 679 1464 669 1517 679 1519 679 1713 667 1715 654 1709 616 1216 626 1159 616 1157 616 1071 628 1028 618 1026 618 1024 618 1022 618 991 630 767 630 689 618 687 618 685 618 683 618 671 630 450 630 452 658"/>
                        </Shape>
                        <String CONTENT="you sure that you can sleep with an ‘alien’ keˊlᴇ-wife?”"/>
                    </TextLine>
<TextLine ID="mz_2-183_l5" HPOS="566" VPOS="675" WIDTH="1653" HEIGHT="63" BASELINE="567 714 2219 720" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="567 714 566 726 599 738 601 738 603 738 2217 736 2219 720 2217 691 2140 679 1915 679 1913 679 1911 679 1909 679 1893 689 1666 677 1664 677 1662 677 1629 687 1588 677 1586 677 1584 677 1443 687 1355 677 1353 677 1351 677 1310 687 908 687 895 675 893 675 891 675 889 675 887 675 850 685 820 675 818 675 816 675 814 675 789 685 567 683 567 714"/>
                        </Shape>
                        <String CONTENT="“Soft men,” of course, are supposed to excel in all branches of shamanism,"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l6" HPOS="448" VPOS="742" WIDTH="1769" HEIGHT="53" BASELINE="450 775 2217 779" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 775 448 789 2213 795 2217 779 2215 742 450 742 450 775"/>
                        </Shape>
                        <String CONTENT="including the ventriloquistic art, notwithstanding the fact that they are supposed"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l7" HPOS="450" VPOS="804" WIDTH="1769" HEIGHT="47" BASELINE="450 838 2219 838" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 838 450 849 2215 851 2219 838 2215 804 450 808 450 838"/>
                        </Shape>
                        <String CONTENT="to be women. Because of their supernatural protectors, they are dreaded"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l8" HPOS="448" VPOS="869" WIDTH="1769" HEIGHT="49" BASELINE="448 898 2217 898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 898 448 910 2213 918 2217 898 2215 869 448 869 448 898"/>
                        </Shape>
                        <String CONTENT="even by untransformed shamans, who avoid having any contests with them,"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l9" HPOS="448" VPOS="920" WIDTH="1769" HEIGHT="59" BASELINE="450 953 2217 957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 953 448 967 487 979 489 979 491 979 2215 971 2217 957 2213 920 450 922 450 953"/>
                        </Shape>
                        <String CONTENT="especially with the younger ones, because they are exceedingly “bashful,” and"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l10" HPOS="448" VPOS="988" WIDTH="1771" HEIGHT="46" BASELINE="448 1018 2219 1018" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1018 448 1032 2217 1034 2219 1018 2219 988 448 988 448 1018"/>
                        </Shape>
                        <String CONTENT="readily stand back before the pretensions of other people; but afterward the"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l11" HPOS="448" VPOS="1035" WIDTH="1034" HEIGHT="57" BASELINE="450 1079 1482 1075" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1079 450 1092 1480 1090 1482 1075 1478 1045 1032 1035 1030 1035 951 1045 630 1037 628 1037 448 1047 450 1079"/>
                        </Shape>
                        <String CONTENT="supernatural husband retaliates for the slight."/>
                    </TextLine>
<TextLine ID="mz_2-183_l12" HPOS="554" VPOS="1098" WIDTH="1666" HEIGHT="59" BASELINE="556 1133 2220 1137" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="556 1133 554 1145 577 1157 579 1157 581 1157 2219 1149 2220 1137 2220 1108 2201 1098 2199 1098 2197 1098 556 1104 556 1133"/>
                        </Shape>
                        <String CONTENT="Of all transformed shamans whom I have chanced to know, the most"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l13" HPOS="446" VPOS="1155" WIDTH="1769" HEIGHT="59" BASELINE="448 1198 2215 1194" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1198 448 1210 2211 1214 2215 1194 2211 1169 2121 1169 2089 1155 2087 1155 2085 1155 2023 1167 1999 1155 1997 1155 1995 1155 1993 1155 1991 1155 1970 1169 1905 1169 1876 1155 1874 1155 1872 1155 1870 1155 1868 1155 1848 1169 1792 1169 1743 1155 1741 1155 1739 1155 1737 1155 1700 1167 1662 1155 1660 1155 1658 1155 1588 1167 1562 1155 1560 1155 1558 1155 1492 1167 1412 1155 1410 1155 1408 1155 1406 1155 1386 1167 863 1157 861 1157 859 1157 857 1157 838 1171 707 1171 685 1157 683 1157 681 1157 581 1157 579 1157 446 1171 448 1198"/>
                        </Shape>
                        <String CONTENT="remarkable was Tiluˊwg̣i (Plate XXXIII, Fig. 1), of whom I spoke in an"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l14" HPOS="450" VPOS="1218" WIDTH="1767" HEIGHT="62" BASELINE="450 1257 2217 1257" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1257 450 1270 601 1270 616 1280 618 1280 620 1280 622 1280 722 1270 2215 1280 2217 1257 2217 1227 1901 1218 1899 1218 1821 1227 1786 1218 1784 1218 1782 1218 1705 1227 1656 1218 1654 1218 1652 1218 1631 1229 1417 1229 1339 1218 1337 1218 1335 1218 1333 1218 1316 1229 1208 1229 1173 1218 1171 1218 1169 1218 1098 1227 955 1218 953 1218 900 1227 840 1218 838 1218 836 1218 814 1227 781 1218 779 1218 777 1218 775 1218 750 1229 599 1229 522 1218 520 1218 450 1227 450 1257"/>
                        </Shape>
                        <String CONTENT="earlier part of this chapter. I met him at a small trade-gathering among"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l15" HPOS="448" VPOS="1274" WIDTH="1767" HEIGHT="65" BASELINE="450 1314 2215 1317" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1314 448 1327 462 1337 464 1337 466 1337 468 1337 534 1327 569 1337 571 1337 573 1337 701 1327 734 1337 736 1337 738 1337 740 1337 779 1327 848 1337 850 1339 1122 1339 1122 1337 1171 1327 1376 1337 1378 1337 1799 1329 1874 1339 1876 1339 1878 1339 1901 1329 1942 1339 1944 1339 1946 1339 2213 1329 2215 1317 2215 1286 2199 1276 2197 1276 2195 1276 2193 1276 2115 1286 2036 1276 2034 1276 1952 1286 1619 1276 1617 1276 1615 1276 1613 1276 1598 1288 1500 1288 1361 1276 1359 1276 1357 1276 1331 1286 1298 1274 1296 1274 1294 1274 1292 1274 1261 1284 1139 1274 1137 1274 1135 1274 1094 1286 953 1286 936 1274 934 1274 932 1274 930 1274 450 1282 450 1314"/>
                        </Shape>
                        <String CONTENT="the camps of Reindeer people on the Wolverene River. He, together with"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l16" HPOS="448" VPOS="1335" WIDTH="1771" HEIGHT="57" BASELINE="448 1376 2219 1376" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1376 448 1392 2219 1392 2219 1376 2219 1349 2140 1335 2138 1335 2081 1347 2062 1335 2060 1335 2058 1335 2056 1335 1819 1347 1756 1335 1754 1335 1690 1347 1656 1335 1654 1335 1652 1335 1651 1335 1607 1347 1582 1335 1580 1335 1578 1335 1576 1335 1539 1345 1488 1335 1486 1335 1484 1335 1439 1347 1402 1335 1400 1335 1398 1335 1396 1335 1367 1345 1261 1335 1259 1335 1257 1335 1224 1347 1175 1335 1173 1335 1171 1335 1169 1335 1167 1335 1149 1349 1092 1349 1041 1335 1039 1335 1038 1335 1036 1335 1034 1335 1016 1349 863 1349 677 1335 675 1335 673 1335 648 1349 448 1349 448 1376"/>
                        </Shape>
                        <String CONTENT="a party of traders, came from the Chukchee Peninsula. He was of Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l17" HPOS="448" VPOS="1394" WIDTH="1769" HEIGHT="63" BASELINE="450 1435 2217 1439" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1435 448 1447 2213 1457 2217 1439 2215 1408 2156 1396 2154 1396 2001 1406 1948 1396 1946 1396 1944 1396 1917 1406 1780 1396 1778 1396 1776 1396 1754 1408 1488 1408 1459 1396 1457 1396 1455 1396 1337 1406 1296 1394 1294 1394 1292 1394 1182 1406 1051 1406 1036 1394 1034 1394 1032 1394 1030 1394 936 1404 910 1394 908 1394 906 1394 904 1394 863 1404 824 1394 822 1394 820 1394 818 1394 791 1404 759 1394 757 1394 755 1394 703 1404 638 1394 636 1394 634 1394 613 1404 556 1394 554 1394 450 1402 450 1435"/>
                        </Shape>
                        <String CONTENT="origin; but his family had some reindeer, and spent most of their time tending"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l18" HPOS="450" VPOS="1457" WIDTH="1763" HEIGHT="64" BASELINE="450 1496 2213 1496" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1496 450 1509 832 1509 853 1519 855 1519 857 1519 922 1509 1030 1509 1045 1519 1047 1519 1049 1519 1051 1521 1204 1521 1204 1519 1206 1519 1208 1519 1224 1509 2211 1513 2213 1496 2213 1468 2103 1457 2101 1457 2054 1466 1551 1457 1549 1457 1547 1457 1511 1466 1414 1457 1412 1457 1410 1457 1390 1466 1302 1457 1300 1457 1298 1457 1261 1468 930 1468 914 1457 912 1457 910 1457 732 1457 730 1457 675 1466 661 1457 660 1457 658 1457 558 1457 556 1457 554 1457 524 1466 470 1457 468 1457 466 1457 464 1457 450 1464 450 1496"/>
                        </Shape>
                        <String CONTENT="the herd. Tiluˊwg̣i was young, and looked about thirty-five years of age."/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l19" HPOS="448" VPOS="1519" WIDTH="1769" HEIGHT="59" BASELINE="450 1552 2217 1556" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1552 448 1566 513 1578 515 1578 2215 1570 2217 1556 2213 1519 450 1519 450 1552"/>
                        </Shape>
                        <String CONTENT="He was tall and well developed. His large rough hands especially exhibited"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l20" HPOS="456" VPOS="1584" WIDTH="556" HEIGHT="43" BASELINE="458 1613 1012 1615" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="458 1613 456 1627 1010 1627 1012 1615 1010 1586 458 1584 458 1613"/>
                        </Shape>
                        <String CONTENT="no trace of womanhood."/>
                    </TextLine>
<TextLine ID="mz_2-183_l21" HPOS="556" VPOS="1635" WIDTH="1661" HEIGHT="60" BASELINE="558 1674 2217 1678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="558 1674 556 1688 567 1695 569 1695 571 1695 573 1695 2215 1693 2217 1678 2215 1648 1964 1637 1962 1637 1803 1646 1764 1637 1762 1637 1760 1637 1703 1646 1662 1637 1660 1637 1658 1637 1656 1637 1627 1646 1547 1637 1545 1637 1543 1637 1508 1646 1478 1637 1476 1637 1474 1637 1417 1646 1273 1637 1271 1637 1231 1645 1216 1635 1214 1635 1212 1635 1210 1635 1151 1645 1112 1635 1110 1635 1108 1635 1106 1635 1075 1645 992 1635 991 1635 989 1635 955 1645 558 1639 558 1674"/>
                        </Shape>
                        <String CONTENT="I staid for two days in his tent, and slept in his small inner room,"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l22" HPOS="450" VPOS="1695" WIDTH="1767" HEIGHT="55" BASELINE="450 1737 2217 1737" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="450 1737 450 1748 2215 1750 2217 1737 2215 1701 1770 1705 1735 1695 1733 1695 1731 1695 1729 1695 1690 1705 1609 1695 1607 1695 1605 1695 1572 1705 1500 1695 1498 1695 1496 1695 1463 1707 1200 1707 1169 1695 1167 1695 1165 1695 1163 1695 1141 1707 938 1707 902 1695 900 1695 898 1695 897 1695 867 1705 732 1695 730 1695 728 1695 726 1695 710 1707 585 1707 491 1695 489 1695 487 1695 450 1705 450 1737"/>
                        </Shape>
                        <String CONTENT="which was hardly large enough to accommodate four sleepers. Thus I had"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l23" HPOS="448" VPOS="1756" WIDTH="1767" HEIGHT="61" BASELINE="448 1795 2215 1795" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 1795 448 1809 2213 1817 2215 1795 2215 1768 1639 1756 1637 1756 1590 1766 1502 1756 1500 1756 1451 1766 1437 1756 1435 1756 1433 1756 1322 1756 1320 1756 1318 1756 1290 1766 1235 1756 1233 1756 1231 1756 1204 1766 1077 1756 1075 1756 1073 1756 1034 1766 983 1756 981 1756 908 1766 767 1756 765 1756 652 1766 526 1756 524 1756 448 1766 448 1795"/>
                        </Shape>
                        <String CONTENT="a chance to observe quite closely the details of his physique, which, of course,"/>
                    </TextLine>

                    <TextLine ID="mz_2-183_l24" HPOS="448" VPOS="1813" WIDTH="1769" HEIGHT="63" BASELINE="450 1852 2217 1856" TAGREFS="TYPE_5">
                        <Shape>
