                        </Shape>
                        <String CONTENT="446"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l2" HPOS="947" VPOS="468" WIDTH="608" HEIGHT="49" BASELINE="947 499 1555 499" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1541 468 947 468 947 499 947 517 1555 517 1555 499 1553 479 1541 468"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-174_l3" HPOS="372" VPOS="560" WIDTH="1768" HEIGHT="54" BASELINE="372 601 2140 601" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2134 569 2115 569 2095 567 2076 567 2056 567 2048 565 2030 569 1365 560 1363 560 1361 560 1335 569 1288 560 1286 560 1284 560 1263 571 1108 571 1071 560 1069 560 1067 560 1022 569 989 560 987 560 985 560 795 569 712 560 710 560 642 569 609 560 607 560 605 560 603 560 564 569 503 560 501 560 499 560 475 569 415 560 413 560 411 560 372 569 372 601 372 614 2138 614 2140 601 2140 571 2134 569 2134 569"/>
                        </Shape>
                        <String CONTENT="with his fur shirt on, and of course the knife had abundant room to slide"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l4" HPOS="370" VPOS="618" WIDTH="1373" HEIGHT="61" BASELINE="372 658 1743 661" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 658 370 671 379 679 381 679 383 679 385 679 1741 671 1743 661 1741 632 1527 632 1490 620 1488 620 1486 620 1484 620 1447 630 1396 620 1394 620 991 628 957 618 955 618 953 618 951 618 916 628 738 618 736 618 734 618 705 630 587 630 571 618 569 618 567 618 566 618 372 626 372 658"/>
                        </Shape>
                        <String CONTENT="under his arm between the ample folds of the fur garment."/>
                    </TextLine>
<TextLine ID="mz_2-174_l5" HPOS="477" VPOS="679" WIDTH="1661" HEIGHT="55" BASELINE="477 718 2138 718" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 718 477 734 2138 734 2138 718 2138 689 2095 679 2093 679 2091 679 2089 679 2060 689 2029 679 2027 679 2025 679 2023 679 1993 689 1907 679 1905 679 1903 679 1876 689 1831 679 1829 679 1827 679 1795 689 1703 679 1701 679 1645 689 1584 679 1582 679 1529 689 1500 679 1498 679 1496 679 1427 691 1333 691 1320 679 1318 679 1316 679 1314 679 1247 689 1233 679 1231 679 1229 679 1227 679 1173 691 991 691 957 679 955 679 953 679 951 679 920 691 802 691 785 679 783 679 781 679 779 679 477 687 477 718"/>
                        </Shape>
                        <String CONTENT="Scratching-Woman, however, offered to stab himself on the bare body."/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l6" HPOS="368" VPOS="736" WIDTH="1772" HEIGHT="59" BASELINE="370 781 2140 775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 781 370 795 2138 793 2140 775 2138 750 2091 736 2089 736 2087 736 2085 736 2062 748 1983 736 1982 736 1980 736 1944 748 1884 736 1882 736 1778 748 1719 736 1717 736 1521 750 1402 738 1400 738 1343 750 1284 738 1282 738 1280 738 1243 752 1075 752 1055 738 1053 738 1051 738 1049 738 914 740 912 740 910 740 891 752 820 740 818 740 816 740 781 753 575 753 556 740 554 740 552 740 550 740 481 752 417 740 415 740 368 746 370 781"/>
                        </Shape>
                        <String CONTENT="For this purpose he obliged me to give him a new knife, which, after the"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l7" HPOS="368" VPOS="799" WIDTH="1772" HEIGHT="54" BASELINE="370 840 2140 836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 840 370 853 2138 851 2140 836 2136 808 1261 799 1259 799 1257 799 1220 808 381 800 379 800 377 800 376 800 368 806 370 840"/>
                        </Shape>
                        <String CONTENT="feast, was to become his property and to be used in magic medicine. The"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l8" HPOS="370" VPOS="863" WIDTH="1770" HEIGHT="51" BASELINE="370 898 2140 898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 898 370 914 2140 914 2140 898 2138 863 370 863 370 898"/>
                        </Shape>
                        <String CONTENT="knife must be keen-edged and sharp-pointed. Then Scratching-Woman started"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l9" HPOS="368" VPOS="916" WIDTH="1772" HEIGHT="59" BASELINE="370 961 2140 955" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 961 370 975 2138 971 2140 955 2138 928 2115 916 2113 916 2111 916 2054 926 2040 916 2038 916 2036 916 2034 916 2032 916 2009 926 1884 916 1882 916 1880 916 1841 926 1778 916 1776 916 1774 916 1772 916 1756 928 1627 928 1596 916 1594 916 1592 916 1527 928 1506 918 1504 918 1502 918 1500 918 1459 928 1367 918 1365 918 1306 928 1179 918 1177 918 1049 928 368 928 370 961"/>
                        </Shape>
                        <String CONTENT="beating the drum, in order, according to his explanation, to “heat” the knife"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l10" HPOS="368" VPOS="977" WIDTH="1772" HEIGHT="57" BASELINE="370 1020 2140 1016" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1020 370 1034 2138 1030 2140 1016 2138 988 2107 977 2105 977 2103 977 2050 987 1921 977 1919 977 1842 987 1817 977 1815 977 1813 977 1811 977 1809 977 1794 988 1658 988 1609 977 1607 977 1557 987 1464 977 1463 977 1392 987 1296 977 1294 977 1292 977 1249 988 691 979 689 979 687 979 685 979 669 990 526 990 440 979 438 979 368 990 370 1020"/>
                        </Shape>
                        <String CONTENT="and to warm his body to a degree at which stabbing becomes harmless. He"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l11" HPOS="368" VPOS="1035" WIDTH="1772" HEIGHT="59" BASELINE="370 1081 2140 1075" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1081 370 1094 2138 1090 2140 1075 2134 1039 1615 1045 1551 1035 1549 1035 1547 1035 1519 1047 1441 1037 1439 1037 1437 1037 1400 1047 1343 1037 1341 1037 1235 1047 1092 1037 1090 1037 895 1049 818 1039 816 1039 814 1039 775 1049 671 1039 669 1039 607 1049 591 1039 589 1039 587 1039 450 1039 448 1039 368 1051 370 1081"/>
                        </Shape>
                        <String CONTENT="explained naïvely that the performance with the shirt on might be executed"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l12" HPOS="370" VPOS="1094" WIDTH="1770" HEIGHT="59" BASELINE="372 1139 2140 1135" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1139 372 1153 2138 1151 2140 1135 2134 1098 1750 1106 1727 1094 1725 1094 1723 1094 1721 1094 1719 1094 1703 1106 1688 1094 1686 1094 1684 1094 1682 1094 1621 1104 1598 1094 1596 1094 1594 1094 1521 1106 1472 1094 1470 1094 1468 1094 1466 1094 1464 1094 1447 1106 1431 1094 1429 1094 1427 1094 1363 1094 1361 1094 1359 1094 1327 1108 1130 1108 1047 1096 1045 1096 983 1108 965 1096 963 1096 961 1096 959 1096 902 1106 877 1096 875 1096 873 1096 871 1096 848 1108 744 1096 742 1096 740 1096 716 1108 693 1096 691 1096 689 1096 634 1106 571 1096 569 1096 567 1096 544 1108 417 1096 415 1096 413 1096 370 1110 372 1139"/>
                        </Shape>
                        <String CONTENT="without “heating” the knife. The women of his household, however, protested"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l13" HPOS="372" VPOS="1159" WIDTH="1770" HEIGHT="63" BASELINE="372 1198 2142 1198" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1198 372 1210 530 1222 532 1222 534 1222 577 1212 908 1212 934 1222 936 1222 938 1222 1077 1212 1188 1222 1190 1222 2142 1210 2142 1198 2142 1171 2044 1159 2042 1159 1942 1169 1539 1159 1537 1159 1535 1159 1533 1159 1517 1171 1365 1171 1271 1159 1269 1159 1171 1169 1118 1159 1116 1159 1114 1159 1071 1169 992 1159 991 1159 861 1169 804 1159 802 1159 752 1169 701 1159 699 1159 697 1159 669 1169 622 1159 620 1159 556 1169 542 1159 540 1159 538 1159 407 1159 405 1159 403 1159 372 1169 372 1198"/>
                        </Shape>
                        <String CONTENT="violently all the time against the performance. They even reproached me"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l14" HPOS="370" VPOS="1218" WIDTH="1770" HEIGHT="56" BASELINE="372 1259 2140 1255" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1259 372 1274 2138 1274 2140 1255 2136 1227 1255 1218 1253 1218 1251 1218 1249 1218 1237 1227 411 1220 409 1220 407 1220 370 1229 372 1259"/>
                        </Shape>
                        <String CONTENT="with wanting to shorten the shaman’s life, because, according to their words,"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l15" HPOS="370" VPOS="1274" WIDTH="1770" HEIGHT="59" BASELINE="372 1317 2140 1312" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1317 372 1333 2138 1327 2140 1312 2136 1286 2007 1274 2005 1274 2003 1274 1980 1286 1656 1286 1633 1274 1631 1274 1629 1274 1627 1274 1625 1274 1609 1284 1511 1276 1510 1276 1508 1276 1478 1286 1231 1276 1229 1276 1143 1286 1088 1276 1086 1276 883 1288 383 1278 381 1278 379 1278 377 1278 370 1284 372 1317"/>
                        </Shape>
                        <String CONTENT="feats like this, even when ending without immediate harm, are nevertheless"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l16" HPOS="370" VPOS="1335" WIDTH="1202" HEIGHT="57" BASELINE="372 1378 1572 1374" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1378 372 1392 1570 1392 1572 1374 1568 1347 1437 1347 1419 1335 1417 1335 1416 1335 1414 1335 1339 1345 1320 1335 1318 1335 1316 1335 1314 1335 1290 1345 1267 1335 1265 1335 1263 1335 1261 1335 1259 1335 1243 1347 1122 1347 1092 1335 1090 1335 1088 1335 1086 1335 1085 1335 1071 1343 1063 1337 1063 1335 1061 1335 1059 1335 991 1335 989 1335 987 1335 961 1347 898 1337 897 1337 895 1337 867 1347 710 1337 708 1337 593 1347 556 1337 554 1337 552 1337 550 1337 517 1347 379 1337 377 1337 376 1337 374 1337 374 1339 372 1339 370 1339 372 1378"/>
                        </Shape>
                        <String CONTENT="highly destructive to the vital forces of the shaman."/>
                    </TextLine>
<TextLine ID="mz_2-174_l17" HPOS="475" VPOS="1394" WIDTH="1667" HEIGHT="59" BASELINE="477 1439 2142 1433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 1439 477 1453 2140 1447 2142 1433 2140 1406 2113 1394 2111 1394 2109 1394 2056 1404 1995 1394 1993 1394 1938 1404 1919 1394 1917 1394 1915 1394 1913 1394 1911 1394 1897 1406 1656 1406 1631 1394 1629 1394 1627 1394 1625 1394 1582 1406 850 1398 848 1398 846 1398 844 1398 828 1408 573 1398 571 1398 569 1398 548 1408 497 1398 495 1398 493 1398 491 1398 475 1406 477 1439"/>
                        </Shape>
                        <String CONTENT="At last, when Scratching-Woman was almost ready to proceed with his"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l18" HPOS="368" VPOS="1455" WIDTH="1772" HEIGHT="66" BASELINE="370 1498 2140 1492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1498 370 1511 626 1521 628 1521 630 1521 632 1521 648 1511 2138 1511 2140 1492 2134 1457 1652 1464 1600 1455 1598 1455 1511 1466 1461 1457 1459 1457 1370 1466 1339 1457 1337 1457 1335 1457 1282 1466 1251 1457 1249 1457 1247 1457 1245 1457 1218 1466 1157 1457 1155 1457 1153 1457 1118 1466 1016 1457 1014 1457 893 1468 493 1458 491 1458 368 1470 370 1498"/>
                        </Shape>
                        <String CONTENT="experiment, and beat the drum for the last time, there suddenly appeared"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l19" HPOS="366" VPOS="1513" WIDTH="1768" HEIGHT="67" BASELINE="368 1558 2134 1552" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1558 368 1570 761 1570 832 1580 834 1580 1267 1568 1282 1578 1284 1578 1286 1578 1288 1580 1433 1580 1433 1578 1435 1578 1437 1578 1453 1568 1490 1578 1492 1578 1494 1578 1496 1578 1515 1568 1537 1578 1539 1578 1541 1578 1690 1568 1723 1576 1725 1576 1727 1576 1729 1576 1731 1576 1745 1566 1768 1576 1770 1576 1772 1576 1774 1576 1797 1566 1835 1576 1837 1576 1839 1578 1948 1578 1948 1576 1950 1576 1952 1576 1968 1566 2107 1576 2109 1576 2111 1576 2134 1564 2134 1552 2128 1513 2032 1523 1572 1515 1570 1515 1508 1525 1014 1517 1012 1517 949 1529 366 1529 368 1558"/>
                        </Shape>
                        <String CONTENT="on the scene a “separate voice,” which claimed to belong to a female “spirit”"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l20" HPOS="368" VPOS="1572" WIDTH="1774" HEIGHT="63" BASELINE="370 1621 2142 1611" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1621 370 1635 2140 1627 2142 1611 2138 1584 2074 1572 2072 1572 2070 1572 2048 1582 1923 1572 1921 1572 1919 1572 1891 1582 1870 1572 1868 1572 1866 1572 1782 1584 1492 1574 1490 1574 1427 1586 1312 1576 1310 1576 1224 1586 1198 1576 1196 1576 1194 1576 1075 1586 991 1578 989 1578 987 1578 961 1588 759 1578 757 1578 640 1590 391 1582 389 1582 387 1582 368 1590 370 1621"/>
                        </Shape>
                        <String CONTENT="among the acquaintances of Scratching-Woman. This new party declared that,"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l21" HPOS="372" VPOS="1645" WIDTH="1770" HEIGHT="47" BASELINE="372 1676 2142 1676" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 1676 372 1692 2142 1692 2142 1676 2142 1648 372 1645 372 1676"/>
                        </Shape>
                        <String CONTENT="Scratching-Woman, conformably to a promise given a year ago, owed her a"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l22" HPOS="366" VPOS="1693" WIDTH="1776" HEIGHT="59" BASELINE="368 1739 2142 1733" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1739 368 1752 2140 1748 2142 1733 2138 1705 1598 1693 1596 1693 1594 1693 1592 1693 1578 1703 1553 1693 1551 1693 1549 1693 1547 1693 1545 1693 1525 1705 1294 1695 1292 1695 1290 1695 1288 1695 1273 1707 1075 1707 1022 1695 1020 1695 1018 1695 996 1705 963 1695 961 1695 959 1695 898 1707 456 1697 454 1697 366 1709 368 1739"/>
                        </Shape>
                        <String CONTENT="sacrifice of a reindeer, and she requested her due, forbidding the performance"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l23" HPOS="368" VPOS="1754" WIDTH="1398" HEIGHT="57" BASELINE="370 1797 1766 1793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1797 370 1811 1764 1809 1766 1793 1764 1766 1719 1754 1717 1754 1715 1754 1435 1764 1323 1754 1322 1754 1320 1754 1294 1764 1241 1754 1239 1754 1190 1764 1165 1754 1163 1754 1161 1754 1159 1754 1124 1764 1067 1754 1065 1754 1063 1754 1026 1766 1002 1756 1000 1756 998 1756 936 1766 564 1756 562 1756 560 1756 558 1756 542 1768 442 1768 411 1756 409 1756 407 1756 405 1756 368 1768 370 1797"/>
                        </Shape>
                        <String CONTENT="of any shamanistic feats till after the liquidation of the debt."/>
                    </TextLine>
<TextLine ID="mz_2-174_l24" HPOS="475" VPOS="1815" WIDTH="1667" HEIGHT="55" BASELINE="477 1856 2142 1852" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 1856 477 1870 2140 1866 2142 1852 2138 1827 1915 1815 1913 1815 1823 1825 1772 1815 1770 1815 1768 1815 1766 1815 1752 1827 1457 1827 1423 1815 1421 1815 1419 1815 1417 1815 1388 1825 1339 1815 1337 1815 1335 1815 1288 1827 1275 1817 1273 1817 1271 1817 1269 1817 1267 1817 1237 1827 1212 1817 1210 1817 1208 1817 1128 1827 1022 1817 1020 1817 1018 1817 981 1829 673 1829 660 1817 658 1817 656 1817 654 1817 475 1825 477 1856"/>
                        </Shape>
                        <String CONTENT="Since it was summer-time, and the herds were away from the houses"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l25" HPOS="366" VPOS="1872" WIDTH="1770" HEIGHT="64" BASELINE="368 1919 2136 1911" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1919 368 1932 1692 1936 1694 1936 1696 1936 1698 1936 1713 1927 2134 1927 2136 1911 2130 1872 1856 1881 1829 1872 1827 1872 1825 1872 1768 1881 1743 1872 1741 1872 1739 1872 1737 1872 1692 1883 1658 1874 1656 1874 1654 1874 1652 1874 1627 1883 1560 1874 1558 1874 1557 1874 1535 1883 1513 1874 1511 1874 1510 1874 1453 1883 1184 1876 1182 1876 1180 1876 1179 1876 1165 1885 1110 1876 1108 1876 1106 1876 1077 1885 1032 1876 1030 1876 1028 1876 998 1885 967 1876 965 1876 963 1876 897 1885 777 1878 775 1878 773 1878 771 1878 755 1887 573 1878 571 1878 479 1887 440 1878 438 1878 436 1878 366 1889 368 1919"/>
                        </Shape>
                        <String CONTENT="and would join them only in the fall, the interdiction by the female “spirit”"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l26" HPOS="368" VPOS="1932" WIDTH="1772" HEIGHT="67" BASELINE="370 1979 2140 1974" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1979 370 1999 971 1989 1545 1997 1547 1997 1672 1987 2136 1995 2140 1974 2136 1946 1721 1932 1719 1932 1717 1932 1715 1932 1696 1946 1623 1946 1590 1932 1588 1932 1586 1932 1584 1932 1527 1946 1408 1934 1406 1934 1184 1946 1057 1934 1055 1934 992 1946 961 1934 959 1934 957 1934 955 1934 922 1948 618 1936 616 1936 556 1948 497 1936 495 1936 493 1936 491 1936 473 1948 440 1938 438 1938 436 1938 368 1950 370 1979"/>
                        </Shape>
                        <String CONTENT="put the whole matter of stabbing out of the question. Scratching-Woman,"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l27" HPOS="368" VPOS="1993" WIDTH="1772" HEIGHT="61" BASELINE="370 2036 2140 2032" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2036 370 2050 2136 2054 2140 2032 2136 2005 1839 1993 1837 1993 1745 2003 1715 1993 1713 1993 1711 1993 1629 2003 1602 1993 1600 1993 1598 1993 1596 1993 1574 2003 1535 1993 1533 1993 1531 1993 1529 1993 1508 2005 1278 2005 1257 1993 1255 1993 1253 1993 1251 1993 1226 2005 1204 1995 1202 1995 1200 1995 1102 2007 912 2007 897 1995 895 1995 893 1995 891 1995 832 2005 732 1995 730 1995 368 2003 370 2036"/>
                        </Shape>
                        <String CONTENT="however, did not wish me to think he was merely boasting of his exploits,"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l28" HPOS="368" VPOS="2056" WIDTH="1774" HEIGHT="57" BASELINE="370 2097 2142 2093" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2097 370 2111 2138 2113 2142 2093 2138 2066 1269 2056 1267 2056 1265 2056 1235 2066 438 2058 436 2058 368 2068 370 2097"/>
                        </Shape>
                        <String CONTENT="and, to prove his veracity, he showed me two deep scars on his abdomen,"/>
                    </TextLine>

                    <TextLine ID="mz_2-174_l29" HPOS="370" VPOS="2113" WIDTH="1770" HEIGHT="58" BASELINE="372 2156 2140 2150" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="372 2156 372 2171 2138 2169 2140 2150 2136 2124 2040 2113 2038 2113 2036 2113 2011 2122 1815 2113 1813 2113 1811 2113 1790 2122 1762 2113 1760 2113 1758 2113 1658 2122 1553 2113 1551 2113 1549 2113 1547 2113 1531 2124 1339 2115 1337 2115 1280 2124 1243 2115 1241 2115 1239 2115 1014 2124 985 2115 983 2115 981 2115 889 2126 599 2116 597 2116 595 2116 562 2126 520 2116 519 2116 517 2116 370 2128 372 2156"/>
                        </Shape>
                        <String CONTENT="one of which, he asserted, was produced by the knife, and the other by a"/>
                    </TextLine>

