            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-136" HPOS="646" VPOS="623" WIDTH="1799" HEIGHT="2628"><TextLine ID="mz_1-136_l1" HPOS="1230" VPOS="623" WIDTH="617" HEIGHT="54" BASELINE="1230 656 1847 656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1837 636 1821 623 1245 623 1230 636 1230 656 1230 677 1847 677 1847 656 1843 645 1837 636"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l2" HPOS="654" VPOS="632" WIDTH="106" HEIGHT="54" BASELINE="654 660 760 660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 634 654 660 654 673 721 686 723 686 726 686 760 673 760 660 760 632 656 632 654 634"/>
                        </Shape>
                        <String CONTENT="104"/>
                    </TextLine>
<TextLine ID="mz_1-136_l3" HPOS="648" VPOS="723" WIDTH="1771" HEIGHT="58" BASELINE="648 766 2419 766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2246 723 2244 723 2242 723 2239 723 2207 734 2058 723 2055 723 2053 723 2027 734 1967 723 1964 723 1962 723 1934 734 1902 723 1899 723 1897 723 1834 734 1780 723 1778 723 1711 734 1603 723 1601 723 1598 723 1566 734 1510 723 1507 723 1505 723 1477 734 1447 723 1445 723 1442 723 1393 734 1360 723 1358 723 1356 723 1276 734 1222 723 1219 723 1111 734 951 723 949 723 947 723 916 734 864 723 862 723 860 723 830 734 648 731 648 766 648 781 2419 781 2419 766 2419 736 2268 736 2248 723 2246 723"/>
                        </Shape>
                        <String CONTENT="had to be kept carefully tied all the time. The Siberian harness-dogs are"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l4" HPOS="648" VPOS="790" WIDTH="1771" HEIGHT="58" BASELINE="650 822 2419 827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 822 648 835 674 848 676 848 678 848 2417 840 2419 827 2417 790 650 790 650 822"/>
                        </Shape>
                        <String CONTENT="more given to howling than barking. Their howl is long and whining, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l5" HPOS="650" VPOS="857" WIDTH="1771" HEIGHT="45" BASELINE="650 885 2421 885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 885 650 902 2421 902 2421 885 2421 857 650 857 650 885"/>
                        </Shape>
                        <String CONTENT="ends with an occasional yelp. On winter nights the whole canine population"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l6" HPOS="650" VPOS="911" WIDTH="1771" HEIGHT="52" BASELINE="650 946 2421 946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 946 650 963 2421 963 2421 946 2419 911 650 913 650 946"/>
                        </Shape>
                        <String CONTENT="of the village, often several hundred head strong, will raise a chorus that will"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l7" HPOS="648" VPOS="967" WIDTH="1728" HEIGHT="55" BASELINE="650 1002 2376 1009" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1002 648 1015 2372 1022 2376 1009 2374 976 650 967 650 1002"/>
                        </Shape>
                        <String CONTENT="last for half an hour, subsiding several times, and then breaking out again."/>
                    </TextLine>
<TextLine ID="mz_1-136_l8" HPOS="749" VPOS="1030" WIDTH="1668" HEIGHT="61" BASELINE="752 1063 2417 1069" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="752 1063 749 1073 780 1089 782 1089 784 1089 786 1089 830 1078 879 1089 882 1091 1135 1091 1135 1089 1137 1089 1139 1089 1154 1078 1248 1078 1261 1089 1263 1089 1265 1089 1267 1089 2415 1084 2417 1069 2415 1037 752 1030 752 1063"/>
                        </Shape>
                        <String CONTENT="Of dog-diseases, the peculiar Arctic form of rabies occurs frequently,"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l9" HPOS="646" VPOS="1082" WIDTH="1773" HEIGHT="69" BASELINE="648 1125 2419 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1125 648 1141 1193 1151 1196 1151 1198 1151 1200 1151 1215 1141 2417 1141 2419 1121 2415 1093 1536 1082 1533 1082 1531 1082 1529 1082 1512 1093 765 1084 762 1084 646 1095 648 1125"/>
                        </Shape>
                        <String CONTENT="especially in the spring. I observed that it occurred most frequently after a"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l10" HPOS="648" VPOS="1149" WIDTH="1773" HEIGHT="52" BASELINE="648 1186 2421 1186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1186 648 1201 2421 1201 2421 1186 2421 1156 648 1149 648 1186"/>
                        </Shape>
                        <String CONTENT="long course on the open tundra; and, according to native ideas, it results"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l11" HPOS="650" VPOS="1212" WIDTH="1771" HEIGHT="52" BASELINE="650 1245 2421 1245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1245 650 1264 2421 1264 2421 1245 2421 1214 650 1212 650 1245"/>
                        </Shape>
                        <String CONTENT="from the action upon the brain of the excessive brightness of the snow, analogous"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l12" HPOS="650" VPOS="1275" WIDTH="1769" HEIGHT="47" BASELINE="650 1305 2419 1305" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1305 650 1322 2419 1322 2419 1305 2419 1275 650 1275 650 1305"/>
                        </Shape>
                        <String CONTENT="to the spring snow-blindness of men. Dog-rabies, however, is not so bad in"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l13" HPOS="648" VPOS="1322" WIDTH="1771" HEIGHT="61" BASELINE="650 1366 2419 1361" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1366 650 1383 2417 1379 2419 1361 2415 1333 1538 1322 1536 1322 1533 1322 1499 1333 734 1325 732 1325 648 1335 650 1366"/>
                        </Shape>
                        <String CONTENT="northern as in southern latitudes; and, though I have known of many men"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l14" HPOS="650" VPOS="1383" WIDTH="1771" HEIGHT="59" BASELINE="650 1424 2421 1424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1424 650 1442 2421 1442 2421 1424 2421 1396 2369 1383 2367 1383 2365 1383 2335 1394 2244 1383 2242 1383 2239 1383 2209 1394 2166 1383 2164 1383 2161 1383 2105 1394 2040 1383 2038 1383 2036 1383 1993 1394 1980 1383 1977 1383 1975 1383 1973 1383 1971 1383 1945 1394 1845 1383 1843 1383 1841 1383 1804 1394 1774 1383 1772 1383 1769 1383 1767 1383 1724 1394 1663 1383 1661 1383 1659 1383 1633 1396 1410 1396 1395 1383 1393 1383 1391 1383 1388 1383 1317 1394 1239 1383 1237 1383 1235 1383 1211 1394 1193 1383 1191 1383 1189 1383 1187 1383 1074 1394 650 1387 650 1424"/>
                        </Shape>
                        <String CONTENT="being bitten by a rabid dog, I have never heard of any bad results from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l15" HPOS="650" VPOS="1448" WIDTH="1769" HEIGHT="54" BASELINE="650 1485 2419 1485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1485 650 1502 2419 1502 2419 1485 2419 1455 650 1448 650 1485"/>
                        </Shape>
                        <String CONTENT="bite, but I have heard of some such cases with rabid wolves. However, any"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l16" HPOS="646" VPOS="1509" WIDTH="1773" HEIGHT="52" BASELINE="648 1539 2419 1545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1539 646 1554 2415 1561 2419 1545 2417 1509 648 1509 648 1539"/>
                        </Shape>
                        <String CONTENT="dog bitten by a rabid one will itself go mad, and sometimes, when the rabid"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l17" HPOS="646" VPOS="1569" WIDTH="1773" HEIGHT="63" BASELINE="648 1600 2419 1606" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1600 646 1617 661 1628 663 1628 665 1628 667 1628 758 1617 773 1628 775 1628 778 1628 780 1628 782 1628 817 1617 856 1628 858 1628 860 1628 923 1617 1165 1617 1261 1630 1263 1630 1265 1630 1297 1619 1432 1630 1434 1630 1436 1630 1473 1619 1527 1630 1529 1630 1808 1621 1824 1632 1826 1632 1828 1632 1830 1632 2417 1623 2419 1606 2417 1576 648 1569 648 1600"/>
                        </Shape>
                        <String CONTENT="dog is not killed in time, several teams will be greatly injured. On long"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l18" HPOS="648" VPOS="1630" WIDTH="1773" HEIGHT="61" BASELINE="648 1665 2421 1665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1665 648 1691 2421 1682 2421 1665 2421 1634 648 1630 648 1665"/>
                        </Shape>
                        <String CONTENT="journeys the drivers simply muzzle the rabid dogs at first, so that they cannot"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l19" HPOS="648" VPOS="1688" WIDTH="1773" HEIGHT="54" BASELINE="648 1725 2421 1725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1725 648 1742 2421 1742 2421 1725 2421 1695 648 1688 648 1725"/>
                        </Shape>
                        <String CONTENT="bite their companions; and they continue to drive them thus for two or three"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l20" HPOS="646" VPOS="1751" WIDTH="1775" HEIGHT="50" BASELINE="648 1781 2421 1786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1781 646 1797 2417 1801 2421 1786 2419 1755 648 1751 648 1781"/>
                        </Shape>
                        <String CONTENT="successive days, as I witnessed when travelling among the Chukchee between"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l21" HPOS="648" VPOS="1810" WIDTH="1773" HEIGHT="52" BASELINE="650 1842 2421 1846" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1842 648 1857 2417 1862 2421 1846 2419 1814 650 1810 650 1842"/>
                        </Shape>
                        <String CONTENT="Anadyr and Indian Point in March, 1901. Dr. Slunin¹ asserts that animals bitten"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l22" HPOS="648" VPOS="1864" WIDTH="1773" HEIGHT="65" BASELINE="650 1903 2421 1907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 1903 648 1914 669 1927 672 1927 674 1927 1499 1918 1538 1929 1540 1929 1542 1929 2419 1918 2421 1907 2419 1875 650 1864 650 1903"/>
                        </Shape>
                        <String CONTENT="by a rabid dog are not infected. However, I had dogs in my own team"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l23" HPOS="648" VPOS="1935" WIDTH="1773" HEIGHT="50" BASELINE="648 1965 2421 1965" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 1965 648 1985 2421 1978 2421 1965 2421 1935 648 1935 648 1965"/>
                        </Shape>
                        <String CONTENT="perish from such cause. A dog suspected of being rabid is speedily made"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l24" HPOS="646" VPOS="1991" WIDTH="1773" HEIGHT="57" BASELINE="648 2022 2419 2026" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2022 646 2035 730 2048 732 2048 2417 2043 2419 2026 2417 1996 648 1991 648 2022"/>
                        </Shape>
                        <String CONTENT="away with, for fear that it may bite some of its companions — except on long"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l25" HPOS="650" VPOS="2041" WIDTH="1795" HEIGHT="70" BASELINE="652 2085 2445 2082" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 2085 652 2111 2404 2111 2404 2108 2406 2108 2445 2095 2445 2082 2439 2041 2374 2054 2194 2054 2174 2041 2172 2041 2170 2041 2168 2041 2075 2052 2023 2041 2021 2041 2019 2041 1986 2054 1837 2054 1813 2041 1811 2041 1808 2041 1806 2041 1785 2052 1763 2041 1761 2041 1759 2041 1756 2041 1726 2052 1650 2041 1648 2041 1646 2041 1618 2052 1549 2041 1546 2041 1468 2052 1308 2041 1306 2041 1304 2041 1274 2052 1193 2041 1191 2041 1126 2052 1061 2041 1059 2041 1057 2041 1020 2052 936 2041 934 2041 877 2052 650 2046 652 2085"/>
                        </Shape>
                        <String CONTENT="journeys, when the driver has to utilize the whole strength of his team. I"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l26" HPOS="648" VPOS="2111" WIDTH="1776" HEIGHT="49" BASELINE="650 2139 2424 2143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2139 648 2156 2419 2160 2424 2143 2421 2115 650 2111 650 2139"/>
                        </Shape>
                        <String CONTENT="would also mention a kind of palsy — a disease of northern dogs, that affects"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l27" HPOS="646" VPOS="2169" WIDTH="1775" HEIGHT="52" BASELINE="648 2199 2421 2206" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2199 646 2214 2417 2221 2421 2206 2419 2175 648 2169 648 2199"/>
                        </Shape>
                        <String CONTENT="the head of the animal, and disables it for walking — and a kind of cramp"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l28" HPOS="646" VPOS="2230" WIDTH="1775" HEIGHT="52" BASELINE="648 2260 2421 2264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2260 646 2277 2417 2282 2421 2264 2419 2234 648 2230 648 2260"/>
                        </Shape>
                        <String CONTENT="that often precedes the palsy. Both diseases are contagious, and may destroy"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l29" HPOS="646" VPOS="2290" WIDTH="1775" HEIGHT="63" BASELINE="648 2321 2421 2327" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2321 646 2336 1884 2353 1886 2353 2419 2342 2421 2327 2419 2297 648 2290 648 2321"/>
                        </Shape>
                        <String CONTENT="a whole team in twenty-four hours, since the animal generally dies with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l30" HPOS="646" VPOS="2338" WIDTH="188" HEIGHT="58" BASELINE="648 2379 834 2383" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2379 646 2392 830 2396 834 2383 834 2353 799 2340 797 2340 795 2340 793 2340 758 2351 685 2338 682 2338 680 2338 648 2347 648 2379"/>
                        </Shape>
                        <String CONTENT="first fit."/>
                    </TextLine>
<TextLine ID="mz_1-136_l31" HPOS="752" VPOS="2398" WIDTH="1669" HEIGHT="72" BASELINE="754 2440 2421 2446" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="754 2440 752 2455 1258 2457 1310 2470 1313 2470 2419 2461 2421 2446 2421 2414 2408 2403 2406 2403 2404 2403 2402 2403 2400 2403 2367 2414 2287 2403 2285 2403 2211 2414 2190 2403 2187 2403 2066 2403 2064 2403 2062 2403 2060 2403 2047 2416 1902 2416 1889 2403 1886 2403 1884 2403 1882 2403 1769 2411 1746 2401 1744 2401 1741 2401 1739 2401 1698 2411 1614 2401 1611 2401 1609 2401 1575 2411 1373 2401 1371 2401 1310 2411 1293 2398 1291 2398 1289 2398 1287 2398 1284 2398 1256 2409 1211 2398 1209 2398 1206 2398 1137 2409 754 2407 754 2440"/>
                        </Shape>
                        <String CONTENT="DOG-DRIVING. — The dog-sledge now in use in northeastern Siberia (Fig. 21)"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l32" HPOS="650" VPOS="2466" WIDTH="1771" HEIGHT="56" BASELINE="650 2502 2421 2502" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2502 650 2522 2421 2522 2421 2502 2421 2472 650 2466 650 2502"/>
                        </Shape>
                        <String CONTENT="is long and narrow, and has three or four pairs of stanchions. The lower end"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l33" HPOS="648" VPOS="2528" WIDTH="1771" HEIGHT="61" BASELINE="650 2559 2419 2565" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2559 648 2574 1300 2589 1302 2589 2417 2585 2419 2565 2417 2535 650 2528 650 2559"/>
                        </Shape>
                        <String CONTENT="of the stanchion is cut off square, except a rough peg which is left standing"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l34" HPOS="648" VPOS="2578" WIDTH="1769" HEIGHT="63" BASELINE="650 2619 2417 2626" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2619 648 2634 2413 2641 2417 2626 2417 2595 2391 2583 2389 2583 2387 2583 2385 2583 2350 2593 2168 2583 2166 2583 1973 2593 1956 2583 1954 2583 1951 2583 1949 2583 1947 2583 1906 2593 1876 2583 1873 2583 1871 2583 1869 2583 1845 2593 1828 2580 1826 2580 1824 2580 1821 2580 1819 2580 1789 2591 1772 2580 1769 2580 1767 2580 1765 2580 1763 2580 1741 2591 1692 2580 1689 2580 1635 2591 1614 2580 1611 2580 1609 2580 1607 2580 1583 2591 1481 2580 1479 2580 1421 2591 1291 2580 1289 2580 1287 2580 1265 2591 1239 2578 1237 2578 1235 2578 1232 2578 1230 2578 1213 2589 650 2583 650 2619"/>
                        </Shape>
                        <String CONTENT="in the middle. The peg is inserted in a circular hole in the runner (Fig. 21, b)."/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l35" HPOS="650" VPOS="2643" WIDTH="1771" HEIGHT="59" BASELINE="652 2680 2421 2686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 2680 650 2695 2417 2702 2421 2686 2419 2654 652 2643 652 2680"/>
                        </Shape>
                        <String CONTENT="Each pair of stanchions is joined at half their height by a round stick, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l36" HPOS="646" VPOS="2706" WIDTH="1775" HEIGHT="63" BASELINE="648 2741 2421 2745" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2741 646 2754 862 2767 864 2767 1531 2758 1544 2769 1546 2769 1549 2769 1551 2769 2419 2758 2421 2745 2419 2715 648 2706 648 2741"/>
                        </Shape>
                        <String CONTENT="is mortised into a circular hole in the stanchion. A thin, broad plank — or"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l37" HPOS="648" VPOS="2771" WIDTH="1776" HEIGHT="50" BASELINE="650 2799 2424 2803" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2799 648 2816 2419 2821 2424 2803 2424 2773 650 2771 650 2799"/>
                        </Shape>
                        <String CONTENT="rather two planks laced together — rests on these sticks. Two rails are fastened"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l38" HPOS="646" VPOS="2821" WIDTH="1773" HEIGHT="62" BASELINE="648 2857 2419 2868" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2857 646 2873 2415 2883 2419 2868 2417 2838 2073 2838 2014 2825 2012 2825 1726 2834 1707 2823 1705 2823 1702 2823 1700 2823 1414 2831 1356 2821 1354 2821 648 2825 648 2857"/>
                        </Shape>
                        <String CONTENT="on the upper ends of the stanchions, and are lashed to the boards with thong,"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l39" HPOS="648" VPOS="2879" WIDTH="1773" HEIGHT="72" BASELINE="650 2920 2421 2927" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 2920 648 2933 1356 2948 1358 2948 1826 2940 1852 2951 1854 2951 1856 2951 2419 2940 2421 2927 2419 2896 2109 2896 2049 2883 2047 2883 1960 2894 1921 2883 1919 2883 1917 2883 1915 2883 1912 2883 1897 2894 1867 2883 1865 2883 1863 2883 1860 2883 1830 2894 1785 2881 1782 2881 1780 2881 1778 2881 1752 2892 1728 2881 1726 2881 1724 2881 1572 2892 1531 2881 1529 2881 1527 2881 1525 2881 1501 2894 1369 2894 1196 2879 1193 2879 1191 2879 1148 2890 1120 2879 1118 2879 1115 2879 650 2888 650 2920"/>
                        </Shape>
                        <String CONTENT="which forms a kind of retaining-net all around the sledge. The runners are"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l40" HPOS="646" VPOS="2948" WIDTH="1767" HEIGHT="55" BASELINE="648 2979 2413 2987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="648 2979 646 2994 2408 3003 2413 2987 2411 2957 648 2948 648 2979"/>
                        </Shape>
                        <String CONTENT="flat, and their front ends are strongly curved and tied to a strong wooden bow,"/>
                    </TextLine>

                    <TextLine ID="mz_1-136_l41" HPOS="648" VPOS="3007" WIDTH="1771" HEIGHT="56" BASELINE="650 3039 2419 3048" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="650 3039 648 3054 2415 3063 2419 3048 2417 3016 650 3007 650 3039"/>
                        </Shape>
                        <String CONTENT="which is fastened to the foremost stanchions with strong lashings (Fig. 21, c)."/>
                    </TextLine>

