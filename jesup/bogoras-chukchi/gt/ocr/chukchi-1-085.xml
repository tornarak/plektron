                        </Shape>
                        <String CONTENT="have a longing for tobacco, and pay for it with large fish and otters."/>
                    </TextLine>
<TextLine ID="mz_1-085_l42" HPOS="505" VPOS="3063" WIDTH="1652" HEIGHT="50" BASELINE="505 3093 2157 3093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="505 3093 505 3113 2157 3113 2157 3093 2157 3065 505 3063 505 3093"/>
                        </Shape>
                        <String CONTENT="“Still deeper in the woods live dwarfs not larger than the fore-arm of a"/>
