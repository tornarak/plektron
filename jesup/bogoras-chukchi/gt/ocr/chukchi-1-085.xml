                <TextBlock ID="text_1-085" HPOS="377" VPOS="617" WIDTH="1780" HEIGHT="2619"><TextLine ID="mz_1-085_l1" HPOS="957" VPOS="617" WIDTH="620" HEIGHT="52" BASELINE="957 649 1577 649" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1564 617 957 617 957 649 957 669 1577 669 1577 649 1575 638 1564 617"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l2" HPOS="2081" VPOS="619" WIDTH="37" HEIGHT="63" BASELINE="2090 664 2116 660" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2090 664 2092 682 2118 679 2116 660 2105 619 2081 619 2090 664"/>
                        </Shape>
                        <String CONTENT="59"/>
                    </TextLine>
<TextLine ID="mz_1-085_l3" HPOS="377" VPOS="716" WIDTH="1774" HEIGHT="61" BASELINE="379 762 2151 755" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 762 379 777 2148 770 2151 755 2146 725 968 716 966 716 377 729 379 762"/>
                        </Shape>
                        <String CONTENT="names. The trouble evidently arose from their being unable to understand a"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l4" HPOS="377" VPOS="777" WIDTH="1776" HEIGHT="61" BASELINE="379 822 2153 816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 822 379 838 2151 831 2153 816 2148 786 970 777 968 777 966 777 964 777 944 788 403 779 401 779 399 779 377 788 379 822"/>
                        </Shape>
                        <String CONTENT="single word of each other’s language; though Kudrin, now deceased, had the"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l5" HPOS="377" VPOS="833" WIDTH="1776" HEIGHT="63" BASELINE="379 881 2153 876" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 881 379 896 2151 892 2153 876 2151 846 2118 833 2116 833 2114 833 2112 833 2109 833 2092 844 2038 833 2036 833 2034 833 2006 844 1806 833 1804 833 1726 844 1700 833 1698 833 1696 833 1635 844 1572 833 1570 833 1507 844 1462 833 1460 833 1458 833 1401 844 1388 833 1386 833 1384 833 1382 833 1380 833 1343 844 1274 833 1271 833 1269 833 1267 833 1252 846 1200 835 1198 835 1196 835 1174 846 1152 835 1150 835 1148 835 1068 846 981 835 979 835 977 835 953 848 795 848 762 835 760 835 758 835 756 835 754 835 736 846 672 835 669 835 576 846 544 835 542 835 539 835 537 835 535 835 516 848 377 848 379 881"/>
                        </Shape>
                        <String CONTENT="reputation of being out of his mind. His brother, Theodore Kudrin, who is"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l6" HPOS="381" VPOS="909" WIDTH="1718" HEIGHT="48" BASELINE="381 939 2099 939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 939 381 957 2097 957 2099 939 2097 909 381 909 381 939"/>
                        </Shape>
                        <String CONTENT="still living, is even one of the few Russian shamans of the Lower Kolyma."/>
                    </TextLine>
<TextLine ID="mz_1-085_l7" HPOS="487" VPOS="954" WIDTH="1664" HEIGHT="72" BASELINE="490 1000 2151 996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="490 1000 490 1015 710 1026 713 1026 765 1015 1128 1015 1245 1026 1248 1026 1250 1026 1293 1015 1828 1024 1830 1024 2040 1013 2125 1024 2127 1024 2129 1024 2131 1024 2151 1011 2151 996 2146 967 2071 954 2068 954 2066 954 2040 965 2006 954 2003 954 2001 954 1923 967 1442 967 1419 954 1416 954 1414 954 1315 967 1191 957 1189 957 1126 967 1081 957 1079 957 1076 957 1022 967 994 957 992 957 990 957 988 957 947 967 903 957 901 957 899 957 897 957 866 967 845 957 843 957 840 957 838 957 795 967 739 957 736 957 487 963 490 1000"/>
                        </Shape>
                        <String CONTENT="The people of the Pacific villages continue to go every year with dog-"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l8" HPOS="379" VPOS="1030" WIDTH="1774" HEIGHT="46" BASELINE="379 1058 2153 1058" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1041 379 1058 379 1076 2153 1076 2153 1058 2153 1030 381 1030 379 1041"/>
                        </Shape>
                        <String CONTENT="teams to the Russian settlements on the Anadyr, because the route to that"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l9" HPOS="379" VPOS="1076" WIDTH="1774" HEIGHT="67" BASELINE="381 1121 2153 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1121 381 1143 2151 1128 2153 1112 2148 1084 1287 1076 1284 1076 1282 1076 1258 1086 438 1080 435 1080 379 1091 381 1121"/>
                        </Shape>
                        <String CONTENT="point is much shorter than to the Anui. The best place for meeting is not"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l10" HPOS="379" VPOS="1134" WIDTH="1774" HEIGHT="61" BASELINE="381 1180 2153 1173" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1180 381 1195 2151 1188 2153 1173 2148 1145 1562 1134 1559 1134 1557 1134 1533 1145 973 1136 970 1136 968 1136 942 1147 479 1138 477 1138 379 1149 381 1180"/>
                        </Shape>
                        <String CONTENT="at the fairs mentioned above, but in the neighborhood of the mouth of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l11" HPOS="379" VPOS="1193" WIDTH="1772" HEIGHT="65" BASELINE="381 1240 2151 1234" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1240 381 1258 2148 1251 2151 1234 2148 1206 2116 1193 2114 1193 2112 1193 2016 1203 1468 1195 1466 1195 1464 1195 1462 1195 1447 1206 877 1197 875 1197 873 1197 871 1197 856 1208 810 1197 808 1197 806 1197 804 1197 771 1208 626 1197 624 1197 552 1208 401 1197 399 1197 396 1197 394 1197 379 1206 381 1240"/>
                        </Shape>
                        <String CONTENT="Anadyr, whither the journey from the nearest Chukchee village, across Holy"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l12" HPOS="379" VPOS="1253" WIDTH="1772" HEIGHT="65" BASELINE="381 1303 2151 1294" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1303 381 1318 2148 1309 2151 1294 2148 1266 2099 1253 2097 1253 2094 1253 2092 1253 2045 1264 1663 1255 1661 1255 1659 1255 1657 1255 1644 1266 1607 1255 1605 1255 1603 1255 1601 1255 1577 1268 1440 1268 1334 1255 1332 1255 1252 1268 1226 1258 1224 1258 1222 1258 1027 1268 988 1258 986 1258 983 1258 981 1258 949 1268 908 1258 905 1258 903 1258 821 1271 773 1260 771 1260 769 1260 624 1271 535 1260 533 1260 531 1260 529 1260 511 1271 396 1260 394 1260 392 1260 390 1260 379 1266 381 1303"/>
                        </Shape>
                        <String CONTENT="Cross Bay, can be made, in the spring of the year, in five or six days. For"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l13" HPOS="377" VPOS="1322" WIDTH="1776" HEIGHT="55" BASELINE="379 1359 2153 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1359 379 1377 2151 1370 2153 1353 2146 1322 377 1325 379 1359"/>
                        </Shape>
                        <String CONTENT="half a century the meeting-place has been on the tundra, twenty miles north-"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l14" HPOS="379" VPOS="1372" WIDTH="1774" HEIGHT="65" BASELINE="381 1422 2153 1413" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1422 381 1437 2151 1429 2153 1413 2148 1383 2090 1372 2088 1372 2025 1383 2001 1372 1999 1372 1997 1372 1930 1383 1897 1372 1895 1372 1893 1372 1824 1383 1791 1372 1789 1372 1787 1372 1692 1385 1670 1374 1668 1374 1666 1374 1549 1385 1490 1374 1488 1374 1486 1374 1462 1385 1410 1374 1408 1374 1406 1374 1403 1374 1386 1385 1183 1377 1180 1377 1178 1377 1141 1387 1096 1377 1094 1377 1092 1377 1089 1377 1050 1387 953 1377 951 1377 901 1387 869 1377 866 1377 864 1377 799 1390 533 1379 531 1379 529 1379 526 1379 509 1390 479 1379 477 1379 474 1379 379 1390 381 1422"/>
                        </Shape>
                        <String CONTENT="ward from the mouth of the Anadyr, near the Hare Mountains; but for the"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l15" HPOS="377" VPOS="1442" WIDTH="1771" HEIGHT="56" BASELINE="379 1483 2148 1474" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1483 379 1498 2146 1489 2148 1474 2142 1442 377 1446 379 1483"/>
                        </Shape>
                        <String CONTENT="last ten years two small fairs have been arranged instead at Mariinsky Post, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l16" HPOS="379" VPOS="1494" WIDTH="1776" HEIGHT="62" BASELINE="381 1541 2155 1535" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1541 381 1556 2153 1550 2155 1535 2151 1502 1886 1494 1884 1494 1806 1504 1752 1494 1750 1494 1748 1494 1715 1504 1663 1494 1661 1494 1659 1494 1657 1494 1640 1504 1531 1496 1529 1496 1527 1496 1503 1509 1282 1509 1230 1496 1228 1496 1226 1496 1196 1506 1157 1496 1154 1496 1152 1496 1150 1496 1148 1496 1133 1506 1057 1496 1055 1496 1053 1496 1018 1506 886 1498 884 1498 754 1509 717 1498 715 1498 713 1498 630 1509 570 1498 568 1498 565 1498 529 1509 492 1498 490 1498 487 1498 379 1511 381 1541"/>
                        </Shape>
                        <String CONTENT="one in the spring, and the other in the summer, about the time of the arrival"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l17" HPOS="381" VPOS="1554" WIDTH="1772" HEIGHT="65" BASELINE="383 1602 2153 1591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1602 383 1619 2151 1608 2153 1591 2148 1563 1445 1554 1442 1554 1440 1554 1438 1554 1423 1565 1096 1556 1094 1556 1092 1556 1089 1556 1089 1558 1079 1567 418 1561 416 1561 414 1561 381 1571 383 1602"/>
                        </Shape>
                        <String CONTENT="of the mail-steamer. In the spring about fifty dog-sledges come from the Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l18" HPOS="379" VPOS="1610" WIDTH="1774" HEIGHT="68" BASELINE="381 1662 2153 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1662 381 1678 2151 1669 2153 1652 2146 1621 1902 1621 1873 1610 1871 1610 1869 1610 1867 1610 1865 1610 1845 1623 1724 1623 1702 1613 1700 1613 1698 1613 1696 1613 1661 1623 1637 1613 1635 1613 1633 1613 1531 1623 1442 1613 1440 1613 1438 1613 1399 1626 1105 1615 1102 1615 1100 1615 1098 1615 1079 1628 853 1617 851 1617 771 1628 734 1617 732 1617 730 1617 518 1630 409 1619 407 1619 405 1619 379 1628 381 1662"/>
                        </Shape>
                        <String CONTENT="chee and Eskimo villages as far as Indian Point, and about twice as many"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l19" HPOS="379" VPOS="1673" WIDTH="1774" HEIGHT="74" BASELINE="381 1723 2153 1712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1723 381 1736 685 1747 687 1747 689 1747 736 1734 1083 1742 1085 1742 1332 1732 1440 1742 1442 1742 1514 1729 1772 1740 1774 1740 1776 1740 1778 1740 1798 1727 1815 1738 1817 1738 1819 1738 1821 1738 1982 1727 2112 1738 2114 1738 2116 1738 2153 1725 2153 1712 2146 1682 1776 1684 1739 1673 1737 1673 1735 1673 1733 1673 1731 1673 1715 1686 1494 1686 1464 1673 1462 1673 1460 1673 1187 1686 1131 1675 1128 1675 1126 1675 1079 1688 1061 1678 1059 1678 1057 1678 1055 1678 966 1688 912 1678 910 1678 908 1678 862 1688 767 1678 765 1678 762 1678 760 1678 745 1688 594 1680 591 1680 589 1680 568 1691 429 1680 427 1680 425 1680 379 1691 381 1723"/>
                        </Shape>
                        <String CONTENT="reindeer-sledges from the Oˊnmɪlɪn and Telqäˊp camps. In summer ten or"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l20" HPOS="381" VPOS="1738" WIDTH="1774" HEIGHT="59" BASELINE="383 1781 2155 1775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1781 383 1797 2153 1790 2155 1775 2151 1745 399 1738 396 1738 394 1738 392 1738 381 1745 383 1781"/>
                        </Shape>
                        <String CONTENT="fifteen skin boats from the same maritime villages, a few boats of the Telqäˊp"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l21" HPOS="381" VPOS="1794" WIDTH="1492" HEIGHT="61" BASELINE="383 1840 1873 1836" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1840 383 1855 1871 1851 1873 1836 1869 1807 1382 1794 1380 1794 1378 1794 1354 1805 1254 1794 1252 1794 1109 1807 392 1797 390 1797 388 1797 386 1797 386 1799 383 1799 381 1799 383 1840"/>
                        </Shape>
                        <String CONTENT="Reindeer Chukchee, and even some of the Kerek, visit the port."/>
                    </TextLine>
<TextLine ID="mz_1-085_l22" HPOS="492" VPOS="1853" WIDTH="1663" HEIGHT="63" BASELINE="494 1898 2155 1892" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="494 1898 494 1916 2153 1909 2155 1892 2151 1864 1700 1853 1698 1853 1596 1866 492 1866 494 1898"/>
                        </Shape>
                        <String CONTENT="TOBACCO AND BRICK-TEA. — Of all Russian wares, tobacco held the first"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l23" HPOS="381" VPOS="1916" WIDTH="1772" HEIGHT="67" BASELINE="383 1961 2153 1950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1961 383 1983 2151 1970 2153 1950 2146 1916 381 1929 383 1961"/>
                        </Shape>
                        <String CONTENT="place. The craving of the natives for it is aptly expressed in a tale well"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l24" HPOS="383" VPOS="1989" WIDTH="995" HEIGHT="48" BASELINE="383 2020 1378 2020" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2020 383 2037 1378 2037 1378 2020 1378 1989 383 1989 383 2020"/>
                        </Shape>
                        <String CONTENT="known to all tribes of northeastern Siberia."/>
                    </TextLine>
<TextLine ID="mz_1-085_l25" HPOS="487" VPOS="2039" WIDTH="1670" HEIGHT="56" BASELINE="490 2080 2157 2074" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="490 2080 490 2095 2155 2089 2157 2074 2153 2041 500 2039 498 2039 496 2039 494 2039 494 2041 487 2046 490 2080"/>
                        </Shape>
                        <String CONTENT="In the time of a tobacco famine, when all the people were nearly mad"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l26" HPOS="379" VPOS="2102" WIDTH="1776" HEIGHT="56" BASELINE="381 2139 2155 2132" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2139 381 2158 2153 2152 2155 2132 2148 2102 379 2108 381 2139"/>
                        </Shape>
                        <String CONTENT="because they had nothing to smoke, one well-to-do reindeer-breeder possessed"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l27" HPOS="381" VPOS="2162" WIDTH="1770" HEIGHT="55" BASELINE="383 2201 2151 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2201 383 2217 2148 2210 2151 2195 2144 2162 381 2167 383 2201"/>
                        </Shape>
                        <String CONTENT="a large pouch quite filled with tobacco, but would not share it with any one."/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l28" HPOS="381" VPOS="2210" WIDTH="1772" HEIGHT="67" BASELINE="383 2262 2153 2251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2262 383 2277 2151 2271 2153 2251 2148 2221 1850 2210 1847 2210 1845 2210 1843 2210 1828 2221 1679 2212 1676 2212 1674 2212 1650 2225 1518 2225 1490 2212 1488 2212 1486 2212 1484 2212 1481 2212 1466 2223 1339 2214 1336 2214 1334 2214 1302 2225 1269 2214 1267 2214 1265 2214 1170 2225 1109 2214 1107 2214 977 2227 771 2217 769 2217 661 2230 405 2219 403 2219 401 2219 381 2227 383 2262"/>
                        </Shape>
                        <String CONTENT="At last his own brother asked for a pipeful, and was refused. The next day"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l29" HPOS="379" VPOS="2277" WIDTH="1776" HEIGHT="61" BASELINE="381 2321 2155 2314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2321 381 2338 2153 2331 2155 2314 2151 2279 392 2277 390 2277 388 2277 386 2277 386 2279 379 2284 381 2321"/>
                        </Shape>
                        <String CONTENT="he overtook the owner of the tobacco on the tundra, stabbed him from behind"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l30" HPOS="381" VPOS="2329" WIDTH="1774" HEIGHT="72" BASELINE="383 2383 2155 2370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2383 383 2401 2153 2388 2155 2370 2151 2340 1873 2329 1871 2329 1869 2329 1828 2342 1663 2331 1661 2331 1659 2331 1635 2342 1581 2331 1579 2331 1577 2331 1575 2331 1557 2344 1442 2334 1440 2334 1367 2344 1336 2334 1334 2334 1332 2334 1263 2347 1107 2336 1105 2336 1102 2336 1100 2336 1087 2347 1025 2336 1022 2336 1020 2336 1018 2336 1003 2347 864 2338 862 2338 860 2338 830 2349 760 2338 758 2338 756 2338 754 2338 739 2351 574 2351 557 2340 555 2340 552 2340 425 2340 422 2340 420 2340 381 2353 383 2383"/>
                        </Shape>
                        <String CONTENT="with his spear, ripped open his breast, and took out his lungs, which he found"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l31" HPOS="381" VPOS="2394" WIDTH="1776" HEIGHT="61" BASELINE="383 2440 2157 2433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2440 383 2455 2155 2448 2157 2433 2153 2405 1566 2394 1564 2394 1473 2405 544 2398 542 2398 381 2409 383 2440"/>
                        </Shape>
                        <String CONTENT="covered with soot. He scraped away a part of this, and used it to fill his"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l32" HPOS="381" VPOS="2459" WIDTH="1776" HEIGHT="63" BASELINE="383 2502 2157 2494" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2502 383 2522 2155 2507 2157 2494 2153 2461 418 2459 416 2459 414 2459 381 2470 383 2502"/>
                        </Shape>
                        <String CONTENT="pipe. The pouch he left untouched. When caught by the Cossacks and"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l33" HPOS="383" VPOS="2520" WIDTH="1774" HEIGHT="58" BASELINE="386 2561 2157 2552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 2561 386 2578 2155 2570 2157 2552 2151 2520 383 2524 386 2561"/>
                        </Shape>
                        <String CONTENT="brought before the Russian magistrate, he showed him the big pouch and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l34" HPOS="383" VPOS="2576" WIDTH="1062" HEIGHT="69" BASELINE="386 2619 1445 2615" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2606 386 2619 386 2634 661 2645 663 2645 665 2645 667 2645 667 2643 678 2634 977 2643 979 2643 1276 2632 1397 2643 1399 2643 1401 2643 1445 2630 1445 2615 1440 2587 996 2576 994 2576 390 2589 383 2606"/>
                        </Shape>
                        <String CONTENT="sooty lungs, and was acquitted of the charge."/>
                    </TextLine>
<TextLine ID="mz_1-085_l35" HPOS="498" VPOS="2641" WIDTH="1657" HEIGHT="56" BASELINE="500 2680 2155 2671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="500 2680 500 2697 2153 2689 2155 2671 2151 2641 498 2641 500 2680"/>
                        </Shape>
                        <String CONTENT="Tobacco has found its way from Siberia far eastward into arctic America."/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l36" HPOS="386" VPOS="2702" WIDTH="1769" HEIGHT="56" BASELINE="388 2741 2155 2732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="388 2741 388 2758 2153 2754 2155 2732 2151 2702 386 2702 388 2741"/>
                        </Shape>
                        <String CONTENT="The Chukchee tradition in regard to the ancient trade, previously referred to,"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l37" HPOS="383" VPOS="2767" WIDTH="553" HEIGHT="54" BASELINE="386 2795 936 2799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 2795 383 2814 392 2821 394 2821 396 2821 399 2821 934 2812 936 2799 934 2771 386 2767 386 2795"/>
                        </Shape>
                        <String CONTENT="continues as follows: —"/>
                    </TextLine>
<TextLine ID="mz_1-085_l38" HPOS="498" VPOS="2814" WIDTH="1659" HEIGHT="61" BASELINE="500 2857 2157 2853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="500 2857 500 2875 2155 2875 2157 2853 2153 2825 1328 2814 1326 2814 1323 2814 1295 2827 498 2827 500 2857"/>
                        </Shape>
                        <String CONTENT="“Farther on live men who dissever themselves at will. They stay among"/>
                    </TextLine>

                    <TextLine ID="mz_1-085_l39" HPOS="381" VPOS="2881" WIDTH="1774" HEIGHT="61" BASELINE="383 2918 2155 2909" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2918 383 2933 1159 2931 1187 2942 1189 2942 1191 2942 1313 2929 1499 2929 1514 2940 1516 2940 1518 2940 1520 2940 2153 2927 2155 2909 2148 2881 381 2888 383 2918"/>
                        </Shape>
