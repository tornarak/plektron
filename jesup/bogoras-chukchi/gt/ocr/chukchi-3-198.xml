                        </Shape>
                        <String CONTENT="well-to-do merchant, Nekhoroshev, who had come from Yakutsk a few years"/>
                    </TextLine>

                    <TextLine ID="mz_3-198_l8" HPOS="528" VPOS="903" WIDTH="1771" HEIGHT="62" BASELINE="530 942 2299 946" TAGREFS="TYPE_4">
