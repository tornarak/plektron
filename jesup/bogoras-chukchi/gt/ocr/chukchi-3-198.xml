                        </Shape>
                        <String CONTENT="I brought back from the Large Anui River the ancient dress of a Yukaghir"/>
                    </TextLine>

                    <TextLine ID="mz_3-198_l6" HPOS="528" VPOS="784" WIDTH="1773" HEIGHT="61" BASELINE="530 827 2301 821" TAGREFS="TYPE_4">
