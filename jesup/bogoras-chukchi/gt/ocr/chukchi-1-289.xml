                        </Shape>
                        <String CONTENT="could not be ascertained, because the work belongs to a former generation."/>
                    </TextLine>

                    <TextLine ID="mz_1-289_l9" HPOS="405" VPOS="2907" WIDTH="1769" HEIGHT="59" BASELINE="407 2953 2174 2944" TAGREFS="TYPE_4">
