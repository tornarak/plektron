                        </Shape>
                        <String CONTENT="decorated with elaborate embroidery (Plate XXII). The meaning of these figures"/>
                    </TextLine>
<TextLine ID="mz_1-289_l8" HPOS="401" VPOS="2847" WIDTH="1776" HEIGHT="62" BASELINE="403 2894 2177 2883" TAGREFS="TYPE_4">
