                        </Shape>
                        <String CONTENT="boys often are nursed until five or six years old. In this case the husband"/>
                    </TextLine>

                    <TextLine ID="mz_3-044_l29" HPOS="372" VPOS="2117" WIDTH="1777" HEIGHT="65" BASELINE="374 2156 2149 2160" TAGREFS="TYPE_5">
                        <Shape>
