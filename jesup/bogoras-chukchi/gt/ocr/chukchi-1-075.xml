                <TextBlock ID="text_1-075" HPOS="370" VPOS="894" WIDTH="1787" HEIGHT="2418"><TextLine ID="mz_1-075_l1" HPOS="1066" VPOS="894" WIDTH="396" HEIGHT="73" BASELINE="1068 946 1462 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1455 939 1440 907 1352 894 1347 894 1332 894 1317 907 1265 894 1263 894 1261 894 1258 894 1256 894 1230 911 1148 911 1128 894 1126 894 1124 894 1122 894 1081 896 1079 896 1076 896 1076 898 1066 907 1068 946 1068 957 1261 967 1263 967 1445 965 1447 965 1449 965 1462 954 1462 941 1460 937 1455 939"/>
                        </Shape>
                        <String CONTENT="III. — TRADE."/>
                    </TextLine>
<TextLine ID="mz_1-075_l2" HPOS="485" VPOS="1006" WIDTH="1661" HEIGHT="59" BASELINE="485 1050 2146 1050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2109 1013 2088 1013 2066 1011 2064 1011 2001 1017 1445 1006 1442 1006 1352 1017 1297 1006 1295 1006 1293 1006 1245 1017 1115 1006 1113 1006 1111 1006 1076 1017 970 1006 968 1006 966 1006 964 1006 951 1019 775 1019 715 1006 713 1006 710 1006 682 1017 509 1006 507 1006 505 1006 485 1015 485 1050 485 1065 2146 1065 2146 1050 2146 1017 2129 1013 2109 1013"/>
                        </Shape>
                        <String CONTENT="ANCIENT TRADE. — Even before the arrival of the Russians, a lively"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l3" HPOS="377" VPOS="1065" WIDTH="1771" HEIGHT="60" BASELINE="379 1110 2148 1106" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1110 379 1125 2146 1121 2148 1106 2144 1076 1267 1065 1265 1065 1263 1065 1261 1065 1248 1076 451 1067 448 1067 377 1078 379 1110"/>
                        </Shape>
                        <String CONTENT="traffic was carried on between the Reindeer Chukchee camps and the Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l4" HPOS="375" VPOS="1128" WIDTH="1782" HEIGHT="58" BASELINE="377 1171 2157 1164" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1171 377 1186 2155 1180 2157 1164 2153 1128 409 1128 407 1128 405 1128 375 1138 377 1171"/>
                        </Shape>
                        <String CONTENT="villages (both Chukchee and Eskimo), and also between Asia and America"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l5" HPOS="373" VPOS="1186" WIDTH="1771" HEIGHT="63" BASELINE="375 1232 2144 1225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1232 375 1247 2140 1249 2144 1225 2140 1195 1009 1186 1007 1186 373 1199 375 1232"/>
                        </Shape>
                        <String CONTENT="across Bering Strait. The Reindeer people were in need of blubber, thongs,"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l6" HPOS="373" VPOS="1245" WIDTH="1775" HEIGHT="60" BASELINE="375 1292 2148 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1292 375 1305 2146 1299 2148 1286 2144 1255 1557 1245 1555 1245 1553 1245 1551 1245 1531 1255 968 1247 966 1247 895 1258 446 1249 444 1249 373 1260 375 1292"/>
                        </Shape>
                        <String CONTENT="and seal-skins, and would offer in exchange reindeer-skins and ready-made"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l7" HPOS="373" VPOS="1305" WIDTH="1775" HEIGHT="65" BASELINE="375 1351 2148 1344" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1351 375 1370 2146 1359 2148 1344 2144 1316 1616 1305 1614 1305 1507 1316 1031 1307 1029 1307 955 1318 548 1309 546 1309 373 1320 375 1351"/>
                        </Shape>
                        <String CONTENT="garments, just as is done at the present day. On the American side, reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l8" HPOS="375" VPOS="1368" WIDTH="1773" HEIGHT="56" BASELINE="377 1411 2148 1405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1411 377 1424 2146 1418 2148 1405 2144 1374 403 1368 401 1368 399 1368 375 1377 377 1411"/>
                        </Shape>
                        <String CONTENT="skins brought a much better price than in Asia: therefore Chukchee and"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l9" HPOS="379" VPOS="1437" WIDTH="1767" HEIGHT="50" BASELINE="379 1468 2146 1468" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1468 379 1487 2144 1487 2146 1468 2144 1437 379 1437 379 1468"/>
                        </Shape>
                        <String CONTENT="Asiatic Eskimo parties crossed over every year on trading-expeditions, occasion-"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l10" HPOS="375" VPOS="1494" WIDTH="784" HEIGHT="58" BASELINE="377 1524 1159 1528" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1524 375 1543 388 1552 390 1552 392 1552 394 1552 1157 1543 1159 1528 1157 1498 377 1494 377 1524"/>
                        </Shape>
                        <String CONTENT="ally, however, indulging in piracy."/>
                    </TextLine>
<TextLine ID="mz_1-075_l11" HPOS="481" VPOS="1539" WIDTH="1665" HEIGHT="65" BASELINE="483 1589 2146 1582" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="483 1589 483 1604 2144 1597 2146 1582 2142 1552 2053 1539 2051 1539 1967 1550 1951 1539 1949 1539 1947 1539 1945 1539 1943 1539 1941 1539 1925 1552 1720 1552 1687 1539 1685 1539 1683 1539 1585 1552 1085 1541 1083 1541 1020 1554 994 1543 992 1543 990 1543 635 1554 583 1543 581 1543 578 1543 537 1554 496 1543 494 1543 492 1543 490 1543 487 1543 487 1545 481 1550 483 1589"/>
                        </Shape>
                        <String CONTENT="In the tale of “Elendi and his Sons,” the hero, coming to an American"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l12" HPOS="377" VPOS="1613" WIDTH="1771" HEIGHT="49" BASELINE="379 1647 2148 1643" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 1647 379 1662 2146 1658 2148 1643 2144 1613 377 1613 379 1647"/>
                        </Shape>
                        <String CONTENT="Eskimo, requests “a score of ground-seal skins, a score each of bleached and"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l13" HPOS="375" VPOS="1673" WIDTH="1769" HEIGHT="54" BASELINE="377 1708 2144 1701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1708 377 1727 2142 1727 2144 1701 2140 1673 375 1673 377 1708"/>
                        </Shape>
                        <String CONTENT="black-dyed coils of thong, the same of rough-seal skins; whatever you have,"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l14" HPOS="373" VPOS="1723" WIDTH="1771" HEIGHT="58" BASELINE="375 1768 2144 1764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 1768 375 1781 2142 1777 2144 1764 2140 1734 1434 1723 1432 1723 373 1736 375 1768"/>
                        </Shape>
                        <String CONTENT="one score of each.” The host asks for an equivalent, but Elendi has nothing:"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l15" HPOS="375" VPOS="1781" WIDTH="1771" HEIGHT="61" BASELINE="377 1827 2146 1823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1827 377 1842 2144 1838 2146 1823 2142 1792 1261 1781 1258 1781 1200 1792 641 1784 639 1784 375 1794 377 1827"/>
                        </Shape>
                        <String CONTENT="so a quarrel arises, and they fight. Elendi vanquishes the Eskimo, commands"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l16" HPOS="377" VPOS="1855" WIDTH="1769" HEIGHT="50" BASELINE="377 1888 2146 1888" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1888 377 1901 2144 1905 2146 1888 2146 1855 377 1855 377 1888"/>
                        </Shape>
                        <String CONTENT="the people of the village to deliver up to him everything he had asked for,"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l17" HPOS="375" VPOS="1901" WIDTH="1472" HEIGHT="62" BASELINE="377 1946 1847 1939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 1946 377 1963 1845 1957 1847 1939 1841 1901 1343 1911 910 1903 908 1903 849 1914 442 1905 440 1905 375 1916 377 1946"/>
                        </Shape>
                        <String CONTENT="and returns home carrying his subdued enemy away as a slave.¹"/>
                    </TextLine>
<TextLine ID="mz_1-075_l18" HPOS="485" VPOS="1959" WIDTH="1663" HEIGHT="61" BASELINE="487 2000 2148 2004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="487 2000 485 2015 2144 2020 2148 2004 2148 1974 2107 1961 2105 1961 1934 1961 1932 1961 1930 1961 1928 1961 1915 1972 1876 1961 1873 1961 1871 1961 1869 1961 1832 1972 1746 1961 1744 1961 1670 1972 1616 1961 1614 1961 1248 1970 1224 1959 1222 1959 1219 1959 1135 1972 1033 1972 1018 1959 1016 1959 1014 1959 1012 1959 1009 1959 983 1970 879 1959 877 1959 875 1959 851 1972 734 1972 719 1959 717 1959 715 1959 713 1959 487 1965 487 2000"/>
                        </Shape>
                        <String CONTENT="The chief part in such expeditions, however, belonged to the Nɵˊɵkalɪt"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l19" HPOS="375" VPOS="2020" WIDTH="1771" HEIGHT="60" BASELINE="377 2065 2146 2061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 2065 377 2080 2144 2076 2146 2061 2144 2033 2118 2020 2116 2020 2114 2020 2112 2020 2081 2033 1971 2033 1956 2020 1954 2020 1951 2020 1949 2020 1947 2020 1921 2030 1897 2020 1895 2020 1893 2020 1811 2033 1575 2033 1544 2020 1542 2020 1540 2020 1538 2020 1494 2030 1406 2020 1403 2020 1401 2020 1375 2030 1362 2020 1360 2020 1358 2020 1267 2020 1265 2020 1263 2020 1261 2020 1245 2033 1193 2022 1191 2022 1189 2022 1159 2033 1120 2022 1118 2022 1115 2022 1113 2022 1076 2033 1014 2022 1012 2022 944 2033 821 2022 819 2022 817 2022 773 2033 693 2022 691 2022 375 2028 377 2065"/>
                        </Shape>
                        <String CONTENT="Eskimo of East Cape, although the Chukchee often accompanied them. It"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l20" HPOS="375" VPOS="2091" WIDTH="1769" HEIGHT="50" BASELINE="377 2126 2144 2119" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 2126 377 2141 2142 2137 2144 2119 2140 2091 375 2091 377 2126"/>
                        </Shape>
                        <String CONTENT="is told that as late as three generations ago large parties would start from"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l21" HPOS="375" VPOS="2139" WIDTH="1771" HEIGHT="60" BASELINE="377 2184 2146 2180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 2184 377 2199 2144 2195 2146 2180 2142 2152 2049 2139 2047 2139 2045 2139 2021 2152 1793 2152 1778 2139 1776 2139 1774 2139 1772 2139 1769 2139 1748 2150 1644 2139 1642 2139 1640 2139 1614 2150 1588 2139 1585 2139 1583 2139 1581 2139 1553 2150 1540 2139 1538 2139 1536 2139 1533 2139 1531 2139 1501 2150 1455 2139 1453 2139 1451 2139 1449 2139 1425 2150 375 2150 377 2184"/>
                        </Shape>
                        <String CONTENT="East Cape for America. The Nɵˊɵkalɪt went in their large boats, sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l22" HPOS="375" VPOS="2197" WIDTH="1771" HEIGHT="65" BASELINE="377 2245 2146 2238" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="377 2245 377 2262 2144 2256 2146 2238 2142 2210 1598 2197 1596 2197 1594 2197 1544 2210 1481 2199 1479 2199 1477 2199 1453 2210 1343 2199 1341 2199 1289 2210 1243 2199 1241 2199 1239 2199 1237 2199 1235 2199 1219 2210 1113 2199 1111 2199 1109 2199 1079 2210 1033 2199 1031 2199 1029 2199 1027 2199 1025 2199 1007 2210 509 2201 507 2201 505 2201 479 2212 418 2201 416 2201 414 2201 375 2214 377 2245"/>
                        </Shape>
                        <String CONTENT="with thirty paddles in each; the Chukchee from the neighboring Arctic villages"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l23" HPOS="373" VPOS="2264" WIDTH="1773" HEIGHT="54" BASELINE="375 2305 2146 2301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2305 375 2318 2144 2314 2146 2301 2142 2273 472 2264 470 2264 373 2275 375 2305"/>
                        </Shape>
                        <String CONTENT="went in smaller boats. These fleets crossed to America, carrying on trade"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l24" HPOS="373" VPOS="2318" WIDTH="1773" HEIGHT="63" BASELINE="375 2366 2146 2360" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2366 375 2381 2144 2375 2146 2360 2142 2329 1555 2318 1553 2318 1497 2329 1009 2321 1007 2321 953 2331 479 2323 477 2323 373 2334 375 2366"/>
                        </Shape>
                        <String CONTENT="or piracy, as circumstances dictated. Similar expeditions of Eskimo and Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l25" HPOS="373" VPOS="2379" WIDTH="1773" HEIGHT="61" BASELINE="375 2424 2146 2418" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2424 375 2440 2146 2433 2146 2418 2142 2390 1559 2379 1557 2379 1555 2379 1553 2379 1540 2390 399 2383 396 2383 394 2383 373 2392 375 2424"/>
                        </Shape>
                        <String CONTENT="chee, though on a smaller scale, went over from Indian Point to St. Lawrence"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l26" HPOS="379" VPOS="2437" WIDTH="160" HEIGHT="65" BASELINE="379 2483 539 2483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="379 2483 379 2502 539 2502 539 2483 539 2450 394 2437 392 2437 390 2437 388 2437 379 2444 379 2483"/>
                        </Shape>
                        <String CONTENT="Island."/>
                    </TextLine>
<TextLine ID="mz_1-075_l27" HPOS="481" VPOS="2496" WIDTH="1663" HEIGHT="63" BASELINE="483 2544 2144 2537" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="483 2544 483 2559 2142 2552 2144 2537 2140 2509 1598 2496 1596 2496 1594 2496 1592 2496 1577 2511 1488 2511 1473 2498 1471 2498 1468 2498 1466 2498 1388 2509 1284 2498 1282 2498 1022 2511 953 2500 951 2500 875 2511 817 2500 814 2500 812 2500 784 2511 481 2509 483 2544"/>
                        </Shape>
                        <String CONTENT="Trade, even in Asia, was carried on with considerable mutual distrust."/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l28" HPOS="373" VPOS="2557" WIDTH="1771" HEIGHT="62" BASELINE="375 2602 2144 2595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2602 375 2619 2142 2613 2144 2595 2140 2567 1553 2557 1551 2557 1549 2557 1525 2567 1005 2559 1003 2559 1001 2559 960 2570 373 2570 375 2602"/>
                        </Shape>
                        <String CONTENT="I was told that in very ancient times there was a kind of fair in Nɵˊɵkan or,"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l29" HPOS="373" VPOS="2619" WIDTH="1771" HEIGHT="59" BASELINE="373 2660 2144 2660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2660 373 2678 2144 2678 2144 2660 2144 2630 2099 2619 2097 2619 2094 2619 2092 2619 2058 2630 1954 2619 1951 2619 1949 2619 1917 2630 1787 2619 1785 2619 1782 2619 1746 2630 1694 2619 1692 2619 1689 2619 1657 2632 1492 2632 1475 2619 1473 2619 1471 2619 1468 2619 1401 2630 1341 2619 1339 2619 1248 2630 1196 2619 1193 2619 1074 2630 1042 2619 1040 2619 947 2619 944 2619 942 2619 940 2619 925 2632 801 2632 786 2619 784 2619 782 2619 780 2619 373 2628 373 2660"/>
                        </Shape>
                        <String CONTENT="in Uweˊlen, which was held outside of the village, on the flat seashore, for"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l30" HPOS="370" VPOS="2678" WIDTH="1774" HEIGHT="58" BASELINE="373 2723 2144 2719" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2723 373 2736 2142 2734 2144 2719 2142 2691 2107 2678 2105 2678 2103 2678 2101 2678 2075 2689 2060 2678 2058 2678 2055 2678 2053 2678 1590 2689 1559 2678 1557 2678 1555 2678 1553 2678 1518 2689 1399 2678 1397 2678 1250 2691 531 2680 529 2680 470 2691 388 2680 386 2680 383 2680 381 2680 370 2686 373 2723"/>
                        </Shape>
                        <String CONTENT="fear of hostilities (the same custom was afterwards universally adopted in"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l31" HPOS="370" VPOS="2741" WIDTH="1774" HEIGHT="58" BASELINE="373 2782 2144 2777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2782 373 2799 2142 2795 2144 2777 2140 2749 392 2741 390 2741 388 2741 386 2741 370 2747 373 2782"/>
                        </Shape>
                        <String CONTENT="the Russian fairs, and it is persisted in at the present time in Anadyr). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l32" HPOS="373" VPOS="2799" WIDTH="1771" HEIGHT="65" BASELINE="375 2844 2144 2836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 2844 375 2864 2142 2853 2144 2836 2140 2808 1267 2799 1265 2799 1263 2799 1228 2810 847 2801 845 2801 373 2814 375 2844"/>
                        </Shape>
                        <String CONTENT="people came to trade fully armed, and offered their wares to each other on"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l33" HPOS="370" VPOS="2857" WIDTH="1774" HEIGHT="63" BASELINE="373 2903 2144 2899" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2903 373 2920 2142 2920 2144 2899 2140 2868 1258 2857 1256 2857 1174 2868 392 2860 390 2860 388 2860 386 2860 370 2866 373 2903"/>
                        </Shape>
                        <String CONTENT="their spear-points; or else they would hold a bundle of skins with one hand,"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l34" HPOS="370" VPOS="2916" WIDTH="1774" HEIGHT="71" BASELINE="373 2964 2144 2957" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2964 373 2977 960 2985 962 2985 1074 2974 1198 2985 1200 2985 1202 2985 1228 2974 1265 2985 1267 2985 1269 2985 1271 2985 1295 2974 1310 2985 1313 2985 1315 2985 1317 2987 1497 2987 1497 2985 1585 2972 1642 2983 1644 2983 1726 2972 2034 2983 2036 2983 2038 2983 2040 2983 2055 2972 2122 2983 2125 2983 2127 2983 2129 2983 2144 2970 2144 2957 2142 2929 2097 2916 2094 2916 2092 2916 1910 2927 1815 2916 1813 2916 1811 2916 1808 2916 1793 2929 1692 2929 1661 2916 1659 2916 1657 2916 1531 2929 1083 2918 1081 2918 1079 2918 1076 2918 1063 2929 1033 2918 1031 2918 1029 2918 908 2931 526 2920 524 2920 522 2920 481 2931 442 2920 440 2920 438 2920 370 2933 373 2964"/>
                        </Shape>
                        <String CONTENT="and with the other a bared knife, in readiness to raise a fight upon the"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l35" HPOS="373" VPOS="2979" WIDTH="483" HEIGHT="60" BASELINE="375 3022 856 3018" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 3022 375 3039 856 3033 856 3018 851 2987 399 2979 396 2979 394 2979 373 2987 375 3022"/>
                        </Shape>
                        <String CONTENT="slightest provocation."/>
                    </TextLine>
<TextLine ID="mz_1-075_l36" HPOS="481" VPOS="3033" WIDTH="1665" HEIGHT="78" BASELINE="483 3083 2146 3074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="483 3083 483 3111 552 3098 968 3106 970 3106 1315 3093 1726 3102 1728 3102 1867 3091 1943 3102 1945 3102 1947 3102 1949 3102 1960 3093 1971 3102 1973 3102 1975 3102 1977 3104 2084 3104 2084 3102 2146 3087 2146 3074 2142 3046 1893 3033 1891 3033 1889 3033 1852 3044 1815 3033 1813 3033 1811 3033 1722 3046 1698 3035 1696 3035 1694 3035 1692 3035 1668 3046 1503 3035 1501 3035 1432 3046 1388 3035 1386 3035 1384 3035 1308 3048 1079 3037 1076 3037 1016 3048 975 3037 973 3037 970 3037 968 3037 929 3048 901 3037 899 3037 897 3037 821 3050 784 3039 782 3039 780 3039 542 3050 500 3039 498 3039 496 3039 494 3039 492 3039 481 3048 483 3083"/>
                        </Shape>
                        <String CONTENT="A mute trade took place in Asia as well as in America. In this manner"/>
                    </TextLine>

                    <TextLine ID="mz_1-075_l37" HPOS="373" VPOS="3096" WIDTH="1769" HEIGHT="67" BASELINE="375 3143 2142 3135" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="375 3143 375 3163 2140 3154 2142 3135 2138 3104 1258 3096 1256 3096 1254 3096 1232 3106 505 3100 503 3100 373 3111 375 3143"/>
                        </Shape>
                        <String CONTENT="a party of adventurers, who in 1646 sailed from the mouth of the Kolyma west-"/>
                    </TextLine>
<TextLine ID="mz_1-075_l38" HPOS="944" VPOS="3189" WIDTH="628" HEIGHT="52" BASELINE="947 3217 1572 3223" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="947 3217 944 3234 1568 3241 1572 3223 1570 3195 947 3189 947 3217"/>
                        </Shape>
