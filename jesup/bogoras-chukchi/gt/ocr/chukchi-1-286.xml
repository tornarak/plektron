                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l2" HPOS="602" VPOS="615" WIDTH="108" HEIGHT="67" BASELINE="604 660 710 656" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="604 660 604 671 654 682 656 682 710 669 710 656 708 625 676 615 674 615 672 615 602 628 604 660"/>
                        </Shape>
                        <String CONTENT="226"/>
                    </TextLine>
<TextLine ID="mz_1-286_l3" HPOS="704" VPOS="718" WIDTH="1672" HEIGHT="61" BASELINE="706 764 2376 760" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2350 727 2328 727 2307 727 2294 725 2270 729 2233 723 2220 723 2198 723 2177 723 2170 723 2129 731 1791 731 1713 718 1711 718 1575 729 1551 718 1549 718 1546 718 1544 718 1503 731 717 721 715 721 713 721 710 721 710 723 704 727 706 764 706 779 2374 775 2376 760 2374 729 2367 727 2350 727"/>
                        </Shape>
                        <String CONTENT="EMBROIDERY. — Skin clothes are ornamented in two ways, — either with"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l4" HPOS="598" VPOS="781" WIDTH="1778" HEIGHT="59" BASELINE="600 822 2376 818" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 822 600 840 2374 835 2376 818 2372 790 672 781 669 781 598 792 600 822"/>
                        </Shape>
                        <String CONTENT="embroidery or with appliqué work, formed, like a mosaic, of small squares"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l5" HPOS="598" VPOS="842" WIDTH="1776" HEIGHT="58" BASELINE="600 883 2374 879" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 883 600 900 2372 896 2374 879 2369 851 641 842 639 842 637 842 598 853 600 883"/>
                        </Shape>
                        <String CONTENT="of black and white skin cut out for the purpose and sewed together piece by"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l6" HPOS="598" VPOS="898" WIDTH="1778" HEIGHT="69" BASELINE="600 946 2376 939" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 946 600 967 2374 954 2376 939 2372 909 1811 898 1808 898 1735 909 1239 900 1237 900 1235 900 1187 911 635 902 633 902 630 902 598 913 600 946"/>
                        </Shape>
                        <String CONTENT="piece (see Plate XXI, Fig. 1). In both branches of this ornamental work the"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l7" HPOS="600" VPOS="957" WIDTH="1776" HEIGHT="62" BASELINE="602 1004 2376 998" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1004 602 1019 2374 1013 2376 998 2372 967 2101 957 2099 957 2045 967 1967 957 1964 957 1843 967 1815 957 1813 957 1811 957 1808 957 1778 970 1748 959 1746 959 1744 959 1512 970 1497 959 1494 959 1492 959 1323 959 1321 959 1243 970 1198 959 1196 959 1193 959 1191 959 1189 959 1174 972 827 961 825 961 823 961 795 974 600 974 602 1004"/>
                        </Shape>
                        <String CONTENT="women of the Chukchee have but little skill, while those of the Koryak and"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l8" HPOS="600" VPOS="1017" WIDTH="1772" HEIGHT="63" BASELINE="602 1065 2372 1061" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1065 602 1080 2369 1076 2372 1061 2367 1030 2244 1017 2242 1017 2239 1017 2237 1017 2220 1030 2023 1030 1999 1017 1997 1017 1995 1017 1993 1017 1990 1017 1975 1030 1759 1030 1696 1017 1694 1017 1692 1017 1650 1028 1590 1017 1588 1017 1484 1030 1410 1019 1408 1019 1406 1019 1375 1030 1354 1019 1352 1019 1349 1019 1280 1030 1222 1019 1219 1019 1165 1030 1076 1019 1074 1019 1072 1019 1070 1019 1057 1030 1042 1019 1040 1019 1038 1019 895 1019 892 1019 890 1019 888 1019 873 1030 793 1019 791 1019 788 1019 754 1030 704 1019 702 1019 700 1019 676 1030 648 1019 646 1019 643 1019 641 1019 600 1032 602 1065"/>
                        </Shape>
                        <String CONTENT="of the Russianized Yukaghir display considerable taste and great patience."/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l9" HPOS="600" VPOS="1076" WIDTH="1774" HEIGHT="65" BASELINE="602 1125 2374 1117" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1125 602 1141 2372 1132 2374 1117 2369 1089 2075 1076 2073 1076 2071 1076 2068 1076 2053 1089 1928 1089 1804 1078 1802 1078 1800 1078 1776 1089 1752 1078 1750 1078 1748 1078 1746 1078 1722 1089 1635 1078 1633 1078 1542 1089 1432 1080 1429 1080 1427 1080 1425 1080 1410 1091 1321 1080 1319 1080 1317 1080 1291 1091 1250 1080 1248 1080 1245 1080 1243 1080 1211 1091 1180 1080 1178 1080 1176 1080 1042 1093 994 1082 992 1082 990 1082 988 1082 953 1093 914 1082 912 1082 910 1082 908 1082 877 1093 799 1082 797 1082 600 1086 602 1125"/>
                        </Shape>
                        <String CONTENT="Embroidery is done with the long hair of the reindeer-mane, which is white"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l10" HPOS="600" VPOS="1134" WIDTH="1776" HEIGHT="65" BASELINE="602 1186 2376 1177" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1186 602 1199 2374 1193 2376 1177 2374 1145 2354 1134 2352 1134 2350 1134 2348 1134 2346 1134 2330 1147 2235 1147 2218 1134 2216 1134 2213 1134 2211 1134 2209 1134 2207 1134 2192 1145 2177 1134 2174 1134 2172 1134 2170 1134 2088 1145 2066 1134 2064 1134 2062 1134 1954 1145 1936 1134 1934 1134 1932 1134 1930 1134 1928 1134 1925 1134 1906 1147 1780 1136 1778 1136 1711 1147 1685 1136 1683 1136 1681 1136 1679 1136 1640 1147 1616 1136 1614 1136 1611 1136 1609 1136 1575 1147 1518 1136 1516 1136 1514 1136 1484 1149 1449 1138 1447 1138 1445 1138 1388 1149 1345 1138 1343 1138 1341 1138 1339 1138 1300 1149 1254 1138 1252 1138 1250 1138 1146 1149 1098 1138 1096 1138 1094 1138 1003 1151 927 1141 925 1141 853 1151 749 1141 747 1141 600 1147 602 1186"/>
                        </Shape>
                        <String CONTENT="in color. Often it is dyed red with alder-bark. Thin sinew thread is used"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l11" HPOS="600" VPOS="1199" WIDTH="1774" HEIGHT="61" BASELINE="602 1245 2374 1238" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1245 602 1260 2372 1253 2374 1238 2369 1210 1804 1199 1802 1199 1800 1199 1752 1210 1367 1201 1365 1201 600 1212 602 1245"/>
                        </Shape>
                        <String CONTENT="for the same purpose, as are also long narrow strips of soft white leather."/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l12" HPOS="600" VPOS="1266" WIDTH="1776" HEIGHT="54" BASELINE="602 1305 2376 1299" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="602 1305 602 1320 2374 1314 2376 1299 2369 1266 600 1271 602 1305"/>
                        </Shape>
                        <String CONTENT="Koryak women and Russianized native women also use woollen thread and"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l13" HPOS="600" VPOS="1333" WIDTH="583" HEIGHT="48" BASELINE="600 1364 1183 1364" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1364 600 1381 1183 1381 1183 1364 1183 1333 600 1333 600 1364"/>
                        </Shape>
                        <String CONTENT="silk bought from traders."/>
                    </TextLine>
<TextLine ID="mz_1-286_l14" HPOS="708" VPOS="1377" WIDTH="1666" HEIGHT="62" BASELINE="710 1422 2374 1416" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="710 1422 710 1439 2372 1433 2374 1416 2369 1387 1993 1377 1990 1377 1813 1387 1373 1379 1371 1379 708 1390 710 1422"/>
                        </Shape>
                        <String CONTENT="The embroidery patterns used by Chukchee women consist of a few very"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l15" HPOS="598" VPOS="1442" WIDTH="1776" HEIGHT="60" BASELINE="600 1483 2374 1476" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1483 600 1502 2372 1496 2374 1476 2369 1448 628 1442 626 1442 624 1442 598 1450 600 1483"/>
                        </Shape>
                        <String CONTENT="simple geometrical figures, chiefly straight lines, crosses, and circles, single or"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l16" HPOS="598" VPOS="1502" WIDTH="1778" HEIGHT="67" BASELINE="600 1543 2376 1539" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1543 600 1556 1063 1567 1066 1567 1204 1556 1265 1567 1267 1569 1267 1567 1326 1556 1360 1567 1362 1567 1365 1567 1367 1567 1397 1556 1473 1567 1475 1567 1614 1554 1943 1565 1945 1565 2012 1554 2038 1565 2040 1565 2042 1565 2374 1552 2376 1539 2372 1511 624 1502 622 1502 620 1502 598 1511 600 1543"/>
                        </Shape>
                        <String CONTENT="double. The circles are said to represent stars. All these figures may be"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l17" HPOS="598" VPOS="1558" WIDTH="1776" HEIGHT="61" BASELINE="600 1604 2374 1600" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1604 600 1619 2372 1615 2374 1600 2372 1571 2343 1558 2341 1558 2339 1558 2337 1558 2313 1569 2235 1558 2233 1558 2231 1558 2187 1569 2049 1558 2047 1558 2045 1558 2001 1569 1967 1558 1964 1558 1962 1558 1960 1558 1958 1558 1938 1571 1798 1571 1700 1558 1698 1558 1696 1558 1694 1558 1676 1571 1579 1571 1486 1558 1484 1558 1481 1558 1440 1571 1365 1561 1362 1561 1046 1571 1009 1561 1007 1561 1005 1561 1003 1561 962 1571 875 1561 873 1561 598 1574 600 1604"/>
                        </Shape>
                        <String CONTENT="seen on various pieces of embroidery (Plate XXI, Figs. 1-4; also Fig. 158, a-c)."/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l18" HPOS="598" VPOS="1619" WIDTH="1778" HEIGHT="74" BASELINE="600 1662 2376 1656" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1662 600 1693 672 1682 862 1691 864 1691 866 1691 908 1678 992 1691 994 1691 996 1691 999 1691 1018 1678 1144 1686 1146 1686 1250 1675 1564 1688 1566 1688 1642 1675 1984 1686 1986 1686 1988 1686 1990 1686 2008 1673 2084 1684 2086 1684 2088 1684 2116 1673 2135 1686 2138 1686 2140 1686 2142 1688 2296 1688 2296 1686 2374 1671 2376 1656 2372 1619 1191 1619 1189 1619 1133 1630 617 1621 615 1621 613 1621 611 1621 598 1628 600 1662"/>
                        </Shape>
                        <String CONTENT="Occasionally they embellish the trimming of the “dry-shoes,” the opening of"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l19" HPOS="596" VPOS="1680" WIDTH="1654" HEIGHT="60" BASELINE="598 1725 2250 1719" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 1725 598 1740 2248 1734 2250 1719 2246 1688 1694 1680 1692 1680 1637 1691 1146 1682 1144 1682 1141 1682 1107 1695 596 1695 598 1725"/>
                        </Shape>
                        <String CONTENT="the sleeves, or the backs of women’s frocks, where tassels are fastened."/>
                    </TextLine>
<TextLine ID="mz_1-286_l20" HPOS="708" VPOS="1734" WIDTH="1666" HEIGHT="65" BASELINE="710 1784 2374 1775" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="710 1784 710 1799 2372 1792 2374 1775 2369 1747 2244 1734 2242 1734 2140 1745 2122 1734 2120 1734 2118 1734 2116 1734 2114 1734 2081 1745 2060 1734 2058 1734 2055 1734 1949 1747 1633 1736 1631 1736 1629 1736 1585 1747 1564 1736 1562 1736 1559 1736 1557 1736 1520 1751 1232 1751 1219 1738 1217 1738 1215 1738 1213 1738 1211 1738 1185 1749 1172 1738 1170 1738 1167 1738 1165 1738 1057 1751 964 1740 962 1740 708 1747 710 1784"/>
                        </Shape>
                        <String CONTENT="The Reindeer Chukchee women embroider the covers of their family"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l21" HPOS="596" VPOS="1801" WIDTH="1778" HEIGHT="58" BASELINE="598 1846 2374 1840" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 1846 598 1859 2372 1853 2374 1840 2369 1810 1189 1801 1187 1801 1107 1812 624 1803 622 1803 620 1803 596 1812 598 1846"/>
                        </Shape>
                        <String CONTENT="sledges according to their skill. These covers have around their lower part"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l22" HPOS="596" VPOS="1862" WIDTH="1778" HEIGHT="58" BASELINE="598 1905 2374 1898" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 1905 598 1920 2372 1914 2374 1898 2369 1866 665 1862 663 1862 596 1872 598 1905"/>
                        </Shape>
                        <String CONTENT="a broad band of leather embroidered with various geometrical designs, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l23" HPOS="600" VPOS="1920" WIDTH="1386" HEIGHT="58" BASELINE="600 1963 1986 1963" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="600 1963 600 1978 1986 1978 1986 1963 1986 1931 1960 1920 1958 1920 1956 1920 1954 1920 1930 1933 1865 1933 1854 1922 1854 1920 1852 1920 1850 1920 1847 1920 1845 1920 1798 1931 1648 1920 1646 1920 1644 1920 1614 1931 1581 1920 1579 1920 1577 1920 1455 1931 1397 1920 1395 1920 1393 1920 1391 1920 1380 1929 1371 1922 1371 1920 1369 1920 1367 1920 1239 1920 1237 1920 1170 1931 1144 1920 1141 1920 1139 1920 999 1931 936 1920 934 1920 931 1920 899 1931 849 1920 847 1920 845 1920 799 1931 778 1920 775 1920 773 1920 695 1931 650 1920 648 1920 646 1920 643 1920 600 1931 600 1963"/>
                        </Shape>
                        <String CONTENT="trimmed with fringe and red-dyed fur tassels (Fig. 158, a-c)."/>
                    </TextLine>
<TextLine ID="mz_1-286_l24" HPOS="708" VPOS="1976" WIDTH="1668" HEIGHT="74" BASELINE="710 2024 2376 2017" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="710 2024 710 2039 962 2050 964 2050 1393 2037 1475 2048 1477 2048 1479 2048 1501 2037 1581 2048 1583 2048 1585 2048 1620 2037 1657 2048 1659 2048 1661 2048 1663 2048 1666 2048 1681 2037 2064 2046 2066 2046 2068 2046 2071 2046 2084 2035 2122 2046 2125 2046 2127 2046 2129 2046 2151 2035 2239 2046 2242 2046 2244 2046 2246 2046 2263 2035 2374 2035 2376 2017 2372 1987 2322 1976 2320 1976 2317 1976 2294 1989 2062 1989 2036 1976 2034 1976 2032 1976 1934 1987 1858 1976 1856 1976 1778 1989 1765 1978 1763 1978 1761 1978 1759 1978 1756 1978 1735 1989 1551 1978 1549 1978 1486 1989 1304 1978 1302 1978 1243 1991 1200 1981 1198 1981 1196 1981 1193 1981 1165 1994 1003 1994 990 1981 988 1981 986 1981 983 1981 708 1987 710 2024"/>
                        </Shape>
                        <String CONTENT="The triangles seen in Plate XXI, Fig. 1, and in Fig. 158, c, were said"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l25" HPOS="596" VPOS="2043" WIDTH="1780" HEIGHT="59" BASELINE="598 2085 2376 2078" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2085 598 2102 2374 2095 2376 2078 2372 2048 617 2043 615 2043 613 2043 611 2043 596 2050 598 2085"/>
                        </Shape>
                        <String CONTENT="to represent mountains; and the zigzag-like lines in Fig. 158, c, were explained"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l26" HPOS="596" VPOS="2102" WIDTH="1778" HEIGHT="67" BASELINE="598 2143 2374 2139" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2143 598 2158 912 2158 951 2169 953 2169 955 2169 1204 2158 1317 2169 1319 2169 1425 2158 1481 2169 1484 2169 1486 2169 1529 2156 1566 2167 1568 2167 1570 2167 2372 2154 2374 2139 2369 2111 695 2102 693 2102 596 2113 598 2143"/>
                        </Shape>
                        <String CONTENT="as rivers. A part of the design in Fig. 158, c, is apparently copied from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l27" HPOS="596" VPOS="2160" WIDTH="1773" HEIGHT="63" BASELINE="598 2204 2369 2199" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2204 598 2219 2365 2223 2369 2199 2365 2171 1484 2160 1481 2160 1479 2160 1477 2160 1458 2171 752 2162 749 2162 596 2173 598 2204"/>
                        </Shape>
                        <String CONTENT="engraving on the iron spear-points, the pattern of which, as noted before,"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l28" HPOS="598" VPOS="2234" WIDTH="500" HEIGHT="45" BASELINE="598 2262 1098 2262" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2262 598 2277 1096 2279 1098 2262 1098 2234 598 2234 598 2262"/>
                        </Shape>
                        <String CONTENT="came from the south."/>
                    </TextLine>
<TextLine ID="mz_1-286_l29" HPOS="706" VPOS="2277" WIDTH="1668" HEIGHT="72" BASELINE="708 2323 2374 2318" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="708 2323 708 2338 1191 2338 1284 2349 1287 2349 1356 2338 1499 2349 1501 2349 1503 2349 1505 2349 1520 2336 1635 2336 1718 2347 1720 2347 1824 2336 1960 2347 1962 2347 2372 2334 2374 2318 2369 2290 2300 2277 2298 2277 1923 2288 1850 2277 1847 2277 1793 2288 1756 2277 1754 2277 1752 2277 1629 2288 1566 2277 1564 2277 1562 2277 1533 2292 1323 2292 1304 2279 1302 2279 1300 2279 1297 2279 1295 2279 1261 2290 1232 2279 1230 2279 1228 2279 1226 2279 1198 2290 1105 2279 1102 2279 706 2288 708 2323"/>
                        </Shape>
                        <String CONTENT="I could not find a single woman able to give full explanations of her"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l30" HPOS="596" VPOS="2340" WIDTH="1778" HEIGHT="58" BASELINE="598 2383 2374 2379" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2383 598 2398 2372 2394 2374 2379 2369 2351 1657 2340 1655 2340 596 2353 598 2383"/>
                        </Shape>
                        <String CONTENT="own patterns; so that, if they ever had a meaning, it is forgotten by this time."/>
                    </TextLine>
<TextLine ID="mz_1-286_l31" HPOS="706" VPOS="2398" WIDTH="1670" HEIGHT="61" BASELINE="708 2444 2376 2440" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="708 2444 708 2459 2374 2455 2376 2440 2372 2409 1553 2398 1551 2398 1549 2398 1525 2409 730 2401 728 2401 726 2401 706 2409 708 2444"/>
                        </Shape>
                        <String CONTENT="Above the band on the back part of the cover is fastened a circle about"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l32" HPOS="596" VPOS="2461" WIDTH="1776" HEIGHT="59" BASELINE="598 2502 2372 2498" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2502 598 2520 2369 2515 2372 2498 2367 2470 715 2461 713 2461 596 2472 598 2502"/>
                        </Shape>
                        <String CONTENT="twenty-five or thirty centimetres in diameter, covered all over with embroidery."/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l33" HPOS="602" VPOS="2518" WIDTH="1772" HEIGHT="60" BASELINE="604 2563 2374 2559" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="604 2563 604 2578 2372 2574 2374 2559 2372 2531 2322 2518 2320 2518 2317 2518 2315 2518 2289 2528 2155 2518 2153 2518 2151 2518 2118 2531 1819 2531 1802 2518 1800 2518 1798 2518 1795 2518 1793 2518 1761 2528 1724 2518 1722 2518 1720 2518 1718 2518 1685 2528 1581 2518 1579 2518 1434 2533 1252 2533 1219 2520 1217 2520 1215 2520 1213 2520 1183 2531 1165 2520 1163 2520 1161 2520 1159 2520 1059 2531 999 2520 996 2520 602 2524 604 2563"/>
                        </Shape>
                        <String CONTENT="This is called “the sun,” the same name which the Lamut women give to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-286_l34" HPOS="596" VPOS="2580" WIDTH="1778" HEIGHT="59" BASELINE="598 2624 2374 2619" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="598 2624 598 2639 2372 2634 2374 2619 2369 2587 717 2580 715 2580 596 2591 598 2624"/>
                        </Shape>
                        <String CONTENT="round metal breastplates that form part of their festive costumes. This round"/>
                    </TextLine>

