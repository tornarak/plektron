    <Layout>
        <Page WIDTH="2781" HEIGHT="3866" PHYSICAL_IMG_NR="0" ID="page_0">
            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-051" HPOS="370" VPOS="617" WIDTH="1774" HEIGHT="2634"><TextLine ID="mz_1-051_l1" HPOS="942" VPOS="617" WIDTH="622" HEIGHT="56" BASELINE="944 649 1564 656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1555 619 962 617 944 645 944 649 942 666 1559 673 1564 656 1562 628 1555 619"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l2" HPOS="2081" VPOS="628" WIDTH="31" HEIGHT="56" BASELINE="2086 660 2112 658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2105 632 2081 628 2086 660 2086 682 2112 684 2112 658 2107 632 2105 632"/>
                        </Shape>
                        <String CONTENT="29"/>
                    </TextLine>
<TextLine ID="mz_1-051_l3" HPOS="377" VPOS="723" WIDTH="1763" HEIGHT="52" BASELINE="379 755 2140 751" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="507 723 485 725 464 725 442 725 420 727 399 727 377 727 379 755 379 775 2138 770 2140 751 2135 723 529 723 507 723"/>
                        </Shape>
                        <String CONTENT="Valkaˊʟ̣ên (“having houses of whale’s jaw-bone”), which had during my visit 4 houses with 28 people"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l4" HPOS="448" VPOS="773" WIDTH="1690" HEIGHT="47" BASELINE="451 805 2138 801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 805 451 820 2135 816 2138 801 2131 773 448 775 451 805"/>
                        </Shape>
                        <String CONTENT="(Register, 7 houses, 39 inhabitants). The underground houses alluded to in the name went"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l5" HPOS="451" VPOS="814" WIDTH="1682" HEIGHT="54" BASELINE="453 851 2133 844" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 851 453 868 2131 861 2133 844 2127 814 451 820 453 851"/>
                        </Shape>
                        <String CONTENT="out of use long ago, and the inhabitants now live in large “genuine houses” of the usual type.¹"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l6" HPOS="373" VPOS="879" WIDTH="1767" HEIGHT="52" BASELINE="375 911 2140 907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 911 375 931 2138 931 2140 907 2133 879 373 881 375 911"/>
                        </Shape>
                        <String CONTENT="ᴇˊnmɪlɪn (“craggy”), in the Aiˊwan Eskimo language Tɪkɪˊvak, which lies five miles farther on, along"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l7" HPOS="455" VPOS="926" WIDTH="1683" HEIGHT="50" BASELINE="455 954 2138 954" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 954 455 974 2135 976 2138 954 2138 926 455 926 455 954"/>
                        </Shape>
                        <String CONTENT="the shore. It had 17 houses, and a mile from it 2 more, with a total population of 126 (Register,"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l8" HPOS="455" VPOS="972" WIDTH="502" HEIGHT="52" BASELINE="457 1006 957 1000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 1006 457 1024 955 1017 957 1000 951 972 455 976 457 1006"/>
                        </Shape>
                        <String CONTENT="19 houses, 104 inhabitants)."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l9" HPOS="373" VPOS="1024" WIDTH="1767" HEIGHT="52" BASELINE="375 1058 2140 1052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1058 375 1076 2138 1069 2140 1052 2133 1024 373 1028 375 1058"/>
                        </Shape>
                        <String CONTENT="Nuˊnlig̣ren (see Plate I, Fig. 2), which had 17 houses in one place, and 4 in another near by, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l10" HPOS="451" VPOS="1069" WIDTH="1050" HEIGHT="54" BASELINE="453 1106 1501 1097" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 1106 453 1123 1499 1117 1501 1097 1494 1069 451 1076 453 1106"/>
                        </Shape>
                        <String CONTENT="a population of 104 (Register, 25 houses, 110 inhabitants)."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l11" HPOS="375" VPOS="1128" WIDTH="1763" HEIGHT="62" BASELINE="377 1164 2138 1156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1164 377 1190 2135 1173 2138 1156 2131 1128 375 1134 377 1164"/>
                        </Shape>
                        <String CONTENT="Aˊčon, the last Chukchee village, which had during my visit 5 houses with 24 inhabitants. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l12" HPOS="453" VPOS="1177" WIDTH="1687" HEIGHT="52" BASELINE="455 1212 2140 1206" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 1212 455 1229 2138 1223 2140 1206 2133 1177 453 1182 455 1212"/>
                        </Shape>
                        <String CONTENT="were very poor Reindeer people, who had turned to seal-hunting as a last resort, but were not"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l13" HPOS="451" VPOS="1225" WIDTH="1063" HEIGHT="52" BASELINE="453 1258 1514 1253" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 1258 453 1277 1512 1273 1514 1253 1507 1225 451 1227 453 1258"/>
                        </Shape>
                        <String CONTENT="successful even at that (Register, 4 houses, 19 inhabitants)."/>
                    </TextLine>
<TextLine ID="mz_1-051_l14" HPOS="1176" VPOS="1307" WIDTH="160" HEIGHT="52" BASELINE="1178 1344 1336 1338" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1178 1344 1178 1359 1334 1355 1336 1338 1330 1307 1176 1312 1178 1344"/>
                        </Shape>
                        <String CONTENT="ESKIMO."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l15" HPOS="375" VPOS="1383" WIDTH="1765" HEIGHT="52" BASELINE="377 1416 2140 1411" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1416 377 1435 2138 1431 2140 1411 2133 1383 375 1385 377 1416"/>
                        </Shape>
                        <String CONTENT="Wuteˊen or Wuˊturen (Eskimo, Čeṛiˊnak), the first Eskimo village, which lies near Cape Ulakhpen."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l16" HPOS="451" VPOS="1424" WIDTH="1329" HEIGHT="59" BASELINE="453 1465 1780 1459" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 1465 453 1483 1778 1476 1780 1459 1774 1424 451 1435 453 1465"/>
                        </Shape>
                        <String CONTENT="It had 8 houses with 58 inhabitants (Register, 14 houses, 77 inhabitants).²"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l17" HPOS="375" VPOS="1487" WIDTH="1758" HEIGHT="61" BASELINE="377 1526 2133 1515" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1526 377 1548 2131 1532 2133 1515 2127 1487 375 1496 377 1526"/>
                        </Shape>
                        <String CONTENT="Between Aˊčon and Wuteˊen, in former times, there was a small settlement, Čeˊnlin, occupied by"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l18" HPOS="453" VPOS="1535" WIDTH="1687" HEIGHT="54" BASELINE="455 1571 2140 1563" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 1571 455 1589 2138 1580 2140 1563 2133 1535 453 1541 455 1571"/>
                        </Shape>
                        <String CONTENT="the Wuteˊelɪt and the Chukchee. The greater part of its inhabitants, however, perished in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l19" HPOS="453" VPOS="1582" WIDTH="1687" HEIGHT="52" BASELINE="455 1617 2140 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 1617 455 1634 2138 1628 2140 1610 2133 1582 453 1587 455 1617"/>
                        </Shape>
                        <String CONTENT="famine of 1880. The remainder turned to reindeer-breeding or emigrated to Wuteˊen and to"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l20" HPOS="453" VPOS="1636" WIDTH="377" HEIGHT="48" BASELINE="453 1665 830 1665" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 1665 453 1684 830 1684 830 1665 830 1636 453 1636 453 1665"/>
                        </Shape>
                        <String CONTENT="St. Lawrence Island."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l21" HPOS="375" VPOS="1682" WIDTH="1763" HEIGHT="54" BASELINE="377 1719 2138 1710" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 1691 377 1719 377 1736 2135 1732 2138 1710 2131 1682 375 1688 375 1691"/>
                        </Shape>
                        <String CONTENT="Iˊmtun (Eskimo, Iˊmtuk), a few miles off, which had 12 houses with 65 inhabitants (Register, 9"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l22" HPOS="451" VPOS="1729" WIDTH="1689" HEIGHT="63" BASELINE="453 1768 2140 1758" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 1768 453 1792 2138 1773 2140 1758 2133 1729 451 1738 453 1768"/>
                        </Shape>
                        <String CONTENT="houses, 43 inhabitants). Most of the people are Aiˊwan, but four families came from Wuteˊen."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l23" HPOS="375" VPOS="1788" WIDTH="1763" HEIGHT="54" BASELINE="377 1823 2138 1816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 1823 377 1842 2135 1840 2138 1816 2131 1788 375 1792 377 1823"/>
                        </Shape>
                        <String CONTENT="Iˊᵋen (Eskimo, Ṛɪˊṛak), in Plover Bay, which had only 2 houses with 9 inhabitants (Register, 4"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l24" HPOS="455" VPOS="1836" WIDTH="1683" HEIGHT="54" BASELINE="457 1872 2138 1864" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 1872 457 1890 2135 1883 2138 1864 2131 1836 455 1842 457 1872"/>
                        </Shape>
                        <String CONTENT="houses, 24 inhabitants); but two families moved to Euˊnmun a little while before our coming."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l25" HPOS="455" VPOS="1888" WIDTH="710" HEIGHT="49" BASELINE="457 1920 1165 1916" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 1920 457 1937 1163 1937 1165 1916 1159 1888 455 1890 457 1920"/>
                        </Shape>
                        <String CONTENT="The people are Aiˊwan, and very poor."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l26" HPOS="377" VPOS="1931" WIDTH="1763" HEIGHT="58" BASELINE="379 1974 2140 1959" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1974 379 1989 2140 1974 2140 1959 2133 1931 377 1944 379 1974"/>
                        </Shape>
                        <String CONTENT="Euˊnmun (Eskimo, Aˊvak), near Cape Chukotsky, which during our visit had 12 houses with 88"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l27" HPOS="453" VPOS="1983" WIDTH="1689" HEIGHT="52" BASELINE="455 2020 2142 2011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 2020 455 2035 2140 2026 2142 2011 2135 1983 453 1989 455 2020"/>
                        </Shape>
                        <String CONTENT="inhabitants. Besides these, two families with 10 men came over from Iˊᵋen, where of late"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l28" HPOS="453" VPOS="2028" WIDTH="1685" HEIGHT="57" BASELINE="455 2067 2138 2054" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 2067 455 2085 2135 2072 2138 2054 2131 2028 453 2039 455 2067"/>
                        </Shape>
                        <String CONTENT="sealing has been very unsuccessful. There were then 98 inhabitants in Euˊnmun (Register, 16,"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l29" HPOS="451" VPOS="2078" WIDTH="1126" HEIGHT="52" BASELINE="453 2113 1577 2106" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 2113 453 2130 1575 2124 1577 2106 1570 2078 451 2082 453 2113"/>
                        </Shape>
                        <String CONTENT="houses, 101 inhabitants). The people of Euˊnmun are Aiˊwan."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l30" HPOS="370" VPOS="2130" WIDTH="1772" HEIGHT="61" BASELINE="373 2175 2142 2160" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2175 373 2191 2140 2178 2142 2160 2135 2130 370 2141 373 2175"/>
                        </Shape>
                        <String CONTENT="Čeˊčin (Eskimo, Teˊsik), on the west shore of the bay of the same name (Čečiˊkin quˊim, i. e., Čeˊčin"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l31" HPOS="455" VPOS="2182" WIDTH="1685" HEIGHT="54" BASELINE="457 2219 2140 2210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="457 2219 457 2236 2138 2227 2140 2210 2133 2182 455 2188 457 2219"/>
                        </Shape>
                        <String CONTENT="Bay),³ which had 18 houses with 94 inhabitants (Register, 25 houses, 142 inhabitants). The"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l32" HPOS="448" VPOS="2230" WIDTH="865" HEIGHT="56" BASELINE="451 2269 1313 2260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2269 451 2286 1310 2282 1313 2260 1306 2230 448 2238 451 2269"/>
                        </Shape>
                        <String CONTENT="people are Chukchee and Aiˊwan, half and half."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l33" HPOS="377" VPOS="2286" WIDTH="1767" HEIGHT="58" BASELINE="379 2329 2144 2316" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 2329 379 2344 2144 2331 2144 2316 2138 2286 377 2297 379 2329"/>
                        </Shape>
                        <String CONTENT="Uñiˊin (Eskimo, Uñiˊsak), on Cape Chaplin (Indian Point) (Plate I, Figs. 1, 3), which had 61 houses"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l34" HPOS="453" VPOS="2327" WIDTH="1431" HEIGHT="65" BASELINE="455 2375 1884 2362" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="455 2375 455 2392 1884 2379 1884 2362 1878 2327 453 2347 455 2375"/>
                        </Shape>
                        <String CONTENT="with 442 inhabitants, all of them Aiˊwan (Register, 51 houses, 500 inhabitants).⁴"/>
                    </TextLine>
<TextLine ID="mz_1-051_l35" HPOS="1005" VPOS="2420" WIDTH="502" HEIGHT="52" BASELINE="1007 2457 1507 2448" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1007 2457 1007 2472 1507 2463 1507 2448 1501 2420 1005 2427 1007 2457"/>
                        </Shape>
                        <String CONTENT="NORTH OF INDIAN POINT.⁵"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l36" HPOS="373" VPOS="2489" WIDTH="1769" HEIGHT="72" BASELINE="375 2537 1724 2522 2142 2526" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2537 375 2561 2140 2541 2142 2526 2138 2489 373 2502 375 2537"/>
                        </Shape>
                        <String CONTENT="Nepeˊkuten (Eskimo, Napaˊkutak), on the island called Ipeˊkut in Chukchee (Eskimo, Ciˊṛluk⁶),"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l37" HPOS="448" VPOS="2544" WIDTH="1521" HEIGHT="54" BASELINE="451 2583 1969 2572" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2583 451 2598 1967 2587 1969 2572 1962 2544 448 2552 451 2583"/>
                        </Shape>
                        <String CONTENT="the last Aiˊwan village: 4 houses, 37 inhabitants (Register, 5 houses, 52 inhabitants)."/>
                    </TextLine>
<TextLine ID="mz_1-051_l38" HPOS="490" VPOS="2604" WIDTH="1652" HEIGHT="54" BASELINE="492 2641 2142 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="492 2641 492 2658 2140 2647 2142 2630 2135 2604 490 2613 492 2641"/>
                        </Shape>
                        <String CONTENT="¹ The Chukchee use the expression “genuine house” for a tent-like dwelling with an inner sleeping-room"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l39" HPOS="370" VPOS="2647" WIDTH="1341" HEIGHT="55" BASELINE="373 2684 1711 2676" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 2684 373 2702 1709 2693 1711 2676 1705 2647 370 2654 373 2684"/>
                        </Shape>
                        <String CONTENT="made of heavy skins. For description see the chapter on “Habitations,” farther on."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l40" HPOS="483" VPOS="2693" WIDTH="208" HEIGHT="48" BASELINE="485 2721 691 2725" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="485 2721 483 2736 687 2741 691 2725 689 2697 485 2693 485 2721"/>
                        </Shape>
                        <String CONTENT="² See p. 20."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l41" HPOS="481" VPOS="2730" WIDTH="1663" HEIGHT="54" BASELINE="483 2767 2144 2756" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="483 2767 483 2784 2142 2775 2144 2756 2138 2730 481 2738 483 2767"/>
                        </Shape>
                        <String CONTENT="³ Mr. Gondatti has confounded Providence Bay with Čeˊčin Bay, which led him to many misunderstand-"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l42" HPOS="373" VPOS="2773" WIDTH="1769" HEIGHT="56" BASELINE="375 2812 2142 2799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2812 375 2829 2140 2816 2142 2799 2135 2773 373 2784 375 2812"/>
                        </Shape>
                        <String CONTENT="ings, and induced Mr. Bogdanovitch to hint that Mr. Gondatti did not visit all the places that he mentioned"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l43" HPOS="375" VPOS="2814" WIDTH="1765" HEIGHT="59" BASELINE="377 2855 2140 2840" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2855 377 2873 2138 2857 2140 2840 2133 2814 375 2827 377 2855"/>
                        </Shape>
                        <String CONTENT="(BOGDANOVITCH, pp. 66, 67). On the Russian maps Čeˊčin Bay is called Tkachen Bay or Admiral Butakoff’s"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l44" HPOS="375" VPOS="2855" WIDTH="1312" HEIGHT="57" BASELINE="377 2896 1687 2888" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 2896 377 2912 1685 2903 1687 2888 1681 2855 375 2868 377 2896"/>
                        </Shape>
                        <String CONTENT="Bay. American whalers call it Marquis Bay, of which Krause made “Marcus Bay.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l45" HPOS="485" VPOS="2896" WIDTH="1657" HEIGHT="65" BASELINE="487 2933 2142 2922" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="487 2933 487 2961 2140 2944 2142 2922 2135 2896 485 2905 487 2933"/>
                        </Shape>
                        <String CONTENT="⁴ The decrease in population on this coast since Mr. Gondatti’s visit is due undoubtedly to the epidemic"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l46" HPOS="375" VPOS="2955" WIDTH="465" HEIGHT="43" BASELINE="375 2981 840 2981" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="375 2981 375 2998 840 2998 840 2981 840 2955 375 2955 375 2981"/>
                        </Shape>
                        <String CONTENT="of measles in the year 1899."/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l47" HPOS="481" VPOS="2981" WIDTH="1659" HEIGHT="56" BASELINE="483 3018 2140 3007" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="483 3018 483 3037 2138 3026 2140 3007 2133 2981 481 2990 483 3018"/>
                        </Shape>
                        <String CONTENT="⁵ Northward from Indian Point my information is reliable only for the number of houses. The Register"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l48" HPOS="375" VPOS="3026" WIDTH="1765" HEIGHT="59" BASELINE="377 3067 2140 3052" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="377 3067 377 3085 2138 3067 2140 3052 2133 3026 375 3039 377 3067"/>
                        </Shape>
                        <String CONTENT="gives the number of inhabitants in every case, but I fear the figures are often only approximate. The average"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l49" HPOS="377" VPOS="3067" WIDTH="1763" HEIGHT="59" BASELINE="379 3106 2140 3093" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 3106 379 3126 2138 3113 2140 3093 2133 3067 377 3078 379 3106"/>
                        </Shape>
                        <String CONTENT="of inmates in a house, according to my calculations, which agree with the data given by Mr. Gondatti, is about"/>
                    </TextLine>

                    <TextLine ID="mz_1-051_l50" HPOS="377" VPOS="3111" WIDTH="1765" HEIGHT="56" BASELINE="379 3150 2142 3137" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 3150 379 3167 2140 3156 2142 3137 2135 3111 377 3122 379 3150"/>
                        </Shape>
                        <String CONTENT="6½ or 7. Lieut. Nordquist allows for the villages of the Arctic shore not more than 5 to a house, but this"/>
                    </TextLine>

