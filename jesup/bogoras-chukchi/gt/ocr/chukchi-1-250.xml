            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-250" HPOS="615" VPOS="617" WIDTH="1785" HEIGHT="2630"><TextLine ID="mz_1-250_l1" HPOS="1206" VPOS="617" WIDTH="615" HEIGHT="56" BASELINE="1209 651 1821 656" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1815 628 1800 619 1209 617 1209 651 1206 669 1817 673 1821 656 1819 636 1815 628"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l2" HPOS="639" VPOS="630" WIDTH="95" HEIGHT="62" BASELINE="641 666 734 662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="641 666 641 679 682 692 685 692 687 692 689 692 734 675 734 662 728 630 639 632 641 666"/>
                        </Shape>
                        <String CONTENT="194"/>
                    </TextLine>
<TextLine ID="mz_1-250_l3" HPOS="628" VPOS="718" WIDTH="1767" HEIGHT="65" BASELINE="630 766 2395 762" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2382 736 2361 736 2339 734 2317 734 2296 731 2274 731 2252 731 2231 729 2209 729 2187 727 2166 727 2144 725 2122 729 2094 723 2079 723 2058 723 2049 721 2034 729 2003 721 1993 721 1982 718 1886 729 1352 721 1349 721 1347 721 1345 721 1330 731 1250 721 1248 721 819 731 710 721 708 721 628 734 630 766 630 781 2391 783 2395 762 2391 736 2382 736"/>
                        </Shape>
                        <String CONTENT="tradition among the Reindeer Chukchee, according to which, in olden times,"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l4" HPOS="628" VPOS="783" WIDTH="1772" HEIGHT="59" BASELINE="630 825 2400 820" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 825 630 842 2398 838 2400 820 2395 792 650 783 648 783 646 783 643 783 628 790 630 825"/>
                        </Shape>
                        <String CONTENT="their forefathers had no clay kettles, and the meat was roasted on large flat"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l5" HPOS="626" VPOS="844" WIDTH="1774" HEIGHT="58" BASELINE="628 885 2400 879" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 885 628 902 2398 896 2400 879 2395 851 667 844 665 844 663 844 626 855 628 885"/>
                        </Shape>
                        <String CONTENT="stones heated for the purpose. The Lamut tell the same story of their ances-"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l6" HPOS="628" VPOS="905" WIDTH="1772" HEIGHT="58" BASELINE="630 946 2400 937" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="630 946 630 963 2398 954 2400 937 2395 909 648 905 646 905 643 905 641 905 628 911 630 946"/>
                        </Shape>
                        <String CONTENT="tors; but such a method of cooking is possible only within the borders of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l7" HPOS="624" VPOS="961" WIDTH="1776" HEIGHT="67" BASELINE="626 1004 2400 1000" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1004 626 1017 1196 1028 1198 1028 1300 1017 1382 1028 1384 1028 1386 1028 1414 1017 1445 1028 1447 1028 1449 1028 1451 1028 1453 1028 1466 1017 1510 1026 1512 1026 1761 1015 1780 1026 1782 1026 1785 1026 1787 1026 1958 1015 2001 1026 2003 1026 2006 1026 2231 1015 2285 1026 2287 1026 2289 1026 2291 1026 2309 1015 2376 1026 2378 1026 2380 1026 2382 1026 2400 1013 2400 1000 2395 972 1516 961 1514 961 1512 961 1490 972 643 963 641 963 639 963 637 963 624 970 626 1004"/>
                        </Shape>
                        <String CONTENT="forest, where the supply of fuel is abundant. On the tundra and on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l8" HPOS="624" VPOS="1024" WIDTH="1776" HEIGHT="71" BASELINE="626 1065 2400 1058" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1065 626 1095 801 1080 1174 1089 1176 1089 1280 1078 1447 1091 1449 1091 1451 1091 1453 1091 1468 1078 1529 1089 1531 1089 1533 1089 1579 1078 1661 1091 1663 1091 1763 1078 1802 1086 1804 1086 1806 1086 2105 1076 2229 1089 2231 1089 2233 1089 2270 1076 2398 1076 2400 1058 2395 1030 646 1024 643 1024 641 1024 639 1024 624 1030 626 1065"/>
                        </Shape>
                        <String CONTENT="treeless coast a method of cooking that requires less fuel must always have"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l9" HPOS="626" VPOS="1078" WIDTH="1772" HEIGHT="65" BASELINE="628 1128 2398 1119" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1128 628 1143 2395 1134 2398 1119 2393 1089 2010 1078 2008 1078 1947 1091 626 1091 628 1128"/>
                        </Shape>
                        <String CONTENT="been in use. Therefore it seems probable that the lamp and the kettle were"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l10" HPOS="624" VPOS="1145" WIDTH="901" HEIGHT="56" BASELINE="626 1186 1525 1180" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1186 626 1201 1523 1199 1525 1180 1520 1151 633 1145 630 1145 628 1145 626 1145 626 1147 624 1147 626 1186"/>
                        </Shape>
                        <String CONTENT="in use in former times as well as now."/>
                    </TextLine>
<TextLine ID="mz_1-250_l11" HPOS="736" VPOS="1193" WIDTH="1662" HEIGHT="69" BASELINE="739 1247 2398 1236" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="739 1247 739 1262 2395 1251 2398 1236 2393 1206 2283 1206 2265 1193 2263 1193 2261 1193 2259 1193 2257 1193 2231 1203 2213 1193 2211 1193 2209 1193 2207 1193 2205 1193 2203 1193 2187 1206 2062 1206 1960 1195 1958 1195 1956 1195 1928 1206 1912 1195 1910 1195 1908 1195 1906 1195 1904 1195 1871 1206 1841 1195 1839 1195 1837 1195 1834 1195 1808 1206 1785 1195 1782 1195 1780 1195 1778 1195 1728 1208 1507 1197 1505 1197 1503 1197 1471 1208 1445 1197 1442 1197 1440 1197 1438 1197 1384 1210 1356 1199 1354 1199 1352 1199 1300 1210 1241 1199 1239 1199 1237 1199 1211 1210 1183 1199 1180 1199 1178 1199 1126 1210 736 1210 739 1247"/>
                        </Shape>
                        <String CONTENT="The Yukaghir and the Kamchadal used to boil their meat and fish in"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l12" HPOS="624" VPOS="1260" WIDTH="1771" HEIGHT="62" BASELINE="626 1307 2395 1301" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1307 626 1320 2391 1322 2395 1301 2391 1271 1865 1260 1863 1260 1800 1273 624 1273 626 1307"/>
                        </Shape>
                        <String CONTENT="bark or wooden vessels by means of heated stones. This method of boiling"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l13" HPOS="624" VPOS="1322" WIDTH="1774" HEIGHT="63" BASELINE="626 1370 2398 1359" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1370 626 1385 2395 1374 2398 1359 2393 1329 1334 1322 1332 1322 1330 1322 1328 1322 1308 1333 1009 1325 1007 1325 624 1338 626 1370"/>
                        </Shape>
                        <String CONTENT="meat is still used occasionally by the hunter, who carries no kettle, and who"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l14" HPOS="624" VPOS="1377" WIDTH="1776" HEIGHT="65" BASELINE="626 1429 2400 1420" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1429 626 1442 2398 1433 2400 1420 2395 1390 2343 1377 2341 1377 2339 1377 2311 1387 2099 1377 2097 1377 2010 1387 1964 1377 1962 1377 1960 1377 1891 1390 1858 1379 1856 1379 1854 1379 1679 1390 1616 1379 1614 1379 1611 1379 1583 1390 1512 1379 1510 1379 1507 1379 1505 1379 1481 1392 1180 1381 1178 1381 1176 1381 1139 1392 1107 1381 1105 1381 1102 1381 1100 1381 1098 1381 1083 1392 758 1383 756 1383 754 1383 752 1383 736 1396 624 1396 626 1429"/>
                        </Shape>
                        <String CONTENT="may boil his meat in the old way. The Kamchadal of Central Kamchatka"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l15" HPOS="624" VPOS="1437" WIDTH="1774" HEIGHT="67" BASELINE="626 1487 2398 1476" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1487 626 1504 2395 1494 2398 1476 2393 1448 2042 1437 2040 1437 2038 1437 2008 1448 1007 1444 1005 1444 1003 1444 975 1455 771 1446 769 1446 624 1457 626 1487"/>
                        </Shape>
                        <String CONTENT="extract the fish-oil of Salmo sanguinolentus by trying out the fish in a dug-out"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l16" HPOS="626" VPOS="1502" WIDTH="444" HEIGHT="59" BASELINE="628 1545 1070 1541" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="628 1545 628 1561 1070 1556 1070 1541 1066 1513 877 1502 875 1502 873 1502 843 1513 667 1504 665 1504 663 1504 626 1515 628 1545"/>
                        </Shape>
                        <String CONTENT="with heated stones."/>
                    </TextLine>
<TextLine ID="mz_1-250_l17" HPOS="734" VPOS="1561" WIDTH="1664" HEIGHT="60" BASELINE="736 1604 2398 1595" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="736 1604 736 1621 2395 1613 2398 1595 2393 1567 1170 1561 1167 1561 1074 1571 758 1563 756 1563 754 1563 734 1571 736 1604"/>
                        </Shape>
                        <String CONTENT="At present the Chukchee use little roasted meat. They hardly know how"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l18" HPOS="622" VPOS="1628" WIDTH="1773" HEIGHT="52" BASELINE="624 1665 2395 1658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 1665 624 1680 2393 1673 2395 1658 2389 1628 622 1632 624 1665"/>
                        </Shape>
                        <String CONTENT="to roast it properly. Fish and lungs, which are sometimes roasted near the"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l19" HPOS="624" VPOS="1686" WIDTH="1771" HEIGHT="56" BASELINE="626 1725 2395 1714" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1725 626 1742 2393 1732 2395 1714 2389 1686 624 1695 626 1725"/>
                        </Shape>
                        <String CONTENT="fire, are always covered with ashes, charred from without, and quite raw"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l20" HPOS="624" VPOS="1738" WIDTH="1771" HEIGHT="63" BASELINE="626 1786 2395 1777" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1786 626 1801 2393 1792 2395 1777 2391 1747 1510 1738 1507 1738 1442 1749 1083 1740 1081 1740 1079 1740 1057 1751 669 1742 667 1742 665 1742 624 1753 626 1786"/>
                        </Shape>
                        <String CONTENT="within. The Yukaghir and Kamchadal roast fish and meat very well on thin"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l21" HPOS="624" VPOS="1803" WIDTH="1132" HEIGHT="59" BASELINE="626 1846 1756 1840" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 1846 626 1862 1754 1857 1756 1840 1752 1812 1020 1803 1018 1803 624 1816 626 1846"/>
                        </Shape>
                        <String CONTENT="wooden spits stuck into the ground near the fire."/>
                    </TextLine>
<TextLine ID="mz_1-250_l22" HPOS="730" VPOS="1855" WIDTH="1665" HEIGHT="67" BASELINE="732 1905 2395 1894" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="732 1905 732 1922 2393 1911 2395 1894 2391 1866 2133 1855 2131 1855 2058 1866 1731 1857 1728 1857 1726 1857 1694 1868 1414 1859 1412 1859 1410 1859 1408 1859 1391 1870 1152 1862 1150 1862 730 1872 732 1905"/>
                        </Shape>
                        <String CONTENT="RAW AND PUTRID MEAT AND CARRION. — Raw, frozen meat is eaten by"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l23" HPOS="620" VPOS="1916" WIDTH="1775" HEIGHT="65" BASELINE="622 1965 2395 1957" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 1965 622 1981 2393 1972 2395 1957 2391 1927 2348 1916 2346 1916 2213 1927 2190 1916 2187 1916 2185 1916 2183 1916 2146 1927 2105 1916 2103 1916 2101 1916 2036 1927 1975 1916 1973 1916 1971 1916 1945 1929 1557 1918 1555 1918 1553 1918 1501 1931 1341 1920 1339 1920 1336 1920 1304 1931 1269 1920 1267 1920 1265 1920 1148 1931 1096 1920 1094 1920 1031 1933 1014 1922 1012 1922 1009 1922 1007 1922 886 1933 864 1922 862 1922 736 1922 734 1922 732 1922 700 1933 648 1922 646 1922 643 1922 620 1931 622 1965"/>
                        </Shape>
                        <String CONTENT="the Reindeer Chukchee and all the neighboring tribes. The Arctic people"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l24" HPOS="622" VPOS="1978" WIDTH="1773" HEIGHT="63" BASELINE="624 2026 2395 2020" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2026 624 2041 2393 2035 2395 2020 2391 1989 1843 1978 1841 1978 1839 1978 1791 1989 723 1983 721 1983 622 1994 624 2026"/>
                        </Shape>
                        <String CONTENT="consider meat that is raw and hard-frozen just as palatable as cooked meat."/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l25" HPOS="624" VPOS="2037" WIDTH="1767" HEIGHT="65" BASELINE="626 2089 2391 2078" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="626 2089 626 2102 2389 2095 2391 2078 2387 2048 2073 2037 2071 2037 2068 2037 2032 2048 1817 2039 1815 2039 1679 2050 1447 2041 1445 2041 1315 2054 624 2054 626 2089"/>
                        </Shape>
                        <String CONTENT="I must acknowledge that I soon learned to eat it and to like its taste."/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l26" HPOS="622" VPOS="2095" WIDTH="1773" HEIGHT="67" BASELINE="624 2150 2395 2139" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2150 624 2162 2393 2152 2395 2139 2393 2108 2367 2095 2365 2095 2363 2095 2257 2106 2187 2095 2185 2095 2183 2095 2153 2106 2103 2095 2101 2095 2019 2108 1828 2098 1826 2098 1761 2108 1657 2100 1655 2100 1653 2100 1650 2100 1635 2111 1391 2100 1388 2100 1267 2113 1191 2102 1189 2102 1087 2113 622 2113 624 2150"/>
                        </Shape>
                        <String CONTENT="Especially when we had to live for a long time exclusively on fat fish, with"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l27" HPOS="622" VPOS="2162" WIDTH="1773" HEIGHT="61" BASELINE="624 2208 2395 2195" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2208 624 2223 2395 2210 2395 2195 2391 2167 1228 2162 1226 2162 1224 2162 1202 2173 691 2167 689 2167 622 2178 624 2208"/>
                        </Shape>
                        <String CONTENT="not so much as a pinch of salt to season it, we found this diet more tolerable"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l28" HPOS="624" VPOS="2223" WIDTH="1068" HEIGHT="56" BASELINE="624 2264 1692 2264" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="624 2264 624 2279 1692 2279 1692 2264 1692 2232 1676 2223 1674 2223 1672 2223 1568 2223 1566 2223 1564 2223 1562 2223 1562 2225 1551 2234 1373 2223 1371 2223 1308 2236 938 2236 871 2223 869 2223 812 2234 788 2223 786 2223 784 2223 693 2234 672 2223 669 2223 667 2223 665 2223 624 2234 624 2264"/>
                        </Shape>
                        <String CONTENT="when the fish was eaten raw and frozen hard."/>
                    </TextLine>
<TextLine ID="mz_1-250_l29" HPOS="728" VPOS="2282" WIDTH="1665" HEIGHT="60" BASELINE="730 2325 2393 2318" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="730 2325 730 2342 2391 2342 2393 2318 2389 2288 741 2282 739 2282 736 2282 734 2282 734 2284 728 2288 730 2325"/>
                        </Shape>
                        <String CONTENT="Liver and kidneys, heart, tendons of the legs, gristle of the nose, eyes,"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l30" HPOS="620" VPOS="2344" WIDTH="1773" HEIGHT="57" BASELINE="622 2385 2393 2375" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2385 622 2401 2391 2392 2393 2375 2387 2344 620 2353 622 2385"/>
                        </Shape>
                        <String CONTENT="and marrow are consumed raw summer and winter, immediately after the"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l31" HPOS="620" VPOS="2398" WIDTH="1773" HEIGHT="63" BASELINE="622 2446 2393 2437" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2446 622 2461 2391 2453 2393 2437 2389 2407 1510 2398 1507 2398 1505 2398 1475 2409 1096 2401 1094 2401 1092 2401 1059 2411 672 2403 669 2403 620 2414 622 2446"/>
                        </Shape>
                        <String CONTENT="reindeer has been slaughtered. Blood is also consumed raw, fresh, or half-"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l32" HPOS="620" VPOS="2461" WIDTH="1775" HEIGHT="65" BASELINE="622 2507 2395 2498" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="622 2507 622 2526 2393 2520 2395 2498 2391 2468 1085 2461 1083 2461 620 2474 622 2507"/>
                        </Shape>
                        <String CONTENT="putrid. The Chukchee are averse to eating other parts of the animal raw;"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l33" HPOS="617" VPOS="2524" WIDTH="1776" HEIGHT="56" BASELINE="620 2563 2393 2554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2563 620 2580 2391 2572 2393 2554 2387 2524 617 2531 620 2563"/>
                        </Shape>
                        <String CONTENT="and I know of cases where a herdsman who had no kettle killed one buck"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l34" HPOS="617" VPOS="2576" WIDTH="1774" HEIGHT="67" BASELINE="620 2626 2391 2617" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2626 620 2643 2389 2643 2391 2617 2387 2587 1956 2576 1954 2576 1951 2576 1949 2576 1949 2578 1938 2587 1520 2578 1518 2578 1516 2578 1514 2578 1497 2589 659 2583 656 2583 654 2583 617 2593 620 2626"/>
                        </Shape>
                        <String CONTENT="after another, and ate only those parts that are considered fit to be eaten raw,"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l35" HPOS="617" VPOS="2639" WIDTH="949" HEIGHT="60" BASELINE="620 2684 1566 2680" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2684 620 2699 1564 2695 1566 2680 1564 2650 1546 2639 1544 2639 1542 2639 1540 2639 1538 2639 1492 2652 1193 2652 1165 2639 1163 2639 1161 2639 1159 2639 1157 2639 1144 2650 1118 2639 1115 2639 1113 2639 1111 2639 1083 2652 626 2641 624 2641 622 2641 620 2641 620 2643 617 2643 620 2684"/>
                        </Shape>
                        <String CONTENT="leaving all the rest of the meat to spoil."/>
                    </TextLine>
<TextLine ID="mz_1-250_l36" HPOS="730" VPOS="2695" WIDTH="1665" HEIGHT="65" BASELINE="732 2745 2395 2734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="732 2745 732 2760 2393 2751 2395 2734 2389 2706 2029 2706 2006 2695 2003 2695 2001 2695 1999 2695 1997 2695 1984 2708 1906 2708 1837 2695 1834 2695 1785 2706 1759 2695 1756 2695 1754 2695 1752 2695 1711 2708 1696 2697 1694 2697 1692 2697 1689 2697 1687 2697 1659 2708 1609 2697 1607 2697 1425 2708 1399 2697 1397 2697 1395 2697 1393 2697 1349 2710 1230 2699 1083 2699 1081 2699 1079 2699 1076 2699 1059 2712 986 2702 983 2702 730 2706 732 2745"/>
                        </Shape>
                        <String CONTENT="The Reindeer Chukchee, and especially the herdsmen, however, are not"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l37" HPOS="617" VPOS="2760" WIDTH="1774" HEIGHT="61" BASELINE="620 2805 2391 2799" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2805 620 2818 2387 2821 2391 2799 2387 2769 1215 2760 1213 2760 1146 2771 834 2762 832 2762 617 2773 620 2805"/>
                        </Shape>
                        <String CONTENT="very particular as to their food. They eat the maggots of the reindeer-fly,"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l38" HPOS="617" VPOS="2823" WIDTH="1776" HEIGHT="56" BASELINE="620 2864 2393 2857" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2864 620 2879 2391 2873 2393 2857 2389 2825 687 2823 685 2823 617 2834 620 2864"/>
                        </Shape>
                        <String CONTENT="and various herbs which taste to us unsavory or repugnant. In exceptional"/>
                    </TextLine>

                    <TextLine ID="mz_1-250_l39" HPOS="617" VPOS="2877" WIDTH="1776" HEIGHT="65" BASELINE="620 2925 2393 2914" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="620 2925 620 2942 2391 2931 2393 2914 2389 2886 1683 2877 1681 2877 1679 2877 1676 2877 1659 2888 975 2881 973 2881 617 2894 620 2925"/>
                        </Shape>
                        <String CONTENT="cases they gather toadstools and the green, half-liquid dung of the reindeer"/>
                    </TextLine>

