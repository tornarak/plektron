                        </Shape>
                        <String CONTENT="proffered. The answer was, “Who knows! To the vaˊɪrg̣ɪn, to the keˊlᴇ"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l14" HPOS="295" VPOS="1235" WIDTH="1773" HEIGHT="73" BASELINE="297 1286 2068 1278" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="297 1286 297 1298 577 1308 579 1308 581 1308 609 1298 650 1308 652 1308 654 1308 656 1308 658 1308 673 1298 802 1306 804 1306 806 1306 840 1296 871 1306 873 1306 875 1306 877 1306 879 1306 897 1294 2066 1292 2068 1278 2064 1249 1899 1235 1897 1235 1895 1235 1893 1235 1876 1249 1795 1249 1766 1235 1764 1235 1762 1235 1760 1235 1758 1235 1741 1247 1670 1237 1668 1237 1613 1249 1594 1237 1592 1237 1590 1237 1588 1237 1586 1237 1558 1249 1484 1237 1482 1237 1419 1249 1363 1237 1361 1237 1359 1237 1357 1237 1337 1251 1167 1251 944 1239 942 1239 940 1239 889 1251 834 1239 832 1239 773 1251 742 1239 740 1239 738 1239 663 1253 618 1241 616 1241 614 1241 458 1251 442 1241 440 1241 438 1241 311 1241 309 1241 307 1241 305 1241 295 1249 297 1286"/>
                        </Shape>
                        <String CONTENT="(“Qo! vaɪrg̣êˊtɪ, kalag̣tɪˊ”). Both names were intended for the class of beings"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l15" HPOS="295" VPOS="1302" WIDTH="1773" HEIGHT="53" BASELINE="295 1341 2068 1341" TAGREFS="TYPE_4">
                        <Shape>
