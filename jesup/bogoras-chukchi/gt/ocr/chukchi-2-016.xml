                        </Shape>
                        <String CONTENT="The word “vaˊɪrg̣ɪn” (pl. vaˊɪrg̣ɪt) signifies simply “being,” and therefore"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l18" HPOS="295" VPOS="1478" WIDTH="1775" HEIGHT="57" BASELINE="297 1521 2070 1517" TAGREFS="TYPE_4">
