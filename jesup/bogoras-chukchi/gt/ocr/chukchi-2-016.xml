                        </Shape>
                        <String CONTENT="friendly to man, because no Chukchee will openly confess to having made"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l16" HPOS="295" VPOS="1372" WIDTH="1495" HEIGHT="45" BASELINE="295 1402 1790 1402" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="295 1402 295 1417 1790 1417 1790 1402 1790 1372 295 1372 295 1402"/>
