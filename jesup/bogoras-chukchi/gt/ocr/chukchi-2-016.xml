                        </Shape>
                        <String CONTENT="Many times when witnessing sacrifices made by the common people,"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l12" HPOS="295" VPOS="1128" WIDTH="1771" HEIGHT="54" BASELINE="297 1159 2066 1163" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="297 1159 295 1171 2062 1182 2066 1163 2064 1131 297 1128 297 1159"/>
                        </Shape>
                        <String CONTENT="who know little of spiritual matters, I asked to whom the sacrifice was being"/>
