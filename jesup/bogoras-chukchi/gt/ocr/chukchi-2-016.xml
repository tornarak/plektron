                        </Shape>
                        <String CONTENT="are referred to as keˊlet; but, strictly speaking, this use of the term is incor-"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l8" HPOS="291" VPOS="881" WIDTH="1781" HEIGHT="64" BASELINE="293 924 2072 918" TAGREFS="TYPE_4">
                        <Shape>
