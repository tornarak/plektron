<TextLine ID="mz_2-016_l22" HPOS="403" VPOS="1717" WIDTH="1665" HEIGHT="57" BASELINE="405 1762 2068 1758" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1762 405 1774 2066 1770 2068 1758 2066 1731 2015 1717 2013 1717 2011 1717 2009 1717 1972 1731 1688 1731 1670 1717 1668 1717 1666 1717 1613 1717 1611 1717 1609 1717 1607 1717 1590 1729 1488 1717 1486 1717 1484 1717 1451 1729 1394 1717 1392 1717 1292 1729 1261 1717 1259 1717 1257 1717 1177 1729 1073 1719 1071 1719 1069 1719 1067 1719 1051 1731 992 1719 991 1719 989 1719 953 1731 871 1719 869 1719 867 1719 836 1731 765 1719 763 1719 761 1719 718 1731 693 1719 691 1719 689 1719 638 1729 585 1719 583 1719 403 1725 405 1762"/>
                        </Shape>
                        <String CONTENT="I mentioned also that the “owners” of the rivers, lakes, etc., are also"/>
