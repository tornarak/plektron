                        </Shape>
                        <String CONTENT="to mankind. Sometimes, however, all kinds of spirits, harmful or harmless,"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l7" HPOS="293" VPOS="820" WIDTH="1775" HEIGHT="55" BASELINE="295 861 2068 857" TAGREFS="TYPE_4">
                        <Shape>
