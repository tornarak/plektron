                        </Shape>
                        <String CONTENT="supernatural beings, — the harmful keˊlᴇ or evil spirit and the benevolent"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l10" HPOS="295" VPOS="1010" WIDTH="194" HEIGHT="59" BASELINE="297 1039 489 1043" TAGREFS="TYPE_4">
