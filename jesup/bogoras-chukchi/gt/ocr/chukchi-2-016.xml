                        </Shape>
                        <String CONTENT="mythology of the Chukchee. Most prominent among them are the keˊlet"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l5" HPOS="293" VPOS="697" WIDTH="1773" HEIGHT="62" BASELINE="295 748 2066 738" TAGREFS="TYPE_4">
