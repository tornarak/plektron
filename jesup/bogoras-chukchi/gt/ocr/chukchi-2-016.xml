                        </Shape>
                        <String CONTENT="Stories about such beings form the greater part of the folk-lore and"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l4" HPOS="291" VPOS="640" WIDTH="1777" HEIGHT="57" BASELINE="293 683 2068 679" TAGREFS="TYPE_4">
