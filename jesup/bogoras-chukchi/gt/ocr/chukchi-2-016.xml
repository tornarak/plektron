                        <Shape>
                            <Polygon POINTS="299 1582 299 1596 2068 1596 2070 1578 2064 1543 1821 1549 1727 1539 1725 1539 1678 1549 1574 1539 1572 1539 1506 1549 1457 1539 1455 1539 1312 1549 1273 1539 1271 1539 1269 1539 1267 1539 1245 1551 1092 1551 1008 1541 1006 1541 949 1551 851 1541 850 1541 848 1541 846 1541 832 1551 797 1541 795 1541 793 1541 740 1551 679 1541 677 1541 548 1551 511 1541 509 1541 507 1541 505 1541 462 1551 315 1541 313 1541 311 1541 309 1541 297 1549 299 1582"/>
                        </Shape>
                        <String CONTENT="fication is usually desired. For example, aqaˊm-vaˊɪrg̣ɪt indicates “bad"/>
                    </TextLine>

