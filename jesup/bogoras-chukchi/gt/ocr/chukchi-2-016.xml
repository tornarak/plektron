                        </Shape>
                        <String CONTENT="rect. An accurate speaker will distinguish at least two separate classes of"/>
                    </TextLine>

                    <TextLine ID="mz_2-016_l9" HPOS="293" VPOS="940" WIDTH="1779" HEIGHT="62" BASELINE="295 983 2072 979" TAGREFS="TYPE_4">
