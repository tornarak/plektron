                        </Shape>
                        <String CONTENT="sugar, and tobacco. They took all this, but then declared that they wanted"/>
                    </TextLine>

                    <TextLine ID="mz_3-127_l5" HPOS="387" VPOS="687" WIDTH="1768" HEIGHT="58" BASELINE="389 730 2155 726" TAGREFS="TYPE_5">
