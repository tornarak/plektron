                            <Polygon POINTS="395 1209 395 1221 2163 1227 2167 1205 2163 1178 393 1172 395 1209"/>
                        </Shape>
                        <String CONTENT="had a cousin who was an assistant herdsman in a large tundra herd on the."/>
