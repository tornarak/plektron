                        </Shape>
                        <String CONTENT="the Cossack who killed the man, or at least any other of the Cossacks. He"/>
                    </TextLine>

                    <TextLine ID="mz_3-127_l6" HPOS="389" VPOS="747" WIDTH="1768" HEIGHT="59" BASELINE="391 790 2157 786" TAGREFS="TYPE_5">
