                <TextBlock ID="text_1-058" HPOS="624" VPOS="599" WIDTH="1817" HEIGHT="2639"><TextLine ID="mz_1-058_l1" HPOS="1228" VPOS="599" WIDTH="619" HEIGHT="57" BASELINE="1230 634 1847 638" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1837 602 1250 599 1230 602 1230 634 1228 651 1843 656 1847 638 1845 615 1837 602"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l2" HPOS="669" VPOS="599" WIDTH="44" HEIGHT="67" BASELINE="674 647 713 645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="674 647 674 666 713 660 713 645 706 599 669 606 674 647"/>
                        </Shape>
                        <String CONTENT="36"/>
                    </TextLine>
<TextLine ID="mz_1-058_l3" HPOS="654" VPOS="705" WIDTH="1778" HEIGHT="59" BASELINE="656 749 2432 744" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2408 718 2387 716 2365 716 2343 716 2322 714 2300 714 2291 712 680 705 678 705 676 705 654 714 656 749 656 764 2430 760 2432 744 2428 718 2408 718"/>
                        </Shape>
                        <String CONTENT="the bloody wars of the early conquest by the Cossacks, and in subsequent"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l4" HPOS="656" VPOS="764" WIDTH="1776" HEIGHT="61" BASELINE="659 809 2432 801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 809 659 825 2430 816 2432 801 2428 773 1544 764 1542 764 1540 764 1505 775 739 768 736 768 656 779 659 809"/>
                        </Shape>
                        <String CONTENT="mutinies, which were subdued by wholesale murder. After that came severe"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l5" HPOS="656" VPOS="825" WIDTH="1776" HEIGHT="62" BASELINE="659 870 2432 863" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 870 659 887 2430 881 2432 863 2428 833 1250 825 1248 825 656 838 659 870"/>
                        </Shape>
                        <String CONTENT="oppression; demand of tribute (hitherto wholly unknown); exactions from the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l6" HPOS="656" VPOS="894" WIDTH="1774" HEIGHT="52" BASELINE="659 926 2430 922" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 926 659 946 2428 941 2430 922 2424 894 656 896 659 926"/>
                        </Shape>
                        <String CONTENT="officials and Cossacks, who succeeded in enslaving a number of the strongest"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l7" HPOS="656" VPOS="946" WIDTH="1774" HEIGHT="60" BASELINE="659 989 2430 983" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 989 659 1006 2428 1000 2430 983 2426 954 1291 946 1289 946 656 959 659 989"/>
                        </Shape>
                        <String CONTENT="men and women; and the fraudulent acts of the merchants, who imposed on"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l8" HPOS="656" VPOS="1002" WIDTH="1776" HEIGHT="63" BASELINE="659 1050 2432 1043" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1050 659 1065 2430 1058 2432 1043 2428 1015 2003 1002 2001 1002 1999 1002 1962 1013 1899 1002 1897 1002 1895 1002 1873 1013 1843 1002 1841 1002 1839 1002 1776 1015 1713 1004 1711 1004 1605 1015 1460 1004 1458 1004 1455 1004 1429 1015 1380 1004 1378 1004 1375 1004 1330 1015 1256 1004 1254 1004 1252 1004 1250 1004 1235 1017 1222 1006 1219 1006 1217 1006 1215 1006 990 1017 912 1006 910 1006 908 1006 866 1017 767 1006 765 1006 762 1006 736 1017 693 1006 691 1006 689 1006 687 1006 656 1017 659 1050"/>
                        </Shape>
                        <String CONTENT="all those that remained free the burden of interminable debts. Then came"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l9" HPOS="656" VPOS="1069" WIDTH="1776" HEIGHT="54" BASELINE="659 1110 2432 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1110 659 1123 2432 1117 2432 1104 2428 1076 747 1069 745 1069 656 1080 659 1110"/>
                        </Shape>
                        <String CONTENT="contagious diseases, which made havoc not only among the natives, but also"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l10" HPOS="654" VPOS="1132" WIDTH="1601" HEIGHT="54" BASELINE="656 1171 2255 1164" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 1171 656 1186 2252 1180 2255 1164 2248 1132 654 1136 656 1171"/>
                        </Shape>
                        <String CONTENT="among the conquerors, who lived under the same material conditions."/>
                    </TextLine>
<TextLine ID="mz_1-058_l11" HPOS="769" VPOS="1182" WIDTH="1659" HEIGHT="65" BASELINE="771 1229 2428 1225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="771 1229 771 1242 2424 1247 2428 1225 2426 1195 2389 1182 2387 1182 2385 1182 2328 1193 2276 1182 2274 1182 2272 1182 2246 1195 2120 1195 2105 1182 2103 1182 2101 1182 2099 1182 2097 1182 2075 1193 2053 1182 2051 1182 2049 1182 2047 1182 2021 1193 1999 1182 1997 1182 1995 1182 1993 1182 1945 1195 1741 1195 1728 1182 1726 1182 1724 1182 1722 1182 1627 1193 1575 1184 1572 1184 1570 1184 1568 1184 1555 1195 1540 1184 1538 1184 1536 1184 1533 1184 1531 1184 1503 1195 1416 1184 1414 1184 1412 1184 1386 1195 1302 1184 1300 1184 1297 1184 1269 1197 1170 1197 1157 1184 1154 1184 1152 1184 1150 1184 1148 1184 1113 1195 1076 1184 1074 1184 1072 1184 1022 1195 996 1184 994 1184 992 1184 990 1184 960 1195 769 1193 771 1229"/>
                        </Shape>
                        <String CONTENT="Worst of all, the natives lost their vital energy and their zest for life,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l12" HPOS="656" VPOS="1245" WIDTH="1774" HEIGHT="67" BASELINE="659 1292 2430 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1292 659 1305 1837 1312 1839 1312 1915 1301 2428 1301 2430 1286 2426 1255 1865 1245 1863 1245 1860 1245 1813 1255 1429 1247 1427 1247 1235 1258 700 1249 697 1249 695 1249 656 1260 659 1292"/>
                        </Shape>
                        <String CONTENT="which gave them the power and the will to struggle with the harsh Arctic"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l13" HPOS="654" VPOS="1316" WIDTH="1774" HEIGHT="52" BASELINE="656 1351 2428 1346" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 1351 656 1366 2424 1368 2428 1346 2421 1316 654 1318 656 1351"/>
                        </Shape>
                        <String CONTENT="nature. A number of them abstained from matrimony and from producing"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l14" HPOS="656" VPOS="1370" WIDTH="1772" HEIGHT="59" BASELINE="659 1413 2428 1405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1413 659 1429 2426 1422 2428 1405 2424 1374 697 1370 695 1370 693 1370 656 1381 659 1413"/>
                        </Shape>
                        <String CONTENT="offspring. They dropped a large part of their former pursuits, and patiently"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l15" HPOS="656" VPOS="1426" WIDTH="1774" HEIGHT="65" BASELINE="659 1470 2430 1463" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1470 659 1485 1837 1491 1839 1491 1841 1491 1889 1481 2428 1481 2430 1463 2426 1435 1250 1426 1248 1426 1245 1426 1243 1426 1224 1437 710 1429 708 1429 656 1439 659 1470"/>
                        </Shape>
                        <String CONTENT="submitted to regular periods of famine, considering their tribe doomed to"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l16" HPOS="656" VPOS="1489" WIDTH="1774" HEIGHT="63" BASELINE="659 1530 2430 1524" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1530 659 1545 1837 1552 1839 1552 1841 1552 1882 1541 2428 1541 2430 1524 2426 1496 678 1489 676 1489 674 1489 672 1489 656 1496 659 1530"/>
                        </Shape>
                        <String CONTENT="destruction. For instance, among the vanishing clans of the Yukaghir on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l17" HPOS="656" VPOS="1543" WIDTH="1770" HEIGHT="74" BASELINE="659 1593 2426 1584" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1593 659 1606 938 1617 940 1617 1115 1604 2424 1604 2426 1584 2421 1554 2101 1543 2099 1543 1973 1554 1568 1545 1566 1545 1564 1545 1531 1558 656 1558 659 1593"/>
                        </Shape>
                        <String CONTENT="Lower Kolyma the number of unmarried people is disproportionately large."/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l18" HPOS="661" VPOS="1604" WIDTH="1769" HEIGHT="63" BASELINE="663 1652 2430 1645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="663 1652 663 1667 2428 1660 2430 1645 2426 1615 1841 1604 1839 1604 1782 1617 661 1617 663 1652"/>
                        </Shape>
                        <String CONTENT="The hunting of reindeer and the capturing of moulting birds to a considerable"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l19" HPOS="656" VPOS="1667" WIDTH="1774" HEIGHT="65" BASELINE="659 1712 2430 1704" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1712 659 1727 1984 1732 1986 1732 2428 1719 2430 1704 2426 1675 1551 1667 1549 1667 1546 1667 1544 1667 1531 1678 1109 1669 1107 1669 1105 1669 1081 1680 676 1671 674 1671 672 1671 669 1671 656 1678 659 1712"/>
                        </Shape>
                        <String CONTENT="degree went out of practice, because they required too much exertion. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l20" HPOS="656" VPOS="1723" WIDTH="1785" HEIGHT="69" BASELINE="659 1773 2441 1766" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1773 659 1792 2439 1781 2441 1766 2439 1736 2404 1723 2402 1723 2400 1723 2398 1723 2374 1734 2287 1723 2285 1723 2209 1734 2181 1723 2179 1723 2177 1723 2174 1723 2172 1723 2157 1736 2027 1736 1999 1723 1997 1723 1995 1723 1917 1734 1869 1723 1867 1723 1865 1723 1863 1723 1860 1723 1841 1736 1806 1725 1804 1725 1802 1725 1724 1736 1648 1725 1646 1725 1644 1725 1616 1736 1170 1727 1167 1727 1165 1727 1163 1727 1148 1738 834 1727 832 1727 830 1727 827 1727 810 1738 773 1727 771 1727 769 1727 656 1740 659 1773"/>
                        </Shape>
                        <String CONTENT="people live solely by fishing, and every spring suffer from the scarcity of food,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l21" HPOS="656" VPOS="1788" WIDTH="1776" HEIGHT="56" BASELINE="659 1829 2432 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1829 659 1844 2430 1840 2432 1825 2428 1797 697 1788 695 1788 693 1788 656 1799 659 1829"/>
                        </Shape>
                        <String CONTENT="often amounting to a real famine. It must not be forgotten that also under"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l22" HPOS="654" VPOS="1840" WIDTH="1778" HEIGHT="69" BASELINE="656 1892 2432 1881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 1892 656 1909 2430 1898 2432 1881 2426 1851 2209 1851 2185 1840 2183 1840 2181 1840 2179 1840 2177 1840 2159 1851 2049 1842 2047 1842 1984 1853 1949 1842 1947 1842 1945 1842 1893 1853 1824 1842 1821 1842 1819 1842 1778 1853 1750 1842 1748 1842 1746 1842 1744 1842 1741 1842 1726 1853 1692 1844 1689 1844 1687 1844 1685 1844 1683 1844 1668 1857 1577 1857 1549 1844 1546 1844 1544 1844 1462 1855 1375 1844 1373 1844 1371 1844 1369 1844 1352 1857 1185 1846 1183 1846 1126 1857 1020 1846 1018 1846 957 1859 680 1849 678 1849 676 1849 654 1857 656 1892"/>
                        </Shape>
                        <String CONTENT="the natural condition of affairs before the arrival of the Russians, the increase"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l23" HPOS="656" VPOS="1916" WIDTH="1776" HEIGHT="49" BASELINE="659 1950 2432 1944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 1950 659 1965 2432 1959 2432 1944 2426 1916 656 1920 659 1950"/>
                        </Shape>
                        <String CONTENT="of population, even among the strongest tribes, was very uncertain, and was"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l24" HPOS="656" VPOS="1965" WIDTH="912" HEIGHT="61" BASELINE="659 2011 1568 2007" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2011 659 2026 1566 2024 1568 2007 1564 1978 1414 1965 1412 1965 1410 1965 1391 1976 1369 1965 1367 1965 1365 1965 1362 1965 1360 1965 1360 1968 1349 1978 1172 1978 1118 1965 1115 1965 1113 1965 1111 1965 1111 1968 1109 1968 1102 1976 1096 1970 1096 1968 1094 1968 1092 1968 1089 1968 1087 1968 1063 1978 942 1968 940 1968 938 1968 897 1978 754 1968 752 1968 656 1981 659 2011"/>
                        </Shape>
                        <String CONTENT="continually checked by war and famine."/>
                    </TextLine>
<TextLine ID="mz_1-058_l25" HPOS="760" VPOS="2024" WIDTH="1670" HEIGHT="63" BASELINE="762 2072 2430 2067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="762 2072 762 2087 2428 2087 2430 2067 2426 2037 1925 2024 1923 2024 1921 2024 1919 2024 1906 2037 1733 2037 1676 2024 1674 2024 1672 2024 1629 2035 1497 2026 1494 2026 1438 2037 1395 2026 1393 2026 1391 2026 1388 2026 1386 2026 1373 2037 1336 2026 1334 2026 1332 2026 1330 2026 1328 2026 1313 2039 1144 2039 1081 2026 1079 2026 1076 2026 1033 2037 931 2026 929 2026 840 2037 784 2026 782 2026 780 2026 778 2026 760 2035 762 2072"/>
                        </Shape>
                        <String CONTENT="One of the old men at Indian Point said to me, “The spirits, it seems,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l26" HPOS="654" VPOS="2085" WIDTH="1776" HEIGHT="62" BASELINE="656 2132 2430 2126" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2132 656 2147 2428 2141 2430 2126 2426 2098 1912 2085 1910 2085 1832 2098 1297 2087 1295 2087 1293 2087 1291 2087 1276 2098 923 2089 921 2089 918 2089 916 2089 897 2102 765 2102 706 2089 704 2089 702 2089 654 2102 656 2132"/>
                        </Shape>
                        <String CONTENT="take care that the people of this country shall not multiply. In olden times"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l27" HPOS="656" VPOS="2147" WIDTH="1774" HEIGHT="61" BASELINE="659 2193 2430 2186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2193 659 2208 2428 2201 2430 2186 2426 2156 1278 2147 1276 2147 1196 2158 1001 2150 999 2150 656 2160 659 2193"/>
                        </Shape>
                        <String CONTENT="war was sent down to ward off increase. After that, in spite of the abundant"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l28" HPOS="656" VPOS="2206" WIDTH="1774" HEIGHT="63" BASELINE="659 2253 2430 2247" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2253 659 2269 2428 2266 2430 2247 2426 2217 1839 2206 1837 2206 1834 2206 1793 2217 734 2210 732 2210 656 2221 659 2253"/>
                        </Shape>
                        <String CONTENT="variety of sea-game, famine would come and carry off the surplus. At present,"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l29" HPOS="656" VPOS="2266" WIDTH="1774" HEIGHT="63" BASELINE="659 2312 2430 2303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2312 659 2329 2428 2321 2430 2303 2426 2275 1544 2266 1542 2266 1540 2266 1538 2266 1523 2277 697 2271 695 2271 693 2271 656 2282 659 2312"/>
                        </Shape>
                        <String CONTENT="with the fulsome supply of American food, the disease comes down, and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l30" HPOS="656" VPOS="2327" WIDTH="620" HEIGHT="67" BASELINE="659 2372 1276 2366" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2372 659 2385 1066 2394 1068 2394 1120 2383 1254 2392 1256 2392 1258 2392 1261 2392 1276 2381 1276 2366 1269 2327 656 2342 659 2372"/>
                        </Shape>
                        <String CONTENT="result is exactly the same.”"/>
                    </TextLine>
<TextLine ID="mz_1-058_l31" HPOS="765" VPOS="2381" WIDTH="1667" HEIGHT="67" BASELINE="767 2433 2432 2422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="767 2433 767 2448 2430 2437 2432 2422 2428 2392 2179 2381 2177 2381 2094 2392 2012 2383 2010 2383 765 2396 767 2433"/>
                        </Shape>
                        <String CONTENT="BIRTH AND CHILDHOOD. — The Chukchee women are delivered with little"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l32" HPOS="654" VPOS="2446" WIDTH="1778" HEIGHT="69" BASELINE="656 2492 2432 2485" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2492 656 2505 1185 2515 1187 2515 1189 2515 1191 2515 1206 2505 1237 2515 1239 2515 1241 2515 1378 2502 1782 2513 1785 2513 1910 2500 2029 2500 2045 2511 2047 2511 2049 2511 2051 2511 2343 2500 2408 2511 2411 2511 2413 2511 2415 2511 2432 2498 2432 2485 2428 2457 2084 2446 2081 2446 654 2457 656 2492"/>
                        </Shape>
                        <String CONTENT="labor. Custom strictly forbids the woman to groan, or to give way to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l33" HPOS="656" VPOS="2502" WIDTH="1776" HEIGHT="72" BASELINE="659 2552 2432 2544" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2552 659 2574 1152 2563 1204 2574 1206 2574 1284 2563 1529 2574 1531 2574 1533 2574 1536 2574 1553 2561 1616 2572 1618 2572 1672 2561 1856 2572 1858 2572 1860 2572 1891 2561 1947 2572 1949 2572 1951 2572 1954 2572 1969 2561 2077 2570 2079 2570 2081 2570 2084 2570 2099 2559 2411 2570 2413 2570 2415 2570 2417 2570 2432 2557 2432 2544 2428 2515 2335 2502 2333 2502 2330 2502 2328 2502 2313 2515 2051 2515 2023 2502 2021 2502 2019 2502 2016 2502 1984 2515 1566 2505 1564 2505 1562 2505 1559 2505 1544 2515 1196 2507 1193 2507 1191 2507 1148 2518 1107 2507 1105 2507 1102 2507 988 2520 717 2509 715 2509 656 2522 659 2552"/>
                        </Shape>
                        <String CONTENT="pain by any audible sign. Nor may help be given by other women. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l34" HPOS="659" VPOS="2567" WIDTH="1773" HEIGHT="59" BASELINE="661 2611 2432 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 2611 661 2626 2430 2619 2432 2602 2428 2572 1200 2567 1198 2567 659 2580 661 2611"/>
                        </Shape>
                        <String CONTENT="woman who has been delivered has to attend to her own needs herself, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l35" HPOS="656" VPOS="2630" WIDTH="1778" HEIGHT="56" BASELINE="659 2671 2434 2663" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2671 659 2686 2432 2678 2434 2663 2430 2634 678 2630 676 2630 674 2630 672 2630 656 2637 659 2671"/>
                        </Shape>
                        <String CONTENT="to those of the new-born infant. She cuts the navel-string and puts away the"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l36" HPOS="659" VPOS="2682" WIDTH="1773" HEIGHT="72" BASELINE="661 2730 2432 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 2730 661 2754 2430 2738 2432 2721 2426 2682 1085 2697 693 2689 691 2689 689 2689 659 2699 661 2730"/>
                        </Shape>
                        <String CONTENT="placenta.¹ The woman who accepts help in these operations will be mocked"/>
                    </TextLine>

                    <TextLine ID="mz_1-058_l37" HPOS="656" VPOS="2743" WIDTH="1778" HEIGHT="65" BASELINE="659 2790 2434 2784" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2790 659 2808 2432 2801 2434 2784 2430 2756 2274 2743 2272 2743 2216 2754 2190 2743 2187 2743 2185 2743 2129 2754 2090 2743 2088 2743 2086 2743 1984 2754 1932 2743 1930 2743 1878 2754 1845 2743 1843 2743 1841 2743 1839 2743 1837 2743 1817 2756 1670 2745 1668 2745 1666 2745 1629 2756 1601 2745 1598 2745 1596 2745 1594 2745 1553 2756 1510 2745 1507 2745 1505 2745 1503 2745 1473 2756 1438 2745 1436 2745 1434 2745 1432 2745 1429 2745 1414 2756 1345 2745 1343 2745 1226 2758 1202 2747 1200 2747 1198 2747 1196 2747 1148 2758 797 2747 795 2747 700 2758 672 2747 669 2747 667 2747 665 2747 663 2747 663 2749 656 2754 659 2790"/>
                        </Shape>
                        <String CONTENT="her whole life long, and even her husband will occasionally receive the derisive"/>
