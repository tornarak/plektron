                <TextBlock ID="text_1-134" HPOS="680" VPOS="617" WIDTH="1780" HEIGHT="2628"><TextLine ID="mz_1-134_l1" HPOS="1261" VPOS="617" WIDTH="615" HEIGHT="54" BASELINE="1261 651 1876 651" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1867 628 1845 621 1830 617 1261 617 1261 651 1261 671 1876 671 1876 651 1876 630 1867 628"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l2" HPOS="689" VPOS="623" WIDTH="104" HEIGHT="46" BASELINE="689 653 793 653" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="786 623 691 623 689 625 689 653 689 669 793 669 793 653 793 628 786 623"/>
                        </Shape>
                        <String CONTENT="102"/>
                    </TextLine>
<TextLine ID="mz_1-134_l3" HPOS="680" VPOS="718" WIDTH="1774" HEIGHT="59" BASELINE="682 762 2454 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2434 727 2413 727 2391 727 2369 725 2348 725 2326 725 2304 725 2298 723 693 718 691 718 689 718 687 718 687 721 680 725 682 762 682 777 2452 773 2454 755 2450 727 2434 727"/>
                        </Shape>
                        <String CONTENT="fox”), etc.; though other names have a different origin, for instance, keiˊñɪn"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l4" HPOS="682" VPOS="773" WIDTH="1772" HEIGHT="67" BASELINE="685 822 2454 816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 822 685 840 2452 833 2454 816 2450 786 2099 786 2032 773 2029 773 1954 783 1876 773 1873 773 1871 773 1869 773 1854 786 1754 775 1752 775 1750 775 1748 775 1733 786 1689 775 1687 775 1685 775 1518 786 1503 775 1501 775 1499 775 1406 775 1403 775 1401 775 1399 775 1382 786 1354 775 1352 775 1349 775 1271 788 1213 777 1211 777 1159 788 947 777 944 777 875 788 860 777 858 777 856 777 702 777 700 777 697 777 695 777 682 786 685 822"/>
                        </Shape>
                        <String CONTENT="(“bear”), veˊʟ̣ᴇ (“raven”), neneˊn (“infant”), titiˊñɪ (“needle”). Other names cannot"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l5" HPOS="682" VPOS="842" WIDTH="1772" HEIGHT="65" BASELINE="685 879 2454 883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 879 682 894 697 905 700 905 702 905 704 905 1332 896 1577 907 1579 907 2452 896 2454 883 2452 851 685 842 685 879"/>
                        </Shape>
                        <String CONTENT="be translated; for instance, pappaˊlhɪn, which is given only to black dogs,"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l6" HPOS="685" VPOS="896" WIDTH="281" HEIGHT="61" BASELINE="685 939 966 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 939 685 957 966 957 966 939 966 909 821 896 819 896 817 896 782 907 765 896 762 896 760 896 758 896 685 907 685 939"/>
                        </Shape>
                        <String CONTENT="and eliˊhɪkɪ."/>
                    </TextLine>
<TextLine ID="mz_1-134_l7" HPOS="791" VPOS="965" WIDTH="1667" HEIGHT="52" BASELINE="791 998 2458 998" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="791 998 791 1017 2456 1017 2458 998 2456 967 791 965 791 998"/>
                        </Shape>
                        <String CONTENT="Dogs of the southern and western districts are considered the swiftest and"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l8" HPOS="680" VPOS="1026" WIDTH="1770" HEIGHT="56" BASELINE="682 1058 2450 1063" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1058 680 1071 695 1082 697 1082 700 1082 702 1082 2447 1073 2450 1063 2447 1030 682 1026 682 1058"/>
                        </Shape>
                        <String CONTENT="the most enduring. Among the Russianized natives the large and shaggy"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l9" HPOS="680" VPOS="1084" WIDTH="1772" HEIGHT="59" BASELINE="682 1117 2452 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1117 680 1132 695 1143 697 1143 700 1143 702 1143 2450 1138 2452 1121 2450 1089 682 1084 682 1117"/>
                        </Shape>
                        <String CONTENT="dogs of the Indighirka River are especially valued; among the Kamchadal,"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l10" HPOS="685" VPOS="1149" WIDTH="1771" HEIGHT="46" BASELINE="685 1180 2456 1180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1180 685 1195 2456 1195 2456 1180 2456 1149 685 1149 685 1180"/>
                        </Shape>
                        <String CONTENT="those of the southwestern villages Yavina and Golyghina; and among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l11" HPOS="680" VPOS="1195" WIDTH="1776" HEIGHT="67" BASELINE="682 1236 2456 1240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1236 680 1253 691 1262 693 1262 695 1262 697 1262 2454 1253 2456 1240 2454 1210 2265 1210 2233 1197 2231 1197 2045 1197 2042 1197 2040 1197 2038 1197 2023 1210 1793 1210 1756 1197 1754 1197 1752 1197 1696 1208 1644 1197 1642 1197 1640 1197 1637 1197 1624 1208 1557 1195 1555 1195 1501 1206 1449 1195 1447 1195 1384 1206 1332 1195 1330 1195 1252 1206 1224 1195 1222 1195 1219 1195 1217 1195 1176 1206 1133 1195 1131 1195 1128 1195 1126 1195 1098 1206 1085 1195 1083 1195 1081 1195 1079 1195 1076 1195 1040 1206 923 1195 921 1195 918 1195 888 1206 838 1195 836 1195 834 1195 804 1206 682 1203 682 1236"/>
                        </Shape>
                        <String CONTENT="Koryak, those of the Poqaˊč. The Chukchee dogs are considered the poorest"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l12" HPOS="685" VPOS="1268" WIDTH="1771" HEIGHT="48" BASELINE="685 1299 2456 1299" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1299 685 1316 2456 1316 2456 1299 2456 1268 685 1268 685 1299"/>
                        </Shape>
                        <String CONTENT="of all, probably on account of their more scanty diet. Therefore the trade in"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l13" HPOS="680" VPOS="1327" WIDTH="1776" HEIGHT="50" BASELINE="682 1361 2456 1357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1361 682 1377 2454 1372 2456 1357 2452 1327 680 1327 682 1361"/>
                        </Shape>
                        <String CONTENT="live dogs between the Russian settlements in Anadyr and the Chukchee villages"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l14" HPOS="680" VPOS="1377" WIDTH="1776" HEIGHT="58" BASELINE="682 1420 2456 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1420 682 1435 2454 1431 2456 1416 2452 1387 1614 1377 1611 1377 1609 1377 1564 1387 780 1379 778 1379 680 1390 682 1420"/>
                        </Shape>
                        <String CONTENT="on the Pacific shore is of importance. A good dog can be bought with four"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l15" HPOS="682" VPOS="1444" WIDTH="1772" HEIGHT="52" BASELINE="685 1476 2454 1481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1476 682 1491 2450 1496 2454 1481 2452 1448 685 1444 685 1476"/>
                        </Shape>
                        <String CONTENT="or five white fox-skins, or two dogs with an American shotgun with accessories, etc."/>
                    </TextLine>
<TextLine ID="mz_1-134_l16" HPOS="791" VPOS="1500" WIDTH="1663" HEIGHT="56" BASELINE="793 1537 2454 1541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="793 1537 791 1550 2450 1556 2454 1541 2452 1509 793 1500 793 1537"/>
                        </Shape>
                        <String CONTENT="Kamchadal, Koryak, and Russian dogs are fed exclusively on fish, — raw,"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l17" HPOS="682" VPOS="1552" WIDTH="1768" HEIGHT="67" BASELINE="685 1595 2450 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1595 682 1610 695 1619 697 1619 700 1619 702 1619 2447 1615 2450 1604 2450 1569 2432 1558 2430 1558 2428 1558 2426 1558 2424 1558 2387 1569 2049 1558 2047 1558 2045 1558 2016 1569 1977 1556 1975 1556 1973 1556 1904 1567 1880 1556 1878 1556 1876 1556 1873 1556 1839 1567 1802 1556 1800 1556 1798 1556 1795 1556 1763 1567 1488 1567 1455 1554 1453 1554 1451 1554 1449 1554 1419 1567 1280 1567 1256 1554 1254 1554 1252 1554 986 1563 953 1552 951 1552 949 1552 947 1552 918 1565 817 1565 801 1552 799 1552 797 1552 795 1552 685 1561 685 1595"/>
                        </Shape>
                        <String CONTENT="dried, or frozen, according to the season or the locality (Plate VI, Fig. 3)."/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l18" HPOS="687" VPOS="1619" WIDTH="1769" HEIGHT="56" BASELINE="687 1658 2456 1658" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="687 1658 687 1675 2456 1675 2456 1658 2454 1619 687 1619 687 1658"/>
                        </Shape>
                        <String CONTENT="The Kolyma Russians often cook for their dogs a kind of porridge made of"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l19" HPOS="685" VPOS="1684" WIDTH="1767" HEIGHT="56" BASELINE="685 1717 2452 1721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1717 685 1740 2450 1740 2452 1721 2450 1688 685 1684 685 1717"/>
                        </Shape>
                        <String CONTENT="putrid fish, roe, fish-bones, refuse of human food, etc., and serve it in long"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l20" HPOS="682" VPOS="1742" WIDTH="1772" HEIGHT="61" BASELINE="685 1773 2454 1777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 1773 682 1788 832 1801 834 1801 1527 1792 1607 1803 1609 1803 2452 1792 2454 1777 2452 1747 685 1742 685 1773"/>
                        </Shape>
                        <String CONTENT="wooden trays; but this kind of food is convenient only at times of rest, since"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l21" HPOS="680" VPOS="1792" WIDTH="1774" HEIGHT="63" BASELINE="682 1838 2454 1833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1838 682 1855 2452 1851 2454 1833 2447 1801 2198 1803 2181 1792 2179 1792 2177 1792 2174 1792 2086 1803 2071 1792 2068 1792 2066 1792 2064 1792 2062 1792 2038 1803 2021 1792 2019 1792 2016 1792 2014 1792 2012 1792 1984 1803 1938 1792 1936 1792 1934 1792 1878 1803 1819 1792 1817 1792 1763 1803 1741 1792 1739 1792 1737 1792 1735 1792 1692 1803 1596 1792 1594 1792 1592 1792 1590 1792 1575 1803 1464 1794 1462 1794 1460 1794 1458 1794 1442 1807 1258 1807 1193 1794 1191 1794 1137 1805 916 1794 914 1794 838 1805 799 1794 797 1794 795 1794 793 1794 756 1805 706 1794 704 1794 702 1794 700 1794 680 1803 682 1838"/>
                        </Shape>
                        <String CONTENT="the dogs feel heavy with too much liquid food. The Chukchee dogs are fed"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l22" HPOS="680" VPOS="1864" WIDTH="1776" HEIGHT="50" BASELINE="682 1894 2456 1898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1894 680 1909 2452 1914 2456 1898 2454 1868 682 1864 682 1894"/>
                        </Shape>
                        <String CONTENT="on the intestines of seals, and on seal, walrus, and whale blubber. Their share"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l23" HPOS="680" VPOS="1916" WIDTH="1776" HEIGHT="60" BASELINE="682 1959 2456 1955" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 1959 682 1976 2454 1972 2456 1955 2452 1927 1568 1916 1566 1916 1505 1927 717 1918 715 1918 713 1918 680 1929 682 1959"/>
                        </Shape>
                        <String CONTENT="of meat is small, and consists only of kitchen refuse, since their masters want"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l24" HPOS="680" VPOS="1974" WIDTH="1774" HEIGHT="67" BASELINE="682 2020 2454 2013" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2020 682 2035 1860 2041 1863 2041 2452 2028 2454 2013 2450 1985 1863 1974 1860 1974 1858 1974 1834 1985 1274 1976 1271 1976 1269 1976 1241 1987 708 1978 706 1978 704 1978 680 1987 682 2020"/>
                        </Shape>
                        <String CONTENT="all the meat proper for themselves. However, exclusive blubber diet is insuf-"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l25" HPOS="680" VPOS="2033" WIDTH="1776" HEIGHT="62" BASELINE="682 2080 2456 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2080 682 2095 2454 2089 2456 2074 2454 2046 2419 2033 2417 2033 2415 2033 2413 2033 2367 2043 2239 2033 2237 2033 2235 2033 2216 2043 2200 2033 2198 2033 2196 2033 2194 2033 2192 2033 2190 2033 2174 2046 2053 2046 2001 2033 1999 2033 1897 2043 1876 2033 1873 2033 1871 2033 1869 2033 1867 2033 1854 2046 1834 2035 1832 2035 1830 2035 1828 2035 1806 2046 1780 2035 1778 2035 1776 2035 1609 2046 1579 2035 1577 2035 1575 2035 1512 2046 1455 2035 1453 2035 1451 2035 1449 2035 1432 2048 1265 2048 1202 2037 1200 2037 1033 2048 940 2037 938 2037 936 2037 910 2048 847 2037 845 2037 843 2037 840 2037 830 2048 817 2037 814 2037 812 2037 693 2037 691 2037 689 2037 687 2037 687 2039 680 2043 682 2080"/>
                        </Shape>
                        <String CONTENT="ficient for dogs. In the summer-time, in the Chukchee villages of the Pacific"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l26" HPOS="680" VPOS="2098" WIDTH="1774" HEIGHT="58" BASELINE="682 2139 2454 2134" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2139 682 2156 2452 2152 2454 2134 2450 2106 791 2098 788 2098 680 2108 682 2139"/>
                        </Shape>
                        <String CONTENT="coast, I saw large pieces of blubber strewn all over the ground; and the dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l27" HPOS="680" VPOS="2154" WIDTH="1774" HEIGHT="67" BASELINE="682 2201 2454 2195" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2201 682 2221 2452 2219 2454 2195 2450 2167 2270 2154 2268 2154 2265 2154 2263 2154 2246 2167 2144 2167 2118 2154 2116 2154 2114 2154 1999 2165 1941 2154 1938 2154 1886 2165 1865 2154 1863 2154 1860 2154 1787 2167 1640 2156 1637 2156 1635 2156 1633 2156 1616 2169 1295 2169 1276 2156 1274 2156 1271 2156 1269 2156 1200 2169 767 2158 765 2158 680 2171 682 2201"/>
                        </Shape>
                        <String CONTENT="prowling among them did not appear to be overfed. The natives said, that,"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l28" HPOS="685" VPOS="2227" WIDTH="1771" HEIGHT="48" BASELINE="685 2258 2456 2258" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2258 685 2275 2456 2275 2456 2258 2456 2227 685 2227 685 2258"/>
                        </Shape>
                        <String CONTENT="whenever the dogs were satiated, they would desist from eating blubber for"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l29" HPOS="682" VPOS="2273" WIDTH="1772" HEIGHT="63" BASELINE="685 2321 2454 2314" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2321 685 2336 2452 2329 2454 2314 2450 2286 2363 2273 2361 2273 2309 2284 1958 2273 1956 2273 1858 2286 1590 2275 1588 2275 1585 2275 1555 2286 1503 2275 1501 2275 1499 2275 1464 2286 1427 2275 1425 2275 1423 2275 1421 2275 1419 2275 1401 2286 1291 2277 1289 2277 1213 2288 1148 2277 1146 2277 962 2288 873 2277 871 2277 869 2277 845 2288 741 2277 739 2277 736 2277 682 2290 685 2321"/>
                        </Shape>
                        <String CONTENT="a long time. On the contrary, in the fishing villages of the Koryak or Kam-"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l30" HPOS="682" VPOS="2342" WIDTH="1774" HEIGHT="59" BASELINE="685 2372 2456 2379" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2372 682 2392 695 2401 697 2401 700 2401 702 2401 2454 2394 2456 2379 2454 2349 685 2342 685 2372"/>
                        </Shape>
                        <String CONTENT="chadal, at the same season, when food is scattered on the ground, the dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l31" HPOS="682" VPOS="2394" WIDTH="916" HEIGHT="67" BASELINE="685 2437 1598 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2437 685 2457 1172 2461 1174 2461 1176 2461 1178 2461 1178 2459 1189 2450 1300 2450 1434 2461 1436 2461 1438 2461 1466 2450 1572 2461 1575 2461 1577 2461 1579 2461 1598 2448 1598 2433 1592 2394 682 2407 685 2437"/>
                        </Shape>
                        <String CONTENT="grow so fat that they can hardly walk.¹"/>
                    </TextLine>
<TextLine ID="mz_1-134_l32" HPOS="791" VPOS="2459" WIDTH="1665" HEIGHT="54" BASELINE="793 2492 2456 2498" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="793 2492 791 2507 2452 2513 2456 2498 2454 2468 793 2459 793 2492"/>
                        </Shape>
                        <String CONTENT="The continuous fluctuations of success in seal-hunting, and the frequent"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l33" HPOS="682" VPOS="2528" WIDTH="1772" HEIGHT="50" BASELINE="682 2557 2454 2557" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2557 682 2574 2452 2578 2454 2557 2454 2528 682 2528 682 2557"/>
                        </Shape>
                        <String CONTENT="seasons of famine, have a deteriorating effect upon the Chukchee race of dogs;"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l34" HPOS="682" VPOS="2583" WIDTH="1774" HEIGHT="51" BASELINE="682 2615 2456 2615" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2615 682 2634 2456 2634 2456 2615 2456 2587 682 2583 682 2615"/>
                        </Shape>
                        <String CONTENT="but fishing among the more southern tribes is much more regular. Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l35" HPOS="682" VPOS="2643" WIDTH="1774" HEIGHT="50" BASELINE="685 2673 2456 2678" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2673 682 2689 2452 2693 2456 2678 2454 2647 685 2643 685 2673"/>
                        </Shape>
                        <String CONTENT="dogs need something to season their blubber, and are generally inclined to"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l36" HPOS="680" VPOS="2699" WIDTH="1780" HEIGHT="65" BASELINE="682 2734 2460 2738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="682 2734 680 2747 812 2762 814 2762 817 2762 858 2751 1102 2762 1105 2762 1326 2751 1414 2762 1416 2762 1419 2762 1447 2751 1572 2764 1575 2764 1655 2754 1720 2764 1722 2764 1724 2764 1767 2754 1902 2764 1904 2764 2458 2751 2460 2738 2458 2699 682 2702 682 2734"/>
                        </Shape>
                        <String CONTENT="eat up all the dry thongs they can get; they even gnaw at the lashings of"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l37" HPOS="685" VPOS="2769" WIDTH="1771" HEIGHT="45" BASELINE="685 2797 2456 2797" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2797 685 2814 2456 2814 2456 2797 2456 2769 685 2769 685 2797"/>
                        </Shape>
                        <String CONTENT="sledges, and destroy their own harness and traces, much more than do the"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l38" HPOS="685" VPOS="2827" WIDTH="1773" HEIGHT="48" BASELINE="685 2855 2458 2855" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2855 685 2875 2458 2875 2458 2855 2458 2827 685 2827 685 2855"/>
                        </Shape>
                        <String CONTENT="southern fish-fed dogs. On the contrary, the Russian fish-fed dogs thrive best"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l39" HPOS="682" VPOS="2879" WIDTH="1774" HEIGHT="61" BASELINE="685 2909 2456 2916" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="685 2909 682 2925 730 2938 732 2938 734 2938 1187 2929 1293 2940 1295 2940 2454 2931 2456 2916 2454 2881 685 2879 685 2909"/>
                        </Shape>
                        <String CONTENT="when they are given blubber mixed with their dried fish. The dogs are fed"/>
                    </TextLine>

                    <TextLine ID="mz_1-134_l40" HPOS="685" VPOS="2946" WIDTH="1771" HEIGHT="48" BASELINE="685 2974 2456 2974" TAGREFS="TYPE_5">
                        <Shape>
