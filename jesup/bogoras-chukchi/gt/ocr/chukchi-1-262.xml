                <TextBlock ID="text_1-262" HPOS="710" VPOS="539" WIDTH="1781" HEIGHT="2626"><TextLine ID="mz_1-262_l1" HPOS="1295" VPOS="539" WIDTH="615" HEIGHT="54" BASELINE="1297 569 1910 576" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1904 539 1705 539 1687 539 1666 539 1644 539 1622 539 1601 539 1579 539 1557 539 1536 539 1514 539 1492 539 1471 539 1449 539 1427 539 1406 539 1384 539 1362 539 1341 539 1319 539 1297 539 1297 569 1295 586 1906 593 1910 576 1908 547 1904 539"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l2" HPOS="717" VPOS="543" WIDTH="108" HEIGHT="56" BASELINE="719 578 825 573" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 550 719 578 719 589 769 599 771 599 825 586 825 573 806 543 719 545 717 550"/>
                        </Shape>
                        <String CONTENT="206"/>
                    </TextLine>
<TextLine ID="mz_1-262_l3" HPOS="710" VPOS="640" WIDTH="1778" HEIGHT="61" BASELINE="710 684 2488 684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2465 649 2443 649 2421 649 2400 647 2395 647 2385 651 2359 647 2356 647 2335 645 2313 645 2291 645 2278 645 2220 651 2153 640 2151 640 1834 651 1782 640 1780 640 1778 640 1746 651 1722 640 1720 640 1577 640 1575 640 1572 640 1570 640 1555 653 1423 653 1352 640 1349 640 1243 651 1139 640 1137 640 1079 651 1014 640 1012 640 788 651 736 640 734 640 732 640 710 651 710 684 710 701 2488 701 2488 684 2488 653 2465 649 2465 649"/>
                        </Shape>
                        <String CONTENT="the consumption of the mushrooms. Usually the person remains awake; but"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l4" HPOS="710" VPOS="708" WIDTH="1776" HEIGHT="52" BASELINE="713 740 2486 744" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 740 710 755 2482 760 2486 744 2484 712 713 708 713 740"/>
                        </Shape>
                        <String CONTENT="the natives say that if a person falls asleep immediately after eating mushrooms,"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l5" HPOS="710" VPOS="760" WIDTH="1778" HEIGHT="58" BASELINE="713 805 2488 801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 805 713 818 2486 814 2488 801 2484 773 2294 773 2268 760 2265 760 2263 760 2168 770 2116 760 2114 760 2053 770 2006 760 2003 760 2001 760 1951 770 1899 760 1897 760 1895 760 1860 770 1769 760 1767 760 1765 760 1763 760 1748 773 1657 773 1614 760 1611 760 1609 760 1607 760 1605 760 1594 770 1564 762 1562 762 1559 762 1497 773 1432 762 1429 762 947 773 877 762 875 762 823 773 730 762 728 762 726 762 723 762 710 770 713 805"/>
                        </Shape>
                        <String CONTENT="they will work more effectively, and in a short time he will awaken more"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l6" HPOS="713" VPOS="820" WIDTH="1775" HEIGHT="59" BASELINE="713 863 2488 863" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 863 713 879 2488 879 2488 863 2488 833 2437 820 2434 820 2432 820 2402 831 2356 820 2354 820 2352 820 2350 820 2317 833 2064 833 2019 820 2016 820 2014 820 1932 831 1904 820 1902 820 1899 820 1847 831 1815 820 1813 820 1811 820 1808 820 1772 831 1737 820 1735 820 1733 820 1731 820 1689 831 1633 820 1631 820 1629 820 1603 831 1520 820 1518 820 1516 820 1514 820 1497 833 1356 833 1265 820 1263 820 1261 820 1258 820 1243 831 1159 820 1157 820 1089 831 1055 820 1053 820 1050 820 960 831 890 820 888 820 771 831 741 820 739 820 736 820 734 820 713 831 713 863"/>
                        </Shape>
                        <String CONTENT="thoroughly under their influence. The intoxication has three stages. In the"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l7" HPOS="713" VPOS="879" WIDTH="1771" HEIGHT="60" BASELINE="715 922 2484 920" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 922 715 939 2482 937 2484 920 2480 892 2404 879 2402 879 2400 879 2369 889 2348 879 2346 879 2343 879 2341 879 2304 889 2248 879 2246 879 2183 892 1947 892 1917 879 1915 879 1912 879 1910 879 1873 889 1815 879 1813 879 1735 889 1663 879 1661 879 1609 889 1514 879 1512 879 1432 889 1386 879 1384 879 1382 879 1297 889 1237 879 1235 879 1232 879 1187 889 1098 879 1096 879 1094 879 1092 879 1076 892 901 892 845 879 843 879 840 879 806 889 732 879 730 879 728 879 726 879 713 887 715 922"/>
                        </Shape>
                        <String CONTENT="first the person feels pleasantly excited. His agility increases, and he displays"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l8" HPOS="715" VPOS="939" WIDTH="1773" HEIGHT="61" BASELINE="715 983 2488 983" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 983 715 1000 2488 1000 2488 983 2488 952 2428 939 2426 939 2424 939 2400 950 2339 939 2337 939 2335 939 2311 950 2274 939 2272 939 2270 939 2103 950 2027 939 2025 939 2023 939 1997 952 1854 952 1819 939 1817 939 1815 939 1756 950 1726 939 1724 939 1722 939 1720 939 1718 939 1702 950 1611 939 1609 939 1546 950 1490 939 1488 939 1486 939 1484 939 1464 952 1306 952 1261 939 1258 939 1256 939 1254 939 1222 950 1198 939 1196 939 1193 939 1042 950 1025 939 1022 939 1020 939 879 939 877 939 875 939 851 952 715 952 715 983"/>
                        </Shape>
                        <String CONTENT="more physical strength than normally. Reindeer-hunters of the Middle Anadyr"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l9" HPOS="713" VPOS="1011" WIDTH="1775" HEIGHT="47" BASELINE="713 1041 2488 1041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1041 713 1058 2488 1058 2488 1041 2488 1011 713 1011 713 1041"/>
                        </Shape>
                        <String CONTENT="told me that before starting in canoes in pursuit of animals, they would chew"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l10" HPOS="713" VPOS="1071" WIDTH="1775" HEIGHT="48" BASELINE="713 1102 2488 1102" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1102 713 1119 2488 1119 2488 1102 2488 1071 713 1071 713 1102"/>
                        </Shape>
                        <String CONTENT="agaric because that made them more nimble on the hunt. A native fellow-"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l11" HPOS="710" VPOS="1128" WIDTH="1778" HEIGHT="58" BASELINE="713 1158 2488 1162" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1158 710 1173 726 1184 728 1184 730 1184 732 1184 1458 1175 1603 1186 1605 1186 2486 1175 2488 1162 2486 1128 713 1128 713 1158"/>
                        </Shape>
                        <String CONTENT="traveller of mine, after taking agaric, would lay aside his snow-shoes and"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l12" HPOS="710" VPOS="1186" WIDTH="1778" HEIGHT="59" BASELINE="713 1219 2488 1223" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1219 710 1232 732 1245 734 1245 736 1245 2486 1236 2488 1223 2486 1190 713 1186 713 1219"/>
                        </Shape>
                        <String CONTENT="walk through the deep snow hour after hour by the side of his dogs for the"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l13" HPOS="710" VPOS="1240" WIDTH="1778" HEIGHT="67" BASELINE="713 1284 2488 1279" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1284 713 1296 1328 1307 1330 1307 1332 1307 1334 1307 1349 1296 1919 1305 1921 1305 1923 1305 1925 1305 1943 1294 2161 1305 2164 1305 2166 1305 2207 1294 2220 1305 2222 1305 2224 1305 2226 1307 2469 1307 2469 1305 2471 1305 2473 1305 2488 1292 2488 1279 2484 1249 884 1240 882 1240 710 1251 713 1284"/>
                        </Shape>
                        <String CONTENT="mere pleasure of exercise, and without any feeling of fatigue. During this"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l14" HPOS="715" VPOS="1307" WIDTH="1773" HEIGHT="59" BASELINE="715 1342 2488 1342" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1342 715 1366 2488 1355 2488 1342 2486 1307 715 1309 715 1342"/>
                        </Shape>
                        <String CONTENT="period the agaric-eater sings and dances. He frequently bursts into loud"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l15" HPOS="713" VPOS="1364" WIDTH="1778" HEIGHT="60" BASELINE="713 1403 2491 1403" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1403 713 1424 2491 1416 2491 1403 2488 1364 713 1370 713 1403"/>
                        </Shape>
                        <String CONTENT="peals of laughter without any apparent reason. It is a state altogether of"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l16" HPOS="715" VPOS="1431" WIDTH="1773" HEIGHT="47" BASELINE="715 1461 2488 1461" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1461 715 1478 2488 1478 2488 1461 2488 1431 715 1431 715 1461"/>
                        </Shape>
                        <String CONTENT="noisy joviality. His face acquires a darker hue and twitches nervously; his"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l17" HPOS="713" VPOS="1485" WIDTH="1773" HEIGHT="52" BASELINE="715 1515 2486 1519" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1515 713 1532 2482 1537 2486 1519 2484 1489 715 1485 715 1515"/>
                        </Shape>
                        <String CONTENT="eyes are now contracted, and again almost bursting from their sockets; his"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l18" HPOS="715" VPOS="1552" WIDTH="1295" HEIGHT="45" BASELINE="715 1580 2010 1580" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1580 715 1597 2010 1597 2010 1580 2010 1552 715 1552 715 1580"/>
                        </Shape>
                        <String CONTENT="mouth puckers and grins or spreads into a broad smile."/>
                    </TextLine>
<TextLine ID="mz_1-262_l19" HPOS="814" VPOS="1604" WIDTH="1677" HEIGHT="63" BASELINE="817 1636 2491 1641" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="817 1636 814 1652 830 1662 832 1662 834 1662 979 1665 981 1665 983 1665 986 1665 999 1654 1033 1665 1035 1665 1038 1665 1040 1665 1076 1654 1189 1654 1209 1665 1211 1665 1213 1665 1215 1665 1653 1654 1681 1667 1683 1667 1685 1667 1815 1656 1917 1667 1919 1667 1984 1656 2114 1667 2116 1667 2118 1667 2155 1656 2488 1656 2491 1641 2491 1610 817 1604 817 1636"/>
                        </Shape>
                        <String CONTENT="Flashes of the second stage often appear early, shortly after the first"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l20" HPOS="713" VPOS="1656" WIDTH="1773" HEIGHT="63" BASELINE="715 1701 2486 1697" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1701 715 1719 2484 1719 2486 1697 2484 1669 2450 1656 2447 1656 2445 1656 2443 1656 2419 1667 2276 1656 2274 1656 2272 1656 2270 1656 2255 1669 1943 1669 1897 1656 1895 1656 1893 1656 1891 1656 1867 1667 1826 1656 1824 1656 1821 1656 1819 1656 1774 1667 1748 1656 1746 1656 1744 1656 1741 1656 1707 1667 1620 1656 1618 1656 1616 1656 1614 1656 1594 1669 1549 1658 1546 1658 1544 1658 1178 1669 1159 1658 1157 1658 1154 1658 912 1658 910 1658 908 1658 882 1669 732 1660 730 1660 728 1660 726 1660 713 1667 715 1701"/>
                        </Shape>
                        <String CONTENT="traces of intoxication become visible; indeed, all three stages are frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l21" HPOS="715" VPOS="1727" WIDTH="1771" HEIGHT="50" BASELINE="715 1760 2486 1760" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 1760 715 1777 2486 1777 2486 1760 2486 1729 715 1727 715 1760"/>
                        </Shape>
                        <String CONTENT="intermingled. This is noticeable especially among elderly inveterate agaric-"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l22" HPOS="717" VPOS="1790" WIDTH="1771" HEIGHT="48" BASELINE="717 1820 2488 1820" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 1820 717 1838 2488 1838 2488 1820 2488 1790 717 1790 717 1820"/>
                        </Shape>
                        <String CONTENT="eaters. During the second stage the intoxicated person hears strange voices"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l23" HPOS="715" VPOS="1840" WIDTH="1776" HEIGHT="58" BASELINE="717 1881 2491 1877" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 1881 717 1898 2488 1894 2491 1877 2484 1840 715 1844 717 1881"/>
                        </Shape>
                        <String CONTENT="bidding him perform more or less incongruous actions; he sees the spirits of"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l24" HPOS="717" VPOS="1909" WIDTH="1769" HEIGHT="52" BASELINE="717 1939 2486 1939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 1939 717 1955 2484 1961 2486 1939 2486 1909 717 1909 717 1939"/>
                        </Shape>
                        <String CONTENT="fly-agaric and talks to them. He still recognizes surrounding objects, however,"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l25" HPOS="713" VPOS="1959" WIDTH="1775" HEIGHT="56" BASELINE="715 2000 2488 1996" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 2000 715 2015 2486 2011 2488 1996 2484 1965 782 1959 780 1959 713 1970 715 2000"/>
                        </Shape>
                        <String CONTENT="and when talked to is able to answer. All things appear to him increased"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l26" HPOS="715" VPOS="2022" WIDTH="1773" HEIGHT="56" BASELINE="717 2059 2488 2063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2059 715 2072 2484 2078 2488 2063 2486 2030 717 2022 717 2059"/>
                        </Shape>
                        <String CONTENT="in size. For instance, when entering a room and stepping over the door-sill,"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l27" HPOS="717" VPOS="2085" WIDTH="1774" HEIGHT="52" BASELINE="717 2119 2491 2119" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2119 717 2137 2491 2137 2491 2119 2491 2089 717 2085 717 2119"/>
                        </Shape>
                        <String CONTENT="he will raise his feet exceedingly high. The handle of a knife seems to him"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l28" HPOS="715" VPOS="2145" WIDTH="1165" HEIGHT="61" BASELINE="717 2178 1880 2182" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2178 715 2193 728 2204 730 2204 732 2204 734 2204 736 2204 773 2193 808 2204 810 2204 812 2204 877 2193 938 2204 940 2204 942 2204 983 2193 1274 2193 1293 2206 1295 2206 1297 2206 1300 2206 1878 2193 1880 2182 1878 2150 717 2145 717 2178"/>
                        </Shape>
                        <String CONTENT="so big that he wants to grasp it with both hands."/>
                    </TextLine>
<TextLine ID="mz_1-262_l29" HPOS="823" VPOS="2195" WIDTH="1668" HEIGHT="67" BASELINE="825 2236 2491 2240" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="825 2236 823 2249 905 2262 908 2262 2488 2253 2491 2240 2488 2201 899 2206 825 2195 825 2236"/>
                        </Shape>
                        <String CONTENT="The spirits of fly-agaric have an outward appearance similar to that of"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l30" HPOS="715" VPOS="2266" WIDTH="1773" HEIGHT="57" BASELINE="717 2297 2488 2301" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2297 715 2310 745 2323 747 2323 749 2323 2486 2314 2488 2301 2488 2271 717 2266 717 2297"/>
                        </Shape>
                        <String CONTENT="the actual mushrooms, and the agaric-eater feels impelled to imitate them."/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l31" HPOS="717" VPOS="2323" WIDTH="1774" HEIGHT="54" BASELINE="717 2360 2491 2360" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2360 717 2377 2491 2377 2491 2360 2491 2329 717 2323 717 2360"/>
                        </Shape>
                        <String CONTENT="For example, I saw one man suddenly snatch a small narrow bag and pull"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l32" HPOS="715" VPOS="2381" WIDTH="1773" HEIGHT="63" BASELINE="717 2416 2488 2420" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2416 715 2429 791 2442 793 2442 1551 2433 1605 2444 1607 2444 2486 2433 2488 2420 2488 2388 717 2381 717 2416"/>
                        </Shape>
                        <String CONTENT="it with all his might over his head, trying to break through the bottom. He"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l33" HPOS="717" VPOS="2448" WIDTH="1774" HEIGHT="50" BASELINE="717 2479 2491 2479" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2479 717 2498 2491 2498 2491 2479 2491 2448 717 2448 717 2479"/>
                        </Shape>
                        <String CONTENT="was evidently imitating the mushroom bursting forth from the ground. Another"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l34" HPOS="717" VPOS="2509" WIDTH="1774" HEIGHT="45" BASELINE="717 2539 2491 2539" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2482 2509 717 2509 717 2539 717 2554 2491 2554 2491 2539 2491 2531 2482 2509"/>
                        </Shape>
                        <String CONTENT="walked around with his neck drawn in, and assured every one that he had"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l35" HPOS="717" VPOS="2557" WIDTH="1774" HEIGHT="58" BASELINE="717 2600 2491 2600" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2600 717 2615 2491 2615 2491 2600 2491 2567 2458 2557 2456 2557 2454 2557 2402 2567 2337 2557 2335 2557 2333 2557 2302 2567 2270 2557 2268 2557 2265 2557 2263 2557 2233 2567 2071 2557 2068 2557 2066 2557 2064 2557 2047 2570 1733 2570 1702 2557 1700 2557 1698 2557 1536 2567 1481 2557 1479 2557 1477 2557 1445 2567 1386 2557 1384 2557 1382 2557 1380 2557 1369 2567 1356 2557 1354 2557 1352 2557 1248 2557 1245 2557 1243 2557 1241 2557 1228 2567 1172 2557 1170 2557 1053 2567 981 2557 979 2557 977 2557 938 2567 925 2557 923 2557 921 2557 817 2557 814 2557 717 2567 717 2600"/>
                        </Shape>
                        <String CONTENT="no head. He would bend his knees and move very quickly, swinging his"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l36" HPOS="715" VPOS="2617" WIDTH="1773" HEIGHT="59" BASELINE="715 2660 2488 2660" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 2660 715 2676 2488 2676 2488 2660 2488 2630 2437 2617 2434 2617 2432 2617 2391 2628 2328 2617 2326 2617 2324 2617 2296 2628 2183 2617 2181 2617 1722 2628 1700 2617 1698 2617 1562 2617 1559 2617 1557 2617 1536 2628 1503 2617 1501 2617 1499 2617 1497 2617 1494 2617 1477 2630 1371 2630 1271 2617 1269 2617 1204 2628 1105 2617 1102 2617 1050 2628 888 2617 886 2617 884 2617 860 2630 715 2630 715 2660"/>
                        </Shape>
                        <String CONTENT="arms violently about. This was in imitation of the spirits of fly-agaric, who"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l37" HPOS="715" VPOS="2678" WIDTH="1773" HEIGHT="58" BASELINE="715 2721 2488 2721" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="715 2721 715 2736 2488 2734 2488 2721 2488 2689 2462 2678 2460 2678 2458 2678 2354 2689 2287 2678 2285 2678 1804 2689 1728 2678 1726 2678 1724 2678 1681 2689 1594 2678 1592 2678 1590 2678 1588 2678 1572 2691 1481 2691 1434 2678 1432 2678 1429 2678 1239 2689 1133 2678 1131 2678 1042 2689 1009 2678 1007 2678 1005 2678 715 2689 715 2721"/>
                        </Shape>
                        <String CONTENT="are supposed to have no necks or legs, but stout cylindrical bodies which"/>
                    </TextLine>

                    <TextLine ID="mz_1-262_l38" HPOS="715" VPOS="2745" WIDTH="457" HEIGHT="56" BASELINE="717 2780 1172 2775" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="717 2780 717 2793 1157 2801 1159 2801 1161 2801 1163 2801 1163 2799 1172 2790 1172 2775 1165 2745 715 2747 717 2780"/>
                        </Shape>
                        <String CONTENT="move about swiftly."/>
                    </TextLine>
