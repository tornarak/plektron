                <TextBlock ID="text_1-239" HPOS="336" VPOS="619" WIDTH="1786" HEIGHT="2632"><TextLine ID="mz_1-239_l1" HPOS="914" VPOS="621" WIDTH="624" HEIGHT="56" BASELINE="916 658 1538 653" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1527 621 921 623 914 630 916 658 916 677 1536 673 1538 653 1531 621 1527 621"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l2" HPOS="2016" VPOS="619" WIDTH="96" HEIGHT="58" BASELINE="2016 660 2112 660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2103 630 2081 628 2060 623 2038 619 2016 628 2016 660 2016 677 2112 677 2112 660 2112 632 2103 630"/>
                        </Shape>
                        <String CONTENT="183"/>
                    </TextLine>
<TextLine ID="mz_1-239_l3" HPOS="336" VPOS="727" WIDTH="1778" HEIGHT="67" BASELINE="338 773 2114 762" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="466 731 444 731 422 734 407 734 336 740 338 773 338 794 1014 794 1014 792 1016 792 1050 781 1399 790 1401 790 1486 779 1501 790 1503 790 1505 790 1507 792 1618 792 1618 790 1620 790 1622 790 1637 779 1754 790 1756 790 1759 790 1800 777 1821 788 1824 788 1826 790 2094 790 2094 788 2097 788 2099 788 2114 775 2114 762 2109 731 693 727 691 727 689 727 687 727 672 738 474 729 466 731"/>
                        </Shape>
                        <String CONTENT="population of the island was due, for the most part, to the unwholesome"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l4" HPOS="338" VPOS="783" WIDTH="554" HEIGHT="68" BASELINE="340 825 892 829" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 825 338 844 347 851 349 851 351 851 353 851 890 842 892 829 890 799 754 799 730 786 728 786 726 786 723 786 678 796 650 786 648 786 646 786 643 786 641 786 630 794 620 786 620 783 617 783 615 783 613 783 611 783 570 794 490 783 487 783 340 792 340 825"/>
                        </Shape>
                        <String CONTENT="condition of the houses."/>
                    </TextLine>
<TextLine ID="mz_1-239_l5" HPOS="446" VPOS="842" WIDTH="1668" HEIGHT="63" BASELINE="448 889 2114 883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 889 448 905 2112 898 2114 883 2112 855 2077 842 2075 842 2073 842 1709 853 1674 842 1672 842 1670 842 1527 855 1488 844 1486 844 1484 844 1406 855 1347 844 1345 844 1343 844 1319 855 1230 844 1228 844 999 857 708 846 706 846 704 846 702 846 689 859 516 859 459 846 457 846 455 846 453 846 453 848 446 853 448 889"/>
                        </Shape>
                        <String CONTENT="So, upon the whole, we must admit for this part of northeastern Asia"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l6" HPOS="338" VPOS="902" WIDTH="1776" HEIGHT="63" BASELINE="340 948 2114 941" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 948 340 965 2112 959 2114 941 2109 913 1564 902 1562 902 1559 902 1514 913 1059 905 1057 905 338 918 340 948"/>
                        </Shape>
                        <String CONTENT="two principal types of house. One is the “jaw-bone house,” which in ancient"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l7" HPOS="338" VPOS="963" WIDTH="1776" HEIGHT="61" BASELINE="340 1009 2114 1004" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1009 340 1024 2112 1019 2114 1004 2109 976 2042 963 2040 963 2038 963 2010 974 1772 963 1769 963 1767 963 1741 974 1696 963 1694 963 1692 963 1689 963 1668 974 1611 963 1609 963 1607 963 1585 974 1553 963 1551 963 1549 963 1458 974 1339 963 1336 963 1334 963 1289 974 1235 963 1232 963 1230 963 1228 963 1211 976 1109 965 1107 965 1105 965 1066 976 927 965 925 965 923 965 921 965 901 978 719 978 693 965 691 965 542 965 539 965 461 976 364 965 362 965 360 965 357 965 338 974 340 1009"/>
                        </Shape>
                        <String CONTENT="times existed in many places along the Arctic and the Pacific shores, but"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l8" HPOS="342" VPOS="1037" WIDTH="1772" HEIGHT="45" BASELINE="342 1067 2114 1067" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1067 342 1082 2114 1082 2114 1067 2114 1037 342 1037 342 1067"/>
                        </Shape>
                        <String CONTENT="which at present has almost altogether gone out of use. It is more or less"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l9" HPOS="340" VPOS="1084" WIDTH="1772" HEIGHT="59" BASELINE="342 1125 2112 1121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1125 342 1143 2109 1138 2112 1121 2107 1089 368 1084 366 1084 364 1084 340 1093 342 1125"/>
                        </Shape>
                        <String CONTENT="similar to the habitations of the Eskimo in America, and of the Koryak and"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l10" HPOS="342" VPOS="1141" WIDTH="1772" HEIGHT="62" BASELINE="344 1188 2114 1182" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1188 344 1203 2112 1197 2114 1182 2109 1154 2047 1141 2045 1141 2042 1141 2021 1151 1650 1141 1648 1141 1646 1141 1622 1151 1559 1141 1557 1141 1555 1141 1520 1154 1494 1143 1492 1143 1384 1143 1382 1143 1380 1143 1378 1143 1365 1154 1306 1143 1304 1143 1302 1143 1274 1154 1224 1143 1222 1143 1219 1143 1191 1154 992 1143 990 1143 866 1156 778 1145 775 1145 697 1156 641 1145 639 1145 342 1151 344 1188"/>
                        </Shape>
                        <String CONTENT="Kamchadal in Asia. Another type is the double skin house, the “genuine"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l11" HPOS="338" VPOS="1201" WIDTH="1774" HEIGHT="61" BASELINE="340 1247 2112 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1247 340 1262 2109 1258 2112 1242 2107 1214 1579 1201 1577 1201 1525 1212 1494 1201 1492 1201 1490 1201 1488 1201 1466 1212 1438 1201 1436 1201 1434 1201 1291 1212 1256 1201 1254 1201 1252 1201 1250 1201 1206 1214 1107 1203 1105 1203 1102 1203 1070 1214 1029 1203 1027 1203 1025 1203 1022 1203 999 1214 977 1203 975 1203 973 1203 970 1203 934 1214 823 1203 821 1203 819 1203 795 1214 782 1203 780 1203 778 1203 775 1203 338 1212 340 1247"/>
                        </Shape>
                        <String CONTENT="house” of the Chukchee. It is also ancient, and the Chukchee consider it as"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l12" HPOS="336" VPOS="1268" WIDTH="1776" HEIGHT="57" BASELINE="338 1309 2112 1301" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="338 1309 338 1325 2109 1316 2112 1301 2105 1268 336 1275 338 1309"/>
                        </Shape>
                        <String CONTENT="characteristic of their tribe. Outside of the Chukchee territory, setting aside its"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l13" HPOS="336" VPOS="1325" WIDTH="1773" HEIGHT="60" BASELINE="338 1368 2109 1364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="336 1338 338 1368 338 1385 2107 1381 2109 1364 2105 1333 535 1325 533 1325 336 1335 336 1338"/>
                        </Shape>
                        <String CONTENT="recent adoption by the Asiatic Eskimo, it occurs only among the Reindeer Koryak."/>
                    </TextLine>
<TextLine ID="mz_1-239_l14" HPOS="448" VPOS="1379" WIDTH="1664" HEIGHT="67" BASELINE="451 1431 2112 1422" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="451 1431 451 1446 2109 1437 2112 1422 2107 1392 1945 1379 1943 1379 1893 1390 1869 1379 1867 1379 1865 1379 1804 1390 1780 1379 1778 1379 1776 1379 1774 1379 1772 1379 1756 1390 1741 1379 1739 1379 1737 1379 1735 1379 1657 1392 1447 1381 1445 1381 1442 1381 1412 1394 1278 1394 1252 1383 1250 1383 1248 1383 1118 1394 1094 1383 1092 1383 1089 1383 1087 1383 1085 1383 1072 1394 1022 1383 1020 1383 921 1394 864 1383 862 1383 860 1383 819 1396 594 1385 591 1385 520 1396 466 1385 464 1385 461 1385 459 1385 448 1394 451 1431"/>
                        </Shape>
                        <String CONTENT="Snow-House. — The vaulted snow-house, which is typical for the Eskimo"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l15" HPOS="338" VPOS="1446" WIDTH="1778" HEIGHT="63" BASELINE="340 1489 2116 1481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="340 1489 340 1509 2114 1496 2116 1481 2109 1446 752 1457 357 1448 355 1448 353 1448 351 1448 338 1455 340 1489"/>
                        </Shape>
                        <String CONTENT="tribes, does not occur anywhere on the Asiatic coast. Of all the tribes of"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l16" HPOS="340" VPOS="1500" WIDTH="1774" HEIGHT="65" BASELINE="342 1550 2114 1541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1550 342 1565 2112 1556 2114 1541 2109 1513 2025 1500 2023 1500 1919 1511 1895 1500 1893 1500 1891 1500 1837 1511 1793 1500 1791 1500 1789 1500 1787 1500 1763 1511 1536 1502 1533 1502 1326 1513 1278 1502 1276 1502 1274 1502 1271 1502 1269 1502 1252 1513 986 1504 983 1504 981 1504 979 1504 964 1515 905 1504 903 1504 901 1504 875 1515 825 1504 823 1504 821 1504 778 1517 433 1506 431 1506 340 1519 342 1550"/>
                        </Shape>
                        <String CONTENT="northeastern Asia, only the Kerek, who have no sufficient supply of wood or"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l17" HPOS="340" VPOS="1567" WIDTH="1769" HEIGHT="56" BASELINE="342 1610 2109 1604" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1610 342 1623 2107 1619 2109 1604 2105 1574 368 1567 366 1567 364 1567 340 1576 342 1610"/>
                        </Shape>
                        <String CONTENT="skins to construct adequate winter houses, utilize snow as building-material."/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l18" HPOS="342" VPOS="1632" WIDTH="1770" HEIGHT="52" BASELINE="344 1665 2112 1660" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1665 344 1684 2109 1680 2112 1660 2107 1632 342 1632 344 1665"/>
                        </Shape>
                        <String CONTENT="Their half-underground house has a frame roughly constructed of such poles"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l19" HPOS="340" VPOS="1684" WIDTH="1776" HEIGHT="56" BASELINE="342 1727 2116 1723" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1727 342 1740 2114 1736 2116 1723 2112 1684 1228 1684 1226 1684 1137 1695 414 1686 412 1686 340 1697 342 1727"/>
                        </Shape>
                        <String CONTENT="and pieces of wood as they can find on the shore. Crooked branches of"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l20" HPOS="342" VPOS="1753" WIDTH="1774" HEIGHT="50" BASELINE="342 1786 2116 1786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1786 342 1803 2116 1803 2116 1786 2114 1753 342 1753 342 1786"/>
                        </Shape>
                        <String CONTENT="stunted willow and birch trees are placed between to fill in the spaces, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l21" HPOS="340" VPOS="1805" WIDTH="1772" HEIGHT="61" BASELINE="342 1846 2112 1842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1846 342 1862 2107 1866 2112 1842 2107 1814 362 1805 360 1805 357 1805 355 1805 340 1812 342 1846"/>
                        </Shape>
                        <String CONTENT="the whole is lined, from within with such skins as they can scrape together,"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l22" HPOS="342" VPOS="1877" WIDTH="1774" HEIGHT="45" BASELINE="342 1905 2116 1905" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 1905 342 1922 2116 1922 2116 1905 2116 1877 342 1877 342 1905"/>
                        </Shape>
                        <String CONTENT="and from without with sod and loose earth. A long, low, narrow passage"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l23" HPOS="342" VPOS="1924" WIDTH="1772" HEIGHT="59" BASELINE="344 1968 2114 1963" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 1968 344 1981 2109 1983 2114 1963 2109 1933 427 1924 425 1924 342 1935 344 1968"/>
                        </Shape>
                        <String CONTENT="made of similar material forms the entrance. It is divided into three parts,"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l24" HPOS="340" VPOS="1981" WIDTH="1774" HEIGHT="71" BASELINE="342 2028 2114 2022" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2028 342 2041 557 2052 559 2052 561 2052 563 2052 578 2041 2112 2041 2114 2022 2112 1994 2086 1981 2084 1981 2081 1981 2079 1981 2055 1994 1800 1994 1767 1981 1765 1981 1763 1981 1646 1991 1611 1981 1609 1981 1607 1981 1520 1994 1497 1983 1494 1983 1492 1983 1050 1994 953 1983 951 1983 949 1983 947 1983 927 1996 847 1985 845 1985 691 1996 620 1985 617 1985 615 1985 576 1996 368 1985 366 1985 364 1985 340 1996 342 2028"/>
                        </Shape>
                        <String CONTENT="closed by skin curtains. This structure is used in spring and summer as it"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l25" HPOS="342" VPOS="2054" WIDTH="1772" HEIGHT="52" BASELINE="342 2087 2114 2087" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="342 2087 342 2100 2112 2106 2114 2087 2114 2054 342 2054 342 2087"/>
                        </Shape>
                        <String CONTENT="is; but in the fall it is covered with a thick layer of snow several feet deep,"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l26" HPOS="342" VPOS="2102" WIDTH="1772" HEIGHT="60" BASELINE="344 2147 2114 2143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2147 344 2162 2112 2158 2114 2143 2109 2113 1258 2102 1256 2102 1254 2102 1222 2113 412 2104 409 2104 342 2115 344 2147"/>
                        </Shape>
                        <String CONTENT="and fashioned into a well-defined round or rectangular form, which gives to"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l27" HPOS="342" VPOS="2160" WIDTH="1395" HEIGHT="63" BASELINE="344 2208 1737 2201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2208 344 2223 1735 2219 1737 2201 1733 2173 1291 2160 1289 2160 1287 2160 1284 2160 1267 2173 1228 2162 1226 2162 1224 2162 1040 2173 895 2162 892 2162 739 2175 453 2165 451 2165 448 2165 446 2165 431 2175 364 2165 362 2165 360 2165 357 2165 342 2173 344 2208"/>
                        </Shape>
                        <String CONTENT="this house some outward likeness to the Eskimo snow-house."/>
                    </TextLine>
<TextLine ID="mz_1-239_l28" HPOS="457" VPOS="2223" WIDTH="1659" HEIGHT="59" BASELINE="457 2264 2116 2264" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="457 2264 457 2282 2116 2282 2116 2264 2116 2236 2049 2223 2047 2223 1997 2234 1982 2223 1980 2223 1977 2223 1975 2223 1973 2223 1925 2234 1772 2223 1769 2223 1767 2223 1737 2234 1700 2223 1698 2223 1696 2223 1596 2234 1492 2223 1490 2223 1488 2223 1451 2234 1388 2223 1386 2223 1330 2234 1304 2223 1302 2223 1300 2223 1297 2223 1267 2234 457 2230 457 2264"/>
                        </Shape>
                        <String CONTENT="The interior arrangements are much like those of the houses of other"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l29" HPOS="342" VPOS="2279" WIDTH="1774" HEIGHT="63" BASELINE="344 2329 2116 2323" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="344 2329 344 2342 2114 2336 2116 2323 2112 2292 1863 2279 1860 2279 1858 2279 1856 2279 1839 2292 1644 2292 1601 2279 1598 2279 1596 2279 1520 2292 1180 2282 1178 2282 1115 2292 1085 2282 1083 2282 1081 2282 1014 2292 949 2282 947 2282 944 2282 942 2282 927 2295 860 2284 858 2284 799 2295 782 2284 780 2284 778 2284 775 2284 717 2295 672 2284 669 2284 667 2284 342 2292 344 2329"/>
                        </Shape>
                        <String CONTENT="branches of the Maritime Koryak. The lack of a roof-entrance with its cha-"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l30" HPOS="344" VPOS="2340" WIDTH="1774" HEIGHT="63" BASELINE="347 2390 2118 2381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2390 347 2403 2118 2394 2118 2381 2114 2351 1692 2340 1689 2340 1687 2340 1685 2340 1668 2351 843 2344 840 2344 344 2357 347 2390"/>
                        </Shape>
                        <String CONTENT="racteristic tree-ladder, however, gives it a peculiar feature. On that part of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l31" HPOS="344" VPOS="2401" WIDTH="1772" HEIGHT="69" BASELINE="347 2448 2116 2440" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2448 347 2461 1105 2470 1107 2470 1109 2470 1148 2459 1464 2468 1466 2468 1523 2457 1622 2468 1624 2468 1627 2468 1646 2457 1663 2468 1666 2468 1668 2468 1670 2468 1735 2455 1756 2466 1759 2466 1761 2466 1830 2455 1854 2466 1856 2466 1858 2466 1860 2466 1899 2455 1915 2466 1917 2466 1919 2466 1921 2466 1997 2455 2086 2466 2088 2466 2090 2466 2116 2453 2116 2440 2112 2411 1674 2401 1672 2401 1670 2401 1668 2401 1650 2411 795 2405 793 2405 791 2405 788 2405 775 2416 366 2407 364 2407 362 2407 360 2407 344 2414 347 2448"/>
                        </Shape>
                        <String CONTENT="shore no logs fit for the purpose can be found. Thus the use of the tree-"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l32" HPOS="344" VPOS="2459" WIDTH="1772" HEIGHT="65" BASELINE="347 2507 2116 2500" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2507 347 2524 2114 2518 2116 2500 2112 2470 1531 2459 1529 2459 1527 2459 1525 2459 1512 2472 344 2472 347 2507"/>
                        </Shape>
                        <String CONTENT="ladder ceases suddenly on this part of the Asiatic shore for want of material."/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l33" HPOS="347" VPOS="2531" WIDTH="1769" HEIGHT="52" BASELINE="349 2565 2116 2561" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 2565 349 2583 2114 2578 2116 2561 2109 2531 347 2531 349 2565"/>
                        </Shape>
                        <String CONTENT="Farther to the northward and eastward, across Bering Strait, along the American"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l34" HPOS="344" VPOS="2583" WIDTH="1772" HEIGHT="58" BASELINE="347 2626 2116 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2626 347 2641 2114 2637 2116 2619 2112 2591 936 2583 934 2583 931 2583 884 2593 370 2585 368 2585 366 2585 344 2593 347 2626"/>
                        </Shape>
                        <String CONTENT="shore on the Arctic and Pacific Oceans, are found various types of houses."/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l35" HPOS="347" VPOS="2639" WIDTH="1767" HEIGHT="65" BASELINE="349 2686 2114 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="349 2686 349 2702 2109 2704 2114 2680 2109 2652 2055 2639 2053 2639 1967 2650 1943 2639 1941 2639 1938 2639 1936 2639 1904 2650 1880 2639 1878 2639 1876 2639 1873 2639 1871 2639 1856 2652 1767 2652 1737 2639 1735 2639 1733 2639 1731 2639 1694 2650 1657 2639 1655 2639 1653 2639 1601 2650 1575 2639 1572 2639 1570 2639 1568 2639 1514 2652 1455 2641 1453 2641 1451 2641 1421 2652 1131 2641 1128 2641 1126 2641 1092 2652 1025 2641 1022 2641 1020 2641 986 2652 951 2641 949 2641 947 2641 944 2641 942 2641 929 2654 903 2643 901 2643 899 2643 620 2654 360 2643 357 2643 355 2643 353 2643 353 2645 347 2650 349 2686"/>
                        </Shape>
                        <String CONTENT="Still farther to the south, in America, after the forest border is reached again,"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l36" HPOS="344" VPOS="2704" WIDTH="1774" HEIGHT="58" BASELINE="347 2747 2118 2743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2747 347 2762 2116 2758 2118 2743 2114 2712 366 2704 364 2704 362 2704 360 2704 344 2710 347 2747"/>
                        </Shape>
                        <String CONTENT="the square roof-entrance and the notched tree-ladder re-appear in exactly the"/>
                    </TextLine>

                    <TextLine ID="mz_1-239_l37" HPOS="344" VPOS="2769" WIDTH="1397" HEIGHT="54" BASELINE="347 2808 1741 2801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="347 2808 347 2823 1739 2816 1741 2801 1735 2769 344 2773 347 2808"/>
                        </Shape>
                        <String CONTENT="same shapes as among the Koryak and Kamchadal in Asia."/>
                    </TextLine>
