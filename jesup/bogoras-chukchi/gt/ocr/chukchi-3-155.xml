                        </Shape>
                        <String CONTENT="them no tribute. Likewise at the present time they would not pay anything,"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l25" HPOS="366" VPOS="1909" WIDTH="1764" HEIGHT="54" BASELINE="368 1950 2130 1946" TAGREFS="TYPE_5">
