                        </Shape>
                        <String CONTENT="with deceit to the Lower Kolyma winter hamlet. One of them was taken"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l10" HPOS="362" VPOS="1006" WIDTH="1770" HEIGHT="61" BASELINE="364 1053 2132 1047" TAGREFS="TYPE_5">
