                        </Shape>
                        <String CONTENT="sent us by tundra to the winter hamlet (зимовье) of the Lower Kolyma. We"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l6" HPOS="360" VPOS="771" WIDTH="1766" HEIGHT="62" BASELINE="362 813 2126 809" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 813 362 827 2122 833 2126 809 2122 782 2057 771 2056 771 2054 771 2024 780 1993 771 1991 771 1989 771 1933 780 1831 771 1829 771 1828 771 1798 780 1611 771 1609 771 1500 780 1329 771 1327 771 1241 782 1221 772 1219 772 1218 772 1159 782 1083 772 1081 772 1030 784 890 784 874 772 873 772 871 772 869 772 360 776 362 813"/>
                        </Shape>
                        <String CONTENT="lost our way and fed on weeds, and reached the Kolyma on the tenth day,"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l7" HPOS="360" VPOS="829" WIDTH="1768" HEIGHT="58" BASELINE="362 874 2128 866" TAGREFS="TYPE_5">
