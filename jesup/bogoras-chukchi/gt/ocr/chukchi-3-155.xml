                        </Shape>
                        <String CONTENT="captive, Niˊtkal, according to his Chukchee name. The said Niˊtkal said that"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l11" HPOS="362" VPOS="1067" WIDTH="1766" HEIGHT="64" BASELINE="364 1114 2128 1108" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1114 364 1131 2126 1131 2128 1108 2124 1078 1826 1067 1824 1067 1775 1076 1748 1067 1746 1067 1744 1067 1742 1067 1740 1067 1724 1078 1598 1078 1570 1067 1568 1067 1566 1067 1564 1067 1535 1078 1485 1069 1483 1069 1481 1069 1453 1078 1169 1069 1167 1069 1165 1069 1163 1069 1147 1080 1034 1080 976 1069 974 1069 972 1069 931 1080 908 1071 906 1071 904 1071 837 1080 567 1071 565 1071 362 1078 364 1114"/>
                        </Shape>
                        <String CONTENT="Daniel Busormanov, going by sea, did not recognize the mouth of the Kolyma,"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l12" HPOS="364" VPOS="1129" WIDTH="1768" HEIGHT="66" BASELINE="366 1174 2132 1168" TAGREFS="TYPE_5">
