                        </Shape>
                        <String CONTENT="near the mouth of the Konkova River. We were starving. So he, Daniel,"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l5" HPOS="360" VPOS="708" WIDTH="1766" HEIGHT="61" BASELINE="362 755 2126 747" TAGREFS="TYPE_5">
