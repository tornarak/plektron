                        </Shape>
                        <String CONTENT="this present year 1710. In January of this year some Chukchee robbers came"/>
                    </TextLine>

                    <TextLine ID="mz_3-155_l9" HPOS="364" VPOS="952" WIDTH="1773" HEIGHT="52" BASELINE="364 991 2137 991" TAGREFS="TYPE_5">
