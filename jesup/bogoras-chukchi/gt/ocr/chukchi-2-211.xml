                        </Shape>
                        <String CONTENT="victim. It may, however, be intercepted and made ineffectual by some magic"/>
                    </TextLine>

                    <TextLine ID="mz_2-211_l33" HPOS="446" VPOS="2373" WIDTH="1767" HEIGHT="59" BASELINE="448 2412 2213 2408" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="448 2412 448 2432 2211 2424 2213 2408 2209 2373 710 2373 708 2373 446 2383 448 2412"/>
                        </Shape>
