                        </Shape>
                        <String CONTENT="according to their mode of life in the different seasons. The varieties of"/>
                    </TextLine>

                    <TextLine ID="mz_1-151_l13" HPOS="368" VPOS="1717" WIDTH="1774" HEIGHT="64" BASELINE="370 1758 2142 1753" TAGREFS="TYPE_5">
                        <Shape>
