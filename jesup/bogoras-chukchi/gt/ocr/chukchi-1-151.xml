                    </TextLine>

                    <TextLine ID="mz_1-151_l15" HPOS="368" VPOS="1831" WIDTH="1770" HEIGHT="61" BASELINE="370 1877 2138 1872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1877 370 1892 2135 1888 2138 1872 2133 1842 1254 1831 1252 1831 1250 1831 1219 1842 412 1833 409 1833 407 1833 368 1844 370 1877"/>
                        </Shape>
