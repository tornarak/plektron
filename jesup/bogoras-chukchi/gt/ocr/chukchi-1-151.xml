                    </TextLine>

                    <TextLine ID="mz_1-151_l16" HPOS="368" VPOS="1905" WIDTH="1770" HEIGHT="47" BASELINE="368 1933 2138 1933" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 1933 368 1952 2138 1952 2138 1933 2138 1905 368 1905 368 1933"/>
                        </Shape>
                        <String CONTENT="are used in spring to stalk the animals on the smooth ice, and also during the"/>
                    </TextLine>

                    <TextLine ID="mz_1-151_l17" HPOS="368" VPOS="1952" WIDTH="1770" HEIGHT="59" BASELINE="370 1996 2138 1989" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 1996 370 2011 2135 2007 2138 1989 2133 1961 1059 1952 1057 1952 368 1965 370 1996"/>
                        </Shape>
                        <String CONTENT="summer on the open water. Now, however, this latter style of harpoon has"/>
                    </TextLine>

                    <TextLine ID="mz_1-151_l18" HPOS="373" VPOS="2017" WIDTH="1767" HEIGHT="55" BASELINE="373 2054 2140 2054" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2054 373 2072 2138 2072 2140 2054 2138 2024 373 2017 373 2054"/>
                        </Shape>
                        <String CONTENT="been almost superseded by the gun in this kind of hunting. The form of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-151_l19" HPOS="370" VPOS="2080" WIDTH="1768" HEIGHT="54" BASELINE="373 2115 2138 2111" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="373 2115 373 2134 2138 2134 2138 2111 2133 2082 370 2080 373 2115"/>
