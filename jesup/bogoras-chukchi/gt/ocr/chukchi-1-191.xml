<TextLine ID="mz_1-191_l3" HPOS="364" VPOS="701" WIDTH="1769" HEIGHT="74" BASELINE="366 751 2133 755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="862 703 840 703 819 703 797 703 775 705 754 705 732 705 710 705 691 705 650 714 630 708 624 708 602 708 581 708 572 708 539 714 524 708 516 708 494 710 472 710 470 710 453 714 435 710 429 710 407 710 386 710 366 738 366 751 364 775 2131 775 2133 755 2129 708 1917 716 1860 703 1858 703 1856 703 1761 716 1722 703 1720 703 1718 703 1715 703 1676 716 1648 703 1646 703 1644 703 1642 703 1640 703 1618 718 1440 718 1406 703 1403 703 1401 703 1399 703 1397 703 1378 718 1252 718 1150 716 1133 701 1131 701 1128 701 1126 701 1124 701 1094 714 940 701 938 701 936 701 886 714 864 703 862 703"/>
                        </Shape>
                        <String CONTENT="However, no Chukchee has patience enough to cut six feet of ice, as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l4" HPOS="370" VPOS="766" WIDTH="1397" HEIGHT="80" BASELINE="370 816 1767 816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 816 370 846 1767 844 1767 816 1767 779 1733 766 1731 766 1728 766 1726 766 1683 779 1637 766 1635 766 1633 766 1631 766 1581 779 1529 766 1527 766 1525 766 1462 779 1421 768 1419 768 1416 768 1278 779 1258 766 1256 766 1254 766 1252 766 1250 766 1248 766 1232 781 1139 781 1126 768 1126 766 1124 766 1122 766 882 766 879 766 877 766 875 766 858 781 749 781 646 766 643 766 570 779 542 766 539 766 537 766 535 766 533 766 520 779 481 766 479 766 477 766 474 766 433 779 370 766 370 816"/>
                        </Shape>
                        <String CONTENT="Russianized fisherman of the Kolyma does in setting his net."/>
                    </TextLine>
<TextLine ID="mz_1-191_l5" HPOS="474" VPOS="825" WIDTH="1655" HEIGHT="95" BASELINE="477 876 2129 872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 876 477 902 546 918 548 918 550 918 598 905 910 905 931 918 934 918 936 918 938 918 1022 905 1042 918 1044 918 1046 918 1048 920 1154 920 1154 918 1157 918 1191 905 1291 918 1293 918 1520 915 1523 915 1525 915 1538 905 1618 915 1620 915 1622 915 1653 902 1780 915 1782 915 2127 913 2129 872 2122 825 474 835 477 876"/>
                        </Shape>
                        <String CONTENT="Bag-nets fastened to a square frame made of thin stakes (Fig. 63) are"/>
                    </TextLine>
<TextLine ID="mz_1-191_l6" HPOS="362" VPOS="1719" WIDTH="1416" HEIGHT="65" BASELINE="364 1764 1778 1760" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1769 1723 1748 1723 1726 1723 1722 1723 1705 1723 1683 1723 1661 1723 1640 1723 1618 1723 1596 1723 1575 1723 1553 1723 1531 1723 1510 1723 1507 1725 1436 1725 1429 1723 1423 1723 1401 1723 1380 1723 1378 1723 1375 1725 1206 1725 1196 1721 1185 1721 1163 1721 1152 1721 1150 1723 1144 1721 1141 1721 1120 1721 1098 1721 1081 1721 1066 1725 678 1719 665 1719 643 1719 622 1719 600 1719 578 1719 557 1719 535 1719 513 1719 492 1719 470 1719 448 1719 427 1719 405 1719 399 1719 373 1725 362 1734 364 1764 364 1784 1776 1781 1778 1760 1776 1725 1774 1723 1769 1723"/>
                        </Shape>
                        <String CONTENT="used in shallow water. The vertical stakes of the frame have"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l7" HPOS="364" VPOS="1777" WIDTH="1050" HEIGHT="74" BASELINE="366 1827 1414 1823" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1827 366 1849 1410 1851 1414 1823 1410 1788 1152 1777 1150 1777 1096 1788 1044 1777 1042 1777 962 1788 888 1777 886 1777 884 1777 882 1777 858 1790 563 1779 561 1779 559 1779 557 1779 542 1792 429 1792 381 1779 379 1779 377 1779 375 1779 373 1779 373 1781 364 1788 366 1827"/>
                        </Shape>
                        <String CONTENT="sharp points, and are driven into the ground."/>
                    </TextLine>
<TextLine ID="mz_1-191_l8" HPOS="479" VPOS="1840" WIDTH="1299" HEIGHT="69" BASELINE="481 1888 1778 1881" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="481 1888 481 1909 1778 1907 1778 1881 1772 1840 479 1846 481 1888"/>
                        </Shape>
                        <String CONTENT="The ice-scoop used by the Chukchee (Fig. 64) is of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l9" HPOS="364" VPOS="1903" WIDTH="1412" HEIGHT="69" BASELINE="366 1944 1776 1937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 1944 366 1972 1774 1963 1776 1937 1769 1903 364 1905 366 1944"/>
                        </Shape>
                        <String CONTENT="well-known Eskimo form, chiefly of small size, and has a cir-"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l10" HPOS="364" VPOS="1965" WIDTH="1410" HEIGHT="61" BASELINE="366 2007 1774 2000" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2007 366 2026 1772 2026 1774 2000 1767 1965 364 1970 366 2007"/>
                        </Shape>
                        <String CONTENT="cular hoop of antler netted across with whalebone strings or"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l11" HPOS="362" VPOS="2022" WIDTH="1412" HEIGHT="67" BASELINE="364 2067 1774 2061" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2067 364 2087 1769 2089 1774 2061 1769 2028 381 2022 379 2022 377 2022 375 2022 362 2028 364 2067"/>
                        </Shape>
                        <String CONTENT="thin strips of leather. A round hoop-net made of whalebone"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l12" HPOS="362" VPOS="2080" WIDTH="1416" HEIGHT="78" BASELINE="364 2132 1778 2121" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2132 364 2158 1778 2147 1778 2121 1772 2080 362 2089 364 2132"/>
                        </Shape>
                        <String CONTENT="(Fig. 65), with one large stone beneath for a sinker, is used for"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l13" HPOS="364" VPOS="2139" WIDTH="1408" HEIGHT="71" BASELINE="366 2184 1772 2180" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2184 366 2210 1769 2206 1772 2180 1765 2139 364 2147 366 2184"/>
                        </Shape>
                        <String CONTENT="catching wachna.¹ It is identical with the American Eskimo net.²"/>
                    </TextLine>
<TextLine ID="mz_1-191_l14" HPOS="477" VPOS="2195" WIDTH="1297" HEIGHT="78" BASELINE="479 2245 1774 2240" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="479 2245 479 2273 1772 2269 1774 2240 1769 2208 1646 2195 1644 2195 1577 2206 1555 2195 1553 2195 1551 2195 1549 2195 1523 2208 1343 2208 1315 2195 1313 2195 1310 2195 1224 2206 1178 2195 1176 2195 1174 2195 1053 2208 581 2197 578 2197 576 2197 533 2208 494 2197 492 2197 490 2197 487 2197 485 2197 477 2204 479 2245"/>
                        </Shape>
                        <String CONTENT="Nordenskiöld³ gives a picture of a fish-spear made of bone."/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l15" HPOS="366" VPOS="2258" WIDTH="1414" HEIGHT="69" BASELINE="366 2303 1780 2303" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2303 366 2327 1780 2327 1780 2303 1780 2269 1759 2258 1756 2258 1754 2258 1752 2258 1722 2269 1692 2258 1689 2258 1575 2258 1572 2258 1570 2258 1568 2258 1553 2271 1386 2271 1367 2258 1365 2258 1362 2258 1360 2258 1358 2258 1334 2271 1172 2271 1159 2258 1157 2258 1154 2258 1152 2258 1081 2269 1040 2258 1038 2258 1035 2258 1033 2258 1031 2258 1014 2269 992 2258 990 2258 988 2258 916 2271 830 2271 817 2258 814 2258 812 2258 810 2258 808 2258 773 2271 652 2271 633 2258 630 2258 628 2258 626 2258 624 2258 587 2269 548 2258 546 2258 544 2258 366 2266 366 2303"/>
                        </Shape>
                        <String CONTENT="On the Pacific coast I met with the fish-spear only among the Kerek"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l16" HPOS="364" VPOS="2316" WIDTH="1414" HEIGHT="76" BASELINE="366 2366 1778 2357" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2366 366 2392 1776 2383 1778 2357 1774 2325 1575 2316 1572 2316 1507 2327 1464 2316 1462 2316 1460 2316 1458 2316 1455 2316 1442 2329 1339 2329 1328 2321 1328 2318 1326 2318 1323 2318 1159 2318 1157 2318 1154 2318 1152 2318 1139 2329 953 2321 951 2321 949 2321 947 2321 947 2323 936 2331 808 2323 806 2323 695 2334 661 2323 659 2323 656 2323 583 2334 559 2323 557 2323 386 2323 383 2323 381 2323 379 2323 364 2331 366 2366"/>
                        </Shape>
                        <String CONTENT="near Cape Anannon, and in several places among the Kam-"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l17" HPOS="362" VPOS="2379" WIDTH="1418" HEIGHT="80" BASELINE="364 2427 1780 2420" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2427 364 2448 832 2459 834 2459 836 2459 877 2448 1752 2455 1754 2455 1756 2455 1780 2442 1780 2420 1776 2385 381 2379 379 2379 377 2379 375 2379 362 2385 364 2427"/>
                        </Shape>
                        <String CONTENT="chatka Koryak. Their spears, however, are more or less similar"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l18" HPOS="364" VPOS="2444" WIDTH="1414" HEIGHT="74" BASELINE="366 2487 1778 2481" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2487 366 2507 643 2518 646 2518 648 2518 693 2507 730 2518 732 2518 734 2518 736 2518 769 2507 786 2518 788 2518 791 2518 793 2518 795 2518 819 2507 1776 2507 1778 2481 1772 2444 364 2446 366 2487"/>
                        </Shape>
                        <String CONTENT="to that given by Nordenskiöld. The specimen represented in"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l19" HPOS="366" VPOS="2494" WIDTH="1408" HEIGHT="84" BASELINE="368 2548 1774 2541" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="368 2548 368 2567 771 2578 773 2578 1098 2565 1280 2576 1282 2576 1772 2561 1774 2541 1765 2496 1731 2507 1566 2494 1564 2494 1562 2494 1525 2507 1462 2494 1460 2494 1458 2494 1455 2494 1436 2509 1371 2509 1341 2494 1339 2494 1336 2494 1334 2494 1300 2511 1217 2511 1204 2498 1204 2496 1202 2496 1200 2496 1198 2496 1089 2511 986 2511 962 2496 960 2496 957 2496 955 2496 877 2509 812 2498 810 2498 808 2498 806 2498 784 2511 715 2498 713 2498 710 2498 708 2498 691 2509 617 2498 520 2498 518 2498 516 2498 513 2498 492 2511 366 2505 368 2548"/>
                        </Shape>
                        <String CONTENT="Fig. 66 probably formed one of the prongs of a fish-spear.⁴"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l20" HPOS="368" VPOS="2554" WIDTH="1406" HEIGHT="83" BASELINE="370 2608 1774 2600" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="370 2608 370 2637 1772 2632 1774 2600 1767 2554 1650 2565 1579 2554 1577 2554 1575 2554 1542 2565 1464 2554 1462 2554 1395 2570 1211 2570 1187 2557 1185 2557 1183 2557 1118 2567 1074 2557 1072 2557 1070 2557 1068 2557 1066 2557 1048 2572 973 2572 962 2561 962 2559 960 2559 957 2559 955 2559 840 2570 825 2559 823 2559 821 2559 721 2559 719 2559 717 2559 674 2572 368 2563 370 2608"/>
                        </Shape>
                        <String CONTENT="It is made of bone, and was found on an ancient house-site"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l21" HPOS="366" VPOS="2624" WIDTH="723" HEIGHT="69" BASELINE="366 2667 1089 2667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2667 366 2693 1089 2693 1089 2667 1087 2624 366 2624 366 2667"/>
                        </Shape>
                        <String CONTENT="in the Eskimo village Wuteˊen."/>
                    </TextLine>
<TextLine ID="mz_1-191_l22" HPOS="474" VPOS="2669" WIDTH="1304" HEIGHT="89" BASELINE="477 2728 1778 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 2728 479 2758 526 2747 877 2756 879 2756 953 2745 1776 2745 1778 2721 1776 2684 1744 2669 1741 2669 1668 2669 1666 2669 1663 2669 1661 2669 1661 2671 1648 2682 1592 2671 1590 2671 1588 2671 1585 2671 1572 2682 1555 2669 1553 2669 1551 2669 1549 2669 1546 2669 1497 2682 1445 2669 1442 2669 1440 2669 1438 2669 1386 2682 1367 2669 1365 2669 1362 2669 1360 2669 1358 2669 1356 2669 1336 2684 1237 2671 1235 2671 1232 2671 1200 2686 1089 2686 1066 2671 1063 2671 1061 2671 1059 2671 1057 2671 1055 2671 1040 2684 927 2684 914 2673 914 2671 912 2671 910 2671 908 2671 905 2671 875 2686 615 2673 613 2673 546 2684 507 2673 505 2673 503 2673 500 2673 474 2684 477 2728"/>
                        </Shape>
                        <String CONTENT="The Chukchee make hardly any fish-weirs, because of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l23" HPOS="362" VPOS="2734" WIDTH="1414" HEIGHT="76" BASELINE="364 2788 1776 2782" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 2788 364 2810 1774 2810 1776 2782 1772 2749 1520 2734 1518 2734 1516 2734 1514 2734 1499 2749 1356 2749 1313 2734 1310 2734 1308 2734 1306 2734 1304 2734 1287 2749 1241 2736 1239 2736 1237 2736 1235 2736 1191 2749 977 2749 966 2738 966 2736 964 2736 962 2736 960 2736 804 2751 572 2751 546 2738 544 2738 542 2738 362 2747 364 2788"/>
                        </Shape>
                        <String CONTENT="lack of proper material for constructing fences and fish-traps."/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l24" HPOS="364" VPOS="2799" WIDTH="1412" HEIGHT="74" BASELINE="366 2847 1776 2842" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2847 366 2868 1772 2873 1776 2842 1772 2805 377 2799 375 2799 373 2799 370 2799 370 2801 364 2805 366 2847"/>
                        </Shape>
                        <String CONTENT="On the Arctic coast, at the mouth of some of the smaller rivers,"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l25" HPOS="364" VPOS="2864" WIDTH="1416" HEIGHT="67" BASELINE="366 2905 1780 2901" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2905 366 2931 1778 2927 1780 2901 1774 2864 364 2866 366 2905"/>
                        </Shape>
                        <String CONTENT="weirs are occasionally constructed of square pieces of sod piled"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l26" HPOS="364" VPOS="2925" WIDTH="1414" HEIGHT="67" BASELINE="366 2970 1778 2961" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 2970 366 2992 1776 2990 1778 2961 1772 2925 364 2931 366 2970"/>
                        </Shape>
                        <String CONTENT="up across the river in the form of a low wall. Fish-traps are"/>
                    </TextLine>
<TextLine ID="mz_1-191_l27" HPOS="474" VPOS="3020" WIDTH="1651" HEIGHT="60" BASELINE="477 3057 2125 3050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="477 3057 477 3080 2122 3076 2125 3050 2118 3020 474 3022 477 3057"/>
                        </Shape>
                        <String CONTENT="¹ Russian, Вахня; Chukchee and Koryak, veˊqän. This name is applied to various species of Gadi; such"/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l28" HPOS="364" VPOS="3065" WIDTH="1756" HEIGHT="85" BASELINE="366 3104 2120 3091" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="366 3104 366 3130 559 3130 613 3150 615 3150 617 3150 620 3150 676 3128 840 3130 866 3148 869 3148 871 3148 873 3148 875 3148 921 3128 955 3139 957 3139 960 3139 1035 3126 1163 3145 1165 3145 1291 3126 1455 3128 1488 3143 1490 3143 1492 3143 1494 3143 1497 3143 1518 3130 1540 3141 1542 3141 1544 3141 2118 3130 2120 3091 2114 3065 364 3074 366 3104"/>
                        </Shape>
                        <String CONTENT="as Boreogadus polaris in the Arctic, Microgadus proximus and Eleginus navaga (Gadus wachna Pall.) in the"/>
                    </TextLine>

