                        <Shape>
                            <Polygon POINTS="364 3148 364 3197 446 3195 448 3195 451 3195 451 3193 479 3169 591 3180 594 3148 594 3117 364 3115 364 3148"/>
                        </Shape>
                        <String CONTENT="Pacific Ocean."/>
                    </TextLine>

