                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-191_l2" HPOS="2040" VPOS="608" WIDTH="87" HEIGHT="74" BASELINE="2040 653 2127 653" TAGREFS="TYPE_5">
