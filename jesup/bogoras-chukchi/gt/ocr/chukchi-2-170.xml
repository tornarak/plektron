                        <Shape>
                            <Polygon POINTS="313 1110 313 1126 2076 1126 2077 1106 2074 1079 338 1071 336 1071 334 1071 311 1079 313 1110"/>
                        </Shape>
                        <String CONTENT="all the time very near to his knees, and he had even to stoop down to talk"/>
