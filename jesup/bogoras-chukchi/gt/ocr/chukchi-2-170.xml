                        </Shape>
                        <String CONTENT="voices talked to them out of the fire of the hearth; but they were never able"/>
                    </TextLine>

                    <TextLine ID="mz_2-170_l9" HPOS="315" VPOS="961" WIDTH="1766" HEIGHT="43" BASELINE="315 987 2081 987" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="315 987 315 1004 2081 1004 2081 987 2081 961 315 961 315 987"/>
                        </Shape>
