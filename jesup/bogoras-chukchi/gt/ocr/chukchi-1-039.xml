                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-039_l2" HPOS="351" VPOS="736" WIDTH="1776" HEIGHT="65" BASELINE="353 783 2127 777" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 783 353 801 2125 794 2127 777 2122 749 1999 736 1997 736 1995 736 1971 749 351 749 353 783"/>
                        </Shape>
                        <String CONTENT="literally, “fire-tools-bow Taˊn˙ñɪtan”). At present, however, on account of mis-"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l3" HPOS="353" VPOS="799" WIDTH="1774" HEIGHT="71" BASELINE="355 844 2127 840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 844 355 870 2125 857 2127 840 2122 809 1241 799 1239 799 1237 799 1198 809 533 801 531 801 353 812 355 844"/>
                        </Shape>
                        <String CONTENT="pronunciation, there has arisen a tale of a fire-drill which was left on a camping-"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l4" HPOS="353" VPOS="859" WIDTH="888" HEIGHT="67" BASELINE="355 902 1241 898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 902 355 926 1239 915 1241 898 1237 859 840 859 838 859 769 870 386 861 383 861 381 861 353 872 355 902"/>
                        </Shape>
                        <String CONTENT="place and transformed into a Russian.¹"/>
                    </TextLine>
<TextLine ID="mz_1-039_l5" HPOS="459" VPOS="918" WIDTH="1668" HEIGHT="60" BASELINE="461 963 2127 959" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 963 461 978 2125 974 2127 959 2122 928 1293 918 1291 918 1239 928 483 920 481 920 479 920 459 928 461 963"/>
                        </Shape>
                        <String CONTENT="Aˊtal-taˊn˙ñɪtan is applied to the Chuvantzy. Aˊtal (eˊtel)² is the name"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l6" HPOS="353" VPOS="983" WIDTH="1774" HEIGHT="58" BASELINE="355 1024 2127 1017" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1024 355 1041 2125 1035 2127 1017 2122 989 375 983 373 983 370 983 368 983 353 989 355 1024"/>
                        </Shape>
                        <String CONTENT="these people give to themselves at the present time. Krasheninnikoff gives"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l7" HPOS="353" VPOS="1037" WIDTH="1774" HEIGHT="73" BASELINE="355 1084 2127 1078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1084 355 1099 715 1110 717 1110 784 1099 916 1108 918 1108 921 1108 947 1097 1191 1097 1371 1108 1373 1108 1375 1108 1378 1108 1393 1097 1733 1106 1735 1106 1737 1106 1759 1095 1845 1106 1847 1106 1928 1095 2014 1106 2016 1106 2019 1106 2021 1106 2036 1095 2105 1106 2107 1106 2109 1106 2112 1106 2127 1093 2127 1078 2125 1050 2075 1037 2073 1037 2071 1037 2068 1037 2042 1048 1971 1037 1969 1037 1967 1037 1964 1037 1947 1050 1735 1050 1666 1037 1663 1037 1533 1050 1516 1039 1514 1039 1512 1039 1510 1039 1362 1050 1302 1039 1300 1039 1297 1039 1265 1050 1154 1039 1152 1039 1150 1039 1120 1050 1070 1039 1068 1039 999 1050 968 1039 966 1039 964 1039 962 1039 960 1039 938 1054 780 1054 765 1041 762 1041 760 1041 758 1041 680 1052 656 1041 654 1041 652 1041 353 1050 355 1084"/>
                        </Shape>
                        <String CONTENT="it as the Koryak name for the Yukaghir, which certainly agrees with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l8" HPOS="355" VPOS="1112" WIDTH="1226" HEIGHT="48" BASELINE="355 1143 1581 1143" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1143 355 1160 1581 1160 1581 1143 1581 1112 355 1112 355 1143"/>
                        </Shape>
                        <String CONTENT="data I have already given concerning the Chuvantzy."/>
                    </TextLine>
<TextLine ID="mz_1-039_l9" HPOS="461" VPOS="1158" WIDTH="1668" HEIGHT="67" BASELINE="464 1206 2129 1201" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 1206 464 1216 2079 1225 2081 1225 2084 1225 2129 1212 2129 1201 2127 1171 2097 1158 2094 1158 2092 1158 2090 1158 2062 1169 1954 1158 1951 1158 1902 1169 1878 1158 1876 1158 1873 1158 1871 1158 1837 1169 1800 1158 1798 1158 1795 1158 1793 1158 1791 1158 1778 1171 1681 1171 1648 1158 1646 1158 1644 1158 1538 1169 1510 1158 1507 1158 1505 1158 1503 1158 1501 1158 1486 1169 1380 1158 1378 1158 1315 1169 1300 1158 1297 1158 1295 1158 1293 1158 1291 1158 1265 1171 1178 1160 1176 1160 1174 1160 1152 1171 1137 1160 1135 1160 1133 1160 1131 1160 1035 1171 940 1160 938 1160 936 1160 910 1171 882 1160 879 1160 877 1160 825 1173 518 1173 500 1160 498 1160 496 1160 494 1160 492 1160 461 1169 464 1206"/>
                        </Shape>
                        <String CONTENT="In contrast to all these Taˊn˙ñɪt, the Chukchee often call the Koryak"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l10" HPOS="351" VPOS="1216" WIDTH="1776" HEIGHT="65" BASELINE="353 1266 2127 1260" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 1266 353 1281 2125 1275 2127 1260 2122 1227 1949 1216 1947 1216 1945 1216 1943 1216 1928 1229 1830 1229 1806 1216 1804 1216 1802 1216 1800 1216 1798 1216 1778 1229 1614 1229 1590 1216 1588 1216 1585 1216 1518 1232 1235 1232 1202 1219 1200 1219 1198 1219 1196 1219 1163 1229 1120 1219 1118 1219 1115 1219 1113 1219 1087 1229 1074 1219 1072 1219 1070 1219 1068 1219 973 1229 877 1221 875 1221 873 1221 871 1221 858 1232 801 1221 799 1221 797 1221 760 1232 674 1221 672 1221 669 1221 626 1232 576 1221 574 1221 351 1227 353 1266"/>
                        </Shape>
                        <String CONTENT="Lɪˊê-taˊn˙ñɪt (“genuine Taˊn˙ñɪt”) in the same way, perhaps, as they call them-"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l11" HPOS="353" VPOS="1281" WIDTH="1774" HEIGHT="59" BASELINE="355 1325 2127 1320" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1325 355 1340 2125 1335 2127 1320 2122 1290 405 1281 403 1281 353 1292 355 1325"/>
                        </Shape>
                        <String CONTENT="selves “genuine men.” As to the meaning of the word Taˊn˙ñɪtan, no explanation"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l12" HPOS="353" VPOS="1340" WIDTH="1772" HEIGHT="60" BASELINE="355 1385 2125 1381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1385 355 1400 2122 1396 2125 1381 2120 1351 1239 1340 1237 1340 1185 1351 435 1342 433 1342 353 1353 355 1385"/>
                        </Shape>
                        <String CONTENT="could be obtained, and there is no existing Chukchee or Koryak root akin to"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l13" HPOS="355" VPOS="1398" WIDTH="1770" HEIGHT="65" BASELINE="357 1448 2125 1442" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1448 357 1461 2120 1463 2125 1442 2120 1409 1546 1398 1544 1398 1451 1411 355 1411 357 1448"/>
                        </Shape>
                        <String CONTENT="it. J. Murdoch says that even the Point Barrow Eskimo use the word taˊnning"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l14" HPOS="355" VPOS="1459" WIDTH="1280" HEIGHT="71" BASELINE="357 1504 1635 1498" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1504 357 1517 544 1530 546 1530 548 1530 591 1519 756 1528 758 1528 760 1528 784 1517 996 1517 1012 1528 1014 1528 1016 1528 1018 1528 1020 1528 1063 1517 1098 1528 1100 1528 1102 1528 1105 1528 1137 1517 1497 1526 1499 1526 1553 1515 1616 1526 1618 1526 1620 1526 1622 1526 1635 1513 1635 1498 1631 1459 1206 1459 1204 1459 1202 1459 1165 1470 788 1461 786 1461 784 1461 782 1461 782 1463 780 1463 773 1472 477 1463 474 1463 355 1474 357 1504"/>
                        </Shape>
                        <String CONTENT="or taˊngin for the Russians or for ships which pass by.³"/>
                    </TextLine>
<TextLine ID="mz_1-039_l15" HPOS="459" VPOS="1519" WIDTH="1668" HEIGHT="63" BASELINE="461 1563 2127 1558" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 1563 461 1582 2125 1578 2127 1558 2122 1528 481 1519 479 1519 477 1519 474 1519 459 1526 461 1563"/>
                        </Shape>
                        <String CONTENT="On the Pacific shore the Russians are called also Ruˊssilɪt (from the English"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l16" HPOS="360" VPOS="1578" WIDTH="251" HEIGHT="69" BASELINE="362 1619 611 1623" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1619 360 1634 394 1647 396 1647 399 1647 609 1639 611 1623 611 1589 585 1578 583 1578 581 1578 522 1589 507 1578 505 1578 503 1578 362 1578 362 1619"/>
                        </Shape>
                        <String CONTENT="“Russian”)."/>
                    </TextLine>
<TextLine ID="mz_1-039_l17" HPOS="461" VPOS="1636" WIDTH="1664" HEIGHT="70" BASELINE="464 1682 2125 1686" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 1682 461 1693 492 1706 494 1706 496 1706 2122 1701 2125 1686 2125 1652 2081 1639 2079 1639 2077 1639 1672 1649 1542 1639 1540 1639 1471 1649 1410 1639 1408 1639 1406 1639 1378 1649 1332 1639 1330 1639 1328 1639 1326 1639 1302 1649 1274 1636 1271 1636 1269 1636 1187 1647 1172 1636 1170 1636 1167 1636 1165 1636 464 1645 464 1682"/>
                        </Shape>
                        <String CONTENT="American whalers are called Leluˊᵋtvɪlɪt (from leluˊᵋtvᴇt, “ship;” literally,"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l18" HPOS="364" VPOS="1710" WIDTH="1763" HEIGHT="50" BASELINE="364 1742 2127 1742" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="364 1742 364 1760 2127 1760 2127 1742 2125 1710 364 1710 364 1742"/>
                        </Shape>
                        <String CONTENT="“whisker-boat;” though no reason is assigned why a ship should be associated"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l19" HPOS="357" VPOS="1758" WIDTH="1768" HEIGHT="62" BASELINE="360 1805 2125 1801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1805 360 1820 2122 1816 2125 1801 2122 1771 2092 1758 2090 1758 2088 1758 2086 1758 2051 1768 1895 1758 1893 1758 1839 1768 1817 1758 1815 1758 1813 1758 1811 1758 1769 1768 1724 1758 1722 1758 1720 1758 1718 1758 1715 1758 1698 1768 1618 1758 1616 1758 1614 1758 1592 1768 1562 1758 1559 1758 1557 1758 1269 1768 1243 1758 1241 1758 1239 1758 1165 1771 999 1760 996 1760 921 1771 897 1760 895 1760 892 1760 806 1771 762 1760 760 1760 758 1760 756 1760 715 1771 680 1760 678 1760 676 1760 596 1771 509 1760 507 1760 505 1760 457 1771 403 1760 401 1760 399 1760 357 1773 360 1805"/>
                        </Shape>
                        <String CONTENT="with whiskers [perhaps the whiskers of the crews were included in the definition])."/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l20" HPOS="360" VPOS="1820" WIDTH="1769" HEIGHT="63" BASELINE="360 1862 2129 1862" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 1862 360 1883 2129 1883 2129 1862 2129 1833 2008 1820 2006 1820 2003 1820 1958 1831 1928 1820 1925 1820 1923 1820 1609 1831 1546 1820 1544 1820 1542 1820 1516 1831 1403 1820 1401 1820 1343 1831 1300 1820 1297 1820 1295 1820 1293 1820 1274 1831 1258 1820 1256 1820 1254 1820 1144 1820 1141 1820 1050 1831 1022 1820 1020 1820 1018 1820 1016 1820 1014 1820 994 1833 838 1833 812 1820 810 1820 808 1820 752 1831 708 1820 706 1820 704 1820 702 1820 663 1831 635 1820 633 1820 630 1820 535 1831 505 1820 503 1820 500 1820 418 1831 379 1820 377 1820 375 1820 373 1820 370 1820 360 1827 360 1862"/>
                        </Shape>
                        <String CONTENT="Sometimes the Russians are also called Leˊlu-reˊmkɪn (“bearded people”), whence"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l21" HPOS="355" VPOS="1883" WIDTH="1776" HEIGHT="56" BASELINE="357 1927 2131 1920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1927 357 1939 2131 1933 2131 1920 2127 1890 381 1883 379 1883 377 1883 355 1892 357 1927"/>
                        </Shape>
                        <String CONTENT="the Asiatic Eskimo term laˊlo-reˊmka. Americans also are called Pnauˊkulɪt"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l22" HPOS="355" VPOS="1937" WIDTH="1772" HEIGHT="76" BASELINE="357 1985 2127 1978" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1985 357 2002 602 2013 604 2013 607 2013 643 2002 674 2013 676 2013 678 2013 680 2013 682 2013 697 2002 825 2002 864 2013 866 2013 869 2013 960 2000 1046 2011 1048 2011 1050 2011 1076 2000 1196 2000 1211 2011 1213 2011 1215 2011 1217 2011 1460 2000 1516 2011 1518 2011 2125 1996 2127 1978 2122 1950 1951 1937 1949 1937 1947 1937 1945 1937 1930 1950 1826 1950 1772 1937 1769 1937 1767 1937 1765 1937 1748 1950 1616 1950 1583 1937 1581 1937 1579 1937 1525 1948 1445 1939 1442 1939 1440 1939 1438 1939 1423 1950 1098 1939 1096 1939 1042 1950 960 1939 957 1939 955 1939 925 1952 375 1942 373 1942 370 1942 368 1942 355 1950 357 1985"/>
                        </Shape>
                        <String CONTENT="(“file-mongers,” from pnauˊkun, “file” [literally, “whetting-stone”]); or they are"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l23" HPOS="355" VPOS="2000" WIDTH="1152" HEIGHT="61" BASELINE="357 2046 1507 2041" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2046 357 2061 1505 2056 1507 2041 1503 2011 953 2000 951 2000 877 2011 490 2002 487 2002 355 2013 357 2046"/>
                        </Shape>
                        <String CONTENT="sometimes called even Taˊn˙ñɪt, like the Russians."/>
                    </TextLine>
<TextLine ID="mz_1-039_l24" HPOS="461" VPOS="2059" WIDTH="1668" HEIGHT="62" BASELINE="464 2104 2129 2100" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="464 2104 464 2121 2127 2117 2129 2100 2125 2072 1854 2059 1852 2059 1850 2059 1806 2069 1785 2059 1782 2059 1780 2059 1668 2069 1592 2059 1590 2059 1588 2059 1549 2069 1523 2059 1520 2059 1518 2059 1453 2069 1425 2059 1423 2059 1421 2059 1354 2069 1295 2059 1293 2059 1291 2059 1289 2059 1271 2072 1204 2061 1202 2061 901 2072 873 2061 871 2061 869 2061 866 2061 825 2072 754 2061 752 2061 749 2061 747 2061 734 2074 537 2074 474 2061 472 2061 470 2061 468 2061 468 2063 461 2067 464 2104"/>
                        </Shape>
                        <String CONTENT="The eastern branch of the Maritime Koryak, who live on the Pacific coast"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l25" HPOS="353" VPOS="2128" WIDTH="1776" HEIGHT="52" BASELINE="355 2165 2129 2160" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2165 355 2180 2127 2175 2129 2160 2122 2128 353 2130 355 2165"/>
                        </Shape>
                        <String CONTENT="from Cape Anannon to Cape Barykoff, are called Keˊrek. The origin of this"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l26" HPOS="353" VPOS="2182" WIDTH="1769" HEIGHT="58" BASELINE="355 2225 2122 2219" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2225 355 2240 2120 2234 2122 2219 2118 2191 988 2182 986 2182 934 2193 505 2184 503 2184 353 2195 355 2225"/>
                        </Shape>
                        <String CONTENT="name is unknown. It can hardly have anything in common with Koryak, —"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l27" HPOS="355" VPOS="2243" WIDTH="1774" HEIGHT="58" BASELINE="357 2288 2129 2284" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2288 357 2301 2127 2297 2129 2284 2125 2253 1406 2243 1403 2243 355 2256 357 2288"/>
                        </Shape>
                        <String CONTENT="a name created by the Cossacks from qoraˊkɪ, of the southeastern Koryak"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l28" HPOS="355" VPOS="2301" WIDTH="1023" HEIGHT="61" BASELINE="357 2347 1378 2342" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 2347 357 2362 1375 2357 1378 2342 1373 2301 864 2301 862 2301 860 2301 858 2301 858 2303 847 2312 379 2303 377 2303 375 2303 355 2312 357 2347"/>
                        </Shape>
                        <String CONTENT="dialect, which means “(being) with reindeer.”"/>
                    </TextLine>
<TextLine ID="mz_1-039_l29" HPOS="464" VPOS="2357" WIDTH="1665" HEIGHT="65" BASELINE="466 2407 2129 2401" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="466 2407 466 2422 2127 2416 2129 2401 2125 2370 2045 2357 2042 2357 2040 2357 2038 2357 2021 2368 1997 2357 1995 2357 1993 2357 1852 2368 1733 2357 1731 2357 1728 2357 1689 2368 1605 2357 1603 2357 1601 2357 1566 2370 1180 2360 1178 2360 1176 2360 1174 2360 1154 2372 464 2372 466 2407"/>
                        </Shape>
                        <String CONTENT="Both Lamut and Tungus are called qaˊa-raˊmkɪt, which signifies “Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l30" HPOS="353" VPOS="2422" WIDTH="1774" HEIGHT="63" BASELINE="355 2468 2127 2463" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2468 355 2485 2125 2485 2127 2463 2122 2431 403 2422 401 2422 399 2422 353 2433 355 2468"/>
                        </Shape>
                        <String CONTENT="tribe.” More strictly speaking, the Lamut are also called qor-êmtêˊ-qaˊa-raˊmkɪt,"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l31" HPOS="357" VPOS="2479" WIDTH="1776" HEIGHT="69" BASELINE="360 2526 2133 2520" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2526 360 2539 1538 2548 1540 2548 1614 2537 2109 2546 2112 2546 2114 2546 2116 2546 2133 2535 2133 2520 2127 2485 1744 2489 1666 2479 1663 2479 1505 2492 1447 2481 1445 2481 1388 2492 1360 2481 1358 2481 1356 2481 1354 2481 1319 2492 1302 2481 1300 2481 1297 2481 1295 2481 1217 2492 1180 2481 1178 2481 1176 2481 1174 2481 1137 2492 1100 2481 1098 2481 1096 2481 990 2492 953 2481 951 2481 949 2481 947 2481 944 2481 931 2492 743 2483 741 2483 652 2494 455 2483 453 2483 357 2496 360 2526"/>
                        </Shape>
                        <String CONTENT="or “reindeer-carried Reindeer tribe;” and the Tungus of the tundra west of"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l32" HPOS="357" VPOS="2539" WIDTH="1770" HEIGHT="65" BASELINE="360 2587 2127 2583" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2587 360 2602 2122 2604 2127 2583 2122 2552 2053 2539 2051 2539 2049 2539 2029 2550 2008 2539 2006 2539 2003 2539 2001 2539 1969 2550 1912 2539 1910 2539 1702 2550 1611 2539 1609 2539 1438 2550 1378 2539 1375 2539 1373 2539 1343 2550 1243 2539 1241 2539 1239 2539 1237 2539 1215 2552 1139 2541 1137 2541 1135 2541 1111 2552 1089 2541 1087 2541 1085 2541 999 2552 953 2541 951 2541 949 2541 947 2541 914 2552 873 2541 871 2541 869 2541 793 2552 710 2541 708 2541 357 2550 360 2587"/>
                        </Shape>
                        <String CONTENT="Kolyma, together with the Reindeer Yukaghir, are called oˊrwu-qaˊa-raˊmkɪt,"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l33" HPOS="357" VPOS="2602" WIDTH="1772" HEIGHT="58" BASELINE="360 2645 2129 2641" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2645 360 2660 2127 2656 2129 2641 2125 2611 457 2602 455 2602 357 2613 360 2645"/>
                        </Shape>
                        <String CONTENT="or “sledge Reindeer tribe,” because they travel with sledges. The Yukaghir"/>
                    </TextLine>

                    <TextLine ID="mz_1-039_l34" HPOS="360" VPOS="2663" WIDTH="1769" HEIGHT="58" BASELINE="360 2704 2129 2704" TAGREFS="TYPE_5">
