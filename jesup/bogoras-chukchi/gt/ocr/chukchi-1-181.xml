                <TextBlock ID="text_1-181" HPOS="377" VPOS="602" WIDTH="1782" HEIGHT="2647"><TextLine ID="mz_1-181_l1" HPOS="953" VPOS="602" WIDTH="619" HEIGHT="54" BASELINE="953 636 1572 636" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="953 636 953 656 1572 656 1572 636 1572 602 953 602 953 636"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l2" HPOS="2053" VPOS="608" WIDTH="85" HEIGHT="56" BASELINE="2058 649 2138 645" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2120 612 2099 610 2077 610 2066 608 2053 608 2058 649 2058 664 2135 664 2138 645 2131 612 2120 612"/>
                        </Shape>
                        <String CONTENT="139"/>
                    </TextLine>
<TextLine ID="mz_1-181_l3" HPOS="379" VPOS="716" WIDTH="1772" HEIGHT="46" BASELINE="379 747 2151 747" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 747 379 762 2151 762 2151 747 2151 716 379 716 379 747"/>
                        </Shape>
                        <String CONTENT="the owner, and when visited may occasionally strike him on the feet, since"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l4" HPOS="377" VPOS="766" WIDTH="1771" HEIGHT="56" BASELINE="379 807 2148 803" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 807 379 822 2146 818 2148 803 2144 775 451 766 448 766 377 777 379 807"/>
                        </Shape>
                        <String CONTENT="under the snow it is not easy to ascertain the actual place of the releasing-"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l5" HPOS="377" VPOS="833" WIDTH="522" HEIGHT="61" BASELINE="379 863 899 868" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 863 377 883 388 892 390 892 392 892 394 892 637 881 832 894 834 894 897 881 899 868 897 838 379 833 379 863"/>
                        </Shape>
                        <String CONTENT="string and the trigger."/>
                    </TextLine>
<TextLine ID="mz_1-181_l6" HPOS="485" VPOS="883" WIDTH="1663" HEIGHT="61" BASELINE="485 928 2148 928" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="485 928 485 941 2146 944 2148 928 2148 896 1925 883 1923 883 1921 883 1919 883 1904 896 1789 896 1765 883 1763 883 1761 883 1759 883 1756 883 1741 894 1715 883 1713 883 1711 883 1709 883 1685 894 1635 883 1633 883 1557 894 1501 883 1499 883 1442 894 1419 883 1416 883 1414 883 1412 883 1386 894 1330 883 1328 883 1326 883 1291 894 1230 883 1228 883 1226 883 1189 896 918 896 895 883 892 883 890 883 834 894 775 883 773 883 771 883 747 894 706 883 704 883 702 883 641 894 617 883 615 883 613 883 559 894 507 883 505 883 503 883 500 883 485 892 485 928"/>
                        </Shape>
                        <String CONTENT="On the Pacific shore some native blacksmiths, Chukchee and Eskimo,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l7" HPOS="379" VPOS="954" WIDTH="1767" HEIGHT="50" BASELINE="381 989 2146 985" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 989 381 1004 2144 1004 2146 985 2142 954 379 954 381 989"/>
                        </Shape>
                        <String CONTENT="hammer traps of their own out of the bar-iron bought from whalers. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l8" HPOS="379" VPOS="1015" WIDTH="1767" HEIGHT="52" BASELINE="379 1050 2146 1050" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1050 379 1063 2142 1067 2146 1050 2144 1017 379 1015 379 1050"/>
                        </Shape>
                        <String CONTENT="have usually but one spring; since traps with two springs work too strongly,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l9" HPOS="377" VPOS="1061" WIDTH="1771" HEIGHT="67" BASELINE="379 1110 2148 1104" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="379 1110 379 1123 2144 1128 2148 1104 2144 1073 1971 1073 1947 1061 1945 1061 1943 1061 1865 1071 1837 1061 1834 1061 1832 1061 1774 1071 1750 1061 1748 1061 1746 1061 1744 1061 1741 1061 1724 1071 1670 1061 1668 1061 1666 1061 1642 1071 1616 1061 1614 1061 1611 1061 1609 1061 1588 1071 1559 1061 1557 1061 1555 1061 1553 1061 1520 1073 1222 1063 1219 1063 1217 1063 1180 1073 1150 1063 1148 1063 1146 1063 1055 1073 1018 1063 1016 1063 1014 1063 938 1076 524 1065 522 1065 520 1065 487 1076 453 1065 451 1065 448 1065 377 1078 379 1110"/>
                        </Shape>
                        <String CONTENT="and often cut off the paw, instead of holding it. Both kinds of spring-traps,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l10" HPOS="381" VPOS="1125" WIDTH="1770" HEIGHT="59" BASELINE="381 1169 2151 1169" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1169 381 1182 2148 1184 2151 1169 2151 1138 2029 1125 2027 1125 2025 1125 1990 1136 1642 1125 1640 1125 1557 1136 1527 1125 1525 1125 1523 1125 1466 1136 1432 1125 1429 1125 1427 1125 1425 1125 1399 1136 1367 1125 1365 1125 1362 1125 1176 1136 1161 1125 1159 1125 1157 1125 1022 1125 1020 1125 1018 1125 992 1138 754 1138 719 1125 717 1125 715 1125 713 1125 691 1136 639 1125 637 1125 635 1125 596 1136 505 1125 503 1125 500 1125 498 1125 483 1138 381 1138 381 1169"/>
                        </Shape>
                        <String CONTENT="especially the larger ones of steel, are used also for other animals, — hares,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l11" HPOS="379" VPOS="1184" WIDTH="1772" HEIGHT="61" BASELINE="381 1229 2151 1223" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1229 381 1245 2148 1238 2151 1223 2146 1195 1559 1184 1557 1184 1505 1195 442 1188 440 1188 379 1199 381 1229"/>
                        </Shape>
                        <String CONTENT="wolverines, wolves, and even swans and geese. When set for the wolf, the"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l12" HPOS="379" VPOS="1245" WIDTH="1769" HEIGHT="69" BASELINE="381 1290 2148 1286" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1290 381 1303 596 1314 598 1314 600 1314 602 1314 617 1303 905 1303 957 1314 960 1314 1066 1303 1209 1314 1211 1314 1213 1314 1215 1314 1228 1303 1245 1312 1248 1312 1250 1312 1356 1301 1674 1301 1715 1312 1718 1312 1720 1312 2146 1299 2148 1286 2144 1255 1265 1245 1263 1245 1261 1245 1237 1255 416 1247 414 1247 412 1247 379 1258 381 1290"/>
                        </Shape>
                        <String CONTENT="steel trap is fastened with a strong chain to a wooden block weighing from"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l13" HPOS="379" VPOS="1305" WIDTH="1769" HEIGHT="63" BASELINE="381 1348 2148 1344" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1348 381 1364 2144 1368 2148 1344 2144 1316 1274 1305 1271 1305 1269 1305 1267 1305 1252 1316 399 1307 396 1307 394 1307 392 1307 379 1314 381 1348"/>
                        </Shape>
                        <String CONTENT="twenty to twenty-five pounds, so that the wolf may be able to drag it along"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l14" HPOS="379" VPOS="1366" WIDTH="1772" HEIGHT="58" BASELINE="381 1409 2151 1403" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1409 381 1424 2148 1418 2151 1403 2146 1374 970 1366 968 1366 912 1377 487 1368 485 1368 379 1379 381 1409"/>
                        </Shape>
                        <String CONTENT="on the snow. If the block should be too heavy, the wolf would snap the"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l15" HPOS="379" VPOS="1426" WIDTH="1772" HEIGHT="57" BASELINE="381 1468 2151 1463" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1468 381 1483 2148 1478 2151 1463 2146 1435 409 1426 407 1426 405 1426 379 1435 381 1468"/>
                        </Shape>
                        <String CONTENT="chain and carry away the trap. Sometimes the wolf that carried away the"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l16" HPOS="381" VPOS="1498" WIDTH="1767" HEIGHT="50" BASELINE="381 1528 2148 1528" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1528 381 1543 2144 1548 2148 1528 2146 1498 381 1498 381 1528"/>
                        </Shape>
                        <String CONTENT="trap is able to live for several months on the tundra, preying on hares, moulting"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l17" HPOS="379" VPOS="1552" WIDTH="1774" HEIGHT="58" BASELINE="381 1582 2153 1587" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1582 379 1600 392 1608 394 1608 396 1608 399 1608 1232 1600 1269 1610 1271 1610 1274 1610 2151 1600 2153 1587 2153 1552 381 1552 381 1582"/>
                        </Shape>
                        <String CONTENT="ducks, etc. Once in the winter I was shown, on the fresh trail of several"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l18" HPOS="381" VPOS="1617" WIDTH="1772" HEIGHT="48" BASELINE="381 1647 2153 1647" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1647 381 1665 2153 1665 2153 1647 2153 1617 381 1617 381 1647"/>
                        </Shape>
                        <String CONTENT="wolves, the footsteps of one that evidently had only three paws; the fourth"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l19" HPOS="381" VPOS="1662" WIDTH="1774" HEIGHT="72" BASELINE="383 1710 2155 1704" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 1710 383 1734 2153 1719 2155 1704 2151 1675 2081 1662 2079 1662 2077 1662 2049 1673 1977 1662 1975 1662 1973 1662 1971 1662 1956 1675 1763 1675 1735 1662 1733 1662 1731 1662 1728 1662 1685 1673 1635 1662 1633 1662 1538 1675 1484 1665 1481 1665 1479 1665 1458 1675 1434 1665 1432 1665 1429 1665 1243 1675 1213 1665 1211 1665 1209 1665 1118 1675 1102 1665 1100 1665 1098 1665 977 1665 975 1665 910 1678 581 1667 578 1667 381 1680 383 1710"/>
                        </Shape>
                        <String CONTENT="paw probably having withered, and dropped down with the trap. Another"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l20" HPOS="379" VPOS="1725" WIDTH="1774" HEIGHT="59" BASELINE="381 1768 2153 1764" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1768 381 1784 2151 1779 2153 1764 2148 1736 1267 1725 1265 1725 1191 1736 405 1727 403 1727 401 1727 379 1736 381 1768"/>
                        </Shape>
                        <String CONTENT="time a trap carried away by a wolf in the fall was found in the spring far"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l21" HPOS="379" VPOS="1784" WIDTH="1360" HEIGHT="67" BASELINE="381 1825 1739 1829" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1825 379 1842 390 1851 392 1851 394 1851 396 1851 1737 1842 1739 1829 1739 1799 1713 1786 1711 1786 1709 1786 1707 1786 1676 1797 1646 1786 1644 1786 1642 1786 1165 1797 1111 1786 1109 1786 1107 1786 1061 1797 1014 1784 1012 1784 1009 1784 1007 1784 977 1794 944 1784 942 1784 940 1784 862 1794 782 1784 780 1784 726 1797 639 1797 626 1784 624 1784 622 1784 620 1784 617 1784 591 1794 539 1784 537 1784 535 1784 533 1784 513 1794 381 1794 381 1825"/>
                        </Shape>
                        <String CONTENT="away in the tundra, with the withered paw of a wolf in it."/>
                    </TextLine>
<TextLine ID="mz_1-181_l22" HPOS="485" VPOS="1844" WIDTH="1668" HEIGHT="61" BASELINE="487 1890 2153 1885" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="487 1890 487 1905 2151 1903 2153 1885 2148 1855 1319 1844 1317 1844 1315 1844 1269 1855 498 1846 496 1846 494 1846 492 1846 492 1849 485 1853 487 1890"/>
                        </Shape>
                        <String CONTENT="Dead-falls are used only by a few Chukchee, in imitation of the Russians,"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l23" HPOS="379" VPOS="1907" WIDTH="1774" HEIGHT="58" BASELINE="381 1950 2153 1944" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 1950 381 1965 2151 1959 2153 1944 2148 1916 973 1907 970 1907 968 1907 931 1918 420 1909 418 1909 416 1909 379 1920 381 1950"/>
                        </Shape>
                        <String CONTENT="who have large rows of them everywhere in the forest and on the tundra."/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l24" HPOS="379" VPOS="1963" WIDTH="1776" HEIGHT="63" BASELINE="381 2011 2155 2004" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2011 381 2026 2153 2020 2155 2004 2153 1976 2125 1963 2122 1963 2120 1963 1802 1974 1759 1963 1756 1963 1754 1963 1752 1963 1711 1974 1679 1963 1676 1963 1674 1963 1557 1976 1362 1965 1360 1965 1308 1976 1282 1965 1280 1965 1278 1965 1276 1965 1252 1978 1040 1978 1003 1965 1001 1965 999 1965 996 1965 962 1976 838 1968 836 1968 834 1968 832 1968 817 1978 505 1968 503 1968 500 1968 459 1978 396 1968 394 1968 392 1968 390 1968 379 1976 381 2011"/>
                        </Shape>
                        <String CONTENT="On the Chukchee Peninsula, among the Maritime people, however, wood is"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l25" HPOS="379" VPOS="2030" WIDTH="1776" HEIGHT="57" BASELINE="381 2072 2155 2063" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="381 2072 381 2087 2153 2078 2155 2063 2151 2035 399 2030 396 2030 394 2030 392 2030 379 2037 381 2072"/>
                        </Shape>
                        <String CONTENT="too scarce for constructing dead-falls; and the Reindeer Chukchee in other"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l26" HPOS="381" VPOS="2087" WIDTH="1774" HEIGHT="69" BASELINE="383 2132 2155 2126" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2132 383 2156 2153 2141 2155 2126 2151 2098 1601 2087 1598 2087 1518 2098 466 2091 464 2091 381 2102 383 2132"/>
                        </Shape>
                        <String CONTENT="parts of the country do not care very much about them, since they are not"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l27" HPOS="386" VPOS="2147" WIDTH="582" HEIGHT="59" BASELINE="386 2191 968 2191" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 2191 386 2206 968 2206 968 2191 968 2160 533 2147 531 2147 529 2147 526 2147 509 2160 386 2160 386 2191"/>
                        </Shape>
                        <String CONTENT="very skilful with the axe."/>
                    </TextLine>
<TextLine ID="mz_1-181_l28" HPOS="494" VPOS="2201" WIDTH="1665" HEIGHT="74" BASELINE="496 2253 2159 2243" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="496 2253 496 2266 1133 2275 1135 2275 1222 2264 1795 2271 1798 2271 2157 2258 2159 2243 2153 2208 1863 2212 1837 2201 1834 2201 1832 2201 1830 2201 1828 2201 1813 2214 1739 2204 1737 2204 1735 2204 1707 2214 1679 2204 1676 2204 1674 2204 1605 2214 1577 2204 1575 2204 1572 2204 1570 2204 1544 2214 1440 2206 1438 2206 1323 2217 1295 2206 1293 2206 1291 2206 1209 2217 1163 2206 1161 2206 1159 2206 1096 2219 1083 2208 1081 2208 1079 2208 903 2208 901 2208 899 2208 897 2208 882 2219 797 2210 795 2210 793 2210 791 2210 778 2221 509 2210 507 2210 505 2210 503 2210 503 2212 494 2219 496 2253"/>
                        </Shape>
                        <String CONTENT="A common fox dead-fall (Fig. 49) consists of a double fence made of"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l29" HPOS="381" VPOS="2266" WIDTH="1774" HEIGHT="63" BASELINE="383 2312 2155 2303" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 2312 383 2329 2153 2323 2155 2303 2151 2275 1276 2266 1274 2266 1271 2266 1269 2266 1256 2277 401 2271 399 2271 396 2271 394 2271 381 2277 383 2312"/>
                        </Shape>
                        <String CONTENT="thin poles ten feet long and two feet high, with a space between about two"/>
                    </TextLine>
<TextLine ID="mz_1-181_l30" HPOS="381" VPOS="2925" WIDTH="1778" HEIGHT="71" BASELINE="383 2981 2159 2968" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2135 2935 2133 2933 1904 2925 1902 2925 1899 2925 1845 2938 1694 2927 1692 2927 1689 2927 1687 2927 1672 2938 1544 2929 1542 2929 1462 2940 1447 2929 1445 2929 1442 2929 1332 2929 1330 2929 1328 2929 1300 2940 1278 2929 1276 2929 1274 2929 1271 2929 1269 2929 1252 2942 1092 2931 1089 2931 1033 2942 973 2931 970 2931 968 2931 966 2931 951 2944 892 2933 890 2933 814 2944 797 2933 795 2933 793 2933 676 2933 674 2933 672 2933 669 2933 654 2946 396 2935 394 2935 392 2935 390 2935 381 2940 383 2981 383 2996 2157 2983 2159 2968 2155 2948 2135 2935"/>
                        </Shape>
                        <String CONTENT="feet and a half broad. The flooring is laid loosely; and the roof is formed"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l31" HPOS="383" VPOS="3000" WIDTH="1776" HEIGHT="61" BASELINE="386 3041 2159 3028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 3041 386 3061 1863 3061 1863 3059 1865 3059 1867 3059 1867 3057 1878 3048 2157 3048 2159 3028 2153 3000 383 3011 386 3041"/>
                        </Shape>
                        <String CONTENT="of two or three strong beams split at the front end, and having a cross-pole"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l32" HPOS="381" VPOS="3061" WIDTH="1776" HEIGHT="67" BASELINE="383 3102 2157 3089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="383 3102 383 3128 570 3117 667 3126 669 3126 672 3126 674 3126 687 3115 864 3126 866 3126 1217 3113 1265 3124 1267 3124 1269 3124 1271 3124 1310 3111 1339 3122 1341 3122 1343 3124 1553 3124 1553 3122 1555 3122 1603 3109 1821 3119 1824 3119 2155 3104 2157 3089 2151 3061 381 3070 383 3102"/>
                        </Shape>
                        <String CONTENT="jammed into the cleft. The rear end simply rests on the ground or on a"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l33" HPOS="383" VPOS="3124" WIDTH="1776" HEIGHT="67" BASELINE="386 3163 2159 3150" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 3163 386 3178 405 3189 407 3189 409 3191 548 3191 548 3189 550 3189 552 3189 568 3178 667 3189 669 3189 672 3189 674 3189 689 3176 918 3187 921 3187 1003 3174 1258 3184 1261 3184 1263 3184 1297 3171 1481 3182 1484 3182 1486 3182 1488 3182 1503 3171 1750 3180 1752 3180 1811 3169 1850 3180 1852 3180 1854 3180 1856 3180 1882 3167 2021 3178 2023 3178 2157 3165 2159 3150 2155 3124 403 3124 401 3124 399 3124 396 3124 383 3130 386 3163"/>
                        </Shape>
                        <String CONTENT="special, very low support. Sometimes a large stone is put on the roof to"/>
                    </TextLine>

                    <TextLine ID="mz_1-181_l34" HPOS="383" VPOS="3182" WIDTH="1772" HEIGHT="67" BASELINE="386 3221 1410 3226 2155 3210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="386 3221 386 3241 1395 3249 1397 3249 2155 3234 2155 3210 2148 3182 383 3191 386 3221"/>
                        </Shape>
                        <String CONTENT="make it heavier. The roof is quite free, and so fitted that in falling down"/>
                    </TextLine>
</TextBlock></PrintSpace>
        </Page>
