                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-212_l3" HPOS="319" VPOS="581" WIDTH="1766" HEIGHT="59" BASELINE="321 626 2085 622" TAGREFS="TYPE_5">
                        <Shape>
