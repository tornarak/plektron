                <TextBlock ID="text_3-081" HPOS="426" VPOS="478" WIDTH="1787" HEIGHT="2623"><TextLine ID="mz_3-081_l1" HPOS="1001" VPOS="480" WIDTH="624" HEIGHT="51" BASELINE="1003 515 1625 511" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1605 482 1598 480 1001 482 1001 484 1003 515 1003 531 1623 527 1625 511 1623 507 1605 482"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l2" HPOS="2104" VPOS="478" WIDTH="92" HEIGHT="59" BASELINE="2104 517 2196 517" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2182 488 2163 484 2143 482 2124 480 2114 478 2104 482 2104 517 2104 529 2194 537 2196 517 2196 490 2182 488"/>
                        </Shape>
                        <String CONTENT="615"/>
                    </TextLine>
<TextLine ID="mz_3-081_l3" HPOS="426" VPOS="580" WIDTH="1778" HEIGHT="56" BASELINE="428 622 2204 619" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="543 587 524 587 504 589 485 589 465 591 446 591 426 591 428 622 428 636 2202 632 2204 619 2200 591 1685 580 1683 580 1592 589 1561 580 1559 580 1557 580 1555 580 1533 589 1498 580 1496 580 1494 580 1399 589 1366 580 1364 580 1362 580 1360 580 1334 589 1319 580 1317 580 1315 580 1313 580 1311 580 1274 591 1241 581 1239 581 1237 581 1235 581 1202 591 1153 581 1151 581 849 591 789 581 787 581 785 581 783 581 767 593 664 593 555 587 543 587"/>
                        </Shape>
                        <String CONTENT="dependent on the master. The beginning of the relations between master"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l4" HPOS="428" VPOS="644" WIDTH="1257" HEIGHT="60" BASELINE="430 677 1685 683" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="430 677 428 695 438 702 440 702 442 702 444 702 806 695 849 704 851 704 853 704 1683 696 1685 683 1681 644 430 646 430 677"/>
                        </Shape>
                        <String CONTENT="and assistant is well described in the tale of Aiˊg̣ɪnto.¹"/>
                    </TextLine>
<TextLine ID="mz_3-081_l5" HPOS="539" VPOS="739" WIDTH="1665" HEIGHT="43" BASELINE="539 765 2204 765" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="539 765 539 782 2204 782 2204 765 2204 739 539 739 539 765"/>
                        </Shape>
                        <String CONTENT="“Then they continued their journey with dogs. At last they were without food. All their"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l6" HPOS="430" VPOS="784" WIDTH="1772" HEIGHT="45" BASELINE="432 813 2202 809" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="432 813 432 829 2200 827 2202 809 2196 784 430 786 432 813"/>
                        </Shape>
                        <String CONTENT="dogs had perished. They went afoot, drawing their sledges behind them. Almost all their strength"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l7" HPOS="432" VPOS="829" WIDTH="1770" HEIGHT="51" BASELINE="434 856 2202 860" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 856 432 872 444 880 446 880 448 880 450 880 2200 872 2202 860 2200 831 434 829 434 856"/>
                        </Shape>
                        <String CONTENT="was spent. At last they met a large reindeer-herd. One small boy herdsman was with the herd."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l8" HPOS="434" VPOS="878" WIDTH="1770" HEIGHT="43" BASELINE="434 905 2204 905" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 905 434 921 2202 921 2204 905 2202 880 434 878 434 905"/>
                        </Shape>
                        <String CONTENT="‘Oh, oh, guests! And who are you?’ — ‘We are people of Aiˊg̣ɪnto.’ — ‘Aha! at last we have"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l9" HPOS="432" VPOS="923" WIDTH="1768" HEIGHT="42" BASELINE="434 948 2200 952" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 948 432 963 2196 965 2200 952 2198 926 434 923 434 948"/>
                        </Shape>
                        <String CONTENT="found some companions on this earth. Come to our tent.’ — ‘But who is the oldest of all there?’ —"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l10" HPOS="434" VPOS="967" WIDTH="1772" HEIGHT="45" BASELINE="436 995 2206 999" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 995 434 1008 2202 1012 2206 999 2204 971 436 967 436 995"/>
                        </Shape>
                        <String CONTENT="‘The father, of course.’ — ‘But maybe he will say “I do not want them.” Let us rather stay here"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l11" HPOS="432" VPOS="1008" WIDTH="982" HEIGHT="51" BASELINE="434 1045 1414 1041" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1045 434 1059 1412 1055 1414 1041 1410 1010 442 1008 440 1008 438 1008 436 1008 436 1010 434 1010 432 1010 434 1045"/>
                        </Shape>
                        <String CONTENT="in this place.’ — ‘Then I shall go and ask the father.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l12" HPOS="543" VPOS="1059" WIDTH="1663" HEIGHT="49" BASELINE="545 1084 2206 1090" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="545 1084 543 1102 2202 1108 2206 1090 2204 1065 545 1059 545 1084"/>
                        </Shape>
                        <String CONTENT="“The old man lives in his tent with his wife and family. ‘There,’ says the son, ‘some guests"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l13" HPOS="432" VPOS="1110" WIDTH="1772" HEIGHT="44" BASELINE="434 1139 2204 1135" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1139 434 1154 2202 1154 2204 1135 2200 1112 432 1110 434 1139"/>
                        </Shape>
                        <String CONTENT="have come, quite unknown before.’ — ‘Where are they? Let them come in.’ — ‘They have"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l14" HPOS="432" VPOS="1154" WIDTH="1772" HEIGHT="55" BASELINE="434 1182 2204 1186" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1182 432 1195 1486 1209 1488 1209 2202 1199 2204 1186 2202 1158 434 1154 434 1182"/>
                        </Shape>
                        <String CONTENT="remained with the herd, saying, “Maybe thy father will say, ‘I do not want them.’”’ — ‘Oh, you"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l15" HPOS="432" VPOS="1205" WIDTH="1772" HEIGHT="43" BASELINE="434 1232 2204 1229" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1232 434 1246 2200 1248 2204 1229 2198 1205 432 1207 434 1232"/>
                        </Shape>
                        <String CONTENT="are the cause of the delay,’ says the old man. ‘Our companions-to-be are waiting in the open."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l16" HPOS="434" VPOS="1252" WIDTH="1772" HEIGHT="43" BASELINE="434 1277 2206 1277" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1277 434 1295 2206 1295 2206 1277 2206 1252 434 1252 434 1277"/>
                        </Shape>
                        <String CONTENT="Go back, and be quick!’ The boy sped back like an arrow shot from a bow. ‘The father chides"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l17" HPOS="436" VPOS="1299" WIDTH="1768" HEIGHT="41" BASELINE="436 1326 2204 1326" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1326 436 1338 2202 1340 2204 1326 2204 1299 436 1299 436 1326"/>
                        </Shape>
                        <String CONTENT="me for your error, and says, “Why have you not brought them all at once?”’ — ‘Eh, eh! then"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l18" HPOS="432" VPOS="1342" WIDTH="1772" HEIGHT="44" BASELINE="434 1369 2204 1373" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1369 432 1382 2200 1386 2204 1373 2202 1343 434 1342 434 1369"/>
                        </Shape>
                        <String CONTENT="let us go there.’ They came to the tent. Aiˊg̣ɪnto refused to enter, and told the children to stay"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l19" HPOS="436" VPOS="1392" WIDTH="1770" HEIGHT="41" BASELINE="436 1418 2206 1418" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1418 436 1431 2202 1433 2206 1418 2204 1392 436 1392 436 1418"/>
                        </Shape>
                        <String CONTENT="outside. ‘Maybe the old woman will look at us awry.’ Only the young herdsman has entered."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l20" HPOS="434" VPOS="1433" WIDTH="1774" HEIGHT="53" BASELINE="436 1458 2208 1464" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1458 434 1472 461 1484 463 1484 465 1484 949 1476 1028 1486 1030 1486 2206 1478 2208 1464 2206 1439 436 1433 436 1458"/>
                        </Shape>
                        <String CONTENT="‘Where are the guests?’ — They refuse to enter, saying, ‘Maybe the old woman will look at us"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l21" HPOS="432" VPOS="1484" WIDTH="1774" HEIGHT="45" BASELINE="434 1513 2206 1509" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1513 434 1529 2204 1529 2206 1509 2200 1484 432 1486 434 1513"/>
                        </Shape>
                        <String CONTENT="awry.’ — ‘Oh, oh! You old one, now you are the cause of the delay. Go out and make them"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l22" HPOS="434" VPOS="1529" WIDTH="1772" HEIGHT="43" BASELINE="436 1556 2206 1560" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1556 434 1568 2202 1572 2206 1560 2204 1533 436 1529 436 1556"/>
                        </Shape>
                        <String CONTENT="enter.’ The old woman went out. ‘Ah, ah! a woman guest has come. Quick, enter the sleeping-"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l23" HPOS="434" VPOS="1577" WIDTH="1776" HEIGHT="43" BASELINE="434 1605 2210 1605" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="434 1605 434 1620 2210 1620 2210 1605 2210 1577 434 1577 434 1605"/>
                        </Shape>
                        <String CONTENT="room!’ She took the snow-beater and dusted their clothes, shaking off the snow. ‘Go in.’ — ‘Let"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l24" HPOS="434" VPOS="1614" WIDTH="1772" HEIGHT="53" BASELINE="436 1653 2206 1648" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1653 436 1665 2202 1667 2206 1648 2200 1614 434 1626 436 1653"/>
                        </Shape>
                        <String CONTENT="the father enter first,’ says the master from within. Aiˊg̣ɪnto entered. ‘You came?’ — ‘Yes, I"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l25" HPOS="436" VPOS="1673" WIDTH="1772" HEIGHT="41" BASELINE="436 1698 2208 1698" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 1698 436 1712 2206 1714 2208 1698 2208 1673 436 1673 436 1698"/>
                        </Shape>
                        <String CONTENT="came!’² He showed him to the place of honor, opposite himself, by the other side of the lamp."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l26" HPOS="438" VPOS="1714" WIDTH="1770" HEIGHT="50" BASELINE="440 1741 2208 1745" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="440 1741 438 1753 465 1764 467 1764 469 1764 2206 1759 2208 1745 2206 1718 440 1714 440 1741"/>
                        </Shape>
                        <String CONTENT="‘Then let the sons of the guest enter.’ The boys entered. He made them sit down by his own"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l27" HPOS="436" VPOS="1761" WIDTH="1772" HEIGHT="44" BASELINE="438 1788 2208 1792" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="438 1788 436 1801 2204 1805 2208 1792 2206 1764 438 1761 438 1788"/>
                        </Shape>
                        <String CONTENT="side. ‘These shall be my own dear sons.’ — ‘And what shall I do (without sons),’ said Aiˊg̣ɪnto."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l28" HPOS="438" VPOS="1805" WIDTH="1770" HEIGHT="51" BASELINE="440 1833 2208 1839" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="440 1833 438 1844 465 1856 467 1856 469 1856 2206 1850 2208 1839 2206 1811 440 1805 440 1833"/>
                        </Shape>
                        <String CONTENT="‘Wait a little! Let my own son enter here.’ The boy entered. ‘This shall be thy son, since he"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l29" HPOS="438" VPOS="1854" WIDTH="1770" HEIGHT="45" BASELINE="438 1885 2208 1885" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="438 1885 438 1897 2204 1899 2208 1885 2206 1858 438 1854 438 1885"/>
                        </Shape>
                        <String CONTENT="brought thee here.’ — ‘All right,’ said Aiˊg̣ɪnto. ‘Mine are two sons, and thine only one. Let us"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l30" HPOS="438" VPOS="1895" WIDTH="992" HEIGHT="51" BASELINE="438 1928 1430 1928" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="438 1928 438 1946 1430 1946 1430 1928 1428 1895 438 1901 438 1928"/>
                        </Shape>
                        <String CONTENT="exchange, if food from thee is included in the bargain.’"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l31" HPOS="551" VPOS="1944" WIDTH="1660" HEIGHT="48" BASELINE="553 1971 2211 1977" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="553 1971 551 1987 2208 1992 2211 1977 2211 1946 553 1944 553 1971"/>
                        </Shape>
                        <String CONTENT="“Thus they began to live. All three boys were taking care of the herd. The old men staid"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l32" HPOS="434" VPOS="1987" WIDTH="189" HEIGHT="58" BASELINE="436 2024 623 2020" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 2024 436 2035 512 2045 514 2045 623 2031 623 2020 617 1987 434 1994 436 2024"/>
                        </Shape>
                        <String CONTENT="at home.”"/>
                    </TextLine>
<TextLine ID="mz_3-081_l33" HPOS="543" VPOS="2068" WIDTH="1668" HEIGHT="65" BASELINE="545 2109 2211 2113" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="545 2109 543 2121 569 2133 570 2133 572 2133 2210 2125 2211 2113 2210 2082 2001 2070 1999 2070 1907 2080 1837 2070 1835 2070 1752 2080 1687 2070 1685 2070 1683 2070 1656 2080 1596 2070 1594 2070 1592 2070 1566 2080 1225 2080 1212 2068 1210 2068 1208 2068 1206 2068 1120 2080 982 2080 968 2068 966 2068 964 2068 962 2068 960 2068 931 2078 853 2068 851 2068 849 2068 818 2078 798 2068 797 2068 795 2068 793 2068 767 2078 703 2068 701 2068 699 2068 670 2078 633 2068 631 2068 629 2068 545 2072 545 2109"/>
                        </Shape>
                        <String CONTENT="This description shows well how strong may be the desire of the master"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l34" HPOS="434" VPOS="2131" WIDTH="1774" HEIGHT="60" BASELINE="436 2174 2208 2170" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 2174 436 2185 2204 2191 2208 2170 2204 2143 1985 2131 1983 2131 1921 2141 1896 2131 1894 2131 1892 2131 1841 2141 1816 2131 1814 2131 1812 2131 1765 2141 1685 2131 1683 2131 1681 2131 1654 2143 1490 2143 1457 2131 1455 2131 1453 2131 1399 2141 1366 2131 1364 2131 1362 2131 1290 2143 1233 2133 1231 2133 1177 2143 1130 2133 1128 2133 1025 2143 876 2133 874 2133 631 2143 518 2133 516 2133 514 2133 491 2143 455 2133 454 2133 452 2133 450 2133 448 2133 434 2141 436 2174"/>
                        </Shape>
                        <String CONTENT="to have a new neighbor and assistant for the care of the herd. Of course,"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l35" HPOS="434" VPOS="2189" WIDTH="1776" HEIGHT="59" BASELINE="436 2230 2210 2234" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 2230 434 2242 2206 2248 2210 2234 2210 2201 2194 2191 2192 2191 2190 2191 2188 2191 2122 2201 2061 2191 2059 2191 2057 2191 2022 2201 1954 2191 1952 2191 1950 2191 1913 2201 1894 2191 1892 2191 1890 2191 1802 2201 1709 2191 1707 2191 1609 2201 1555 2191 1553 2191 1551 2191 1518 2203 1420 2203 1403 2191 1401 2191 1399 2191 1397 2191 1266 2199 1251 2189 1249 2189 1247 2189 1245 2189 1243 2189 1214 2199 1149 2189 1147 2189 1101 2199 1003 2189 1001 2189 863 2199 836 2189 834 2189 832 2189 830 2189 795 2199 773 2189 771 2189 769 2189 715 2199 666 2189 664 2189 662 2189 635 2199 545 2189 543 2189 436 2195 436 2230"/>
                        </Shape>
                        <String CONTENT="it gives the ideal conditions of such relations. It will be noted that the rich"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l36" HPOS="436" VPOS="2254" WIDTH="1775" HEIGHT="54" BASELINE="436 2291 2211 2291" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="436 2291 436 2304 2210 2308 2211 2291 2210 2254 436 2261 436 2291"/>
                        </Shape>
                        <String CONTENT="reindeer-owner and the poor new-comer meet in this tale on a quite equal"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l37" HPOS="438" VPOS="2318" WIDTH="1773" HEIGHT="49" BASELINE="440 2347 2211 2351" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="440 2347 438 2363 2208 2367 2211 2351 2210 2322 440 2318 440 2347"/>
                        </Shape>
                        <String CONTENT="footing, and then they live rather as two brothers than as master and dependent."/>
                    </TextLine>
<TextLine ID="mz_3-081_l38" HPOS="545" VPOS="2367" WIDTH="1665" HEIGHT="62" BASELINE="547 2408 2210 2413" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="547 2408 545 2421 2206 2429 2210 2413 2210 2382 2182 2371 2180 2371 2178 2371 2118 2380 2069 2371 2067 2371 1601 2378 1582 2369 1580 2369 1578 2369 1576 2369 1549 2378 1336 2369 1334 2369 1264 2378 1227 2369 1225 2369 1223 2369 1221 2369 1219 2369 1204 2378 1101 2367 1099 2367 1097 2367 1095 2367 1081 2376 1025 2367 1023 2367 968 2378 826 2378 810 2367 808 2367 806 2367 804 2367 802 2367 771 2378 691 2378 678 2367 676 2367 674 2367 672 2367 547 2374 547 2408"/>
                        </Shape>
                        <String CONTENT="Another tale concerning Eleˊndi and his sons describes the same relationship"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l39" HPOS="436" VPOS="2439" WIDTH="1775" HEIGHT="47" BASELINE="438 2468 2211 2472" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="438 2468 436 2482 2208 2486 2211 2472 2210 2443 438 2439 438 2468"/>
                        </Shape>
                        <String CONTENT="entered into between the master and his slave who was taken as a prisoner"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l40" HPOS="438" VPOS="2497" WIDTH="179" HEIGHT="55" BASELINE="440 2526 617 2530" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="440 2526 438 2542 448 2550 450 2550 452 2550 454 2550 512 2540 531 2552 533 2552 535 2552 537 2552 615 2540 617 2530 615 2501 440 2497 440 2526"/>
                        </Shape>
                        <String CONTENT="of war."/>
                    </TextLine>
<TextLine ID="mz_3-081_l41" HPOS="547" VPOS="2552" WIDTH="1666" HEIGHT="54" BASELINE="549 2587 2213 2591" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="549 2587 547 2602 2210 2606 2213 2591 2213 2554 549 2552 549 2587"/>
                        </Shape>
                        <String CONTENT="The tale describes how Eleˊndi sent his prisoner to the herd, and ordered"/>
                    </TextLine>
<TextLine ID="mz_3-081_l42" HPOS="551" VPOS="2675" WIDTH="631" HEIGHT="48" BASELINE="553 2700 1182 2704" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="553 2700 551 2712 625 2723 627 2723 1180 2716 1182 2704 1180 2678 553 2675 553 2700"/>
                        </Shape>
                        <String CONTENT="¹ Bogoras, Chukchee Materials, p. 263."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l43" HPOS="549" VPOS="2714" WIDTH="1664" HEIGHT="48" BASELINE="551 2739 2213 2747" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="551 2739 549 2754 2210 2762 2213 2747 2211 2721 551 2714 551 2739"/>
                        </Shape>
                        <String CONTENT="² “Yeˊtti?” (“You came?”) “Tiyeˊttyäᵋq!” (“I came!”) are the usual greetings of the Chukchee, which are"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l44" HPOS="442" VPOS="2758" WIDTH="1769" HEIGHT="47" BASELINE="444 2784 2211 2790" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="444 2784 442 2799 2208 2805 2211 2790 2210 2764 444 2758 444 2784"/>
                        </Shape>
                        <String CONTENT="exchanged when a man enters the sleeping-room. Good manners require these short formulas to be pronounced."/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l45" HPOS="444" VPOS="2801" WIDTH="1767" HEIGHT="47" BASELINE="446 2827 2211 2832" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="446 2827 444 2842 2208 2848 2211 2832 2210 2807 446 2801 446 2827"/>
                        </Shape>
                        <String CONTENT="When the new-comer is still outside, and the master, sitting in the sleeping-room, hears him coming, the first"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l46" HPOS="440" VPOS="2842" WIDTH="707" HEIGHT="53" BASELINE="442 2868 1147 2871" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="442 2868 440 2881 797 2895 798 2895 1145 2885 1147 2871 1145 2846 442 2842 442 2868"/>
                        </Shape>
                        <String CONTENT="words exchanged usually run as follows: —"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l47" HPOS="837" VPOS="2883" WIDTH="948" HEIGHT="55" BASELINE="839 2908 1785 2912" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="839 2908 837 2920 859 2934 861 2934 863 2934 865 2936 919 2936 919 2934 921 2934 923 2934 923 2932 937 2920 984 2930 986 2930 1030 2920 1060 2934 1062 2934 1064 2934 1282 2920 1307 2936 1309 2936 1311 2936 1313 2938 1422 2938 1422 2936 1424 2936 1426 2936 1426 2934 1440 2922 1705 2936 1707 2936 1783 2920 1785 2912 1783 2887 839 2883 839 2908"/>
                        </Shape>
                        <String CONTENT="“Mei” — “Wui!” — “Meˊñin?” — “Êloˊ, g̣ŭm!”"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l48" HPOS="804" VPOS="2928" WIDTH="1010" HEIGHT="53" BASELINE="806 2953 1814 2957" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="806 2953 804 2965 826 2977 828 2977 830 2977 1239 2967 1327 2979 1329 2981 1483 2981 1483 2979 1485 2979 1486 2979 1486 2977 1496 2969 1750 2979 1752 2979 1812 2967 1814 2957 1812 2928 806 2928 806 2953"/>
                        </Shape>
                        <String CONTENT="“Halloo!” — “Ho!” — “Who (are you)?” — “No, (it is) I.”"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l49" HPOS="444" VPOS="2969" WIDTH="1766" HEIGHT="52" BASELINE="446 2996 2210 3002" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2204 2973 446 2969 446 2996 444 3010 2206 3021 2210 3002 2208 2998 2204 2973"/>
                        </Shape>
                        <String CONTENT="Then follows the invitation to enter and exchange short greeting formulas. In the intercourse with the Russians,"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l50" HPOS="446" VPOS="3014" WIDTH="1764" HEIGHT="48" BASELINE="446 3041 2210 3041" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2204 3014 446 3016 446 3041 446 3059 2208 3062 2210 3041 2208 3023 2204 3014"/>
                        </Shape>
                        <String CONTENT="another greeting is used, — toroˊma, — which is only the Russian greeting здорово (“Your health”), changed"/>
                    </TextLine>

                    <TextLine ID="mz_3-081_l51" HPOS="446" VPOS="3055" WIDTH="820" HEIGHT="46" BASELINE="446 3082 1266 3082" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="446 3082 446 3099 1264 3101 1266 3082 1264 3055 446 3057 446 3082"/>
                        </Shape>
                        <String CONTENT="according to the necessities of Chukchee phonetics."/>
