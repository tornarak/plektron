                <TextBlock ID="text_1-100" HPOS="576" VPOS="591" WIDTH="1780" HEIGHT="2632"><TextLine ID="mz_1-100_l1" HPOS="1165" VPOS="591" WIDTH="615" HEIGHT="56" BASELINE="1167 628 1780 632" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1774 621 1754 593 1167 591 1167 628 1165 643 1776 647 1780 632 1778 625 1774 621"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l2" HPOS="581" VPOS="597" WIDTH="69" HEIGHT="59" BASELINE="585 643 650 636" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="585 643 585 656 650 649 650 636 643 597 581 602 585 643"/>
                        </Shape>
                        <String CONTENT="74"/>
                    </TextLine>
<TextLine ID="mz_1-100_l3" HPOS="581" VPOS="708" WIDTH="1775" HEIGHT="47" BASELINE="581 738 2356 738" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="2335 710 2313 710 2291 708 2270 708 581 708 581 738 581 755 2356 755 2356 738 2356 710 2335 710"/>
                        </Shape>
                        <String CONTENT="come to the herd, fighting with their tame rivals, and seeking for some doe"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l4" HPOS="581" VPOS="755" WIDTH="1775" HEIGHT="61" BASELINE="581 799 2356 799" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 799 581 816 2356 816 2356 799 2356 768 2181 755 2179 755 2109 766 2081 755 2079 755 2077 755 2027 766 2003 755 2001 755 1999 755 1949 766 1923 755 1921 755 1919 755 1917 755 1880 766 1817 755 1815 755 1679 766 1644 755 1642 755 1640 755 1590 766 1562 755 1559 755 1557 755 1555 755 1512 766 1481 755 1479 755 1477 755 1414 766 1367 755 1365 755 1362 755 1360 755 1321 766 1263 755 1261 755 1189 766 1157 755 1154 755 1152 755 1150 755 1148 755 1133 766 1074 755 1072 755 973 766 940 755 938 755 936 755 851 766 795 755 793 755 734 766 706 755 704 755 702 755 700 755 654 766 609 755 607 755 604 755 602 755 581 766 581 799"/>
                        </Shape>
                        <String CONTENT="that is still rutting. During this time the herdsmen visit the herd as little as"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l5" HPOS="581" VPOS="814" WIDTH="1771" HEIGHT="69" BASELINE="583 859 2352 855" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="583 859 583 883 2350 879 2352 855 2350 825 2330 814 2328 814 2326 814 2324 814 2322 814 2285 825 2248 814 2246 814 2244 814 2242 814 2218 825 2166 814 2164 814 2161 814 2133 825 1988 814 1986 814 1908 825 1804 814 1802 814 1739 825 1702 814 1700 814 1698 814 1696 814 1674 825 1629 814 1627 814 1624 814 1460 827 1133 816 1131 816 1063 827 1033 816 1031 816 1029 816 1027 816 1025 816 1005 829 760 829 680 816 678 816 581 829 583 859"/>
                        </Shape>
                        <String CONTENT="possible, even at the risk of losing some animals. When visiting the herd,"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l6" HPOS="581" VPOS="889" WIDTH="1775" HEIGHT="46" BASELINE="581 920 2356 920" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 920 581 935 2356 935 2356 920 2356 889 581 889 581 920"/>
                        </Shape>
                        <String CONTENT="they are careful to keep on the windward side of the shy guest, in order not"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l7" HPOS="578" VPOS="933" WIDTH="1774" HEIGHT="67" BASELINE="581 980 2352 976" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 980 581 993 2348 1000 2352 976 2348 946 2250 933 2248 933 2246 933 2244 933 2229 944 2144 933 2142 933 2058 944 2036 933 2034 933 2032 933 1962 944 1917 933 1915 933 1912 933 1910 933 1886 946 1696 946 1650 933 1648 933 1646 933 1644 933 1642 933 1627 944 1499 933 1497 933 1494 933 1460 946 1447 935 1445 935 1442 935 1440 935 1438 935 1399 946 1152 935 1150 935 1148 935 1146 935 1131 948 949 948 869 935 866 935 864 935 832 946 674 935 672 935 578 948 581 980"/>
                        </Shape>
                        <String CONTENT="to frighten him away. The visits of wild bucks are considered as blessings,"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l8" HPOS="578" VPOS="993" WIDTH="1778" HEIGHT="59" BASELINE="581 1039 2356 1035" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1039 581 1052 2356 1048 2356 1035 2352 1006 1501 993 1499 993 1497 993 1462 1006 1425 996 1423 996 1421 996 1419 996 1388 1006 1365 996 1362 996 1360 996 1267 1006 1180 996 1178 996 1176 996 1150 1006 1081 996 1079 996 1076 996 1046 1006 970 996 968 996 966 996 927 1006 825 996 823 996 752 1006 613 996 611 996 609 996 578 1006 581 1039"/>
                        </Shape>
                        <String CONTENT="obvious tokens that Providence looks favorably on the herd: therefore the"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l9" HPOS="578" VPOS="1065" WIDTH="1776" HEIGHT="50" BASELINE="581 1099 2354 1095" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1099 581 1115 2352 1110 2354 1095 2350 1065 578 1065 581 1099"/>
                        </Shape>
                        <String CONTENT="herdsmen, with special charms and incantations, strive to allure and to detain"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l10" HPOS="578" VPOS="1115" WIDTH="1776" HEIGHT="60" BASELINE="581 1160 2354 1156" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1160 581 1175 2352 1171 2354 1156 2350 1125 1523 1115 1520 1115 1462 1125 663 1117 661 1117 578 1128 581 1160"/>
                        </Shape>
                        <String CONTENT="as long as possible the wild reindeer. After the crossing, the herdsmen try"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l11" HPOS="578" VPOS="1173" WIDTH="1776" HEIGHT="61" BASELINE="581 1219 2354 1214" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1219 581 1234 2352 1232 2354 1214 2348 1182 2168 1184 2114 1173 2112 1173 2109 1173 2081 1184 2058 1173 2055 1173 2053 1173 2051 1173 2049 1173 2034 1186 1860 1186 1815 1173 1813 1173 1811 1173 1737 1184 1702 1173 1700 1173 1698 1173 1696 1173 1672 1186 1540 1186 1466 1173 1464 1173 1462 1173 1460 1173 1438 1186 1287 1175 1284 1175 1282 1175 1252 1188 1089 1188 1059 1175 1057 1175 1055 1175 1053 1175 1050 1175 1033 1186 905 1175 903 1175 840 1186 782 1175 780 1175 778 1175 756 1186 665 1175 663 1175 578 1188 581 1219"/>
                        </Shape>
                        <String CONTENT="to kill the wild buck as speedily as they can, since its escape is interpreted"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l12" HPOS="578" VPOS="1234" WIDTH="1776" HEIGHT="60" BASELINE="581 1279 2354 1273" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1279 581 1294 2352 1288 2354 1273 2350 1245 1763 1234 1761 1234 1759 1234 1731 1245 1198 1236 1196 1236 1193 1236 1161 1247 676 1238 674 1238 578 1249 581 1279"/>
                        </Shape>
                        <String CONTENT="as the recall of the blessing. If several bucks that have crossed with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l13" HPOS="581" VPOS="1303" WIDTH="1773" HEIGHT="54" BASELINE="581 1338 2354 1338" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1338 581 1355 2352 1357 2354 1338 2354 1307 581 1303 581 1338"/>
                        </Shape>
                        <String CONTENT="herd should make good their escape, they will induce the herd the next spring"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l14" HPOS="578" VPOS="1357" WIDTH="1776" HEIGHT="56" BASELINE="581 1398 2354 1394" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1398 581 1413 2352 1409 2354 1394 2350 1366 598 1357 596 1357 594 1357 591 1357 578 1364 581 1398"/>
                        </Shape>
                        <String CONTENT="to return the visit, and will keep them afterward. The offspring of the cross"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l15" HPOS="578" VPOS="1424" WIDTH="1776" HEIGHT="50" BASELINE="581 1459 2354 1455" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1459 581 1474 2352 1470 2354 1455 2350 1424 578 1424 581 1459"/>
                        </Shape>
                        <String CONTENT="between tame and wild reindeer is highly valued by the Chukchee. They trace"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l16" HPOS="581" VPOS="1487" WIDTH="1773" HEIGHT="48" BASELINE="581 1517 2354 1517" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1517 581 1535 2354 1535 2354 1517 2354 1487 581 1487 581 1517"/>
                        </Shape>
                        <String CONTENT="the lineage of such blood for three or four generations. All cross-breeds are"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l17" HPOS="581" VPOS="1543" WIDTH="1773" HEIGHT="52" BASELINE="581 1576 2354 1576" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1576 581 1595 2354 1595 2354 1576 2354 1548 581 1543 581 1576"/>
                        </Shape>
                        <String CONTENT="broken for the harness, and used especially in racing, because they are swifter"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l18" HPOS="578" VPOS="1604" WIDTH="1776" HEIGHT="50" BASELINE="581 1636 2354 1632" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1636 581 1654 2352 1649 2354 1632 2348 1604 578 1606 581 1636"/>
                        </Shape>
                        <String CONTENT="and have more mettle than any tame reindeer. The offspring of the wild"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l19" HPOS="578" VPOS="1665" WIDTH="1776" HEIGHT="49" BASELINE="581 1699 2354 1695" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1699 581 1714 2352 1710 2354 1695 2350 1665 578 1665 581 1699"/>
                        </Shape>
                        <String CONTENT="buck and the tame doe is called rɪteˊqäu; and that of the rɪteˊqäu buck and"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l20" HPOS="576" VPOS="1714" WIDTH="1780" HEIGHT="59" BASELINE="578 1760 2356 1755" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 1760 578 1773 2356 1768 2356 1755 2352 1725 1466 1714 1464 1714 1462 1714 1440 1725 602 1717 600 1717 598 1717 576 1725 578 1760"/>
                        </Shape>
                        <String CONTENT="the tame doe, ɪˊčve-teiˊkɪn (“wild reindeer made”). Sometimes the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l21" HPOS="578" VPOS="1775" WIDTH="1772" HEIGHT="65" BASELINE="581 1816 2350 1820" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1816 578 1831 589 1840 591 1840 594 1840 596 1840 2348 1838 2350 1820 2348 1790 2278 1777 2276 1777 2140 1788 2084 1777 2081 1777 2006 1788 1915 1777 1912 1777 1910 1777 1878 1788 1860 1777 1858 1777 1856 1777 1854 1777 1763 1788 1635 1777 1633 1777 1631 1777 1629 1777 1614 1790 1468 1790 1453 1775 1451 1775 1449 1775 1447 1775 1388 1786 1276 1775 1274 1775 1271 1775 1235 1786 1137 1775 1135 1775 1133 1775 1094 1786 1007 1775 1005 1775 1003 1775 955 1786 581 1781 581 1816"/>
                        </Shape>
                        <String CONTENT="buck, when roaming about free, will cross with a wild doe. The offspring,"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l22" HPOS="578" VPOS="1836" WIDTH="1774" HEIGHT="60" BASELINE="581 1879 2352 1875" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1879 581 1896 2350 1892 2352 1875 2348 1846 1484 1836 1481 1836 1479 1836 1447 1846 620 1838 617 1838 615 1838 578 1849 581 1879"/>
                        </Shape>
                        <String CONTENT="when caught young, can be broken, and is prized more highly than any other"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l23" HPOS="578" VPOS="1894" WIDTH="1776" HEIGHT="61" BASELINE="581 1939 2354 1935" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 1939 581 1955 2352 1950 2354 1935 2350 1905 1466 1894 1464 1894 1462 1894 1429 1905 628 1896 626 1896 624 1896 578 1907 581 1939"/>
                        </Shape>
                        <String CONTENT="reindeer. The Chukchee assert that the first cross-bred generation of rɪteˊqäu"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l24" HPOS="576" VPOS="1952" WIDTH="1778" HEIGHT="63" BASELINE="578 2000 2354 1994" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 2000 578 2015 2352 2009 2354 1994 2350 1963 1806 1952 1804 1952 1802 1952 1756 1965 576 1965 578 2000"/>
                        </Shape>
                        <String CONTENT="is better and even more docile than the second, in which the innate wildness"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l25" HPOS="576" VPOS="2013" WIDTH="1778" HEIGHT="63" BASELINE="578 2061 2354 2054" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 2061 578 2076 2352 2069 2354 2054 2350 2026 2268 2013 2265 2013 2263 2013 2239 2024 2094 2013 2092 2013 1975 2024 1947 2013 1945 2013 1943 2013 1941 2013 1938 2013 1923 2024 1817 2013 1815 2013 1707 2026 1689 2015 1687 2015 1685 2015 1683 2015 1681 2015 1633 2026 1128 2017 1126 2017 1124 2017 1122 2017 1109 2028 1046 2017 1044 2017 743 2028 637 2017 635 2017 576 2030 578 2061"/>
                        </Shape>
                        <String CONTENT="returns. The crossing between the Lamut and the Chukchee reindeer does"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l26" HPOS="581" VPOS="2089" WIDTH="747" HEIGHT="45" BASELINE="581 2117 1328 2117" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 2117 581 2134 1328 2134 1328 2117 1328 2089 581 2089 581 2117"/>
                        </Shape>
                        <String CONTENT="not attract any special attention."/>
                    </TextLine>
<TextLine ID="mz_1-100_l27" HPOS="689" VPOS="2141" WIDTH="1665" HEIGHT="54" BASELINE="689 2175 2354 2175" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="689 2175 689 2195 2354 2195 2354 2175 2354 2147 689 2141 689 2175"/>
                        </Shape>
                        <String CONTENT="The tame reindeer shows considerable variety in color, ranging from spot-"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l28" HPOS="578" VPOS="2201" WIDTH="1776" HEIGHT="55" BASELINE="578 2236 2354 2236" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 2236 578 2256 2354 2256 2354 2236 2354 2208 578 2201 578 2236"/>
                        </Shape>
                        <String CONTENT="less snow-white to dark gray and hazel-nut brown (usually called by the natives"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l29" HPOS="578" VPOS="2260" WIDTH="1772" HEIGHT="56" BASELINE="581 2295 2350 2299" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 2295 578 2310 2346 2316 2350 2299 2348 2266 581 2260 581 2295"/>
                        </Shape>
                        <String CONTENT="black). It is darkest shortly after shedding its hair, and lightest in the spring,"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l30" HPOS="581" VPOS="2316" WIDTH="1771" HEIGHT="59" BASELINE="581 2357 2352 2357" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="581 2357 581 2375 2352 2375 2352 2357 2352 2329 2170 2329 2155 2316 2153 2316 2151 2316 2148 2316 2146 2316 2116 2327 2062 2316 2060 2316 1984 2327 1960 2316 1958 2316 1956 2316 1904 2329 1741 2329 1726 2316 1724 2316 1722 2316 1720 2316 1657 2327 1592 2316 1590 2316 1588 2316 1555 2327 1471 2316 1468 2316 1466 2316 1434 2327 1358 2316 1356 2316 1354 2316 1326 2327 1308 2316 1306 2316 1304 2316 1302 2316 1300 2316 1269 2329 1072 2329 1053 2316 1050 2316 1048 2316 1046 2316 990 2327 892 2316 890 2316 581 2321 581 2357"/>
                        </Shape>
                        <String CONTENT="before shedding. Fawns are darker than the old ones, and white fawns are"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l31" HPOS="578" VPOS="2375" WIDTH="1778" HEIGHT="58" BASELINE="578 2418 2356 2418" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 2418 578 2433 2356 2433 2356 2418 2354 2379 2075 2385 2042 2375 2040 2375 2038 2375 2036 2375 2001 2385 1923 2375 1921 2375 1919 2375 1873 2385 1828 2375 1826 2375 1824 2375 1772 2385 1715 2375 1713 2375 1657 2385 1562 2375 1559 2375 1488 2385 1436 2375 1434 2375 1432 2375 1429 2375 1414 2385 1313 2375 1310 2375 1243 2385 1183 2375 1180 2375 1120 2385 1092 2375 1089 2375 1087 2375 1085 2375 1053 2385 1016 2375 1014 2375 1012 2375 929 2385 903 2375 901 2375 899 2375 897 2375 895 2375 877 2388 739 2388 723 2375 721 2375 719 2375 604 2375 602 2375 600 2375 578 2385 578 2418"/>
                        </Shape>
                        <String CONTENT="therefore much valued. The Chukchee distinguish the following colors of"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l32" HPOS="576" VPOS="2433" WIDTH="390" HEIGHT="59" BASELINE="578 2479 966 2474" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="578 2479 578 2492 964 2489 966 2474 962 2446 795 2433 793 2433 791 2433 765 2446 628 2435 626 2435 624 2435 576 2448 578 2479"/>
                        </Shape>
                        <String CONTENT="reindeer-skin: —"/>
                    </TextLine>
<TextLine ID="mz_1-100_l33" HPOS="585" VPOS="2511" WIDTH="1767" HEIGHT="50" BASELINE="585 2541 2352 2541" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="585 2541 585 2561 2350 2561 2352 2541 2350 2511 585 2511 585 2541"/>
                        </Shape>
                        <String CONTENT="1. Teñ-uweˊlᴇ (“quite black” [chestnut brown]). 9. Čêˊčhên-yaˊqɪlhɪn (“under-leg grayish” [light-"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l34" HPOS="1549" VPOS="2559" WIDTH="801" HEIGHT="49" BASELINE="1551 2587 2350 2591" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1551 2587 1549 2608 2348 2608 2350 2591 2348 2563 1551 2559 1551 2587"/>
                        </Shape>
                        <String CONTENT="gray spots under the legs and on the groins,"/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l35" HPOS="585" VPOS="2561" WIDTH="626" HEIGHT="56" BASELINE="585 2591 1211 2591" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="585 2591 585 2604 719 2617 721 2617 808 2606 823 2617 825 2617 827 2617 830 2617 957 2606 1185 2617 1187 2617 1189 2617 1211 2604 1211 2591 1211 2561 585 2561 585 2591"/>
                        </Shape>
                        <String CONTENT="2. Uuˊrg̣ɪlɪn (“black hair tipped”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l36" HPOS="1549" VPOS="2602" WIDTH="259" HEIGHT="50" BASELINE="1551 2632 1808 2637" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="1551 2632 1549 2647 1804 2652 1808 2637 1806 2606 1551 2602 1551 2632"/>
                        </Shape>
                        <String CONTENT="body brown])."/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l37" HPOS="587" VPOS="2608" WIDTH="368" HEIGHT="50" BASELINE="587 2637 955 2637" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="587 2637 587 2658 955 2652 955 2637 955 2608 587 2608 587 2637"/>
                        </Shape>
                        <String CONTENT="3. Čêvaˊro (“gray”)."/>
                    </TextLine>

                    <TextLine ID="mz_1-100_l38" HPOS="581" VPOS="2645" WIDTH="1767" HEIGHT="67" BASELINE="583 2686 2348 2676" TAGREFS="TYPE_6">
                        <Shape>
