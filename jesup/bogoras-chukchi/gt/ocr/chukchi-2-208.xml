                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-208_l3" HPOS="350" VPOS="565" WIDTH="1765" HEIGHT="53" BASELINE="352 605 2115 601" TAGREFS="TYPE_5">
