                <TextBlock ID="text_1-174" HPOS="622" VPOS="608" WIDTH="1784" HEIGHT="2624"><TextLine ID="mz_1-174_l1" HPOS="1211" VPOS="608" WIDTH="617" HEIGHT="54" BASELINE="1213 643 1828 638" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1817 610 1795 608 1774 608 1752 608 1731 608 1709 608 1687 608 1666 608 1644 608 1622 608 1601 608 1579 608 1557 608 1536 608 1514 608 1211 608 1213 643 1213 662 1826 658 1828 638 1826 636 1817 610"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l2" HPOS="643" VPOS="610" WIDTH="87" HEIGHT="52" BASELINE="646 649 730 645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="646 649 646 662 728 660 730 645 723 610 643 612 646 649"/>
                        </Shape>
                        <String CONTENT="132"/>
                    </TextLine>
<TextLine ID="mz_1-174_l3" HPOS="633" VPOS="716" WIDTH="1773" HEIGHT="61" BASELINE="635 747 2406 751" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2387 727 2365 725 2343 725 2322 723 2300 723 2278 721 2274 718 635 716 635 747 633 760 656 773 659 773 661 773 773 764 862 775 864 777 983 777 983 775 986 775 988 775 1003 764 1066 775 1068 775 1466 764 1488 775 1490 775 1492 775 1637 766 1793 777 1795 777 2404 764 2406 751 2404 727 2387 727"/>
                        </Shape>
                        <String CONTENT="often hampered while on the road by the breaking-up of the ice. In order"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l4" HPOS="630" VPOS="777" WIDTH="1776" HEIGHT="58" BASELINE="633 807 2406 812" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 807 630 820 1520 835 1523 835 2404 825 2406 812 2404 781 633 777 633 807"/>
                        </Shape>
                        <String CONTENT="to cross the mountain rivers, suddenly swollen by floods, they sometimes"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l5" HPOS="630" VPOS="838" WIDTH="1774" HEIGHT="58" BASELINE="633 868 2404 872" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 868 630 881 652 894 654 894 656 894 1306 885 1520 896 1523 896 2402 885 2404 872 2402 842 633 838 633 868"/>
                        </Shape>
                        <String CONTENT="construct a peculiar device, consisting of several sledges tied together in a"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l6" HPOS="630" VPOS="889" WIDTH="1774" HEIGHT="63" BASELINE="633 931 2404 926" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 931 633 952 2402 946 2404 926 2400 896 665 889 663 889 661 889 630 900 633 931"/>
                        </Shape>
                        <String CONTENT="pile, and protected from beneath by the cover of the outer tent. This is used"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l7" HPOS="630" VPOS="946" WIDTH="1174" HEIGHT="67" BASELINE="633 985 1804 991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 985 630 1004 639 1011 641 1011 643 1011 646 1011 927 1002 1022 1013 1025 1013 1802 1004 1804 991 1802 950 1653 950 1650 950 1648 950 1646 950 1646 952 1637 959 1627 950 1624 950 1622 950 1620 950 1555 961 1544 952 1544 950 1542 950 1540 950 1538 950 1434 959 1416 948 1414 948 1412 948 1410 948 1323 959 845 959 834 948 834 946 832 946 830 946 827 946 825 946 799 957 633 957 633 985"/>
                        </Shape>
                        <String CONTENT="as a raft to carry over men and household things.¹"/>
                    </TextLine>
<TextLine ID="mz_1-174_l8" HPOS="734" VPOS="1019" WIDTH="1670" HEIGHT="48" BASELINE="734 1050 2404 1050" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="734 1050 734 1067 2404 1067 2404 1050 2404 1019 734 1019 734 1050"/>
                        </Shape>
                        <String CONTENT="HUNTING OF LAND-GAME. — Of land-game, the wild reindeer is the most"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l9" HPOS="630" VPOS="1076" WIDTH="1774" HEIGHT="49" BASELINE="630 1108 2404 1108" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1108 630 1125 2404 1125 2404 1108 2404 1080 630 1076 630 1108"/>
                        </Shape>
                        <String CONTENT="important. It is nevertheless not so abundant in northeastern Asia as the"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l10" HPOS="630" VPOS="1130" WIDTH="1774" HEIGHT="56" BASELINE="633 1171 2404 1167" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1171 633 1186 2402 1184 2404 1167 2400 1134 700 1130 697 1130 630 1141 633 1171"/>
                        </Shape>
                        <String CONTENT="caribou in America, because the best pastures are occupied by domesticated"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l11" HPOS="633" VPOS="1188" WIDTH="1771" HEIGHT="59" BASELINE="633 1232 2404 1232" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1232 633 1247 2404 1247 2404 1232 2404 1201 2348 1188 2346 1188 2265 1199 2116 1188 2114 1188 2023 1199 1904 1188 1902 1188 1899 1188 1871 1199 1795 1188 1793 1188 1698 1199 1655 1188 1653 1188 1650 1188 1648 1188 1620 1199 1607 1188 1605 1188 1603 1188 1601 1188 1546 1199 1391 1188 1388 1188 1386 1188 1356 1199 1310 1188 1308 1188 1306 1188 1215 1199 1154 1188 1152 1188 1098 1199 1076 1188 1074 1188 1072 1188 1070 1188 1040 1199 986 1188 983 1188 981 1188 944 1199 905 1188 903 1188 901 1188 812 1199 633 1195 633 1232"/>
                        </Shape>
                        <String CONTENT="herds. Only the depths of the forests and the higher slopes of the mountains"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l12" HPOS="630" VPOS="1247" WIDTH="1774" HEIGHT="60" BASELINE="633 1290 2404 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1290 633 1307 2402 1303 2404 1286 2400 1258 1529 1247 1527 1247 1436 1258 739 1249 736 1249 630 1260 633 1290"/>
                        </Shape>
                        <String CONTENT="are left quite undisturbed for the wild breed, because they are unsuitable for"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l13" HPOS="630" VPOS="1305" WIDTH="1774" HEIGHT="63" BASELINE="633 1353 2404 1348" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1353 633 1368 2402 1364 2404 1348 2400 1318 1886 1318 1863 1305 1860 1305 1858 1305 1780 1316 1748 1305 1746 1305 1744 1305 1741 1305 1739 1305 1726 1316 1694 1305 1692 1305 1689 1305 1687 1305 1644 1316 1631 1305 1629 1305 1627 1305 1527 1305 1525 1305 1523 1305 1520 1305 1505 1318 1438 1307 1436 1307 1434 1307 1401 1318 1360 1307 1358 1307 1356 1307 1354 1307 1321 1318 1152 1307 1150 1307 1087 1318 968 1307 966 1307 964 1307 923 1318 730 1307 728 1307 726 1307 723 1307 710 1318 652 1307 650 1307 648 1307 646 1307 630 1316 633 1353"/>
                        </Shape>
                        <String CONTENT="the breeding of domesticated animals. Wild reindeer, however, are met every-"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l14" HPOS="633" VPOS="1374" WIDTH="1427" HEIGHT="50" BASELINE="635 1405 2060 1409" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 1405 633 1420 2055 1424 2060 1409 2058 1379 635 1374 635 1405"/>
                        </Shape>
                        <String CONTENT="where in northeastern Asia, in single heads or in small herds."/>
                    </TextLine>
<TextLine ID="mz_1-174_l15" HPOS="745" VPOS="1431" WIDTH="1659" HEIGHT="54" BASELINE="745 1470 2404 1470" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="745 1470 745 1485 2404 1485 2404 1470 2404 1439 745 1431 745 1470"/>
                        </Shape>
                        <String CONTENT="The wild reindeer is larger than any of the domesticated varieties. Its"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l16" HPOS="633" VPOS="1500" WIDTH="1769" HEIGHT="48" BASELINE="633 1530 2402 1530" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1530 633 1548 2402 1548 2402 1530 2402 1500 633 1500 633 1530"/>
                        </Shape>
                        <String CONTENT="step is wider, and its footprint longer, because its hoof-joints are more supple."/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l17" HPOS="633" VPOS="1554" WIDTH="1769" HEIGHT="54" BASELINE="633 1589 2402 1589" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1589 633 1608 2402 1608 2402 1589 2402 1558 633 1554 633 1589"/>
                        </Shape>
                        <String CONTENT="Its antlers are more or less similar to those of the Lamut reindeer, but generally"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l18" HPOS="633" VPOS="1610" WIDTH="1771" HEIGHT="55" BASELINE="633 1647 2404 1647" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1647 633 1665 2404 1665 2404 1647 2402 1610 633 1617 633 1647"/>
                        </Shape>
                        <String CONTENT="the ends are bent up in a hook-like shape. Also the difference in size of"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l19" HPOS="628" VPOS="1675" WIDTH="1772" HEIGHT="50" BASELINE="630 1706 2400 1710" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1706 628 1721 2395 1725 2400 1710 2398 1680 630 1675 630 1706"/>
                        </Shape>
                        <String CONTENT="antlers between buck and doe is still more marked than with Lamut reindeer."/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l20" HPOS="630" VPOS="1729" WIDTH="1770" HEIGHT="68" BASELINE="633 1764 2400 1771" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 1764 630 1779 1969 1797 1971 1797 2398 1786 2400 1771 2398 1740 633 1729 633 1764"/>
                        </Shape>
                        <String CONTENT="The color of the skin is uniformly dark gray, somewhat lighter on the belly"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l21" HPOS="628" VPOS="1786" WIDTH="1772" HEIGHT="60" BASELINE="630 1829 2400 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1829 630 1846 2398 1846 2400 1825 2393 1794 1951 1797 1921 1786 1919 1786 1917 1786 1789 1797 1759 1786 1756 1786 1754 1786 1752 1786 1750 1786 1731 1799 1609 1799 1518 1786 1516 1786 1514 1786 1512 1786 1497 1799 1365 1788 1362 1788 1300 1799 1271 1788 1269 1788 1267 1788 1170 1799 1113 1788 1111 1788 1109 1788 1107 1788 1092 1799 1055 1788 1053 1788 1050 1788 999 1799 986 1788 983 1788 981 1788 979 1788 875 1799 697 1788 695 1788 628 1801 630 1829"/>
                        </Shape>
                        <String CONTENT="and lower part of the neck. Those living on the northeastern tundras and"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l22" HPOS="628" VPOS="1857" WIDTH="1770" HEIGHT="54" BASELINE="630 1888 2398 1892" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1888 628 1901 643 1911 646 1911 648 1911 650 1911 2395 1909 2398 1892 2395 1862 630 1857 630 1888"/>
                        </Shape>
                        <String CONTENT="close to the ocean are smaller, but accumulate more fat. In this respect,"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l23" HPOS="630" VPOS="1911" WIDTH="1770" HEIGHT="54" BASELINE="630 1946 2400 1946" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 1946 630 1965 2400 1965 2400 1946 2400 1918 630 1911 630 1946"/>
                        </Shape>
                        <String CONTENT="however, all varieties of the wild reindeer are superior, even to the Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l24" HPOS="628" VPOS="1970" WIDTH="1772" HEIGHT="54" BASELINE="630 2007 2400 2011" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2007 628 2020 2395 2024 2400 2011 2398 1978 630 1970 630 2007"/>
                        </Shape>
                        <String CONTENT="breed. Late in summer, when insects cease to swarm around the pastures, a"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l25" HPOS="628" VPOS="2024" WIDTH="1772" HEIGHT="61" BASELINE="630 2069 2400 2065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="630 2069 630 2085 2398 2080 2400 2065 2395 2037 2287 2024 2285 2024 2283 2024 2237 2035 2220 2024 2218 2024 2216 2024 2213 2024 2142 2035 2120 2024 2118 2024 2116 2024 2114 2024 2112 2024 2094 2037 1960 2037 1904 2024 1902 2024 1899 2024 1876 2035 1819 2024 1817 2024 1815 2024 1813 2024 1795 2037 1674 2037 1629 2024 1627 2024 1624 2024 1622 2024 1601 2035 1551 2024 1549 2024 1546 2024 1510 2037 1436 2026 1434 2026 1432 2026 1406 2037 1378 2026 1375 2026 1373 2026 1371 2026 1345 2037 1243 2026 1241 2026 1239 2026 1237 2026 1222 2039 1094 2039 1055 2026 1053 2026 1050 2026 986 2037 908 2026 905 2026 903 2026 860 2037 847 2026 845 2026 843 2026 669 2026 667 2026 665 2026 628 2039 630 2069"/>
                        </Shape>
                        <String CONTENT="wild buck often takes on three inches of tallow on his hips, so that he is no"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l26" HPOS="630" VPOS="2093" WIDTH="997" HEIGHT="50" BASELINE="633 2128 1627 2126" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="633 2128 633 2143 1624 2141 1627 2126 1622 2098 630 2093 633 2128"/>
                        </Shape>
                        <String CONTENT="longer able to run with his usual swiftness."/>
                    </TextLine>
<TextLine ID="mz_1-174_l27" HPOS="734" VPOS="2150" WIDTH="1668" HEIGHT="60" BASELINE="736 2184 2402 2188" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2184 734 2199 752 2210 754 2210 756 2210 758 2210 2400 2201 2402 2188 2400 2154 736 2150 736 2184"/>
                        </Shape>
                        <String CONTENT="Some wild reindeer always live in the same places. They are called"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l28" HPOS="633" VPOS="2210" WIDTH="1769" HEIGHT="67" BASELINE="635 2240 2402 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="635 2240 633 2253 663 2269 665 2269 667 2271 825 2271 825 2269 827 2269 853 2258 990 2271 992 2271 1061 2260 1139 2271 1141 2271 1471 2262 1494 2273 1497 2273 1499 2273 1824 2264 1882 2275 1884 2277 1884 2275 1943 2264 2218 2264 2274 2277 2276 2277 2400 2264 2402 2251 2400 2221 635 2210 635 2240"/>
                        </Shape>
                        <String CONTENT="“resident reindeer.” Others gather every year in large herds and migrate"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l29" HPOS="624" VPOS="2273" WIDTH="1717" HEIGHT="52" BASELINE="626 2303 2341 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2303 624 2318 2337 2325 2341 2310 2341 2279 626 2273 626 2303"/>
                        </Shape>
                        <String CONTENT="considerable distances, from the forest border to the tundra and back again."/>
                    </TextLine>
<TextLine ID="mz_1-174_l30" HPOS="734" VPOS="2334" WIDTH="1666" HEIGHT="49" BASELINE="734 2366 2400 2366" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="734 2366 734 2383 2400 2383 2400 2366 2400 2338 734 2334 734 2366"/>
                        </Shape>
                        <String CONTENT="In former times there were two different trails in northeastern Asia for"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l31" HPOS="622" VPOS="2383" WIDTH="1778" HEIGHT="70" BASELINE="624 2424 2400 2429" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="624 2424 622 2437 689 2450 691 2450 1510 2442 1572 2453 1575 2453 2398 2442 2400 2429 2398 2398 2337 2385 2335 2385 2333 2385 2296 2396 2252 2385 2250 2385 2248 2385 2246 2385 2203 2396 2153 2385 2151 2385 2148 2385 2114 2398 1921 2398 1897 2385 1895 2385 1893 2385 1815 2396 1767 2385 1765 2385 1763 2385 1477 2394 1462 2383 1460 2383 1458 2383 1455 2383 1453 2383 1423 2394 1323 2383 1321 2383 1319 2383 1291 2394 1267 2383 1265 2383 1263 2383 1185 2394 1113 2383 1111 2383 1109 2383 1070 2394 929 2383 927 2383 925 2383 899 2394 832 2383 830 2383 624 2392 624 2424"/>
                        </Shape>
                        <String CONTENT="these migrations. One led from the Kolyma Mountains across the Omolon"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l32" HPOS="626" VPOS="2446" WIDTH="1772" HEIGHT="56" BASELINE="626 2487 2398 2487" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2487 626 2500 2395 2502 2398 2487 2398 2457 2372 2446 2369 2446 2367 2446 2276 2457 2231 2446 2229 2446 2226 2446 2224 2446 2194 2457 1964 2446 1962 2446 1871 2457 1841 2446 1839 2446 1837 2446 1752 2457 1713 2446 1711 2446 1709 2446 1529 2457 1464 2446 1462 2446 1460 2446 1421 2457 1369 2446 1367 2446 1365 2446 1362 2446 1345 2459 1245 2459 977 2446 975 2446 973 2446 970 2446 955 2459 819 2459 760 2446 758 2446 756 2446 732 2457 697 2446 695 2446 693 2446 626 2457 626 2487"/>
                        </Shape>
                        <String CONTENT="and the two Anui Rivers to the Chaun tundra; the other, from the high"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l33" HPOS="624" VPOS="2511" WIDTH="1776" HEIGHT="61" BASELINE="626 2541 2400 2548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2541 624 2557 741 2570 743 2570 1191 2561 1252 2572 1254 2572 2398 2563 2400 2548 2398 2518 626 2511 626 2541"/>
                        </Shape>
                        <String CONTENT="country of Palpal, across the Anadyr River, to the Chukchee Peninsula. About"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l34" HPOS="624" VPOS="2572" WIDTH="1771" HEIGHT="54" BASELINE="626 2604 2395 2613" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2604 624 2617 2391 2626 2395 2613 2393 2580 626 2572 626 2604"/>
                        </Shape>
                        <String CONTENT="fourscore years ago the reindeer migration over the former trail began to lessen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l35" HPOS="626" VPOS="2624" WIDTH="1772" HEIGHT="60" BASELINE="626 2667 2398 2667" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2663 626 2667 626 2684 2398 2684 2398 2667 2398 2637 2302 2624 2300 2624 2298 2624 2276 2634 2255 2624 2252 2624 2250 2624 2248 2624 2226 2634 2127 2624 2125 2624 2122 2624 2120 2624 2103 2634 2064 2624 2062 2624 2060 2624 1744 2634 1685 2624 1683 2624 1631 2634 1618 2624 1616 2624 1614 2624 1499 2624 1497 2624 1403 2634 1362 2624 1360 2624 1358 2624 1356 2624 1354 2624 1339 2637 1252 2637 1224 2624 1222 2624 1219 2624 1133 2634 1100 2624 1098 2624 1096 2624 1094 2624 1061 2634 1038 2624 1035 2624 1033 2624 882 2634 754 2624 752 2624 749 2624 747 2624 730 2634 702 2624 700 2624 697 2624 637 2632 626 2663"/>
                        </Shape>
                        <String CONTENT="and finally ceased altogether. Several Yukaghir villages which depended on"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l36" HPOS="624" VPOS="2693" WIDTH="1774" HEIGHT="50" BASELINE="626 2723 2398 2728" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2723 624 2738 2393 2743 2398 2728 2395 2697 626 2693 626 2723"/>
                        </Shape>
                        <String CONTENT="wild reindeer for their subsistence were starved out in consequence, and the"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l37" HPOS="626" VPOS="2756" WIDTH="1769" HEIGHT="47" BASELINE="626 2786 2395 2786" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2786 626 2803 2395 2803 2395 2786 2395 2756 626 2756 626 2786"/>
                        </Shape>
                        <String CONTENT="remainder went to the northwest and settled in the Russo-Yukaghir fishing-"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l38" HPOS="624" VPOS="2812" WIDTH="1771" HEIGHT="61" BASELINE="626 2842 2395 2847" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2842 624 2857 715 2870 717 2870 1421 2862 1512 2873 1514 2873 2393 2862 2395 2847 2393 2816 626 2812 626 2842"/>
                        </Shape>
                        <String CONTENT="villages on the Kolyma River. In the year 1896, when descending the Omolon"/>
                    </TextLine>

                    <TextLine ID="mz_1-174_l39" HPOS="624" VPOS="2870" WIDTH="1771" HEIGHT="59" BASELINE="626 2901 2395 2907" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="626 2901 624 2918 637 2927 639 2927 641 2927 643 2927 1126 2918 1217 2929 1219 2929 2393 2920 2395 2907 2393 2877 626 2870 626 2901"/>
                        </Shape>
