                        </Shape>
                        <String CONTENT="Chukchee funeral, taken down from the mouth of a native, may be cited."/>
                    </TextLine>
<TextLine ID="mz_2-216_l5" HPOS="426" VPOS="716" WIDTH="1669" HEIGHT="51" BASELINE="428 744 2095 748" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="428 744 426 755 464 767 466 767 468 767 2093 763 2095 748 2093 718 428 716 428 744"/>
                        </Shape>
                        <String CONTENT="“Then they lay down rollers under the sledge and try to draw it. (They ask the deceased)"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l6" HPOS="327" VPOS="765" WIDTH="1768" HEIGHT="45" BASELINE="327 793 2095 793" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 793 327 806 2091 810 2095 793 2093 765 327 765 327 793"/>
                        </Shape>
                        <String CONTENT="‘Of all those present here, say straightly whether anything ill shall befall them. Tell that about all,"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l7" HPOS="327" VPOS="814" WIDTH="1766" HEIGHT="41" BASELINE="327 840 2093 840" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 840 327 855 2093 855 2093 840 2093 814 327 814 327 840"/>
                        </Shape>
                        <String CONTENT="one by one, not hiding anything.’ If, on asking about some particular person, the sledge runs"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l8" HPOS="330" VPOS="853" WIDTH="858" HEIGHT="49" BASELINE="332 887 1188 883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 887 332 902 1186 896 1188 883 1182 853 330 859 332 887"/>
                        </Shape>
                        <String CONTENT="smoothly and without hitch, he will surely die.”¹"/>
                    </TextLine>
<TextLine ID="mz_2-216_l9" HPOS="432" VPOS="932" WIDTH="1659" HEIGHT="58" BASELINE="434 975 2091 971" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="434 975 434 990 2089 990 2091 971 2089 941 2074 932 2072 932 2070 932 2068 932 2066 932 2036 941 2001 932 1999 932 1997 932 1995 932 1970 943 1809 943 1794 932 1792 932 1790 932 1788 932 1786 932 1764 941 1602 932 1600 932 1367 941 1327 932 1325 932 1323 932 1257 943 1094 934 1092 934 1090 934 1059 943 994 934 992 934 938 943 916 934 914 934 912 934 432 940 434 975"/>
                        </Shape>
                        <String CONTENT="The method of divination by suspension is widely spread among both"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l10" HPOS="323" VPOS="990" WIDTH="1772" HEIGHT="59" BASELINE="325 1035 2095 1032" TAGREFS="TYPE_5">
                        <Shape>
