                        </Shape>
                        <String CONTENT="As an instance of the contrary, an extract from a description of a"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l4" HPOS="323" VPOS="628" WIDTH="1704" HEIGHT="57" BASELINE="323 669 2027 669" TAGREFS="TYPE_5">
