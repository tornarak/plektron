                        <Shape>
                            <Polygon POINTS="329 1874 329 1887 2093 1887 2095 1870 2093 1842 2050 1831 2048 1831 2046 1831 2044 1831 2019 1840 1463 1831 1461 1831 1410 1840 1357 1831 1355 1831 1288 1840 1249 1831 1247 1831 1245 1831 1188 1842 1018 1833 1016 1833 906 1842 853 1833 851 1833 850 1833 830 1842 797 1833 795 1833 793 1833 726 1842 644 1833 642 1833 579 1842 517 1833 515 1833 470 1842 434 1833 432 1833 430 1833 327 1844 329 1874"/>
                        </Shape>
                        <String CONTENT="stood still. One of the cords supporting the plates became hooked to the"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l25" HPOS="325" VPOS="1889" WIDTH="1770" HEIGHT="59" BASELINE="327 1934 2095 1930" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1934 327 1948 2093 1948 2095 1930 2089 1895 1972 1899 1944 1889 1942 1889 1940 1889 1938 1889 1897 1899 1876 1889 1874 1889 1872 1889 1870 1889 1844 1899 1821 1889 1819 1889 1817 1889 1741 1899 1719 1889 1717 1889 1715 1889 1713 1889 1678 1899 1617 1889 1615 1889 1564 1899 1541 1889 1539 1889 1537 1889 1535 1889 1502 1899 1488 1889 1486 1889 1484 1889 1367 1889 1365 1889 1363 1889 1361 1889 1345 1901 1192 1901 1157 1891 1155 1891 1153 1891 1151 1891 1149 1891 1133 1903 1022 1903 975 1891 973 1891 971 1891 938 1901 897 1891 895 1891 893 1891 891 1891 889 1891 875 1901 850 1891 848 1891 846 1891 736 1901 624 1891 622 1891 620 1891 589 1901 538 1891 536 1891 534 1891 532 1891 517 1901 479 1891 477 1891 475 1891 473 1891 432 1901 399 1891 397 1891 395 1891 325 1903 327 1934"/>
                        </Shape>
                        <String CONTENT="end of the lever, and its free motion was disturbed. “Desist, desist!” cried"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l26" HPOS="327" VPOS="1950" WIDTH="1768" HEIGHT="57" BASELINE="329 1995 2095 1991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1995 329 2007 2093 2005 2095 1991 2091 1964 2015 1964 1993 1950 1991 1950 1989 1950 1987 1950 1985 1950 1960 1960 1933 1950 1931 1950 1929 1950 1927 1950 1880 1962 1856 1950 1854 1950 1852 1950 1780 1962 1735 1950 1733 1950 1731 1950 1658 1962 1557 1950 1555 1950 1486 1962 1410 1950 1408 1950 1406 1950 1404 1950 1384 1962 781 1952 779 1952 777 1952 732 1964 687 1952 685 1952 683 1952 558 1964 479 1952 477 1952 405 1964 350 1952 348 1952 346 1952 344 1952 327 1962 329 1995"/>
                        </Shape>
                        <String CONTENT="the other people, frightened; but it was too late. Now, when the balance"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l27" HPOS="329" VPOS="2013" WIDTH="1764" HEIGHT="56" BASELINE="330 2052 2093 2048" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 2052 330 2069 2091 2069 2093 2048 2087 2013 877 2022 855 2013 853 2013 679 2013 677 2013 538 2022 454 2013 452 2013 450 2013 423 2022 348 2013 346 2013 344 2013 342 2013 329 2021 330 2052"/>
                        </Shape>
                        <String CONTENT="did give an unfavorable answer, it was necessary to coax it to change it, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l28" HPOS="329" VPOS="2073" WIDTH="1768" HEIGHT="63" BASELINE="330 2115 2097 2109" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 2115 330 2126 853 2136 855 2136 977 2124 1214 2134 1216 2134 1263 2124 1327 2134 1329 2134 2095 2124 2097 2109 2093 2081 920 2073 918 2073 789 2083 348 2075 346 2075 344 2075 342 2075 329 2081 330 2115"/>
                        </Shape>
                        <String CONTENT="to answer more acceptably in its new, entangled position. The experiment"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l29" HPOS="330" VPOS="2130" WIDTH="1763" HEIGHT="55" BASELINE="332 2169 2093 2173" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 2169 330 2181 2089 2185 2093 2173 2093 2144 2052 2132 2050 2132 2048 2132 1535 2142 1476 2132 1474 2132 1472 2132 1447 2144 1290 2144 1212 2130 1210 2130 1208 2130 1182 2140 1143 2130 1141 2130 1139 2130 1137 2130 1110 2140 1088 2130 1086 2130 1085 2130 1010 2140 985 2130 983 2130 981 2130 926 2140 783 2130 781 2130 779 2130 750 2140 669 2130 667 2130 616 2140 597 2130 595 2130 593 2130 591 2130 567 2142 436 2142 421 2130 419 2130 417 2130 415 2130 332 2138 332 2169"/>
