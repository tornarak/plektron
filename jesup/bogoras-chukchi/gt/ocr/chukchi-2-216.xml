                        </Shape>
                        <String CONTENT="the Reindeer and the Maritime Chukchee, and is employed in almost all cases"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l11" HPOS="323" VPOS="1051" WIDTH="1770" HEIGHT="59" BASELINE="325 1096 2093 1090" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="325 1096 325 1108 2089 1110 2093 1090 2089 1063 1792 1051 1790 1051 1733 1061 1684 1051 1682 1051 1604 1061 1527 1051 1525 1051 1523 1051 1498 1063 1182 1053 1180 1053 1179 1053 1177 1053 1161 1065 875 1065 836 1055 834 1055 832 1055 830 1055 808 1065 728 1055 726 1055 634 1065 552 1055 550 1055 481 1065 468 1055 466 1055 464 1055 364 1055 362 1055 360 1055 323 1067 325 1096"/>
                        </Shape>
                        <String CONTENT="of life. Once, while in a camp on the Wolverene River the night before a"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l12" HPOS="325" VPOS="1112" WIDTH="1766" HEIGHT="64" BASELINE="327 1159 2091 1151" TAGREFS="TYPE_5">
                        <Shape>
