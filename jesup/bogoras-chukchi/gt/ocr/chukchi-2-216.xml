                        </Shape>
                        <String CONTENT="great race, I was weighing some medicine on a small brass balance. A man"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l13" HPOS="327" VPOS="1173" WIDTH="1764" HEIGHT="58" BASELINE="329 1214 2091 1210" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="329 1214 329 1227 2087 1231 2091 1210 2089 1182 2072 1173 2070 1173 2068 1173 2066 1173 2064 1173 2036 1182 1915 1173 1913 1173 1839 1182 1811 1173 1809 1173 1807 1173 1762 1182 1737 1173 1735 1173 1733 1173 1731 1173 1729 1173 1713 1184 1557 1184 1468 1173 1466 1173 1464 1173 1439 1182 1388 1173 1386 1173 1288 1182 1255 1173 1253 1173 1251 1173 1249 1173 1229 1182 1214 1173 1212 1173 1210 1173 1208 1173 1206 1173 1169 1184 1012 1175 1010 1175 936 1184 902 1175 900 1175 898 1175 748 1184 683 1175 681 1175 679 1175 656 1184 569 1175 567 1175 566 1175 564 1175 548 1186 423 1186 366 1175 364 1175 362 1175 327 1186 329 1214"/>
                        </Shape>
                        <String CONTENT="who sat close by wanted to have a look at the balance, and when he took"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l14" HPOS="325" VPOS="1231" WIDTH="1768" HEIGHT="57" BASELINE="327 1276 2093 1272" TAGREFS="TYPE_5">
                        <Shape>
