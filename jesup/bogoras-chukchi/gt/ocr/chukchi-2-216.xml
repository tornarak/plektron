                        </Shape>
                        <String CONTENT="it from my hand, of course it began swinging. The Chukchee took this as"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l15" HPOS="325" VPOS="1290" WIDTH="1768" HEIGHT="69" BASELINE="327 1337 2093 1331" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1337 327 1349 440 1359 442 1359 444 1359 472 1349 2091 1349 2093 1331 2089 1302 1931 1302 1909 1290 1907 1290 1905 1290 1846 1300 1827 1290 1825 1290 1823 1290 1735 1300 1674 1290 1672 1290 1574 1300 1541 1290 1539 1290 1537 1290 1535 1290 1490 1302 1457 1292 1455 1292 1453 1292 1451 1292 1419 1302 1000 1292 998 1292 861 1304 501 1294 499 1294 497 1294 466 1304 397 1294 395 1294 325 1306 327 1337"/>
                        </Shape>
                        <String CONTENT="a sign that the balance wanted to be used for soothsaying. He took advantage"/>
                    </TextLine>

