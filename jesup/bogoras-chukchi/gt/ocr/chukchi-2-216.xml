                        </Shape>
                        <String CONTENT="Divination with suspended objects is well known also among the Asiatic"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l31" HPOS="329" VPOS="2250" WIDTH="1766" HEIGHT="58" BASELINE="330 2289 2095 2293" TAGREFS="TYPE_5">
                        <Shape>
