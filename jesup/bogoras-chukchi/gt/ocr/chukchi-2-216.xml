                        <Shape>
                            <Polygon POINTS="327 1394 327 1408 1886 1410 1889 1390 1886 1364 1288 1353 1286 1353 1284 1353 1257 1363 1220 1355 1218 1355 961 1364 746 1355 744 1355 742 1355 705 1364 667 1355 665 1355 663 1355 661 1355 660 1355 644 1364 613 1355 611 1355 609 1355 548 1364 513 1355 511 1355 509 1355 507 1355 481 1364 362 1355 360 1355 358 1355 325 1366 327 1394"/>
                        </Shape>
                        <String CONTENT="of this to ask it about the arrangement of the race for the morrow."/>
                    </TextLine>
<TextLine ID="mz_2-216_l17" HPOS="440" VPOS="1413" WIDTH="1655" HEIGHT="65" BASELINE="440 1453 2095 1453" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="440 1453 440 1464 797 1476 799 1476 863 1466 989 1476 991 1478 1145 1478 1145 1476 1147 1476 1149 1476 1163 1466 1276 1476 1278 1476 2095 1466 2095 1453 2095 1419 1786 1413 1784 1413 1717 1423 1627 1413 1625 1413 1623 1413 1596 1423 1566 1413 1564 1413 1562 1413 1513 1423 1416 1413 1414 1413 1139 1423 1059 1413 1057 1413 928 1423 893 1413 891 1413 889 1413 887 1413 885 1413 871 1425 585 1425 569 1413 567 1413 566 1413 440 1413 440 1453"/>
                        </Shape>
                        <String CONTENT="“Shall we arrange it together, or separately?” asked he. “Give a good"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l18" HPOS="325" VPOS="1472" WIDTH="1768" HEIGHT="57" BASELINE="327 1517 2093 1513" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1517 327 1529 2091 1529 2093 1513 2089 1484 1731 1472 1729 1472 1727 1472 1705 1482 1674 1472 1672 1472 1670 1472 1668 1472 1666 1472 1651 1482 701 1474 699 1474 605 1484 507 1474 505 1474 460 1484 446 1474 444 1474 442 1474 350 1474 348 1474 346 1474 325 1484 327 1517"/>
                        </Shape>
                        <String CONTENT="sign! Give a favorable omen!” There were two men desiring to arrange"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l19" HPOS="327" VPOS="1535" WIDTH="1766" HEIGHT="53" BASELINE="327 1574 2093 1574" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1574 327 1586 2091 1588 2093 1574 2093 1547 1404 1535 1402 1535 1400 1535 1363 1545 1280 1535 1278 1535 1276 1535 1249 1545 1102 1535 1100 1535 1047 1545 977 1535 975 1535 697 1545 614 1535 613 1535 403 1545 350 1535 348 1535 346 1535 327 1545 327 1574"/>
                        </Shape>
                        <String CONTENT="the race, and it was a question whether they should join their stakes, or not."/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l20" HPOS="330" VPOS="1596" WIDTH="1763" HEIGHT="54" BASELINE="332 1635 2093 1629" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="332 1635 332 1650 2091 1650 2093 1629 2087 1596 330 1598 332 1635"/>
                        </Shape>
                        <String CONTENT="The balance gave an answer in the required sense. The man asked several"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l21" HPOS="325" VPOS="1650" WIDTH="1766" HEIGHT="65" BASELINE="327 1690 2091 1695" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1690 325 1701 2087 1715 2091 1695 2089 1662 1858 1654 1856 1654 1754 1664 1701 1654 1700 1654 1698 1654 1696 1654 1680 1666 1555 1666 1504 1652 1502 1652 1500 1652 1498 1652 1472 1662 1447 1652 1445 1652 1231 1652 1229 1652 1045 1662 998 1652 996 1652 932 1662 816 1650 814 1650 327 1658 327 1690"/>
                        </Shape>
                        <String CONTENT="other questions, which were all answered favorably, because the unstable thing"/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l22" HPOS="327" VPOS="1713" WIDTH="1766" HEIGHT="55" BASELINE="327 1754 2093 1754" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="327 1754 327 1764 2091 1768 2093 1754 2093 1725 1737 1713 1735 1713 1733 1713 1696 1723 1664 1713 1662 1713 1660 1713 1658 1713 1621 1723 1574 1713 1572 1713 1570 1713 1545 1723 1445 1713 1443 1713 1359 1723 1323 1713 1322 1713 1320 1713 1179 1723 1055 1713 1053 1713 1002 1723 949 1713 947 1713 945 1713 904 1723 848 1713 846 1713 773 1723 722 1713 720 1713 718 1713 697 1723 665 1713 663 1713 661 1713 509 1723 477 1713 475 1713 473 1713 327 1723 327 1754"/>
                        </Shape>
                        <String CONTENT="swayed to and fro with the slightest motion of the hand of the performer."/>
                    </TextLine>

                    <TextLine ID="mz_2-216_l23" HPOS="330" VPOS="1780" WIDTH="1765" HEIGHT="49" BASELINE="330 1813 2095 1813" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="330 1813 330 1829 2095 1829 2095 1813 2095 1784 330 1780 330 1813"/>
                        </Shape>
                        <String CONTENT="Suddenly, when he put forward a question about the foot-race, the balance"/>
                    </TextLine>

