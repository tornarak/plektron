                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-216_l3" HPOS="430" VPOS="569" WIDTH="1661" HEIGHT="55" BASELINE="432 612 2091 609" TAGREFS="TYPE_5">
