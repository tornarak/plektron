                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_3-098_l3" HPOS="319" VPOS="562" WIDTH="1766" HEIGHT="60" BASELINE="319 605 2085 605" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2073 568 2054 568 2044 568 2032 572 1985 566 1976 566 1956 566 1937 566 1933 564 1902 572 1124 562 1122 562 1071 572 1038 562 1036 562 1034 562 954 572 923 562 921 562 919 562 871 572 837 562 836 562 834 562 832 562 810 574 670 574 652 562 650 562 648 562 524 562 522 562 520 562 483 572 455 562 454 562 452 562 450 562 418 572 362 562 360 562 358 562 319 572 319 605 319 622 2083 622 2085 605 2085 572 2077 568 2073 568"/>
                        </Shape>
                        <String CONTENT="with the Reindeer people, the rule of distribution is somewhat more complicated."/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l4" HPOS="321" VPOS="622" WIDTH="1764" HEIGHT="57" BASELINE="323 661 2085 665" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="323 661 321 675 2081 679 2085 665 2085 636 2048 624 2046 624 2044 624 2042 624 2005 634 1978 624 1976 624 1974 624 1872 634 1654 624 1652 624 1650 624 1617 634 1529 624 1527 624 1453 634 1381 624 1379 624 1208 634 1192 622 1190 622 1188 622 1186 622 1184 622 1145 634 1017 634 1001 622 999 622 997 622 995 622 861 632 323 624 323 661"/>
                        </Shape>
                        <String CONTENT="When thong-seals are abundant, each man takes a hide, beginning with the"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l5" HPOS="317" VPOS="685" WIDTH="1768" HEIGHT="56" BASELINE="317 726 2085 726" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 726 317 737 2083 741 2085 726 2083 687 798 695 717 685 715 685 664 695 533 685 531 685 530 685 528 685 512 696 317 696 317 726"/>
                        </Shape>
                        <String CONTENT="master. When they are scarce, the middle part of each hide is cut up and"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l6" HPOS="317" VPOS="741" WIDTH="1768" HEIGHT="59" BASELINE="319 784 2085 780" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 784 319 800 2083 800 2085 780 2083 753 2057 741 2056 741 2054 741 2052 741 2030 751 1999 741 1997 741 1995 741 1919 751 1872 741 1870 741 1868 741 1845 751 1816 741 1814 741 1812 741 1810 741 1808 741 1792 753 1644 753 1561 741 1559 741 1557 741 1555 741 1539 753 1428 753 1313 741 1311 741 1309 741 1270 751 1202 741 1200 741 1143 753 1087 743 1085 743 1038 753 740 743 738 743 572 753 448 743 446 743 317 755 319 784"/>
                        </Shape>
                        <String CONTENT="wound into two rolls of thong of medium thickness. The rest of the hide is"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l7" HPOS="319" VPOS="804" WIDTH="1764" HEIGHT="56" BASELINE="319 845 2083 845" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 845 319 858 2081 860 2083 845 2083 815 2022 804 2020 804 2019 804 1983 813 1870 804 1868 804 1818 813 1804 804 1802 804 1800 804 1798 804 1373 813 1317 804 1315 804 1313 804 1311 804 1295 815 1138 815 1122 804 1120 804 1118 804 906 804 904 804 902 804 900 804 886 813 853 804 851 804 849 804 635 813 545 804 543 804 493 813 415 804 413 804 319 813 319 845"/>
                        </Shape>
                        <String CONTENT="cut into eight parts and distributed among the crew as material for boot-soles."/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l8" HPOS="321" VPOS="864" WIDTH="1762" HEIGHT="62" BASELINE="321 905 2083 905" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="321 905 321 919 2081 926 2083 905 2083 876 1904 876 1870 864 1868 864 1867 864 1865 864 1831 874 1804 864 1802 864 1800 864 1728 874 1654 864 1652 864 1650 864 1611 874 1590 864 1588 864 1586 864 1584 864 1547 874 1514 864 1512 864 1510 864 1508 864 1475 874 1409 864 1407 864 1352 874 1233 864 1231 864 1180 874 321 866 321 905"/>
                        </Shape>
                        <String CONTENT="The thongs are given to the men one after another, beginning with the master,"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l9" HPOS="315" VPOS="921" WIDTH="1772" HEIGHT="58" BASELINE="317 965 2087 962" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 965 317 979 2085 977 2087 962 2083 932 2034 921 2032 921 1800 930 1773 921 1771 921 1769 921 1767 921 1730 930 1699 921 1697 921 1695 921 1693 921 1670 930 1562 921 1561 921 1500 930 1467 921 1465 921 1463 921 1393 930 1379 921 1377 921 1375 921 1284 921 1282 921 1280 921 1243 930 1210 921 1208 921 1206 921 1204 921 1173 932 1093 923 1091 923 1089 923 1056 932 939 923 937 923 853 932 818 923 816 923 814 923 713 932 666 923 664 923 662 923 621 932 607 923 606 923 604 923 415 923 413 923 315 934 317 965"/>
                        </Shape>
                        <String CONTENT="as described. In modern times, instead of this rule of distribution, the hides"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l10" HPOS="317" VPOS="983" WIDTH="1770" HEIGHT="56" BASELINE="317 1024 2087 1024" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1024 317 1039 2085 1039 2087 1024 2085 995 2030 983 2028 983 1981 993 1637 983 1635 983 1564 993 1514 983 1512 983 1510 983 1488 993 1440 983 1438 983 1280 993 1225 983 1223 983 1159 993 1106 983 1104 983 1103 983 1071 993 1015 983 1013 983 1011 983 1009 983 995 993 917 983 915 983 830 993 779 983 777 983 775 983 754 995 631 995 596 983 594 983 592 983 457 993 354 983 352 983 350 983 317 993 317 1024"/>
                        </Shape>
                        <String CONTENT="of thong-seals are often taken by those hunters who have killed the respective"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l11" HPOS="317" VPOS="1043" WIDTH="1768" HEIGHT="55" BASELINE="317 1084 2085 1084" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1084 317 1096 2083 1098 2085 1084 2085 1053 2065 1043 2063 1043 2061 1043 2059 1043 2026 1053 956 1043 954 1043 865 1053 787 1043 785 1043 783 1043 781 1043 765 1055 664 1055 567 1043 565 1043 487 1053 452 1043 450 1043 448 1043 446 1043 426 1053 376 1043 374 1043 317 1053 317 1084"/>
                        </Shape>
                        <String CONTENT="animals, which are thus excluded from the common stock. This new way is"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l12" HPOS="315" VPOS="1102" WIDTH="1737" HEIGHT="58" BASELINE="317 1145 2052 1141" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1145 317 1160 2050 1156 2052 1141 2050 1114 2028 1102 2026 1102 2024 1102 2022 1102 1997 1112 1796 1102 1794 1102 1792 1102 1790 1102 1773 1114 1658 1114 1631 1102 1629 1102 1627 1102 1625 1102 1623 1102 1609 1114 1488 1114 1455 1102 1453 1102 1451 1102 1243 1112 1210 1102 1208 1102 1206 1102 1058 1114 592 1104 590 1104 315 1115 317 1145"/>
                        </Shape>
                        <String CONTENT="not approved by public opinion; still it is more and more frequently adopted."/>
                    </TextLine>
<TextLine ID="mz_3-098_l13" HPOS="426" VPOS="1160" WIDTH="1661" HEIGHT="65" BASELINE="428 1199 2087 1203" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="428 1199 426 1213 469 1225 471 1225 473 1225 2085 1217 2087 1203 2087 1174 2063 1162 2061 1162 2059 1162 1966 1172 1898 1162 1896 1162 1894 1162 1857 1174 1707 1174 1689 1162 1687 1162 1685 1162 1683 1162 1681 1162 1648 1172 1629 1162 1627 1162 1625 1162 1623 1162 1599 1172 1576 1162 1574 1162 1572 1162 1570 1162 1545 1172 1477 1162 1475 1162 1473 1162 1442 1174 1264 1174 1249 1160 1247 1160 1245 1160 1243 1160 1241 1160 1214 1170 1149 1160 1147 1160 1145 1160 1116 1170 428 1164 428 1199"/>
                        </Shape>
                        <String CONTENT="With the whale, the meat, as has been mentioned, belongs to the whole"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l14" HPOS="315" VPOS="1230" WIDTH="1772" HEIGHT="57" BASELINE="317 1260 2087 1264" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1260 315 1273 333 1285 335 1285 337 1285 339 1285 1157 1275 1239 1285 1241 1285 1611 1277 1777 1287 1779 1287 1781 1287 1783 1287 1798 1277 2085 1277 2087 1264 2085 1234 317 1230 317 1260"/>
                        </Shape>
                        <String CONTENT="village, generally to whoever wants to take part in the carving. The bones"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l15" HPOS="315" VPOS="1281" WIDTH="1772" HEIGHT="59" BASELINE="317 1324 2087 1320" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1324 317 1338 2083 1340 2087 1320 2083 1293 1748 1281 1746 1281 1668 1291 1588 1281 1586 1281 1523 1291 1481 1281 1479 1281 1477 1281 1475 1281 1473 1281 1459 1291 1428 1281 1426 1281 1424 1281 1422 1281 1393 1291 1364 1281 1362 1281 1360 1281 1276 1291 1202 1281 1200 1281 1198 1281 1196 1281 1177 1293 1132 1283 1130 1283 1128 1283 1091 1293 715 1283 713 1283 565 1293 485 1283 483 1283 481 1283 459 1293 352 1283 350 1283 348 1283 315 1295 317 1324"/>
                        </Shape>
                        <String CONTENT="of the jaw are taken by the one who first noticed the whale. The whalebone"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l16" HPOS="315" VPOS="1343" WIDTH="1772" HEIGHT="57" BASELINE="317 1384 2087 1381" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1384 317 1400 2085 1400 2087 1381 2081 1343 315 1347 317 1384"/>
                        </Shape>
                        <String CONTENT="is divided equally among all the participants of the hunt, and is distributed"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l17" HPOS="315" VPOS="1400" WIDTH="1768" HEIGHT="58" BASELINE="317 1443 2083 1439" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1443 317 1458 2081 1458 2083 1439 2081 1412 2038 1400 2036 1400 2034 1400 1972 1410 1929 1400 1927 1400 1925 1400 1874 1410 1810 1400 1808 1400 1755 1410 1707 1400 1705 1400 1703 1400 1676 1410 1627 1400 1625 1400 1557 1412 1409 1412 1387 1400 1385 1400 1383 1400 1184 1412 1151 1402 1149 1402 1147 1402 1145 1402 1116 1412 1065 1402 1064 1402 1062 1402 1027 1412 315 1408 317 1443"/>
                        </Shape>
                        <String CONTENT="by the master, who reserves the best and longest slabs for himself. The"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l18" HPOS="313" VPOS="1460" WIDTH="1772" HEIGHT="59" BASELINE="315 1505 2085 1499" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="315 1505 315 1519 2083 1517 2085 1499 2081 1470 2009 1460 2007 1460 2005 1460 2003 1460 1987 1472 1816 1472 1785 1460 1783 1460 1781 1460 1677 1470 1627 1460 1625 1460 1578 1470 1527 1460 1525 1460 1523 1460 1488 1472 1219 1462 1218 1462 1087 1472 937 1462 935 1462 810 1474 479 1464 477 1464 313 1474 315 1505"/>
                        </Shape>
                        <String CONTENT="man who dealt the mortal blow, usually the one who sits at the prow, has"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l19" HPOS="315" VPOS="1521" WIDTH="1772" HEIGHT="56" BASELINE="317 1564 2087 1560" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1564 317 1577 2085 1575 2087 1560 2083 1533 1863 1533 1835 1521 1833 1521 1831 1521 1829 1521 1789 1531 1761 1521 1759 1521 1757 1521 1672 1531 1592 1521 1590 1521 1588 1521 1586 1521 1570 1533 1358 1533 1305 1521 1303 1521 1247 1531 1204 1521 1202 1521 1200 1521 1198 1521 1167 1533 633 1523 631 1523 629 1523 592 1533 559 1523 557 1523 555 1523 553 1523 530 1533 432 1523 430 1523 428 1523 395 1533 335 1523 333 1523 331 1523 329 1523 315 1531 317 1564"/>
                        </Shape>
                        <String CONTENT="the right to choose his portion next after the master. When the boat comes"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l20" HPOS="317" VPOS="1583" WIDTH="1768" HEIGHT="57" BASELINE="317 1622 2085 1622" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1622 317 1638 2083 1640 2085 1622 2085 1593 2056 1583 2054 1583 2052 1583 1968 1593 1475 1583 1473 1583 1416 1593 1360 1583 1358 1583 1255 1593 1149 1583 1147 1583 1145 1583 1118 1595 958 1595 797 1583 795 1583 793 1583 760 1595 572 1595 514 1583 512 1583 422 1593 366 1583 364 1583 317 1593 317 1622"/>
                        </Shape>
                        <String CONTENT="ashore, the master will take some of the smaller slabs, which are not used in"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l21" HPOS="313" VPOS="1640" WIDTH="1115" HEIGHT="58" BASELINE="315 1685 1428 1681" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="315 1685 315 1696 1424 1698 1428 1681 1424 1653 1348 1653 1323 1640 1321 1640 1319 1640 1317 1640 1288 1651 1256 1640 1255 1640 1253 1640 1251 1640 1225 1653 1153 1653 1124 1640 1122 1640 1120 1640 1118 1640 1116 1640 1101 1651 592 1642 590 1642 588 1642 586 1642 569 1653 537 1642 535 1642 533 1642 440 1653 397 1642 395 1642 393 1642 391 1642 389 1642 389 1644 379 1651 331 1644 329 1644 327 1644 325 1644 313 1651 315 1685"/>
                        </Shape>
                        <String CONTENT="trade, and distribute them among the onlookers."/>
                    </TextLine>
<TextLine ID="mz_3-098_l22" HPOS="424" VPOS="1704" WIDTH="1663" HEIGHT="59" BASELINE="426 1739 2087 1743" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="426 1739 424 1755 434 1763 436 1763 438 1763 440 1763 2085 1755 2087 1743 2085 1712 426 1704 426 1739"/>
                        </Shape>
                        <String CONTENT="I was told that in former times, as many as fifty years ago, after each"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l23" HPOS="317" VPOS="1772" WIDTH="1768" HEIGHT="53" BASELINE="317 1801 2085 1801" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1801 317 1815 2083 1825 2085 1801 2085 1772 317 1772 317 1801"/>
                        </Shape>
                        <String CONTENT="successful catch, a large part of the best whalebone was distributed among"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l24" HPOS="317" VPOS="1821" WIDTH="1770" HEIGHT="56" BASELINE="317 1864 2087 1864" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 1864 317 1876 2083 1877 2087 1864 2083 1825 1652 1831 1588 1821 1586 1821 1584 1821 1564 1831 1539 1821 1537 1821 1535 1821 1461 1831 1387 1821 1385 1821 1307 1831 1280 1821 1278 1821 1276 1821 1202 1831 1122 1821 1120 1821 1118 1821 1116 1821 1101 1833 997 1833 941 1821 939 1821 884 1831 785 1821 783 1821 662 1831 498 1821 496 1821 494 1821 467 1831 418 1821 416 1821 415 1821 393 1831 348 1821 346 1821 344 1821 317 1831 317 1864"/>
                        </Shape>
                        <String CONTENT="all the inhabitants of the village. The price of the whalebone was lower, and"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l25" HPOS="317" VPOS="1879" WIDTH="1768" HEIGHT="61" BASELINE="319 1922 2085 1918" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 1922 319 1938 2081 1940 2085 1918 2079 1881 1440 1889 1407 1879 1405 1879 1403 1879 1401 1879 1373 1889 1344 1879 1342 1879 1340 1879 1338 1879 1336 1879 1323 1889 1278 1879 1276 1879 1274 1879 1251 1889 1214 1879 1212 1879 1210 1879 1208 1879 1182 1893 1087 1893 1023 1881 1021 1881 1019 1881 976 1891 890 1881 888 1881 830 1891 646 1881 645 1881 643 1881 621 1893 473 1893 354 1881 352 1881 350 1881 317 1893 319 1922"/>
                        </Shape>
                        <String CONTENT="whales more abundant. The rich people had also an old supply not yet sold"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l26" HPOS="317" VPOS="1944" WIDTH="1768" HEIGHT="52" BASELINE="319 1983 2085 1979" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 1983 319 1996 2083 1994 2085 1979 2081 1952 335 1944 333 1944 331 1944 329 1944 317 1950 319 1983"/>
                        </Shape>
                        <String CONTENT="to the Americans. At present good whalebone is too valuable and rare to"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l27" HPOS="317" VPOS="2006" WIDTH="1768" HEIGHT="53" BASELINE="317 2041 2085 2041" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="317 2041 317 2055 2083 2059 2085 2041 2085 2010 317 2006 317 2041"/>
                        </Shape>
                        <String CONTENT="be thus distributed. This last information was given me by a native, for my"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l28" HPOS="317" VPOS="2061" WIDTH="1768" HEIGHT="64" BASELINE="319 2106 2085 2102" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 2106 319 2125 2083 2125 2085 2102 2081 2072 1985 2061 1983 2061 1981 2061 1952 2070 1927 2061 1925 2061 1923 2061 1740 2070 1701 2061 1699 2061 1697 2061 1695 2061 1693 2061 1677 2072 1586 2072 1570 2061 1568 2061 1566 2061 1449 2061 1447 2061 1446 2061 1426 2070 1395 2061 1393 2061 1391 2061 1389 2061 1366 2070 1278 2061 1276 2061 1274 2061 1241 2070 1163 2063 1161 2063 1159 2063 1157 2063 1141 2072 376 2063 374 2063 317 2074 319 2106"/>
                        </Shape>
                        <String CONTENT="guidance. In most cases, however, the whale is killed, not by a single boat,"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l29" HPOS="317" VPOS="2127" WIDTH="1768" HEIGHT="49" BASELINE="319 2162 2085 2158" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 2162 319 2176 2083 2172 2085 2158 2081 2131 317 2127 319 2162"/>
                        </Shape>
                        <String CONTENT="but by two, three, or several boats. One of the boats, that has acted fore-"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l30" HPOS="317" VPOS="2180" WIDTH="1764" HEIGHT="58" BASELINE="319 2222 2081 2219" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="319 2222 319 2238 2079 2234 2081 2219 2077 2180 1241 2180 1239 2180 1188 2189 459 2182 457 2182 317 2191 319 2222"/>
                        </Shape>
                        <String CONTENT="most, is considered as the “principal boat,” the others are only “assistant boats.”"/>
                    </TextLine>

                    <TextLine ID="mz_3-098_l31" HPOS="323" VPOS="2240" WIDTH="1762" HEIGHT="64" BASELINE="323 2283 2085 2283" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="323 2283 323 2295 2083 2304 2085 2283 2085 2254 1956 2254 1939 2240 1937 2240 1935 2240 1933 2240 1843 2252 1623 2240 1621 2240 1619 2240 1588 2252 1531 2240 1529 2240 1527 2240 1488 2252 1461 2240 1459 2240 1457 2240 1340 2252 1276 2240 1274 2240 1272 2240 1239 2254 1161 2254 1140 2240 1138 2240 1136 2240 1134 2240 1132 2240 1097 2252 1062 2240 1060 2240 1058 2240 1056 2240 1030 2250 921 2240 919 2240 917 2240 915 2240 898 2252 853 2240 851 2240 849 2240 847 2240 820 2252 715 2240 613 2240 611 2240 609 2240 576 2252 506 2240 504 2240 502 2240 469 2252 323 2244 323 2283"/>
                        </Shape>
                        <String CONTENT="Then the whalebone is divided along the middle line into two equal parts,"/>
                    </TextLine>

