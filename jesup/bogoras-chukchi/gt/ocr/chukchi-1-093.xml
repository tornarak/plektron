                            <Polygon POINTS="1531 608 1510 608 1488 608 1466 608 1445 608 1423 608 1401 608 1380 608 1358 608 1336 608 1315 608 1293 608 1271 608 1250 608 1228 608 1206 608 1185 608 1163 608 1141 608 1120 608 1098 608 1076 608 1055 608 1033 608 1012 608 990 608 968 608 947 608 947 643 947 662 1566 662 1566 643 1566 608 1553 608 1531 608"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l2" HPOS="2084" VPOS="610" WIDTH="28" HEIGHT="65" BASELINE="2084 649 2112 649" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2105 619 2084 610 2084 649 2084 666 2107 675 2112 649 2112 621 2105 619"/>
                        </Shape>
                        <String CONTENT="67"/>
                    </TextLine>
<TextLine ID="mz_1-093_l3" HPOS="366" VPOS="705" WIDTH="1774" HEIGHT="74" BASELINE="368 753 2140 749" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 753 368 768 775 779 778 779 780 779 782 779 797 768 2138 768 2140 749 2135 718 1352 705 1349 705 1243 718 1228 708 1226 708 1224 708 1222 708 1219 708 1193 718 1094 708 1092 708 996 718 970 708 968 708 966 708 908 718 851 708 849 708 726 718 492 708 490 708 487 708 485 708 472 718 444 708 442 708 440 708 366 721 368 753"/>
                        </Shape>
                        <String CONTENT="and Rɪrkaiˊpɪyan; still others from beyond Kuluˊči Bay. Lively barter goes"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l4" HPOS="373" VPOS="783" WIDTH="1500" HEIGHT="46" BASELINE="373 812 1873 812" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="373 812 373 829 1873 829 1873 812 1873 783 373 783 373 812"/>
                        </Shape>
                        <String CONTENT="on for two weeks; then the traders start on their return journey."/>
                    </TextLine>
<TextLine ID="mz_1-093_l5" HPOS="474" VPOS="829" WIDTH="1668" HEIGHT="60" BASELINE="477 874 2142 870" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="477 874 477 889 2140 885 2142 870 2138 842 2064 829 2062 829 2006 840 1928 829 1925 829 1923 829 1895 840 1845 829 1843 829 1841 829 1795 840 1722 829 1720 829 1668 840 1622 829 1620 829 1618 829 1616 829 1581 840 474 840 477 874"/>
                        </Shape>
                        <String CONTENT="In former times there were richer men among the Kavraˊlɪt than there"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l6" HPOS="366" VPOS="900" WIDTH="1776" HEIGHT="50" BASELINE="368 933 2142 928" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 933 368 950 2140 946 2142 928 2135 900 366 902 368 933"/>
                        </Shape>
                        <String CONTENT="are at present. About forty years ago one of them bought horses and made"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l7" HPOS="368" VPOS="959" WIDTH="1772" HEIGHT="56" BASELINE="370 989 2140 993" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 989 368 1002 405 1015 407 1015 409 1015 2138 1006 2140 993 2138 963 370 959 370 989"/>
                        </Shape>
                        <String CONTENT="summer trips between the Reindeer camps, carrying his wares on horseback."/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l8" HPOS="368" VPOS="1011" WIDTH="1772" HEIGHT="58" BASELINE="370 1054 2140 1050" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1054 370 1069 2138 1065 2140 1050 2135 1019 388 1011 386 1011 383 1011 381 1011 368 1017 370 1054"/>
                        </Shape>
                        <String CONTENT="Another one, at his own request, was sent to Yakutsk by the officials of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l9" HPOS="370" VPOS="1078" WIDTH="1770" HEIGHT="52" BASELINE="370 1112 2140 1112" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1112 370 1130 2140 1130 2140 1112 2140 1078 370 1078 370 1112"/>
                        </Shape>
                        <String CONTENT="Kolyma district. He visited the Russian governor at Yakutsk, and received"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l10" HPOS="370" VPOS="1130" WIDTH="1770" HEIGHT="58" BASELINE="370 1171 2140 1171" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1171 370 1188 2140 1188 2140 1171 2140 1141 2099 1130 2097 1130 2094 1130 2092 1130 2066 1141 1705 1130 1702 1130 1700 1130 1661 1141 1631 1130 1629 1130 1627 1130 1624 1130 1592 1141 1507 1130 1505 1130 1330 1141 1295 1130 1293 1130 1291 1130 1124 1141 1096 1130 1094 1130 1092 1130 1022 1141 951 1130 949 1130 864 1141 806 1130 804 1130 661 1141 583 1130 581 1130 578 1130 550 1141 522 1130 520 1130 518 1130 516 1130 492 1141 392 1130 390 1130 388 1130 386 1130 370 1138 370 1171"/>
                        </Shape>
                        <String CONTENT="through him a gold medal and a parade coat adorned with silver lace. At"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l11" HPOS="368" VPOS="1188" WIDTH="1774" HEIGHT="70" BASELINE="370 1234 2142 1229" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1234 370 1258 2125 1258 2125 1255 2127 1255 2129 1255 2142 1245 2142 1229 2138 1199 1284 1188 1282 1188 1180 1199 723 1190 721 1190 368 1201 370 1234"/>
                        </Shape>
                        <String CONTENT="present none of them equals in wealth Kuvaˊr and the other Eskimo traders"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l12" HPOS="370" VPOS="1249" WIDTH="470" HEIGHT="58" BASELINE="370 1292 840 1292" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1292 370 1307 840 1307 840 1292 840 1262 542 1249 539 1249 490 1260 466 1249 464 1249 461 1249 459 1249 457 1249 440 1260 414 1249 412 1249 409 1249 407 1249 370 1260 370 1292"/>
                        </Shape>
                        <String CONTENT="of the Pacific shore."/>
                    </TextLine>
<TextLine ID="mz_1-093_l13" HPOS="474" VPOS="1322" WIDTH="1666" HEIGHT="46" BASELINE="474 1353 2140 1353" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 1353 474 1368 2140 1368 2140 1353 2140 1322 474 1322 474 1353"/>
                        </Shape>
                        <String CONTENT="Several other regular trips, but of shorter range, are made for the pur-"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l14" HPOS="368" VPOS="1383" WIDTH="1770" HEIGHT="52" BASELINE="368 1413 2138 1413" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 1413 368 1435 2138 1431 2138 1413 2138 1383 368 1383 368 1413"/>
                        </Shape>
                        <String CONTENT="pose of trading. In the Anui country Russian traders travel among the camps,"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l15" HPOS="368" VPOS="1435" WIDTH="1772" HEIGHT="54" BASELINE="370 1472 2140 1468" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1472 370 1489 2138 1485 2140 1468 2133 1435 368 1437 370 1472"/>
                        </Shape>
                        <String CONTENT="in winter with dog-teams and in summer with horses, collecting chiefly small"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l16" HPOS="366" VPOS="1487" WIDTH="1774" HEIGHT="61" BASELINE="368 1532 2140 1528" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 1532 368 1548 2138 1543 2140 1528 2138 1500 2101 1487 2099 1487 2097 1487 2094 1487 2073 1498 1906 1487 1904 1487 1841 1498 1826 1487 1824 1487 1821 1487 1819 1487 1817 1487 1793 1498 1767 1487 1765 1487 1763 1487 1698 1498 1629 1487 1627 1487 1501 1498 1468 1487 1466 1487 1464 1487 1462 1487 1425 1498 1367 1487 1365 1487 1362 1487 1317 1498 1254 1487 1252 1487 1250 1487 1248 1487 1232 1500 769 1489 767 1489 765 1489 728 1500 691 1489 689 1489 687 1489 598 1500 507 1489 505 1489 503 1489 479 1500 383 1489 381 1489 379 1489 377 1489 366 1496 368 1532"/>
                        </Shape>
                        <String CONTENT="fawn-skins and white and red foxes. The Russian traders of the Anadyr do"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l17" HPOS="370" VPOS="1550" WIDTH="1770" HEIGHT="60" BASELINE="370 1591 2140 1591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1591 370 1606 2138 1610 2140 1591 2140 1563 1744 1550 1741 1550 1655 1561 1594 1550 1592 1550 1590 1550 1588 1550 1570 1563 1189 1563 1150 1550 1148 1550 1146 1550 1144 1550 1111 1561 1033 1550 1031 1550 1029 1550 1001 1561 970 1550 968 1550 966 1550 836 1561 799 1550 797 1550 795 1550 732 1561 700 1550 697 1550 695 1550 600 1561 546 1550 544 1550 370 1561 370 1591"/>
                        </Shape>
                        <String CONTENT="not make such trips, and they do not go even as far as Holy Cross Bay;"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l18" HPOS="370" VPOS="1617" WIDTH="1768" HEIGHT="50" BASELINE="370 1652 2138 1652" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1652 370 1667 2135 1667 2138 1652 2135 1621 370 1617 370 1652"/>
                        </Shape>
                        <String CONTENT="indeed, neither the Russian traders nor the Cossack invaders cared to go"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l19" HPOS="368" VPOS="1667" WIDTH="1772" HEIGHT="60" BASELINE="370 1712 2140 1708" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1712 370 1727 2138 1723 2140 1708 2135 1680 2068 1667 2066 1667 2064 1667 2038 1678 1951 1667 1949 1667 1947 1667 1921 1678 1858 1667 1856 1667 1854 1667 1821 1678 1759 1667 1756 1667 1754 1667 1715 1678 1692 1667 1689 1667 1687 1667 1685 1667 1650 1678 1611 1667 1609 1667 1607 1667 1605 1667 1575 1678 1514 1667 1512 1667 1284 1678 1256 1667 1254 1667 1252 1667 1250 1667 1215 1680 1102 1669 1100 1669 1098 1669 1063 1680 918 1669 916 1669 914 1669 871 1680 836 1669 834 1669 832 1669 830 1669 801 1680 691 1669 689 1669 687 1669 652 1680 598 1669 596 1669 594 1669 559 1680 535 1669 533 1669 531 1669 368 1675 370 1712"/>
                        </Shape>
                        <String CONTENT="beyond the forest border, at least when travelling by land. On the other"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l20" HPOS="368" VPOS="1738" WIDTH="1772" HEIGHT="52" BASELINE="370 1773 2140 1766" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1773 370 1790 2138 1784 2140 1766 2135 1738 368 1738 370 1773"/>
                        </Shape>
                        <String CONTENT="hand, petty traders go in the winter-time with dog-sledges from every native"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l21" HPOS="368" VPOS="1797" WIDTH="1770" HEIGHT="58" BASELINE="370 1829 2138 1833" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="370 1829 368 1844 383 1855 386 1855 388 1855 390 1855 2135 1846 2138 1833 2135 1801 370 1797 370 1829"/>
                        </Shape>
                        <String CONTENT="village of the Chukchee-Peninsula to the Reindeer camps, collecting large"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l22" HPOS="366" VPOS="1851" WIDTH="1774" HEIGHT="56" BASELINE="368 1892 2140 1888" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 1892 368 1907 2138 1903 2140 1888 2135 1859 379 1851 377 1851 375 1851 373 1851 373 1853 366 1857 368 1892"/>
                        </Shape>
                        <String CONTENT="fawn-skins and ready-made garments. Later in the summer whole squadrons"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l23" HPOS="366" VPOS="1920" WIDTH="1774" HEIGHT="48" BASELINE="366 1950 2140 1950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 1950 366 1968 2140 1968 2140 1950 2140 1920 366 1920 366 1950"/>
                        </Shape>
                        <String CONTENT="of boats start from Indian Point on their journey to Holy Cross and St. Law-"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l24" HPOS="366" VPOS="1981" WIDTH="1774" HEIGHT="49" BASELINE="366 2011 2140 2011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2011 366 2026 2138 2030 2140 2011 2140 1981 366 1981 366 2011"/>
                        </Shape>
                        <String CONTENT="rence Bays, where the Reindeer people perform the ceremonial slaughtering"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l25" HPOS="366" VPOS="2041" WIDTH="1774" HEIGHT="46" BASELINE="366 2072 2140 2072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2072 366 2087 2140 2087 2140 2072 2140 2041 366 2041 366 2072"/>
                        </Shape>
                        <String CONTENT="of the season. They return heavily laden with skins and meat. Some of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l26" HPOS="366" VPOS="2098" WIDTH="1774" HEIGHT="49" BASELINE="368 2132 2140 2128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 2132 368 2147 2138 2143 2140 2128 2135 2100 366 2098 368 2132"/>
                        </Shape>
                        <String CONTENT="boats go to the Anadyr and proceed upstream to take part in the large rein-"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l27" HPOS="364" VPOS="2150" WIDTH="1776" HEIGHT="58" BASELINE="366 2193 2140 2188" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2193 366 2208 2138 2206 2140 2188 2135 2158 390 2150 388 2150 386 2150 364 2158 366 2193"/>
                        </Shape>
                        <String CONTENT="deer-hunts. Twenty years ago they proceeded along the seacoast to the Telqäˊp"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l28" HPOS="364" VPOS="2210" WIDTH="1778" HEIGHT="59" BASELINE="366 2253 2142 2247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2253 366 2269 2140 2262 2142 2247 2135 2210 364 2223 366 2253"/>
                        </Shape>
                        <String CONTENT="summer camps, and as far as the Kerek villages. Here, near Capes Barykoff"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l29" HPOS="364" VPOS="2264" WIDTH="1778" HEIGHT="63" BASELINE="366 2314 2142 2308" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2314 366 2327 2142 2321 2142 2308 2138 2277 2086 2264 2084 2264 2081 2264 2058 2277 1945 2277 1928 2264 1925 2264 1923 2264 1921 2264 1919 2264 1917 2264 1902 2277 1778 2277 1661 2264 1659 2264 1601 2275 1575 2264 1572 2264 1570 2264 1507 2277 1484 2266 1481 2266 1479 2266 1477 2266 1429 2277 1148 2266 1146 2266 1068 2277 1016 2266 1014 2266 949 2279 440 2269 438 2269 364 2282 366 2314"/>
                        </Shape>
                        <String CONTENT="and Navarin, was the southern limit of the Chukchee-Eskimo trade on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l30" HPOS="366" VPOS="2327" WIDTH="306" HEIGHT="61" BASELINE="368 2368 672 2372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 2368 366 2383 667 2388 672 2372 669 2342 522 2342 494 2327 492 2327 490 2327 368 2336 368 2368"/>
                        </Shape>
                        <String CONTENT="Pacific coast."/>
                    </TextLine>
<TextLine ID="mz_1-093_l31" HPOS="472" VPOS="2383" WIDTH="1668" HEIGHT="72" BASELINE="474 2433 2140 2427" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="474 2433 481 2455 487 2446 905 2455 908 2455 2138 2442 2140 2427 2135 2396 2027 2383 2025 2383 2023 2383 1986 2394 1969 2383 1967 2383 1964 2383 1962 2383 1960 2383 1932 2394 1908 2383 1906 2383 1904 2383 1902 2383 1899 2383 1884 2396 1746 2396 1720 2383 1718 2383 1715 2383 1713 2383 1711 2383 1698 2394 1672 2383 1670 2383 1668 2383 1581 2396 1540 2385 1538 2385 1536 2385 1533 2385 1510 2396 1475 2385 1473 2385 1471 2385 1313 2396 1280 2385 1278 2385 1276 2385 1274 2385 1271 2385 1261 2394 1250 2385 1248 2385 1245 2385 1150 2385 1148 2385 1146 2385 1105 2396 1029 2385 1027 2385 1025 2385 1022 2385 1003 2398 793 2388 791 2388 788 2388 743 2398 526 2388 524 2388 472 2396 474 2433"/>
                        </Shape>
                        <String CONTENT="UNITS AND PRICES. — The Chukchee trade is carried on exclusively in"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l32" HPOS="366" VPOS="2444" WIDTH="1772" HEIGHT="74" BASELINE="368 2494 2138 2485" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 2494 368 2507 706 2518 708 2518 710 2518 713 2518 730 2507 1170 2515 1172 2515 1174 2515 1176 2515 1191 2502 1317 2502 1540 2502 1555 2513 1557 2513 1559 2513 1562 2513 1720 2500 1917 2511 1919 2511 1921 2511 1962 2500 1977 2511 1980 2511 1982 2511 1984 2511 2135 2502 2138 2485 2133 2457 1793 2457 1750 2444 1748 2444 1746 2444 1646 2457 1345 2446 1343 2446 1341 2446 1306 2457 1252 2446 1250 2446 1248 2446 1204 2459 1029 2448 1027 2448 955 2459 890 2448 888 2448 808 2461 771 2450 769 2450 767 2450 765 2450 732 2461 622 2450 620 2450 366 2457 368 2494"/>
                        </Shape>
                        <String CONTENT="barter. Money is quite unknown. The Reindeer people have not even a"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l33" HPOS="366" VPOS="2507" WIDTH="1772" HEIGHT="60" BASELINE="368 2552 2138 2546" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="368 2552 368 2567 2135 2563 2138 2546 2133 2515 970 2507 968 2507 966 2507 964 2507 951 2518 461 2509 459 2509 366 2520 368 2552"/>
                        </Shape>
                        <String CONTENT="word for it, and call it keliˊtul (“a piece of variegated”), which name may be"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l34" HPOS="364" VPOS="2563" WIDTH="1774" HEIGHT="76" BASELINE="366 2615 2138 2606" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2615 366 2628 444 2639 446 2639 743 2628 806 2639 808 2639 966 2626 1124 2637 1126 2637 1128 2637 1176 2626 1488 2634 1490 2634 1761 2621 2109 2632 2112 2632 2114 2632 2138 2619 2138 2606 2133 2574 1871 2563 1869 2563 1867 2563 1841 2574 1780 2563 1778 2563 1776 2563 1735 2574 1692 2563 1689 2563 1687 2563 1685 2563 1648 2576 1369 2565 1367 2565 1291 2576 1250 2565 1248 2565 1245 2565 1243 2565 1196 2578 877 2567 875 2567 873 2567 847 2578 448 2570 446 2570 364 2580 366 2615"/>
                        </Shape>
                        <String CONTENT="applied also to any piece of paper with writing on it. The Maritime Chuk-"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l35" HPOS="364" VPOS="2639" WIDTH="1429" HEIGHT="47" BASELINE="364 2669 1793 2669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="364 2669 364 2686 1793 2686 1793 2669 1793 2639 364 2639 364 2669"/>
                        </Shape>
                        <String CONTENT="chee call it manêˊman (from English “money” of the whalers)."/>
                    </TextLine>
<TextLine ID="mz_1-093_l36" HPOS="474" VPOS="2697" WIDTH="1668" HEIGHT="48" BASELINE="477 2732 2142 2728" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="477 2732 477 2745 2140 2741 2142 2728 2138 2697 474 2697 477 2732"/>
                        </Shape>
                        <String CONTENT="The unit of value in Russian trade remains a bundle of tobacco “not"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l37" HPOS="364" VPOS="2756" WIDTH="1778" HEIGHT="49" BASELINE="366 2793 2142 2788" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2793 366 2805 2142 2801 2142 2788 2135 2756 364 2758 366 2793"/>
                        </Shape>
                        <String CONTENT="tampered with,” because the traders often abstract a few leaves and replace"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l38" HPOS="364" VPOS="2812" WIDTH="1776" HEIGHT="63" BASELINE="366 2851 2140 2847" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2851 366 2864 1243 2875 1245 2875 1248 2875 1274 2864 2120 2873 2122 2873 2125 2873 2127 2873 2140 2862 2140 2847 2133 2812 364 2818 366 2851"/>
                        </Shape>
                        <String CONTENT="the bindings. In recent years brick-tea has also come into use as a standard"/>
                    </TextLine>

                    <TextLine ID="mz_1-093_l39" HPOS="364" VPOS="2875" WIDTH="1694" HEIGHT="52" BASELINE="366 2912 2058 2907" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="366 2912 366 2927 2055 2922 2058 2907 2051 2875 364 2877 366 2912"/>
                        </Shape>
