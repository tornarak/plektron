    <Layout>
        <Page WIDTH="2781" HEIGHT="3866" PHYSICAL_IMG_NR="0" ID="page_0">
            <PrintSpace HPOS="0" VPOS="0" WIDTH="2781" HEIGHT="3866">
                <TextBlock ID="text_1-046" HPOS="568" VPOS="621" WIDTH="1780" HEIGHT="2643"><TextLine ID="mz_1-046_l1" HPOS="1148" VPOS="625" WIDTH="615" HEIGHT="54" BASELINE="1150 658 1763 662" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1756 630 1744 625 1170 625 1152 640 1150 658 1148 675 1759 679 1763 662 1761 658 1756 630"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l2" HPOS="576" VPOS="621" WIDTH="70" HEIGHT="58" BASELINE="576 666 646 666" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 666 576 679 646 677 646 666 646 632 624 621 622 621 620 621 617 621 576 632 576 666"/>
                        </Shape>
                        <String CONTENT="26"/>
                    </TextLine>
<TextLine ID="mz_1-046_l3" HPOS="568" VPOS="738" WIDTH="1773" HEIGHT="52" BASELINE="570 773 2341 768" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="570 773 570 790 2339 786 2341 768 2326 738 568 738 570 773"/>
                        </Shape>
                        <String CONTENT="being that it may not trespass on any ground already occupied by others for"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l4" HPOS="570" VPOS="799" WIDTH="455" HEIGHT="58" BASELINE="572 829 1025 833" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="572 829 570 842 890 857 892 857 1022 846 1025 833 1022 803 572 799 572 829"/>
                        </Shape>
                        <String CONTENT="the season running."/>
                    </TextLine>
<TextLine ID="mz_1-046_l5" HPOS="678" VPOS="846" WIDTH="1243" HEIGHT="61" BASELINE="680 892 1921 887" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="680 892 680 907 1919 902 1921 887 1917 859 1661 846 1659 846 1657 846 1655 846 1655 848 1644 859 1419 859 1391 846 1388 846 1386 846 1384 846 1382 846 1367 857 1297 846 1295 846 1293 846 1245 859 1163 848 1161 848 678 857 680 892"/>
                        </Shape>
                        <String CONTENT="The groups of Reindeer Chukchee are as follows: —"/>
                    </TextLine>
<TextLine ID="mz_1-046_l6" HPOS="570" VPOS="959" WIDTH="1771" HEIGHT="47" BASELINE="572 989 2341 985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2324 959 570 961 572 989 572 1006 2339 1002 2341 985 2335 959 2324 959"/>
                        </Shape>
                        <String CONTENT="The Indighirka and Alaseya Group, along the rivers of the same names, — 13 camps, with a popu-"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l7" HPOS="650" VPOS="1004" WIDTH="1685" HEIGHT="52" BASELINE="652 1039 2335 1030" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 1039 652 1056 2333 1050 2335 1030 2328 1004 650 1009 652 1039"/>
                        </Shape>
                        <String CONTENT="lation of about 150 souls. This is the most westerly group, and its territory is surrounded by"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l8" HPOS="650" VPOS="1052" WIDTH="1689" HEIGHT="47" BASELINE="652 1084 2339 1078" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 1084 652 1099 2337 1095 2339 1078 2333 1052 650 1056 652 1084"/>
                        </Shape>
                        <String CONTENT="districts inhabited by Yakut and Tungus. Some of its reindeer-herds consist of as many as"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l9" HPOS="654" VPOS="1095" WIDTH="1685" HEIGHT="56" BASELINE="656 1132 2339 1123" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 1132 656 1151 2337 1141 2339 1123 2333 1095 654 1102 656 1132"/>
                        </Shape>
                        <String CONTENT="5,000 head, and their owners reguiarly supply the Russian town of Sredne-Kolymsk and other"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l10" HPOS="652" VPOS="1149" WIDTH="409" HEIGHT="46" BASELINE="652 1177 1061 1177" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 1177 652 1195 1061 1195 1061 1177 1061 1149 652 1149 652 1177"/>
                        </Shape>
                        <String CONTENT="settlements with meat."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l11" HPOS="574" VPOS="1214" WIDTH="1767" HEIGHT="46" BASELINE="574 1242 2341 1242" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 1242 574 1260 2339 1260 2341 1242 2339 1214 574 1214 574 1242"/>
                        </Shape>
                        <String CONTENT="The Western Kolyma Group, as the name indicates, on the tundra to the west of the Kolyma"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l12" HPOS="652" VPOS="1260" WIDTH="1687" HEIGHT="49" BASELINE="654 1292 2339 1286" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1292 654 1309 2337 1303 2339 1286 2333 1260 652 1262 654 1292"/>
                        </Shape>
                        <String CONTENT="River, — about 35 camps, with a population of 400 souls. This group, on account of a severe"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l13" HPOS="652" VPOS="1305" WIDTH="1687" HEIGHT="52" BASELINE="654 1338 2339 1331" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1338 654 1357 2337 1351 2339 1331 2333 1305 652 1309 654 1338"/>
                        </Shape>
                        <String CONTENT="epidemic of small-pox, which in 1884 devastated it and caused one-third of the population to"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l14" HPOS="650" VPOS="1353" WIDTH="1687" HEIGHT="52" BASELINE="652 1385 2337 1381" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 1385 652 1405 2335 1400 2337 1381 2330 1353 650 1355 652 1385"/>
                        </Shape>
                        <String CONTENT="perish, is rather on the decrease. After the epidemic many large herds, left without guards,"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l15" HPOS="652" VPOS="1400" WIDTH="1685" HEIGHT="48" BASELINE="654 1431 2337 1426" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1431 654 1448 2335 1444 2337 1426 2330 1400 652 1403 654 1431"/>
                        </Shape>
                        <String CONTENT="disintegrated, and joined the herds of wild reindeer; while some of the western camps, who"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l16" HPOS="650" VPOS="1446" WIDTH="1687" HEIGHT="50" BASELINE="652 1478 2337 1474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="652 1478 652 1496 2335 1491 2337 1474 2330 1446 650 1448 652 1478"/>
                        </Shape>
                        <String CONTENT="formerly lived in this district, recrossed the Kolyma River and re-occupied their former territory."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l17" HPOS="572" VPOS="1517" WIDTH="1769" HEIGHT="57" BASELINE="574 1552 2341 1545" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="572 1522 574 1552 574 1565 1741 1574 1744 1574 1746 1574 1748 1574 1748 1571 1759 1563 2322 1571 2324 1571 2326 1571 2328 1571 2341 1561 2341 1545 2335 1517 572 1519 572 1522"/>
                        </Shape>
                        <String CONTENT="The Dry Anui Group, between the Arctic Ocean and the Dry Anui River. This group is the"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l18" HPOS="652" VPOS="1565" WIDTH="1687" HEIGHT="50" BASELINE="654 1597 2339 1593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1597 654 1615 2337 1610 2339 1593 2333 1565 652 1567 654 1597"/>
                        </Shape>
                        <String CONTENT="largest of all, and its camps extend at intervals of from five to ten miles from the right bank"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l19" HPOS="652" VPOS="1613" WIDTH="1687" HEIGHT="47" BASELINE="654 1643 2339 1639" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1643 654 1660 2337 1656 2339 1639 2333 1613 652 1615 654 1643"/>
                        </Shape>
                        <String CONTENT="of the Kolyma, along the Anui, to the confines of the Chaun tundra. The camps number"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l20" HPOS="654" VPOS="1662" WIDTH="1687" HEIGHT="46" BASELINE="654 1691 2341 1691" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1691 654 1708 2341 1708 2341 1691 2341 1662 654 1662 654 1691"/>
                        </Shape>
                        <String CONTENT="about 100. Their herds are not very large, for the most part consisting of from 300 to 400"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l21" HPOS="654" VPOS="1708" WIDTH="1685" HEIGHT="47" BASELINE="654 1738 2339 1738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1738 654 1755 2339 1755 2339 1738 2339 1710 654 1708 654 1738"/>
                        </Shape>
                        <String CONTENT="head, which is sufficient to supply two families (i. e., from ten to fifteen persons, the average"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l22" HPOS="654" VPOS="1755" WIDTH="1685" HEIGHT="48" BASELINE="654 1784 2339 1784" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="654 1784 654 1803 2339 1803 2339 1784 2339 1755 654 1755 654 1784"/>
                        </Shape>
                        <String CONTENT="size of a camp) with meat, clothing, and trading-skins. Several herds, however, number 2,000-"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l23" HPOS="654" VPOS="1799" WIDTH="1378" HEIGHT="52" BASELINE="656 1838 2032 1827" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 1838 656 1851 2029 1844 2032 1827 2025 1799 654 1807 656 1838"/>
                        </Shape>
                        <String CONTENT="3,000 animals. Farther to the east the herds of this group are of larger size."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l24" HPOS="576" VPOS="1870" WIDTH="1767" HEIGHT="63" BASELINE="578 1905 2343 1898" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1905 578 1933 2341 1918 2343 1898 2337 1870 576 1872 578 1905"/>
                        </Shape>
                        <String CONTENT="The Large Anui Group, consisting of hardly 20 camps. Their number has been considerably depleted"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l25" HPOS="659" VPOS="1918" WIDTH="1680" HEIGHT="52" BASELINE="661 1952 2339 1944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 1952 661 1970 2337 1961 2339 1944 2333 1918 659 1918 661 1952"/>
                        </Shape>
                        <String CONTENT="by migration southward to the rivers Oloi and Omolon, where at present the most southerly"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l26" HPOS="654" VPOS="1965" WIDTH="1687" HEIGHT="55" BASELINE="656 2000 2341 1991" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2000 656 2020 2339 2009 2341 1991 2335 1965 654 1972 656 2000"/>
                        </Shape>
                        <String CONTENT="portion of the tribe is living. This is a group of about 45 camps, with a population of 500"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l27" HPOS="654" VPOS="2013" WIDTH="1685" HEIGHT="50" BASELINE="656 2046 2339 2039" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2046 656 2063 2337 2056 2339 2039 2333 2013 654 2017 656 2046"/>
                        </Shape>
                        <String CONTENT="souls. Some of their herds are as large as those of the Indighirka, and supply two Russian"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l28" HPOS="656" VPOS="2061" WIDTH="1681" HEIGHT="50" BASELINE="659 2091 2337 2087" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2091 659 2106 2333 2111 2337 2087 2330 2061 656 2063 659 2091"/>
                        </Shape>
                        <String CONTENT="towns — Sredne-Kolymsk and Gishiginsk — with meat. They have no access to the sea,"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l29" HPOS="654" VPOS="2106" WIDTH="1687" HEIGHT="52" BASELINE="656 2137 2341 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2330 2106 654 2108 656 2137 656 2158 2339 2154 2341 2132 2337 2115 2330 2106"/>
                        </Shape>
                        <String CONTENT="however, and consequently live in the mountains during the summer months, so that there have"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l30" HPOS="656" VPOS="2158" WIDTH="1220" HEIGHT="46" BASELINE="656 2186 1876 2186" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2186 656 2204 1876 2204 1876 2186 1876 2158 656 2158 656 2186"/>
                        </Shape>
                        <String CONTENT="been considerable losses in reindeer among them from time to time."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l31" HPOS="574" VPOS="2219" WIDTH="1772" HEIGHT="60" BASELINE="576 2253 2346 2247" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="574 2227 576 2253 576 2279 2343 2264 2346 2247 2339 2219 581 2221 574 2227"/>
                        </Shape>
                        <String CONTENT="The Upper Anadyr Group, which comprises about 30 camps. These also resort to the mountains"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l32" HPOS="656" VPOS="2269" WIDTH="1159" HEIGHT="47" BASELINE="659 2299 1815 2295" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2299 659 2316 1813 2312 1815 2295 1808 2269 656 2271 659 2299"/>
                        </Shape>
                        <String CONTENT="in summer. Of late their herds, too, have been greatly reduced."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l33" HPOS="574" VPOS="2334" WIDTH="1769" HEIGHT="49" BASELINE="576 2366 2343 2360" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="576 2366 576 2383 2341 2377 2343 2360 2337 2334 574 2338 576 2366"/>
                        </Shape>
                        <String CONTENT="The Chaun Group, — about 50 camps, living on the tundra near Chaun Bay. They are separated"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l34" HPOS="654" VPOS="2379" WIDTH="1687" HEIGHT="52" BASELINE="656 2411 2341 2405" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2411 656 2431 2339 2424 2341 2405 2335 2379 654 2383 656 2411"/>
                        </Shape>
                        <String CONTENT="from the Anui Group by the mountains of the watershed. Their herds, like those of the Eastern"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l35" HPOS="656" VPOS="2427" WIDTH="1683" HEIGHT="52" BASELINE="659 2461 2339 2453" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2461 659 2479 2337 2470 2339 2453 2333 2427 656 2433 659 2461"/>
                        </Shape>
                        <String CONTENT="Anui, number about 400 or 500 head, though more numerous herds also occur. The same may"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l36" HPOS="656" VPOS="2476" WIDTH="200" HEIGHT="46" BASELINE="656 2505 856 2505" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2505 656 2522 856 2522 856 2505 856 2476 656 2476 656 2505"/>
                        </Shape>
                        <String CONTENT="be said of"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l37" HPOS="576" VPOS="2539" WIDTH="1770" HEIGHT="50" BASELINE="578 2574 2346 2567" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2574 578 2589 2346 2583 2346 2567 2339 2539 576 2541 578 2574"/>
                        </Shape>
                        <String CONTENT="The Erri Group, whose territory lies farther to the east, and which is made up of about the same"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l38" HPOS="656" VPOS="2591" WIDTH="470" HEIGHT="48" BASELINE="656 2619 1126 2619" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="656 2619 656 2639 1126 2639 1126 2619 1126 2591 656 2591 656 2619"/>
                        </Shape>
                        <String CONTENT="number (40-50) of camps."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l39" HPOS="576" VPOS="2652" WIDTH="1767" HEIGHT="52" BASELINE="578 2686 2343 2680" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2686 578 2704 2341 2697 2343 2680 2337 2652 576 2656 578 2686"/>
                        </Shape>
                        <String CONTENT="The Oˊnmɪlɪn (“the inland one”) Group, living between the north bank of the Anadyr River and"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l40" HPOS="656" VPOS="2699" WIDTH="1685" HEIGHT="52" BASELINE="659 2734 2341 2725" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2734 659 2751 2339 2745 2341 2725 2335 2699 656 2706 659 2734"/>
                        </Shape>
                        <String CONTENT="Holy Cross Bay, — about 60 camps. It varies considerably in the proportion and distribution"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l41" HPOS="659" VPOS="2747" WIDTH="1682" HEIGHT="52" BASELINE="661 2782 2341 2775" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 2782 661 2799 2339 2799 2341 2775 2335 2747 659 2751 661 2782"/>
                        </Shape>
                        <String CONTENT="of its herds. Many camps are very poor, and live on fish and seal three seasons out of four,"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l42" HPOS="659" VPOS="2795" WIDTH="1682" HEIGHT="47" BASELINE="661 2825 2341 2821" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 2825 661 2842 2339 2838 2341 2821 2335 2795 659 2797 661 2825"/>
                        </Shape>
                        <String CONTENT="while others are well-to-do. This whole group includes a number of Maritime Chukchee from"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l43" HPOS="656" VPOS="2840" WIDTH="1687" HEIGHT="52" BASELINE="659 2873 2343 2866" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2873 659 2892 2341 2886 2343 2866 2337 2840 656 2844 659 2873"/>
                        </Shape>
                        <String CONTENT="the Pacific villages who have turned reindeer-breeders within the last thirty years. Their herds"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l44" HPOS="659" VPOS="2892" WIDTH="809" HEIGHT="46" BASELINE="659 2920 1468 2920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 2920 659 2938 1468 2938 1468 2920 1468 2892 659 2892 659 2920"/>
                        </Shape>
                        <String CONTENT="have not yet had time to become very large."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l45" HPOS="576" VPOS="2953" WIDTH="1770" HEIGHT="52" BASELINE="578 2987 2346 2981" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 2987 578 3005 2343 2998 2346 2981 2339 2953 576 2955 578 2987"/>
                        </Shape>
                        <String CONTENT="The Telqäˊp Group, called by the Russians Tumanskiye Chukchee (Туманскіе Чукчи), — about 50"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l46" HPOS="656" VPOS="3000" WIDTH="1687" HEIGHT="50" BASELINE="659 3033 2343 3026" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 3033 659 3050 2341 3044 2343 3026 2337 3000 656 3005 659 3033"/>
                        </Shape>
                        <String CONTENT="camps. Their herds are of moderate size (400-500 head). These are the roughest and most"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l47" HPOS="659" VPOS="3048" WIDTH="1687" HEIGHT="50" BASELINE="661 3080 2346 3074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 3080 661 3098 2343 3091 2346 3074 2339 3048 659 3050 661 3080"/>
                        </Shape>
                        <String CONTENT="indomitable of all the Chukchee, and in former times were the leaders in the wars against"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l48" HPOS="659" VPOS="3100" WIDTH="227" HEIGHT="45" BASELINE="659 3128 886 3128" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="659 3128 659 3145 886 3145 886 3128 886 3100 659 3100 659 3128"/>
                        </Shape>
                        <String CONTENT="the Koryak."/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l49" HPOS="578" VPOS="3158" WIDTH="1770" HEIGHT="55" BASELINE="581 3195 2348 3187" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 3195 581 3213 2346 3204 2348 3187 2341 3158 578 3161 581 3195"/>
                        </Shape>
                        <String CONTENT="The camps along the river Utteˊg̣nɪčen, a southern affluent of the Anadyr (called by the Russians"/>
                    </TextLine>

                    <TextLine ID="mz_1-046_l50" HPOS="659" VPOS="3206" WIDTH="1682" HEIGHT="58" BASELINE="661 3241 2341 3232" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="661 3241 661 3264 2339 3256 2341 3232 2335 3206 659 3210 661 3241"/>
                        </Shape>
