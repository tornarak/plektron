                        </Shape>
                        <String CONTENT="Most of the camps have a common fire because their inhabitants belong"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l23" HPOS="405" VPOS="1776" WIDTH="1772" HEIGHT="58" BASELINE="407 1823 2177 1817" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1823 407 1834 2175 1833 2177 1817 2175 1786 2158 1776 2156 1776 2154 1776 2152 1776 1835 1786 1786 1776 1784 1776 1737 1786 1707 1776 1705 1776 1703 1776 1654 1786 1625 1776 1623 1776 1621 1776 1619 1776 1580 1787 1508 1778 1506 1778 1504 1778 1472 1787 1280 1778 1278 1778 1130 1787 996 1778 994 1778 889 1789 425 1782 423 1782 421 1782 419 1782 405 1787 407 1823"/>
                        </Shape>
                        <String CONTENT="to related families. Difficulties regarding the fire arise in the camps of rich"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l24" HPOS="403" VPOS="1840" WIDTH="1776" HEIGHT="55" BASELINE="405 1880 2179 1876" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1880 405 1895 2177 1891 2179 1876 2175 1848 452 1840 450 1840 403 1850 405 1880"/>
                        </Shape>
                        <String CONTENT="reindeer-breeders, who hire poor assistants (coming often from a quite distant"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l25" HPOS="403" VPOS="1897" WIDTH="1776" HEIGHT="61" BASELINE="405 1942 2179 1936" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1942 405 1958 2177 1952 2179 1936 2175 1907 2079 1897 2077 1897 2023 1907 1995 1897 1993 1897 1991 1897 1886 1907 1842 1897 1841 1897 1839 1897 1729 1907 1635 1897 1633 1897 1570 1909 1243 1899 1241 1899 1239 1899 1237 1899 1222 1911 812 1911 752 1901 750 1901 748 1901 724 1911 691 1901 689 1901 687 1901 603 1911 522 1901 520 1901 403 1911 405 1942"/>
                        </Shape>
                        <String CONTENT="country), and also among very poor families, who not infrequently are heedless"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l26" HPOS="405" VPOS="1958" WIDTH="1774" HEIGHT="57" BASELINE="407 2001 2179 1997" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 2001 407 2015 2177 2011 2179 1997 2175 1968 1306 1958 1304 1958 1249 1968 446 1960 444 1960 442 1960 405 1970 407 2001"/>
                        </Shape>
                        <String CONTENT="of the ties of relationship when they join their herds together to watch them"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l27" HPOS="405" VPOS="2019" WIDTH="1774" HEIGHT="56" BASELINE="407 2062 2179 2058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 2062 407 2075 2177 2071 2179 2058 2175 2030 2128 2019 2126 2019 2125 2019 2091 2028 2066 2019 2064 2019 2062 2019 1725 2028 1541 2019 1539 2019 1537 2019 1535 2019 1519 2030 1388 2030 1302 2019 1300 2019 1229 2030 577 2021 575 2021 405 2032 407 2062"/>
                        </Shape>
                        <String CONTENT="more effectually. Sometimes near relatives, even brothers, will sever their fire"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l28" HPOS="403" VPOS="2073" WIDTH="1776" HEIGHT="63" BASELINE="405 2122 2179 2115" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 2122 405 2136 2177 2130 2179 2115 2175 2085 2123 2073 2121 2073 2119 2073 2091 2085 2068 2073 2066 2073 2064 2073 2062 2073 2060 2073 2042 2087 1862 2087 1794 2073 1792 2073 1729 2087 1682 2075 1680 2075 1678 2075 1598 2087 1541 2075 1539 2075 1537 2075 1535 2075 1517 2089 1419 2089 1386 2075 1384 2075 1382 2075 1380 2075 1337 2087 1294 2075 1292 2075 1290 2075 1288 2075 1286 2075 1267 2089 930 2077 928 2077 926 2077 924 2077 906 2089 802 2079 801 2079 799 2079 773 2091 716 2079 714 2079 712 2079 681 2089 648 2079 646 2079 644 2079 642 2079 614 2091 556 2079 554 2079 552 2079 513 2091 421 2079 419 2079 417 2079 415 2079 403 2085 405 2122"/>
                        </Shape>
                        <String CONTENT="from the family fire. When a house has been visited by misfortune and the"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l29" HPOS="405" VPOS="2136" WIDTH="1774" HEIGHT="71" BASELINE="407 2183 2179 2175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 2183 407 2197 791 2207 793 2207 851 2195 1175 2205 1177 2205 1335 2193 1437 2203 1439 2203 2177 2193 2179 2175 2175 2146 2023 2136 2021 2136 1976 2146 1938 2136 1936 2136 1935 2136 1933 2136 1931 2136 1915 2148 1786 2148 1752 2136 1750 2136 1748 2136 1747 2136 1745 2136 1723 2148 1247 2140 1245 2140 1104 2150 1004 2140 1002 2140 1000 2140 998 2140 985 2150 924 2140 922 2140 844 2152 820 2142 818 2142 587 2142 585 2142 583 2142 558 2154 405 2154 407 2183"/>
                        </Shape>
                        <String CONTENT="anger of “spirits,” — for instance, when many grown people or male children"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l30" HPOS="405" VPOS="2197" WIDTH="1774" HEIGHT="57" BASELINE="407 2240 2179 2236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 2240 407 2254 2177 2250 2179 2236 2175 2209 1960 2209 1944 2197 1942 2197 1940 2197 1938 2197 1936 2197 1903 2207 1807 2197 1805 2197 1803 2197 1772 2209 1557 2209 1519 2197 1517 2197 1515 2197 1414 2207 1349 2197 1347 2197 1288 2210 1153 2210 1137 2199 1135 2199 1133 2199 1132 2199 1130 2199 1098 2209 1004 2199 1002 2199 906 2209 802 2199 801 2199 708 2209 575 2199 573 2199 405 2205 407 2240"/>
                        </Shape>
                        <String CONTENT="belonging to it have died. — it may suddenly be cast out from the commu-"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l31" HPOS="403" VPOS="2257" WIDTH="1770" HEIGHT="57" BASELINE="405 2301 2173 2295" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 2301 405 2314 2172 2308 2173 2295 2170 2257 1602 2257 1600 2257 1598 2257 1578 2267 1024 2259 1022 2259 1020 2259 989 2269 434 2261 432 2261 430 2261 403 2269 405 2301"/>
                        </Shape>
                        <String CONTENT="nity of fire. In this case the man who pronounces the protecting incantation¹"/>
                    </TextLine>

