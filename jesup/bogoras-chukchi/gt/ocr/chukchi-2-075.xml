                        </Shape>
                        <String CONTENT="During my travels I had much trouble with women on account of the"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l4" HPOS="401" VPOS="640" WIDTH="1776" HEIGHT="57" BASELINE="401 681 2177 681" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 681 401 697 2177 697 2177 681 2175 644 1496 650 1464 640 1463 640 1461 640 1459 640 1457 640 1441 650 1414 640 1412 640 1410 640 1408 640 1406 640 1390 650 1361 640 1359 640 1357 640 1278 650 1245 640 1243 640 1241 640 1190 650 1163 640 1161 640 1159 640 1157 640 1135 652 1006 652 979 640 977 640 975 640 973 640 942 650 914 640 912 640 910 640 826 650 797 640 795 640 793 640 791 640 765 650 740 640 738 640 736 640 613 650 548 640 546 640 454 650 423 640 421 640 419 640 417 640 415 640 401 648 401 681"/>
                        </Shape>
                        <String CONTENT="fire. Many of them had no teakettles of their own, and yet refused to boil"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l5" HPOS="399" VPOS="701" WIDTH="1778" HEIGHT="54" BASELINE="401 742 2177 738" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 742 401 755 2175 752 2177 738 2173 710 1298 701 1296 701 1294 701 1292 701 1278 710 477 703 475 703 399 712 401 742"/>
                        </Shape>
                        <String CONTENT="water in mine because it had stood by an alien hearth. Sometimes their"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l6" HPOS="399" VPOS="759" WIDTH="1778" HEIGHT="57" BASELINE="401 802 2177 799" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 802 401 816 2175 812 2177 799 2173 771 1384 759 1382 759 1267 771 1071 761 1069 761 1067 761 1045 773 851 773 779 761 777 761 775 761 752 771 685 761 683 761 581 771 517 761 515 761 399 773 401 802"/>
                        </Shape>
                        <String CONTENT="scruples would give way at the prospect of drinking hot tea. In other cases"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l7" HPOS="403" VPOS="822" WIDTH="1647" HEIGHT="53" BASELINE="403 861 2050 861" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 861 403 875 2050 875 2050 861 2050 834 1690 822 1688 822 1396 832 1288 822 1286 822 1284 822 1282 822 1271 832 1239 822 1237 822 1235 822 1137 832 1073 822 1071 822 1069 822 1067 822 1051 834 787 834 728 822 726 822 644 832 611 822 609 822 607 822 605 822 603 822 591 832 579 822 577 822 575 822 493 822 491 822 403 832 403 861"/>
                        </Shape>
                        <String CONTENT="we had to make a separate fire, and drink our tea outside of the tent."/>
                    </TextLine>
<TextLine ID="mz_2-075_l8" HPOS="507" VPOS="877" WIDTH="1670" HEIGHT="61" BASELINE="509 922 2177 916" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="509 922 509 938 2175 932 2177 916 2173 889 1766 877 1764 877 1762 877 1737 887 1666 877 1664 877 1662 877 1615 891 1478 891 1461 879 1459 879 1457 879 1455 879 1453 879 1427 889 1382 879 1380 879 1378 879 1347 889 1286 879 1284 879 1282 879 1241 889 1145 879 1143 879 1038 891 1010 881 1008 881 1006 881 955 891 848 881 846 881 507 887 509 922"/>
                        </Shape>
                        <String CONTENT="Brothers, cousins, and relatives of male descent, while living in the same"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l9" HPOS="399" VPOS="936" WIDTH="1780" HEIGHT="72" BASELINE="401 985 2179 975" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 985 401 998 513 1008 515 1008 517 1008 548 996 1124 994 1439 1004 1441 1004 1443 1004 1445 1004 1461 994 1694 1002 1696 1002 1698 1002 1700 1002 1715 992 2177 992 2179 975 2173 936 2121 945 2011 936 2009 936 2007 936 2005 936 1989 947 1870 947 1846 936 1844 936 1842 936 1841 936 1813 947 1588 938 1586 938 1584 938 1582 938 1566 949 1461 949 1425 940 1423 940 1421 940 1296 949 1179 940 1177 940 1106 951 802 941 801 941 399 953 401 985"/>
                        </Shape>
                        <String CONTENT="camp, or at least in the same neighborhood, may freely interchange fire. If"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l10" HPOS="401" VPOS="1002" WIDTH="1778" HEIGHT="53" BASELINE="403 1041 2179 1037" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1041 403 1055 2177 1051 2179 1037 2175 1010 552 1002 550 1002 401 1012 403 1041"/>
                        </Shape>
                        <String CONTENT="one of them has moved to a distant country, his fire gradually becomes"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l11" HPOS="401" VPOS="1061" WIDTH="1776" HEIGHT="57" BASELINE="403 1102 2177 1096" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1102 403 1118 2175 1114 2177 1096 2172 1061 1329 1071 1273 1061 1271 1061 1269 1061 1237 1071 1224 1061 1222 1061 1220 1061 1086 1061 1085 1061 1083 1061 1081 1061 1065 1071 932 1063 930 1063 928 1063 887 1073 822 1063 820 1063 754 1073 462 1063 460 1063 401 1075 403 1102"/>
                        </Shape>
                        <String CONTENT="estranged from the primary hearth, because it consumes strange fuel, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l12" HPOS="401" VPOS="1118" WIDTH="1776" HEIGHT="60" BASELINE="403 1165 2177 1157" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1165 403 1178 2175 1173 2177 1157 2173 1129 1870 1118 1868 1118 1776 1128 1735 1118 1733 1118 1731 1118 1729 1118 1705 1129 1649 1120 1647 1120 1645 1120 1619 1131 1372 1131 1351 1120 1349 1120 1347 1120 1286 1131 1245 1122 1243 1122 1241 1122 1239 1122 1202 1131 1092 1122 1090 1122 1039 1131 996 1122 994 1122 992 1122 812 1133 797 1124 795 1124 793 1124 791 1124 708 1133 640 1124 638 1124 581 1133 526 1124 524 1124 401 1128 403 1165"/>
                        </Shape>
                        <String CONTENT="inhales alien and unseemly odors. In this way, even brothers who have been"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l13" HPOS="403" VPOS="1180" WIDTH="1770" HEIGHT="57" BASELINE="405 1222 2173 1216" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1222 405 1237 2172 1235 2173 1216 2170 1188 1030 1180 1028 1180 1026 1180 989 1190 558 1182 556 1182 403 1192 405 1222"/>
                        </Shape>
                        <String CONTENT="separated for a long term of years may lose the right to interchange their fires."/>
                    </TextLine>
<TextLine ID="mz_2-075_l14" HPOS="515" VPOS="1237" WIDTH="1664" HEIGHT="59" BASELINE="517 1282 2179 1276" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="517 1282 517 1296 2177 1290 2179 1276 2175 1249 2021 1249 2005 1237 2003 1237 2001 1237 1999 1237 1997 1237 1970 1247 1915 1237 1913 1237 1911 1237 1909 1237 1895 1249 1784 1249 1748 1237 1747 1237 1745 1237 1743 1237 1711 1247 1660 1237 1658 1237 1656 1237 1621 1249 1607 1239 1605 1239 1604 1239 1602 1239 1600 1239 1570 1251 1476 1251 1463 1239 1461 1239 1459 1239 1457 1239 1065 1251 515 1245 517 1282"/>
                        </Shape>
                        <String CONTENT="When there are two or more fires of different family descent in the same"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l15" HPOS="401" VPOS="1300" WIDTH="1780" HEIGHT="66" BASELINE="403 1343 2181 1337" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1343 403 1357 861 1366 863 1366 865 1366 867 1366 883 1355 994 1355 1069 1364 1071 1364 1073 1364 1112 1355 1257 1364 1259 1364 1261 1364 1288 1355 2179 1355 2181 1337 2177 1302 1466 1300 1464 1300 1400 1310 1302 1300 1300 1300 1298 1300 1261 1310 1224 1300 1222 1300 1220 1300 979 1312 916 1302 914 1302 912 1302 875 1312 814 1302 812 1302 401 1314 403 1343"/>
                        </Shape>
                        <String CONTENT="camp, a community fire may result, if the children playing together should"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l16" HPOS="403" VPOS="1359" WIDTH="1776" HEIGHT="60" BASELINE="405 1402 2179 1398" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1402 405 1415 2175 1419 2179 1398 2175 1370 2117 1359 2115 1359 2040 1368 1972 1359 1970 1359 1848 1368 1780 1359 1670 1359 1668 1359 1666 1359 1664 1359 1651 1368 1598 1359 1596 1359 1545 1368 1369 1359 1367 1359 1286 1370 1194 1361 1192 1361 1143 1370 1049 1361 1047 1361 969 1370 904 1361 902 1361 900 1361 865 1370 724 1361 722 1361 665 1370 607 1361 605 1361 603 1361 601 1361 585 1370 403 1368 405 1402"/>
                        </Shape>
                        <String CONTENT="happen to mix one fire with another. The respective families will then bring"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l17" HPOS="401" VPOS="1417" WIDTH="1776" HEIGHT="59" BASELINE="403 1462 2177 1455" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1462 403 1476 2175 1472 2177 1455 2173 1427 2085 1417 2083 1417 1997 1427 1956 1417 1954 1417 1952 1417 1950 1417 1948 1417 1933 1429 1531 1429 1410 1419 1408 1419 1406 1419 1372 1429 1128 1421 1126 1421 1124 1421 1085 1431 965 1421 963 1421 904 1431 767 1423 765 1423 401 1433 403 1462"/>
                        </Shape>
                        <String CONTENT="a common sacrifice, and for the future will keep up a common fire. The"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l18" HPOS="403" VPOS="1482" WIDTH="1778" HEIGHT="59" BASELINE="405 1521 2181 1517" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1521 405 1539 2132 1541 2134 1541 2181 1529 2181 1517 2177 1482 585 1482 583 1482 403 1492 405 1521"/>
                        </Shape>
                        <String CONTENT="community of related people who use fire from a common source are called"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l19" HPOS="411" VPOS="1537" WIDTH="1768" HEIGHT="59" BASELINE="413 1578 2179 1574" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="413 1578 413 1596 2177 1592 2179 1574 2175 1549 2115 1537 2113 1537 2111 1537 2079 1549 1893 1549 1864 1537 1862 1537 1860 1537 1858 1537 1823 1547 1801 1537 1799 1537 1797 1537 1707 1547 1678 1537 1676 1537 1674 1537 1672 1537 1670 1537 1654 1549 1535 1549 1443 1537 1441 1537 1382 1547 1314 1537 1312 1537 1255 1549 1198 1539 1196 1539 1194 1539 1161 1549 1086 1539 1085 1539 1010 1549 987 1539 985 1539 983 1539 981 1539 949 1549 775 1539 773 1539 771 1539 734 1549 669 1539 667 1539 411 1547 413 1578"/>
                        </Shape>
                        <String CONTENT="“those having the same fire” (ᴇnnaˊn-yɪˊnlɪt). This term is equivalent to another"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l20" HPOS="403" VPOS="1594" WIDTH="1770" HEIGHT="62" BASELINE="405 1643 2173 1635" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="405 1643 405 1656 2172 1648 2173 1635 2166 1596 2134 1605 2107 1594 2105 1594 2103 1594 2101 1594 2099 1594 2077 1607 1858 1607 1784 1594 1782 1594 1780 1594 1758 1605 1739 1594 1737 1594 1735 1594 1733 1594 1731 1594 1729 1594 1709 1607 1598 1596 1596 1596 1594 1596 1592 1596 1576 1607 1557 1598 1555 1598 1553 1598 1551 1598 1549 1598 1533 1609 1404 1609 1359 1596 1357 1596 1355 1596 1353 1596 1329 1607 1300 1596 1298 1596 1296 1596 1294 1596 1292 1596 1271 1611 1190 1611 1173 1598 1171 1598 1169 1598 1167 1598 1165 1598 1137 1609 1090 1598 1088 1598 1086 1598 1085 1598 1083 1598 1063 1609 1036 1598 1034 1598 1032 1598 971 1607 908 1598 906 1598 904 1598 902 1598 885 1609 736 1599 734 1599 732 1599 712 1609 683 1599 681 1599 679 1599 677 1599 675 1599 658 1611 550 1599 548 1599 546 1599 513 1613 403 1613 405 1643"/>
                        </Shape>
                        <String CONTENT="one which designates kinship in the male line, — “old buck-fellow community”"/>
                    </TextLine>

                    <TextLine ID="mz_2-075_l21" HPOS="405" VPOS="1666" WIDTH="415" HEIGHT="61" BASELINE="407 1697 820 1701" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="407 1697 405 1717 415 1725 417 1725 419 1725 421 1725 571 1715 791 1727 793 1727 795 1727 818 1715 820 1701 818 1670 407 1666 407 1697"/>
                        </Shape>
                        <String CONTENT="(kɪrñeˊ-tuˊmg̣ɪ-ret)."/>
                    </TextLine>
<TextLine ID="mz_2-075_l22" HPOS="519" VPOS="1719" WIDTH="1660" HEIGHT="61" BASELINE="519 1760 2179 1760" TAGREFS="TYPE_5">
                        <Shape>
