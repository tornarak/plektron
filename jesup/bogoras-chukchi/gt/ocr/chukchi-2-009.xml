                        </Shape>
                        <String CONTENT="Animals, when personating human beings, can change their shape and"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l30" HPOS="415" VPOS="2197" WIDTH="1772" HEIGHT="57" BASELINE="417 2238 2187 2232" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2238 417 2254 2185 2250 2187 2232 2183 2205 1006 2197 1004 2197 928 2207 438 2199 436 2199 434 2199 415 2207 417 2238"/>
                        </Shape>
                        <String CONTENT="size quite as easily as spirits do. The ermine, for example, appears as a stately"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l31" HPOS="417" VPOS="2254" WIDTH="1770" HEIGHT="56" BASELINE="419 2297 2187 2293" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="419 2297 419 2310 2185 2306 2187 2293 2183 2265 1844 2254 1842 2254 1792 2263 1745 2254 1743 2254 1741 2254 1713 2263 1666 2254 1664 2254 1619 2263 1584 2254 1582 2254 1580 2254 1578 2254 1541 2263 1508 2254 1506 2254 1504 2254 1400 2263 1367 2254 1365 2254 1363 2254 1361 2254 1337 2263 1304 2254 1302 2254 1300 2254 1298 2254 1269 2265 1224 2256 1222 2256 922 2265 844 2256 842 2256 773 2265 634 2256 632 2256 581 2265 519 2256 517 2256 417 2267 419 2297"/>
                        </Shape>
                        <String CONTENT="warrior clad in white armor, while the legs of mice he has killed turn into"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l32" HPOS="415" VPOS="2312" WIDTH="1772" HEIGHT="59" BASELINE="417 2357 2187 2351" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2357 417 2371 2185 2369 2187 2351 2185 2324 2156 2312 2154 2312 2152 2312 2150 2312 2123 2322 2001 2312 1999 2312 1997 2312 1972 2322 1944 2312 1942 2312 1940 2312 1938 2312 1936 2312 1921 2324 1694 2324 1615 2312 1613 2312 1611 2312 1609 2312 1592 2324 1494 2314 1492 2314 1490 2314 1453 2326 1186 2326 1137 2314 1135 2314 1075 2324 1038 2314 1036 2314 1034 2314 1032 2314 1002 2326 979 2316 977 2316 975 2316 661 2326 464 2316 462 2316 460 2316 415 2328 417 2357"/>
                        </Shape>
                        <String CONTENT="reindeer-hams. The owl, also, becomes a warrior. Mice are people living in"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l33" HPOS="415" VPOS="2373" WIDTH="1774" HEIGHT="59" BASELINE="417 2418 2189 2412" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2418 417 2432 2187 2426 2189 2412 2185 2385 1660 2373 1658 2373 1594 2387 1472 2387 1457 2375 1455 2375 1453 2375 1451 2375 1173 2385 1120 2375 1118 2375 1004 2387 957 2377 955 2377 867 2387 485 2377 483 2377 415 2389 417 2418"/>
                        </Shape>
                        <String CONTENT="underground houses, who use the root of Polygonum viviparum or Polygonum"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l34" HPOS="415" VPOS="2434" WIDTH="1772" HEIGHT="66" BASELINE="417 2477 2187 2473" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2477 417 2500 2185 2489 2187 2473 2183 2445 2134 2434 2132 2434 1692 2444 1654 2434 1652 2434 1651 2434 1590 2444 1453 2434 1451 2434 1349 2444 1302 2434 1300 2434 1298 2434 1296 2434 1280 2445 1267 2436 1265 2436 1263 2436 1261 2436 1206 2445 611 2436 609 2436 550 2445 444 2436 442 2436 440 2436 415 2445 417 2477"/>
                        </Shape>
                        <String CONTENT="polymorphum as their reindeer, and have sledges of grass. By a sudden"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l35" HPOS="415" VPOS="2494" WIDTH="1774" HEIGHT="57" BASELINE="417 2536 2189 2532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2536 417 2551 2187 2547 2189 2532 2185 2504 1388 2494 1386 2494 1292 2504 532 2496 530 2496 415 2506 417 2536"/>
                        </Shape>
                        <String CONTENT="transformation they become real hunters with regular sledges, and hunt polar"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l36" HPOS="415" VPOS="2553" WIDTH="1772" HEIGHT="59" BASELINE="417 2598 2187 2592" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2598 417 2612 2185 2606 2187 2592 2183 2565 1919 2565 1893 2553 1891 2553 1889 2553 1801 2563 1553 2555 1551 2555 1549 2555 1547 2555 1533 2565 1449 2555 1447 2555 1378 2565 1337 2555 1335 2555 1333 2555 1331 2555 1300 2565 1249 2555 1247 2555 1245 2555 1206 2565 1018 2557 1016 2557 1014 2557 1012 2557 1000 2567 415 2563 417 2598"/>
                        </Shape>
                        <String CONTENT="bears. When they want to carry the dead bear home, the sledge returns to"/>
                    </TextLine>
<TextLine ID="mz_2-009_l37" HPOS="522" VPOS="2671" WIDTH="1667" HEIGHT="49" BASELINE="524 2702 2189 2696" TAGREFS="TYPE_5">
                        <Shape>
