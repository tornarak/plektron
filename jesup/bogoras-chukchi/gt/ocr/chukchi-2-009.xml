                        </Shape>
                        <String CONTENT="¹ In some Chukchee tales, even the sun, the sea, and the sky figure as beings who retain accessories of"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l38" HPOS="419" VPOS="2720" WIDTH="1768" HEIGHT="43" BASELINE="419 2743 2187 2743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="419 2743 419 2759 2183 2763 2187 2743 2185 2720 419 2720 419 2743"/>
                        </Shape>
                        <String CONTENT="their material nature. In one tale, the Sun, while taking part in a shamanistic match with other competitors,"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l39" HPOS="415" VPOS="2759" WIDTH="1770" HEIGHT="45" BASELINE="417 2788 2185 2782" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="417 2788 417 2804 2183 2800 2185 2782 2179 2759 415 2763 417 2788"/>
                        </Shape>
                        <String CONTENT="appears with his luminary, and burns those present; the Sea drowns them (in another tale, he crushes them"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l40" HPOS="419" VPOS="2802" WIDTH="1766" HEIGHT="43" BASELINE="421 2829 2185 2825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="421 2829 421 2845 2183 2845 2185 2825 2179 2802 419 2804 421 2829"/>
                        </Shape>
                        <String CONTENT="with ice); and the Sky also crushes them by the falling of his upper crust. It is worthy of note that such"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l41" HPOS="417" VPOS="2841" WIDTH="1768" HEIGHT="45" BASELINE="419 2870 2185 2865" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="419 2870 419 2886 2185 2880 2185 2865 2179 2841 417 2845 419 2870"/>
                        </Shape>
                        <String CONTENT="incidents occur only in shamanistic performances, while at all other times the sun, the sky, and the sea appear"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l42" HPOS="417" VPOS="2884" WIDTH="1766" HEIGHT="45" BASELINE="419 2914 2183 2908" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="419 2914 419 2929 2181 2925 2183 2908 2177 2884 417 2888 419 2914"/>
                        </Shape>
                        <String CONTENT="as actual men. They also have a double nature, which they may change at will. Compare Bogoras, Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_2-009_l43" HPOS="417" VPOS="2925" WIDTH="290" HEIGHT="47" BASELINE="419 2951 707 2957" TAGREFS="TYPE_5">
