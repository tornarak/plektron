                        </Shape>
                        <String CONTENT="case of his elder sister, as follows: —"/>
                    </TextLine>
<TextLine ID="mz_3-036_l25" HPOS="487" VPOS="1955" WIDTH="1672" HEIGHT="49" BASELINE="489 1985 2159 1989" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="489 1985 487 2000 2155 2004 2159 1989 2157 1959 489 1955 489 1985"/>
                        </Shape>
                        <String CONTENT="“Then [after their father had died] Aiˊhɪnto [the master of the camp] said to my sister, ‘You"/>
                    </TextLine>

                    <TextLine ID="mz_3-036_l26" HPOS="383" VPOS="2010" WIDTH="1774" HEIGHT="41" BASELINE="383 2035 2157 2035" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 2035 383 2049 2155 2051 2157 2035 2157 2010 383 2010 383 2035"/>
                        </Shape>
                        <String CONTENT="must throw away your tent.’ ... She said, ‘Why not? I have neither father nor husband. Then"/>
                    </TextLine>

                    <TextLine ID="mz_3-036_l27" HPOS="381" VPOS="2051" WIDTH="1776" HEIGHT="45" BASELINE="383 2078 2157 2082" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 2078 381 2092 2153 2096 2157 2082 2155 2055 383 2051 383 2078"/>
                        </Shape>
                        <String CONTENT="for whom must I put up the tent, shake and dust the skins? Is it for you?’ Then she left in the"/>
                    </TextLine>

                    <TextLine ID="mz_3-036_l28" HPOS="383" VPOS="2104" WIDTH="1776" HEIGHT="42" BASELINE="383 2129 2159 2129" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 2129 383 2146 2159 2146 2159 2129 2159 2104 383 2104 383 2129"/>
                        </Shape>
                        <String CONTENT="open everything that she had, — fire-drills, sledges, and charm-strings. These last she cut up, thus"/>
                    </TextLine>

                    <TextLine ID="mz_3-036_l29" HPOS="383" VPOS="2146" WIDTH="1774" HEIGHT="45" BASELINE="385 2174 2157 2178" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="385 2174 383 2187 2153 2191 2157 2178 2155 2150 385 2146 385 2174"/>
                        </Shape>
                        <String CONTENT="wholly renouncing them for the future. Also the tent, of her father’s make, the covered sledge, the"/>
                    </TextLine>

                    <TextLine ID="mz_3-036_l30" HPOS="383" VPOS="2189" WIDTH="1176" HEIGHT="51" BASELINE="383 2222 1559 2222" TAGREFS="TYPE_6">
                        <Shape>
                            <Polygon POINTS="383 2222 383 2240 1557 2240 1559 2222 1555 2189 383 2195 383 2222"/>
