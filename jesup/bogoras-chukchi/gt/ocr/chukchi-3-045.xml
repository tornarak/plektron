                        <String CONTENT="particularly a woman. In another country lives a woman who has never seen"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l33" HPOS="387" VPOS="2369" WIDTH="1772" HEIGHT="64" BASELINE="389 2419 2159 2408" TAGREFS="TYPE_4">
