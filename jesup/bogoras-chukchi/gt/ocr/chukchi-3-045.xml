                        </Shape>
                        <String CONTENT="which is made in two different ways. In one type of story, the bride is always"/>
                    </TextLine>
<TextLine ID="mz_3-045_l40" HPOS="387" VPOS="2836" WIDTH="1778" HEIGHT="51" BASELINE="389 2871 2165 2862" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="389 2871 389 2887 2163 2881 2165 2862 2159 2836 387 2846 389 2871"/>
                        </Shape>
                        <String CONTENT="part in the holy act; but immediately all the people let go, and the bell fell to the ground. They were all"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l41" HPOS="389" VPOS="2881" WIDTH="1776" HEIGHT="51" BASELINE="391 2916 2165 2906" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 2916 391 2932 2163 2926 2165 2906 2159 2881 389 2889 391 2916"/>
                        </Shape>
                        <String CONTENT="guilty of this sin. At this time this tale is obsolete. Some similar cases occur also among the Chukchee, but"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l42" HPOS="389" VPOS="2924" WIDTH="1774" HEIGHT="43" BASELINE="391 2953 2163 2947" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 2953 391 2967 2163 2961 2163 2947 2157 2924 389 2928 391 2953"/>
                        </Shape>
                        <String CONTENT="the people talk about them not without derision. Thus, when I was travelling on the Wolverene River, I was"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l43" HPOS="389" VPOS="2961" WIDTH="1772" HEIGHT="51" BASELINE="391 2996 2161 2988" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="391 2996 391 3012 2159 3010 2161 2988 2155 2961 389 2971 391 2996"/>
                        </Shape>
                        <String CONTENT="told that one Yeˊtɪläqäi was living with the wife of his minor son Atkaiˊñau. The people laughed at him, and"/>
