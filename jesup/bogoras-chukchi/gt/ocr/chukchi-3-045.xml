                    </TextLine>

                    <TextLine ID="mz_3-045_l13" HPOS="385" VPOS="1184" WIDTH="1778" HEIGHT="52" BASELINE="387 1221 2163 1215" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="387 1221 387 1236 2161 1230 2163 1215 2159 1186 385 1184 387 1221"/>
                        </Shape>
                        <String CONTENT="This institution, as its name indicates, evidently originated under the conditions"/>
                    </TextLine>

