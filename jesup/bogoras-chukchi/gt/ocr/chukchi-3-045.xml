                            <Polygon POINTS="389 2419 389 2433 2157 2429 2159 2408 2155 2380 2026 2369 2024 2369 1970 2378 1944 2369 1943 2369 1941 2369 1939 2369 1937 2369 1921 2378 1787 2371 1785 2371 1783 2371 1781 2371 1765 2382 1596 2382 1570 2371 1568 2371 1566 2371 1564 2371 1537 2382 1313 2373 1311 2373 1309 2373 1268 2384 1017 2374 1015 2374 1013 2374 972 2386 758 2376 756 2376 754 2376 726 2386 685 2376 683 2376 682 2376 387 2390 389 2419"/>
                        </Shape>
                        <String CONTENT="a man. Both feel a peculiar desire, which they do not understand. When"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l34" HPOS="385" VPOS="2431" WIDTH="1776" HEIGHT="68" BASELINE="387 2478 2161 2470" TAGREFS="TYPE_4">
