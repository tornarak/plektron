                        </Shape>
                        <String CONTENT="ulous and obscene details. At last they learn by experience, and become"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l36" HPOS="385" VPOS="2552" WIDTH="1776" HEIGHT="58" BASELINE="387 2597 2161 2591" TAGREFS="TYPE_4">
