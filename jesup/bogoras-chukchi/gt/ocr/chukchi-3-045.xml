                            <Polygon POINTS="387 2597 387 2610 2159 2604 2161 2591 2159 2563 2118 2552 2116 2552 2114 2552 2063 2563 1767 2563 1709 2552 1707 2552 1705 2552 1679 2563 385 2563 387 2597"/>
                        </Shape>
                        <String CONTENT="husband and wife. Other tales describe the adventures of a young man who"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l37" HPOS="385" VPOS="2612" WIDTH="1519" HEIGHT="59" BASELINE="387 2659 1904 2653" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="387 2659 387 2671 1902 2669 1904 2653 1900 2624 1775 2612 1773 2612 1771 2612 1742 2624 1508 2624 1455 2612 1453 2612 1352 2624 1122 2614 1120 2614 1056 2624 1003 2614 1001 2614 999 2614 960 2624 927 2614 925 2614 923 2614 921 2614 919 2614 906 2624 570 2616 569 2616 567 2616 565 2616 553 2628 385 2628 387 2659"/>
                        </Shape>
                        <String CONTENT="secures his bride right in the middle of a hostile camp or village."/>
                    </TextLine>
<TextLine ID="mz_3-045_l38" HPOS="494" VPOS="2671" WIDTH="1667" HEIGHT="62" BASELINE="496 2717 2161 2710" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="496 2717 496 2731 2157 2733 2161 2710 2159 2682 2122 2671 2120 2671 2118 2671 1820 2680 1744 2671 1742 2671 1689 2682 1646 2673 1644 2673 1642 2673 1640 2673 1613 2682 1533 2673 1531 2673 1529 2673 1527 2673 1514 2684 1420 2684 1331 2673 1329 2673 1327 2673 1325 2673 1305 2684 1138 2675 1136 2675 982 2684 951 2675 949 2675 947 2675 863 2686 791 2677 789 2677 494 2684 496 2717"/>
                        </Shape>
                        <String CONTENT="In these tales much attention is given to the description of the bride,"/>
                    </TextLine>

                    <TextLine ID="mz_3-045_l39" HPOS="387" VPOS="2733" WIDTH="1776" HEIGHT="57" BASELINE="389 2774 2163 2770" TAGREFS="TYPE_4">
