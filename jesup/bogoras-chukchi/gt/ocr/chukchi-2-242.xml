                        </Shape>
                        <String CONTENT="is often the name of a deceased relative, which, in days gone by, was chosen"/>
                    </TextLine>

                    <TextLine ID="mz_2-242_l30" HPOS="360" VPOS="2187" WIDTH="1768" HEIGHT="57" BASELINE="362 2228 2128 2224" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="362 2228 362 2242 2125 2244 2128 2224 2126 2199 2083 2187 2081 2187 2079 2187 2077 2187 2052 2197 1999 2187 1997 2187 1995 2187 1960 2197 1933 2187 1931 2187 1929 2187 1927 2187 1886 2199 1690 2199 1656 2187 1654 2187 1652 2187 1549 2197 1468 2187 1325 2187 1323 2187 1322 2187 1296 2197 1169 2189 1167 2189 1165 2189 1132 2199 1028 2189 916 2189 914 2189 912 2189 910 2189 895 2199 360 2197 362 2228"/>
                        </Shape>
                        <String CONTENT="in the same manner. Similar methods of naming children are used also by"/>
