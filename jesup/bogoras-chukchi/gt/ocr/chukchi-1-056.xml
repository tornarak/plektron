                <TextBlock ID="text_1-056" HPOS="578" VPOS="599" WIDTH="1783" HEIGHT="2635"><TextLine ID="mz_1-056_l1" HPOS="1165" VPOS="599" WIDTH="620" HEIGHT="57" BASELINE="1167 634 1785 638" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1774 619 1756 602 1187 599 1167 608 1167 634 1165 651 1780 656 1785 638 1780 628 1774 619"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l2" HPOS="587" VPOS="610" WIDTH="76" HEIGHT="48" BASELINE="591 649 663 645" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="591 649 591 658 663 656 663 645 656 610 587 612 591 649"/>
                        </Shape>
                        <String CONTENT="34"/>
                    </TextLine>
<TextLine ID="mz_1-056_l3" HPOS="583" VPOS="708" WIDTH="1773" HEIGHT="62" BASELINE="585 744 2356 749" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2337 718 2315 718 2294 716 2272 716 2265 714 585 708 585 744 583 762 596 770 598 770 600 770 602 770 2354 766 2356 749 2356 718 2337 718"/>
                        </Shape>
                        <String CONTENT="Faces strongly Mongolian in outline are more frequent among the women,"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l4" HPOS="585" VPOS="779" WIDTH="1774" HEIGHT="46" BASELINE="585 807 2359 807" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 807 585 825 2359 825 2359 807 2359 779 585 779 585 807"/>
                        </Shape>
                        <String CONTENT="though many are as fair and as well formed as the average woman of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l5" HPOS="585" VPOS="833" WIDTH="264" HEIGHT="48" BASELINE="587 863 849 868" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="587 863 585 876 845 881 849 868 847 838 587 833 587 863"/>
                        </Shape>
                        <String CONTENT="white race."/>
                    </TextLine>
<TextLine ID="mz_1-056_l6" HPOS="693" VPOS="883" WIDTH="1663" HEIGHT="67" BASELINE="695 926 2356 931" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="695 926 693 937 756 950 758 950 2354 946 2356 931 2354 898 2265 885 2263 885 2261 885 2229 896 2140 885 2138 885 2032 896 1923 885 1921 885 1919 885 1884 898 1724 898 1707 885 1705 885 1702 885 1700 885 1698 885 1666 896 1568 885 1566 885 1436 894 1401 883 1399 883 1397 883 1295 894 1204 883 1202 883 1085 894 695 889 695 926"/>
                        </Shape>
                        <String CONTENT="Their eyes are straight, and frequently as large as those of Caucasians,"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l7" HPOS="581" VPOS="946" WIDTH="1780" HEIGHT="65" BASELINE="583 989 2361 985" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 989 583 1002 2341 1011 2343 1011 2346 1011 2348 1011 2361 1000 2361 985 2354 946 1245 957 1200 946 1198 946 1196 946 1092 957 1009 946 1007 946 1005 946 1003 946 988 959 817 959 723 946 721 946 719 946 693 957 656 946 654 946 652 946 581 957 583 989"/>
                        </Shape>
                        <String CONTENT="and plica occurs but rarely among them; and their hair, as well as that of"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l8" HPOS="583" VPOS="1006" WIDTH="1776" HEIGHT="59" BASELINE="585 1050 2359 1045" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1050 585 1065 2356 1061 2359 1045 2354 1015 602 1006 600 1006 598 1006 596 1006 583 1013 585 1050"/>
                        </Shape>
                        <String CONTENT="the Koryak, is often wavy or even curly, while the Kamchadal always have"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l9" HPOS="583" VPOS="1063" WIDTH="1776" HEIGHT="60" BASELINE="585 1108 2359 1104" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1108 585 1123 2356 1119 2359 1104 2354 1073 1471 1063 1468 1063 1466 1063 1464 1063 1449 1073 669 1065 667 1065 583 1076 585 1108"/>
                        </Shape>
                        <String CONTENT="straight hair. Several Reindeer Chukchee that I met in various parts of their"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l10" HPOS="585" VPOS="1136" WIDTH="1774" HEIGHT="50" BASELINE="585 1169 2359 1169" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1169 585 1182 2356 1186 2359 1169 2359 1136 585 1136 585 1169"/>
                        </Shape>
                        <String CONTENT="territory had the surname “curly” (kaˊmčɪ) because of their very curly hair;"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l11" HPOS="583" VPOS="1182" WIDTH="1776" HEIGHT="63" BASELINE="585 1229 2359 1225" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1229 585 1245 2356 1240 2359 1225 2356 1195 2320 1182 2317 1182 2315 1182 2313 1182 2289 1195 2077 1195 2053 1182 2051 1182 2049 1182 1988 1193 1973 1182 1971 1182 1969 1182 1967 1182 1964 1182 1938 1193 1917 1182 1915 1182 1912 1182 1910 1182 1871 1193 1808 1182 1806 1182 1746 1193 1731 1182 1728 1182 1726 1182 1724 1182 1661 1193 1640 1182 1637 1182 1490 1182 1488 1182 1486 1182 1484 1182 1466 1193 1315 1184 1313 1184 1250 1195 1228 1184 1226 1184 1066 1184 1063 1184 1061 1184 1059 1184 1044 1195 968 1184 966 1184 964 1184 925 1195 682 1184 680 1184 583 1197 585 1229"/>
                        </Shape>
                        <String CONTENT="as, for instance, “Curly Yaˊtirg̣ɪn” (Kaˊmčɪ-Yaˊtirg̣ɪn). The hair of some people"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l12" HPOS="587" VPOS="1253" WIDTH="1772" HEIGHT="52" BASELINE="587 1288 2359 1288" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="587 1288 587 1305 2359 1305 2359 1288 2359 1258 587 1253 587 1288"/>
                        </Shape>
                        <String CONTENT="in Pacific villages even looked woolly. This effect was produced because the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l13" HPOS="587" VPOS="1314" WIDTH="1572" HEIGHT="52" BASELINE="587 1348 2159 1348" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="587 1348 587 1366 2159 1366 2159 1348 2159 1318 587 1314 587 1348"/>
                        </Shape>
                        <String CONTENT="hair was coarse and thick, and at the same time formed tight curls."/>
                    </TextLine>
<TextLine ID="mz_1-056_l14" HPOS="691" VPOS="1364" WIDTH="1665" HEIGHT="65" BASELINE="693 1405 2356 1409" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 1405 691 1418 706 1429 708 1429 710 1429 713 1429 2354 1424 2356 1409 2356 1379 2322 1366 2320 1366 2317 1366 2315 1366 2281 1377 2265 1366 2263 1366 2261 1366 2259 1366 2200 1377 2177 1366 2174 1366 2172 1366 2170 1366 2142 1377 2118 1366 2116 1366 2114 1366 2032 1377 1990 1366 1988 1366 1986 1366 1895 1377 1806 1366 1804 1366 1711 1377 1683 1366 1681 1366 1679 1366 1676 1366 1674 1366 1657 1379 1527 1379 1486 1364 1484 1364 1391 1364 1388 1364 1386 1364 1384 1364 1371 1374 1304 1364 1302 1364 1300 1364 1267 1377 1172 1377 1157 1364 1154 1364 1152 1364 1150 1364 1098 1374 992 1364 990 1364 988 1364 962 1374 897 1364 895 1364 892 1364 871 1374 810 1364 808 1364 693 1370 693 1405"/>
                        </Shape>
                        <String CONTENT="In the interior and on the Arctic coast the color of the hair is black,"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l15" HPOS="585" VPOS="1433" WIDTH="1771" HEIGHT="52" BASELINE="585 1468 2356 1468" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1468 585 1485 2356 1485 2356 1468 2356 1437 585 1433 585 1468"/>
                        </Shape>
                        <String CONTENT="but on the Pacific coast about fifteen per cent of the people have dark-brown"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l16" HPOS="585" VPOS="1485" WIDTH="1771" HEIGHT="67" BASELINE="587 1524 2356 1528" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="587 1524 585 1541 596 1550 598 1550 600 1550 602 1550 1328 1541 1479 1552 1481 1552 2354 1541 2356 1528 2356 1498 1503 1498 1475 1485 1473 1485 1471 1485 587 1491 587 1524"/>
                        </Shape>
                        <String CONTENT="or even light-brown hair. The growth of hair on the face is scanty, but"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l17" HPOS="583" VPOS="1556" WIDTH="1769" HEIGHT="48" BASELINE="585 1589 2352 1584" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1589 585 1604 2350 1604 2352 1584 2348 1556 583 1556 585 1589"/>
                        </Shape>
                        <String CONTENT="beards are more frequently seen than among the Lamut or the Yakut."/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l18" HPOS="585" VPOS="1606" WIDTH="1769" HEIGHT="59" BASELINE="587 1647 2354 1643" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="587 1647 587 1665 2352 1660 2354 1643 2350 1615 611 1606 609 1606 607 1606 585 1615 587 1647"/>
                        </Shape>
                        <String CONTENT="Accordingly, while the Lamut are very careful to pull out the beard-hair with"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l19" HPOS="585" VPOS="1678" WIDTH="1771" HEIGHT="47" BASELINE="585 1708 2356 1708" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1708 585 1725 2356 1725 2356 1708 2356 1678 585 1678 585 1708"/>
                        </Shape>
                        <String CONTENT="tweezers, the Chukchee frequently allow their beards to grow, and are even"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l20" HPOS="583" VPOS="1723" WIDTH="1773" HEIGHT="69" BASELINE="585 1768 2356 1764" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 1768 585 1792 2354 1779 2356 1764 2352 1736 2140 1736 2116 1723 2114 1723 2112 1723 2023 1734 1999 1723 1997 1723 1995 1723 1880 1734 1850 1723 1847 1723 1845 1723 1843 1723 1817 1734 1765 1723 1763 1723 1761 1723 1759 1723 1744 1736 1553 1736 1516 1723 1514 1723 1512 1723 1510 1723 1464 1736 775 1725 773 1725 771 1725 739 1736 704 1725 702 1725 700 1725 583 1738 585 1768"/>
                        </Shape>
                        <String CONTENT="proud of them. With the Reindeer people a mustache (or, rather, the appear-"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l21" HPOS="578" VPOS="1786" WIDTH="1783" HEIGHT="67" BASELINE="581 1829 2361 1825" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1829 581 1842 1466 1853 1468 1853 1471 1853 1514 1842 2337 1851 2339 1851 2341 1851 2343 1851 2361 1840 2361 1825 2354 1786 578 1794 581 1829"/>
                        </Shape>
                        <String CONTENT="ance of a black down on the upper lip) is considered the crowning feature of"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l22" HPOS="578" VPOS="1844" WIDTH="1778" HEIGHT="61" BASELINE="581 1890 2356 1883" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 1890 581 1905 2354 1898 2356 1883 2352 1853 1185 1844 1183 1844 1180 1844 1152 1857 886 1846 884 1846 882 1846 840 1857 801 1846 799 1846 797 1846 680 1857 596 1846 594 1846 591 1846 589 1846 578 1855 581 1890"/>
                        </Shape>
                        <String CONTENT="full growth, the warrant of independence. The eyebrows are often thick and"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l23" HPOS="578" VPOS="1916" WIDTH="1776" HEIGHT="47" BASELINE="581 1948 2354 1944" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="578 1922 581 1948 581 1963 2352 1959 2354 1944 2350 1916 583 1916 578 1922"/>
                        </Shape>
                        <String CONTENT="bushy, especially among old men. The growth of hair on the body is scanty."/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l24" HPOS="583" VPOS="1965" WIDTH="1773" HEIGHT="63" BASELINE="585 2011 2356 2002" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="585 2011 585 2028 2356 2017 2356 2002 2350 1965 583 1972 585 2011"/>
                        </Shape>
                        <String CONTENT="Thick eyebrows, long thick braids, and hairy pubes are counted as marks of"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l25" HPOS="578" VPOS="2028" WIDTH="431" HEIGHT="54" BASELINE="581 2067 1009 2065" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2067 581 2082 1007 2080 1009 2065 1003 2028 578 2037 581 2067"/>
                        </Shape>
                        <String CONTENT="beauty in woman.¹"/>
                    </TextLine>
<TextLine ID="mz_1-056_l26" HPOS="691" VPOS="2093" WIDTH="1661" HEIGHT="61" BASELINE="693 2128 2352 2124" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="693 2128 693 2143 1477 2154 1479 2154 1481 2154 1484 2154 1499 2141 1614 2141 1930 2141 1943 2152 1945 2152 1947 2152 1949 2152 2038 2141 2287 2152 2289 2152 2350 2139 2352 2124 2348 2095 691 2093 693 2128"/>
                        </Shape>
                        <String CONTENT="The color of the face is bronze, with intermediate tints varying from"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l27" HPOS="578" VPOS="2141" WIDTH="1776" HEIGHT="65" BASELINE="581 2191 2354 2184" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2191 581 2206 2352 2199 2354 2184 2350 2154 2296 2141 2294 2141 2291 2141 2289 2141 2270 2154 1804 2154 1780 2141 1778 2141 1776 2141 1774 2141 1772 2141 1756 2154 1720 2143 1718 2143 1715 2143 1713 2143 1692 2154 1655 2143 1653 2143 1650 2143 1648 2143 1627 2154 1442 2143 1440 2143 1438 2143 1397 2154 1367 2143 1365 2143 1362 2143 1360 2143 1339 2154 1280 2143 1278 2143 1222 2154 1174 2143 1172 2143 1170 2143 1167 2143 1139 2156 1094 2145 1092 2145 1089 2145 1027 2156 1014 2145 1012 2145 1009 2145 1007 2145 1005 2145 977 2156 934 2145 931 2145 929 2145 873 2156 782 2145 780 2145 578 2154 581 2191"/>
                        </Shape>
                        <String CONTENT="brick-red to blood-red. The ideal of beauty in both sexes requires that the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l28" HPOS="581" VPOS="2201" WIDTH="1773" HEIGHT="70" BASELINE="583 2251 2354 2245" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2243 583 2251 583 2264 1761 2271 1763 2271 1765 2271 1767 2271 1785 2260 2352 2260 2354 2245 2350 2214 2118 2201 2116 2201 2045 2212 2019 2201 2016 2201 2014 2201 2012 2201 2010 2201 1995 2212 1969 2201 1967 2201 1964 2201 1882 2212 1852 2201 1850 2201 1847 2201 1754 2214 1733 2204 1731 2204 1728 2204 1486 2214 1432 2204 1429 2204 1375 2214 1243 2204 1241 2204 1239 2204 1217 2214 1193 2204 1191 2204 1189 2204 1187 2204 1154 2217 1128 2206 1126 2206 1124 2206 849 2217 806 2206 804 2206 801 2206 799 2206 760 2217 708 2206 706 2206 633 2217 600 2206 598 2206 596 2206 581 2243"/>
                        </Shape>
                        <String CONTENT="face be “as red as blood, burning like fire.” The color of the skin of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l29" HPOS="583" VPOS="2275" WIDTH="1769" HEIGHT="52" BASELINE="583 2310 2352 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 2310 583 2325 2350 2327 2352 2310 2352 2277 583 2275 583 2310"/>
                        </Shape>
                        <String CONTENT="body is generally scarcely distinguishable from that of Caucasians. There are,"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l30" HPOS="581" VPOS="2336" WIDTH="1771" HEIGHT="49" BASELINE="583 2370 2352 2364" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 2370 583 2385 2350 2381 2352 2364 2346 2336 581 2336 583 2370"/>
                        </Shape>
                        <String CONTENT="however, numerous cases of brown or even dark-brown skin, more frequently"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l31" HPOS="581" VPOS="2385" WIDTH="1773" HEIGHT="61" BASELINE="583 2431 2354 2424" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 2431 583 2446 2352 2440 2354 2424 2350 2394 1172 2385 1170 2385 581 2398 583 2431"/>
                        </Shape>
                        <String CONTENT="among the Maritime Chukchee. The latter even consider the brownish com-"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l32" HPOS="581" VPOS="2448" WIDTH="1773" HEIGHT="65" BASELINE="583 2489 2354 2483" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 2489 583 2513 2352 2500 2354 2483 2350 2453 615 2448 613 2448 611 2448 581 2459 583 2489"/>
                        </Shape>
                        <String CONTENT="plexion to be the handsomest. The breasts of women who are with child"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l33" HPOS="583" VPOS="2518" WIDTH="1412" HEIGHT="45" BASELINE="583 2548 1995 2548" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="583 2548 583 2563 1995 2563 1995 2548 1995 2518 583 2518 583 2548"/>
                        </Shape>
                        <String CONTENT="frequently assume a dark-brown color over the whole surface."/>
                    </TextLine>
<TextLine ID="mz_1-056_l34" HPOS="687" VPOS="2561" WIDTH="1667" HEIGHT="71" BASELINE="689 2608 2354 2602" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="689 2608 689 2621 1458 2630 1460 2630 1540 2619 1609 2630 1611 2630 1614 2630 1616 2630 1631 2619 1644 2630 1646 2630 1648 2630 1650 2632 1774 2632 1774 2630 1852 2617 1893 2628 1895 2628 1897 2628 1899 2628 1945 2617 1960 2628 1962 2628 1964 2628 1967 2628 2352 2617 2354 2602 2350 2574 2276 2561 2274 2561 1795 2574 1670 2563 1668 2563 1596 2574 1570 2563 1568 2563 1566 2563 1564 2563 1525 2574 1499 2563 1497 2563 1494 2563 1492 2563 1468 2574 1412 2563 1410 2563 1408 2563 1406 2563 1391 2574 1360 2563 1358 2563 1356 2563 1241 2576 1217 2565 1215 2565 1213 2565 1211 2565 1170 2576 856 2565 853 2565 791 2576 708 2565 706 2565 704 2565 702 2565 687 2574 689 2608"/>
                        </Shape>
                        <String CONTENT="One of the marks of superiority is the ability to eat quickly. “When"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l35" HPOS="578" VPOS="2624" WIDTH="1776" HEIGHT="60" BASELINE="581 2669 2354 2665" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2669 581 2684 2352 2680 2354 2665 2352 2637 2307 2624 2304 2624 2302 2624 2300 2624 2265 2637 2153 2637 2135 2624 2133 2624 2131 2624 2129 2624 2055 2634 1967 2624 1964 2624 1962 2624 1925 2634 1889 2624 1886 2624 1884 2624 1804 2634 1406 2626 1403 2626 1401 2626 1399 2626 1384 2637 1135 2626 1133 2626 1131 2626 1083 2639 663 2639 607 2626 604 2626 602 2626 578 2637 581 2669"/>
                        </Shape>
                        <String CONTENT="the young men eat quickly, the old men look on with pleasure,” says the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l36" HPOS="578" VPOS="2682" WIDTH="1776" HEIGHT="74" BASELINE="581 2732 2354 2721" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2732 581 2751 953 2745 1070 2756 1072 2756 1074 2756 1105 2745 1157 2756 1159 2756 1161 2756 1163 2756 1180 2743 1408 2743 1568 2754 1570 2754 1746 2741 1815 2751 1817 2751 1943 2741 1988 2751 1990 2751 1993 2751 2216 2741 2330 2749 2333 2749 2335 2749 2337 2749 2354 2736 2354 2721 2350 2691 1644 2682 1642 2682 1640 2682 1637 2682 1620 2693 1304 2684 1302 2684 578 2699 581 2732"/>
                        </Shape>
                        <String CONTENT="proverb. Accordingly the Reindeer Chukchee have adopted a peculiarly fierce"/>
                    </TextLine>
<TextLine ID="mz_1-056_l37" HPOS="578" VPOS="2745" WIDTH="1776" HEIGHT="60" BASELINE="581 2788 2354 2782" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="581 2788 581 2805 2352 2799 2354 2782 2350 2754 1183 2745 1180 2745 1178 2745 1176 2745 1161 2756 654 2747 652 2747 578 2758 581 2788"/>
                        </Shape>
                        <String CONTENT="and hasty method of eating, accompanied by sounds reminding one of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-056_l38" HPOS="578" VPOS="2803" WIDTH="1776" HEIGHT="63" BASELINE="581 2851 2354 2842" TAGREFS="TYPE_5">
                        <Shape>
