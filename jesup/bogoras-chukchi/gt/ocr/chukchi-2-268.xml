                        <Shape>
                            <Polygon POINTS="513 1386 511 1400 520 1408 522 1408 524 1408 644 1410 646 1410 701 1400 1020 1400 1108 1411 1110 1411 1188 1402 1464 1411 1466 1411 1723 1404 1739 1413 1741 1413 1743 1413 1745 1413 2170 1402 2172 1392 2170 1363 1946 1351 1944 1351 1942 1351 1940 1351 1927 1363 1723 1363 1643 1351 1641 1351 1639 1351 1617 1361 1441 1349 1439 1349 1437 1349 1400 1359 1141 1349 1139 1349 1067 1359 947 1347 945 1347 883 1357 869 1347 867 1347 865 1347 863 1347 799 1357 744 1347 742 1347 740 1347 708 1357 548 1347 546 1347 544 1347 513 1355 513 1386"/>
                        </Shape>
                        <String CONTENT="Among the Maritime people it often happens that persons die at sea"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l17" HPOS="401" VPOS="1415" WIDTH="1769" HEIGHT="45" BASELINE="403 1447 2170 1451" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1447 401 1457 2166 1460 2170 1451 2168 1419 403 1415 403 1447"/>
                        </Shape>
                        <String CONTENT="whose bodies are never recovered. Those who have perished in this manner"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l18" HPOS="399" VPOS="1466" WIDTH="1771" HEIGHT="65" BASELINE="401 1507 2170 1511" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="401 1507 399 1519 413 1529 415 1529 417 1529 419 1531 558 1531 558 1529 560 1529 562 1529 575 1519 601 1529 603 1529 605 1531 605 1529 607 1529 634 1519 660 1529 661 1529 663 1531 793 1531 793 1529 795 1529 797 1529 810 1519 836 1529 838 1529 840 1529 1006 1519 1280 1519 1294 1529 1296 1529 1298 1529 1300 1529 1392 1521 1451 1531 1453 1531 1498 1521 1531 1531 1533 1531 1535 1531 1631 1521 1668 1531 1670 1531 1672 1531 1674 1531 1709 1521 1878 1531 1880 1531 2168 1523 2170 1511 2170 1482 2123 1468 2121 1468 2119 1468 2117 1468 2087 1480 2044 1468 2042 1468 2040 1468 2038 1468 2001 1482 1805 1482 1770 1468 1768 1468 1766 1468 1658 1480 1576 1468 1574 1468 1572 1468 1521 1482 1361 1482 1325 1468 1323 1468 1322 1468 1202 1478 1184 1466 1182 1466 1180 1466 1063 1466 1061 1466 1059 1466 1032 1478 957 1466 955 1466 830 1478 801 1466 799 1466 797 1466 726 1480 562 1480 515 1466 513 1466 511 1466 509 1466 475 1478 401 1478 401 1507"/>
                        </Shape>
                        <String CONTENT="receive a special sacrifice offered at the very edge of the water. In the"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l19" HPOS="403" VPOS="1527" WIDTH="1769" HEIGHT="61" BASELINE="405 1566 2172 1570" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1566 403 1580 415 1588 417 1588 419 1588 421 1588 2170 1582 2172 1570 2170 1541 1976 1529 1974 1529 1972 1529 1950 1539 1919 1529 1917 1529 1915 1529 1807 1539 1748 1529 1747 1529 1745 1529 1743 1529 1727 1541 1531 1541 1478 1529 1476 1529 1474 1529 1437 1539 1357 1529 1355 1529 1353 1529 1329 1539 1214 1527 1212 1527 1210 1527 1175 1537 1139 1527 1137 1527 1135 1527 405 1535 405 1566"/>
                        </Shape>
                        <String CONTENT="feast, the share of the dead is thrown into the water. One and the same"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l20" HPOS="403" VPOS="1590" WIDTH="1767" HEIGHT="58" BASELINE="403 1629 2170 1629" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1629 403 1648 2170 1646 2170 1629 2170 1596 1950 1590 1948 1590 1946 1590 1919 1599 1813 1590 1811 1590 1711 1599 1651 1590 1649 1590 1541 1599 1474 1590 1472 1590 1202 1599 1147 1590 1145 1590 1143 1590 1106 1599 1047 1590 1045 1590 1043 1590 1041 1590 1026 1601 861 1601 763 1590 761 1590 712 1599 656 1590 654 1590 652 1590 650 1590 634 1601 479 1601 436 1590 434 1590 432 1590 430 1590 403 1599 403 1629"/>
                        </Shape>
                        <String CONTENT="place on the shore serves for all commemorative sacrifices of this kind, and"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l21" HPOS="403" VPOS="1646" WIDTH="1765" HEIGHT="61" BASELINE="405 1688 2168 1692" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1688 403 1697 417 1707 419 1707 421 1707 423 1707 2166 1703 2168 1692 2168 1662 2132 1648 2130 1648 2128 1648 2126 1648 2099 1660 1805 1648 1803 1648 1801 1648 1770 1660 1701 1648 1700 1648 1698 1648 1670 1662 1586 1662 1568 1648 1566 1648 1564 1648 1484 1648 1482 1648 1419 1660 1396 1648 1394 1648 1392 1648 1306 1656 1200 1646 1198 1646 1112 1658 1067 1646 1065 1646 924 1646 922 1646 920 1646 918 1646 898 1660 759 1660 726 1646 724 1646 722 1646 720 1646 687 1658 650 1646 648 1646 646 1646 405 1656 405 1688"/>
                        </Shape>
                        <String CONTENT="each family has two “hearth enclosures” in which to offer them, — one in"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l22" HPOS="401" VPOS="1705" WIDTH="1767" HEIGHT="67" BASELINE="403 1744 2168 1750" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1744 401 1758 415 1768 417 1768 419 1768 421 1768 975 1760 2164 1772 2168 1750 2166 1721 1954 1709 1952 1709 1950 1709 1948 1709 1933 1721 1817 1721 1764 1709 1762 1709 1666 1719 1633 1709 1631 1709 1629 1709 1627 1709 1592 1719 1513 1707 1511 1707 1067 1717 991 1705 989 1705 987 1705 985 1705 971 1715 916 1705 914 1705 912 1705 877 1717 595 1717 577 1705 575 1705 573 1705 571 1705 403 1713 403 1744"/>
                        </Shape>
                        <String CONTENT="the village cemetery for those who died on land; and another on the shore,"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l23" HPOS="403" VPOS="1780" WIDTH="1148" HEIGHT="41" BASELINE="403 1807 1551 1807" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1807 403 1821 1551 1821 1551 1807 1551 1780 403 1780 403 1807"/>
                        </Shape>
