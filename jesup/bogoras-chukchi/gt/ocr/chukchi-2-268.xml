                        <Shape>
                            <Polygon POINTS="513 1866 511 1876 634 1887 636 1887 2170 1881 2172 1870 2168 1834 513 1834 513 1866"/>
                        </Shape>
                        <String CONTENT="A man who is supposed to have perished at sea, but who in the end"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l25" HPOS="401" VPOS="1885" WIDTH="1769" HEIGHT="67" BASELINE="403 1925 2170 1930" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1925 401 1936 423 1948 425 1948 426 1948 945 1940 1580 1952 1582 1952 2168 1942 2170 1930 2170 1901 2144 1889 2142 1889 2140 1889 2038 1899 1980 1889 1978 1889 1976 1889 1974 1889 1958 1901 1656 1901 1580 1887 1578 1887 1486 1897 1300 1887 1298 1887 1065 1897 985 1885 983 1885 981 1885 947 1897 830 1897 814 1885 812 1885 810 1885 808 1885 403 1893 403 1925"/>
                        </Shape>
                        <String CONTENT="escapes and lands on shore, must undergo a purifying ceremony. For this"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l26" HPOS="401" VPOS="1944" WIDTH="1767" HEIGHT="67" BASELINE="403 1985 2168 1991" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1985 401 1999 411 2007 413 2007 415 2007 417 2007 898 1999 2164 2011 2168 1991 2166 1962 2054 1962 2019 1948 2017 1948 2015 1948 2013 1948 1980 1960 1784 1948 1782 1948 1676 1960 1643 1948 1641 1948 1639 1948 1584 1960 1564 1946 1562 1946 1560 1946 1558 1946 1557 1946 1523 1958 1378 1946 1376 1946 1308 1958 1188 1958 1173 1946 1171 1946 1169 1946 1167 1946 1165 1946 1133 1958 1118 1946 1116 1946 1114 1946 1112 1946 1110 1946 1065 1958 961 1944 959 1944 957 1944 918 1958 836 1958 818 1944 816 1944 814 1944 812 1944 734 1956 705 1944 703 1944 701 1944 699 1944 667 1954 597 1944 595 1944 593 1944 567 1956 509 1944 507 1944 505 1944 479 1956 403 1948 403 1985"/>
                        </Shape>
                        <String CONTENT="he is girded with a piece of thong. Then a dog is sacrificed to the sea,"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l27" HPOS="401" VPOS="2015" WIDTH="1769" HEIGHT="51" BASELINE="403 2044 2170 2050" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2044 401 2056 415 2066 417 2066 419 2066 421 2066 2168 2062 2170 2050 2168 2021 403 2015 403 2044"/>
                        </Shape>
