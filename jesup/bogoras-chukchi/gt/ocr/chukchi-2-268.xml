                    <TextLine ID="mz_2-268_l2" HPOS="415" VPOS="464" WIDTH="78" HEIGHT="62" BASELINE="419 515 493 509" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="415 485 419 515 419 526 493 518 493 509 485 464 423 473 415 485"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_2-268_l3" HPOS="401" VPOS="565" WIDTH="1772" HEIGHT="57" BASELINE="403 607 2173 611" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2144 577 2125 575 2105 575 2085 575 2066 573 2060 573 2036 577 2023 571 2007 571 1987 571 1952 577 1692 567 1690 567 1688 567 1686 567 1670 579 1582 579 1549 567 1547 567 1545 567 1543 567 1510 577 1441 567 1439 567 1388 577 1367 567 1365 567 1363 567 1227 575 1198 565 1196 565 1194 565 1100 575 1073 565 1071 565 1069 565 991 577 832 577 816 565 814 565 812 565 810 565 738 575 663 565 661 565 660 565 632 575 569 565 567 565 566 565 544 575 440 565 438 565 436 565 403 573 403 607 401 618 2170 622 2173 611 2172 579 2158 577 2144 577"/>
                        </Shape>
                        <String CONTENT="than the first fall ceremonial of the reindeer-breeders. Indeed, the Maritime"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l4" HPOS="403" VPOS="628" WIDTH="1769" HEIGHT="63" BASELINE="405 673 2172 669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 673 405 691 2170 683 2172 669 2170 642 2144 628 2142 628 2140 628 2138 628 2136 628 2119 640 2074 628 2072 628 2070 628 2068 628 2066 628 2044 640 1733 628 1731 628 1729 628 1696 640 1611 628 1609 628 1607 628 1578 640 1504 628 1502 628 1500 628 1472 640 1365 628 1363 628 1361 628 1359 628 1337 642 1188 642 1130 630 1128 630 1126 630 1088 642 1057 630 1055 630 1053 630 953 642 908 630 906 630 904 630 902 630 857 644 697 644 632 630 630 630 562 642 513 630 511 630 509 630 403 644 405 673"/>
                        </Shape>
                        <String CONTENT="people, who as a rule visit the camps about that time, have to carry back"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l5" HPOS="405" VPOS="689" WIDTH="1767" HEIGHT="61" BASELINE="407 728 2172 732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 728 405 742 417 750 419 750 421 750 423 750 2170 744 2172 732 2170 703 2105 691 2103 691 2025 701 1915 691 1913 691 1911 691 1872 701 1815 691 1813 691 1811 691 1768 701 1457 691 1455 691 1118 699 1047 689 1045 689 932 699 867 689 865 689 863 689 824 699 707 689 705 689 407 697 407 728"/>
                        </Shape>
                        <String CONTENT="to their villages the reindeer-meat and antlers necessary for the sacrifice."/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l6" HPOS="409" VPOS="753" WIDTH="1763" HEIGHT="51" BASELINE="409 789 2172 789" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 789 409 802 2170 804 2172 789 2172 757 409 753 409 789"/>
                        </Shape>
                        <String CONTENT="They carry the latter to their dead, and arrange a feast, in which the dead"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l7" HPOS="403" VPOS="816" WIDTH="529" HEIGHT="45" BASELINE="405 844 932 847" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 844 403 857 928 861 932 847 930 820 405 816 405 844"/>
                        </Shape>
                        <String CONTENT="also receive their part."/>
                    </TextLine>
<TextLine ID="mz_2-268_l8" HPOS="513" VPOS="865" WIDTH="1659" HEIGHT="57" BASELINE="515 906 2172 910" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="515 906 513 918 2168 922 2172 910 2172 881 2142 867 2140 867 2138 867 2136 867 2113 879 2087 867 2085 867 2083 867 1978 879 1940 867 1938 867 1936 867 1886 877 1852 867 1850 867 1848 867 1846 867 1844 867 1829 879 1776 867 1774 867 1772 867 1737 881 1631 881 1605 867 1604 867 1602 867 1527 879 1406 867 1404 867 1402 867 1369 879 1333 865 1331 865 1329 865 1327 865 1290 879 1235 879 1220 865 1218 865 1216 865 1214 865 1212 865 1171 877 1139 865 1137 865 1085 865 1083 865 1081 865 1079 865 1061 879 861 879 844 865 842 865 840 865 838 865 836 865 812 877 769 865 767 865 765 865 705 877 689 865 687 865 685 865 683 865 681 865 652 877 613 865 611 865 609 865 607 865 583 877 558 865 556 865 554 865 515 869 515 906"/>
                        </Shape>
                        <String CONTENT="Each family has a special place for the sacrifice to the dead, which is"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l9" HPOS="403" VPOS="928" WIDTH="1769" HEIGHT="55" BASELINE="403 971 2172 971" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 971 403 981 2168 983 2172 971 2170 940 2121 928 2119 928 2117 928 2095 938 2009 928 2007 928 2005 928 1985 938 1954 928 1952 928 1950 928 1948 928 1927 938 1895 928 1893 928 1891 928 1839 938 1778 928 1776 928 1774 928 1750 938 1670 928 1668 928 1619 938 1590 928 1588 928 1586 928 1445 938 1378 928 1376 928 1374 928 1341 938 1251 928 1249 928 1198 938 1141 928 1139 928 971 938 920 928 918 928 824 938 403 936 403 971"/>
                        </Shape>
                        <String CONTENT="in the cemetery, and is called “hearth enclosure” (pênuˊkwun). If, during the"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l10" HPOS="401" VPOS="996" WIDTH="1771" HEIGHT="53" BASELINE="403 1026 2172 1030" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1026 401 1039 421 1049 423 1049 425 1049 2170 1041 2172 1030 2170 1000 403 996 403 1026"/>
                        </Shape>
                        <String CONTENT="ceremony, there are close by corpses of those who have died recently, various"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l11" HPOS="405" VPOS="1051" WIDTH="1767" HEIGHT="61" BASELINE="405 1090 2172 1090" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1090 405 1112 660 1102 1750 1112 1752 1112 1811 1102 1895 1112 1897 1112 2172 1102 2172 1090 2172 1063 1658 1051 1656 1051 1443 1061 1382 1051 1380 1051 1322 1061 1161 1051 1159 1051 1100 1061 981 1051 979 1051 906 1061 822 1051 820 1051 660 1061 560 1051 558 1051 405 1061 405 1090"/>
                        </Shape>
                        <String CONTENT="precautions are taken. Some of those who are sacrificing bring harpoons"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l12" HPOS="403" VPOS="1110" WIDTH="1767" HEIGHT="55" BASELINE="403 1151 2170 1151" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1151 403 1161 2168 1165 2170 1151 2170 1120 2144 1110 2142 1110 2140 1110 2087 1120 1515 1110 1513 1110 1511 1110 1468 1120 1416 1110 1414 1110 1339 1120 1255 1110 1253 1110 1194 1120 1135 1110 1133 1110 1132 1110 1130 1110 1114 1122 1024 1122 930 1110 928 1110 926 1110 924 1110 908 1122 799 1122 763 1110 761 1110 759 1110 564 1120 473 1110 472 1110 403 1120 403 1151"/>
                        </Shape>
                        <String CONTENT="and lances, and use them as if stalking the dead, and striking them with"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l13" HPOS="405" VPOS="1171" WIDTH="1761" HEIGHT="62" BASELINE="405 1210 2166 1210" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1210 405 1222 618 1233 620 1233 744 1223 1057 1233 1059 1233 1106 1223 1212 1233 1214 1233 1292 1223 1417 1223 1433 1233 1435 1233 1437 1233 1439 1233 1570 1223 1658 1233 1660 1233 1721 1223 2164 1225 2166 1210 2166 1182 1739 1171 1737 1171 1668 1180 1609 1171 1607 1171 1605 1171 1584 1180 1547 1171 1545 1171 1543 1171 1414 1180 1374 1171 1372 1171 1370 1171 1269 1180 1135 1171 1133 1171 1132 1171 1094 1180 971 1171 969 1171 967 1171 945 1180 802 1171 801 1171 799 1171 797 1171 781 1182 519 1182 425 1171 423 1171 421 1171 419 1171 405 1178 405 1210"/>
                        </Shape>
                        <String CONTENT="their weapons. Others bring thongs, and spread slings before the corpses."/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l14" HPOS="403" VPOS="1227" WIDTH="1769" HEIGHT="65" BASELINE="405 1267 2172 1270" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1267 403 1282 415 1290 417 1290 419 1290 421 1290 1198 1282 1290 1292 1292 1292 2170 1282 2172 1270 2170 1241 2087 1229 2085 1229 2083 1229 2054 1241 1893 1241 1872 1229 1870 1229 1868 1229 1866 1229 1833 1239 1797 1229 1795 1229 1794 1229 1196 1237 1163 1227 1161 1227 1159 1227 1157 1227 1120 1239 820 1239 804 1227 802 1227 801 1227 799 1227 797 1227 767 1237 683 1227 681 1227 405 1235 405 1267"/>
                        </Shape>
                        <String CONTENT="After finishing the ceremony, the people repeat their hostile demonstrations"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l15" HPOS="403" VPOS="1300" WIDTH="1065" HEIGHT="43" BASELINE="403 1329 1468 1329" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 1329 403 1343 1468 1343 1468 1329 1468 1300 403 1300 403 1329"/>
                        </Shape>
                        <String CONTENT="and then run away in a most hurried manner."/>
                    </TextLine>
