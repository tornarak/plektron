                    </TextLine>

                    <TextLine ID="mz_2-268_l28" HPOS="401" VPOS="2064" WIDTH="1765" HEIGHT="62" BASELINE="403 2105 2166 2113" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="403 2105 401 2115 425 2126 426 2126 428 2126 2164 2124 2166 2113 2166 2081 2134 2069 2132 2069 2130 2069 1864 2079 1831 2069 1829 2069 1827 2069 1764 2079 1725 2068 1723 2068 1721 2068 1652 2077 1631 2068 1629 2068 1627 2068 1574 2077 1527 2068 1525 2068 1329 2077 1314 2068 1312 2068 1310 2068 1308 2068 1175 2075 1092 2066 1090 2066 1088 2066 1055 2075 963 2066 961 2066 875 2075 765 2064 763 2064 761 2064 734 2073 640 2064 638 2064 636 2064 609 2073 517 2064 515 2064 403 2071 403 2105"/>
                        </Shape>
                        <String CONTENT="family, where he must lie down on the ground and wallow in the rubbish."/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l29" HPOS="405" VPOS="2126" WIDTH="1765" HEIGHT="65" BASELINE="407 2165 2170 2169" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2165 405 2177 434 2189 436 2189 438 2189 1163 2181 1290 2191 1292 2191 2168 2181 2170 2169 2168 2140 2077 2128 2076 2128 2013 2138 1884 2128 1882 2128 1809 2138 1774 2128 1772 2128 1770 2128 1768 2128 1747 2140 1600 2140 1582 2128 1580 2128 1578 2128 1451 2128 1449 2128 1447 2128 1414 2138 1363 2128 1361 2128 1359 2128 1318 2138 1075 2126 1073 2126 885 2136 814 2126 812 2126 810 2126 779 2136 708 2126 707 2126 626 2136 407 2128 407 2165"/>
                        </Shape>
                        <String CONTENT="This resembles the purification, among the Reindeer people, of the objects"/>
                    </TextLine>

                    <TextLine ID="mz_2-268_l30" HPOS="401" VPOS="2195" WIDTH="1765" HEIGHT="51" BASELINE="403 2224 2166 2228" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2158 2197 403 2195 403 2224 401 2240 2162 2246 2166 2228 2164 2212 2158 2197"/>
                        </Shape>
                        <String CONTENT="connected with the funeral, through immersing them in the refuse from the"/>
                    </TextLine>

