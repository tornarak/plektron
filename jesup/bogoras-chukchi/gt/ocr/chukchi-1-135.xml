                <TextBlock ID="text_1-135" HPOS="308" VPOS="625" WIDTH="1806" HEIGHT="2626"><TextLine ID="mz_1-135_l1" HPOS="912" VPOS="625" WIDTH="619" HEIGHT="54" BASELINE="914 662 1531 658" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1518 625 912 628 914 662 914 679 1529 675 1531 658 1527 640 1518 625"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l2" HPOS="2014" VPOS="632" WIDTH="93" HEIGHT="50" BASELINE="2014 662 2107 662" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2101 638 2079 634 2058 632 2014 632 2014 662 2014 682 2107 682 2107 662 2107 638 2101 638"/>
                        </Shape>
                        <String CONTENT="103"/>
                    </TextLine>
<TextLine ID="mz_1-135_l3" HPOS="336" VPOS="727" WIDTH="1778" HEIGHT="61" BASELINE="338 773 2114 764" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="782 729 780 729 734 740 355 731 353 731 351 731 349 731 347 731 336 738 338 773 338 788 2112 779 2114 764 2109 727 1302 727 1300 727 1219 738 784 729 782 729"/>
                        </Shape>
                        <String CONTENT="day’s run, most drivers, when food is not scarce, give their dogs a piece of"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l4" HPOS="336" VPOS="788" WIDTH="1778" HEIGHT="65" BASELINE="338 831 2114 827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 831 338 844 2092 853 2094 853 2097 853 2099 853 2114 842 2114 827 2109 799 1226 788 1224 788 1222 788 1193 801 336 801 338 831"/>
                        </Shape>
                        <String CONTENT="blubber by way of encouragement. The dogs can go several days without"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l5" HPOS="336" VPOS="846" WIDTH="1776" HEIGHT="61" BASELINE="338 894 2112 887" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 894 338 907 2109 902 2112 887 2105 855 1616 857 1564 846 1562 846 1559 846 1557 846 1542 859 1386 859 1352 848 1349 848 1347 848 1289 859 1230 848 1228 848 1165 859 1046 848 1044 848 1042 848 1040 848 1025 859 817 851 814 851 812 851 782 861 728 851 726 851 723 851 721 851 702 863 466 863 353 851 351 851 349 851 347 851 336 857 338 894"/>
                        </Shape>
                        <String CONTENT="food, even on the journey. They will, of course, become very weak, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l6" HPOS="336" VPOS="909" WIDTH="1773" HEIGHT="69" BASELINE="338 954 2109 944" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 954 338 967 689 978 691 978 693 978 721 965 843 976 845 976 847 976 884 965 1022 974 1025 974 1027 974 1048 963 1291 974 1293 974 1403 961 1516 972 1518 972 1520 972 1553 961 1579 972 1581 972 1583 972 1642 961 1746 972 1748 972 1750 972 1752 972 1765 959 1787 970 1789 970 1791 970 1865 959 1882 970 1884 970 1886 970 1889 970 2107 963 2109 944 2105 915 1089 909 1087 909 1085 909 1042 920 743 911 741 911 336 924 338 954"/>
                        </Shape>
                        <String CONTENT="unable to carry heavy loads. When not at work, the dogs can subsist on"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l7" HPOS="338" VPOS="963" WIDTH="1774" HEIGHT="76" BASELINE="340 1015 2112 1006" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1015 340 1028 429 1039 431 1039 433 1039 435 1039 451 1028 572 1037 574 1037 981 1026 996 1037 999 1037 1001 1037 1003 1039 1133 1039 1133 1037 1135 1037 1137 1037 1152 1026 1406 1035 1408 1035 1410 1035 1440 1024 1594 1035 1596 1035 1670 1022 1772 1032 1774 1032 1776 1032 1804 1022 1997 1032 1999 1032 2001 1032 2003 1032 2019 1022 2088 1032 2090 1032 2092 1032 2094 1032 2112 1019 2112 1006 2107 976 1951 976 1925 963 1923 963 1921 963 1858 974 1832 963 1830 963 1828 963 1826 963 1804 974 1460 965 1458 965 1455 965 1429 976 1315 965 1313 965 1310 965 1308 965 1293 976 1196 967 1193 967 1089 978 1057 967 1055 967 1053 967 1050 967 1007 978 953 967 951 967 949 967 916 978 882 967 879 967 877 967 574 980 472 970 470 970 468 970 466 970 451 983 338 983 340 1015"/>
                        </Shape>
                        <String CONTENT="very little. At the end of spring, when sledge-driving is over, the dogs are"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l8" HPOS="336" VPOS="1030" WIDTH="1776" HEIGHT="59" BASELINE="338 1073 2112 1067" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1073 338 1089 2109 1082 2112 1067 2107 1037 386 1030 383 1030 381 1030 336 1041 338 1073"/>
                        </Shape>
                        <String CONTENT="released for the summer, and are not fed at all, because the seal-catch is not"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l9" HPOS="336" VPOS="1091" WIDTH="1773" HEIGHT="56" BASELINE="338 1134 2109 1128" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1134 338 1147 2107 1143 2109 1128 2105 1097 370 1091 368 1091 366 1091 336 1102 338 1134"/>
                        </Shape>
                        <String CONTENT="abundant; then they live on such scraps as they can secure. During the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l10" HPOS="338" VPOS="1145" WIDTH="1769" HEIGHT="63" BASELINE="340 1190 2107 1184" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1190 340 1208 2105 1206 2107 1184 2103 1156 1529 1145 1527 1145 1525 1145 1523 1145 1507 1156 964 1147 962 1147 836 1158 414 1149 412 1149 338 1160 340 1190"/>
                        </Shape>
                        <String CONTENT="entire summer, in certain localities, the dogs find their own subsistence. In"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l11" HPOS="338" VPOS="1208" WIDTH="1774" HEIGHT="60" BASELINE="340 1251 2112 1247" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1251 340 1268 2109 1264 2112 1247 2107 1219 1243 1208 1241 1208 1124 1219 364 1210 362 1210 360 1210 338 1219 340 1251"/>
                        </Shape>
                        <String CONTENT="the Kolyma country, for instance, they live on mice and spermophiles; on the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l12" HPOS="338" VPOS="1281" WIDTH="1213" HEIGHT="46" BASELINE="338 1309 1551 1309" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1309 338 1327 1551 1327 1551 1309 1551 1281 338 1281 338 1309"/>
                        </Shape>
                        <String CONTENT="southern shores of Bering Sea, on dead salmon, etc."/>
                    </TextLine>
<TextLine ID="mz_1-135_l13" HPOS="451" VPOS="1340" WIDTH="1661" HEIGHT="47" BASELINE="451 1370 2112 1370" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 1370 451 1387 2112 1387 2112 1370 2112 1340 451 1340 451 1370"/>
                        </Shape>
                        <String CONTENT="After the summer rest, the dogs, before being put into harness, have to"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l14" HPOS="336" VPOS="1387" WIDTH="1776" HEIGHT="59" BASELINE="338 1431 2112 1426" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1431 338 1446 2109 1442 2112 1426 2107 1398 1488 1387 1486 1387 336 1398 338 1431"/>
                        </Shape>
                        <String CONTENT="be carefully tied up and kept for a day or two with very little food, or even"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l15" HPOS="338" VPOS="1448" WIDTH="1774" HEIGHT="58" BASELINE="340 1491 2112 1487" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1491 340 1506 2109 1502 2112 1487 2107 1459 1228 1448 1226 1448 1224 1448 1183 1459 381 1450 379 1450 377 1450 338 1461 340 1491"/>
                        </Shape>
                        <String CONTENT="without any, according to the amount of fat they have accumulated. Dogs"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l16" HPOS="338" VPOS="1515" WIDTH="1776" HEIGHT="52" BASELINE="340 1552 2114 1545" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1552 340 1567 2112 1563 2114 1545 2107 1515 338 1517 340 1552"/>
                        </Shape>
                        <String CONTENT="harnessed too soon will be spoiled for the whole winter, being unable to endure"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l17" HPOS="338" VPOS="1578" WIDTH="1771" HEIGHT="50" BASELINE="340 1613 2109 1606" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1613 340 1628 2107 1621 2109 1606 2105 1578 338 1578 340 1613"/>
                        </Shape>
                        <String CONTENT="long, fast runs. Dogs are harnessed in the first autumn of their lives, often"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l18" HPOS="336" VPOS="1623" WIDTH="1776" HEIGHT="74" BASELINE="338 1673 2112 1665" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1673 338 1686 576 1697 578 1697 581 1697 583 1697 600 1686 767 1695 769 1695 1055 1684 1172 1695 1174 1695 1300 1682 1451 1693 1453 1693 2109 1680 2112 1665 2107 1636 1928 1623 1925 1623 1923 1623 1893 1634 1865 1623 1863 1623 1860 1623 1858 1623 1856 1623 1841 1636 1733 1636 1705 1623 1702 1623 1700 1623 1698 1623 1650 1636 1622 1626 1620 1626 1618 1626 1616 1626 1590 1636 1343 1626 1341 1626 1339 1626 1336 1626 1319 1636 1196 1628 1193 1628 1191 1628 1161 1639 944 1628 942 1628 890 1639 838 1628 836 1628 773 1641 379 1630 377 1630 375 1630 336 1641 338 1673"/>
                        </Shape>
                        <String CONTENT="when only two months old. Sometimes the female dog is attached in the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l19" HPOS="336" VPOS="1691" WIDTH="1776" HEIGHT="56" BASELINE="338 1734 2112 1727" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1734 338 1747 2109 1740 2112 1727 2107 1697 353 1691 351 1691 349 1691 347 1691 336 1697 338 1734"/>
                        </Shape>
                        <String CONTENT="front, and her whole litter of pups in the rear. In a few months, when the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l20" HPOS="336" VPOS="1749" WIDTH="1773" HEIGHT="65" BASELINE="338 1794 2109 1786" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1794 338 1814 2107 1801 2109 1786 2105 1758 1252 1749 1250 1749 1248 1749 1217 1760 966 1751 964 1751 336 1764 338 1794"/>
                        </Shape>
                        <String CONTENT="pups are quite grown, such a team will perform heavier and more uniform"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l21" HPOS="340" VPOS="1823" WIDTH="498" HEIGHT="45" BASELINE="340 1851 838 1851" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 1851 340 1868 838 1868 838 1851 838 1823 340 1823 340 1851"/>
                        </Shape>
                        <String CONTENT="work than any other."/>
                    </TextLine>
<TextLine ID="mz_1-135_l22" HPOS="448" VPOS="1862" WIDTH="1664" HEIGHT="69" BASELINE="451 1914 2112 1903" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 1914 451 1927 1769 1931 1772 1931 1774 1931 1819 1920 2090 1929 2092 1929 2094 1929 2097 1929 2112 1918 2112 1903 2107 1875 2034 1862 2032 1862 1932 1872 1908 1862 1906 1862 1904 1862 1902 1862 1899 1862 1884 1875 1778 1875 1759 1864 1756 1864 1754 1864 1752 1864 1750 1864 1722 1877 1497 1877 1471 1864 1468 1864 1466 1864 1464 1864 1462 1864 1442 1877 1352 1866 1349 1866 1347 1866 1323 1877 1228 1866 1226 1866 1224 1866 1193 1877 448 1877 451 1914"/>
                        </Shape>
                        <String CONTENT="The females are good leaders; but, since they are weaker and smaller"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l23" HPOS="336" VPOS="1924" WIDTH="1773" HEIGHT="63" BASELINE="338 1972 2109 1963" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="338 1972 338 1987 2107 1981 2109 1963 2105 1935 1672 1924 1670 1924 1668 1924 1666 1924 1653 1935 357 1931 355 1931 353 1931 351 1931 336 1937 338 1972"/>
                        </Shape>
                        <String CONTENT="than the males, they are not good for drawing heavy loads. The males are"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l24" HPOS="334" VPOS="1985" WIDTH="1773" HEIGHT="67" BASELINE="336 2035 2107 2028" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="336 2035 336 2052 2105 2052 2107 2028 2103 1996 1956 1985 1954 1985 1867 1996 1843 1985 1841 1985 1839 1985 1837 1985 1834 1985 1815 1998 1681 1998 1603 1985 1601 1985 1507 2000 1263 2000 1230 1987 1228 1987 1226 1987 1074 1998 986 1987 983 1987 981 1987 979 1987 964 1998 713 1989 710 1989 609 2000 550 1989 548 1989 546 1989 509 2000 496 1989 494 1989 492 1989 399 1989 396 1989 334 2000 336 2035"/>
                        </Shape>
                        <String CONTENT="gelded with an iron knife. The operation, contrary to that upon the reindeer,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l25" HPOS="308" VPOS="2048" WIDTH="1801" HEIGHT="58" BASELINE="308 2089 2109 2089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="308 2089 308 2106 2109 2106 2109 2089 2109 2061 1973 2048 1843 2048 1841 2048 1839 2048 1837 2048 1821 2059 1746 2048 1744 2048 1741 2048 1707 2059 1674 2048 1672 2048 1670 2048 1668 2048 1624 2059 1585 2048 1583 2048 1581 2048 1579 2048 1533 2059 1466 2048 1464 2048 1384 2059 1310 2048 1308 2048 1306 2048 1274 2059 1237 2048 1235 2048 1232 2048 1230 2048 1193 2059 1096 2048 1094 2048 1092 2048 1059 2059 1001 2048 999 2048 996 2048 966 2059 862 2048 860 2048 858 2048 834 2059 784 2048 782 2048 697 2059 308 2052 308 2089"/>
                        </Shape>
                        <String CONTENT="requires some skill, since the fat male dog will easily die from bleeding or"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l26" HPOS="329" VPOS="2113" WIDTH="1783" HEIGHT="52" BASELINE="332 2152 2112 2145" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="332 2152 332 2165 2109 2160 2112 2145 2107 2117 329 2113 332 2152"/>
                        </Shape>
                        <String CONTENT="inflammation. On the Kolyma, the operators assert that they can cause the"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l27" HPOS="338" VPOS="2169" WIDTH="1771" HEIGHT="61" BASELINE="340 2212 2109 2208" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 2212 340 2227 2105 2230 2109 2208 2105 2180 1224 2169 1222 2169 1219 2169 1185 2180 399 2171 396 2171 338 2182 340 2212"/>
                        </Shape>
                        <String CONTENT="animal operated on to assume afterward whatever pace they like, — trot, canter,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l28" HPOS="338" VPOS="2225" WIDTH="1774" HEIGHT="65" BASELINE="340 2273 2112 2264" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 2273 340 2290 2109 2282 2112 2264 2107 2236 1668 2225 1666 2225 1663 2225 1661 2225 1644 2236 797 2230 795 2230 793 2230 791 2230 775 2240 470 2232 468 2232 338 2243 340 2273"/>
                        </Shape>
                        <String CONTENT="or gallop. On the Pacific side there is no occasion for such assertion, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l29" HPOS="340" VPOS="2290" WIDTH="1774" HEIGHT="65" BASELINE="342 2334 2114 2325" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2334 342 2347 1222 2355 1224 2355 1226 2355 1263 2344 1655 2353 1657 2353 1659 2353 1661 2353 1661 2351 1672 2342 2094 2351 2097 2351 2099 2351 2101 2351 2114 2340 2114 2325 2109 2297 793 2290 791 2290 788 2290 786 2290 769 2301 360 2292 357 2292 355 2292 353 2292 340 2299 342 2334"/>
                        </Shape>
                        <String CONTENT="the dogs are not allowed to go at any swifter pace than a brisk trot. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l30" HPOS="340" VPOS="2342" WIDTH="1772" HEIGHT="67" BASELINE="342 2392 2112 2383" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2392 342 2409 2109 2401 2112 2383 2109 2355 2075 2342 2073 2342 2071 2342 1854 2353 1824 2342 1821 2342 1819 2342 1817 2342 1787 2353 1748 2342 1746 2342 1744 2342 1741 2342 1722 2353 1700 2342 1698 2342 1696 2342 1694 2342 1663 2355 1501 2344 1499 2344 1429 2355 1399 2344 1397 2344 1395 2344 1339 2355 1300 2344 1297 2344 1295 2344 1209 2357 1193 2347 1191 2347 1189 2347 1187 2347 1185 2347 1157 2357 979 2347 977 2347 912 2357 847 2347 845 2347 736 2360 706 2349 704 2349 702 2349 416 2360 353 2349 351 2349 349 2349 347 2349 347 2351 340 2355 342 2392"/>
                        </Shape>
                        <String CONTENT="Kamchadal and the Koryak crop the tails of their dogs, believing that this"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l31" HPOS="340" VPOS="2403" WIDTH="1767" HEIGHT="65" BASELINE="342 2453 2107 2444" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2453 342 2468 2105 2463 2107 2444 2103 2416 2012 2403 2010 2403 2008 2403 2006 2403 1990 2416 1828 2416 1785 2403 1782 2403 1780 2403 1720 2414 1689 2403 1687 2403 1685 2403 1683 2403 1681 2403 1663 2416 1650 2405 1648 2405 1646 2405 1644 2405 1642 2405 1614 2416 1494 2405 1492 2405 1490 2405 1458 2416 1388 2405 1386 2405 1280 2416 1248 2405 1245 2405 1243 2405 1241 2405 1239 2405 1219 2418 1139 2407 1137 2407 908 2418 873 2407 871 2407 869 2407 769 2420 726 2409 723 2409 721 2409 490 2420 383 2409 381 2409 379 2409 340 2422 342 2453"/>
                        </Shape>
                        <String CONTENT="will increase their speed. Disobedient dogs often have their tails cropped on"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l32" HPOS="338" VPOS="2470" WIDTH="1774" HEIGHT="58" BASELINE="340 2513 2112 2505" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 2513 340 2528 2109 2520 2112 2505 2107 2474 364 2470 362 2470 360 2470 338 2479 340 2513"/>
                        </Shape>
                        <String CONTENT="the road, and have to go till evening, the blood trickling all the while. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l33" HPOS="338" VPOS="2528" WIDTH="1774" HEIGHT="61" BASELINE="340 2574 2112 2563" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="340 2574 340 2589 2109 2578 2112 2563 2107 2535 1048 2528 1046 2528 966 2539 357 2533 355 2533 353 2533 351 2533 338 2539 340 2574"/>
                        </Shape>
                        <String CONTENT="team-dogs serve till ten or twelve years old. After the sixth or seventh year"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l34" HPOS="340" VPOS="2587" WIDTH="1769" HEIGHT="60" BASELINE="342 2632 1932 2626 2109 2632" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2632 342 2645 2105 2647 2109 2632 2107 2595 944 2587 942 2587 940 2587 903 2598 366 2589 364 2589 362 2589 340 2598 342 2632"/>
                        </Shape>
                        <String CONTENT="they begin to decline. Contrary to what has been said of the Eskimo dog,"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l35" HPOS="340" VPOS="2645" WIDTH="1765" HEIGHT="63" BASELINE="342 2693 2105 2684" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2693 342 2708 2103 2704 2105 2684 2099 2645 1313 2656 1282 2645 1280 2645 1278 2645 1213 2658 1087 2647 1085 2647 860 2658 823 2647 821 2647 819 2647 730 2660 466 2650 464 2650 461 2650 418 2660 362 2650 360 2650 357 2650 355 2650 340 2658 342 2693"/>
                        </Shape>
                        <String CONTENT="the Asiatic harness-dogs are sullen, and care little about their masters. I"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l36" HPOS="340" VPOS="2704" WIDTH="1772" HEIGHT="65" BASELINE="342 2751 2112 2743" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2751 342 2769 2109 2760 2112 2743 2107 2715 1746 2704 1744 2704 1663 2715 455 2710 453 2710 340 2721 342 2751"/>
                        </Shape>
                        <String CONTENT="myself had occasion to breed several generations of dogs under the ordinary"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l37" HPOS="340" VPOS="2771" WIDTH="1774" HEIGHT="58" BASELINE="342 2814 2114 2803" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="342 2814 342 2829 2112 2821 2114 2803 2109 2771 734 2771 732 2771 617 2782 431 2773 429 2773 340 2784 342 2814"/>
                        </Shape>
                        <String CONTENT="conditions. Most of those that I gave away would not recognize me at all"/>
                    </TextLine>

                    <TextLine ID="mz_1-135_l38" HPOS="344" VPOS="2842" WIDTH="457" HEIGHT="46" BASELINE="344 2873 801 2873" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="344 2873 344 2888 801 2888 801 2873 801 2842 344 2842 344 2873"/>
                        </Shape>
                        <String CONTENT="after a few months."/>
