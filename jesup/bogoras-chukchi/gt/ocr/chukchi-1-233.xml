                <TextBlock ID="text_1-233" HPOS="422" VPOS="608" WIDTH="1778" HEIGHT="2622"><TextLine ID="mz_1-233_l1" HPOS="996" VPOS="608" WIDTH="620" HEIGHT="54" BASELINE="999 640 1616 645" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="1607 608 1306 608 1302 608 1280 608 1258 608 1237 608 1215 608 1193 608 1172 608 1150 608 1128 608 1107 608 1085 608 1063 608 1042 608 1020 608 999 610 999 640 996 658 1611 662 1616 645 1614 615 1607 608"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l2" HPOS="2092" VPOS="617" WIDTH="95" HEIGHT="47" BASELINE="2094 649 2187 645" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="2179 628 2157 623 2135 619 2129 617 2092 617 2094 649 2094 664 2185 662 2187 645 2185 643 2179 628"/>
                        </Shape>
                        <String CONTENT="181"/>
                    </TextLine>
<TextLine ID="mz_1-233_l3" HPOS="422" VPOS="710" WIDTH="1778" HEIGHT="60" BASELINE="425 757 2200 753" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="574 714 552 716 548 716 539 725 422 725 425 757 425 770 2198 766 2200 753 2198 723 2148 710 2146 710 2144 710 2142 710 2118 721 1453 710 1451 710 1449 710 1447 710 1432 721 1161 712 1159 712 1096 723 1048 712 1046 712 1044 712 1042 712 994 723 767 712 765 712 762 712 741 723 710 712 708 712 706 712 648 723 578 714 574 714"/>
                        </Shape>
                        <String CONTENT="XVII, Fig. 1) (waˊlkar; pl., waˊlkarat) are found. These ruins seem to be"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l4" HPOS="422" VPOS="781" WIDTH="1778" HEIGHT="48" BASELINE="422 814 2200 814" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="422 814 422 829 2200 829 2200 814 2198 781 422 781 422 814"/>
                        </Shape>
                        <String CONTENT="ancient, and are either circular holes or flat mounds, with some battered"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l5" HPOS="425" VPOS="844" WIDTH="1771" HEIGHT="50" BASELINE="425 874 2196 874" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 874 425 889 2194 894 2196 874 2196 844 425 844 425 874"/>
                        </Shape>
                        <String CONTENT="rafters and beams of bone of the whale. In some villages — as, for example,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l6" HPOS="422" VPOS="894" WIDTH="1778" HEIGHT="65" BASELINE="425 935 2200 931" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 935 425 948 1384 957 1386 957 1741 946 1756 957 1759 957 1761 957 1763 959 1915 959 1915 957 1917 957 1941 946 1980 957 1982 957 1984 957 1986 957 2008 946 2112 957 2114 957 2116 957 2138 946 2174 957 2177 957 2179 957 2181 957 2183 957 2200 944 2200 931 2194 894 422 900 425 935"/>
                        </Shape>
                        <String CONTENT="in ᴇˊnmɪlɪn — the inhabitants have forgotten the exact location of most of"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l7" HPOS="425" VPOS="963" WIDTH="1771" HEIGHT="48" BASELINE="425 993 2196 993" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 993 425 1011 2196 1011 2196 993 2196 963 425 963 425 993"/>
                        </Shape>
                        <String CONTENT="the ruins, because the village has been shifted several times since. In Euˊnmun"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l8" HPOS="425" VPOS="1011" WIDTH="1773" HEIGHT="67" BASELINE="427 1052 2198 1048" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 1052 427 1067 1072 1078 1074 1078 1076 1078 1111 1067 1230 1078 1232 1078 1235 1078 1267 1067 1579 1076 1581 1076 1583 1076 1585 1076 1598 1065 1611 1076 1614 1076 1616 1076 1618 1076 1687 1065 2051 1076 2053 1076 2055 1076 2081 1065 2177 1076 2179 1076 2181 1076 2183 1076 2198 1063 2198 1048 2194 1019 494 1011 492 1011 425 1022 427 1052"/>
                        </Shape>
                        <String CONTENT="and Wuteˊen the “jaw-bone houses” overhanging the flat sandy shore were,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l9" HPOS="425" VPOS="1069" WIDTH="1773" HEIGHT="65" BASELINE="427 1115 2198 1110" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 1115 427 1134 2198 1123 2198 1110 2194 1080 1378 1069 1375 1069 1306 1080 516 1071 513 1071 425 1082 427 1115"/>
                        </Shape>
                        <String CONTENT="gradually destroyed by the weather, and crumbled down, together with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l10" HPOS="425" VPOS="1130" WIDTH="1771" HEIGHT="58" BASELINE="425 1171 2196 1171" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1171 425 1188 2196 1188 2196 1171 2196 1141 2159 1130 2157 1130 2047 1130 2045 1130 2042 1130 2040 1130 2027 1141 2006 1130 2003 1130 2001 1130 1999 1130 1975 1141 1793 1130 1791 1130 1789 1130 1761 1141 1720 1130 1718 1130 1715 1130 1713 1130 1683 1141 1559 1130 1557 1130 1490 1141 1412 1130 1410 1130 1358 1141 1306 1130 1304 1130 1302 1130 1269 1141 1217 1130 1215 1130 1213 1130 1167 1143 1038 1143 1022 1130 1020 1130 1018 1130 1016 1130 1014 1130 983 1141 949 1130 947 1130 944 1130 838 1143 741 1143 726 1130 723 1130 721 1130 719 1130 717 1130 687 1141 624 1130 622 1130 620 1130 578 1141 425 1138 425 1171"/>
                        </Shape>
                        <String CONTENT="ledge of rock on which they stood. In other villages, for instance, in Čeˊčin"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l11" HPOS="422" VPOS="1197" WIDTH="1770" HEIGHT="54" BASELINE="425 1229 2192 1234" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1229 422 1245 2187 1251 2192 1234 2190 1201 425 1197 425 1229"/>
                        </Shape>
                        <String CONTENT="and at Indian Point, they are in the immediate vicinity of the present habitations,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l12" HPOS="422" VPOS="1247" WIDTH="1768" HEIGHT="69" BASELINE="425 1288 2190 1294" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1288 422 1305 433 1314 435 1314 438 1314 440 1314 964 1305 1020 1316 1022 1316 2187 1307 2190 1294 2187 1264 1767 1251 1765 1251 1603 1262 1542 1249 1429 1249 1427 1249 1425 1249 1423 1249 1408 1260 1326 1249 1323 1249 1148 1260 1122 1249 1120 1249 1118 1249 1014 1260 938 1247 936 1247 866 1260 736 1260 717 1247 715 1247 713 1247 710 1247 708 1247 663 1258 574 1247 572 1247 570 1247 544 1258 511 1247 509 1247 507 1247 425 1255 425 1288"/>
                        </Shape>
                        <String CONTENT="and the villagers still remember to what families most of the ruins belong."/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l13" HPOS="425" VPOS="1312" WIDTH="1769" HEIGHT="56" BASELINE="427 1353 2194 1346" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 1353 427 1368 2192 1366 2194 1346 2190 1318 446 1312 444 1312 442 1312 440 1312 425 1318 427 1353"/>
                        </Shape>
                        <String CONTENT="As before mentioned, they claim that these houses went out of use three"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l14" HPOS="422" VPOS="1370" WIDTH="1774" HEIGHT="63" BASELINE="425 1413 2196 1409" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1413 425 1433 2194 1424 2196 1409 2192 1381 1352 1370 1349 1370 1282 1381 583 1372 581 1372 422 1383 425 1413"/>
                        </Shape>
                        <String CONTENT="generations ago. At the time of Hooper’s visit in 1848, houses of the modern"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l15" HPOS="422" VPOS="1437" WIDTH="1774" HEIGHT="54" BASELINE="425 1474 2196 1468" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1474 425 1491 2194 1485 2196 1468 2190 1437 422 1442 425 1474"/>
                        </Shape>
                        <String CONTENT="type were already in use, and he mentions having seen half-ruined underground"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l16" HPOS="425" VPOS="1498" WIDTH="1771" HEIGHT="50" BASELINE="427 1532 2196 1528" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 1532 427 1548 2194 1543 2196 1528 2192 1500 425 1498 427 1532"/>
                        </Shape>
                        <String CONTENT="houses which were in no better condition when I found them, fifty-two years"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l17" HPOS="422" VPOS="1543" WIDTH="1772" HEIGHT="63" BASELINE="425 1593 2194 1587" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1593 425 1606 2192 1604 2194 1587 2190 1556 1858 1543 1856 1543 1854 1543 1817 1554 1791 1543 1789 1543 1787 1543 1785 1543 1763 1554 1739 1543 1737 1543 1735 1543 1733 1543 1713 1554 1696 1543 1694 1543 1692 1543 1689 1543 1687 1543 1648 1554 1627 1543 1624 1543 1622 1543 1620 1543 1618 1543 1596 1556 1176 1545 1174 1545 1172 1545 1148 1556 1092 1545 1089 1545 981 1558 955 1548 953 1548 951 1548 949 1548 914 1558 814 1548 812 1548 752 1558 648 1548 646 1548 422 1556 425 1593"/>
                        </Shape>
                        <String CONTENT="later. The waˊlkar of the Maritime Chukchee and Asiatic Eskimo had a"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l18" HPOS="422" VPOS="1610" WIDTH="1774" HEIGHT="57" BASELINE="425 1652 2196 1647" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1652 425 1667 2194 1662 2196 1647 2192 1619 435 1610 433 1610 431 1610 429 1610 429 1613 422 1617 425 1652"/>
                        </Shape>
                        <String CONTENT="frame made of jaw-bones. Heavy pieces were set in the ground in an upright"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l19" HPOS="422" VPOS="1667" WIDTH="1774" HEIGHT="67" BASELINE="425 1712 2196 1706" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1712 425 1734 2194 1723 2196 1706 2192 1678 1676 1667 1674 1667 1588 1678 1141 1669 1139 1669 1009 1680 500 1671 498 1671 422 1682 425 1712"/>
                        </Shape>
                        <String CONTENT="position at intervals all around the house, and were held in place by earth"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l20" HPOS="425" VPOS="1742" WIDTH="1771" HEIGHT="46" BASELINE="425 1771 2196 1771" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1771 425 1788 2196 1788 2196 1771 2196 1742 425 1742 425 1771"/>
                        </Shape>
                        <String CONTENT="and stones. Sometimes there were about sixteen of these supports, so that"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l21" HPOS="422" VPOS="1790" WIDTH="1776" HEIGHT="65" BASELINE="425 1831 2198 1827" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1831 425 1844 1289 1855 1291 1855 1293 1855 1295 1855 1313 1844 2019 1853 2021 1853 2198 1840 2198 1827 2194 1799 442 1790 440 1790 438 1790 435 1790 422 1797 425 1831"/>
                        </Shape>
                        <String CONTENT="they formed a regular fence. Large pieces of jaw-bone or of whale’s ribs"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l22" HPOS="425" VPOS="1862" WIDTH="1771" HEIGHT="45" BASELINE="425 1890 2196 1890" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1890 425 1907 2196 1907 2196 1890 2196 1862 425 1862 425 1890"/>
                        </Shape>
                        <String CONTENT="were superposed as rafters, and smaller pieces were inserted to make the"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l23" HPOS="422" VPOS="1918" WIDTH="1774" HEIGHT="47" BASELINE="425 1950 2196 1946" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 1950 425 1965 2194 1961 2196 1946 2190 1918 422 1920 425 1950"/>
                        </Shape>
                        <String CONTENT="structure more compact. The floor, or at least the middle part of it, was"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l24" HPOS="425" VPOS="1965" WIDTH="1771" HEIGHT="70" BASELINE="427 2011 2196 2007" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2011 427 2035 2194 2022 2196 2007 2194 1978 2168 1965 2166 1965 2164 1965 2090 1976 2066 1965 2064 1965 2062 1965 1997 1978 1559 1978 1520 1965 1518 1965 1516 1965 1514 1965 1512 1965 1499 1976 1471 1965 1468 1965 1466 1965 1388 1976 1358 1965 1356 1965 1354 1965 1291 1978 1254 1968 1252 1968 1250 1968 875 1978 840 1968 838 1968 836 1968 834 1968 791 1978 723 1968 721 1968 719 1968 689 1978 626 1968 624 1968 622 1968 583 1978 546 1968 544 1968 542 1968 425 1981 427 2011"/>
                        </Shape>
                        <String CONTENT="paved with flat pieces of bone. Then the whole structure was covered with"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l25" HPOS="422" VPOS="2028" WIDTH="1774" HEIGHT="59" BASELINE="425 2072 2196 2065" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2072 425 2087 2194 2080 2196 2065 2192 2037 1016 2028 1014 2028 1012 2028 968 2039 485 2030 483 2030 422 2041 425 2072"/>
                        </Shape>
                        <String CONTENT="sod, and a thick layer of loose earth was strewn around the bottom. Often"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l26" HPOS="422" VPOS="2091" WIDTH="1772" HEIGHT="56" BASELINE="425 2132 2194 2126" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2132 425 2147 2192 2141 2194 2126 2187 2091 422 2100 425 2132"/>
                        </Shape>
                        <String CONTENT="the waˊlkar was started with a circular excavation, and, after being well covered"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l27" HPOS="422" VPOS="2150" WIDTH="1772" HEIGHT="58" BASELINE="425 2193 2194 2184" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2193 425 2208 2192 2199 2194 2184 2190 2156 879 2150 877 2150 780 2160 464 2152 461 2152 459 2152 422 2162 425 2193"/>
                        </Shape>
                        <String CONTENT="with earth, appeared to be a half-underground house, with only the roof pro-"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l28" HPOS="422" VPOS="2206" WIDTH="1772" HEIGHT="63" BASELINE="425 2251 2194 2247" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2251 425 2266 2190 2269 2194 2247 2190 2217 1330 2206 1328 2206 1326 2206 1304 2217 507 2208 505 2208 422 2219 425 2251"/>
                        </Shape>
                        <String CONTENT="truding above the surface. Even the “jaw-bone houses” built above ground,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l29" HPOS="425" VPOS="2277" WIDTH="1769" HEIGHT="52" BASELINE="427 2312 2194 2308" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2312 427 2329 2192 2329 2194 2308 2190 2277 425 2277 427 2312"/>
                        </Shape>
                        <String CONTENT="in the course of a long period of time, assumed the shape of small hillocks,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l30" HPOS="425" VPOS="2323" WIDTH="1771" HEIGHT="65" BASELINE="427 2372 2196 2364" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2372 427 2388 2194 2381 2196 2364 2192 2336 1919 2323 1917 2323 1852 2334 1824 2323 1821 2323 1819 2323 1817 2323 1815 2323 1798 2334 1648 2325 1646 2325 1527 2336 1499 2325 1497 2325 1494 2325 1492 2325 1460 2336 1419 2325 1416 2325 1414 2325 1412 2325 1380 2336 1315 2325 1313 2325 1310 2325 1308 2325 1293 2338 1120 2327 1118 2327 1033 2338 1001 2327 999 2327 996 2327 931 2338 895 2327 892 2327 890 2327 778 2340 466 2329 464 2329 461 2329 425 2342 427 2372"/>
                        </Shape>
                        <String CONTENT="with a human lodging-place inside. Of all the waˊlkarat that I have seen,"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l31" HPOS="425" VPOS="2388" WIDTH="1771" HEIGHT="58" BASELINE="427 2429 2196 2424" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2429 427 2446 2194 2442 2196 2424 2192 2392 524 2388 522 2388 425 2398 427 2429"/>
                        </Shape>
                        <String CONTENT="on the Pacific coast, only one, in the village of Nuˊnlig̣ren, retains its original"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l32" HPOS="425" VPOS="2450" WIDTH="1771" HEIGHT="57" BASELINE="427 2492 2196 2485" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2492 427 2507 2194 2500 2196 2485 2192 2453 446 2450 444 2450 442 2450 440 2450 425 2457 427 2492"/>
                        </Shape>
                        <String CONTENT="shape. A comparison with other ruins shows that it is a typical underground"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l33" HPOS="431" VPOS="2515" WIDTH="1765" HEIGHT="50" BASELINE="433 2548 2196 2544" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="433 2548 433 2565 2194 2561 2196 2544 2190 2515 431 2518 433 2548"/>
                        </Shape>
                        <String CONTENT="“jaw-bone house.” It is a large rectangular apartment, 20 feet long, 14 feet"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l34" HPOS="427" VPOS="2567" WIDTH="1769" HEIGHT="59" BASELINE="429 2608 2196 2602" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="429 2608 429 2626 2194 2619 2196 2602 2192 2572 470 2567 468 2567 466 2567 427 2578 429 2608"/>
                        </Shape>
                        <String CONTENT="wide, and 7½ feet high in the middle. A strong “jaw-bone” frame incrusted"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l35" HPOS="425" VPOS="2624" WIDTH="1769" HEIGHT="71" BASELINE="427 2671 2194 2665" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="427 2671 427 2684 836 2684 895 2695 897 2695 1172 2682 1362 2693 1365 2693 1367 2693 1401 2682 1414 2693 1416 2693 1419 2693 1421 2695 1516 2695 1516 2693 1518 2693 1520 2693 1536 2682 1648 2691 1650 2691 1653 2691 1655 2691 1674 2680 1904 2680 1973 2691 1975 2691 1977 2691 2001 2680 2122 2691 2125 2691 2192 2678 2194 2665 2190 2637 2135 2624 2133 2624 1960 2634 1878 2624 1876 2624 1873 2624 1826 2634 1713 2624 1711 2624 1657 2634 1631 2624 1629 2624 1627 2624 1624 2624 1577 2637 1484 2626 1481 2626 1410 2637 1371 2626 1369 2626 1367 2626 1284 2637 1215 2626 1213 2626 1211 2626 1180 2637 425 2637 427 2671"/>
                        </Shape>
                        <String CONTENT="in the hardened earth supports its walls (Fig. 100). Most of the uprights"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l36" HPOS="427" VPOS="2684" WIDTH="1769" HEIGHT="63" BASELINE="429 2730 2196 2721" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="429 2730 429 2747 2194 2738 2196 2721 2192 2693 1313 2684 1310 2684 1308 2684 1306 2684 1293 2695 879 2686 877 2686 875 2686 873 2686 858 2697 464 2689 461 2689 459 2689 427 2699 429 2730"/>
                        </Shape>
                        <String CONTENT="which support the side-walls are formed of two parts, the upper being thinner"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l37" HPOS="422" VPOS="2745" WIDTH="1774" HEIGHT="60" BASELINE="425 2790 2196 2784" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2790 425 2805 2194 2799 2196 2784 2192 2756 1605 2745 1603 2745 1601 2745 1575 2756 1455 2747 1453 2747 1007 2758 442 2749 440 2749 438 2749 435 2749 422 2756 425 2790"/>
                        </Shape>
                        <String CONTENT="than that below. The upper parts are not fastened to those below, but are"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l38" HPOS="422" VPOS="2808" WIDTH="1776" HEIGHT="58" BASELINE="425 2849 2198 2842" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2849 425 2866 2196 2860 2198 2842 2194 2814 440 2808 438 2808 435 2808 433 2808 422 2814 425 2849"/>
                        </Shape>
                        <String CONTENT="firmly implanted on their top. The pressure of the rafters, and the weight"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l39" HPOS="422" VPOS="2868" WIDTH="1772" HEIGHT="57" BASELINE="425 2912 2194 2901" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2912 425 2925 2192 2918 2194 2901 2190 2873 778 2868 775 2868 715 2879 459 2870 457 2870 455 2870 422 2881 425 2912"/>
                        </Shape>
                        <String CONTENT="of the soil which covers the structure, help to hold them in place. The"/>
                    </TextLine>

                    <TextLine ID="mz_1-233_l40" HPOS="422" VPOS="2927" WIDTH="1772" HEIGHT="58" BASELINE="425 2970 2194 2964" TAGREFS="TYPE_3">
                        <Shape>
                            <Polygon POINTS="425 2970 425 2983 2190 2985 2194 2964 2190 2935 1050 2927 1048 2927 988 2938 507 2929 505 2929 422 2940 425 2970"/>
