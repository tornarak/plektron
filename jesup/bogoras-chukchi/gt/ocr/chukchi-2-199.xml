                        </Shape>
                        <String CONTENT="XVI. — PROTECTIVE AND AGGRESSIVE MAGIC."/>
                    </TextLine>
<TextLine ID="mz_2-199_l2" HPOS="530" VPOS="875" WIDTH="1663" HEIGHT="57" BASELINE="532 914 2193 918" TAGREFS="TYPE_5">
                        <Shape>
