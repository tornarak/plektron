                        </Shape>
                        <String CONTENT="no snow-storms. The late autumn is therefore considered as the season of"/>
                    </TextLine>

                    <TextLine ID="mz_3-020_l8" HPOS="368" VPOS="866" WIDTH="1686" HEIGHT="62" BASELINE="370 905 2054 909" TAGREFS="TYPE_4">
