                        </Shape>
                        <String CONTENT="happiness and rest, especially as about that time the reindeer are fattest."/>
                    </TextLine>
<TextLine ID="mz_3-020_l9" HPOS="475" VPOS="930" WIDTH="1672" HEIGHT="51" BASELINE="477 965 2147 969" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="477 965 475 977 2143 981 2147 969 2145 930 477 930 477 965"/>
                        </Shape>
                        <String CONTENT="Even in the summer, young boys remain alone with the herd for several"/>
                    </TextLine>

