                        <Shape>
                            <Polygon POINTS="370 1024 368 1038 2141 1043 2145 1030 2143 999 370 993 370 1024"/>
                        </Shape>
                        <String CONTENT="days, using their utmost efforts, notwithstanding their insufficient strength, to"/>
                    </TextLine>

