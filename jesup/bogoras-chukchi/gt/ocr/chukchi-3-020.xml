                        </Shape>
                        <String CONTENT="before their father is very respectful. When the young herdsmen come home,"/>
                    </TextLine>

                    <TextLine ID="mz_3-020_l23" HPOS="372" VPOS="1764" WIDTH="1775" HEIGHT="65" BASELINE="374 1805 2147 1811" TAGREFS="TYPE_4">
