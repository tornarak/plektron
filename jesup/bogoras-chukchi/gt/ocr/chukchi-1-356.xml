                        </Shape>
                        <String CONTENT="men.” The participants stand in a circle, with partners facing each other."/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l5" HPOS="604" VPOS="838" WIDTH="1768" HEIGHT="67" BASELINE="607 881 2372 885" TAGREFS="TYPE_4">
