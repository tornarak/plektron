                        </Shape>
                        <String CONTENT="The rod is spun in the middle by somebody. When the top stops spinning,"/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l6" HPOS="602" VPOS="900" WIDTH="1774" HEIGHT="57" BASELINE="604 944 2376 939" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 944 604 957 2374 954 2376 939 2372 907 622 900 620 900 617 900 615 900 602 907 604 944"/>
                        </Shape>
                        <String CONTENT="the party that is faced by the spirits has lost. The stakes are small, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l7" HPOS="602" VPOS="967" WIDTH="1371" HEIGHT="59" BASELINE="604 998 1973 1002" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 998 602 1015 615 1024 617 1024 620 1024 622 1024 1235 1015 1289 1026 1291 1026 1971 1015 1973 1002 1971 972 604 967 604 998"/>
                        </Shape>
