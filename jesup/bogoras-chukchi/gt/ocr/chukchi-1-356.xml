                    </TextLine>

                    <TextLine ID="mz_1-356_l20" HPOS="600" VPOS="1749" WIDTH="1774" HEIGHT="48" BASELINE="600 1779 2374 1779" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="600 1779 600 1797 2374 1797 2374 1779 2374 1749 600 1749 600 1779"/>
                        </Shape>
