                        <Shape>
                            <Polygon POINTS="2365 1565 1488 1556 1486 1556 1484 1556 1453 1567 622 1558 620 1558 617 1558 615 1558 600 1565 602 1602 602 1617 2372 1613 2374 1597 2369 1578 2365 1565"/>
