                    </TextLine>
<TextLine ID="mz_1-356_l8" HPOS="713" VPOS="1017" WIDTH="1665" HEIGHT="61" BASELINE="713 1061 2378 1061" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="713 1061 713 1078 2378 1078 2378 1061 2378 1030 2302 1017 2300 1017 2244 1028 2122 1017 2120 1017 2064 1028 2010 1017 2008 1017 2006 1017 1982 1028 1938 1017 1936 1017 1934 1017 1865 1030 1707 1030 1694 1017 1692 1017 1689 1017 1687 1017 1635 1028 1594 1017 1592 1017 1590 1017 1588 1017 1551 1028 1458 1017 1455 1017 1453 1017 1427 1028 1317 1017 1315 1017 1313 1017 1289 1030 1183 1030 1165 1017 1163 1017 1161 1017 1159 1017 1109 1028 1092 1017 1089 1017 1087 1017 1085 1017 1083 1017 1057 1028 1014 1017 1012 1017 1009 1017 1007 1017 977 1028 947 1017 944 1017 942 1017 940 1017 910 1028 713 1026 713 1061"/>
                        </Shape>
                        <String CONTENT="Nelson obtained his specimen from St. Lawrence Island. He considers"/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l9" HPOS="600" VPOS="1089" WIDTH="1778" HEIGHT="49" BASELINE="602 1121 2378 1117" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="602 1121 602 1138 2378 1132 2378 1117 2374 1089 600 1089 602 1121"/>
                        </Shape>
                        <String CONTENT="it a cord-spinner, or, rather, a cord-twister, and suggests that the idea of it was"/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l10" HPOS="604" VPOS="1145" WIDTH="1770" HEIGHT="54" BASELINE="607 1182 2374 1175" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="607 1182 607 1199 2372 1193 2374 1175 2369 1147 604 1145 607 1182"/>
                        </Shape>
