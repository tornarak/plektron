                    <TextLine ID="mz_1-356_l14" HPOS="604" VPOS="1385" WIDTH="1772" HEIGHT="52" BASELINE="604 1420 2376 1420" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="604 1420 604 1437 2376 1437 2376 1420 2376 1390 604 1385 604 1420"/>
                        </Shape>
