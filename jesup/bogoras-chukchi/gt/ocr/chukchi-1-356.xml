                        </Shape>
                        <String CONTENT="are called “faces of the spirits.” Two other faces are called “the faces of"/>
                    </TextLine>

                    <TextLine ID="mz_1-356_l4" HPOS="602" VPOS="779" WIDTH="1774" HEIGHT="59" BASELINE="604 825 2376 820" TAGREFS="TYPE_4">
                        <Shape>
