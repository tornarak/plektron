<TextLine ID="mz_1-293_l3" HPOS="412" VPOS="734" WIDTH="1769" HEIGHT="60" BASELINE="412 777 2181 777" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="412 777 412 792 2179 794 2181 777 2181 747 1908 734 1906 734 1854 744 1687 734 1685 734 1683 734 1653 744 1624 734 1622 734 1620 734 1618 734 1581 744 1395 734 1393 734 1391 734 1352 744 1280 734 1278 734 1213 744 1139 734 1137 734 1027 744 895 734 892 734 890 734 853 744 817 734 814 734 812 734 717 744 412 740 412 777"/>
                        </Shape>
                        <String CONTENT="The poorest of the larger reindeer-skins, those not fit for any other purpose,"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l4" HPOS="409" VPOS="805" WIDTH="1772" HEIGHT="48" BASELINE="409 835 2181 835" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 835 409 853 2181 853 2181 835 2181 805 409 805 409 835"/>
                        </Shape>
                        <String CONTENT="are clipped of hair with a sharp knife, and then cut into a narrow strip less"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l5" HPOS="409" VPOS="853" WIDTH="1772" HEIGHT="60" BASELINE="409 896 2181 896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 896 409 913 2181 913 2181 896 2181 866 1834 853 1832 853 1830 853 1828 853 1813 866 1715 866 1689 853 1687 853 1685 853 1683 853 1681 853 1668 863 1618 853 1616 853 1540 863 1512 853 1510 853 1507 853 1505 853 1473 866 1248 866 1183 853 1180 853 1118 863 1053 853 1050 853 999 863 973 853 970 853 968 853 910 863 864 853 862 853 860 853 858 853 836 863 812 853 810 853 808 853 806 853 782 863 710 853 708 853 643 863 542 853 539 853 485 863 438 853 435 853 433 853 431 853 409 863 409 896"/>
                        </Shape>
                        <String CONTENT="than half and inch broad. The skins are cut when fresh, or, if dry, they are"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l6" HPOS="405" VPOS="913" WIDTH="1774" HEIGHT="59" BASELINE="407 954 2179 950" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 954 407 972 2177 970 2179 950 2174 922 431 913 429 913 427 913 405 922 407 954"/>
                        </Shape>
                        <String CONTENT="dipped in water to make them softer and more pliable. The line is stretched"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l7" HPOS="407" VPOS="972" WIDTH="1774" HEIGHT="60" BASELINE="409 1015 2181 1011" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1015 409 1032 2179 1028 2181 1011 2177 983 1360 972 1358 972 1289 983 481 974 479 974 407 985 409 1015"/>
                        </Shape>
                        <String CONTENT="out of doors, made as taut as possible, and allowed to dry. This kind of line is"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l8" HPOS="407" VPOS="1043" WIDTH="1774" HEIGHT="48" BASELINE="407 1076 2181 1076" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1076 407 1091 2181 1091 2181 1076 2181 1043 407 1043 407 1076"/>
                        </Shape>
                        <String CONTENT="called a “leather line” (ñilhɪˊlhɪn). Among the Reindeer Chukchee it is used"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l9" HPOS="405" VPOS="1089" WIDTH="1774" HEIGHT="60" BASELINE="407 1136 2179 1132" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1136 407 1149 2177 1147 2179 1132 2174 1102 1581 1089 1579 1089 1494 1099 1449 1089 1447 1089 1445 1089 1360 1099 1339 1089 1336 1089 1334 1089 1332 1089 1287 1102 1274 1091 1271 1091 1269 1091 1267 1091 1202 1102 817 1091 814 1091 812 1091 810 1091 795 1104 587 1104 533 1091 531 1091 529 1091 481 1102 425 1091 422 1091 420 1091 418 1091 405 1099 407 1136"/>
                        </Shape>
                        <String CONTENT="for almost every kind of lashing. The best line of this kind is made of the"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l10" HPOS="405" VPOS="1149" WIDTH="1774" HEIGHT="61" BASELINE="407 1197 2179 1193" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1197 407 1210 2177 1208 2179 1193 2174 1162 2122 1149 2120 1149 2118 1149 2116 1149 2103 1160 2058 1149 2055 1149 2053 1149 2051 1149 2049 1149 2034 1160 2021 1149 2019 1149 2016 1149 2014 1149 2012 1149 2010 1149 1993 1160 1917 1149 1915 1149 1841 1160 1824 1149 1821 1149 1819 1149 1817 1149 1815 1149 1769 1160 1689 1149 1687 1149 1570 1160 1542 1149 1540 1149 1538 1149 1536 1149 1533 1149 1518 1162 1401 1162 1375 1149 1373 1149 1371 1149 1289 1162 1241 1151 1239 1151 1237 1151 947 1162 862 1151 860 1151 858 1151 810 1162 719 1151 717 1151 715 1151 713 1151 697 1162 637 1151 635 1151 633 1151 602 1162 572 1151 570 1151 568 1151 503 1162 435 1151 433 1151 431 1151 405 1162 407 1197"/>
                        </Shape>
                        <String CONTENT="skin of old wild reindeer-bucks. The neck part is so thick that it might be"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l11" HPOS="407" VPOS="1212" WIDTH="1772" HEIGHT="59" BASELINE="409 1255 2179 1251" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1255 409 1271 2177 1268 2179 1251 2174 1223 1341 1212 1339 1212 1336 1212 1289 1223 494 1214 492 1214 407 1225 409 1255"/>
                        </Shape>
                        <String CONTENT="used for boot-soles, and the line made of it is quite strong. When plaited, it"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l12" HPOS="407" VPOS="1271" WIDTH="1772" HEIGHT="60" BASELINE="409 1316 2179 1312" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1316 409 1331 2177 1327 2179 1312 2174 1281 1293 1271 1291 1271 1232 1284 407 1284 409 1316"/>
                        </Shape>
                        <String CONTENT="is used for lassos (see Fig. 162, a). The Maritime Chukchee prepare a similar"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l13" HPOS="405" VPOS="1335" WIDTH="1769" HEIGHT="55" BASELINE="407 1377 2174 1372" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1377 407 1390 2172 1385 2174 1372 2168 1335 405 1340 407 1377"/>
                        </Shape>
                        <String CONTENT="kind of thin line of the skins of smaller seals. It is called “seal-skin leather”"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l14" HPOS="405" VPOS="1390" WIDTH="1553" HEIGHT="62" BASELINE="407 1437 1958 1433" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1437 407 1452 1956 1448 1958 1433 1954 1403 1884 1390 1882 1390 1880 1390 1847 1400 1815 1390 1813 1390 1811 1390 1759 1400 1616 1390 1614 1390 1523 1400 1497 1390 1494 1390 1492 1390 1425 1400 1373 1390 1371 1390 1369 1390 1334 1400 1265 1390 1263 1390 1178 1403 1139 1392 1137 1392 1135 1392 1133 1392 1107 1403 817 1392 814 1392 723 1403 710 1392 708 1392 706 1392 422 1392 420 1392 418 1392 416 1392 405 1400 407 1437"/>
                        </Shape>
                        <String CONTENT="(mêmɪčêˊčhɪn), and it is better in quality than the reindeer-skin line."/>
                    </TextLine>
<TextLine ID="mz_1-293_l15" HPOS="516" VPOS="1461" WIDTH="1661" HEIGHT="50" BASELINE="518 1494 2177 1489" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="518 1494 518 1511 2174 1511 2177 1489 2172 1461 516 1461 518 1494"/>
                        </Shape>
                        <String CONTENT="The skill of the natives in cutting the skin into narrow lines is very"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l16" HPOS="403" VPOS="1509" WIDTH="1774" HEIGHT="62" BASELINE="405 1556 2177 1552" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 1556 405 1571 2174 1567 2177 1552 2170 1517 1938 1519 1921 1509 1919 1509 1917 1509 1915 1509 1912 1509 1910 1509 1891 1522 1724 1522 1676 1509 1674 1509 1672 1509 1670 1509 1627 1519 1598 1509 1596 1509 1594 1509 1592 1509 1568 1519 1542 1509 1540 1509 1538 1509 1449 1519 1362 1509 1360 1509 1358 1509 1332 1519 1289 1509 1287 1509 1284 1509 1282 1509 1280 1509 1261 1522 1131 1511 1128 1511 1126 1511 1124 1511 1107 1524 888 1524 721 1511 719 1511 659 1522 542 1511 539 1511 403 1522 405 1556"/>
                        </Shape>
                        <String CONTENT="remarkable. Usually one man holds the hide and the line near the cut, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l17" HPOS="405" VPOS="1569" WIDTH="1769" HEIGHT="70" BASELINE="407 1615 2174 1610" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1615 407 1639 2172 1639 2174 1610 2170 1582 2109 1569 2107 1569 2105 1569 2084 1580 2019 1569 2016 1569 2014 1569 1993 1580 1908 1569 1906 1569 1904 1569 1902 1569 1886 1582 1772 1582 1731 1569 1728 1569 1726 1569 1724 1569 1722 1569 1707 1582 1614 1582 1562 1569 1559 1569 1557 1569 1520 1580 1453 1569 1451 1569 1365 1580 1291 1569 1289 1569 1287 1569 1250 1582 819 1571 817 1571 656 1582 561 1571 559 1571 557 1571 518 1582 466 1571 464 1571 405 1584 407 1615"/>
                        </Shape>
                        <String CONTENT="pulls them toward himself, while another makes the cut by steadily drawing"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l18" HPOS="407" VPOS="1628" WIDTH="1772" HEIGHT="60" BASELINE="409 1675 2179 1669" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1675 409 1688 2177 1686 2179 1669 2172 1632 1852 1639 1826 1628 1824 1628 1821 1628 1722 1639 1668 1628 1666 1628 1568 1641 1505 1630 1503 1630 1408 1641 1326 1630 1323 1630 1321 1630 1319 1630 1302 1643 1152 1643 1128 1630 1126 1630 999 1630 996 1630 994 1630 992 1630 970 1643 864 1632 862 1632 795 1643 780 1632 778 1632 775 1632 615 1632 613 1632 611 1632 585 1643 546 1632 544 1632 542 1632 422 1634 420 1634 418 1634 407 1641 409 1675"/>
                        </Shape>
                        <String CONTENT="towards himself a knife held in an upright position. For a hundred feet of"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l19" HPOS="407" VPOS="1699" WIDTH="1770" HEIGHT="52" BASELINE="407 1732 2177 1732" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1732 407 1751 2177 1751 2177 1732 2177 1704 407 1699 407 1732"/>
                        </Shape>
                        <String CONTENT="line the hand of the cutter will not change its regular motion or swerve from"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l20" HPOS="407" VPOS="1764" WIDTH="1644" HEIGHT="46" BASELINE="407 1794 2051 1794" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1794 407 1810 2051 1810 2051 1794 2051 1764 407 1764 407 1794"/>
                        </Shape>
                        <String CONTENT="the proper direction. The entire line seems of exactly the same width."/>
                    </TextLine>
<TextLine ID="mz_1-293_l21" HPOS="511" VPOS="1812" WIDTH="1663" HEIGHT="58" BASELINE="511 1855 2174 1855" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="511 1855 511 1870 2174 1870 2174 1855 2174 1823 2131 1812 2129 1812 2127 1812 2032 1823 1990 1812 1988 1812 1986 1812 1427 1823 1347 1812 1345 1812 1284 1823 1222 1812 1219 1812 1217 1812 1176 1823 1072 1812 1070 1812 1009 1823 973 1812 970 1812 968 1812 860 1823 827 1812 825 1812 823 1812 769 1823 713 1812 710 1812 708 1812 706 1812 691 1825 594 1825 526 1812 524 1812 522 1812 520 1812 511 1818 511 1855"/>
                        </Shape>
                        <String CONTENT="Stouter line is made of the skin of the ground-seal and of walrus-hide."/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l22" HPOS="407" VPOS="1879" WIDTH="1770" HEIGHT="52" BASELINE="409 1916 2177 1911" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 1916 409 1931 2174 1929 2177 1911 2172 1881 407 1879 409 1916"/>
                        </Shape>
                        <String CONTENT="These are cut in the manner described, either fresh or dry. The line is usually"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l23" HPOS="405" VPOS="1929" WIDTH="1772" HEIGHT="60" BASELINE="407 1974 2177 1970" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 1974 407 1989 2177 1989 2177 1970 2170 1935 1917 1939 1895 1929 1893 1929 1891 1929 1821 1939 1798 1929 1795 1929 1793 1929 1791 1929 1789 1929 1774 1942 1663 1942 1616 1929 1614 1929 1611 1929 1609 1929 1581 1939 1501 1929 1499 1929 1449 1939 1421 1929 1419 1929 1416 1929 1358 1939 1291 1929 1289 1929 1018 1942 983 1931 981 1931 979 1931 977 1931 975 1931 962 1942 927 1931 925 1931 923 1931 921 1931 918 1931 903 1944 732 1944 635 1931 633 1931 630 1931 628 1931 613 1944 516 1944 418 1931 416 1931 414 1931 412 1931 412 1933 405 1937 407 1974"/>
                        </Shape>
                        <String CONTENT="from an inch to an inch and a half broad. The line made of ground-seal"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l24" HPOS="407" VPOS="1989" WIDTH="1475" HEIGHT="61" BASELINE="407 2035 1882 2035" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2035 407 2050 1882 2050 1882 2035 1882 2002 1813 1989 1811 1989 1754 2000 1635 1989 1633 1989 1523 2000 1497 1989 1494 1989 1492 1989 1403 2000 1386 1989 1384 1989 1382 1989 1380 1989 1378 1989 1349 2000 1328 1989 1326 1989 1323 1989 1321 1989 1297 2000 1267 1989 1265 1989 1263 1989 1261 1989 1217 2000 1196 1989 1193 1989 1191 1989 1189 1989 1148 2000 1074 1989 1072 1989 1005 2000 983 1989 981 1989 979 1989 977 1989 975 1989 962 2002 851 2002 832 1989 830 1989 827 1989 825 1989 773 2000 648 1989 646 1989 568 2000 552 1989 550 1989 548 1989 546 1989 494 2000 438 1989 435 1989 433 1989 407 2000 407 2035"/>
                        </Shape>
                        <String CONTENT="skin (uᵋnečiˊčhɪn, “ground-seal leather”) is best in quality. That"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l25" HPOS="405" VPOS="2046" WIDTH="1473" HEIGHT="65" BASELINE="407 2095 1878 2089" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2095 407 2111 1876 2106 1878 2089 1873 2059 1754 2046 1752 2046 1750 2046 1748 2046 1735 2059 1551 2059 1533 2046 1531 2046 1529 2046 1527 2046 1525 2046 1492 2056 1462 2046 1460 2046 1458 2046 1455 2046 1419 2056 1388 2046 1386 2046 1384 2046 1382 2046 1380 2046 1365 2059 992 2048 990 2048 988 2048 964 2059 938 2048 936 2048 934 2048 860 2061 654 2050 652 2050 559 2061 507 2050 505 2050 503 2050 479 2061 451 2050 448 2050 446 2050 444 2050 405 2063 407 2095"/>
                        </Shape>
                        <String CONTENT="of the walrus-hide (rɪrkaˊ-ñêˊlhɪn, “walrus-line”) becomes flabby"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l26" HPOS="407" VPOS="2119" WIDTH="1471" HEIGHT="56" BASELINE="409 2152 1878 2156" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 2152 407 2167 420 2175 422 2175 425 2175 427 2175 1876 2171 1878 2156 1876 2124 409 2119 409 2152"/>
                        </Shape>
                        <String CONTENT="with moisture, and wears out more rapidly. The hide of young"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l27" HPOS="409" VPOS="2184" WIDTH="1469" HEIGHT="46" BASELINE="409 2214 1878 2214" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="409 2214 409 2230 1876 2230 1878 2214 1876 2184 409 2184 409 2214"/>
                        </Shape>
                        <String CONTENT="walrus gives a line of much better quality. The ground-seal skin"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l28" HPOS="407" VPOS="2230" WIDTH="1473" HEIGHT="67" BASELINE="407 2271 1880 2275" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2271 407 2286 1135 2286 1148 2297 1150 2297 1152 2297 1154 2297 1878 2286 1880 2275 1880 2245 1856 2232 1854 2232 1852 2232 1850 2232 1821 2243 1780 2232 1778 2232 1776 2232 1694 2245 1607 2245 1596 2234 1596 2232 1594 2232 1592 2232 1590 2232 1538 2243 1501 2232 1499 2232 1497 2232 1416 2243 1399 2232 1397 2232 1395 2232 1393 2232 1391 2232 1345 2243 1321 2232 1319 2232 1317 2232 1111 2240 1100 2232 1100 2230 1098 2230 1096 2230 1094 2230 1020 2240 975 2230 973 2230 970 2230 968 2230 936 2240 918 2230 916 2230 914 2230 912 2230 856 2240 840 2230 838 2230 836 2230 747 2230 745 2230 743 2230 741 2230 728 2240 639 2230 637 2230 635 2230 596 2240 537 2230 535 2230 533 2230 511 2240 407 2236 407 2271"/>
                        </Shape>
                        <String CONTENT="line is often dyed black with soot mixed with oil, to make it"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l29" HPOS="407" VPOS="2290" WIDTH="1473" HEIGHT="61" BASELINE="407 2331 1880 2331" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2331 407 2351 1880 2351 1880 2331 1880 2303 1817 2290 1815 2290 1813 2290 1776 2301 1735 2290 1733 2290 1731 2290 1728 2290 1700 2301 1575 2290 1572 2290 1570 2290 1568 2290 1551 2301 1527 2290 1525 2290 1523 2290 1520 2290 1518 2290 1518 2292 1507 2303 1356 2303 1291 2290 1289 2290 1287 2290 1265 2301 1224 2290 1222 2290 1219 2290 1141 2301 1061 2290 1059 2290 1057 2290 1055 2290 1042 2303 897 2303 873 2290 871 2290 869 2290 866 2290 864 2290 851 2303 691 2303 656 2290 654 2290 652 2290 598 2301 570 2290 568 2290 565 2290 563 2290 539 2301 516 2290 513 2290 511 2290 509 2290 507 2290 507 2292 496 2303 407 2303 407 2331"/>
                        </Shape>
                        <String CONTENT="stand the dampness better. When freshly cut and dried, the line"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l30" HPOS="405" VPOS="2362" WIDTH="1475" HEIGHT="45" BASELINE="407 2394 1880 2390" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2394 407 2407 1878 2403 1880 2390 1876 2362 405 2362 407 2394"/>
                        </Shape>
                        <String CONTENT="is almost as hard as wood. To make it more pliable it has to"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l31" HPOS="407" VPOS="2418" WIDTH="1471" HEIGHT="54" BASELINE="407 2453 1878 2453" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2453 407 2472 1878 2472 1878 2453 1878 2422 407 2418 407 2453"/>
                        </Shape>
                        <String CONTENT="be chewed all over, in which process it usually increases in breadth."/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l32" HPOS="407" VPOS="2483" WIDTH="1473" HEIGHT="45" BASELINE="407 2513 1880 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="407 2513 407 2528 1880 2528 1880 2513 1880 2483 407 2483 407 2513"/>
                        </Shape>
                        <String CONTENT="After that, it is drawn with considerable force across the edge"/>
                    </TextLine>

                    <TextLine ID="mz_1-293_l33" HPOS="405" VPOS="2531" WIDTH="1475" HEIGHT="58" BASELINE="405 2574 1880 2574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="405 2574 405 2589 1880 2589 1880 2574 1880 2541 1653 2531 1650 2531 1577 2541 1551 2531 1549 2531 1546 2531 1494 2541 1466 2531 1464 2531 1462 2531 1460 2531 1425 2544 1217 2544 1191 2531 1189 2531 1187 2531 1124 2541 1070 2531 1068 2531 994 2541 927 2531 925 2531 864 2541 801 2531 799 2531 721 2541 635 2531 633 2531 630 2531 628 2531 615 2544 479 2544 451 2531 448 2531 446 2531 444 2531 405 2541 405 2574"/>
                        </Shape>
                        <String CONTENT="of some immovable object, like the runner of a heavily loaded"/>
                    </TextLine>

