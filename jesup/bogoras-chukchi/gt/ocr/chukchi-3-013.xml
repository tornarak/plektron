                        </Shape>
                        <String CONTENT="as quickly as possible. Go to him and serve him.’”¹"/>
                    </TextLine>
<TextLine ID="mz_3-013_l10" HPOS="506" VPOS="987" WIDTH="1666" HEIGHT="62" BASELINE="508 1032 2172 1028" TAGREFS="TYPE_5">
                        <Shape>
