                        </Shape>
                        <String CONTENT="making garments, and much more, not to speak of the duties of the mother."/>
                    </TextLine>

                    <TextLine ID="mz_3-013_l21" HPOS="401" VPOS="1655" WIDTH="1775" HEIGHT="49" BASELINE="403 1688 2176 1683" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1688 403 1704 2174 1700 2176 1683 2172 1657 401 1655 403 1688"/>
                        </Shape>
                        <String CONTENT="Moreover, man almost never shares in the woman’s part of the work; he"/>
                    </TextLine>

                    <TextLine ID="mz_3-013_l22" HPOS="401" VPOS="1710" WIDTH="1775" HEIGHT="54" BASELINE="403 1749 2176 1743" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="403 1749 403 1764 2174 1764 2176 1743 2172 1716 418 1710 416 1710 415 1710 413 1710 401 1716 403 1749"/>
                        </Shape>
                        <String CONTENT="does not even know how it is performed. Often, when wandering with a"/>
                    </TextLine>

                    <TextLine ID="mz_3-013_l23" HPOS="399" VPOS="1764" WIDTH="1777" HEIGHT="59" BASELINE="401 1807 2176 1801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="401 1807 401 1823 2174 1819 2176 1801 2174 1776 2134 1764 2132 1764 2130 1764 2128 1764 2098 1774 2063 1764 2061 1764 2059 1764 1771 1774 1718 1764 1716 1764 1714 1764 1674 1774 1629 1764 1627 1764 1625 1764 1576 1776 1461 1766 1459 1766 1457 1766 1455 1766 1438 1778 1138 1778 1101 1766 1099 1766 1097 1766 989 1778 956 1768 954 1768 952 1768 623 1778 416 1768 415 1768 413 1768 411 1768 399 1774 401 1807"/>
                        </Shape>
                        <String CONTENT="Chukchee camp, I had occasion to go to the newly chosen spot with the"/>
