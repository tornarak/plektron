                <TextBlock ID="text_1-067" HPOS="351" VPOS="599" WIDTH="1780" HEIGHT="2629"><TextLine ID="mz_1-067_l1" HPOS="929" VPOS="599" WIDTH="622" HEIGHT="54" BASELINE="931 632 1551 636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="1235 599 1213 599 1191 599 1170 599 1148 599 1126 599 1105 599 1083 599 1061 599 1040 599 1018 599 996 599 975 599 953 599 931 599 931 632 929 649 1546 653 1551 636 1549 602 1239 599 1235 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l2" HPOS="2060" VPOS="606" WIDTH="56" HEIGHT="58" BASELINE="2060 649 2116 649" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2060 649 2060 662 2114 664 2116 649 2114 606 2060 610 2060 649"/>
                        </Shape>
                        <String CONTENT="45"/>
                    </TextLine>
<TextLine ID="mz_1-067_l3" HPOS="353" VPOS="697" WIDTH="1776" HEIGHT="65" BASELINE="355 747 2129 740" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="548 705 526 705 505 705 483 708 461 708 440 708 418 708 396 710 375 710 366 710 353 714 355 747 355 762 2127 755 2129 740 2125 710 2073 697 2071 697 2068 697 2045 708 1934 697 1932 697 1930 697 1886 708 1869 697 1867 697 1865 697 1863 697 1733 708 1709 697 1707 697 1705 697 1702 697 1700 697 1685 708 1657 697 1655 697 1653 697 1650 697 1609 708 1538 697 1536 697 1533 697 1499 710 1007 699 1005 699 1003 699 979 710 949 699 947 699 944 699 942 699 940 699 925 710 810 701 808 701 806 701 804 701 788 712 548 703 548 705"/>
                        </Shape>
                        <String CONTENT="tribes and nations intermingle.” Raˊlɵ g̣eneˊʟ̣eet (“blended together”) is the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l4" HPOS="355" VPOS="760" WIDTH="1776" HEIGHT="60" BASELINE="357 805 2131 801" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 805 357 820 2129 816 2131 801 2127 770 1304 760 1302 760 1228 770 420 762 418 762 355 773 357 805"/>
                        </Shape>
                        <String CONTENT="ordinary Chukchee term to describe intertribal relations on all borders. On the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l5" HPOS="357" VPOS="818" WIDTH="1774" HEIGHT="65" BASELINE="360 866 2131 861" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 866 360 883 2129 879 2131 861 2127 831 2051 818 2049 818 2047 818 2027 829 2006 818 2003 818 2001 818 1999 818 1977 829 1817 818 1815 818 1813 818 1789 829 1772 818 1769 818 1767 818 1765 818 1763 818 1761 818 1746 829 1713 818 1711 818 1709 818 1635 829 1546 818 1544 818 1542 818 1514 829 1468 818 1466 818 1464 818 1410 829 1384 818 1382 818 1380 818 1302 829 1274 818 1271 818 1269 818 1267 818 1235 831 1180 820 1178 820 1176 820 1148 831 983 820 981 820 903 831 866 820 864 820 862 820 806 831 771 820 769 820 767 820 765 820 762 820 747 831 672 820 669 820 667 820 622 831 591 820 589 820 587 820 585 820 546 831 407 820 405 820 403 820 357 833 360 866"/>
                        </Shape>
                        <String CONTENT="other hand, when in 1895, during a brawl at the Anui fair, a Reindeer Chukchee"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l6" HPOS="357" VPOS="881" WIDTH="1774" HEIGHT="63" BASELINE="360 926 2131 920" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 926 360 944 2129 937 2131 920 2127 889 996 881 994 881 929 892 459 883 457 883 357 894 360 926"/>
                        </Shape>
                        <String CONTENT="was killed by the Cossacks, the others resented the deed so much that they were"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l7" HPOS="355" VPOS="939" WIDTH="1774" HEIGHT="61" BASELINE="357 985 2129 980" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 985 357 1000 2127 996 2129 980 2125 950 1254 939 1252 939 1250 939 1228 950 386 941 383 941 381 941 355 950 357 985"/>
                        </Shape>
                        <String CONTENT="almost ready to attack the fort. Notwithstanding the “weregild” paid by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l8" HPOS="355" VPOS="998" WIDTH="1776" HEIGHT="63" BASELINE="357 1043 2131 1039" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1043 357 1061 2131 1054 2131 1039 2127 1009 1243 998 1241 998 1239 998 1237 998 1219 1009 399 1000 396 1000 394 1000 355 1011 357 1043"/>
                        </Shape>
                        <String CONTENT="officials to the family of the slain man, the Chukchee harbored a feeling of ill will"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l9" HPOS="355" VPOS="1063" WIDTH="1774" HEIGHT="58" BASELINE="357 1104 2129 1099" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1104 357 1121 2127 1117 2129 1099 2125 1071 368 1063 366 1063 364 1063 362 1063 362 1065 355 1069 357 1104"/>
                        </Shape>
                        <String CONTENT="for a long time afterwards; and the next winter, when travelling among the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l10" HPOS="360" VPOS="1128" WIDTH="1713" HEIGHT="60" BASELINE="362 1158 2073 1162" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="362 1158 360 1173 442 1186 444 1186 1213 1177 1254 1188 1256 1188 1258 1188 2071 1177 2073 1162 2071 1132 362 1128 362 1158"/>
                        </Shape>
                        <String CONTENT="Anui camps, I had one or two rather unpleasant encounters with the people."/>
                    </TextLine>
<TextLine ID="mz_1-067_l11" HPOS="466" VPOS="1182" WIDTH="1663" HEIGHT="58" BASELINE="468 1223 2129 1219" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="468 1223 468 1240 2127 1236 2129 1219 2125 1190 487 1182 485 1182 483 1182 481 1182 466 1188 468 1223"/>
                        </Shape>
                        <String CONTENT="A considerable part of their former intractability remains at the present"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l12" HPOS="353" VPOS="1242" WIDTH="1776" HEIGHT="59" BASELINE="355 1284 2129 1279" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1284 355 1301 2127 1296 2129 1279 2125 1251 379 1242 377 1242 375 1242 353 1251 355 1284"/>
                        </Shape>
                        <String CONTENT="time, especially among the Reindeer people, and shows itself even in the minor"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l13" HPOS="353" VPOS="1301" WIDTH="1774" HEIGHT="58" BASELINE="355 1342 2127 1335" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1342 355 1359 2125 1353 2127 1335 2122 1305 379 1301 377 1301 375 1301 353 1309 355 1342"/>
                        </Shape>
                        <String CONTENT="details of every-day life. The Chukchee is easily angered; often a trifle will"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l14" HPOS="355" VPOS="1359" WIDTH="1770" HEIGHT="63" BASELINE="357 1405 2125 1396" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1405 357 1422 2122 1416 2125 1396 2120 1368 1241 1359 1239 1359 1237 1359 1213 1370 806 1361 804 1361 801 1361 799 1361 786 1372 414 1364 412 1364 355 1374 357 1405"/>
                        </Shape>
                        <String CONTENT="suffice to transform his merry laughter into the most unreasonable rage. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l15" HPOS="353" VPOS="1424" WIDTH="1772" HEIGHT="57" BASELINE="355 1465 2125 1457" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1465 355 1481 2122 1474 2125 1457 2120 1429 373 1424 370 1424 368 1424 366 1424 353 1431 355 1465"/>
                        </Shape>
                        <String CONTENT="themselves are not unconscious of this peculiar feature of their mind. “I am"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l16" HPOS="353" VPOS="1485" WIDTH="1774" HEIGHT="58" BASELINE="355 1526 2127 1515" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1526 355 1543 2125 1532 2127 1515 2122 1485 427 1485 425 1485 353 1496 355 1526"/>
                        </Shape>
                        <String CONTENT="a tundra wanderer,” one of my Chukchee acquaintances, named Ñĭroˊn, would"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l17" HPOS="353" VPOS="1539" WIDTH="1769" HEIGHT="71" BASELINE="355 1584 2122 1576" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1584 355 1600 422 1610 425 1610 427 1610 429 1610 444 1600 669 1600 739 1610 741 1610 743 1610 745 1610 760 1600 847 1608 849 1608 1016 1597 1202 1608 1204 1608 1206 1608 1241 1595 1475 1595 1650 1606 1653 1606 1655 1606 1689 1593 1713 1604 1715 1604 1718 1604 1720 1604 1752 1593 2042 1604 2045 1604 2120 1591 2122 1576 2116 1539 353 1554 355 1584"/>
                        </Shape>
                        <String CONTENT="say to me. “My anger rises suddenly. It comes and goes of its own accord.”"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l18" HPOS="355" VPOS="1597" WIDTH="1772" HEIGHT="63" BASELINE="357 1645 2127 1636" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1645 357 1660 2125 1654 2127 1636 2122 1608 1685 1597 1683 1597 1620 1608 1460 1600 1458 1600 355 1610 357 1645"/>
                        </Shape>
                        <String CONTENT="Some women bear a special name on account of their violent temper. They"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l19" HPOS="353" VPOS="1658" WIDTH="1776" HEIGHT="71" BASELINE="355 1704 2129 1697" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 1704 355 1717 882 1729 884 1729 886 1729 888 1729 903 1719 1512 1727 1514 1727 1516 1727 1518 1727 1540 1714 1834 1714 1852 1725 1854 1725 1856 1725 1858 1725 2127 1712 2129 1697 2125 1669 1588 1658 1585 1658 1531 1669 1063 1660 1061 1660 353 1673 355 1704"/>
                        </Shape>
                        <String CONTENT="are called “quarrelling women” (maraˊ-ñaˊus˙qattê). These are regarded as"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l20" HPOS="355" VPOS="1727" WIDTH="1770" HEIGHT="52" BASELINE="357 1764 2125 1755" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1764 357 1779 2122 1775 2125 1755 2118 1727 355 1734 357 1764"/>
                        </Shape>
                        <String CONTENT="nuisances even by their housemates. Among the men, some have the very"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l21" HPOS="355" VPOS="1777" WIDTH="1763" HEIGHT="63" BASELINE="357 1823 2118 1816" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1823 357 1840 2116 1833 2118 1816 2112 1777 1525 1788 944 1779 942 1779 862 1790 522 1781 520 1781 355 1792 357 1823"/>
                        </Shape>
                        <String CONTENT="suggestive epithet “hasty” (qɪvr) prefixed to their names, as “Hasty Aᵋmuˊlin”"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l22" HPOS="357" VPOS="1840" WIDTH="358" HEIGHT="63" BASELINE="357 1885 715 1885" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="357 1885 357 1903 715 1903 715 1885 715 1851 691 1840 689 1840 687 1840 576 1851 516 1840 513 1840 511 1840 483 1851 377 1840 375 1840 373 1840 370 1840 357 1849 357 1885"/>
                        </Shape>
                        <String CONTENT="(Qɪvr-Aᵋmuˊlin)."/>
                    </TextLine>
<TextLine ID="mz_1-067_l23" HPOS="464" VPOS="1896" WIDTH="1661" HEIGHT="65" BASELINE="466 1942 2125 1937" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="466 1942 466 1961 2122 1959 2125 1937 2120 1907 1388 1896 1386 1896 1254 1909 464 1909 466 1942"/>
                        </Shape>
                        <String CONTENT="The Chukchee, when angry, growls, shows his teeth, and makes a threatening"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l24" HPOS="353" VPOS="1955" WIDTH="1774" HEIGHT="65" BASELINE="355 2002 2127 1996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2002 355 2020 2125 2013 2127 1996 2122 1968 1754 1955 1752 1955 1624 1965 1542 1955 1540 1955 1538 1955 1536 1955 1523 1968 1481 1957 1479 1957 1477 1957 1475 1957 1451 1968 1414 1957 1412 1957 1410 1957 1163 1968 1115 1957 1113 1957 1111 1957 1109 1957 1070 1968 1027 1957 1025 1957 1022 1957 1020 1957 981 1968 953 1957 951 1957 949 1957 947 1957 944 1957 927 1972 691 1972 667 1959 665 1959 663 1959 661 1959 630 1970 591 1959 589 1959 587 1959 353 1968 355 2002"/>
                        </Shape>
                        <String CONTENT="bite on his sleeve or on the handle of his knife, in defiance of his foe. Some"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l25" HPOS="353" VPOS="2015" WIDTH="1772" HEIGHT="65" BASELINE="355 2063 2125 2056" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2063 355 2080 2122 2074 2125 2056 2120 2028 2034 2015 2032 2015 1752 2026 1737 2015 1735 2015 1733 2015 1555 2015 1553 2015 1486 2028 1378 2017 1375 2017 1373 2017 1349 2028 1161 2017 1159 2017 1055 2028 990 2017 988 2017 905 2030 871 2020 869 2020 866 2020 864 2020 821 2030 600 2020 598 2020 531 2030 396 2020 394 2020 392 2020 353 2033 355 2063"/>
                        </Shape>
                        <String CONTENT="of them, when angered, shed tears of rage, and tear their hair like unruly children."/>
                    </TextLine>
<TextLine ID="mz_1-067_l26" HPOS="459" VPOS="2078" WIDTH="1668" HEIGHT="61" BASELINE="461 2124 2127 2117" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="461 2124 461 2139 2125 2132 2127 2117 2122 2089 1787 2078 1785 2078 459 2089 461 2124"/>
                        </Shape>
                        <String CONTENT="Their language is singularly poor in abusive terms, and quarrels are"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l27" HPOS="351" VPOS="2134" WIDTH="1776" HEIGHT="65" BASELINE="353 2184 2127 2175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2184 353 2199 2125 2191 2127 2175 2122 2145 1685 2134 1683 2134 1681 2134 1679 2134 1679 2137 1668 2145 1345 2137 1343 2137 351 2150 353 2184"/>
                        </Shape>
                        <String CONTENT="immediately settled by blows or wrestling. There is no lack of murders, some"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l28" HPOS="351" VPOS="2195" WIDTH="1774" HEIGHT="65" BASELINE="353 2245 2125 2236" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2245 353 2260 2122 2251 2125 2236 2120 2208 1832 2195 1830 2195 1759 2206 1713 2195 1711 2195 1709 2195 1707 2195 1676 2210 1362 2210 1326 2197 1323 2197 1321 2197 1319 2197 1317 2197 1302 2208 934 2199 931 2199 929 2199 927 2199 912 2210 678 2201 676 2201 674 2201 628 2212 594 2201 591 2201 589 2201 537 2212 392 2201 390 2201 388 2201 351 2214 353 2245"/>
                        </Shape>
                        <String CONTENT="of them of a barbarous character. Thus, in a camp near Cape Erri, the son"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l29" HPOS="351" VPOS="2256" WIDTH="1774" HEIGHT="67" BASELINE="353 2305 2125 2295" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2305 353 2321 1767 2323 1769 2323 2122 2310 2125 2295 2120 2264 1416 2256 1414 2256 1412 2256 1410 2256 1397 2266 1085 2258 1083 2258 1081 2258 1044 2269 425 2262 422 2262 351 2273 353 2305"/>
                        </Shape>
                        <String CONTENT="and the nephew of the rich reindeer-breeder Yekuˊtku, being goaded to the"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l30" HPOS="353" VPOS="2325" WIDTH="1772" HEIGHT="56" BASELINE="355 2364 2125 2355" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2364 355 2381 2122 2372 2125 2355 2118 2325 353 2331 355 2364"/>
                        </Shape>
                        <String CONTENT="extreme by constant blows and abuse, cut his throat, and that with the knowl-"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l31" HPOS="353" VPOS="2372" WIDTH="1774" HEIGHT="68" BASELINE="355 2424 2127 2414" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2424 355 2440 2112 2440 2112 2437 2114 2437 2116 2437 2127 2427 2127 2414 2120 2377 1828 2383 1804 2372 1802 2372 1800 2372 1798 2372 1767 2385 1715 2375 1713 2375 1711 2375 1709 2375 1694 2388 1605 2388 1529 2375 1527 2375 1386 2388 1306 2377 1304 2377 1159 2388 1124 2377 1122 2377 1120 2377 1059 2390 814 2379 812 2379 756 2390 710 2379 708 2379 706 2379 704 2379 678 2392 396 2381 394 2381 392 2381 353 2394 355 2424"/>
                        </Shape>
                        <String CONTENT="edge of his wife, the mother of one of the murderers. In the summer of"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l32" HPOS="357" VPOS="2435" WIDTH="1768" HEIGHT="72" BASELINE="360 2485 2125 2474" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="360 2485 360 2498 964 2507 966 2507 2122 2489 2125 2474 2120 2444 1419 2435 1416 2435 1414 2435 1384 2446 392 2442 390 2442 388 2442 357 2453 360 2485"/>
                        </Shape>
                        <String CONTENT="1896 on the Poplar River, an affluent of the Small Anui, a young man killed"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l33" HPOS="353" VPOS="2496" WIDTH="1769" HEIGHT="61" BASELINE="355 2541 2122 2535" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2541 355 2557 2120 2550 2122 2535 2118 2507 1585 2496 1583 2496 1527 2509 353 2509 355 2541"/>
                        </Shape>
                        <String CONTENT="his brother in order to get possession of his flock. The murderer, with his"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l34" HPOS="353" VPOS="2557" WIDTH="1769" HEIGHT="71" BASELINE="355 2602 2122 2593" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2602 355 2617 513 2628 516 2628 834 2615 1003 2626 1005 2626 1007 2626 1029 2615 1191 2626 1193 2626 1196 2626 1245 2613 1568 2624 1570 2624 1759 2621 1761 2621 1763 2621 1778 2611 2118 2615 2122 2593 2118 2565 1239 2557 1237 2557 1235 2557 1189 2567 804 2559 801 2559 353 2572 355 2602"/>
                        </Shape>
                        <String CONTENT="accomplice and their victim, arranged a contest of jumping over a barrier,"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l35" HPOS="353" VPOS="2621" WIDTH="1769" HEIGHT="57" BASELINE="355 2665 2122 2654" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2665 355 2678 2120 2669 2122 2654 2118 2621 373 2621 370 2621 368 2621 366 2621 353 2628 355 2665"/>
                        </Shape>
                        <String CONTENT="the loser to pay the forfeit of skipping about for a while with his feet and"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l36" HPOS="353" VPOS="2671" WIDTH="1769" HEIGHT="65" BASELINE="355 2723 2122 2712" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="355 2723 355 2736 2120 2730 2122 2712 2118 2684 1839 2684 1815 2671 1813 2671 1811 2671 1808 2671 1763 2684 1544 2673 1542 2673 1488 2684 1440 2673 1438 2673 1436 2673 1434 2673 1401 2686 1367 2676 1365 2676 1362 2676 1360 2676 1334 2686 1232 2676 1230 2676 1178 2686 1124 2676 1122 2676 1120 2676 1118 2676 1102 2686 799 2678 797 2678 689 2691 661 2680 659 2680 656 2680 353 2689 355 2723"/>
                        </Shape>
                        <String CONTENT="hands bound together. When the elder brother lost, the other two men"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l37" HPOS="351" VPOS="2736" WIDTH="1771" HEIGHT="63" BASELINE="353 2782 2122 2773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2782 353 2799 2120 2790 2122 2773 2118 2741 795 2736 793 2736 736 2747 485 2738 483 2738 351 2749 353 2782"/>
                        </Shape>
                        <String CONTENT="accordingly tied his feet, and coolly stabbed him with their knives. I heard"/>
                    </TextLine>

                    <TextLine ID="mz_1-067_l38" HPOS="351" VPOS="2795" WIDTH="1315" HEIGHT="62" BASELINE="353 2842 1666 2836" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="353 2842 353 2857 1663 2851 1666 2836 1661 2808 1265 2795 1263 2795 1261 2795 1204 2808 955 2797 953 2797 951 2797 923 2808 892 2797 890 2797 888 2797 886 2797 856 2808 821 2797 819 2797 817 2797 814 2797 786 2810 769 2799 767 2799 765 2799 762 2799 591 2810 468 2799 466 2799 407 2810 379 2799 377 2799 375 2799 373 2799 370 2799 351 2808 353 2842"/>
                        </Shape>
                        <String CONTENT="the details of both deeds from the murderers themselves."/>
                    </TextLine>
