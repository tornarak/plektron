                <TextBlock ID="text_1-229" HPOS="440" VPOS="597" WIDTH="1782" HEIGHT="2618"><TextLine ID="mz_1-229_l1" HPOS="1016" VPOS="597" WIDTH="617" HEIGHT="56" BASELINE="1018 632 1633 636" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1624 599 1018 597 1018 632 1016 649 1629 653 1633 636 1631 615 1624 599"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>
<TextLine ID="mz_1-229_l2" HPOS="440" VPOS="699" WIDTH="1769" HEIGHT="74" BASELINE="442 744 2209 740" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="442 744 444 773 492 762 1211 770 1213 770 1328 760 2209 760 2209 740 2207 712 2177 699 2174 699 2172 699 2170 699 2140 712 2006 712 1988 699 1986 699 1984 699 1982 699 1980 699 1947 712 1778 712 1763 699 1761 699 1759 699 1661 699 1659 699 1657 699 1655 699 1640 710 1549 699 1546 699 1544 699 1514 710 1419 699 1416 699 1274 714 1148 714 1133 701 1131 701 1128 701 1126 701 1124 701 1089 712 1014 701 1012 701 1009 701 979 712 934 701 931 701 929 701 927 701 899 712 440 710 442 744"/>
                        </Shape>
                        <String CONTENT="It has three or even four lamps of various sizes, which are used not only"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l3" HPOS="442" VPOS="757" WIDTH="1137" HEIGHT="72" BASELINE="444 801 1579 807" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="444 801 442 825 444 827 446 827 446 829 448 829 451 829 453 829 1577 822 1579 807 1579 773 1559 762 1557 762 1555 762 1553 762 1551 762 1523 773 1399 762 1397 762 1395 762 1393 762 1393 764 1382 775 1282 775 1200 760 1198 760 1196 760 1152 770 1038 760 1035 760 916 770 890 760 888 760 886 760 830 770 814 757 812 757 810 757 808 757 806 757 769 768 687 757 685 757 682 757 656 768 600 757 598 757 444 766 444 801"/>
                        </Shape>
                        <String CONTENT="for light, but also for cooking (Plate XV, Fig. 4)."/>
                    </TextLine>
<TextLine ID="mz_1-229_l4" HPOS="557" VPOS="2368" WIDTH="1665" HEIGHT="59" BASELINE="557 2409 2222 2409" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2207 2377 2140 2368 2016 2368 2014 2368 2012 2368 2010 2368 1997 2379 1954 2368 1951 2368 1949 2368 1858 2379 1666 2368 1663 2368 1570 2379 557 2372 557 2409 557 2427 2222 2427 2222 2409 2222 2401 2207 2377"/>
                        </Shape>
                        <String CONTENT="It is usually larger than the inner room of the tents of the Reindeer"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l5" HPOS="448" VPOS="2427" WIDTH="1768" HEIGHT="67" BASELINE="451 2472 2216 2468" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="448 2448 451 2472 451 2494 2213 2483 2216 2468 2211 2440 2092 2427 2090 2427 2012 2437 1988 2427 1986 2427 1984 2427 1982 2427 1954 2437 1925 2427 1923 2427 1921 2427 1854 2437 1830 2427 1828 2427 1826 2427 1824 2427 1821 2427 1804 2440 1644 2440 1618 2427 1616 2427 1614 2427 1611 2427 1566 2437 1518 2427 1516 2427 1514 2427 1512 2427 1510 2427 1492 2440 1378 2440 1347 2427 1345 2427 1343 2427 1341 2427 1339 2427 1323 2440 1280 2429 1278 2429 1276 2429 1131 2440 1094 2429 1092 2429 1089 2429 1087 2429 1059 2440 979 2429 977 2429 747 2440 706 2429 704 2429 702 2429 602 2440 555 2429 552 2429 550 2429 455 2442 448 2448"/>
                        </Shape>
                        <String CONTENT="people; and among well-to-do families it may be about 30 feet in length, 10"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l6" HPOS="448" VPOS="2485" WIDTH="1768" HEIGHT="63" BASELINE="451 2531 2216 2526" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2531 451 2548 2213 2548 2216 2526 2211 2498 2135 2485 2133 2485 2131 2485 2107 2498 1990 2498 1975 2485 1973 2485 1971 2485 1969 2485 1967 2485 1945 2496 1886 2485 1884 2485 1882 2485 1854 2496 1798 2485 1795 2485 1793 2485 1791 2485 1776 2496 1274 2487 1271 2487 1269 2487 1267 2487 1254 2498 1241 2487 1239 2487 1237 2487 1235 2487 1232 2487 1204 2498 1042 2487 1040 2487 1038 2487 1012 2498 988 2487 986 2487 983 2487 981 2487 953 2498 923 2487 921 2487 918 2487 817 2498 801 2487 799 2487 797 2487 641 2487 639 2487 637 2487 611 2498 570 2487 568 2487 565 2487 563 2487 561 2487 546 2498 466 2487 464 2487 461 2487 459 2487 448 2496 451 2531"/>
                        </Shape>
                        <String CONTENT="feet in breadth, and 6 feet in height. The outer tent is also larger than"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l7" HPOS="448" VPOS="2554" WIDTH="1770" HEIGHT="59" BASELINE="451 2587 2218 2591" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2587 448 2602 461 2611 464 2611 466 2611 468 2611 1306 2602 1336 2613 1339 2613 1341 2613 2216 2602 2218 2591 2216 2559 451 2554 451 2587"/>
                        </Shape>
                        <String CONTENT="that of the Reindeer Chukchee. I saw one house which was forty feet in"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l8" HPOS="451" VPOS="2615" WIDTH="1765" HEIGHT="56" BASELINE="453 2645 2216 2650" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="453 2645 451 2660 2211 2671 2216 2650 2213 2619 453 2615 453 2645"/>
                        </Shape>
                        <String CONTENT="diameter and had eleven stretchers to support the frame. In the outer tent,"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l9" HPOS="448" VPOS="2673" WIDTH="1770" HEIGHT="55" BASELINE="451 2706 2218 2712" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2706 448 2721 2213 2728 2218 2712 2216 2680 451 2673 451 2706"/>
                        </Shape>
                        <String CONTENT="on both sides of the sleeping-room, are placed two huge seal-skin bags, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l10" HPOS="448" VPOS="2741" WIDTH="774" HEIGHT="45" BASELINE="448 2771 1222 2771" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="448 2771 448 2786 1222 2786 1222 2771 1222 2741 448 2741 448 2771"/>
                        </Shape>
                        <String CONTENT="are used for purposes of storage."/>
                    </TextLine>
<TextLine ID="mz_1-229_l11" HPOS="559" VPOS="2788" WIDTH="1659" HEIGHT="63" BASELINE="561 2823 2218 2827" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="561 2823 559 2838 639 2851 641 2851 2216 2849 2218 2827 2216 2797 561 2788 561 2823"/>
                        </Shape>
                        <String CONTENT="The bottom of the sleeping-room is covered with a large walrus-hide,"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l12" HPOS="446" VPOS="2842" WIDTH="1774" HEIGHT="70" BASELINE="448 2886 2220 2890" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="446 2903 459 2912 461 2912 464 2912 466 2912 2218 2903 2220 2890 2218 2860 1804 2847 1802 2847 1663 2857 1598 2847 1596 2847 1594 2847 1592 2847 1577 2860 1468 2860 1438 2847 1436 2847 1434 2847 1332 2857 1176 2844 1174 2844 1172 2844 1137 2855 1109 2844 1107 2844 1105 2844 1053 2855 916 2844 914 2844 834 2855 806 2844 804 2844 801 2844 799 2844 769 2855 723 2844 721 2844 719 2844 717 2844 715 2844 700 2857 594 2857 557 2844 555 2844 552 2844 500 2855 451 2842 448 2886 446 2903"/>
                        </Shape>
                        <String CONTENT="forming a hard and smooth floor to tread on. The steadily burning lamps"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l13" HPOS="448" VPOS="2914" WIDTH="1770" HEIGHT="52" BASELINE="451 2944 2218 2951" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 2944 448 2959 2213 2966 2218 2951 2216 2920 451 2914 451 2944"/>
                        </Shape>
                        <String CONTENT="make the room warm and dry, and even afford a chance for ventilation, which"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l14" HPOS="451" VPOS="2966" WIDTH="1767" HEIGHT="65" BASELINE="451 3009 2218 3009" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3009 451 3024 2213 3031 2218 3009 2218 2977 2198 2966 2196 2966 2194 2966 2192 2966 2190 2966 2144 2977 2049 2966 2047 2966 2045 2966 2016 2977 1971 2966 1969 2966 1967 2966 1964 2966 1943 2977 1915 2966 1912 2966 1910 2966 1908 2966 1880 2977 1865 2966 1863 2966 1860 2966 1858 2966 1759 2979 1588 2979 1568 2966 1566 2966 1564 2966 1562 2966 1559 2966 1523 2977 1386 2966 1384 2966 1382 2966 1354 2977 1198 2966 1196 2966 1193 2966 1163 2977 1109 2966 1107 2966 1105 2966 1074 2977 1001 2966 999 2966 914 2977 871 2966 869 2966 866 2966 864 2966 834 2977 773 2966 771 2966 708 2977 682 2966 680 2966 678 2966 451 2970 451 3009"/>
                        </Shape>
                        <String CONTENT="is effected either by lifting the front or by opening a special hole in the wall,"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l15" HPOS="448" VPOS="3022" WIDTH="1768" HEIGHT="69" BASELINE="451 3063 2216 3072" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3063 448 3076 470 3089 472 3089 474 3089 823 3080 892 3091 895 3091 2213 3085 2216 3072 2216 3041 2172 3028 2170 3028 2168 3028 2103 3039 1889 3028 1886 3028 1832 3039 1767 3026 1765 3026 1763 3026 1722 3037 1659 3026 1657 3026 1655 3026 1609 3037 1564 3026 1562 3026 1559 3026 1503 3037 1276 3037 1261 3024 1258 3024 1256 3024 1254 3024 1046 3035 994 3024 992 3024 990 3024 988 3024 970 3035 947 3024 944 3024 942 3024 940 3024 905 3035 866 3022 864 3022 862 3022 860 3022 827 3033 752 3022 749 3022 747 3022 721 3035 585 3035 568 3022 565 3022 563 3022 561 3022 451 3031 451 3063"/>
                        </Shape>
                        <String CONTENT="which may be closed by a round stopper made of a piece of reindeer-skin."/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l16" HPOS="448" VPOS="3091" WIDTH="1768" HEIGHT="57" BASELINE="451 3128 2216 3124" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3128 451 3148 2216 3148 2216 3124 2211 3096 448 3091 451 3128"/>
                        </Shape>
                        <String CONTENT="Damp clothes are dried by hanging them on pegs or by stretching them on"/>
                    </TextLine>

                    <TextLine ID="mz_1-229_l17" HPOS="448" VPOS="3152" WIDTH="648" HEIGHT="63" BASELINE="451 3184 1096 3189" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="451 3184 448 3200 812 3215 814 3215 1094 3204 1096 3189 1094 3156 451 3152 451 3184"/>
                        </Shape>
                        <String CONTENT="strings tied along the walls."/>
                    </TextLine>
