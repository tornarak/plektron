                <TextBlock ID="text_1-172" HPOS="650" VPOS="638" WIDTH="1780" HEIGHT="2616"><TextLine ID="mz_1-172_l1" HPOS="1265" VPOS="638" WIDTH="617" HEIGHT="52" BASELINE="1265 671 1882 671" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1871 638 1276 638 1265 643 1265 671 1265 690 1882 690 1882 671 1880 666 1871 638"/>
                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l2" HPOS="674" VPOS="640" WIDTH="78" HEIGHT="65" BASELINE="676 679 752 682" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="676 679 674 695 710 705 713 705 715 705 717 705 749 692 752 682 749 645 676 640 676 679"/>
                        </Shape>
                        <String CONTENT="130"/>
                    </TextLine>
<TextLine ID="mz_1-172_l3" HPOS="654" VPOS="744" WIDTH="1774" HEIGHT="59" BASELINE="656 777 2428 781" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2408 744 2387 744 2365 744 656 744 656 777 654 794 665 803 667 803 669 803 672 803 2426 794 2428 781 2428 744 2408 744"/>
                        </Shape>
                        <String CONTENT="the boat to beat to windward. With the wind aft, however, the square sail"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l4" HPOS="1050" VPOS="796" WIDTH="1378" HEIGHT="61" BASELINE="1053 842 2428 838" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1053 842 1053 857 2426 853 2428 838 2424 809 2294 796 2291 796 2289 796 2287 796 2272 807 2248 796 2246 796 2244 796 2242 796 2239 796 2239 799 2231 807 2211 796 2209 796 2207 796 2205 796 2203 796 2190 807 2159 796 2157 796 2155 796 2094 807 2032 796 2029 796 1943 807 1884 796 1882 796 1880 796 1847 809 1713 809 1687 799 1685 799 1683 799 1681 799 1679 799 1666 812 1575 812 1507 799 1505 799 1503 799 1471 809 1429 799 1427 799 1425 799 1423 799 1397 812 1241 812 1209 799 1206 799 1204 799 1102 809 1068 799 1066 799 1063 799 1061 799 1059 799 1059 801 1050 807 1053 842"/>
                        </Shape>
                        <String CONTENT="is much more effective; and even with a side wind it keeps"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l5" HPOS="1053" VPOS="859" WIDTH="556" HEIGHT="56" BASELINE="1055 900 1609 896" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1055 900 1055 915 1607 911 1609 896 1605 868 1074 859 1072 859 1070 859 1068 859 1053 866 1055 900"/>
                        </Shape>
                        <String CONTENT="the boat much steadier."/>
                    </TextLine>
<TextLine ID="mz_1-172_l6" HPOS="1163" VPOS="915" WIDTH="1265" HEIGHT="59" BASELINE="1165 961 2428 957" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1165 961 1165 974 2426 970 2428 957 2424 928 2272 915 2270 915 2213 926 2190 915 2187 915 2185 915 2183 915 2181 915 2170 926 2140 915 2138 915 2135 915 2049 926 2019 915 2016 915 2014 915 1951 926 1912 915 1910 915 1908 915 1906 915 1904 915 1904 918 1893 928 1696 928 1650 918 1648 918 1646 918 1352 928 1258 918 1256 918 1254 918 1217 928 1174 918 1172 918 1170 918 1167 918 1165 918 1165 920 1163 920 1165 961"/>
                        </Shape>
                        <String CONTENT="In former times sails were made of curried reindeer-"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l7" HPOS="1053" VPOS="976" WIDTH="1373" HEIGHT="59" BASELINE="1055 1019 2426 1015" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1055 1019 1055 1035 2424 1030 2426 1015 2421 987 1739 976 1737 976 1735 976 1733 976 1718 987 1083 978 1081 978 1079 978 1053 987 1055 1019"/>
                        </Shape>
                        <String CONTENT="skins sewed together. Nowadays white and blue drilling is"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l8" HPOS="1055" VPOS="1037" WIDTH="1373" HEIGHT="67" BASELINE="1057 1080 2428 1076" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1080 1057 1093 1711 1104 1713 1104 1715 1104 1744 1091 2097 1091 2109 1102 2112 1102 2114 1102 2116 1104 2413 1104 2413 1102 2415 1102 2417 1102 2417 1099 2428 1089 2428 1076 2424 1048 1778 1037 1776 1037 1774 1037 1737 1048 1146 1039 1144 1039 1055 1050 1057 1080"/>
                        </Shape>
                        <String CONTENT="used in the trading-villages, while in more remote places"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l9" HPOS="1055" VPOS="1097" WIDTH="1371" HEIGHT="59" BASELINE="1057 1141 2426 1134" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1141 1057 1156 2424 1149 2426 1134 2421 1106 1572 1097 1570 1097 1055 1110 1057 1141"/>
                        </Shape>
                        <String CONTENT="numerous pieces of cotton and skin are patched together to"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l10" HPOS="1055" VPOS="1156" WIDTH="1369" HEIGHT="67" BASELINE="1057 1197 2424 1201" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1197 1055 1212 1061 1219 1063 1219 1063 1221 1066 1221 1068 1221 1070 1223 1163 1223 1163 1221 1165 1221 1167 1221 1167 1219 1176 1210 1200 1221 1202 1221 1204 1221 1206 1221 1237 1210 1254 1221 1256 1221 1258 1221 1261 1223 1367 1223 1367 1221 1369 1221 1371 1221 1371 1219 1382 1210 1425 1221 1427 1221 1429 1221 1497 1210 1689 1221 1692 1221 2421 1216 2424 1201 2424 1171 2389 1158 2387 1158 2385 1158 2125 1169 1999 1158 1997 1158 1995 1158 1962 1169 1884 1158 1882 1158 1756 1169 1744 1158 1744 1156 1741 1156 1739 1156 1737 1156 1627 1167 1572 1156 1570 1156 1568 1156 1531 1167 1477 1156 1475 1156 1401 1167 1271 1156 1269 1156 1267 1156 1243 1169 1107 1169 1092 1156 1089 1156 1087 1156 1085 1156 1083 1156 1057 1164 1057 1197"/>
                        </Shape>
                        <String CONTENT="form a large sail. In rough weather, if the wind is fair,"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l11" HPOS="1057" VPOS="1229" WIDTH="1369" HEIGHT="46" BASELINE="1057 1260 2426 1260" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1260 1057 1271 2424 1275 2426 1260 2426 1229 1057 1229 1057 1260"/>
                        </Shape>
                        <String CONTENT="two large floats are fastened on both sides of the boat,"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l12" HPOS="1053" VPOS="1273" WIDTH="1375" HEIGHT="60" BASELINE="1055 1318 2428 1314" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1055 1318 1055 1333 2426 1329 2428 1314 2424 1286 2330 1273 2328 1273 2326 1273 2285 1284 2261 1273 2259 1273 2257 1273 2255 1273 2252 1273 2252 1275 2242 1286 2164 1286 2144 1273 2142 1273 2140 1273 2138 1273 2088 1284 2062 1273 2060 1273 2058 1273 2055 1273 2029 1284 2006 1273 2003 1273 2001 1273 1999 1273 1997 1273 1986 1284 1956 1273 1954 1273 1951 1273 1886 1284 1828 1273 1826 1273 1737 1286 1720 1275 1718 1275 1715 1275 1713 1275 1653 1286 1362 1275 1360 1275 1269 1286 1241 1275 1239 1275 1237 1275 1235 1275 1191 1286 1113 1275 1111 1275 1109 1275 1107 1275 1092 1286 1070 1275 1068 1275 1066 1275 1063 1275 1061 1275 1061 1277 1053 1284 1055 1318"/>
                        </Shape>
                        <String CONTENT="below the railing; while with a side wind the boat itself is"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l13" HPOS="1053" VPOS="1338" WIDTH="1377" HEIGHT="62" BASELINE="1055 1379 2430 1374" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="2421 1338 1157 1338 1154 1338 1053 1348 1055 1379 1055 1394 2413 1400 2415 1400 2417 1400 2419 1400 2430 1390 2430 1374 2428 1372 2421 1338"/>
                        </Shape>
                        <String CONTENT="too buoyant to allow the floats to be added. The sides of"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l14" HPOS="1055" VPOS="1394" WIDTH="1371" HEIGHT="67" BASELINE="1057 1437 2426 1442" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1437 1055 1450 1063 1459 1063 1461 1066 1461 1068 1461 1070 1461 2424 1452 2426 1442 2424 1411 2350 1396 2348 1396 2157 1409 2088 1396 2086 1396 2084 1396 2081 1396 2066 1409 2036 1396 2034 1396 2032 1396 2029 1396 1977 1409 1886 1396 1884 1396 1882 1396 1854 1409 1843 1398 1843 1396 1841 1396 1839 1396 1795 1396 1793 1396 1791 1396 1741 1409 1692 1394 1689 1394 1687 1394 1685 1394 1648 1407 1629 1394 1627 1394 1624 1394 1622 1394 1620 1394 1594 1405 1538 1394 1536 1394 1533 1394 1531 1394 1518 1407 1237 1407 1215 1394 1213 1394 1211 1394 1209 1394 1206 1394 1204 1394 1204 1396 1191 1407 1057 1407 1057 1437"/>
                        </Shape>
                        <String CONTENT="many boats are provided also with flaps of skin or drilling,"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l15" HPOS="1055" VPOS="1457" WIDTH="1371" HEIGHT="58" BASELINE="1057 1500 2426 1494" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1500 1057 1515 2424 1511 2426 1494 2421 1465 1512 1457 1510 1457 1408 1468 1094 1459 1092 1459 1089 1459 1055 1470 1057 1500"/>
                        </Shape>
                        <String CONTENT="which in rainy weather are used for covering the cargo, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l16" HPOS="1053" VPOS="1513" WIDTH="1375" HEIGHT="63" BASELINE="1055 1561 2428 1554" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1055 1561 1055 1576 2426 1569 2428 1554 2424 1526 2274 1513 2272 1513 2198 1524 2161 1513 2159 1513 2157 1513 2084 1524 2049 1513 2047 1513 2045 1513 1995 1524 1971 1513 1969 1513 1967 1513 1964 1513 1943 1524 1609 1515 1607 1515 1499 1528 1380 1517 1378 1517 1261 1528 1230 1517 1228 1517 1226 1517 1109 1528 1068 1517 1066 1517 1063 1517 1061 1517 1059 1517 1059 1519 1057 1519 1053 1522 1055 1561"/>
                        </Shape>
                        <String CONTENT="in rough weather are raised, and held in place by sticks or"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l17" HPOS="1055" VPOS="1578" WIDTH="1371" HEIGHT="67" BASELINE="1057 1619 2426 1613" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1619 1057 1634 1510 1645 1512 1645 1668 1632 1756 1643 1759 1643 1856 1632 2424 1632 2426 1613 2421 1584 1081 1578 1079 1578 1076 1578 1055 1587 1057 1619"/>
                        </Shape>
                        <String CONTENT="simply by inverted paddles. These are very convenient, and"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l18" HPOS="1055" VPOS="1643" WIDTH="1304" HEIGHT="61" BASELINE="1057 1673 2359 1678" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1673 1055 1693 1066 1701 1068 1701 1070 1701 1072 1704 1167 1704 1167 1701 1170 1701 1172 1701 1172 1699 1183 1691 1226 1701 1228 1701 1230 1701 1232 1701 1258 1691 1282 1701 1284 1701 1287 1701 1352 1691 1375 1701 1378 1701 1380 1701 1917 1693 1954 1704 1956 1704 1958 1704 1960 1704 1993 1693 2079 1704 2081 1704 2356 1691 2359 1678 2356 1647 1057 1643 1057 1673"/>
                        </Shape>
                        <String CONTENT="keep off the dashing spray even in very rough weather."/>
                    </TextLine>
<TextLine ID="mz_1-172_l19" HPOS="1167" VPOS="1704" WIDTH="1259" HEIGHT="49" BASELINE="1170 1738 2426 1734" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1170 1738 1170 1753 2424 1749 2426 1734 2421 1706 1167 1704 1170 1738"/>
                        </Shape>
                        <String CONTENT="The skin boat has many advantages over the wooden"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l20" HPOS="1057" VPOS="1755" WIDTH="1371" HEIGHT="57" BASELINE="1057 1797 2428 1797" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1057 1797 1057 1812 2428 1812 2428 1797 2428 1768 1653 1755 1650 1755 1648 1755 1622 1766 1594 1755 1592 1755 1590 1755 1475 1766 1445 1755 1442 1755 1440 1755 1438 1755 1408 1766 1371 1755 1369 1755 1367 1755 1365 1755 1362 1755 1362 1758 1352 1768 1232 1768 1219 1755 1217 1755 1215 1755 1102 1755 1100 1755 1098 1755 1057 1766 1057 1797"/>
                        </Shape>
                        <String CONTENT="whale-boat. It is much lighter, and, while it carries more"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l21" HPOS="1053" VPOS="1816" WIDTH="1375" HEIGHT="67" BASELINE="1055 1857 2428 1853" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="1055 1857 1055 1872 1551 1883 1553 1883 1627 1872 1980 1881 1982 1881 1984 1881 1986 1881 1999 1870 2081 1870 2094 1881 2097 1881 2099 1881 2101 1883 2198 1883 2198 1881 2200 1881 2226 1870 2311 1881 2313 1881 2315 1881 2317 1881 2330 1870 2363 1881 2365 1881 2367 1881 2426 1868 2428 1853 2424 1825 1070 1816 1068 1816 1066 1816 1063 1816 1053 1823 1055 1857"/>
                        </Shape>
                        <String CONTENT="freight, can be propelled or towed along the shore with less"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l22" HPOS="656" VPOS="1885" WIDTH="1772" HEIGHT="48" BASELINE="656 1916 2428 1916" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="656 1916 656 1933 2428 1933 2428 1916 2428 1885 656 1885 656 1916"/>
                        </Shape>
                        <String CONTENT="labor. For the windward motion the skin boat is not so convenient, because"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l23" HPOS="656" VPOS="1939" WIDTH="1772" HEIGHT="59" BASELINE="659 1978 2428 1972" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="659 1978 659 1991 2408 1998 2411 1998 2413 1998 2415 1998 2428 1987 2428 1972 2424 1944 656 1939 659 1978"/>
                        </Shape>
                        <String CONTENT="it is too buoyant, and, moreover, has no outer keel. Much more important"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l24" HPOS="652" VPOS="2004" WIDTH="1774" HEIGHT="50" BASELINE="652 2037 2426 2037" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="652 2037 652 2054 2426 2054 2426 2037 2426 2007 652 2004 652 2037"/>
                        </Shape>
                        <String CONTENT="is the advantage the skin boat possesses in being able to land through heavy"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l25" HPOS="652" VPOS="2052" WIDTH="1772" HEIGHT="63" BASELINE="654 2093 2424 2098" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2093 652 2106 2419 2115 2424 2098 2424 2067 2391 2054 2389 2054 2387 2054 1817 2065 1791 2054 1789 2054 1787 2054 1785 2054 1741 2065 1683 2054 1681 2054 1679 2054 1657 2065 1605 2054 1603 2054 1601 2054 1557 2065 1542 2052 1540 2052 1538 2052 1536 2052 1533 2052 1503 2065 1408 2065 1393 2052 1391 2052 1388 2052 1386 2052 1308 2063 1252 2052 1157 2052 1154 2052 1152 2052 1150 2052 1135 2063 1066 2052 1063 2052 1061 2052 1038 2065 923 2065 908 2052 905 2052 903 2052 901 2052 899 2052 871 2063 847 2052 845 2052 843 2052 654 2061 654 2093"/>
                        </Shape>
                        <String CONTENT="surf. Both on the Arctic and on the Pacific shore the sea is very rough,"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l26" HPOS="652" VPOS="2111" WIDTH="1774" HEIGHT="62" BASELINE="654 2158 2426 2152" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2158 654 2173 2424 2167 2426 2152 2421 2124 2343 2111 2341 2111 2339 2111 2337 2111 2320 2121 1947 2111 1945 2111 1943 2111 1941 2111 1925 2124 1815 2124 1323 2113 1321 2113 1187 2126 775 2115 773 2115 652 2128 654 2158"/>
                        </Shape>
                        <String CONTENT="especially in the fall; and sudden squalls are frequent. The skin boat, when"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l27" HPOS="652" VPOS="2173" WIDTH="1774" HEIGHT="61" BASELINE="654 2217 2426 2212" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2217 654 2234 2424 2232 2426 2212 2421 2184 1566 2173 1564 2173 1471 2184 758 2175 756 2175 652 2186 654 2217"/>
                        </Shape>
                        <String CONTENT="caught in a storm, does not seek the harbor, but makes for the first sandy"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l28" HPOS="652" VPOS="2234" WIDTH="1772" HEIGHT="61" BASELINE="654 2277 2424 2273" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2277 654 2295 2421 2295 2424 2273 2419 2245 1538 2234 1536 2234 1449 2245 743 2236 741 2236 652 2247 654 2277"/>
                        </Shape>
                        <String CONTENT="spot free from stones, and screened from the rushing wind in some way by"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l29" HPOS="652" VPOS="2295" WIDTH="1772" HEIGHT="58" BASELINE="654 2336 2424 2331" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2336 654 2353 2421 2351 2424 2331 2419 2299 825 2295 823 2295 652 2305 654 2336"/>
                        </Shape>
                        <String CONTENT="coast cliffs. The landing is effected in a peculiar way: the boat, propelled"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l30" HPOS="656" VPOS="2357" WIDTH="1772" HEIGHT="57" BASELINE="656 2394 2428 2394" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="656 2394 656 2414 2428 2414 2428 2394 2428 2357 656 2357 656 2394"/>
                        </Shape>
                        <String CONTENT="by oars, boldly makes for the shore, and in a favorable moment the end of"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l31" HPOS="652" VPOS="2424" WIDTH="1769" HEIGHT="48" BASELINE="654 2455 2421 2453" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2455 654 2472 2419 2470 2421 2453 2415 2424 652 2424 654 2455"/>
                        </Shape>
                        <String CONTENT="a rope is thrown to the shore, or, when there is nobody to catch it, a man"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l32" HPOS="654" VPOS="2485" WIDTH="1772" HEIGHT="46" BASELINE="654 2513 2426 2513" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2513 654 2531 2426 2531 2426 2513 2426 2485 654 2485 654 2513"/>
                        </Shape>
                        <String CONTENT="will jump out with it. The boat, while free on the water, is made by the"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l33" HPOS="654" VPOS="2546" WIDTH="1772" HEIGHT="45" BASELINE="654 2574 2426 2574" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2574 654 2591 2426 2591 2426 2574 2426 2546 654 2546 654 2574"/>
                        </Shape>
                        <String CONTENT="steersman to turn in alongside the shore, and then the end of another rope"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l34" HPOS="650" VPOS="2602" WIDTH="1774" HEIGHT="50" BASELINE="652 2634 2424 2630" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="652 2634 652 2652 2421 2647 2424 2630 2419 2602 650 2602 652 2634"/>
                        </Shape>
                        <String CONTENT="is thrown from the stern, or another man jumps out with it. By pulling the"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l35" HPOS="650" VPOS="2660" WIDTH="1774" HEIGHT="50" BASELINE="652 2691 2424 2695" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="652 2691 650 2706 2419 2710 2424 2695 2421 2665 652 2660 652 2691"/>
                        </Shape>
                        <String CONTENT="ropes tight, the men on the shore make the water side of the boat stand up"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l36" HPOS="654" VPOS="2719" WIDTH="1772" HEIGHT="54" BASELINE="654 2756 2426 2756" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="654 2756 654 2773 2426 2773 2426 2756 2426 2725 654 2719 654 2756"/>
                        </Shape>
                        <String CONTENT="high against the breaking surf, and the first incoming wave catches the boat"/>
                    </TextLine>

                    <TextLine ID="mz_1-172_l37" HPOS="659" VPOS="2782" WIDTH="1767" HEIGHT="58" BASELINE="661 2812 2426 2816" TAGREFS="TYPE_4">
                        <Shape>
                            <Polygon POINTS="661 2812 659 2825 791 2838 793 2838 1527 2829 1642 2840 1644 2840 2424 2829 2426 2816 2424 2786 661 2782 661 2812"/>
                        </Shape>
                        <String CONTENT="— crew, cargo, and all — and casts it ashore. The flat, slippery boat acts"/>
                    </TextLine>

