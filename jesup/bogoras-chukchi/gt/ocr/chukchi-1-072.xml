                <TextBlock ID="text_1-072" HPOS="732" VPOS="612" WIDTH="1780" HEIGHT="2629"><TextLine ID="mz_1-072_l1" HPOS="1315" VPOS="612" WIDTH="619" HEIGHT="54" BASELINE="1317 647 1934 651" TAGREFS="TYPE_5">
