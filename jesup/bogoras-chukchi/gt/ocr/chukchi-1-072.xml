                        </Shape>
                        <String CONTENT="BOGORAS, THE CHUKCHEE."/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l2" HPOS="752" VPOS="615" WIDTH="49" HEIGHT="69" BASELINE="758 660 801 656" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="758 660 760 684 801 669 801 656 795 615 752 617 758 660"/>
                        </Shape>
                        <String CONTENT="50"/>
                    </TextLine>
<TextLine ID="mz_1-072_l3" HPOS="741" VPOS="714" WIDTH="1771" HEIGHT="61" BASELINE="741 757 2512 757" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="2495 727 2473 727 2452 725 2430 725 2408 723 2387 723 2385 721 2369 725 2346 721 2343 721 2322 721 2300 718 2291 718 2270 725 2255 716 2235 716 2213 716 2211 714 2079 725 2010 714 2008 714 1884 725 1869 714 1867 714 1865 714 1720 714 1718 714 1629 725 1601 714 1598 714 1596 714 1505 725 1434 714 1432 714 1375 725 1341 714 1339 714 1336 714 1276 725 1215 714 1213 714 1152 725 1139 714 1137 714 1135 714 1038 714 1035 714 977 725 875 714 873 714 804 725 760 714 758 714 756 714 754 714 752 714 741 721 741 757 741 775 2512 775 2512 757 2512 727 2495 727"/>
                        </Shape>
                        <String CONTENT="from Indian Point. The dog-drivers from Kuluˊči complained at Indian Point"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l4" HPOS="741" VPOS="775" WIDTH="1769" HEIGHT="60" BASELINE="741 818 2510 818" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 818 741 835 2510 835 2510 818 2510 786 2475 775 2473 775 2471 775 2469 775 2421 786 2367 775 2365 775 2363 775 2339 786 2105 775 2103 775 2101 775 2099 775 2081 786 2058 775 2055 775 2053 775 2051 775 2008 786 1990 775 1988 775 1986 775 1984 775 1982 775 1958 786 1934 775 1932 775 1930 775 1928 775 1893 786 1869 775 1867 775 1865 775 1795 786 1692 775 1689 775 1614 786 1557 775 1555 775 1501 786 1447 775 1445 775 1442 775 1416 786 1375 775 1373 775 1371 775 1369 775 1323 786 1295 775 1293 775 1291 775 1289 775 1287 775 1271 786 1245 775 1243 775 1241 775 1100 786 1044 775 1042 775 1040 775 1018 786 955 775 953 775 951 775 923 786 879 775 877 775 875 775 814 786 769 775 767 775 765 775 762 775 741 786 741 818"/>
                        </Shape>
                        <String CONTENT="that the inhabitants of the Pacific village Luˊᵋren had the habit of occasionally"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l5" HPOS="741" VPOS="846" WIDTH="1767" HEIGHT="52" BASELINE="741 879 2508 879" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 879 741 898 2506 898 2508 879 2506 846 741 846 741 879"/>
                        </Shape>
                        <String CONTENT="robbing the sledges which returned from trading-trips loaded with foreign wares."/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l6" HPOS="739" VPOS="902" WIDTH="1771" HEIGHT="59" BASELINE="741 935 2510 939" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 935 739 952 749 961 752 961 754 961 756 961 2508 952 2510 939 2508 907 741 902 741 935"/>
                        </Shape>
                        <String CONTENT="Between Luˊᵋren and the village Yaˊnřa-ñai a kind of feud is kept up that"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l7" HPOS="741" VPOS="961" WIDTH="940" HEIGHT="54" BASELINE="741 996 1681 996" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 996 741 1015 1681 1015 1681 996 1679 961 741 965 741 996"/>
                        </Shape>
                        <String CONTENT="was going on even two generations ago.¹"/>
                    </TextLine>
<TextLine ID="mz_1-072_l8" HPOS="849" VPOS="1022" WIDTH="1663" HEIGHT="54" BASELINE="849 1058 2512 1058" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="849 1058 849 1076 2512 1076 2512 1058 2512 1026 849 1022 849 1058"/>
                        </Shape>
                        <String CONTENT="The inhabitants of Luˊᵋren, Yaˊnřa-ñai, and other villages and camps around"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l9" HPOS="736" VPOS="1073" WIDTH="1772" HEIGHT="61" BASELINE="739 1119 2508 1112" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1119 739 1134 2506 1130 2508 1112 2504 1084 1954 1073 1951 1073 1949 1073 1912 1084 1410 1076 1408 1076 736 1086 739 1119"/>
                        </Shape>
                        <String CONTENT="St. Lawrence Bay, are famed for their roughness. Some of them buy from"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l10" HPOS="739" VPOS="1136" WIDTH="1769" HEIGHT="61" BASELINE="741 1180 2508 1175" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="741 1180 741 1195 2504 1197 2508 1175 2504 1145 760 1136 758 1136 756 1136 754 1136 739 1143 741 1180"/>
                        </Shape>
                        <String CONTENT="American whalers revolvers, which they carry in a special pocket up the sleeve,"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l11" HPOS="736" VPOS="1193" WIDTH="1776" HEIGHT="62" BASELINE="739 1238 2512 1234" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1238 739 1255 2510 1251 2512 1234 2508 1203 1631 1193 1629 1193 1627 1193 1624 1193 1609 1203 827 1195 825 1195 736 1206 739 1238"/>
                        </Shape>
                        <String CONTENT="ready to handle. Mr. J. Kelly, the American agent for buying reindeer, who spent"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l12" HPOS="736" VPOS="1251" WIDTH="1774" HEIGHT="65" BASELINE="739 1299 2510 1292" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1299 739 1316 2508 1309 2510 1292 2508 1264 2480 1251 2478 1251 2475 1251 2473 1251 2439 1262 2138 1251 2135 1251 2066 1262 2036 1251 2034 1251 2032 1251 1969 1262 1925 1251 1923 1251 1921 1251 1919 1251 1917 1251 1899 1264 1421 1253 1419 1253 1416 1253 1380 1264 1328 1253 1326 1253 1323 1253 1321 1253 1306 1266 869 1255 866 1255 864 1255 817 1266 758 1255 756 1255 754 1255 752 1255 736 1264 739 1299"/>
                        </Shape>
                        <String CONTENT="the winter of 1897-98 on the shores of St. Lawrence Bay, in a block-house built"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l13" HPOS="736" VPOS="1316" WIDTH="1774" HEIGHT="58" BASELINE="739 1357 2510 1353" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1357 739 1374 2508 1370 2510 1353 2506 1325 749 1316 747 1316 745 1316 743 1316 743 1318 736 1322 739 1357"/>
                        </Shape>
                        <String CONTENT="for the purpose near the village Yaˊnřa-ñai, had considerable trouble with the"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l14" HPOS="739" VPOS="1385" WIDTH="1767" HEIGHT="50" BASELINE="739 1416 2506 1416" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1416 739 1435 2504 1435 2506 1416 2504 1385 739 1385 739 1416"/>
                        </Shape>
                        <String CONTENT="natives; and I heard that an attempt was made to attack his house and to rob it."/>
                    </TextLine>
<TextLine ID="mz_1-072_l15" HPOS="847" VPOS="1437" WIDTH="1659" HEIGHT="57" BASELINE="849 1474 2506 1478" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="849 1474 847 1489 2501 1494 2506 1478 2504 1446 849 1437 849 1474"/>
                        </Shape>
                        <String CONTENT="The Chukchee cannot be called quick-witted, especially in trading-transactions,"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l16" HPOS="734" VPOS="1496" WIDTH="1778" HEIGHT="67" BASELINE="736 1537 2512 1532" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1537 736 1550 1040 1563 1042 1563 1044 1563 1079 1552 1276 1563 1278 1563 1280 1563 1319 1552 1375 1563 1378 1563 1529 1552 1583 1563 1585 1563 1648 1550 1685 1561 1687 1561 1689 1561 1692 1561 1731 1550 2408 1561 2411 1561 2413 1561 2447 1550 2465 1561 2467 1561 2469 1561 2471 1561 2473 1561 2512 1545 2512 1532 2506 1496 734 1500 736 1537"/>
                        </Shape>
                        <String CONTENT="in which they are easily imposed upon by their neighbors. Their system of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l17" HPOS="736" VPOS="1565" WIDTH="1774" HEIGHT="50" BASELINE="736 1595 2510 1595" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1595 736 1615 2510 1615 2510 1595 2510 1565 736 1565 736 1595"/>
                        </Shape>
                        <String CONTENT="calculation is quinary-vigesimal, but very imperfect, and all numerical operations"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l18" HPOS="734" VPOS="1613" WIDTH="1774" HEIGHT="58" BASELINE="736 1658 2508 1654" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1658 736 1671 2506 1667 2508 1654 2504 1623 1637 1613 1635 1613 1633 1613 1631 1613 1614 1623 918 1615 916 1615 734 1626 736 1658"/>
                        </Shape>
                        <String CONTENT="are performed with the help of the fingers of both hands. The word for"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l19" HPOS="736" VPOS="1675" WIDTH="1765" HEIGHT="70" BASELINE="736 1714 2501 1714" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1714 736 1729 892 1742 895 1742 947 1732 1256 1742 1258 1742 1261 1742 1304 1732 1436 1742 1438 1742 1516 1732 1555 1742 1557 1742 1559 1745 1804 1745 1804 1742 1806 1742 1808 1742 1826 1732 2447 1742 2450 1742 2501 1729 2501 1714 2499 1675 736 1682 736 1714"/>
                        </Shape>
                        <String CONTENT="counting means literally “I finger” (t-rɪˊlhɪrkɪn). The question “How many?”"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l20" HPOS="734" VPOS="1732" WIDTH="1774" HEIGHT="60" BASELINE="736 1777 2508 1773" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1777 736 1792 2506 1792 2508 1773 2504 1745 2363 1745 2339 1732 2337 1732 2335 1732 2333 1732 2289 1742 2259 1732 2257 1732 2255 1732 2252 1732 2250 1732 2237 1742 2216 1732 2213 1732 2211 1732 2209 1732 2207 1732 2190 1745 1995 1745 1943 1732 1941 1732 1826 1742 1744 1732 1741 1732 1739 1732 1698 1742 1663 1732 1661 1732 1659 1732 1536 1745 1460 1734 1458 1734 1397 1745 1373 1734 1371 1734 1369 1734 1243 1745 1202 1734 1200 1734 1198 1734 1196 1734 1193 1734 1178 1747 1012 1747 882 1734 879 1734 877 1734 875 1734 858 1747 734 1747 736 1777"/>
                        </Shape>
                        <String CONTENT="runs “How many fingers?” (Ter rɪˊlhɪt?) The numbers proceed in the way"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l21" HPOS="734" VPOS="1792" WIDTH="1772" HEIGHT="61" BASELINE="736 1836 2506 1831" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1836 736 1853 2504 1849 2506 1831 2501 1803 1644 1792 1642 1792 1640 1792 1616 1803 836 1794 834 1794 734 1805 736 1836"/>
                        </Shape>
                        <String CONTENT="usual to many primitive languages, so that mɪˊʟɪñên (“five”) is shortened from"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l22" HPOS="734" VPOS="1851" WIDTH="1770" HEIGHT="63" BASELINE="736 1896 2504 1892" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 1896 736 1914 2501 1909 2504 1892 2497 1855 2092 1862 2075 1851 2073 1851 2071 1851 2068 1851 2012 1862 1975 1851 1973 1851 1971 1851 1969 1851 1967 1851 1951 1862 1910 1851 1908 1851 1906 1851 1847 1862 1720 1851 1718 1851 1715 1851 1676 1862 1637 1851 1635 1851 1633 1851 1631 1851 1603 1864 1391 1853 1388 1853 1213 1864 1198 1853 1196 1853 1193 1853 1031 1853 1029 1853 1027 1853 988 1864 871 1853 869 1853 734 1866 736 1896"/>
                        </Shape>
                        <String CONTENT="mɪng̣ɪˊʟɪñɪn (“hand”); mɪng̣ɪˊtkên (“ten”) signifies “belonging to two hands;”"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l23" HPOS="736" VPOS="1909" WIDTH="1770" HEIGHT="65" BASELINE="739 1955 2506 1950" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 1955 739 1974 2504 1970 2506 1950 2501 1922 2008 1909 2006 1909 2003 1909 1982 1920 1958 1909 1956 1909 1954 1909 1808 1920 1780 1909 1778 1909 1776 1909 1774 1909 1748 1920 1724 1909 1722 1909 1720 1909 1581 1922 1458 1911 1455 1911 1395 1922 1382 1911 1380 1911 1378 1911 1375 1911 1373 1911 1343 1922 1239 1911 1237 1911 1235 1911 1213 1922 1185 1911 1183 1911 1180 1911 1113 1922 1083 1911 1081 1911 1079 1911 736 1920 739 1955"/>
                        </Shape>
                        <String CONTENT="kɪlhɪˊnkɪn (“fifteen”) is probably contracted from g̣ɪtkaˊlhɪkên (“belonging to"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l24" HPOS="736" VPOS="1972" WIDTH="1772" HEIGHT="61" BASELINE="736 2015 2508 2015" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2015 736 2033 2508 2033 2508 2015 2508 1981 2406 1972 2404 1972 2402 1972 2378 1983 2352 1972 2350 1972 2348 1972 2216 1983 2153 1972 2151 1972 2148 1972 2114 1983 2084 1972 2081 1972 2079 1972 2077 1972 2075 1972 2060 1985 1813 1985 1780 1972 1778 1972 1776 1972 1718 1983 1685 1972 1683 1972 1681 1972 1679 1972 1676 1972 1661 1983 1618 1972 1616 1972 1614 1972 1559 1983 1503 1972 1501 1972 1499 1972 1468 1983 1440 1972 1438 1972 1436 1972 1434 1972 1399 1983 1367 1972 1365 1972 1362 1972 1360 1972 1358 1972 1343 1985 1245 1985 1187 1972 1185 1972 1183 1972 1150 1983 1025 1972 1022 1972 960 1983 921 1972 918 1972 916 1972 914 1972 875 1983 847 1972 845 1972 843 1972 840 1972 795 1983 765 1972 762 1972 760 1972 758 1972 736 1983 736 2015"/>
                        </Shape>
                        <String CONTENT="the foot”); qliˊkkin (“twenty”) signifies “belonging to a man.” The word qlaˊul"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l25" HPOS="734" VPOS="2030" WIDTH="1774" HEIGHT="72" BASELINE="736 2078 2508 2074" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2078 736 2091 1434 2102 1436 2102 1438 2102 1440 2102 1455 2091 2506 2091 2508 2074 2506 2043 2480 2030 2478 2030 2475 2030 2473 2030 2452 2041 2330 2030 2328 2030 2326 2030 2296 2043 2183 2043 2166 2030 2164 2030 2161 2030 2159 2030 2157 2030 2133 2041 1564 2033 1562 2033 1559 2033 1557 2033 1542 2043 1488 2033 1486 2033 1484 2033 1455 2043 1416 2033 1414 2033 1412 2033 1360 2043 1191 2033 1189 2033 1081 2043 1022 2033 1020 2033 1018 2033 975 2043 960 2033 957 2033 955 2033 752 2033 749 2033 747 2033 745 2033 734 2041 736 2078"/>
                        </Shape>
                        <String CONTENT="(“man”) is also used frequently for “twenty.” The fingers and toes play such"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l26" HPOS="736" VPOS="2091" WIDTH="1770" HEIGHT="63" BASELINE="739 2137 2506 2132" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2137 739 2154 2504 2150 2506 2132 2501 2102 1655 2091 1653 2091 1572 2102 905 2093 903 2093 736 2104 739 2137"/>
                        </Shape>
                        <String CONTENT="a prominent part in counting, that I doubt whether a Chukchee would be able"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l27" HPOS="734" VPOS="2154" WIDTH="1774" HEIGHT="56" BASELINE="736 2195 2508 2191" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2195 736 2210 2506 2206 2508 2191 2504 2154 754 2154 752 2154 749 2154 747 2154 734 2160 736 2195"/>
                        </Shape>
                        <String CONTENT="to make a calculation without them. The larger numbers are composed of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l28" HPOS="736" VPOS="2210" WIDTH="1770" HEIGHT="69" BASELINE="739 2258 2506 2251" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="739 2258 739 2279 2504 2266 2506 2251 2501 2223 2426 2210 2424 2210 2421 2210 2419 2210 2402 2223 2207 2223 2166 2210 2164 2210 2161 2210 2159 2210 2127 2221 2081 2210 2079 2210 2077 2210 1973 2221 1943 2210 1941 2210 1938 2210 1860 2223 1449 2212 1447 2212 1395 2223 1349 2212 1347 2212 1345 2212 1343 2212 1321 2223 947 2214 944 2214 942 2214 918 2227 736 2227 739 2258"/>
                        </Shape>
                        <String CONTENT="groups of “twenty” (“man”). They are also counted on the fingers, so that"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l29" HPOS="734" VPOS="2269" WIDTH="1772" HEIGHT="73" BASELINE="736 2316 2506 2310" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2316 736 2331 1317 2340 1319 2340 1393 2329 1529 2340 1531 2340 1533 2340 1536 2340 1551 2329 1707 2329 1722 2340 1724 2340 1726 2340 1728 2342 1873 2342 1873 2340 2012 2338 2014 2338 2016 2338 2034 2327 2224 2338 2226 2338 2504 2327 2506 2310 2501 2282 2092 2269 2090 2269 2014 2279 1930 2269 1928 2269 1841 2282 1806 2271 1804 2271 1802 2271 1449 2282 1380 2271 1378 2271 1297 2284 1235 2273 1232 2273 940 2284 836 2273 834 2273 832 2273 830 2273 814 2284 760 2273 758 2273 756 2273 754 2273 734 2282 736 2316"/>
                        </Shape>
                        <String CONTENT="the limit of enumeration is “twenty scores” (qlik-qliˊkkin). All numbers above"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l30" HPOS="734" VPOS="2331" WIDTH="1090" HEIGHT="70" BASELINE="736 2372 1824 2377" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2372 734 2390 747 2398 749 2398 752 2398 754 2398 1109 2388 1287 2401 1289 2401 1354 2390 1798 2401 1800 2401 1802 2401 1804 2401 1821 2388 1824 2377 1824 2344 1798 2331 1795 2331 1793 2331 736 2338 736 2372"/>
                        </Shape>
                        <String CONTENT="this are called “knowledge limit” (g̣ɪyeuˊ-teˊhɪn)."/>
                    </TextLine>
<TextLine ID="mz_1-072_l31" HPOS="847" VPOS="2396" WIDTH="1665" HEIGHT="54" BASELINE="847 2433 2512 2433" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="847 2433 847 2450 2512 2450 2512 2433 2510 2396 847 2396 847 2433"/>
                        </Shape>
                        <String CONTENT="This term is also applied by a few rich traders to express the idea of"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l32" HPOS="743" VPOS="2461" WIDTH="1765" HEIGHT="50" BASELINE="743 2492 2508 2492" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="743 2492 743 2511 2508 2511 2508 2492 2508 2463 743 2461 743 2492"/>
                        </Shape>
                        <String CONTENT="“one thousand.” Many of the people, especially the Reindeer men, are unable"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l33" HPOS="734" VPOS="2520" WIDTH="1772" HEIGHT="56" BASELINE="736 2550 2506 2554" TAGREFS="TYPE_5">
                        <Shape>
                            <Polygon POINTS="736 2550 734 2567 747 2576 749 2576 752 2576 754 2576 2504 2570 2506 2554 2504 2524 736 2520 736 2550"/>
                        </Shape>
                        <String CONTENT="to deal with as high a number as a couple of scores. Therefore when dealing"/>
                    </TextLine>

                    <TextLine ID="mz_1-072_l34" HPOS="734" VPOS="2570" WIDTH="1772" HEIGHT="60" BASELINE="736 2615 2506 2611" TAGREFS="TYPE_5">
                        <Shape>
