   "edited": false
  },
  "7": {
   "text": "ordinary costume, and",
   "edited": false
  },
  "8": {
   "text": "consider the combination-",
   "edited": false
  },
  "9": {
   "text": "suit as underclothing.",
   "edited": false
  },
  "10": {
   "text": "The Chukchee women",
   "edited": false
  },
  "11": {
